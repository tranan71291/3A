// =====================================================================
//  DANH MỤC CẤU HÌNH ĐỘNG (bảng tra cứu)
//  Chỉ được ghi bởi syncCatalog(); mọi nơi khác chỉ đọc.
// =====================================================================

const SEGMENT_LABEL: Record<Segment, string> = {};
const SEGMENT_PTS: Record<Segment, number> = {};
const TIER: Record<Tier, { label: string; tone: Tone }> = {};
const TIERS: Tier[] = [];
const PROGRAM_TYPES: ProgramType[] = [];
const PROGRAM_LABEL: Record<ProgramType, string> = {};
const PROGRAM_COLOR: Record<ProgramType, string> = {};
const PROGRAM_FUND: Record<ProgramType, FundCode> = {};
const PROGRAM_BUDGET: Record<ProgramType, number> = {};
const PROGRAM_REQUIRED: Record<ProgramType, PopType[]> = {};
const PROGRAM_SETTLEMENT: Record<ProgramType, Settlement> = {};
const POP_TYPES: PopType[] = [];
const POP_LABEL: Record<PopType, string> = {};
const CUSTOMER_SOURCE: Record<string, CustomerSource> = {};

type Catalog = { segments: SegmentDef[]; tiers: TierRule[]; categories: BudgetCategory[]; popDocs: PopDocDef[]; sources: CustomerSource[] };

function syncCatalog(c: Catalog) {
  const reset = <T,>(o: Record<string, T>) => Object.keys(o).forEach((k) => delete o[k]);
  [SEGMENT_LABEL, SEGMENT_PTS, TIER, PROGRAM_LABEL, PROGRAM_COLOR, PROGRAM_FUND, PROGRAM_BUDGET, PROGRAM_REQUIRED, PROGRAM_SETTLEMENT, POP_LABEL, CUSTOMER_SOURCE].forEach((o) => reset(o as Record<string, unknown>));
  c.segments.forEach((s) => { SEGMENT_LABEL[s.code] = s.name; SEGMENT_PTS[s.code] = s.points; });
  const tiers = [...c.tiers].sort((a, b) => b.minRevenue - a.minRevenue);
  TIERS.splice(0, TIERS.length, ...tiers.map((t) => t.tier));
  tiers.forEach((t) => { TIER[t.tier] = { label: t.name, tone: t.tone }; });
  PROGRAM_TYPES.splice(0, PROGRAM_TYPES.length, ...c.categories.map((x) => x.code));
  c.categories.forEach((x) => {
    PROGRAM_LABEL[x.code] = x.name;
    PROGRAM_COLOR[x.code] = x.color;
    PROGRAM_FUND[x.code] = x.fund;
    PROGRAM_BUDGET[x.code] = x.amount;
    PROGRAM_REQUIRED[x.code] = x.required;
    PROGRAM_SETTLEMENT[x.code] = x.settlement;
  });
  POP_TYPES.splice(0, POP_TYPES.length, ...c.popDocs.map((d) => d.code));
  c.popDocs.forEach((d) => { POP_LABEL[d.code] = d.name; });
  c.sources.forEach((s) => { CUSTOMER_SOURCE[s.id] = s; });
}

const tierInfo = (t: Tier) => TIER[t] ?? { label: t, tone: 'muted' as Tone };
const segName = (s: Segment) => SEGMENT_LABEL[s] ?? s;
const progName = (t: ProgramType) => PROGRAM_LABEL[t] ?? t;
const isMktCustomer = (c: Customer) => !!CUSTOMER_SOURCE[c.sourceId]?.isMarketing;

