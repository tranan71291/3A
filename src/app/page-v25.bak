function quoteBody(title: string, clause: string) {
  return `<table class="layout"><tr>
<td>{{company_logo}}<b>{{company_name}}</b><br>MST: {{company_tax_code}}<br>{{company_address}}<br>ĐT: {{company_phone}}</td>
<td class="r">Số: <b>{{doc_code}}</b><br>Ngày: {{doc_date}}</td>
</tr></table>
<h1>BẢNG BÁO GIÁ</h1>
<p class="c"><i>${title}</i></p>
<p>Kính gửi: <b>{{customer_name}}</b><br>MST: {{tax_code}}<br>Địa chỉ: {{customer_address}}<br>Người nhận: {{customer_rep}}, {{customer_rep_title}}</p>
{{#if project}}<p>Dự án / nhu cầu: <b>{{project_name}}</b> ({{project_code}})</p>{{/if}}
<p>{{company_name}} trân trọng gửi Quý khách báo giá như sau:</p>
{{items_table}}
<p><b>Bằng chữ:</b> <i>{{grand_total_words}}</i></p>
<h3>Điều kiện thương mại</h3>
<ul>
<li>Giao hàng: {{delivery_terms}}.</li>
<li>Thanh toán: {{payment_method}}.</li>
{{#if advance}}<li>Tạm ứng {{advance_percent}} giá trị đơn hàng ({{advance_amount}}) sau khi ký hợp đồng.</li>{{/if}}
{{#if credit}}<li>Phần còn lại thanh toán trong {{credit_days}} ngày kể từ ngày giao hàng và nhận hóa đơn.</li>{{/if}}
{{#if no_credit}}<li>Thanh toán 100% trước hoặc khi giao hàng.</li>{{/if}}
{{#if warranty}}<li>Bảo hành {{warranty_months}} tháng theo tiêu chuẩn nhà sản xuất.</li>{{/if}}
<li>${clause}</li>
<li>Báo giá có hiệu lực đến hết ngày {{valid_until}}.</li>
</ul>
{{#if note}}<p>Ghi chú: {{note}}</p>{{/if}}
<table class="layout sign"><tr><td></td><td><b>ĐẠI DIỆN BÊN BÁN</b><br>{{company_stamp}}<br><b>{{company_rep}}</b><br>{{company_rep_title}}</td></tr></table>
<p class="small">Người liên hệ: {{sales_name}}, {{sales_phone}}</p>`;
}

function contractBody(title: string, clause: string) {
  return `<p class="c"><b>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</b><br><b>Độc lập – Tự do – Hạnh phúc</b></p>
<h1>HỢP ĐỒNG ${title.toUpperCase()}</h1>
<p class="c">Số: {{contract_code}}</p>
<p class="small">Căn cứ Bộ luật Dân sự số 91/2015/QH13 và Luật Thương mại số 36/2005/QH11; căn cứ nhu cầu và khả năng của hai bên.</p>
<p>Hôm nay, ngày {{doc_date}}, chúng tôi gồm:</p>
<p><b>BÊN A (BÊN MUA): {{customer_name}}</b><br>Địa chỉ: {{customer_address}}<br>Mã số thuế: {{tax_code}}<br>Điện thoại: {{customer_phone}}<br>Đại diện: <b>{{customer_rep}}</b> Chức vụ: {{customer_rep_title}}</p>
<p><b>BÊN B (BÊN BÁN): {{company_name}}</b><br>Địa chỉ: {{company_address}}<br>Mã số thuế: {{company_tax_code}}<br>Tài khoản: {{company_bank}}<br>Đại diện: <b>{{company_rep}}</b> Chức vụ: {{company_rep_title}}</p>
<p>Hai bên thống nhất ký kết hợp đồng với các điều khoản sau:</p>
<h3 class="art">Hàng hóa, số lượng và giá trị hợp đồng</h3>
{{#if project}}<p>Hàng hóa cung cấp cho: {{project_name}} ({{project_code}}).</p>{{/if}}
{{items_table}}
<p>Giá trị hợp đồng bằng chữ: <i>{{grand_total_words}}</i>.</p>
<h3 class="art">Giao hàng và nghiệm thu</h3>
<p>{{delivery_terms}}. Hai bên ký biên bản giao nhận khi giao hàng; hàng hóa đúng chủng loại, số lượng và còn nguyên đai kiện.</p>
<h3 class="art">Thanh toán</h3>
<p>Hình thức thanh toán: {{payment_method}}.</p>
{{#if advance}}<p>Bên A tạm ứng {{advance_percent}} giá trị hợp đồng ({{advance_amount}}) trong 05 ngày làm việc kể từ ngày ký hợp đồng.</p>{{/if}}
{{#if credit}}<p>Bên A thanh toán phần giá trị còn lại trong vòng {{credit_days}} ngày kể từ ngày nhận hàng và hóa đơn GTGT hợp lệ.</p>{{/if}}
{{#if no_credit}}<p>Bên A thanh toán 100% giá trị trước hoặc ngay khi nhận hàng.</p>{{/if}}
{{#if guarantee}}<h3 class="art">Bảo lãnh</h3>
<p>{{guarantee_terms}}</p>{{/if}}
{{#if warranty}}<h3 class="art">Bảo hành</h3>
<p>Hàng hóa được bảo hành {{warranty_months}} tháng kể từ ngày giao hàng theo tiêu chuẩn của nhà sản xuất. Bảo hành không áp dụng cho hư hỏng do lắp đặt, sử dụng sai hướng dẫn.</p>{{/if}}
<h3 class="art">Điều khoản riêng</h3>
<p>${clause}</p>
{{#if note}}<p>{{note}}</p>{{/if}}
<h3 class="art">Điều khoản chung</h3>
<p>Hai bên cam kết thực hiện đúng các điều khoản của hợp đồng. Tranh chấp phát sinh được giải quyết trên cơ sở thương lượng; nếu không thương lượng được sẽ đưa ra Tòa án có thẩm quyền giải quyết. Hợp đồng có hiệu lực kể từ ngày ký, được lập thành 04 bản có giá trị pháp lý như nhau, mỗi bên giữ 02 bản.</p>
<table class="layout sign"><tr>
<td><b>ĐẠI DIỆN BÊN A</b><br><br><br><br><b>{{customer_rep}}</b><br>{{customer_rep_title}}</td>
<td><b>ĐẠI DIỆN BÊN B</b><br>{{company_stamp}}<br><b>{{company_rep}}</b><br>{{company_rep_title}}</td>
</tr></table>`;
}

/** 10 mẫu báo giá + 10 mẫu hợp đồng, ghép cặp theo loại giao dịch */
function initialDocTemplates(): DocTemplate[] {
  const today = new Date().toISOString().slice(0, 10);
  const contractTitle: Record<TxType, string> = {
    DEALER: 'Đại lý phân phối', PROJECT_ME: 'Mua bán hàng hóa dự án M&E', SUPPLY_INSTALL: 'Cung cấp và lắp đặt', RETAIL_CASH: 'Mua bán hàng hóa',
    FACTORY: 'Mua bán vật tư công nghiệp', EPC_SUB: 'Cung cấp vật tư cho Tổng thầu', FRAMEWORK: 'Nguyên tắc mua bán hàng hóa', SAMPLE: 'Cung cấp mẫu thử nghiệm',
    SERVICE: 'Dịch vụ bảo trì kỹ thuật', TRADING: 'Mua bán hàng hóa (bán buôn)',
  };
  return (Object.keys(TX_TYPE) as TxType[]).flatMap((t, i) => {
    const n = String(i + 1).padStart(2, '0');
    const base = { txType: t, standardCreditDays: TX_TYPE[t].credit, defaultTier: TX_TYPE[t].tier, defaultDelivery: TX_TYPE[t].delivery, system: true, updatedAt: today };
    return [
      { ...base, id: `tq${n}`, kind: 'QUOTE', name: `Báo giá ${TX_TYPE[t].label}`, pairId: `tc${n}`, body: quoteBody(TX_TYPE[t].label, TX_CLAUSE[t].quote) },
      { ...base, id: `tc${n}`, kind: 'CONTRACT', name: `Hợp đồng ${contractTitle[t]}`, body: contractBody(contractTitle[t], TX_CLAUSE[t].contract) },
    ] as DocTemplate[];
  });
}

// ---------------- Đọc số tiền bằng chữ tiếng Việt ----------------

const VN_DIGITS = ['không', 'một', 'hai', 'ba', 'bốn', 'năm', 'sáu', 'bảy', 'tám', 'chín'];
function readTriple(n: number, full: boolean): string {
  const h = Math.floor(n / 100), t = Math.floor((n % 100) / 10), u = n % 10;
  const out: string[] = [];
  if (h > 0 || full) out.push(`${VN_DIGITS[h]} trăm`);
  if (t === 0) {
    if (u > 0) out.push(h > 0 || full ? `linh ${VN_DIGITS[u]}` : VN_DIGITS[u]);
  } else if (t === 1) {
    out.push('mười');
    if (u === 5) out.push('lăm');
    else if (u > 0) out.push(VN_DIGITS[u]);
  } else {
    out.push(`${VN_DIGITS[t]} mươi`);
    if (u === 1) out.push('mốt');
    else if (u === 4) out.push('tư');
    else if (u === 5) out.push('lăm');
    else if (u > 0) out.push(VN_DIGITS[u]);
  }
  return out.join(' ');
}
/** 1.250.000 -> "Một triệu hai trăm năm mươi nghìn đồng" */
function moneyToWordsVN(amount: number): string {
  let n = Math.round(Math.abs(amount));
  if (!n) return 'Không đồng';
  const units = ['', 'nghìn', 'triệu', 'tỷ', 'nghìn tỷ', 'triệu tỷ'];
  const groups: number[] = [];
  while (n > 0) { groups.push(n % 1000); n = Math.floor(n / 1000); }
  const parts: string[] = [];
  for (let i = groups.length - 1; i >= 0; i--) {
    if (!groups[i]) continue;
    parts.push(`${readTriple(groups[i], i < groups.length - 1)}${units[i] ? ` ${units[i]}` : ''}`);
  }
  const s = `${parts.join(' ')} đồng`;
  return s.charAt(0).toUpperCase() + s.slice(1);
}

// ---------------- Ghép biến ----------------

const money = (n: number) => `${Math.round(n).toLocaleString('vi-VN')} đ`;
const tierPrice = (k: SkuItem | undefined, tier: PriceTier) => (!k ? 0 : tier === 'DEALER' ? k.dealerPrice || k.basePrice : tier === 'PROJECT' ? k.projectPrice || k.basePrice : k.basePrice);

function docTotals(f: ComposerForm) {
  const sub = f.items.reduce((a, l) => a + l.qty * l.price, 0);
  const vat = Math.round((sub * f.vatPct) / 100);
  const grand = sub + vat;
  return { sub, vat, grand, advance: Math.round((grand * f.advancePct) / 100), guarantee: Math.round((grand * f.guaranteePct) / 100) };
}

function itemsTableHtml(f: ComposerForm) {
  const t = docTotals(f);
  const rows = f.items.map((l, i) => `<tr><td class="c">${i + 1}</td><td>${esc(l.sku)}</td><td>${esc(l.name)}</td><td class="c">${esc(l.unit)}</td><td class="r">${l.qty.toLocaleString('vi-VN')}</td><td class="r">${Math.round(l.price).toLocaleString('vi-VN')}</td><td class="r">${Math.round(l.qty * l.price).toLocaleString('vi-VN')}</td></tr>`).join('');
  return `<table class="items"><thead><tr><th>STT</th><th>Mã hàng</th><th>Tên hàng hóa, quy cách</th><th>ĐVT</th><th>SL</th><th>Đơn giá (đ)</th><th>Thành tiền (đ)</th></tr></thead><tbody>${rows || '<tr><td colspan="7" class="c">Chưa có hàng hóa</td></tr>'}
<tr><td colspan="6" class="r">Cộng tiền hàng</td><td class="r">${t.sub.toLocaleString('vi-VN')}</td></tr>
<tr><td colspan="6" class="r">Thuế GTGT ${f.vatPct}%</td><td class="r">${t.vat.toLocaleString('vi-VN')}</td></tr>
<tr><td colspan="6" class="r"><b>Tổng cộng thanh toán</b></td><td class="r"><b>${t.grand.toLocaleString('vi-VN')}</b></td></tr></tbody></table>`;
}

type DocContext = { company: CompanyInfo; quoteCode: string; contractCode: string; projectName?: string; projectCode?: string; salesName: string; salesPhone: string };

function buildDocVars(f: ComposerForm, x: DocContext) {
  const t = docTotals(f);
  const today = new Date();
  const fmt = (d: Date) => `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
  const img = (src?: string, h = 90) => (src ? `<img src="${src}" alt="" style="height:${h}px;max-width:220px;object-fit:contain;display:block;margin:6px auto">` : '<br><br><br>');
  const vars: Record<string, string> = {
    doc_code: x.quoteCode,
    contract_code: x.contractCode,
    doc_date: fmt(today),
    valid_until: fmt(new Date(today.getTime() + f.validDays * 864e5)),
    company_name: x.company.legalName,
    company_tax_code: x.company.taxCode,
    company_address: x.company.address,
    company_phone: x.company.phone,
    company_rep: x.company.representative,
    company_rep_title: x.company.representativeTitle,
    company_bank: [x.company.bankAccount, x.company.bankName].filter(Boolean).join(' tại '),
    company_logo: x.company.logo ? `<img src="${x.company.logo}" alt="" style="height:48px;display:block;margin-bottom:6px">` : '',
    company_stamp: img(x.company.stamp),
    customer_name: f.party.name,
    tax_code: f.party.taxCode,
    customer_address: f.party.address,
    customer_rep: f.party.rep,
    customer_rep_title: f.party.repTitle,
    customer_phone: f.party.phone,
    customer_email: f.party.email,
    project_name: x.projectName ?? '',
    project_code: x.projectCode ?? '',
    items_table: itemsTableHtml(f),
    subtotal: money(t.sub),
    vat_rate: `${f.vatPct}%`,
    vat_amount: money(t.vat),
    grand_total: money(t.grand),
    grand_total_words: moneyToWordsVN(t.grand),
    delivery_terms: f.delivery,
    advance_percent: `${f.advancePct}%`,
    advance_amount: money(t.advance),
    guarantee_terms: f.guaranteeType === 'NONE' ? '' : `Bên B nộp cho Bên A ${GUARANTEE_LABEL[f.guaranteeType].toLowerCase()} trị giá ${f.guaranteePct}% giá trị hợp đồng (${money(t.guarantee)}) do ngân hàng hoạt động hợp pháp tại Việt Nam phát hành.`,
    warranty_months: String(f.warrantyMonths),
    credit_days: String(f.creditDays),
    payment_method: f.paymentMethod,
    note: f.note,
    sales_name: x.salesName,
    sales_phone: x.salesPhone,
  };
  const flags: Record<string, boolean> = {
    advance: f.advancePct > 0, credit: f.creditDays > 0, no_credit: f.creditDays === 0, guarantee: f.guaranteeType !== 'NONE',
    warranty: f.warrantyMonths > 0, project: !!x.projectName, note: !!f.note.trim(),
  };
  return { vars, flags };
}

/** Ghép biến: khối {{#if}} trước, sau đó {{biến}}; tiêu đề h3.art tự đánh số "Điều N." */
/** Biến bắt buộc của bên bán / bên mua: để trống thì hiện ô vàng có tên trường (không in ra khoảng trống "MST:") */
const REQUIRED_VARS = new Set(['company_name', 'company_tax_code', 'company_address', 'company_phone', 'company_rep', 'company_bank', 'customer_name', 'tax_code', 'customer_address']);
const varLabel = (k: string) => TEMPLATE_VARS.find(([v]) => v === k)?.[1] ?? k;
/** Thông tin pháp lý công ty bán còn thiếu (dùng cho cảnh báo trong khung soạn báo giá / hợp đồng) */
const missingCompanyInfo = (c: CompanyInfo) => ([['taxCode', 'MST'], ['address', 'địa chỉ'], ['phone', 'điện thoại'], ['representative', 'người đại diện'], ['bankAccount', 'tài khoản ngân hàng']] as const).filter(([k]) => !String(c[k] ?? '').trim()).map(([, l]) => l);

function renderTemplate(body: string, vars: Record<string, string>, flags: Record<string, boolean>) {
  let out = body.replace(/\{\{#if (\w+)\}\}([\s\S]*?)\{\{\/if\}\}/g, (_m, k: string, inner: string) => (flags[k] ? inner : ''));
  out = out.replace(/\{\{(\w+)\}\}/g, (m, k: string) => (!(k in vars) ? `<span class="missing">${m}</span>` : REQUIRED_VARS.has(k) && !String(vars[k] ?? '').trim() ? `<span class="missing">[${esc(varLabel(k))}]</span>` : RAW_VARS.has(k) ? vars[k] : esc(vars[k])));
  let n = 0;
  return out.replace(/<h3 class="art">/g, () => `<h3>Điều ${++n}. `);
}

const DOC_CSS = `@page{size:A4;margin:18mm 16mm}
body{font-family:'Times New Roman',Times,serif;font-size:13pt;color:#111;line-height:1.45;margin:0;padding:16px 8px;background:#cfd3da}
.page{box-sizing:border-box;width:210mm;max-width:100%;min-height:297mm;margin:0 auto;padding:18mm 16mm;background:#fff;box-shadow:0 4px 18px rgba(0,0,0,.28)}
h1{font-size:17pt;text-align:center;margin:18px 0 4px}h3{font-size:13pt;margin:14px 0 4px}
p{margin:6px 0}ul{margin:4px 0;padding-left:22px}
table.items{width:100%;border-collapse:collapse;font-size:11.5pt;margin:8px 0}
table.items th,table.items td{border:1px solid #333;padding:4px 6px}table.items th{background:#f1f1f1}
table.layout{width:100%;border-collapse:collapse}table.layout td{vertical-align:top;padding:0}
.sign td{text-align:center;width:50%;padding-top:16px}
.r{text-align:right}.c{text-align:center}.small{font-size:10.5pt;color:#444}
.missing{background:#fde68a;color:#92400e;padding:0 2px}
@media (max-width:820px){.page{padding:10mm 8mm;min-height:0}}
@media print{body{background:#fff;padding:0}.page{width:auto;min-height:0;margin:0;padding:0;box-shadow:none}.missing{background:none;color:inherit}}`;

function docShell(title: string, body: string) {
  return `<!doctype html><html lang="vi"><head><meta charset="utf-8"><title>${esc(title)}</title><style>${DOC_CSS}</style></head><body><div class="page">${body}</div></body></html>`;
}

/** PDF: in qua iframe ẩn, người dùng chọn "Lưu dưới dạng PDF" */
function printHtml(html: string) {
  const f = document.createElement('iframe');
  Object.assign(f.style, { position: 'fixed', right: '0', bottom: '0', width: '0', height: '0', border: '0' });
  f.srcdoc = html;
  f.onload = () => {
    f.contentWindow?.focus();
    f.contentWindow?.print();
    setTimeout(() => f.remove(), 2000);
  };
  document.body.appendChild(f);
}

/** Word: HTML có khai báo Office, mở và sửa được bằng Microsoft Word (.doc) */
function downloadWord(fileBase: string, title: string, body: string) {
  const html = `<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="utf-8"><title>${esc(title)}</title><!--[if gte mso 9]><xml><w:WordDocument><w:View>Print</w:View><w:Zoom>100</w:Zoom></w:WordDocument></xml><![endif]--><style>${DOC_CSS}</style></head><body>${body}</body></html>`;
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob(['\uFEFF' + html], { type: 'application/msword' }));
  a.download = `${fileBase.replace(/[\\/:*?"<>|\s]+/g, '_')}.doc`;
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}

/** Đọc nội dung chữ từ file .docx (đọc ZIP + giải nén word/document.xml bằng DecompressionStream của trình duyệt) */
async function readDocxParagraphs(file: File): Promise<string[]> {
  const buf = new Uint8Array(await file.arrayBuffer());
  const dv = new DataView(buf.buffer);
  let eocd = -1;
  for (let i = buf.length - 22; i >= Math.max(0, buf.length - 65557); i--) if (dv.getUint32(i, true) === 0x06054b50) { eocd = i; break; }
  if (eocd < 0) throw new Error('File không đúng định dạng .docx');
  const count = dv.getUint16(eocd + 10, true);
  let p = dv.getUint32(eocd + 16, true);
  for (let n = 0; n < count; n++) {
    if (dv.getUint32(p, true) !== 0x02014b50) break;
    const method = dv.getUint16(p + 10, true);
    const csize = dv.getUint32(p + 20, true);
    const nameLen = dv.getUint16(p + 28, true), extraLen = dv.getUint16(p + 30, true), commentLen = dv.getUint16(p + 32, true);
    const local = dv.getUint32(p + 42, true);
    const name = new TextDecoder().decode(buf.subarray(p + 46, p + 46 + nameLen));
    if (name === 'word/document.xml') {
      const start = local + 30 + dv.getUint16(local + 26, true) + dv.getUint16(local + 28, true);
      const data = buf.slice(start, start + csize);
      let xml: string;
      if (method === 0) xml = new TextDecoder().decode(data);
      else if (method === 8) {
        if (typeof DecompressionStream === 'undefined') throw new Error('Trình duyệt chưa hỗ trợ giải nén, hãy dùng Chrome / Edge / Safari mới');
        xml = await new Response(new Blob([data]).stream().pipeThrough(new DecompressionStream('deflate-raw'))).text();
      } else throw new Error('Kiểu nén trong file .docx không được hỗ trợ');
      const W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
      const doc = new DOMParser().parseFromString(xml, 'application/xml');
      return Array.from(doc.getElementsByTagNameNS(W, 'p')).map((el) => Array.from(el.getElementsByTagNameNS(W, 't')).map((t) => t.textContent ?? '').join(''));
    }
    p += 46 + nameLen + extraLen + commentLen;
  }
  throw new Error('Không tìm thấy nội dung văn bản trong file .docx');
}

/** Dữ liệu mẫu để xem trước mẫu tài liệu khi chưa có khách thật */
const SAMPLE_FORM: ComposerForm = {
  txType: 'PROJECT_ME', quoteTplId: '', contractTplId: '', tier: 'PROJECT',
  party: { name: 'Công ty CP Khách Hàng Mẫu', taxCode: '0100000000', address: '123 Đường Mẫu, Quận 1, TP.HCM', rep: 'Nguyễn Văn A', repTitle: 'Giám đốc', phone: '0900 000 000', email: 'mau@example.com' },
  items: [{ sku: 'SKU-MAU-01', name: 'Sản phẩm mẫu 1', unit: 'Bộ', qty: 10, price: 1_250_000 }, { sku: 'SKU-MAU-02', name: 'Sản phẩm mẫu 2', unit: 'Cuộn', qty: 100, price: 230_000 }],
  vatPct: 10, delivery: 'Giao theo tiến độ thi công', advancePct: 30, guaranteeType: 'PERFORMANCE', guaranteePct: 10, warrantyMonths: 12, creditDays: 45,
  paymentMethod: 'Chuyển khoản', validDays: 30, note: '',
};

/** Điều khoản cần Trưởng phòng / Giám đốc duyệt trước khi xuất hợp đồng */
function specialTermsOf(f: ComposerForm, tpl: DocTemplate | undefined, customer: Customer | undefined, skus: SkuItem[]): string[] {
  const out: string[] = [];
  const t = docTotals(f);
  const std = tpl?.standardCreditDays ?? TX_TYPE[f.txType].credit;
  if (f.creditDays > std) out.push(`Công nợ ${f.creditDays} ngày, vượt mức chuẩn ${std} ngày của mẫu hợp đồng`);
  if (customer && customer.creditLimit > 0 && customer.debt + t.grand > customer.creditLimit) out.push(`Vượt hạn mức công nợ của khách: nợ hiện tại ${compact(customer.debt)} + hợp đồng ${compact(t.grand)} > hạn mức ${compact(customer.creditLimit)}`);
  const belowCost = f.items.filter((l) => { const k = skus.find((s) => s.sku === l.sku); return !!k && k.costPrice > 0 && l.price < k.costPrice; }).length;
  if (belowCost) out.push(`${belowCost} dòng hàng có đơn giá thấp hơn giá vốn`);
  return out;
}

const guessTx = (seg?: Segment): TxType =>
  seg === 'DEALER_L1' || seg === 'DEALER_L2' ? 'DEALER' : seg === 'RETAILER' ? 'RETAIL_CASH' : seg === 'FACTORY_END_USER' || seg === 'WORKSHOP' ? 'FACTORY' : seg === 'EPC_CONTRACTOR' || seg === 'INVESTOR_OWNER' || seg === 'CONSULTANT' ? 'PROJECT_ME' : 'DEALER';

const quoteLineToDoc = (x: QuoteLine): DocLine => ({ sku: x.sku, name: x.name, unit: x.unit, qty: x.qty, price: lineNet(x), listPrice: x.listPrice, discountPct: x.discountPct });
const docLineToQuote = (x: DocLine): QuoteLine => ({ sku: x.sku, name: x.name, unit: x.unit, qty: x.qty, listPrice: x.listPrice ?? x.price, discountPct: x.discountPct ?? 0 });
const partyOf = (c?: Customer, l?: Lead): ComposerForm['party'] => ({
  name: c?.name ?? l?.company ?? '', taxCode: c?.taxCode ?? l?.taxCode ?? '', address: c?.address ?? (l?.province ?? ''),
  rep: c?.contactName ?? l?.contact ?? '', repTitle: c?.contactTitle ?? '', phone: c?.contactPhone ?? l?.phone ?? '', email: c?.contactEmail ?? l?.email ?? '',
});
type ComposerMode = 'QUOTE' | 'CONTRACT';

/** Khung chung Split-View cố định: trái 38% form tối giản, phải 62% bản A4 xem trước theo thời gian thực;
 *  thanh nút hành động cố định dưới đáy. Hai cột cuộn độc lập, không cuộn dài cả trang. */
function ComposerShell({ title, subtitle, badge, left, html, footer, onClose }: { title: string; subtitle: string; badge?: ReactNode; left: ReactNode; html: string; footer: ReactNode; onClose: () => void }) {
  const { company, go, canDo } = useApp();
  const miss = missingCompanyInfo(company);
  const boxRef = useRef<HTMLDivElement>(null);
  const [zoom, setZoom] = useState(1);
  useEffect(() => {
    const el = boxRef.current;
    if (!el || typeof ResizeObserver === 'undefined') return;
    // Trang A4 rộng 210mm ≈ 794px: thu nhỏ vừa khung xem trước, không phóng to quá 100%
    const ro = new ResizeObserver(([e]) => setZoom(Math.max(0.4, Math.min(1, (e.contentRect.width - 24) / 820))));
    ro.observe(el);
    return () => ro.disconnect();
  }, []);
  const doc = docShell('Xem trước', html).replace('</head>', `<style>@media screen{html{background:#cfd3da}body{zoom:${zoom.toFixed(3)}}}</style></head>`);
  return (
    <div className="fixed inset-0 z-50 flex flex-col bg-[#0F141E] motion-safe:animate-[fadeIn_.15s_ease-out]" role="dialog" aria-modal="true" aria-label={title}>
      <header className="flex h-14 shrink-0 items-center gap-3 border-b border-[#263044] px-4 pt-[env(safe-area-inset-top)] sm:px-5">
        <span className="flex h-8 w-8 items-center justify-center rounded bg-[#F28C33]/15"><FileText className="h-4 w-4 text-[#F28C33]" aria-hidden /></span>
        <div className="min-w-0 flex-1">
          <p className="truncate text-sm font-semibold">{title}</p>
          <p className="truncate text-xs text-[#94A3B8]">{subtitle}</p>
        </div>
        {badge}
        <button className={cn(btnGhost, 'p-2')} onClick={onClose} aria-label="Đóng" title="Đóng"><X className="h-5 w-5" /></button>
      </header>
      <div className="grid min-h-0 flex-1 grid-cols-1 overflow-y-auto lg:grid-cols-[38fr_62fr] lg:overflow-hidden">
        <div className="min-w-0 space-y-4 border-[#263044] p-4 lg:overflow-y-auto lg:border-r [scrollbar-gutter:stable]">{left}</div>
        <div className="flex min-h-[75vh] min-w-0 flex-col bg-[#0B1019] lg:min-h-0">
          <p className="flex items-center gap-2 border-b border-[#263044] px-4 py-2 text-xs text-[#94A3B8]"><Eye className="h-3.5 w-3.5" aria-hidden />Xem trước khổ A4, cập nhật theo từng thao tác. Ô vàng là biến chưa có dữ liệu.<span className="ml-auto tabular-nums">{Math.round(zoom * 100)}%</span></p>
          {miss.length > 0 && (
            <p className="flex flex-wrap items-center gap-2 border-b border-[#F28C33]/30 bg-[#F28C33]/10 px-4 py-2 text-xs text-[#F7B23B]" role="status">
              <AlertTriangle className="h-3.5 w-3.5 shrink-0" aria-hidden />Thông tin bên bán ({company.legalName || company.shortName}) còn thiếu {miss.join(', ')}: các ô vàng sẽ in ra nếu xuất ngay.
              {canDo('settings.edit') && <button className="font-semibold text-[#6FA8F0] hover:underline" onClick={() => { onClose(); go('settings'); }}>Khai báo ở Cài đặt › Doanh nghiệp</button>}
            </p>
          )}
          <div ref={boxRef} className="min-h-0 flex-1">
            <iframe title="Xem trước tài liệu" className="h-full min-h-[70vh] w-full bg-[#cfd3da] lg:min-h-0" srcDoc={doc} sandbox="allow-same-origin" />
          </div>
        </div>
      </div>
      <footer className="flex shrink-0 flex-wrap items-center gap-2 border-t border-[#263044] bg-[#0B1019] px-4 py-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] sm:px-5">{footer}</footer>
    </div>
  );
}

type BarAct = { onClick: () => void; disabled?: boolean; title?: string; label?: string };
/** Thanh hành động cố định của báo giá / hợp đồng: [Xuất PDF] [Tải Word] [Chốt đơn] [Gửi duyệt] */
function DocActionBar({ status, extra, pdf, word, win, submit }: { status: ReactNode; extra?: ReactNode; pdf: BarAct; word: BarAct; win: BarAct; submit: BarAct }) {
  const b = (a: BarAct, cls: string, Icon: typeof Wallet, label: string, primary?: boolean) => (
    <button className={cn(cls, 'min-w-[112px] justify-center', primary && 'shadow-[0_0_0_1px_rgba(255,140,0,.35)]')} disabled={a.disabled} title={a.title} onClick={a.onClick}><Icon className="h-4 w-4" aria-hidden />{a.label ?? label}</button>
  );
  return (
    <>
      <div className="flex min-w-0 flex-1 flex-wrap items-center gap-2 text-xs">{status}{extra}</div>
      <div className="grid w-full grid-cols-2 gap-2 sm:flex sm:w-auto">
        {b(pdf, btnGhost, Download, 'Xuất PDF')}
        {b(word, btnGhost, FileText, 'Tải Word')}
        {b(win, cn(btnBase, 'bg-[#00B894] px-3.5 py-2 font-semibold text-[#0F141E] hover:bg-[#1FC7A2] disabled:bg-[#00B894]/30'), CheckCircle2, 'Chốt đơn')}
        {b(submit, btnPrimary, Send, 'Gửi duyệt', true)}
      </div>
    </>
  );
}

/** Nhóm gấp gọn trong form (giữ form ngắn, không phải cuộn dài) */
function Fold({ n, title, summary, open, children }: { n?: number; title: string; summary?: ReactNode; open?: boolean; children: ReactNode }) {
  return (
    <details open={open} className="group rounded-md border border-[#263044] bg-[#151C29] [&_summary::-webkit-details-marker]:hidden">
      <summary className="flex cursor-pointer select-none items-center gap-2 px-3 py-2.5 text-sm font-semibold">
        {n !== undefined && <span className="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#F28C33] text-[11px] font-bold text-[#0F141E]">{n}</span>}
        <span className={cn('shrink-0', n === undefined && 'text-xs font-medium text-[#94A3B8]')}>{title}</span>
        {summary && <span className="min-w-0 flex-1 truncate text-right text-xs font-normal text-[#94A3B8]">{summary}</span>}
        <ChevronDown className="ml-auto h-4 w-4 shrink-0 text-[#94A3B8] transition-transform group-open:rotate-180" aria-hidden />
      </summary>
      <div className="border-t border-[#263044] p-3">{children}</div>
    </details>
  );
}

/** Bảng dòng hàng nhập bằng bàn phím: Tab đi qua SL → Giá → CK; Enter xuống dòng kế tiếp, dòng cuối nhảy tới ô thêm SKU */
function useGridKeys() {
  const ref = useRef<HTMLDivElement>(null);
  const focusCell = (r: number, c = 0) => setTimeout(() => {
    const el = ref.current?.querySelector<HTMLInputElement>(`[data-r="${r}"][data-c="${c}"]`) ?? ref.current?.querySelector<HTMLInputElement>('[data-picker] input, [data-picker] select');
    el?.focus(); el?.select?.();
  }, 0);
  const onKeyDown = (e: RKeyboardEvent<HTMLDivElement>) => {
    const t = e.target as HTMLElement;
    if (e.key !== 'Enter' || t.dataset.r === undefined) return;
    e.preventDefault();
    focusCell(Number(t.dataset.r) + 1, e.shiftKey ? Number(t.dataset.c) : 0);
  };
  return { ref, onKeyDown, focusCell };
}

const secHead = (n: number, title: string) => <h3 className="mb-3 flex items-center gap-2 text-sm font-semibold"><span className="flex h-6 w-6 items-center justify-center rounded-full bg-[#F28C33] text-xs font-bold text-[#0F141E]">{n}</span>{title}</h3>;

/** Ô điều khoản dùng chung cho báo giá và hợp đồng */
function TermsFields({ form, set, cTpl, contract, part = 'all' }: { form: ComposerForm; set: <K extends keyof ComposerForm>(k: K, v: ComposerForm[K]) => void; cTpl?: DocTemplate; contract: boolean; part?: 'all' | 'pay' | 'other' }) {
  const pay = part !== 'other';
  const other = part !== 'pay';
  return (
    <div className="grid grid-cols-2 gap-3">
      {other && <Field label="Tiến độ / địa điểm giao hàng" className="col-span-2"><input className={inputCls} value={form.delivery} onChange={(e) => set('delivery', e.target.value)} /></Field>}
      {pay && <><Field label="Tạm ứng (%)"><input className={inputCls} type="number" min={0} max={100} value={form.advancePct} onChange={(e) => set('advancePct', Number(e.target.value))} /></Field>
      <Field label="Công nợ (ngày)" hint={contract ? `Chuẩn của mẫu: ${cTpl?.standardCreditDays ?? 0} ngày` : undefined}><input className={inputCls} type="number" min={0} value={form.creditDays} onChange={(e) => set('creditDays', Number(e.target.value))} /></Field></>}
      {pay && contract && (
        <>
          <Field label="Bảo lãnh">
            <select className={inputCls} value={form.guaranteeType} onChange={(e) => set('guaranteeType', e.target.value as GuaranteeType)}>
              {(Object.keys(GUARANTEE_LABEL) as GuaranteeType[]).map((g) => <option key={g} value={g}>{GUARANTEE_LABEL[g]}</option>)}
            </select>
          </Field>
          <Field label="Giá trị bảo lãnh (%)"><input className={inputCls} type="number" min={0} max={100} disabled={form.guaranteeType === 'NONE'} value={form.guaranteePct} onChange={(e) => set('guaranteePct', Number(e.target.value))} /></Field>
        </>
      )}
      {other && <Field label="Bảo hành (tháng)"><input className={inputCls} type="number" min={0} value={form.warrantyMonths} onChange={(e) => set('warrantyMonths', Number(e.target.value))} /></Field>}
      {pay && !contract && <Field label="Hiệu lực báo giá (ngày)"><input className={inputCls} type="number" min={1} value={form.validDays} onChange={(e) => set('validDays', Number(e.target.value))} /></Field>}
      {pay && <Field label="Hình thức thanh toán" className={!contract ? undefined : 'col-span-2'}><input className={inputCls} value={form.paymentMethod} onChange={(e) => set('paymentMethod', e.target.value)} /></Field>}
      {other && <Field label="Ghi chú" className="col-span-2"><textarea className={cn(inputCls, 'min-h-16')} value={form.note} onChange={(e) => set('note', e.target.value)} /></Field>}
    </div>
  );
}

function PartyFields({ form, setParty }: { form: ComposerForm; setParty: (k: keyof ComposerForm['party'], v: string) => void }) {
  return (
    <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
      <Field label="Tên pháp nhân *" className="sm:col-span-2 lg:col-span-1 xl:col-span-2"><input className={inputCls} value={form.party.name} onChange={(e) => setParty('name', e.target.value)} /></Field>
      <Field label="Mã số thuế"><input className={inputCls} value={form.party.taxCode} onChange={(e) => setParty('taxCode', e.target.value)} /></Field>
      <Field label="Điện thoại"><input className={inputCls} value={form.party.phone} onChange={(e) => setParty('phone', e.target.value)} /></Field>
      <Field label="Địa chỉ" className="sm:col-span-2 lg:col-span-1 xl:col-span-2"><input className={inputCls} value={form.party.address} onChange={(e) => setParty('address', e.target.value)} /></Field>
      <Field label="Người đại diện"><input className={inputCls} value={form.party.rep} onChange={(e) => setParty('rep', e.target.value)} /></Field>
      <Field label="Chức vụ"><input className={inputCls} value={form.party.repTitle} onChange={(e) => setParty('repTitle', e.target.value)} /></Field>
    </div>
  );
}

// =====================================================================
//  MÀN BÁO GIÁ — chỉ ghi khi bấm "Tạo báo giá" / "Lưu thay đổi"; xuất file sau khi đã lưu
// =====================================================================

function QuoteComposer({ leadId, customerId, quoteId, onClose }: { leadId?: string; customerId?: string; quoteId?: string; onClose: () => void }) {
  const { leads, myLeads, customers, skus, company, users, me, role, docTemplates, quotes, setQuotes, submitQuote, notify, canDo, getfly, openComposer, dispatch, departments, logDecision, winLead } = useApp();
  const grid = useGridKeys();
  const editQuote = quotes.find((q) => q.id === quoteId);
  // Báo giá đã tạo chỉ xem; muốn thay đổi phải tạo báo giá điều chỉnh (phiên bản mới)
  const viewOnly = !!editQuote;
  const year = new Date().getFullYear();
  const suggestQuote = (tx: TxType) => docTemplates.find((t) => t.kind === 'QUOTE' && t.txType === tx) ?? docTemplates.find((t) => t.kind === 'QUOTE');
  const itemsOfLead = (l?: Lead): DocLine[] => {
    if (!l) return [];
    const q = latestQuote(l.id, quotes);
    if (q) return q.lines.map(quoteLineToDoc);
    return (l.boqItems ?? []).map((i) => ({ sku: i.code, name: i.name, unit: i.unit, qty: i.qty, price: Math.round(i.price * (1 - i.discountPct / 100)), listPrice: i.price, discountPct: i.discountPct }));
  };
  const [initial] = useState<ComposerForm>(() => {
    const l = leads.find((x) => x.id === (editQuote?.leadId || leadId));
    const c = customers.find((x) => x.id === (editQuote?.customerId ?? customerId ?? l?.customerId)) ?? (l ? findByTax(customers, l.taxCode) : undefined);
    if (editQuote?.quoteForm) return { ...editQuote.quoteForm, items: editQuote.lines.map(quoteLineToDoc), vatPct: editQuote.vatPct };
    const prev = l ? latestQuote(l.id, quotes) : undefined;
    const tpl = docTemplates.find((t) => t.id === (editQuote?.templateId ?? prev?.templateId)) ?? suggestQuote(guessTx(c?.segment ?? l?.segment));
    const tx = tpl?.txType ?? guessTx(c?.segment ?? l?.segment);
    const base = prev?.quoteForm;
    return {
      txType: tx, quoteTplId: tpl?.id ?? '', contractTplId: tpl?.pairId ?? '', tier: editQuote?.tier ?? prev?.tier ?? (l?.boqItems?.length ? 'BOQ' : TX_TYPE[tx].tier),
      leadId: l?.id, customerId: c?.id, party: base?.party ?? partyOf(c, l), items: editQuote ? editQuote.lines.map(quoteLineToDoc) : itemsOfLead(l), vatPct: editQuote?.vatPct ?? prev?.vatPct ?? (getfly.defaultVatPct || 10),
      delivery: base?.delivery ?? tpl?.defaultDelivery ?? TX_TYPE[tx].delivery, advancePct: base?.advancePct ?? 0, guaranteeType: 'NONE', guaranteePct: 0, warrantyMonths: base?.warrantyMonths ?? 12,
      creditDays: base?.creditDays ?? TX_TYPE[tx].credit, paymentMethod: base?.paymentMethod ?? 'Chuyển khoản', validDays: 30, note: editQuote?.note ?? '',
    };
  });
  const [form, setForm] = useState<ComposerForm>(initial);
  const [savedId, setSavedId] = useState<string | undefined>(editQuote?.id);
  const saved = quotes.find((q) => q.id === savedId);
  const lead = leads.find((x) => x.id === form.leadId);
  const versions = lead ? quotes.filter((q) => q.leadId === lead.id) : [];
  const [code] = useState(() => editQuote?.code ?? nextCode(quotes.map((q) => q.code), `BG-${year}-`, 4));
  const version = saved?.version ?? editQuote?.version ?? versions.reduce((m, x) => Math.max(m, x.version), 0) + 1;
  const locked = viewOnly || !!savedId;

  const set = <K extends keyof ComposerForm>(k: K, v: ComposerForm[K]) => setForm((p) => ({ ...p, [k]: v }));
  const setParty = (k: keyof ComposerForm['party'], v: string) => setForm((p) => ({ ...p, party: { ...p.party, [k]: v } }));
  const setItem = (i: number, p: Partial<DocLine>) => setForm((f) => ({ ...f, items: f.items.map((x, j) => {
    if (j !== i) return x;
    const n = { ...x, ...p };
    if (p.listPrice !== undefined || p.discountPct !== undefined) n.price = Math.round((n.listPrice ?? n.price) * (1 - (n.discountPct ?? 0) / 100));
    return n;
  }) }));

  const qTpl = docTemplates.find((t) => t.id === form.quoteTplId);
  const totals = docTotals(form);
  const seller = users.find((u) => u.id === lead?.assignee) ?? me;
  const { vars, flags } = buildDocVars(form, { company, quoteCode: code, contractCode: '', projectName: lead?.boqNote, projectCode: lead?.code, salesName: seller.name, salesPhone: seller.phone ?? company.phone });
  const html = qTpl ? renderTemplate(qTpl.body, vars, flags) : '<p>Chưa chọn mẫu báo giá</p>';
  const canSeeCost = canDo('price.viewCost');
  const costSum = form.items.reduce((a, l) => a + l.qty * (skus.find((s) => s.sku === l.sku)?.costPrice ?? 0), 0);
  const costKnown = form.items.length > 0 && form.items.every((l) => (skus.find((s) => s.sku === l.sku)?.costPrice ?? 0) > 0);
  const gm = costKnown && totals.sub > 0 ? ((totals.sub - costSum) / totals.sub) * 100 : null;
  const level = approvalOf(gm, totals.sub);
  const reasons = approvalReasons(gm, totals.sub);
  const errs: string[] = [];
  if (form.party.name.trim().length < 3) errs.push('Nhập tên khách hàng');
  if (!form.items.length) errs.push('Thêm ít nhất 1 dòng hàng hóa');
  if (form.items.some((l) => l.qty <= 0 || l.price <= 0)) errs.push('Số lượng và đơn giá phải lớn hơn 0');
  if (!qTpl) errs.push('Chọn mẫu báo giá');
  if (!lead && !form.customerId) errs.push('Chọn dự án hoặc khách hàng trong CRM để lưu báo giá');

  const applyTier = (tier: PriceTier) => setForm((f) => ({ ...f, tier, items: tier === 'BOQ' ? (lead?.boqItems?.length ? lead.boqItems.map((i) => ({ sku: i.code, name: i.name, unit: i.unit, qty: i.qty, price: Math.round(i.price * (1 - i.discountPct / 100)), listPrice: i.price, discountPct: i.discountPct })) : f.items) : f.items.map((l) => { const k = skus.find((s) => s.sku === l.sku); if (!k) return l; const lp = tierPrice(k, tier); return { ...l, listPrice: lp, price: Math.round(lp * (1 - (l.discountPct ?? 0) / 100)) }; }) }));
  const pickProject = (id: string) => {
    const l = leads.find((x) => x.id === id);
    const c = customers.find((x) => x.id === l?.customerId) ?? (l ? findByTax(customers, l.taxCode) : undefined);
    setForm((f) => ({ ...f, leadId: l?.id, customerId: c?.id ?? f.customerId, party: l ? partyOf(c, l) : f.party, items: l ? itemsOfLead(l) : f.items }));
  };
  /** Thêm SKU từ ô tìm (Enter) rồi đưa con trỏ vào ô Số lượng của dòng mới */
  const addLineSku = (sku: string) => {
    const k = skus.find((s) => s.sku === sku);
    if (!k || form.items.some((l) => l.sku === sku)) return;
    const lp = tierPrice(k, form.tier === 'BOQ' ? TX_TYPE[form.txType].tier : form.tier);
    setForm((f) => ({ ...f, items: [...f.items, { sku: k.sku, name: k.name, unit: k.unit, qty: 1, price: lp, listPrice: lp, discountPct: 0 }] }));
    grid.focusCell(form.items.length, 0);
  };

  /** Tạo báo giá: ghi một phiên bản mới rồi khóa lại (không sửa đè) */
  const save = () => {
    if (locked) return;
    if (errs.length) return notify(errs[0], 'red');
    const q: Quote = {
      id: uid('q'), code, leadId: lead?.id ?? '', version, date: todayISO(), discountPct: 0, status: 'SENT', exports: [],
      lines: form.items.map(docLineToQuote), amount: totals.sub, vatPct: form.vatPct, tier: form.tier, templateId: form.quoteTplId, gmPct: gm ?? undefined, approvalLevel: level,
      validUntil: iso(new Date(Date.now() + form.validDays * 864e5)), note: form.note, customerId: form.customerId, quoteForm: form,
      createdBy: me.id, createdAt: Date.now(),
      approval: level === 'AUTO' ? undefined : { status: 'PENDING', level, reasons, requestedAt: Date.now(), requestedBy: me.id },
    };
    setQuotes((p) => [q, ...p.map((x) => (lead && x.leadId === lead.id && x.status === 'SENT' ? { ...x, status: 'REVISED' as QuoteStatus } : x))]);
    if (lead?.status === 'ACCEPTED') submitQuote(lead.id);
    setSavedId(q.id);
    if (q.approval) {
      const head = users.find((u) => u.id === departments.find((d) => d.code === lead?.dept)?.headId && u.active);
      const bods = users.filter((u) => u.active && u.role === 'BOD');
      dispatch('QUOTE_APPROVAL', { lead, toAll: level === 'BOD' ? bods : [head, ...bods].filter((u): u is User => !!u), title: `Báo giá chờ duyệt: ${form.party.name}`, body: `${code} v${version}, ${compact(totals.sub)}. ${reasons.join('; ')}` });
      notify(`Đã tạo báo giá ${code} v${version}, gửi ${APPROVAL_LEVEL[level].label.replace('Cần ', '')}. Xuất PDF sau khi được duyệt.`, 'orange');
    } else notify(`Đã tạo báo giá ${code} v${version}: ${compact(totals.sub)} trước VAT`, 'teal');
  };
  const approval = saved?.approval;
  const exportLocked = !!approval && approval.status !== 'APPROVED';
  const canDecide = !!saved && approval?.status === 'PENDING' && approval.requestedBy !== me.id && canDo('quote.approve') && (approval.level === 'BOD' ? role === 'BOD' : role === 'BOD' || (role === 'DEPT_HEAD' && lead?.dept === me.dept));
  const decideQuote = (d: ApprovalDecision, note?: string) => {
    if (!saved || !approval) return;
    setQuotes((p) => p.map((x) => (x.id === saved.id ? { ...x, approval: { ...approval, status: d, decidedBy: me.id, decidedAt: Date.now(), note } } : x)));
    logDecision({ kind: 'QUOTE', refId: saved.id, title: `${saved.code} v${saved.version}: ${form.party.name}`, requesterId: approval.requestedBy, decision: d, note, amount: saved.amount });
    const req = users.find((u) => u.id === approval.requestedBy);
    dispatch('APPROVAL_RESULT', { to: req, title: `${d === 'APPROVED' ? 'Đã duyệt' : 'Từ chối'} báo giá ${saved.code}`, body: d === 'APPROVED' ? 'Đã mở khóa xuất PDF / Word.' : note ?? '' });
    notify(d === 'APPROVED' ? 'Đã duyệt giá, báo giá được mở khóa xuất file' : 'Đã từ chối báo giá', d === 'APPROVED' ? 'teal' : 'orange');
  };
  const exportQuote = (format: 'PDF' | 'WORD') => {
    if (!savedId) return notify('Bấm "Tạo báo giá" trước khi xuất file', 'orange');
    if (exportLocked) return notify('Báo giá đang chờ duyệt giá, chưa xuất được', 'orange');
    const title = `Báo giá ${code}`;
    if (format === 'PDF') printHtml(docShell(title, html)); else downloadWord(code, title, html);
    setQuotes((p) => p.map((x) => (x.id === savedId ? { ...x, exports: [...(x.exports ?? []), { format, at: todayISO(), by: me.id }] } : x)));
  };

  const projectOpts = myLeads.filter((l) => ['ACCEPTED', 'QUOTED', 'WON'].includes(l.status));
  const left = (
    <>
      {approval && (
        <div className={cn('rounded-md border p-3 text-sm', approval.status === 'APPROVED' ? 'border-[#00B894]/50 bg-[#00B894]/10 text-[#3DDBB6]' : approval.status === 'PENDING' ? 'border-[#F28C33] bg-[#F28C33]/10 text-[#F7B23B]' : 'border-[#EF4444]/50 bg-[#EF4444]/10 text-[#F87171]')}>
          <p className="font-semibold">{approval.status === 'PENDING' ? `Chờ ${approval.level === 'BOD' ? 'BOD' : 'Trưởng phòng'} duyệt giá` : approval.status === 'APPROVED' ? 'Đã duyệt giá' : approval.status === 'NEED_INFO' ? 'Được yêu cầu bổ sung' : 'Bị từ chối'}</p>
          <p className="text-xs text-[#94A3B8]">{approval.reasons.join('; ')}{approval.note ? `. Ghi chú: ${approval.note}` : ''}</p>
        </div>
      )}
      {locked && <p className="rounded border border-[#263044] bg-[#1C2534] p-3 text-xs text-[#94A3B8]">Báo giá đã tạo chỉ xem và xuất lại. Muốn thay đổi giá, số lượng hoặc điều kiện, bấm "Báo giá điều chỉnh" để tạo phiên bản mới.</p>}
      <fieldset disabled={locked} className="space-y-4">
        <div className="grid grid-cols-[1fr_auto_auto] items-end gap-2 [&>*:first-child]:min-w-0">
          <Field label="Mẫu báo giá">
            <select className={inputCls} value={form.quoteTplId} onChange={(e) => { const t = docTemplates.find((x) => x.id === e.target.value); setForm((f) => ({ ...f, quoteTplId: e.target.value, txType: t?.txType ?? f.txType, contractTplId: t?.pairId ?? f.contractTplId })); }}>
              {docTemplates.filter((t) => t.kind === 'QUOTE').map((t) => <option key={t.id} value={t.id}>{t.name}</option>)}
            </select>
          </Field>
          <Field label="Bảng giá">
            <select className={cn(inputBase, 'w-auto max-w-[130px]')} value={form.tier} onChange={(e) => applyTier(e.target.value as PriceTier)}>
              {(Object.keys(PRICE_TIER) as PriceTier[]).map((t) => <option key={t} value={t} disabled={t === 'BOQ' && !lead?.boqItems?.length}>{PRICE_TIER[t]}</option>)}
            </select>
          </Field>
          <Field label="VAT %"><input className={cn(inputBase, 'w-16 text-right tabular-nums')} type="number" min={0} max={10} value={form.vatPct} onChange={(e) => set('vatPct', Number(e.target.value))} /></Field>
        </div>

        <section>
          {secHead(1, 'Khách hàng')}
          <div className="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
            <Field label="Khách hàng CRM">
              <select className={inputCls} value={form.customerId ?? ''} onChange={(e) => { const c = customers.find((x) => x.id === e.target.value); setForm((f) => ({ ...f, customerId: c?.id, party: c ? partyOf(c) : f.party })); }}>
                <option value="">Chọn khách hàng</option>
                {customers.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
              </select>
            </Field>
            <Field label="Dự án">
              <select className={inputCls} value={form.leadId ?? ''} disabled={!!savedId} onChange={(e) => pickProject(e.target.value)}>
                <option value="">Không gắn dự án</option>
                {projectOpts.map((l) => <option key={l.id} value={l.id}>{l.company}: {l.boqNote}</option>)}
              </select>
            </Field>
          </div>
          <div className="mt-2">
            <Fold title="Thông tin pháp nhân trên báo giá" summary={[form.party.name, form.party.taxCode && `MST ${form.party.taxCode}`, form.party.phone].filter(Boolean).join(' · ') || 'Chưa có'} open={!form.party.name}>
              <PartyFields form={form} setParty={setParty} />
            </Fold>
          </div>
        </section>

        <section>
          {secHead(2, `Hàng hóa (${form.items.length} SKU)`)}
          <div ref={grid.ref} onKeyDown={grid.onKeyDown} className="overflow-visible rounded-md border border-[#263044]">
            <table className="w-full table-fixed text-xs">
              <colgroup><col /><col className="w-[58px]" /><col className="w-[92px]" /><col className="w-[50px]" /><col className="w-[92px]" /><col className="w-7" /></colgroup>
              <thead className="bg-[#1C2534] text-[11px] text-[#94A3B8]">
                <tr><th className="rounded-tl-xl px-2 py-1.5 text-left font-medium">Mã / tên hàng</th><th className="px-1 text-right font-medium">SL</th><th className="px-1 text-right font-medium">Giá niêm yết</th><th className="px-1 text-right font-medium">CK %</th><th className="px-2 text-right font-medium">Thành tiền</th><th className="rounded-tr-xl" /></tr>
              </thead>
              <tbody>
                {form.items.map((l, i) => {
                  const k = skus.find((s) => s.sku === l.sku);
                  const lineGm = k?.costPrice && l.price ? ((l.price - k.costPrice) / l.price) * 100 : null;
                  return (
                    <tr key={`${l.sku}-${i}`} className="border-t border-[#263044] align-top hover:bg-[#1C2534]/60">
                      <td className="px-2 py-1.5"><p className="truncate font-mono text-[11px] text-[#F7B23B]">{l.sku}</p><p className="truncate text-[#F1F5F9]" title={l.name}>{l.name}</p></td>
                      <td className="px-1 py-1.5"><input data-r={i} data-c={0} className={'w-full rounded-md border border-transparent bg-[#0F141E] px-1.5 py-1 text-right text-xs tabular-nums text-[#F1F5F9] [appearance:textfield] focus:border-[#F28C33] focus:outline-none disabled:opacity-70 [&::-webkit-inner-spin-button]:appearance-none'} type="number" min={0} value={l.qty} onChange={(e) => setItem(i, { qty: Number(e.target.value) })} aria-label={`Số lượng ${l.sku}`} /><p className="mt-0.5 text-right text-[10px] text-[#94A3B8]">{l.unit}</p></td>
                      <td className="px-1 py-1.5"><input data-r={i} data-c={1} className={'w-full rounded-md border border-transparent bg-[#0F141E] px-1.5 py-1 text-right text-xs tabular-nums text-[#F1F5F9] [appearance:textfield] focus:border-[#F28C33] focus:outline-none disabled:opacity-70 [&::-webkit-inner-spin-button]:appearance-none'} inputMode="numeric" value={(l.listPrice ?? l.price) ? (l.listPrice ?? l.price).toLocaleString('vi-VN') : ''} onChange={(e) => setItem(i, { listPrice: digits(e.target.value) })} aria-label={`Giá niêm yết ${l.sku}`} /></td>
                      <td className="px-1 py-1.5"><input data-r={i} data-c={2} className={'w-full rounded-md border border-transparent bg-[#0F141E] px-1.5 py-1 text-right text-xs tabular-nums text-[#F1F5F9] [appearance:textfield] focus:border-[#F28C33] focus:outline-none disabled:opacity-70 [&::-webkit-inner-spin-button]:appearance-none'} type="number" min={0} max={100} step={0.5} value={l.discountPct ?? 0} onChange={(e) => setItem(i, { discountPct: Number(e.target.value) })} aria-label={`Chiết khấu ${l.sku}`} /></td>
                      <td className="px-2 py-1.5 text-right tabular-nums"><p className="font-medium text-[#F1F5F9]">{(l.qty * l.price).toLocaleString('vi-VN')}</p>{canSeeCost && lineGm !== null && <p className={cn('text-[10px]', lineGm < 10 ? 'text-[#F87171]' : 'text-[#94A3B8]')}>GM {lineGm.toFixed(1)}%</p>}</td>
                      <td className="py-1.5 pr-1 text-center"><button tabIndex={-1} className="rounded p-1 text-[#94A3B8] hover:text-[#F87171]" onClick={() => set('items', form.items.filter((_, j) => j !== i))} aria-label={`Bỏ ${l.sku}`}><Trash2 className="h-3.5 w-3.5" /></button></td>
                    </tr>
                  );
                })}
                {!form.items.length && <tr><td colSpan={6} className="px-3 py-4 text-center text-[#94A3B8]">Chưa có dòng hàng. Gõ mã hoặc tên SKU bên dưới, Enter để thêm.</td></tr>}
              </tbody>
            </table>
            {!locked && <div className="border-t border-[#263044] p-2"><SkuPicker value="" onChange={addLineSku} exclude={form.items.map((l) => l.sku)} /></div>}
            <div className="grid grid-cols-3 gap-px rounded-b-xl border-t border-[#263044] bg-[#263044] text-xs tabular-nums">
              <p className="bg-[#151C29] px-2 py-1.5 text-right"><span className="block text-[10px] text-[#94A3B8]">Cộng tiền hàng</span>{totals.sub.toLocaleString('vi-VN')}</p>
              <p className="bg-[#151C29] px-2 py-1.5 text-right"><span className="block text-[10px] text-[#94A3B8]">VAT {form.vatPct}%</span>{totals.vat.toLocaleString('vi-VN')}</p>
              <p className="bg-[#151C29] px-2 py-1.5 text-right font-semibold text-[#F7B23B]"><span className="block text-[10px] font-normal text-[#94A3B8]">Tổng cộng (đ)</span>{totals.grand.toLocaleString('vi-VN')}</p>
            </div>
          </div>
          <div className="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-[#94A3B8]">
            <span className="hidden lg:inline"><kbd className="rounded border border-[#263044] px-1">Tab</kbd> sang ô kế, <kbd className="rounded border border-[#263044] px-1">Enter</kbd> xuống dòng / thêm SKU</span>
            <span className="ml-auto">{canSeeCost ? (gm !== null ? `Biên gộp ${gm.toFixed(1)}%` : 'Thiếu giá vốn một số SKU') : ''}</span>
            {level !== 'AUTO' && <Chip tone={APPROVAL_LEVEL[level].tone}>{APPROVAL_LEVEL[level].label}</Chip>}
          </div>
          {!locked && reasons.length > 0 && <p className="mt-1 text-[11px] text-[#F7B23B]">{reasons.join('; ')}. Bấm "Gửi duyệt" để chuyển cấp duyệt giá.</p>}
        </section>

        <section>
          {secHead(3, 'Điều khoản thanh toán')}
          <TermsFields form={form} set={set} contract={false} part="pay" />
          <div className="mt-2">
            <Fold title="Giao hàng, bảo hành, ghi chú" summary={`${form.delivery || 'Chưa nhập giao hàng'} · BH ${form.warrantyMonths} th`}>
              <TermsFields form={form} set={set} contract={false} part="other" />
            </Fold>
          </div>
        </section>
      </fieldset>
      {errs.length > 0 && !locked && <ul className="space-y-0.5 text-xs text-[#F87171]">{errs.map((x) => <li key={x}>{x}</li>)}</ul>}
    </>
  );

  const canRevise = !!lead && ['ACCEPTED', 'QUOTED'].includes(lead.status);
  const canWin = !!savedId && !exportLocked && !!lead && lead.status === 'QUOTED' && canDo('project.update');
  const winHint = !lead ? 'Gắn báo giá với dự án để chốt đơn' : lead.status === 'WON' ? 'Dự án đã chốt' : !savedId ? 'Gửi duyệt báo giá trước' : exportLocked ? 'Chờ duyệt giá' : !canDo('project.update') ? 'Không có quyền chốt đơn' : `Chốt đơn theo báo giá ${code} v${version}`;
  const winNow = () => {
    if (!canWin || !lead || !savedId) return;
    winLead(lead.id, savedId);
    onClose();
  };
  return (
    <ComposerShell
      title={`${locked ? 'Báo giá' : 'Tạo báo giá'} ${code} v${version}`}
      subtitle={`${form.party.name || 'Khách hàng'}${lead ? `, dự án ${lead.code}` : ''}`}
      badge={saved ? <Chip tone={QUOTE_STATUS[saved.status].tone}>{QUOTE_STATUS[saved.status].label}</Chip> : undefined}
      left={left}
      html={html}
      onClose={onClose}
      footer={
        <DocActionBar
          status={<span className={cn('font-medium', locked ? 'text-[#3DDBB6]' : errs.length ? 'text-[#F87171]' : level === 'AUTO' ? 'text-[#94A3B8]' : 'text-[#F7B23B]')}>{locked ? (exportLocked ? 'Đã gửi, chờ duyệt giá' : lead?.status === 'WON' ? 'Đơn đã chốt' : 'Đã duyệt, xuất file / chốt đơn được') : errs.length ? `Còn thiếu: ${errs[0]}` : level === 'AUTO' ? `Giá trong ngưỡng: gửi là tự duyệt, tạo bản v${version}` : `${APPROVAL_LEVEL[level].label}: gửi để duyệt giá`}</span>}
          extra={<>
            {locked && canRevise && <button className={cn(btnGhost, btnSm)} onClick={() => { onClose(); openComposer({ leadId: lead!.id, mode: 'QUOTE' }); }}><Pencil className="h-3.5 w-3.5" aria-hidden />Báo giá điều chỉnh</button>}
            {canDecide && (
              <>
                <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E]')} onClick={() => decideQuote('APPROVED')}>Duyệt giá</button>
                <button className={cn(btnBase, btnSm, 'bg-[#EF4444]/15 text-[#F87171]')} onClick={() => { const n = window.prompt('Lý do từ chối / yêu cầu sửa giá'); if (n && n.trim().length >= 3) decideQuote('REJECTED', n.trim()); }}>Từ chối</button>
              </>
            )}
          </>}
          pdf={{ onClick: () => exportQuote('PDF'), disabled: !savedId || exportLocked, title: !savedId ? 'Gửi duyệt (lưu phiên bản) trước khi xuất' : exportLocked ? 'Chờ duyệt giá' : 'In / lưu PDF' }}
          word={{ onClick: () => exportQuote('WORD'), disabled: !savedId || exportLocked, title: !savedId ? 'Gửi duyệt (lưu phiên bản) trước khi xuất' : exportLocked ? 'Chờ duyệt giá' : 'Tải file Word (.doc)' }}
          win={{ onClick: winNow, disabled: !canWin, title: winHint }}
          submit={{ onClick: save, disabled: locked || errs.length > 0, label: locked ? 'Đã gửi' : undefined, title: locked ? 'Muốn đổi giá hoặc điều kiện: tạo báo giá điều chỉnh' : errs[0] ?? (level === 'AUTO' ? 'Lưu phiên bản, tự duyệt vì giá trong ngưỡng' : `Lưu phiên bản và gửi ${APPROVAL_LEVEL[level].label.replace('Cần ', '')}`) }}
        />
      }
    />
  );
}

// =====================================================================
//  MÀN HỢP ĐỒNG — có phiên bản. Bản đã lưu chỉ xem; sửa = tạo phiên bản mới.
//  Có điều khoản đặc biệt: nút chính là "Gửi phê duyệt" (bản ghi ở trạng thái Chờ duyệt).
// =====================================================================

function ContractComposer({ leadId, quoteId, docId, view, onClose }: { leadId?: string; quoteId?: string; docId?: string; view?: boolean; onClose: () => void }) {
  const { leads, customers, skus, company, users, me, role, docTemplates, genDocs, setGenDocs, quotes, notify, dispatch, canDo, openComposer, logDecision, winLead } = useApp();
  const lead0 = leads.find((x) => x.id === leadId);
  const baseId0 = genDocs.find((d) => d.id === docId)?.quoteId ?? quoteId ?? lead0?.wonQuoteId ?? (lead0 ? latestQuote(lead0.id, quotes)?.id : undefined);
  // Nguồn: bản được chỉ định, hoặc bản mới nhất đã có của báo giá này (tránh tạo trùng nhóm hợp đồng)
  const src = genDocs.find((d) => d.id === docId) ?? latestContracts(genDocs).find((d) => d.quoteId === baseId0);
  const viewOnly = !!view && !!src;
  const group = src ? docGroupOf(src) : undefined;
  const nextVersion = group ? Math.max(...genDocs.filter((d) => docGroupOf(d) === group).map((d) => d.version ?? 1)) + 1 : 1;
  const isLatest = !src || latestContracts(genDocs).some((d) => d.id === src.id);

  const [baseId, setBaseId] = useState<string | undefined>(src?.quoteId ?? baseId0);
  const base = quotes.find((q) => q.id === baseId);
  const baseLead = leads.find((l) => l.id === base?.leadId) ?? lead0 ?? leads.find((l) => l.id === src?.leadId);
  const options = quotes.filter((q) => q.lines.length && (baseLead ? q.leadId === baseLead.id : true));

  const formFromQuote = (q?: Quote): ComposerForm => {
    const l = leads.find((x) => x.id === q?.leadId) ?? lead0;
    const c = customers.find((x) => x.id === (q?.customerId ?? l?.customerId)) ?? (l ? findByTax(customers, l.taxCode) : undefined);
    const qt = docTemplates.find((t) => t.id === q?.templateId);
    const tx = qt?.txType ?? guessTx(c?.segment ?? l?.segment);
    const ct = docTemplates.find((t) => t.id === qt?.pairId) ?? docTemplates.find((t) => t.kind === 'CONTRACT' && t.txType === tx) ?? docTemplates.find((t) => t.kind === 'CONTRACT');
    const qf = q?.quoteForm;
    const project = tx === 'PROJECT_ME' || tx === 'EPC_SUB' || tx === 'SUPPLY_INSTALL';
    return {
      txType: tx, quoteTplId: q?.templateId ?? '', contractTplId: ct?.id ?? '', tier: q?.tier ?? 'PROJECT', leadId: l?.id, customerId: c?.id ?? q?.customerId,
      party: qf?.party ?? partyOf(c, l), items: (q?.lines ?? []).map(quoteLineToDoc), vatPct: q?.vatPct ?? 10,
      delivery: qf?.delivery ?? ct?.defaultDelivery ?? TX_TYPE[tx].delivery, advancePct: qf?.advancePct || (project ? 30 : 0), guaranteeType: project ? 'PERFORMANCE' : 'NONE', guaranteePct: project ? 10 : 0,
      warrantyMonths: qf?.warrantyMonths ?? 12, creditDays: qf?.creditDays ?? ct?.standardCreditDays ?? TX_TYPE[tx].credit, paymentMethod: qf?.paymentMethod ?? 'Chuyển khoản', validDays: 30, note: '',
    };
  };
  const [form, setForm] = useState<ComposerForm>(() => src?.form ?? formFromQuote(quotes.find((q) => q.id === baseId0)));
  const [savedId, setSavedId] = useState<string | undefined>(undefined);
  const shown = genDocs.find((d) => d.id === (savedId ?? (viewOnly ? src?.id : undefined)));
  const locked = viewOnly || !!savedId;
  const [code] = useState(() => src?.contractCode ?? `${String(Math.max(0, ...genDocs.map((d) => Number(d.contractCode.match(/^(\d+)/)?.[1] ?? 0))) + 1).padStart(4, '0')}/${new Date().getFullYear()}/HĐ-${company.shortName || 'CTY'}`);
  const version = shown?.version ?? (src && !viewOnly ? nextVersion : src?.version ?? 1);
  const set = <K extends keyof ComposerForm>(k: K, v: ComposerForm[K]) => setForm((p) => ({ ...p, [k]: v }));
  const setParty = (k: keyof ComposerForm['party'], v: string) => setForm((p) => ({ ...p, party: { ...p.party, [k]: v } }));

  const customer = customers.find((x) => x.id === form.customerId);
  const cTpl = docTemplates.find((t) => t.id === form.contractTplId);
  const totals = docTotals(form);
  const special = specialTermsOf(form, cTpl, customer, skus);
  const seller = users.find((u) => u.id === baseLead?.assignee) ?? me;
  const { vars, flags } = buildDocVars(form, { company, quoteCode: base?.code ?? '', contractCode: version > 1 ? `${code} (v${version})` : code, projectName: baseLead?.boqNote, projectCode: baseLead?.code, salesName: seller.name, salesPhone: seller.phone ?? company.phone });
  const html = cTpl ? renderTemplate(cTpl.body, vars, flags) : '<p>Chưa chọn mẫu hợp đồng</p>';
  const docDept = baseLead?.dept ?? customer?.dept;
  const canApprove = canDo('contract.approve') && (role === 'BOD' || (role === 'DEPT_HEAD' && docDept === me.dept));
  const canEdit = canDo('project.update') || canDo('customer.edit');
  const canExport = !!shown && (shown.status === 'ISSUED' || shown.status === 'APPROVED');
  const canWinC = canExport && !!baseLead && !!baseId && baseLead.status === 'QUOTED' && canDo('project.update');
  const errs: string[] = [];
  if (!base) errs.push('Chọn báo giá làm căn cứ hợp đồng');
  if (form.party.name.trim().length < 3) errs.push('Nhập tên pháp nhân bên mua');
  if (!cTpl) errs.push('Chọn mẫu hợp đồng');

  const pickBase = (id: string) => {
    const q = quotes.find((x) => x.id === id);
    setBaseId(id);
    if (q) setForm((f) => ({ ...f, items: q.lines.map(quoteLineToDoc), vatPct: q.vatPct, quoteTplId: q.templateId ?? f.quoteTplId }));
  };

  /** Tạo phiên bản: không có điều khoản đặc biệt -> hiệu lực; có -> chờ duyệt và gửi thông báo */
  const create = () => {
    if (locked) return;
    if (errs.length) return notify(errs[0], 'red');
    const needApproval = special.length > 0;
    const id = uid('gd');
    const rec: GeneratedDoc = {
      id, groupId: group ?? id, version: src ? nextVersion : 1, quoteCode: base?.code ?? '', contractCode: code, leadId: baseLead?.id, customerId: form.customerId, partyName: form.party.name,
      form, total: totals.grand, special, status: needApproval ? 'PENDING_APPROVAL' : 'ISSUED', fingerprint: JSON.stringify(form), createdAt: todayISO(), createdBy: me.id, quoteId: baseId, exports: [], submittedAt: needApproval ? Date.now() : undefined,
    };
    setGenDocs((all) => [rec, ...all.map((d) => (group && docGroupOf(d) === group && d.status !== 'SUPERSEDED' ? { ...d, status: 'SUPERSEDED' as GenDocStatus } : d))]);
    setSavedId(id);
    if (needApproval) {
      dispatch('CONTRACT_APPROVAL', { lead: baseLead, title: `Hợp đồng chờ duyệt: ${form.party.name}`, body: `${code} v${rec.version}, ${compact(totals.grand)}. ${special.join('; ')}`, module: 'tasks' });
      notify(`Đã gửi phê duyệt hợp đồng ${code} v${rec.version}`, 'teal');
    } else notify(`Đã tạo hợp đồng ${code} v${rec.version}, có hiệu lực`, 'teal');
  };
  const decide = (ok: boolean) => {
    if (!shown) return;
    setGenDocs((all) => all.map((d) => (d.id === shown.id ? { ...d, ...(ok ? { status: 'APPROVED' as GenDocStatus, approvedBy: me.id, approvedAt: todayISO() } : { status: 'REJECTED' as GenDocStatus, rejectNote: 'Từ chối tại màn hợp đồng' }) } : d)));
    logDecision({ kind: 'CONTRACT', refId: shown.id, title: `${shown.contractCode} v${shown.version ?? 1}: ${shown.partyName}`, requesterId: shown.createdBy, decision: ok ? 'APPROVED' : 'REJECTED', amount: shown.total });
    notify(ok ? 'Đã duyệt hợp đồng' : 'Đã từ chối hợp đồng', ok ? 'teal' : 'orange');
  };
  const exportContract = (format: 'PDF' | 'WORD') => {
    if (!shown || !canExport) return;
    const file = `${code.replace(/\//g, '-')}${(shown.version ?? 1) > 1 ? `-v${shown.version}` : ''}`;
    const title = `Hợp đồng ${file}`;
    if (format === 'PDF') printHtml(docShell(title, html)); else downloadWord(file, title, html);
    setGenDocs((all) => all.map((d) => (d.id === shown.id ? { ...d, exports: [...d.exports, { kind: 'CONTRACT', format, at: todayISO(), by: me.id }] } : d)));
  };

  const left = (
    <>
      {special.length > 0 && !locked && (
        <div className="rounded-md border-2 border-[#F28C33] bg-[#F28C33]/15 p-4">
          <p className="flex items-center gap-2 font-semibold text-[#F7B23B]"><AlertTriangle className="h-5 w-5" aria-hidden />Hợp đồng cần phê duyệt</p>
          <ul className="mt-1 list-disc space-y-0.5 pl-6 text-sm text-[#F7B23B]">{special.map((x) => <li key={x}>{x}</li>)}</ul>
          <p className="mt-2 text-xs text-[#94A3B8]">Bấm "Gửi phê duyệt" ở cuối màn hình. Hoặc chỉnh điều khoản về mức chuẩn để tạo hợp đồng ngay.</p>
        </div>
      )}
      {locked && shown && (
        <div className={cn('rounded-md border p-3 text-sm', shown.status === 'PENDING_APPROVAL' ? 'border-[#F28C33]/60 bg-[#F28C33]/10 text-[#F7B23B]' : shown.status === 'REJECTED' ? 'border-[#EF4444]/50 bg-[#EF4444]/10 text-[#F87171]' : shown.status === 'SUPERSEDED' ? 'border-[#263044] bg-[#1C2534] text-[#94A3B8]' : 'border-[#00B894]/50 bg-[#00B894]/10 text-[#3DDBB6]')}>
          <p className="font-semibold">Phiên bản v{shown.version ?? 1}: {GENDOC_STATUS[shown.status].label}</p>
          <p className="mt-0.5 text-xs text-[#94A3B8]">{shown.status === 'PENDING_APPROVAL' ? `Chờ duyệt: ${shown.special.join('; ')}` : shown.status === 'REJECTED' ? `Lý do: ${shown.rejectNote ?? '—'}. Bấm "Sửa, tạo phiên bản mới" để điều chỉnh.` : shown.status === 'SUPERSEDED' ? 'Đã có phiên bản mới hơn, bản này chỉ để tra cứu.' : 'Xuất PDF / Word ở cuối màn hình.'}</p>
        </div>
      )}
      <fieldset disabled={locked} className="space-y-4">
        <section>
          {secHead(1, 'Căn cứ & mẫu hợp đồng')}
          <div className="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
            {options.length ? (
              <Field label="Báo giá căn cứ">
                <select className={inputCls} value={baseId ?? ''} onChange={(e) => pickBase(e.target.value)}>
                  <option value="" disabled>Chọn báo giá...</option>
                  {options.map((q) => <option key={q.id} value={q.id}>{q.code} v{q.version}, {compact(q.amount)}{q.status === 'ACCEPTED' ? ' (khách đã chốt)' : ''}</option>)}
                </select>
              </Field>
            ) : <p className="rounded bg-[#F28C33]/10 p-3 text-sm text-[#F7B23B]">Chưa có báo giá có dòng hàng hóa để làm căn cứ.</p>}
            <Field label="Mẫu hợp đồng">
              <select className={inputCls} value={form.contractTplId} onChange={(e) => set('contractTplId', e.target.value)}>
                {docTemplates.filter((t) => t.kind === 'CONTRACT').map((t) => <option key={t.id} value={t.id}>{t.name}</option>)}
              </select>
            </Field>
          </div>
          {base && (
            <div className="mt-2 overflow-hidden rounded-md border border-[#263044]">
              <table className="w-full table-fixed text-xs">
                <colgroup><col /><col className="w-14" /><col className="w-[100px]" /></colgroup>
                <thead className="bg-[#1C2534] text-[11px] text-[#94A3B8]"><tr><th className="px-2 py-1.5 text-left font-medium">Hàng hóa (kế thừa báo giá)</th><th className="px-2 text-right font-medium">SL</th><th className="px-2 text-right font-medium">Thành tiền</th></tr></thead>
                <tbody>
                  {form.items.map((l) => <tr key={l.sku} className="border-t border-[#263044]"><td className="truncate px-2 py-1.5" title={l.name}>{l.name}</td><td className="px-2 text-right tabular-nums">{l.qty.toLocaleString('vi-VN')}</td><td className="px-2 text-right tabular-nums">{(l.qty * l.price).toLocaleString('vi-VN')}</td></tr>)}
                </tbody>
                <tfoot><tr className="border-t border-[#263044] bg-[#1C2534]/60 font-semibold"><td className="px-2 py-1.5" colSpan={2}>Tổng sau VAT {form.vatPct}%</td><td className="px-2 text-right tabular-nums text-[#F7B23B]">{totals.grand.toLocaleString('vi-VN')}</td></tr></tfoot>
              </table>
              <p className="border-t border-[#263044] px-2 py-1.5 text-[11px] italic text-[#94A3B8]">{moneyToWordsVN(totals.grand)}</p>
            </div>
          )}
        </section>
        <section>
          {secHead(2, 'Bên mua')}
          <Fold title="Pháp nhân, đại diện ký" summary={[form.party.name, form.party.taxCode && `MST ${form.party.taxCode}`, form.party.rep].filter(Boolean).join(' · ') || 'Chưa có'} open={!form.party.name}>
            <PartyFields form={form} setParty={setParty} />
          </Fold>
        </section>
        <section>
          {secHead(3, 'Điều khoản thanh toán')}
          <TermsFields form={form} set={set} cTpl={cTpl} contract part="pay" />
          <div className="mt-2">
            <Fold title="Giao hàng, bảo hành, ghi chú" summary={`${form.delivery || 'Chưa nhập giao hàng'} · BH ${form.warrantyMonths} th`}>
              <TermsFields form={form} set={set} cTpl={cTpl} contract part="other" />
            </Fold>
          </div>
        </section>
      </fieldset>
      {!locked && errs.length > 0 && <ul className="space-y-0.5 text-xs text-[#F87171]">{errs.map((x) => <li key={x}>{x}</li>)}</ul>}
    </>
  );

  return (
    <ComposerShell
      title={`${locked ? 'Hợp đồng' : src ? 'Sửa hợp đồng' : 'Tạo hợp đồng'} ${code} v${version}`}
      subtitle={`${form.party.name || 'Bên mua'}${base ? `, căn cứ báo giá ${base.code} v${base.version}` : ''}`}
      badge={shown ? <Chip tone={GENDOC_STATUS[shown.status].tone}>{GENDOC_STATUS[shown.status].label}</Chip> : undefined}
      left={left}
      html={html}
      onClose={onClose}
      footer={
        <DocActionBar
          status={<span className={cn('font-medium', !locked ? (errs.length ? 'text-[#F87171]' : special.length ? 'text-[#F7B23B]' : 'text-[#94A3B8]') : canExport ? 'text-[#3DDBB6]' : 'text-[#F7B23B]')}>{!locked ? (errs.length ? `Còn thiếu: ${errs[0]}` : special.length ? `Cần duyệt: ${special[0]}${special.length > 1 ? ` (+${special.length - 1})` : ''}` : src ? `Gửi sẽ tạo v${nextVersion}, bản cũ chuyển "Đã thay thế"` : 'Điều khoản chuẩn: gửi là có hiệu lực ngay') : canExport ? 'Hợp đồng có hiệu lực' : shown?.status === 'PENDING_APPROVAL' ? 'Chờ phê duyệt, chưa xuất được' : 'Chỉ xem'}</span>}
          extra={<>
            {locked && shown?.status === 'PENDING_APPROVAL' && canApprove && (
              <>
                <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} onClick={() => decide(true)}>Duyệt</button>
                <button className={cn(btnBase, btnSm, 'bg-[#EF4444]/15 text-[#F87171]')} onClick={() => decide(false)}>Từ chối</button>
              </>
            )}
            {viewOnly && isLatest && canEdit && shown?.status !== 'PENDING_APPROVAL' && <button className={cn(btnGhost, btnSm)} onClick={() => { onClose(); openComposer({ docId: src!.id, mode: 'CONTRACT' }); }}><Pencil className="h-3.5 w-3.5" aria-hidden />Sửa, tạo phiên bản mới</button>}
          </>}
          pdf={{ onClick: () => exportContract('PDF'), disabled: !canExport, title: canExport ? 'In / lưu PDF' : 'Chỉ xuất hợp đồng có hiệu lực' }}
          word={{ onClick: () => exportContract('WORD'), disabled: !canExport, title: canExport ? 'Tải file Word (.doc)' : 'Chỉ xuất hợp đồng có hiệu lực' }}
          win={{ onClick: () => { if (baseLead && baseId) { winLead(baseLead.id, baseId); onClose(); } }, disabled: !canWinC, title: !baseLead ? 'Hợp đồng chưa gắn dự án' : baseLead.status === 'WON' ? 'Dự án đã chốt' : !canExport ? 'Hợp đồng phải có hiệu lực (đã duyệt) trước khi chốt' : `Chốt đơn theo báo giá ${base?.code ?? ''}` }}
          submit={{ onClick: create, disabled: locked || errs.length > 0, label: locked ? 'Đã gửi' : special.length ? undefined : src ? `Gửi v${nextVersion}` : undefined, title: locked ? 'Phiên bản đã lưu, chỉ xem' : special.length ? 'Gửi phê duyệt điều khoản đặc biệt' : 'Điều khoản chuẩn: tạo hợp đồng có hiệu lực ngay' }}
        />
      }
    />
  );
}

/** Mở đúng màn: báo giá hoặc hợp đồng */
function DocComposerModal({ mode = 'QUOTE', leadId, customerId, docId, quoteId, view, onClose }: { mode?: ComposerMode; leadId?: string; customerId?: string; docId?: string; quoteId?: string; view?: boolean; onClose: () => void }) {
  return mode === 'CONTRACT' || docId
    ? <ContractComposer leadId={leadId} quoteId={quoteId} docId={docId} view={view} onClose={onClose} />
    : <QuoteComposer leadId={leadId} customerId={customerId} quoteId={quoteId} onClose={onClose} />;
}

// ---------------- Danh sách hợp đồng (bản mới nhất mỗi hợp đồng, xem lịch sử phiên bản) ----------------

function useContractApprover() {
  const { canDo, role, me, leads, customers } = useApp();
  return (d: GeneratedDoc) => {
    const dp = leads.find((l) => l.id === d.leadId)?.dept ?? customers.find((c) => c.id === d.customerId)?.dept;
    return canDo('contract.approve') && (role === 'BOD' || (role === 'DEPT_HEAD' && dp === me.dept));
  };
}

/** Bản ghi hợp đồng: chỉ xem; duyệt nhanh nếu có quyền. Sửa bằng nút "Mở hợp đồng" ở đầu ngăn dự án */
function GeneratedDocList({ leadId, customerId }: { leadId?: string; customerId?: string; compact?: boolean }) {
  const { genDocs, setGenDocs, openComposer, me, notify, userName, logDecision } = useApp();
  const canApprove = useContractApprover();
  const [open, setOpen] = useState<string | null>(null);
  const list = latestContracts(genDocs.filter((d) => (!leadId || d.leadId === leadId) && (!customerId || d.customerId === customerId)))
    .sort((a, b) => Number(b.status === 'PENDING_APPROVAL') - Number(a.status === 'PENDING_APPROVAL') || b.createdAt.localeCompare(a.createdAt));
  const decide = (d: GeneratedDoc, ok: boolean) => {
    setGenDocs((all) => all.map((x) => (x.id === d.id ? { ...x, ...(ok ? { status: 'APPROVED' as GenDocStatus, approvedBy: me.id, approvedAt: todayISO() } : { status: 'REJECTED' as GenDocStatus, rejectNote: 'Từ chối từ danh sách hợp đồng' }) } : x)));
    logDecision({ kind: 'CONTRACT', refId: d.id, title: `${d.contractCode} v${d.version ?? 1}: ${d.partyName}`, requesterId: d.createdBy, decision: ok ? 'APPROVED' : 'REJECTED', amount: d.total });
    notify(ok ? `Đã duyệt ${d.contractCode}` : `Đã từ chối ${d.contractCode}`, ok ? 'teal' : 'orange');
  };
  if (!list.length) return <p className="text-sm text-[#94A3B8]">Chưa có hợp đồng.</p>;
  return (
    <ul className="divide-y divide-[#263044] rounded-md border border-[#263044]">
      {list.map((d) => {
        const versions = contractVersions(genDocs, docGroupOf(d));
        return (
          <li key={d.id} className="px-3 py-2.5 text-sm">
            <div className="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span className="min-w-0 flex-1"><b>{d.contractCode}</b> <span className="text-xs text-[#94A3B8]">v{d.version ?? 1}, căn cứ {d.quoteCode || '—'}, {fmtDate(d.createdAt)}, {userName(d.createdBy)}</span></span>
              <span className="tabular-nums">{compact(d.total)}</span>
              <Chip tone={GENDOC_STATUS[d.status].tone}>{GENDOC_STATUS[d.status].label}</Chip>
            </div>
            {d.status === 'PENDING_APPROVAL' && <p className="mt-1 text-xs text-[#F7B23B]">{d.special.join('; ')}</p>}
            {d.status === 'REJECTED' && d.rejectNote && <p className="mt-1 text-xs text-[#F87171]">Từ chối: {d.rejectNote}</p>}
            <div className="mt-1.5 flex flex-wrap items-center gap-1.5">
              <button className={cn(btnGhost, btnSm)} onClick={() => openComposer({ docId: d.id, view: true })}><Eye className="h-3.5 w-3.5" aria-hidden />Xem</button>
              {d.status === 'PENDING_APPROVAL' && canApprove(d) && (
                <>
                  <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E]')} onClick={() => decide(d, true)}>Duyệt</button>
                  <button className={cn(btnBase, btnSm, 'bg-[#EF4444]/15 text-[#F87171]')} onClick={() => decide(d, false)}>Từ chối</button>
                </>
              )}
              {versions.length > 1 && <button className="ml-auto text-xs text-[#6FA8F0] hover:underline" onClick={() => setOpen(open === d.id ? null : d.id)}>{open === d.id ? 'Ẩn' : `${versions.length} phiên bản`}</button>}
            </div>
            {open === d.id && (
              <ul className="mt-2 space-y-1 border-l-2 border-[#263044] pl-3">
                {versions.slice(1).map((v) => (
                  <li key={v.id} className="flex items-center gap-2 text-xs text-[#94A3B8]">
                    <span className="flex-1">v{v.version ?? 1}, {fmtDate(v.createdAt)}, {compact(v.total)}</span>
                    <Chip tone={GENDOC_STATUS[v.status].tone}>{GENDOC_STATUS[v.status].label}</Chip>
                    <button className="text-[#6FA8F0] hover:underline" onClick={() => openComposer({ docId: v.id, view: true })}>Xem</button>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
    </ul>
  );
}

// ---------------- Quản lý mẫu báo giá & hợp đồng ----------------

function TemplateEditorModal({ tpl, draft, onClose }: { tpl?: DocTemplate; draft?: Partial<DocTemplate>; onClose: () => void }) {
  const { docTemplates, setDocTemplates, company, notify } = useApp();
  const [f, setF] = useState<DocTemplate>(() => tpl ?? {
    id: uid('tpl'), kind: 'QUOTE', name: '', txType: 'DEALER', body: quoteBody('Mẫu mới', 'Điều khoản riêng của mẫu.'), standardCreditDays: 30, defaultTier: 'BASE', defaultDelivery: TX_TYPE.DEALER.delivery, updatedAt: todayISO(), ...draft,
  });
  const [touched, setTouched] = useState(false);
  const area = useRef<HTMLTextAreaElement>(null);
  const set = <K extends keyof DocTemplate>(k: K, v: DocTemplate[K]) => setF((p) => ({ ...p, [k]: v }));
  const insert = (token: string) => {
    const el = area.current;
    if (!el) return set('body', f.body + token);
    const s = el.selectionStart, e = el.selectionEnd;
    set('body', f.body.slice(0, s) + token + f.body.slice(e));
    requestAnimationFrame(() => { el.focus(); el.selectionStart = el.selectionEnd = s + token.length; });
  };
  const sample = buildDocVars({ ...SAMPLE_FORM, txType: f.txType }, { company, quoteCode: 'BG-2026-0001', contractCode: '0001/2026/HĐ', projectName: 'Dự án mẫu', projectCode: 'LD-2026-0001', salesName: 'Nhân viên mẫu', salesPhone: '0900 000 000' });
  const unknown = Array.from(new Set(Array.from(f.body.matchAll(/\{\{(\w+)\}\}/g)).map((m) => m[1]).filter((k) => !TEMPLATE_VARS.some(([v]) => v === k))));
  const err = f.name.trim().length < 3 ? 'Nhập tên mẫu' : !f.body.trim() ? 'Nội dung mẫu trống' : '';
  const save = () => {
    setTouched(true);
    if (err) return;
    const clean = { ...f, name: f.name.trim(), updatedAt: todayISO(), pairId: f.kind === 'QUOTE' ? f.pairId : undefined };
    setDocTemplates((all) => (all.some((t) => t.id === clean.id) ? all.map((t) => (t.id === clean.id ? clean : t)) : [...all, clean]));
    notify(`Đã lưu mẫu ${clean.name}`, 'teal');
    onClose();
  };
  return (
    <div className="fixed inset-0 z-50 flex flex-col bg-[#0F141E]" role="dialog" aria-modal="true" aria-label="Soạn mẫu tài liệu">
      <header className="flex items-center gap-3 border-b border-[#263044] px-4 py-3 pt-[calc(0.75rem+env(safe-area-inset-top))] sm:px-6">
        <FileText className="h-5 w-5 text-[#F28C33]" aria-hidden />
        <p className="flex-1 truncate font-semibold">{tpl ? `Sửa mẫu: ${tpl.name}` : 'Thêm mẫu mới'}</p>
        <button className={btnGhost} onClick={onClose}>Hủy</button>
        <button className={btnPrimary} onClick={save}>Lưu mẫu</button>
      </header>
      <div className="grid min-h-0 flex-1 grid-cols-1 overflow-y-auto lg:grid-cols-2 lg:overflow-hidden">
        <div className="space-y-3 p-4 sm:p-6 lg:overflow-y-auto">
          <div className="grid grid-cols-2 gap-3">
            <Field label="Tên mẫu *" error={touched && err === 'Nhập tên mẫu' ? err : undefined} className="col-span-2"><input className={inputCls} value={f.name} onChange={(e) => set('name', e.target.value)} /></Field>
            <Field label="Loại mẫu">
              <select className={inputCls} value={f.kind} onChange={(e) => set('kind', e.target.value as DocTemplate['kind'])} disabled={!!tpl}>
                <option value="QUOTE">Báo giá</option>
                <option value="CONTRACT">Hợp đồng</option>
              </select>
            </Field>
            <Field label="Loại hình giao dịch">
              <select className={inputCls} value={f.txType} onChange={(e) => set('txType', e.target.value as TxType)}>
                {(Object.keys(TX_TYPE) as TxType[]).map((t) => <option key={t} value={t}>{TX_TYPE[t].label}</option>)}
              </select>
            </Field>
            {f.kind === 'QUOTE' ? (
              <Field label="Mẫu hợp đồng đi kèm" className="col-span-2">
                <select className={inputCls} value={f.pairId ?? ''} onChange={(e) => set('pairId', e.target.value || undefined)}>
                  <option value="">Không ghép cặp</option>
                  {docTemplates.filter((t) => t.kind === 'CONTRACT').map((t) => <option key={t.id} value={t.id}>{t.name}</option>)}
                </select>
              </Field>
            ) : (
              <Field label="Công nợ chuẩn (ngày)" hint="Hợp đồng vượt mức này cần duyệt"><input className={inputCls} type="number" min={0} value={f.standardCreditDays} onChange={(e) => set('standardCreditDays', Number(e.target.value))} /></Field>
            )}
            <Field label="Bảng giá mặc định">
              <select className={inputCls} value={f.defaultTier} onChange={(e) => set('defaultTier', e.target.value as PriceTier)}>
                {(Object.keys(PRICE_TIER) as PriceTier[]).map((t) => <option key={t} value={t}>{PRICE_TIER[t]}</option>)}
              </select>
            </Field>
            <Field label="Tiến độ giao hàng mặc định" className="col-span-2"><input className={inputCls} value={f.defaultDelivery} onChange={(e) => set('defaultDelivery', e.target.value)} /></Field>
          </div>
          <div className="flex flex-wrap items-end gap-2">
            <Field label="Chèn biến tại con trỏ">
              <select className={cn(inputBase, 'w-auto')} value="" onChange={(e) => e.target.value && insert(e.target.value)}>
                <option value="">Chọn biến...</option>
                <optgroup label="Biến">{TEMPLATE_VARS.map(([k, d]) => <option key={k} value={`{{${k}}}`}>{`{{${k}}}`}: {d}</option>)}</optgroup>
                <optgroup label="Khối điều kiện">{TEMPLATE_FLAGS.map(([k, d]) => <option key={k} value={`{{#if ${k}}}...{{/if}}`}>{`{{#if ${k}}}`}: {d}</option>)}</optgroup>
              </select>
            </Field>
            <button className={cn(btnGhost, btnSm)} onClick={() => insert('<h3 class="art">Tên điều khoản</h3>\n<p></p>')}>Chèn điều khoản tự đánh số</button>
          </div>
          <Field label="Nội dung mẫu (HTML + biến)" error={touched && err === 'Nội dung mẫu trống' ? err : undefined}>
            <textarea ref={area} className={cn(inputCls, 'min-h-[45vh] font-mono text-xs leading-relaxed')} value={f.body} onChange={(e) => set('body', e.target.value)} spellCheck={false} />
          </Field>
          {unknown.length > 0 && <p className="text-xs text-[#F7B23B]">Biến không được hỗ trợ (sẽ hiện ô vàng): {unknown.map((k) => `{{${k}}}`).join(', ')}</p>}
          {f.sourceFile && <p className="text-xs text-[#94A3B8]">File Word gốc: <a className="text-[#6FA8F0] hover:underline" href={f.sourceFile.url} download={f.sourceFile.name}>{f.sourceFile.name}</a></p>}
        </div>
        <div className="flex min-h-[60vh] flex-col border-[#263044] bg-[#0B1019] lg:min-h-0 lg:border-l">
          <p className="border-b border-[#263044] px-4 py-2 text-xs text-[#94A3B8]">Xem trước với dữ liệu mẫu</p>
          <iframe title="Xem trước mẫu" className="min-h-[55vh] w-full flex-1 bg-white" srcDoc={docShell('Xem trước mẫu', renderTemplate(f.body, sample.vars, sample.flags))} sandbox="allow-same-origin" />
        </div>
      </div>
    </div>
  );
}

function TemplateManager() {
  const { docTemplates, setDocTemplates, company, canDo, notify } = useApp();
  const canEdit = canDo('template.manage');
  const [editing, setEditing] = useState<{ tpl?: DocTemplate; draft?: Partial<DocTemplate> } | null>(null);
  const [viewing, setViewing] = useState<DocTemplate | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const [q, setQ] = useState('');
  const t = q.trim().toLowerCase();
  const list = (kind: DocTemplate['kind']) => docTemplates.filter((x) => x.kind === kind && (!t || x.name.toLowerCase().includes(t) || TX_TYPE[x.txType].label.toLowerCase().includes(t)));
  const nameOf = (id?: string) => docTemplates.find((x) => x.id === id)?.name ?? '—';
  const sample = buildDocVars(SAMPLE_FORM, { company, quoteCode: 'BG-2026-0001', contractCode: '0001/2026/HĐ', projectName: 'Dự án mẫu', projectCode: 'LD-2026-0001', salesName: 'Nhân viên mẫu', salesPhone: '0900 000 000' });

  const importWord = async (files: File[]) => {
    const file = files[0];
    if (!/\.docx$/i.test(file.name)) return notify('Chọn file Word định dạng .docx', 'red');
    try {
      const paras = await readDocxParagraphs(file);
      const body = paras.map((p) => (p.trim() === '{{items_table}}' ? '{{items_table}}' : p.trim() ? `<p>${esc(p)}</p>` : '<p>&nbsp;</p>')).join('\n');
      const kind: DocTemplate['kind'] = /hợp đồng|hop dong|contract/i.test(file.name) ? 'CONTRACT' : 'QUOTE';
      setEditing({ draft: { name: file.name.replace(/\.docx$/i, ''), kind, body, sourceFile: { name: file.name, url: URL.createObjectURL(file) } } });
      notify(`Đã đọc ${paras.filter((p) => p.trim()).length} đoạn văn từ ${file.name}. Kiểm tra biến rồi lưu mẫu.`, 'teal');
    } catch (e) {
      notify(e instanceof Error ? e.message : 'Không đọc được file Word', 'red');
    }
  };
  const duplicate = (x: DocTemplate) => setEditing({ draft: { ...x, id: uid('tpl'), name: `${x.name} (bản sao)`, system: false, sourceFile: undefined } });
  const askDelete = (x: DocTemplate) => setConfirm({
    title: 'Xóa mẫu', message: <>Xóa mẫu <b>{x.name}</b>?</>,
    blocked: x.system ? 'Mẫu hệ thống không xóa được; có thể sửa nội dung hoặc nhân bản.' : undefined,
    onConfirm: () => { setDocTemplates((all) => all.filter((y) => y.id !== x.id).map((y) => (y.pairId === x.id ? { ...y, pairId: undefined } : y))); notify(`Đã xóa mẫu ${x.name}`, 'orange'); },
  });
  const table = (kind: DocTemplate['kind']) => (
    <Table head={['Tên mẫu', 'Loại giao dịch', kind === 'QUOTE' ? 'Hợp đồng đi kèm' : 'Công nợ chuẩn', 'Nguồn', 'Cập nhật', '']} minW={820}>
      {list(kind).map((x) => (
        <tr key={x.id} className={rowCls}>
          <td className={tdFirst}><p className="font-medium text-[#F1F5F9]">{x.name}</p></td>
          <td className={tdCls}>{TX_TYPE[x.txType].label}</td>
          <td className={cn(tdCls, 'text-xs')}>{kind === 'QUOTE' ? nameOf(x.pairId) : `${x.standardCreditDays} ngày`}</td>
          <td className={tdCls}><Chip tone={x.sourceFile ? 'blue' : x.system ? 'muted' : 'orange'}>{x.sourceFile ? 'Từ file Word' : x.system ? 'Hệ thống' : 'Tùy chỉnh'}</Chip></td>
          <td className={cn(tdCls, 'tabular-nums')}>{fmtDate(x.updatedAt)}</td>
          <td className={cn(tdLast, 'whitespace-nowrap text-right')}>
            <button className={cn(btnGhost, 'mr-1 p-1.5')} onClick={() => setViewing(x)} aria-label={`Xem ${x.name}`}><Eye className="h-3.5 w-3.5" /></button>
            <button className={cn(btnGhost, 'mr-1 p-1.5')} disabled={!canEdit} onClick={() => setEditing({ tpl: x })} aria-label={`Sửa ${x.name}`}><Pencil className="h-3.5 w-3.5" /></button>
            <RowMenu items={[
              { label: 'Nhân bản', icon: Copy, onClick: () => duplicate(x), disabled: !canEdit },
              ...(x.sourceFile ? [{ label: 'Tải file Word gốc', icon: Download, onClick: () => { const a = document.createElement('a'); a.href = x.sourceFile!.url; a.download = x.sourceFile!.name; a.click(); } }] : []),
              { label: 'Xóa mẫu', icon: Trash2, danger: true, onClick: () => askDelete(x), disabled: !canEdit },
            ]} />
          </td>
        </tr>
      ))}
    </Table>
  );

  return (
    <div className="space-y-4">
      <div className="flex flex-col gap-2 rounded-md border border-[#263044] bg-[#151C29] p-2 sm:flex-row sm:items-center">
        <div className="relative flex-1">
          <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#94A3B8]" aria-hidden />
          <input className={cn(inputCls, 'border-[#263044] bg-[#0F141E] py-2 pl-9')} value={q} onChange={(e) => setQ(e.target.value)} placeholder="Tìm mẫu theo tên hoặc loại giao dịch..." aria-label="Tìm mẫu" />
        </div>
        <FilePicker accept=".docx" onFiles={importWord} disabled={!canEdit} className={cn(btnGhost, 'justify-center py-2')}><Upload className="h-4 w-4" aria-hidden />Tải lên file Word (.docx) mẫu</FilePicker>
        <button className={cn(btnPrimary, 'justify-center py-2')} disabled={!canEdit} onClick={() => setEditing({})}><Plus className="h-4 w-4" aria-hidden />Thêm mẫu mới</button>
      </div>

      <Collapse title="Biến mẫu được hỗ trợ" summary={`${TEMPLATE_VARS.length} biến, ${TEMPLATE_FLAGS.length} khối điều kiện`}>
        <div className="grid grid-cols-1 gap-1.5 sm:grid-cols-2 xl:grid-cols-3">
          {TEMPLATE_VARS.map(([k, d]) => (
            <button key={k} className="flex items-center justify-between gap-2 rounded bg-[#1C2534] px-3 py-2 text-left text-xs hover:bg-[#263044]" onClick={() => navigator.clipboard?.writeText(`{{${k}}}`).then(() => notify(`Đã sao chép {{${k}}}`, 'teal'))}>
              <code className="text-[#F7B23B]">{`{{${k}}}`}</code><span className="truncate text-[#94A3B8]">{d}</span>
            </button>
          ))}
        </div>
        <p className="mb-1.5 mt-4 text-xs font-medium text-[#94A3B8]">Khối điều kiện (hiện nội dung khi điều kiện đúng, không lồng nhau)</p>
        <div className="grid grid-cols-1 gap-1.5 sm:grid-cols-2 xl:grid-cols-3">
          {TEMPLATE_FLAGS.map(([k, d]) => (
            <button key={k} className="flex items-center justify-between gap-2 rounded bg-[#1C2534] px-3 py-2 text-left text-xs hover:bg-[#263044]" onClick={() => navigator.clipboard?.writeText(`{{#if ${k}}}...{{/if}}`).then(() => notify('Đã sao chép khối điều kiện', 'teal'))}>
              <code className="text-[#6FA8F0]">{`{{#if ${k}}}`}</code><span className="truncate text-[#94A3B8]">{d}</span>
            </button>
          ))}
        </div>
        <p className="mt-3 text-xs text-[#94A3B8]">Tiêu đề viết dạng {'<h3 class="art">Tên điều</h3>'} được tự đánh số "Điều 1, Điều 2..." theo các khối đang hiện.</p>
      </Collapse>

      <Panel title={`Mẫu báo giá (${list('QUOTE').length})`}>{table('QUOTE')}</Panel>
      <Panel title={`Mẫu hợp đồng (${list('CONTRACT').length})`}>{table('CONTRACT')}</Panel>

      {editing && <TemplateEditorModal tpl={editing.tpl} draft={editing.draft} onClose={() => setEditing(null)} />}
      {viewing && (
        <Modal title={viewing.name} onClose={() => setViewing(null)} wide footer={<button className={btnPrimary} onClick={() => setViewing(null)}>Đóng</button>}>
          <iframe title="Xem trước mẫu" className="h-[65vh] w-full rounded border border-[#263044] bg-white" srcDoc={docShell(viewing.name, renderTemplate(viewing.body, sample.vars, sample.flags))} sandbox="allow-same-origin" />
        </Modal>
      )}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

/** Báo giá & Hợp đồng: hai bảng tách riêng, mỗi dòng là một bộ (phiên bản mới nhất), mở rộng để xem các phiên bản */
function SalesDocsPanel() {
  const { quotes, genDocs, setGenDocs, leads, customers, openComposer, canDo, me, notify, logDecision } = useApp();
  const canApprove = useContractApprover();
  const inR = useInRange();
  const [view, setView] = useState<'QUOTE' | 'CONTRACT'>('QUOTE');
  const [q, setQ] = useState('');
  const [st, setSt] = useState('ALL');
  const [open, setOpen] = useState<string | null>(null);
  const t = q.trim().toLowerCase();
  const nameOfQuote = (x: Quote) => x.quoteForm?.party.name ?? customers.find((c) => c.id === x.customerId)?.name ?? leads.find((l) => l.id === x.leadId)?.company ?? '—';

  // ---- Báo giá: gom theo dự án (hoặc khách hàng nếu không gắn dự án) ----
  const groups = new Map<string, Quote[]>();
  for (const x of quotes) { const k = x.leadId || `c:${x.customerId ?? x.id}`; groups.set(k, [...(groups.get(k) ?? []), x]); }
  const quoteRows = Array.from(groups.entries()).map(([key, xs]) => {
    const versions = [...xs].sort((a, b) => b.version - a.version);
    return { key, latest: versions[0], versions, lead: leads.find((l) => l.id === versions[0].leadId) };
  });
  const qFiltered = quoteRows.filter((r) => inR(r.latest.date) && (st === 'ALL' || r.latest.status === st) && (!t || [r.latest.code, nameOfQuote(r.latest), r.lead?.code ?? ''].some((v) => v.toLowerCase().includes(t))))
    .sort((a, b) => b.latest.date.localeCompare(a.latest.date));
  const acc = quoteRows.filter((r) => r.latest.status === 'ACCEPTED');
  const rej = quoteRows.filter((r) => r.latest.status === 'REJECTED');
  const waiting = quoteRows.filter((r) => r.latest.status === 'SENT');

  // ---- Hợp đồng: phiên bản mới nhất mỗi hợp đồng ----
  const contracts = latestContracts(genDocs);
  const cFiltered = contracts.filter((d) => inR(d.createdAt) && (st === 'ALL' || d.status === st) && (!t || [d.contractCode, d.partyName, d.quoteCode].some((v) => v.toLowerCase().includes(t))))
    .sort((a, b) => Number(b.status === 'PENDING_APPROVAL') - Number(a.status === 'PENDING_APPROVAL') || b.createdAt.localeCompare(a.createdAt));
  const valid = contracts.filter((d) => d.status === 'ISSUED' || d.status === 'APPROVED');

  const qPaged = usePaged(qFiltered, 12);
  const cPaged = usePaged(cFiltered, 12);
  const decide = (d: GeneratedDoc, ok: boolean) => {
    setGenDocs((all) => all.map((x) => (x.id === d.id ? { ...x, ...(ok ? { status: 'APPROVED' as GenDocStatus, approvedBy: me.id, approvedAt: todayISO() } : { status: 'REJECTED' as GenDocStatus, rejectNote: 'Từ chối từ danh sách' }) } : x)));
    logDecision({ kind: 'CONTRACT', refId: d.id, title: `${d.contractCode} v${d.version ?? 1}: ${d.partyName}`, requesterId: d.createdBy, decision: ok ? 'APPROVED' : 'REJECTED', amount: d.total });
    notify(ok ? `Đã duyệt ${d.contractCode}` : `Đã từ chối ${d.contractCode}`, ok ? 'teal' : 'orange');
  };
  const statusOpts = view === 'QUOTE'
    ? (Object.keys(QUOTE_STATUS) as QuoteStatus[]).map((s) => ({ value: s, label: QUOTE_STATUS[s].label }))
    : (['PENDING_APPROVAL', 'ISSUED', 'APPROVED', 'REJECTED'] as GenDocStatus[]).map((s) => ({ value: s, label: GENDOC_STATUS[s].label }));

  return (
    <div className="space-y-4">
      <div className="flex flex-wrap items-center gap-2">
        <div className="flex rounded bg-[#151C29] p-1" role="radiogroup" aria-label="Loại văn bản">
          {([['QUOTE', `Báo giá (${quoteRows.length})`], ['CONTRACT', `Hợp đồng (${contracts.length})`]] as const).map(([k, label]) => (
            <button key={k} role="radio" aria-checked={view === k} onClick={() => { setView(k); setSt('ALL'); setOpen(null); }} className={cn('rounded-md px-4 py-2 text-sm font-medium', view === k ? 'g-brand font-semibold text-[#0F141E]' : 'text-[#94A3B8] hover:text-[#F1F5F9]')}>{label}</button>
          ))}
        </div>
        {view === 'QUOTE' && <button className={cn(btnPrimary, btnSm, 'ml-auto')} disabled={!(canDo('project.update') || canDo('customer.edit'))} onClick={() => openComposer({ mode: 'QUOTE' })}><Plus className="h-3.5 w-3.5" aria-hidden />Tạo báo giá</button>}
        {view === 'CONTRACT' && <button className={cn(btnPrimary, btnSm, 'ml-auto')} disabled={!(canDo('project.update') || canDo('customer.edit'))} onClick={() => openComposer({ mode: 'CONTRACT' })}><Plus className="h-3.5 w-3.5" aria-hidden />Tạo hợp đồng</button>}
      </div>

      {view === 'QUOTE' ? (
        <div className={kpiGrid('lg:grid-cols-4')}>
          <StatCard label="Bộ báo giá" value={String(quoteRows.length)} icon={FileText} sub={`${quotes.length} phiên bản`} />
          <StatCard label="Chờ khách" value={compact(waiting.reduce((a, r) => a + r.latest.amount, 0))} icon={Clock} color={C.orange} sub={`${waiting.length} bộ`} />
          <StatCard label="Khách chấp nhận" value={compact(acc.reduce((a, r) => a + r.latest.amount, 0))} icon={CheckCircle2} color={C.teal} sub={`${acc.length} bộ`} />
          <StatCard label="Tỷ lệ chấp nhận" value={acc.length + rej.length ? `${Math.round((acc.length / (acc.length + rej.length)) * 100)}%` : '—'} icon={Target} color={C.blue} sub={`${rej.length} bị từ chối`} />
        </div>
      ) : (
        <div className={kpiGrid('lg:grid-cols-4')}>
          <StatCard label="Hợp đồng" value={String(contracts.length)} icon={FileText} sub={`${genDocs.length} phiên bản`} />
          <StatCard label="Hiệu lực" value={compact(valid.reduce((a, d) => a + d.total, 0))} icon={CheckCircle2} color={C.teal} sub={`${valid.length} hợp đồng`} />
          <StatCard label="Chờ duyệt" value={String(contracts.filter((d) => d.status === 'PENDING_APPROVAL').length)} icon={Clock} color={C.orange} sub="Điều khoản đặc biệt" />
          <StatCard label="Bị từ chối" value={String(contracts.filter((d) => d.status === 'REJECTED').length)} icon={AlertTriangle} color={C.red} sub="Cần tạo phiên bản mới" />
        </div>
      )}

      <FilterBar q={q} onQ={setQ} placeholder={view === 'QUOTE' ? 'Tìm mã báo giá, khách hàng, mã dự án...' : 'Tìm số hợp đồng, bên mua, báo giá căn cứ...'} status={st} onStatus={setSt} statusOptions={statusOpts} />

      <Panel title={view === 'QUOTE' ? `${qFiltered.length} bộ báo giá` : `${cFiltered.length} hợp đồng`}>
        {view === 'QUOTE' ? (
          <>
            <Table head={['Khách hàng / dự án', 'Báo giá mới nhất', 'Ngày', 'Trước VAT', 'Trạng thái', '']} minW={760}>
              {qPaged.slice.map((r) => (
                <Fragment key={r.key}>
                  <tr className={rowCls}>
                    <td className={tdFirst}><p className="max-w-[280px] truncate font-medium text-[#F1F5F9]">{nameOfQuote(r.latest)}</p><p className="text-xs text-[#94A3B8]">{r.lead ? r.lead.code : 'Không gắn dự án'}</p></td>
                    <td className={tdCls}><b>{r.latest.code}</b> <span className="text-xs text-[#94A3B8]">v{r.latest.version}</span>{r.versions.length > 1 && <button className="ml-2 text-xs text-[#6FA8F0] hover:underline" onClick={() => setOpen(open === r.key ? null : r.key)}>{open === r.key ? 'ẩn' : `${r.versions.length} phiên bản`}</button>}</td>
                    <td className={cn(tdCls, 'tabular-nums')}>{fmtDate(r.latest.date)}</td>
                    <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(r.latest.amount)}</td>
                    <td className={tdCls}><Chip tone={QUOTE_STATUS[r.latest.status].tone}>{QUOTE_STATUS[r.latest.status].label}</Chip></td>
                    <td className={cn(tdLast, 'text-right')}><button className={cn(btnGhost, btnSm)} onClick={() => openComposer({ quoteId: r.latest.id, mode: 'QUOTE' })}><Eye className="h-3.5 w-3.5" aria-hidden />Xem</button></td>
                  </tr>
                  {open === r.key && r.versions.slice(1).map((v) => (
                    <tr key={v.id} className="bg-[#0B1019] text-xs text-[#94A3B8]">
                      <td className={tdFirst} />
                      <td className={tdCls}>{v.code} v{v.version}</td>
                      <td className={cn(tdCls, 'tabular-nums')}>{fmtDate(v.date)}</td>
                      <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(v.amount)}</td>
                      <td className={tdCls}><Chip tone={QUOTE_STATUS[v.status].tone}>{QUOTE_STATUS[v.status].label}</Chip></td>
                      <td className={cn(tdLast, 'text-right')}><button className="text-[#6FA8F0] hover:underline" onClick={() => openComposer({ quoteId: v.id, mode: 'QUOTE' })}>Xem</button></td>
                    </tr>
                  ))}
                </Fragment>
              ))}
            </Table>
            {!qFiltered.length && <EmptyState text={<>Không có báo giá trong khoảng thời gian và bộ lọc này.</>} art="doc" />}
            <Pagination paged={qPaged} unit="bộ báo giá" />
          </>
        ) : (
          <>
            <Table head={['Số hợp đồng', 'Bên mua', 'Căn cứ báo giá', 'Giá trị', 'Trạng thái', '']} minW={820}>
              {cPaged.slice.map((d) => {
                const versions = contractVersions(genDocs, docGroupOf(d));
                return (
                  <Fragment key={d.id}>
                    <tr className={rowCls}>
                      <td className={tdFirst}><b>{d.contractCode}</b> <span className="text-xs text-[#94A3B8]">v{d.version ?? 1}</span>{versions.length > 1 && <button className="ml-2 text-xs text-[#6FA8F0] hover:underline" onClick={() => setOpen(open === d.id ? null : d.id)}>{open === d.id ? 'ẩn' : `${versions.length} phiên bản`}</button>}<p className="text-xs text-[#94A3B8]">{fmtDate(d.createdAt)}</p></td>
                      <td className={tdCls}><p className="max-w-[240px] truncate">{d.partyName}</p></td>
                      <td className={cn(tdCls, 'text-xs')}>{d.quoteCode || '—'}</td>
                      <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(d.total)}</td>
                      <td className={tdCls}><Chip tone={GENDOC_STATUS[d.status].tone}>{GENDOC_STATUS[d.status].label}</Chip>{d.status === 'PENDING_APPROVAL' && <p className="mt-1 max-w-[220px] truncate text-[11px] text-[#F7B23B]">{d.special[0]}</p>}</td>
                      <td className={cn(tdLast, 'whitespace-nowrap text-right')}>
                        <button className={cn(btnGhost, btnSm, 'mr-1')} onClick={() => openComposer({ docId: d.id, view: true })}><Eye className="h-3.5 w-3.5" aria-hidden />Xem</button>
                        {d.status === 'PENDING_APPROVAL' && canApprove(d) && (
                          <>
                            <button className={cn(btnBase, btnSm, 'mr-1 bg-[#00B894] font-semibold text-[#0F141E]')} onClick={() => decide(d, true)}>Duyệt</button>
                            <button className={cn(btnBase, btnSm, 'bg-[#EF4444]/15 text-[#F87171]')} onClick={() => decide(d, false)}>Từ chối</button>
                          </>
                        )}
                      </td>
                    </tr>
                    {open === d.id && versions.slice(1).map((v) => (
                      <tr key={v.id} className="bg-[#0B1019] text-xs text-[#94A3B8]">
                        <td className={tdFirst}>v{v.version ?? 1}, {fmtDate(v.createdAt)}</td>
                        <td className={tdCls} />
                        <td className={tdCls}>{v.quoteCode}</td>
                        <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(v.total)}</td>
                        <td className={tdCls}><Chip tone={GENDOC_STATUS[v.status].tone}>{GENDOC_STATUS[v.status].label}</Chip></td>
                        <td className={cn(tdLast, 'text-right')}><button className="text-[#6FA8F0] hover:underline" onClick={() => openComposer({ docId: v.id, view: true })}>Xem</button></td>
                      </tr>
                    ))}
                  </Fragment>
                );
              })}
            </Table>
            {!cFiltered.length && <EmptyState text={<>Không có hợp đồng trong khoảng thời gian và bộ lọc này.</>} art="doc" />}
            <Pagination paged={cPaged} unit="hợp đồng" />
          </>
        )}
      </Panel>
    </div>
  );
}

/** Tab Tài liệu: thư viện, mẫu báo giá & hợp đồng, văn bản đã xuất */
function DocsModule() {
  const { genDocs } = useApp();
  const [tab, setTab] = useState<'library' | 'templates' | 'generated'>('library');
  const pending = genDocs.filter((d) => d.status === 'PENDING_APPROVAL').length;
  return (
    <div className="space-y-4">
      <Tabs tabs={[{ id: 'library', label: 'Kho tài liệu' }, { id: 'templates', label: 'Mẫu văn bản' }, { id: 'generated', label: pending ? `Báo giá & Hợp đồng (${pending})` : 'Báo giá & Hợp đồng' }]} value={tab} onChange={setTab} />
      {tab === 'library' && <DocsPage />}
      {tab === 'templates' && <TemplateManager />}
      {tab === 'generated' && <SalesDocsPanel />}
    </div>
  );
}

// =====================================================================
//  PHÂN HỆ: LỊCH CÔNG TÁC NHÂN SỰ
//  Gặp khách (bắt buộc khách CRM), khảo sát / nghiệm thu (bắt buộc dự án), công tác ngoại tỉnh,
//  nghỉ việc riêng / đi muộn / giải trình chấm công; check-in hiện trường, kết quả, chi phí
// =====================================================================

const actDays = (a: Activity) => Math.max(0.5, Math.round(((new Date(a.to).getTime() - new Date(a.from).getTime()) / 864e5) * 2) / 2);
const pad2 = (n: number) => String(n).padStart(2, '0');
const toLocal = (d: Date) => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}T${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
const fmtDT = (s: string) => { const d = new Date(s); return `${pad2(d.getHours())}:${pad2(d.getMinutes())} ${pad2(d.getDate())}/${pad2(d.getMonth() + 1)}`; };
const WEEKDAY = ['Chủ nhật', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];
/** Cần duyệt: công tác, nghỉ / giải trình; gặp khách / khảo sát có đề xuất chi phí */
const needsApproval = (a: Pick<Activity, 'type' | 'cost'>) => ACTIVITY_TYPE[a.type].approval || ((a.type === 'MEETING' || a.type === 'SURVEY') && a.cost > 0);

/** Phạm vi xem: BOD & Kế toán xem tất cả; Trưởng phòng / Trưởng MKT xem phòng mình; còn lại xem của mình */
function useActivityScope() {
  const { me, role, users } = useApp();
  return role === 'BOD' || role === 'ACCOUNTANT' ? users.map((u) => u.id)
    : role === 'DEPT_HEAD' || role === 'MKT_LEAD' ? users.filter((u) => u.dept === me.dept || u.id === me.id).map((u) => u.id)
    : [me.id];
}

function useActivityApprover() {
  const { me, role, users, canDo } = useApp();
  return (a: Activity) => {
    const owner = users.find((u) => u.id === a.userId);
    return canDo('activity.approve') && a.userId !== me.id && (role === 'BOD' || (role === 'DEPT_HEAD' && owner?.dept === me.dept));
  };
}

/** Đóng dấu watermark (thời gian, GPS, người chụp) lên ảnh hiện trường */
async function watermarkPhoto(file: File, lines: string[]): Promise<string> {
  const src = URL.createObjectURL(file);
  try {
    const img = await new Promise<HTMLImageElement>((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = () => rej(new Error('Không đọc được ảnh')); i.src = src; });
    const scale = Math.min(1, 1600 / Math.max(img.width, img.height));
    const c = document.createElement('canvas');
    c.width = Math.round(img.width * scale);
    c.height = Math.round(img.height * scale);
    const g = c.getContext('2d');
    if (!g) throw new Error('Trình duyệt không hỗ trợ canvas');
    g.drawImage(img, 0, 0, c.width, c.height);
    const fs = Math.max(14, Math.round(c.width / 42));
    const padY = fs * 0.6;
    const h = lines.length * fs * 1.35 + padY * 2;
    g.fillStyle = 'rgba(0,0,0,0.55)';
    g.fillRect(0, c.height - h, c.width, h);
    g.fillStyle = '#ffffff';
    g.font = `${fs}px sans-serif`;
    lines.forEach((t, i) => g.fillText(t, padY, c.height - h + padY + fs * (i + 1)));
    return c.toDataURL('image/jpeg', 0.85);
  } finally {
    URL.revokeObjectURL(src);
  }
}

function ActivityFormModal({ activity, preset, onClose }: { activity?: Activity; preset?: Partial<Activity>; onClose: () => void }) {
  const { me, role, users, customers, leads, programs, setActivities, notify, dispatch, departments } = useApp();
  const scope = useActivityScope();
  const canPickUser = role === 'BOD' || role === 'DEPT_HEAD' || role === 'MKT_LEAD';
  const defaultsFor = (type: ActivityType, kind?: LeaveKind) => {
    const d = new Date();
    if (type === 'LEAVE') {
      const day = new Date(d); if (kind === 'LEAVE') day.setDate(day.getDate() + 1);
      const at = (h: number, m = 0) => { const x = new Date(day); x.setHours(h, m, 0, 0); return toLocal(x); };
      return kind === 'LATE' ? { from: at(8), to: at(9) } : kind === 'EARLY' ? { from: at(16), to: at(17, 30) } : kind === 'NO_CHECKIN' ? { from: at(8), to: at(8, 15) } : { from: at(8), to: at(17, 30) };
    }
    if (type === 'TRIP') { const a = new Date(d); a.setDate(a.getDate() + 1); a.setHours(7, 0, 0, 0); const b = new Date(a); b.setDate(b.getDate() + 1); b.setHours(18, 0, 0, 0); return { from: toLocal(a), to: toLocal(b) }; }
    const a = new Date(d); a.setDate(a.getDate() + 1); a.setHours(9, 0, 0, 0); const b = new Date(a); b.setHours(type === 'SURVEY' ? 12 : 10, 30, 0, 0);
    return { from: toLocal(a), to: toLocal(b) };
  };
  const [f, setF] = useState<Activity>(() => activity ?? {
    id: uid('act'), userId: me.id, type: 'MEETING', title: '', ...defaultsFor('MEETING'), location: '', cost: 0, note: '', status: 'PLANNED', createdAt: todayISO(), createdBy: me.id, ...preset,
  });
  const [touched, setTouched] = useState(false);
  const set = <K extends keyof Activity>(k: K, v: Activity[K]) => setF((p) => ({ ...p, [k]: v }));
  const changeType = (type: ActivityType) => setF((p) => ({
    ...p, type, ...(activity ? {} : defaultsFor(type, type === 'LEAVE' ? p.leaveKind ?? 'LEAVE' : undefined)),
    leaveKind: type === 'LEAVE' ? p.leaveKind ?? 'LEAVE' : undefined,
    ...(type === 'LEAVE' ? { customerId: undefined, leadId: undefined, programId: undefined, cost: 0, location: '' } : {}),
  }));
  const owner = users.find((u) => u.id === f.userId);
  const cust = customers.find((c) => c.id === f.customerId);
  const projects = leads.filter((l) => ['ROUTED', 'ASSIGNED', 'ACCEPTED', 'QUOTED', 'WON'].includes(l.status));
  const isLeave = f.type === 'LEAVE';
  const e: Record<string, string> = {};
  if (!f.from || !f.to || f.to <= f.from) e.to = 'Thời gian kết thúc phải sau bắt đầu';
  if (f.type === 'MEETING' && !f.customerId) e.customerId = 'Gặp khách hàng: bắt buộc chọn khách hàng trong CRM';
  if (f.type === 'SURVEY' && !f.leadId) e.leadId = 'Khảo sát / nghiệm thu: bắt buộc chọn dự án';
  if (f.type === 'TRIP' && !f.location.trim()) e.location = 'Nhập nơi công tác';
  if (f.type === 'TRIP' && !f.transport) e.transport = 'Chọn phương tiện';
  if (isLeave && f.note.trim().length < 5) e.note = 'Nhập lý do cá nhân (tối thiểu 5 ký tự)';
  if (f.cost < 0 || (f.advance ?? 0) < 0) e.cost = 'Không âm';
  if ((f.advance ?? 0) > f.cost && f.cost > 0) e.advance = 'Tạm ứng không vượt chi phí dự kiến';
  const err = (k: string) => (touched ? e[k] : undefined);

  const save = () => {
    setTouched(true);
    if (Object.keys(e).length) return notify(Object.values(e)[0], 'red');
    const approval = needsApproval(f);
    const byApprover = canPickUser && f.userId !== me.id;
    const keep = activity && !['PENDING_APPROVAL', 'NEED_INFO', 'REJECTED'].includes(activity.status) && !(approval && activity.status === 'PLANNED');
    const status: ActivityStatus = keep ? activity!.status : approval ? (byApprover ? 'APPROVED' : 'PENDING_APPROVAL') : 'PLANNED';
    const title = f.title.trim() || (isLeave ? `${LEAVE_KIND[f.leaveKind ?? 'LEAVE']}` : `${ACTIVITY_TYPE[f.type].label}${cust ? `: ${cust.name}` : ''}`);
    const clean: Activity = { ...f, title, location: f.location.trim(), note: f.note.trim(), status, approvedBy: status === 'APPROVED' && byApprover ? me.id : f.approvedBy, rejectNote: status === 'PENDING_APPROVAL' ? undefined : f.rejectNote, requestNote: status === 'PENDING_APPROVAL' ? undefined : f.requestNote, submittedAt: status === 'PENDING_APPROVAL' ? Date.now() : f.submittedAt };
    setActivities((all) => (all.some((x) => x.id === clean.id) ? all.map((x) => (x.id === clean.id ? clean : x)) : [clean, ...all]));
    if (status === 'PENDING_APPROVAL') {
      const head = users.find((u) => u.id === departments.find((d) => d.code === owner?.dept)?.headId && u.id !== f.userId);
      dispatch('ACTIVITY_APPROVAL', { to: head, title: `${isLeave ? LEAVE_KIND[f.leaveKind ?? 'LEAVE'] : ACTIVITY_TYPE[f.type].label} chờ duyệt: ${owner?.name ?? ''}`, body: `${title}, ${fmtDT(f.from)} – ${fmtDT(f.to)}${f.cost ? `, chi phí ${compact(f.cost)}` : ''}`, module: 'staff' });
      notify(activity?.status === 'NEED_INFO' ? 'Đã bổ sung và gửi lại để duyệt' : 'Đã gửi đề nghị, chờ Trưởng phòng / Giám đốc duyệt', 'teal');
    } else notify(activity ? 'Đã cập nhật lịch' : 'Đã thêm vào lịch công tác', 'teal');
    onClose();
  };

  return (
    <Modal title={activity ? 'Sửa lịch công tác' : 'Thêm lịch công tác'} onClose={onClose} wide footer={<><span className="mr-auto self-center text-xs text-[#94A3B8]">{needsApproval(f) ? 'Cần Trưởng phòng / Giám đốc duyệt' : 'Không cần duyệt'}</span><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>{needsApproval(f) && !(activity && activity.status === 'APPROVED') ? 'Gửi đề nghị' : 'Lưu lịch'}</button></>}>
      {activity?.status === 'NEED_INFO' && activity.requestNote && <p className="mb-3 rounded bg-[#F28C33]/10 p-3 text-sm text-[#F7B23B]">Trưởng phòng yêu cầu bổ sung: {activity.requestNote}</p>}
      <div className="grid grid-cols-1 gap-5 lg:grid-cols-2">
        {/* Cột trái: lịch trình */}
        <div className="space-y-3">
          <p className="text-xs font-semibold uppercase tracking-wide text-[#94A3B8]">Lịch trình</p>
          <Field label="Loại công việc">
            <select className={inputCls} value={f.type} onChange={(ev) => changeType(ev.target.value as ActivityType)}>
              {(Object.keys(ACTIVITY_TYPE) as ActivityType[]).map((t) => <option key={t} value={t}>{ACTIVITY_TYPE[t].label}</option>)}
            </select>
          </Field>
          {isLeave && (
            <Field label="Hình thức">
              <select className={inputCls} value={f.leaveKind ?? 'LEAVE'} onChange={(ev) => { const k = ev.target.value as LeaveKind; setF((p) => ({ ...p, leaveKind: k, ...(activity ? {} : defaultsFor('LEAVE', k)) })); }}>
                {(Object.keys(LEAVE_KIND) as LeaveKind[]).map((k) => <option key={k} value={k}>{LEAVE_KIND[k]}</option>)}
              </select>
            </Field>
          )}
          <Field label="Nhân sự">
            <select className={inputCls} disabled={!canPickUser} value={f.userId} onChange={(ev) => set('userId', ev.target.value)}>
              {users.filter((u) => u.active && scope.includes(u.id)).map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}
            </select>
          </Field>
          <div className="grid grid-cols-2 gap-3">
            <Field label="Bắt đầu"><input className={inputCls} type="datetime-local" value={f.from} onChange={(ev) => set('from', ev.target.value)} /></Field>
            <Field label="Kết thúc" error={err('to')}><input className={inputCls} type="datetime-local" value={f.to} onChange={(ev) => set('to', ev.target.value)} /></Field>
          </div>
          <Field label="Tiêu đề" hint="Để trống sẽ tự đặt theo loại và khách hàng"><input className={inputCls} value={f.title} onChange={(ev) => set('title', ev.target.value)} /></Field>
        </div>

        {/* Cột phải: liên kết, chi phí, mục tiêu */}
        <div className="space-y-3">
          <p className="text-xs font-semibold uppercase tracking-wide text-[#94A3B8]">{isLeave ? 'Lý do' : 'Liên kết & chi phí'}</p>
          {isLeave ? (
            <Field label="Lý do cá nhân *" error={err('note')} hint="Dùng để đối soát trừ phép / trừ công"><textarea className={cn(inputCls, 'min-h-28')} value={f.note} onChange={(ev) => set('note', ev.target.value)} placeholder={f.leaveKind === 'LATE' ? 'VD: Đưa con đi khám, đến văn phòng lúc 9h15' : f.leaveKind === 'NO_CHECKIN' ? 'VD: Máy chấm công lỗi, có mặt từ 7h55' : 'VD: Việc gia đình'} /></Field>
          ) : (
            <>
              <Field label={f.type === 'MEETING' ? 'Khách hàng *' : 'Khách hàng'} error={err('customerId')}>
                <select className={inputCls} value={f.customerId ?? ''} onChange={(ev) => { const c = customers.find((x) => x.id === ev.target.value); setF((p) => ({ ...p, customerId: c?.id, location: p.location || c?.address || '' })); }}>
                  <option value="" disabled={f.type === 'MEETING'}>{f.type === 'MEETING' ? 'Chọn khách hàng trong CRM...' : 'Không gắn khách hàng'}</option>
                  {customers.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
                </select>
              </Field>
              <Field label={f.type === 'SURVEY' ? 'Dự án M&E *' : 'Dự án'} error={err('leadId')}>
                <select className={inputCls} value={f.leadId ?? ''} onChange={(ev) => { const l = leads.find((x) => x.id === ev.target.value); setF((p) => ({ ...p, leadId: l?.id, customerId: p.customerId ?? l?.customerId, location: p.location || l?.province || '' })); }}>
                  <option value="" disabled={f.type === 'SURVEY'}>{f.type === 'SURVEY' ? 'Chọn dự án...' : 'Không gắn dự án'}</option>
                  {projects.map((l) => <option key={l.id} value={l.id}>{l.company}: {l.boqNote}</option>)}
                </select>
              </Field>
              <Field label="Chương trình quỹ MDF (nếu có)">
                <select className={inputCls} value={f.programId ?? ''} onChange={(ev) => set('programId', ev.target.value || undefined)}>
                  <option value="">Không thuộc chương trình</option>
                  {programs.filter((p) => !['REJECTED', 'CANCELLED'].includes(p.status)).map((p) => <option key={p.id} value={p.id}>{p.title}</option>)}
                </select>
              </Field>
              <Field label={f.type === 'TRIP' ? 'Nơi công tác *' : 'Địa điểm'} error={err('location')}><input className={inputCls} value={f.location} onChange={(ev) => set('location', ev.target.value)} /></Field>
              {f.type === 'TRIP' && (
                <div className="grid grid-cols-2 gap-3">
                  <Field label="Phương tiện *" error={err('transport')}>
                    <select className={inputCls} value={f.transport ?? ''} onChange={(ev) => set('transport', ev.target.value)}>
                      <option value="">Chọn...</option>
                      {TRANSPORTS.map((t) => <option key={t} value={t}>{t}</option>)}
                    </select>
                  </Field>
                  <Field label="Nơi lưu trú"><input className={inputCls} value={f.lodging ?? ''} onChange={(ev) => set('lodging', ev.target.value)} placeholder="Khách sạn / nhà nghỉ" /></Field>
                </div>
              )}
              <div className="grid grid-cols-2 gap-3">
                <Field label="Dự toán chi phí" error={err('cost')}><MoneyInput value={f.cost} onChange={(n) => set('cost', n)} /></Field>
                {f.type === 'TRIP' && <Field label="Tạm ứng công tác phí" error={err('advance')}><MoneyInput value={f.advance ?? 0} onChange={(n) => set('advance', n)} /></Field>}
              </div>
              <Field label="Mục tiêu"><textarea className={cn(inputCls, 'min-h-16')} value={f.note} onChange={(ev) => set('note', ev.target.value)} placeholder={f.type === 'SURVEY' ? 'VD: Khảo sát tuyến cáp, đo khoảng cách tủ RMU' : 'VD: Trình bày giải pháp đầu cáp, chốt lịch khảo sát'} /></Field>
            </>
          )}
        </div>
      </div>
    </Modal>
  );
}

/** Ngăn chi tiết: check-in hiện trường, kết quả & việc tiếp theo, chứng từ chi phí, duyệt */
function ActivityDrawer({ id, onClose, onEdit }: { id: string; onClose: () => void; onEdit: (a: Activity) => void }) {
  const { activities, setActivities, users, customers, leads, programs, me, canDo, notify, openCustomer, go, postCash, cashEntries } = useApp();
  const canApprove = useActivityApprover();
  const a = activities.find((x) => x.id === id);
  const [result, setResult] = useState(a?.result ?? '');
  const [next, setNext] = useState(a?.nextAction ?? '');
  const [busy, setBusy] = useState(false);
  const [exp, setExp] = useState<{ name: string; amount: number }>({ name: '', amount: 0 });
  if (!a) return null;
  const patch = (p: Partial<Activity>) => setActivities((all) => all.map((x) => (x.id === a.id ? { ...x, ...p } : x)));
  const t = ACTIVITY_TYPE[a.type];
  const owner = users.find((u) => u.id === a.userId);
  const cust = customers.find((c) => c.id === a.customerId);
  const lead = leads.find((l) => l.id === a.leadId);
  const prog = programs.find((p) => p.id === a.programId);
  const mine = a.userId === me.id || a.createdBy === me.id;
  const isLeave = a.type === 'LEAVE';
  const active = ['PLANNED', 'APPROVED', 'DONE'].includes(a.status);
  const expTotal = (a.expenses ?? []).reduce((s, x) => s + x.amount, 0);

  const doCheckin = (files: File[]) => {
    setBusy(true);
    const finish = (lat: number, lng: number, accuracy: number | undefined, simulated: boolean) => {
      const at = new Date();
      const lateMinutes = Math.max(0, Math.round((at.getTime() - new Date(a.from).getTime()) / 60000) - 15);
      const lines = [`${owner?.name ?? ''} ${pad2(at.getHours())}:${pad2(at.getMinutes())} ${pad2(at.getDate())}/${pad2(at.getMonth() + 1)}/${at.getFullYear()}`, `GPS ${lat.toFixed(5)}, ${lng.toFixed(5)}${simulated ? ' (mô phỏng)' : ''}`, a.location || cust?.name || ''];
      Promise.all(files.map(async (f) => ({ name: f.name, url: await watermarkPhoto(f, lines.filter(Boolean)) })))
        .then((photos) => {
          patch({ checkin: { at: at.toISOString(), lat, lng, accuracy, simulated, lateMinutes, photos: [...(a.checkin?.photos ?? []), ...photos] } });
          notify(`Đã check-in${lateMinutes > 0 ? `, trễ ${lateMinutes} phút so với lịch` : ''}${photos.length ? `, ${photos.length} ảnh có watermark` : ''}`, lateMinutes > 0 ? 'orange' : 'teal');
        })
        .catch((err) => notify(err instanceof Error ? err.message : 'Không xử lý được ảnh', 'red'))
        .finally(() => setBusy(false));
    };
    // Lấy GPS thật nếu trình duyệt cho phép, không thì mô phỏng quanh TP.HCM
    if (typeof navigator !== 'undefined' && navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (p) => finish(p.coords.latitude, p.coords.longitude, p.coords.accuracy, false),
        () => finish(10.7769 + Math.random() * 0.02, 106.7009 + Math.random() * 0.02, undefined, true),
        { enableHighAccuracy: true, timeout: 8000 },
      );
    } else finish(10.7769, 106.7009, undefined, true);
  };
  const addExpense = (files: File[]) => {
    const file = files[0];
    if (!exp.name.trim() || exp.amount <= 0) return notify('Nhập nội dung và số tiền trước khi tải hóa đơn / vé', 'red');
    if (file.size > 10 * 1024 * 1024) return notify('File tối đa 10 MB', 'red');
    patch({ expenses: [...(a.expenses ?? []), { id: uid('ex'), name: exp.name.trim(), amount: exp.amount, fileName: file.name, url: URL.createObjectURL(file) }], expenseStatus: undefined });
    setExp({ name: '', amount: 0 });
  };

  return (
    <Drawer title={a.title} eyebrow={`${isLeave ? LEAVE_KIND[a.leaveKind ?? 'LEAVE'] : t.label}, ${owner?.name ?? ''}`} badge={<Chip tone={ACTIVITY_STATUS[a.status].tone}>{ACTIVITY_STATUS[a.status].label}</Chip>} onClose={onClose}
      actions={(mine || canApprove(a)) && !['DONE', 'CANCELLED'].includes(a.status) ? <button className={cn(btnGhost, btnSm)} onClick={() => onEdit(a)}><Pencil className="h-3.5 w-3.5" aria-hidden />Sửa</button> : undefined}>
      <dl className="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
        {[
          ['Thời gian', `${fmtDT(a.from)} – ${fmtDT(a.to)}${a.type === 'TRIP' || isLeave ? ` (${actDays(a)} ngày)` : ''}`],
          ['Địa điểm', a.location || '—'],
          ...(a.type === 'TRIP' ? [['Phương tiện', a.transport ?? '—'], ['Lưu trú', a.lodging || '—'], ['Tạm ứng', a.advance ? vnd(a.advance) : '—']] : []),
          ...(!isLeave ? [['Dự toán chi phí', a.cost ? vnd(a.cost) : '—']] : []),
        ].map(([k, v]) => <div key={k}><dt className="text-xs text-[#94A3B8]">{k}</dt><dd className="mt-0.5">{v}</dd></div>)}
      </dl>
      {(cust || lead || prog) && (
        <div className="flex flex-wrap gap-1.5 text-xs">
          {cust && <button className="rounded-md bg-[#00B894]/10 px-2 py-1 text-[#3DDBB6] hover:underline" onClick={() => openCustomer(cust.id)}>Khách hàng: {cust.name}</button>}
          {lead && <button className="rounded-md bg-[#1F74D4]/10 px-2 py-1 text-[#6FA8F0] hover:underline" onClick={() => go('projects', lead.code)}>Dự án: {lead.code}</button>}
          {prog && <button className="rounded-md bg-[#F28C33]/10 px-2 py-1 text-[#F7B23B] hover:underline" onClick={() => go('claims')}>Chương trình: {prog.title}</button>}
        </div>
      )}
      {a.note && <p className="rounded bg-[#1C2534] p-3 text-sm"><span className="text-xs text-[#94A3B8]">{isLeave ? 'Lý do cá nhân' : 'Mục tiêu'}: </span>{a.note}</p>}
      {a.requestNote && a.status === 'NEED_INFO' && <p className="rounded bg-[#F28C33]/10 p-3 text-sm text-[#F7B23B]">Yêu cầu bổ sung: {a.requestNote}</p>}
      {a.rejectNote && <p className="rounded bg-[#EF4444]/10 p-3 text-sm text-[#F87171]">Từ chối: {a.rejectNote}</p>}

      {!isLeave && (
        <section>
          <h3 className="mb-2 flex items-center gap-2 text-sm font-semibold"><MapPin className="h-4 w-4 text-[#F28C33]" aria-hidden />Check-in hiện trường</h3>
          {a.checkin ? (
            <div className="space-y-2 text-sm">
              <p>Đã check-in lúc {fmtDT(a.checkin.at)}, GPS {a.checkin.lat.toFixed(5)}, {a.checkin.lng.toFixed(5)}{a.checkin.accuracy ? ` (±${Math.round(a.checkin.accuracy)} m)` : ''}{a.checkin.simulated ? ' (mô phỏng)' : ''}{a.checkin.lateMinutes > 0 ? <span className="text-[#F7B23B]">, trễ {a.checkin.lateMinutes} phút</span> : <span className="text-[#3DDBB6]">, đúng giờ</span>}</p>
              {/* eslint-disable-next-line @next/next/no-img-element */}
              {a.checkin.photos.length > 0 && <div className="grid grid-cols-3 gap-2">{a.checkin.photos.map((p) => <a key={p.url} href={p.url} target="_blank" rel="noreferrer"><img src={p.url} alt={p.name} className="aspect-square w-full rounded object-cover" /></a>)}</div>}
            </div>
          ) : <p className="text-sm text-[#94A3B8]">Chưa check-in.</p>}
          {mine && active && (
            <FilePicker accept="image/*" multiple disabled={busy} onFiles={doCheckin} className={cn(btnPrimary, btnSm, 'mt-2 inline-flex')}>
              <MapPin className="h-3.5 w-3.5" aria-hidden />{busy ? 'Đang lấy vị trí...' : a.checkin ? 'Thêm ảnh hiện trường' : 'Check-in hiện trường (chụp ảnh)'}
            </FilePicker>
          )}
          {mine && active && !a.checkin && <button className={cn(btnGhost, btnSm, 'ml-2 mt-2')} disabled={busy} onClick={() => doCheckin([])}>Check-in không ảnh</button>}
        </section>
      )}

      {!isLeave && (
        <section>
          <h3 className="mb-2 text-sm font-semibold">Kết quả buổi làm việc & Next Action</h3>
          <div className="space-y-2">
            <textarea className={cn(inputCls, 'min-h-16')} disabled={!mine} value={result} onChange={(e) => setResult(e.target.value)} placeholder="Kết quả: khách đồng ý khảo sát, cần báo giá trong tuần..." />
            <input className={inputCls} disabled={!mine} value={next} onChange={(e) => setNext(e.target.value)} placeholder="Việc tiếp theo: gửi báo giá v2 trước thứ 6" />
            {mine && (
              <div className="flex flex-wrap gap-2">
                <button className={cn(btnGhost, btnSm)} onClick={() => { patch({ result: result.trim() || undefined, nextAction: next.trim() || undefined }); notify('Đã lưu vào lịch sử chăm sóc khách hàng / dự án', 'teal'); }}>Lưu kết quả</button>
                {active && a.status !== 'DONE' && <button className={cn(btnPrimary, btnSm)} onClick={() => { patch({ status: 'DONE', result: result.trim() || undefined, nextAction: next.trim() || undefined }); notify('Đã hoàn thành, kết quả lưu vào lịch sử chăm sóc', 'teal'); }}><CheckCircle2 className="h-3.5 w-3.5" aria-hidden />Hoàn thành</button>}
              </div>
            )}
          </div>
        </section>
      )}

      {!isLeave && (
        <section>
          <div className="mb-2 flex items-center justify-between gap-2">
            <h3 className="text-sm font-semibold">Chi phí phát sinh {expTotal ? `(${compact(expTotal)})` : ''}</h3>
            {a.expenseStatus && <Chip tone={EXPENSE_STATUS[a.expenseStatus].tone}>{EXPENSE_STATUS[a.expenseStatus].label}</Chip>}
          </div>
          <ul className="space-y-1.5">
            {(a.expenses ?? []).map((x) => (
              <li key={x.id} className="flex items-center gap-2 rounded bg-[#1C2534] px-3 py-2 text-sm">
                <ReceiptIcon className="h-4 w-4 shrink-0 text-[#94A3B8]" aria-hidden />
                <a href={x.url} target="_blank" rel="noreferrer" className="min-w-0 flex-1 truncate text-[#6FA8F0] hover:underline">{x.name}</a>
                <span className="tabular-nums">{vnd(x.amount)}</span>
                {mine && !a.expenseStatus && <button className="text-[#94A3B8] hover:text-[#F87171]" onClick={() => patch({ expenses: (a.expenses ?? []).filter((y) => y.id !== x.id) })} aria-label="Xóa chứng từ"><Trash2 className="h-3.5 w-3.5" /></button>}
              </li>
            ))}
          </ul>
          {a.expenseNote && <p className="mt-1 text-xs text-[#F87171]">{a.expenseNote}</p>}
          {mine && (!a.expenseStatus || a.expenseStatus === 'REJECTED') && (
            <div className="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-[1fr_140px_auto]">
              <input className={cn(inputCls, 'py-1.5 text-xs')} value={exp.name} onChange={(e) => setExp({ ...exp, name: e.target.value })} placeholder="Nội dung: vé xe, khách sạn, tiếp khách..." />
              <input className={cn(inputCls, 'py-1.5 text-xs tabular-nums')} inputMode="numeric" value={exp.amount ? exp.amount.toLocaleString('vi-VN') : ''} onChange={(e) => setExp({ ...exp, amount: digits(e.target.value) })} placeholder="Số tiền" />
              <FilePicker accept="image/*,.pdf" onFiles={addExpense} className={cn(btnGhost, btnSm, 'inline-flex justify-center')}><Upload className="h-3.5 w-3.5" aria-hidden />Tải hóa đơn / vé</FilePicker>
            </div>
          )}
          {mine && (a.expenses?.length ?? 0) > 0 && (!a.expenseStatus || a.expenseStatus === 'REJECTED') && (
            <button className={cn(btnPrimary, btnSm, 'mt-2')} onClick={() => { patch({ expenseStatus: 'SUBMITTED', expenseNote: undefined, expenseSubmittedAt: Date.now() }); notify('Đã gửi chứng từ chi phí, chờ Trưởng phòng duyệt', 'teal'); }}><Send className="h-3.5 w-3.5" aria-hidden />Gửi duyệt thanh toán</button>
          )}
          {a.expenseStatus === 'SUBMITTED' && canApprove(a) && (
            <div className="mt-2 flex gap-2">
              <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E]')} onClick={() => patch({ expenseStatus: 'HEAD_APPROVED' })}>Duyệt chi</button>
              <button className={cn(btnGhost, btnSm, 'text-[#F87171]')} onClick={() => patch({ expenseStatus: 'REJECTED', expenseNote: 'Trưởng phòng từ chối chi phí' })}>Từ chối</button>
            </div>
          )}
          {a.expenseStatus === 'HEAD_APPROVED' && canDo('claim.accounting') && (
            <div className="mt-2 flex gap-2">
              <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E]')} onClick={() => { patch({ expenseStatus: 'PAID' }); postCash(expenseCash(a, users, cashEntries)); notify('Đã thanh toán, tự sinh phiếu quyết toán công tác phí vào sổ quỹ', 'teal'); }}>Kế toán xác nhận thanh toán</button>
              <button className={cn(btnGhost, btnSm, 'text-[#F87171]')} onClick={() => patch({ expenseStatus: 'REJECTED', expenseNote: 'Kế toán từ chối: chứng từ chưa hợp lệ' })}>Từ chối</button>
            </div>
          )}
        </section>
      )}
    </Drawer>
  );
}

/** Nút duyệt nhanh: Duyệt hợp lệ / Yêu cầu bổ sung / Từ chối */
function ApprovalButtons({ a }: { a: Activity }) {
  const { setActivities, me, notify, logDecision, users, dispatch, postCash } = useApp();
  const record = (d: ApprovalDecision, note?: string) => {
    logDecision({ kind: 'ACTIVITY', refId: a.id, title: a.title, requesterId: a.userId, decision: d, note, amount: a.cost || undefined });
    const req = users.find((u) => u.id === a.userId);
    if (req && req.id !== me.id) dispatch('APPROVAL_RESULT', { to: req, title: `${DECISION_LABEL[d].label}: ${a.title}`, body: note ?? 'Đã được duyệt', module: 'staff' });
  };
  const [mode, setMode] = useState<'need' | 'reject' | null>(null);
  const [note, setNote] = useState('');
  const patch = (p: Partial<Activity>) => setActivities((all) => all.map((x) => (x.id === a.id ? { ...x, ...p } : x)));
  return (
    <div className="space-y-2" onClick={(e) => e.stopPropagation()}>
      <div className="flex flex-wrap gap-1.5">
        <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} onClick={() => { patch({ status: 'APPROVED', approvedBy: me.id }); record('APPROVED'); const adv = advanceCash(a, users); if (adv) postCash(adv); notify(adv ? `Đã duyệt, tự sinh phiếu chi tạm ứng ${vnd(adv.amount)}` : 'Đã duyệt', 'teal'); }}>Duyệt hợp lệ</button>
        <button className={cn(btnGhost, btnSm)} onClick={() => setMode(mode === 'need' ? null : 'need')}>Yêu cầu bổ sung</button>
        <button className={cn(btnBase, btnSm, 'bg-[#EF4444]/15 text-[#F87171] hover:bg-[#EF4444]/25')} onClick={() => setMode(mode === 'reject' ? null : 'reject')}>Từ chối</button>
      </div>
      {mode && (
        <div className="flex gap-2">
          <input className={cn(inputCls, 'py-1.5 text-xs')} value={note} onChange={(e) => setNote(e.target.value)} placeholder={mode === 'need' ? 'Cần bổ sung gì?' : 'Lý do từ chối'} />
          <button className={cn(btnPrimary, 'px-2.5 py-1 text-xs')} disabled={note.trim().length < 3} onClick={() => { patch(mode === 'need' ? { status: 'NEED_INFO', requestNote: note.trim() } : { status: 'REJECTED', rejectNote: note.trim() }); record(mode === 'need' ? 'NEED_INFO' : 'REJECTED', note.trim()); setMode(null); setNote(''); notify(mode === 'need' ? 'Đã yêu cầu bổ sung' : 'Đã từ chối', 'orange'); }}>Gửi</button>
        </div>
      )}
    </div>
  );
}

function ActivityRowCard({ a, onOpen }: { a: Activity; onOpen: () => void }) {
  const { users, customers, leads } = useApp();
  const t = ACTIVITY_TYPE[a.type];
  const cust = customers.find((c) => c.id === a.customerId);
  const lead = leads.find((l) => l.id === a.leadId);
  return (
    <button className="w-full rounded-md border border-[#263044] bg-[#151C29] p-3 text-left hover:border-[#94A3B8]/40" style={{ borderLeft: `3px solid ${t.color}` }} onClick={onOpen}>
      <div className="flex items-start justify-between gap-2">
        <p className="min-w-0 text-sm font-medium text-[#F1F5F9]">{a.title}</p>
        <Chip tone={ACTIVITY_STATUS[a.status].tone}>{ACTIVITY_STATUS[a.status].label}</Chip>
      </div>
      <p className="mt-0.5 text-xs text-[#94A3B8]">{users.find((u) => u.id === a.userId)?.name}, {fmtDT(a.from)} – {fmtDT(a.to)}</p>
      <p className="mt-0.5 truncate text-xs text-[#94A3B8]">{a.type === 'LEAVE' ? LEAVE_KIND[a.leaveKind ?? 'LEAVE'] : cust?.name ?? lead?.company ?? a.location ?? ''}{a.checkin ? ', đã check-in' : ''}{a.cost ? `, ${compact(a.cost)}` : ''}</p>
      {a.result && <p className="mt-1 truncate text-xs text-[#3DDBB6]">Kết quả: {a.result}</p>}
      {a.nextAction && <p className="truncate text-xs text-[#F7B23B]">Tiếp theo: {a.nextAction}</p>}
    </button>
  );
}

/** Lịch gặp & công tác của một khách hàng / dự án — chính là lịch sử chăm sóc */
function ActivityList({ customerId, leadId }: { customerId?: string; leadId?: string }) {
  const { activities } = useApp();
  const scope = useActivityScope();
  const [form, setForm] = useState<{ a?: Activity } | null>(null);
  const [open, setOpen] = useState<string | null>(null);
  const list = activities.filter((a) => scope.includes(a.userId) && ((customerId && a.customerId === customerId) || (leadId && a.leadId === leadId))).sort((a, b) => b.from.localeCompare(a.from));
  return (
    <section>
      <div className="mb-2 flex items-center justify-between gap-2">
        <h3 className="text-sm font-semibold text-[#F1F5F9]">Lịch sử chăm sóc & công tác</h3>
        <button className={cn(btnGhost, btnSm)} onClick={() => setForm({})}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm lịch</button>
      </div>
      <div className="space-y-2">{list.slice(0, 8).map((a) => <ActivityRowCard key={a.id} a={a} onOpen={() => setOpen(a.id)} />)}</div>
      {!list.length && <p className="text-sm text-[#94A3B8]">Chưa có lịch gặp hoặc công tác.</p>}
      {form && <ActivityFormModal activity={form.a} preset={{ customerId, leadId, type: leadId && !customerId ? 'SURVEY' : 'MEETING' }} onClose={() => setForm(null)} />}
      {open && <ActivityDrawer id={open} onClose={() => setOpen(null)} onEdit={(a) => { setOpen(null); setForm({ a }); }} />}
    </section>
  );
}

function StaffModule() {
  const { activities, users, dept, customers, leads, canDo } = useApp();
  const scope = useActivityScope();
  const canApprove = useActivityApprover();
  const inR = useInRange();
  const [tab, setTab] = useState<'list' | 'approval' | 'summary'>('list');
  const [view, setView] = useState<'table' | 'calendar'>('table');
  const [q, setQ] = useState('');
  const [who, setWho] = useState('ALL');
  const [type, setType] = useState('ALL');
  const [form, setForm] = useState<{ a?: Activity } | null>(null);
  useIntent('staff.create', () => setForm({}));
  const [open, setOpen] = useState<string | null>(null);
  const [weekStart, setWeekStart] = useState(() => { const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() - ((d.getDay() + 6) % 7)); return d; });
  const mine = activities.filter((a) => scope.includes(a.userId));
  const pending = mine.filter((a) => a.status === 'PENDING_APPROVAL' && canApprove(a));
  const pendingExp = mine.filter((a) => (a.expenseStatus === 'SUBMITTED' && canApprove(a)) || (a.expenseStatus === 'HEAD_APPROVED' && canDo('claim.accounting')));
  const match = (a: Activity) => {
    const t = q.trim().toLowerCase();
    return (!t || [a.title, a.note, a.location, customers.find((c) => c.id === a.customerId)?.name ?? ''].some((v) => v.toLowerCase().includes(t))) && (who === 'ALL' || a.userId === who) && (type === 'ALL' || a.type === type);
  };
  const list = mine.filter((a) => match(a) && inR(a.from.slice(0, 10))).sort((a, b) => a.from.localeCompare(b.from));
  const live = list.filter((a) => !['CANCELLED', 'REJECTED'].includes(a.status));
  const people = users.filter((u) => scope.includes(u.id) && u.active);
  const days = Array.from({ length: 7 }, (_, i) => { const d = new Date(weekStart); d.setDate(d.getDate() + i); return d; });
  const dayKey = (d: Date) => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  const meetings = live.filter((a) => a.type === 'MEETING' || a.type === 'SURVEY');
  const trips = live.filter((a) => a.type === 'TRIP' && ['APPROVED', 'DONE'].includes(a.status));
  const leaves = live.filter((a) => a.type === 'LEAVE' && a.status === 'APPROVED');
  const waiting = pending.length + pendingExp.length;

  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Gặp khách hàng" value={String(meetings.length)} icon={Users} color={C.teal} sub={`${meetings.filter((a) => a.status === 'DONE').length} cuộc đã hoàn thành`} />
        <StatCard label="Ngày công tác" value={String(trips.reduce((s, a) => s + actDays(a), 0))} icon={Plane} color={C.blue} sub={`Chi phí ${compact(trips.reduce((s, a) => s + a.cost, 0))}`} />
        <StatCard label="Nghỉ & việc riêng" value={String(leaves.filter((a) => (a.leaveKind ?? 'LEAVE') === 'LEAVE').reduce((s, a) => s + actDays(a), 0))} icon={CalendarDays} color={C.red} sub={`${leaves.filter((a) => a.leaveKind && a.leaveKind !== 'LEAVE').length} lần đi muộn / giải trình`} />
        <StatCard label="Chờ duyệt" value={String(mine.filter((a) => a.status === 'PENDING_APPROVAL').length + pendingExp.length)} icon={Clock} color={C.orange} sub={waiting ? `${waiting} cần bạn duyệt` : 'Không có việc chờ bạn'} />
      </div>

      <Tabs tabs={[{ id: 'list', label: 'Lịch' }, { id: 'approval', label: waiting ? `Chờ duyệt (${waiting})` : 'Chờ duyệt' }, { id: 'summary', label: 'Tổng hợp' }]} value={tab} onChange={setTab} aside={<DateRangePicker />} />

      <FilterBar q={q} onQ={setQ} placeholder="Tìm tiêu đề, khách hàng, địa điểm..." status={type} onStatus={setType} statusLabel="Mọi loại" statusOptions={(Object.keys(ACTIVITY_TYPE) as ActivityType[]).map((t) => ({ value: t, label: ACTIVITY_TYPE[t].label }))} extraActive={who !== 'ALL' ? 1 : 0}>
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={who} onChange={(e) => setWho(e.target.value)} aria-label="Nhân sự">
          <option value="ALL">Tất cả nhân sự</option>
          {people.map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}
        </select>
      </FilterBar>

      {tab === 'list' && (
        <Panel
          title={view === 'table' ? `${list.length} lịch trong khoảng đang lọc` : `Tuần ${fmtDate(dayKey(days[0]))} – ${fmtDate(dayKey(days[6]))}`}
          action={
            <div className="flex flex-wrap items-center gap-2">
              <div className="flex rounded bg-[#0F141E] p-0.5" role="radiogroup" aria-label="Kiểu xem">
                <button role="radio" aria-checked={view === 'table'} onClick={() => setView('table')} className={cn('flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-medium', view === 'table' ? 'g-brand font-semibold text-[#0F141E]' : 'text-[#94A3B8]')}><FileSpreadsheet className="h-3.5 w-3.5" aria-hidden />Dạng bảng</button>
                <button role="radio" aria-checked={view === 'calendar'} onClick={() => setView('calendar')} className={cn('flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-medium', view === 'calendar' ? 'g-brand font-semibold text-[#0F141E]' : 'text-[#94A3B8]')}><CalendarDays className="h-3.5 w-3.5" aria-hidden />Lịch tuần</button>
              </div>
              <button className={cn(btnPrimary, btnSm, 'max-lg:hidden')} onClick={() => setForm({})}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm lịch</button>
            </div>
          }
        >
          {view === 'table' ? (
            <>
              <div className="space-y-2 md:hidden">{list.map((a) => <ActivityRowCard key={a.id} a={a} onOpen={() => setOpen(a.id)} />)}</div>
              <div className="hidden md:block">
                <Table head={['Thời gian', 'Nhân sự', 'Loại', 'Nội dung / khách hàng', 'Chi phí', 'Check-in', 'Trạng thái']} minW={980}>
                  {list.map((a) => {
                    const cust = customers.find((c) => c.id === a.customerId);
                    const lead = leads.find((l) => l.id === a.leadId);
                    return (
                      <tr key={a.id} className={cn(rowCls, 'cursor-pointer')} onClick={() => setOpen(a.id)}>
                        <td className={cn(tdFirst, 'whitespace-nowrap tabular-nums')}>{fmtDT(a.from)}<p className="text-xs text-[#94A3B8]">đến {fmtDT(a.to)}</p></td>
                        <td className={tdCls}>{users.find((u) => u.id === a.userId)?.name}</td>
                        <td className={tdCls}><span className="flex items-center gap-1.5 text-xs"><i className="h-2 w-2 shrink-0 rounded-full" style={{ background: ACTIVITY_TYPE[a.type].color }} />{a.type === 'LEAVE' ? LEAVE_KIND[a.leaveKind ?? 'LEAVE'] : ACTIVITY_TYPE[a.type].label}</span></td>
                        <td className={tdCls}><p className="max-w-[280px] truncate">{a.title}</p><p className="max-w-[280px] truncate text-xs text-[#94A3B8]">{cust?.name ?? lead?.company ?? a.location}</p></td>
                        <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{a.cost ? compact(a.cost) : '—'}{a.expenseStatus && <p className="text-[11px] text-[#94A3B8]">{EXPENSE_STATUS[a.expenseStatus].label}</p>}</td>
                        <td className={tdCls}>{a.checkin ? <Chip tone={a.checkin.lateMinutes > 0 ? 'orange' : 'teal'}>{a.checkin.lateMinutes > 0 ? `Trễ ${a.checkin.lateMinutes} phút` : 'Đúng giờ'}</Chip> : <span className="text-xs text-[#94A3B8]">—</span>}</td>
                        <td className={tdLast}><Chip tone={ACTIVITY_STATUS[a.status].tone}>{ACTIVITY_STATUS[a.status].label}</Chip></td>
                      </tr>
                    );
                  })}
                </Table>
              </div>
              {!list.length && <EmptyState text={<>Chưa có lịch trong khoảng thời gian này.</>} hint={<>Lên lịch gặp khách, công tác hoặc nghỉ để quản lý duyệt và theo dõi chi phí.</>} art="calendar" action="Thêm lịch ngay" onAction={() => setForm({})} />}
            </>
          ) : (
            <>
              <div className="mb-3 flex items-center gap-2">
                <button className={cn(btnGhost, btnSm)} onClick={() => setWeekStart((d) => new Date(d.getTime() - 7 * 864e5))} aria-label="Tuần trước"><ChevronRight className="h-4 w-4 rotate-180" /></button>
                <button className={cn(btnGhost, btnSm)} onClick={() => { const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() - ((d.getDay() + 6) % 7)); setWeekStart(d); }}>Tuần này</button>
                <button className={cn(btnGhost, btnSm)} onClick={() => setWeekStart((d) => new Date(d.getTime() + 7 * 864e5))} aria-label="Tuần sau"><ChevronRight className="h-4 w-4" /></button>
              </div>
              <div className="grid grid-cols-1 gap-2 md:grid-cols-7">
                {days.map((d) => {
                  const k = dayKey(d);
                  const items = mine.filter((a) => match(a) && a.from.slice(0, 10) <= k && a.to.slice(0, 10) >= k).sort((a, b) => a.from.localeCompare(b.from));
                  const today = k === todayISO();
                  return (
                    <div key={k} className={cn('min-h-[120px] rounded-md border p-2', today ? 'border-[#F28C33]/60 bg-[#F28C33]/5' : 'border-[#263044] bg-[#0B1019]')}>
                      <p className={cn('mb-2 text-xs font-semibold', today ? 'text-[#F7B23B]' : 'text-[#94A3B8]')}>{WEEKDAY[d.getDay()]} {pad2(d.getDate())}/{pad2(d.getMonth() + 1)}</p>
                      <div className="space-y-1.5">
                        {items.map((a) => (
                          <button key={a.id} className="w-full rounded-md px-2 py-1.5 text-left text-[11px] leading-tight hover:brightness-125" style={{ background: `${ACTIVITY_TYPE[a.type].color}22`, borderLeft: `3px solid ${ACTIVITY_TYPE[a.type].color}` }} onClick={() => setOpen(a.id)}>
                            <span className="block tabular-nums text-[#94A3B8]">{a.from.slice(11, 16)}</span>
                            <span className="block truncate text-[#F1F5F9]">{a.title}</span>
                            <span className="block truncate text-[#94A3B8]">{users.find((u) => u.id === a.userId)?.name}</span>
                          </button>
                        ))}
                      </div>
                    </div>
                  );
                })}
              </div>
            </>
          )}
        </Panel>
      )}

      {tab === 'approval' && (
        <>
          <Panel title={`Đề nghị chờ bạn duyệt (${pending.length})`}>
            <ul className="space-y-2">
              {pending.map((a) => {
                const cust = customers.find((c) => c.id === a.customerId);
                const lead = leads.find((l) => l.id === a.leadId);
                return (
                  <li key={a.id} className="rounded-md border border-[#263044] bg-[#151C29] p-3" style={{ borderLeft: `3px solid ${ACTIVITY_TYPE[a.type].color}` }}>
                    <div className="grid grid-cols-1 gap-3 lg:grid-cols-[1fr_auto]">
                      <button className="min-w-0 text-left" onClick={() => setOpen(a.id)}>
                        <p className="text-sm font-medium">{users.find((u) => u.id === a.userId)?.name}: {a.type === 'LEAVE' ? LEAVE_KIND[a.leaveKind ?? 'LEAVE'] : ACTIVITY_TYPE[a.type].label}</p>
                        <p className="text-xs text-[#94A3B8]">{fmtDT(a.from)} – {fmtDT(a.to)}{a.type === 'TRIP' || a.type === 'LEAVE' ? ` (${actDays(a)} ngày)` : ''}{cust ? `, gặp ${cust.name}` : lead ? `, dự án ${lead.company}` : ''}{a.location ? `, ${a.location}` : ''}</p>
                        <p className="mt-1 text-xs">{a.type === 'LEAVE' ? 'Lý do' : 'Mục tiêu'}: <span className="text-[#94A3B8]">{a.note || '—'}</span></p>
                        {(a.cost > 0 || (a.advance ?? 0) > 0) && <p className="text-xs tabular-nums">Chi phí đề xuất <b>{vnd(a.cost)}</b>{a.advance ? `, tạm ứng ${vnd(a.advance)}` : ''}{a.transport ? `, ${a.transport}` : ''}</p>}
                      </button>
                      <ApprovalButtons a={a} />
                    </div>
                  </li>
                );
              })}
            </ul>
            {!pending.length && <EmptyState text={<>Không có đề nghị chờ duyệt.</>} art="inbox" />}
          </Panel>
          <Panel title={`Chứng từ chi phí chờ duyệt (${pendingExp.length})`}>
            <ul className="space-y-2">
              {pendingExp.map((a) => (
                <li key={a.id}>
                  <button className="flex w-full flex-wrap items-center gap-3 rounded-md border border-[#263044] bg-[#151C29] p-3 text-left" onClick={() => setOpen(a.id)}>
                    <ReceiptIcon className="h-4 w-4 text-[#94A3B8]" aria-hidden />
                    <span className="min-w-0 flex-1 text-sm">{users.find((u) => u.id === a.userId)?.name}: {a.title}<span className="block text-xs text-[#94A3B8]">{(a.expenses ?? []).length} chứng từ</span></span>
                    <span className="tabular-nums">{vnd((a.expenses ?? []).reduce((s, x) => s + x.amount, 0))}</span>
                    {a.expenseStatus && <Chip tone={EXPENSE_STATUS[a.expenseStatus].tone}>{EXPENSE_STATUS[a.expenseStatus].label}</Chip>}
                  </button>
                </li>
              ))}
            </ul>
            {!pendingExp.length && <EmptyState text={<>Không có chứng từ chờ duyệt.</>} art="doc" />}
          </Panel>
        </>
      )}

      {tab === 'summary' && (
        <Panel title="Tổng hợp theo nhân sự (khoảng thời gian đang lọc)">
          <Table head={['Nhân sự', 'Phòng ban', 'Gặp khách', 'Khách đã gặp', 'Ngày công tác', 'Ngày nghỉ', 'Đi muộn / giải trình', 'Chi phí']} minW={860}>
            {people.map((u) => {
              const xs = live.filter((a) => a.userId === u.id);
              return (
                <tr key={u.id} className={rowCls}>
                  <td className={tdFirst}>{u.name}</td>
                  <td className={tdCls}>{dept(u.dept)?.short ?? 'Ban Giám đốc'}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{xs.filter((a) => a.type === 'MEETING' || a.type === 'SURVEY').length}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{new Set(xs.filter((a) => a.customerId).map((a) => a.customerId)).size}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{xs.filter((a) => a.type === 'TRIP' && ['APPROVED', 'DONE'].includes(a.status)).reduce((s, a) => s + actDays(a), 0)}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{xs.filter((a) => a.type === 'LEAVE' && a.status === 'APPROVED' && (a.leaveKind ?? 'LEAVE') === 'LEAVE').reduce((s, a) => s + actDays(a), 0)}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{xs.filter((a) => a.type === 'LEAVE' && a.leaveKind && a.leaveKind !== 'LEAVE').length}</td>
                  <td className={cn(tdLast, 'whitespace-nowrap text-right tabular-nums')}>{compact(xs.reduce((s, a) => s + a.cost, 0))}</td>
                </tr>
              );
            })}
          </Table>
        </Panel>
      )}
      <Fab label="Thêm lịch công tác" onClick={() => setForm({})} />
      {form && <ActivityFormModal activity={form.a} onClose={() => setForm(null)} />}
      {open && <ActivityDrawer id={open} onClose={() => setOpen(null)} onEdit={(a) => { setOpen(null); setForm({ a }); }} />}
    </div>
  );
}

// =====================================================================
//  PHÂN HỆ: CÔNG VIỆC — gom mọi việc chờ người đang đăng nhập xử lý
//  (thông báo duyệt hợp đồng / công tác / giải phóng hàng đều dẫn vào đây)
// =====================================================================

// =====================================================================
//  PHÂN HỆ: SẢN XUẤT (3 trạng thái: chờ sản xuất -> đang sản xuất -> đã hoàn thành -> hẹn lắp đặt)
// =====================================================================

const woLate = (w: WorkOrder) => w.stage !== 'DONE' && w.dueDate < todayISO();

/** Chuyển trạng thái lệnh sản xuất, ghi lịch sử, báo người liên quan */
function useWoActions() {
  const { me, setWorkOrders, jobs, users, dispatch, notify, audit, customers } = useApp();
  return (w: WorkOrder, to: WoStage) => {
    const now = Date.now();
    setWorkOrders((all) => all.map((x) => (x.id === w.id ? { ...x, stage: to, startedAt: to === 'IN_PROGRESS' ? now : x.startedAt, doneAt: to === 'DONE' ? now : x.doneAt, items: to === 'DONE' ? x.items.map((i) => ({ ...i, done: i.qty })) : x.items, history: [...x.history, { stage: to, at: now, by: me.id }] } : x)));
    audit('WO_STAGE', `${w.code}: ${WO_STAGE[to].label}`);
    if (to === 'DONE') {
      const j = jobs.find((x) => x.id === w.jobId);
      const to2 = users.filter((u) => u.active && (u.id === j?.ownerId || (u.dept === 'LAP_DAT' && u.role === 'DEPT_HEAD')));
      to2.forEach((u) => dispatch('APPROVAL_RESULT', { to: u, title: `Sản xuất xong: ${j ? jobCustName(j, customers) : w.title}`, body: `${w.code} đã hoàn thành, hẹn lịch lắp đặt với khách.`, module: 'install' }));
      notify(`${w.code} đã hoàn thành. Hẹn lịch lắp đặt để chuyển sang Lắp đặt.`, 'teal');
    } else notify(`${w.code}: ${WO_STAGE[to].label}`, 'teal');
  };
}

function WoActionButton({ w, onSchedule }: { w: WorkOrder; onSchedule: (w: WorkOrder) => void }) {
  const { canDo, installJobs } = useApp();
  const move = useWoActions();
  const ins = installJobs.find((i) => i.workOrderId === w.id);
  if (w.stage === 'WAITING') return <button className={cn(btnGhost, btnSm, 'whitespace-nowrap')} disabled={!canDo('production.manage')} onClick={(e) => { e.stopPropagation(); move(w, 'IN_PROGRESS'); }}><Factory className="h-3.5 w-3.5" aria-hidden />Bắt đầu sản xuất</button>;
  if (w.stage === 'IN_PROGRESS') return <button className={cn(btnBase, btnSm, 'whitespace-nowrap bg-[#00B894] font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} disabled={!canDo('production.manage')} onClick={(e) => { e.stopPropagation(); move(w, 'DONE'); }}><CheckCircle2 className="h-3.5 w-3.5" aria-hidden />Xác nhận hoàn thành</button>;
  if (ins) return <span className="whitespace-nowrap text-xs text-[#3DDBB6]">{ins.status === 'ACCEPTED' ? 'Đã lắp đặt' : `Hẹn lắp ${ins.from ? fmtDT(ins.from) : ''}`}</span>;
  return <button className={cn(btnPrimary, btnSm, 'whitespace-nowrap')} disabled={!canDo('install.manage') && !canDo('production.manage')} onClick={(e) => { e.stopPropagation(); onSchedule(w); }}><CalendarDays className="h-3.5 w-3.5" aria-hidden />Lên lịch lắp đặt</button>;
}

function WorkOrderDrawer({ id, onClose, onSchedule }: { id: string; onClose: () => void; onSchedule: (w: WorkOrder) => void }) {
  const { workOrders, setWorkOrders, jobs, customers, userName, canDo, stockMoves, stockItems, users } = useApp();
  const [out, setOut] = useState(false);
  const w = workOrders.find((x) => x.id === id);
  if (!w) return null;
  const j = jobs.find((x) => x.id === w.jobId);
  const moves = stockMoves.filter((m) => m.type === 'OUT' && m.woId === w.id);
  const can = canDo('production.manage');
  const patch = (p: Partial<WorkOrder>) => setWorkOrders((all) => all.map((x) => (x.id === w.id ? { ...x, ...p } : x)));
  return (
    <Drawer title={j ? jobCustName(j, customers) : w.title} eyebrow={`${w.code}${j ? ` · ${j.code}` : ''}`} badge={<Chip tone={WO_STAGE[w.stage].tone}>{WO_STAGE[w.stage].label}</Chip>} onClose={onClose}
      actions={<><WoActionButton w={w} onSchedule={onSchedule} />{canDo('stock.manage') && <button className={cn(btnGhost, btnSm)} onClick={() => setOut(true)}><Warehouse className="h-3.5 w-3.5" aria-hidden />Xuất vật tư</button>}</>}>
      <ol className="grid grid-cols-3 gap-2" aria-label="Trạng thái sản xuất">
        {WO_STAGES.map((s, i) => {
          const cur = WO_STAGES.indexOf(w.stage);
          return <li key={s} className={cn('rounded border px-2 py-2 text-center text-xs font-medium', i < cur || w.stage === 'DONE' ? 'border-[#00B894]/40 bg-[#00B894]/10 text-[#3DDBB6]' : i === cur ? 'border-[#F28C33] bg-[#F28C33]/10 text-[#F7B23B]' : 'border-[#263044] text-[#94A3B8]')}>{WO_STAGE[s].label}</li>;
        })}
      </ol>
      <InfoGrid rows={[
        ['Hạng mục', j?.title ?? w.title, true],
        ['Địa chỉ công trình', j?.siteAddress ?? '', true],
        ['Ngày nhận lệnh', fmtDate(w.startDate)],
        ['Hạn hoàn thành', <span className={woLate(w) ? 'text-[#F87171]' : ''}>{fmtDate(w.dueDate)}{woLate(w) ? ' (trễ hạn)' : ''}</span>],
        ['Phụ trách xưởng', userName(w.leaderId)],
        ['Kỹ thuật đo đạc', userName(j?.ownerId)],
      ]} />
      {can && w.stage !== 'DONE' && (
        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <Field label="Hạn hoàn thành"><input className={inputCls} type="date" value={w.dueDate} onChange={(e) => patch({ dueDate: e.target.value })} /></Field>
          <Field label="Phụ trách xưởng"><select className={inputCls} value={w.leaderId ?? ''} onChange={(e) => patch({ leaderId: e.target.value || undefined })}><option value="">Chưa giao</option>{users.filter((u) => u.active).map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}</select></Field>
        </div>
      )}
      <section>
        <h3 className="mb-2 text-sm font-semibold">Hạng mục sản xuất ({w.items.length})</h3>
        <Table head={['STT', 'Hạng mục', 'Kích thước', 'Số lượng']} minW={480}>
          {w.items.map((it, i) => (
            <tr key={it.id} className={rowCls}>
              <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{i + 1}</td>
              <td className={cn(tdCls, 'text-sm')}>{it.name}</td>
              <td className={cn(tdCls, 'whitespace-nowrap text-xs text-[#94A3B8]')}>{it.spec || '—'}</td>
              <td className={cn(tdLast, 'text-right tabular-nums whitespace-nowrap')}>{it.qty.toLocaleString('vi-VN')} {it.unit}</td>
            </tr>
          ))}
        </Table>
      </section>
      {j && j.files.length > 0 && (
        <section>
          <h3 className="mb-2 text-sm font-semibold">Bản vẽ & ảnh khảo sát</h3>
          <div className="grid grid-cols-3 gap-2 sm:grid-cols-5">
            {j.files.map((f) => (
              <a key={f.id} href={f.url} target="_blank" rel="noreferrer" className="block overflow-hidden rounded border border-[#263044] bg-[#1C2534]">
                {/* eslint-disable-next-line @next/next/no-img-element */}
                {f.url.startsWith('data:image') ? <img src={f.url} alt={f.name} className="aspect-square w-full object-cover" /> : <span className="flex aspect-square items-center justify-center p-2 text-center text-[11px] text-[#94A3B8]">{f.name}</span>}
              </a>
            ))}
          </div>
        </section>
      )}
      <section>
        <h3 className="mb-2 text-sm font-semibold">Vật tư đã xuất ({moves.length})</h3>
        {moves.length ? (
          <ul className="space-y-1 text-sm">
            {moves.map((m) => { const it = stockItems.find((s) => s.id === m.itemId); return <li key={m.id} className="flex justify-between gap-2 rounded bg-[#1C2534] px-3 py-1.5"><span>{it?.name ?? m.itemId} <span className="text-xs text-[#94A3B8]">{m.code}, {fmtDate(m.date)}</span></span><span className="whitespace-nowrap tabular-nums">{m.qty} {it?.unit}</span></li>; })}
          </ul>
        ) : <p className="text-sm text-[#94A3B8]">Chưa xuất vật tư cho lệnh này.</p>}
      </section>
      <Field label="Ghi chú xưởng"><textarea className={cn(inputCls, 'min-h-16')} disabled={!can} value={w.note} onChange={(e) => patch({ note: e.target.value })} /></Field>
      <section>
        <h3 className="mb-2 text-sm font-semibold">Lịch sử</h3>
        <ul className="space-y-1 text-xs text-[#94A3B8]">{[...w.history].reverse().map((h, i) => <li key={i}>{new Date(h.at).toLocaleString('vi-VN')}: {WO_STAGE[h.stage]?.label ?? h.stage}, {userName(h.by)}{h.note ? `. ${h.note}` : ''}</li>)}</ul>
      </section>
      {out && <StockVoucherModal type="OUT" preset={{ woId: w.id, jobId: w.jobId }} onClose={() => setOut(false)} />}
    </Drawer>
  );
}

function ProductionModule() {
  const { workOrders, jobs, customers, installJobs, userName } = useApp();
  const inR = useInRange();
  const [st, setSt] = useState<WoStage | 'ALL'>('WAITING');
  const [q, setQ] = useState('');
  const [open, setOpen] = useState<string | null>(null);
  const [schedule, setSchedule] = useState<WorkOrder | null>(null);
  const t = q.trim().toLowerCase();
  const jobOf = (w: WorkOrder) => jobs.find((j) => j.id === w.jobId);
  const visible = workOrders.filter((w) => w.stage !== 'DONE' || !installJobs.some((i) => i.workOrderId === w.id && i.status === 'ACCEPTED') || inR(w.dueDate));
  const count = (s: WoStage) => visible.filter((w) => w.stage === s).length;
  const list = visible.filter((w) => (st === 'ALL' || w.stage === st) && (!t || `${w.code} ${w.title} ${jobOf(w)?.siteAddress ?? ''}`.toLowerCase().includes(t)))
    .sort((a, b) => WO_STAGES.indexOf(a.stage) - WO_STAGES.indexOf(b.stage) || a.dueDate.localeCompare(b.dueDate));
  const paged = usePaged(list, 20);
  const waitInstall = workOrders.filter((w) => w.stage === 'DONE' && !installJobs.some((i) => i.workOrderId === w.id)).length;
  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Chờ sản xuất" value={String(count('WAITING'))} icon={Package} color={C.sand} sub="Đã nhận cọc, chờ xưởng nhận" />
        <StatCard label="Đang sản xuất" value={String(count('IN_PROGRESS'))} icon={Factory} color={C.blue} sub={`${workOrders.filter(woLate).length} lệnh trễ hạn`} />
        <StatCard label="Hoàn thành, chờ hẹn lắp" value={String(waitInstall)} icon={CalendarDays} color={C.orange} />
        <StatCard label="Hoàn thành trong kỳ" value={String(workOrders.filter((w) => w.stage === 'DONE' && w.doneAt && inR(new Date(w.doneAt))).length)} icon={CheckCircle2} color={C.teal} />
      </div>
      <Panel>
        <div className="mb-3 flex flex-wrap items-center gap-2"><SearchBox value={q} onChange={setQ} placeholder="Tìm mã lệnh, khách hàng, địa chỉ" /><div className="ml-auto hidden lg:block"><DateRangePicker /></div></div>
        <StagePills items={[...WO_STAGES.map((s) => ({ id: s as WoStage | 'ALL', label: WO_STAGE[s].label, count: count(s) })), { id: 'ALL', label: 'Tất cả', count: visible.length }]} value={st} onChange={(v) => { setSt(v); paged.setPage(1); }} />
        <div className="mt-3">
          <Table head={['STT', 'Lệnh SX', 'Khách hàng', 'Hạng mục', 'Ngày nhận', 'Hạn hoàn thành', 'Trạng thái', 'Thao tác']} minW={1080}>
            {paged.slice.map((w, i) => {
              const j = jobOf(w);
              return (
                <tr key={w.id} className={cn(rowCls, 'cursor-pointer')} onClick={() => setOpen(w.id)}>
                  <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{(paged.page - 1) * 20 + i + 1}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap font-mono text-xs text-[#F7B23B]')}>{w.code}</td>
                  <td className={tdCls}><p className="font-medium">{j ? jobCustName(j, customers) : customers.find((c) => c.id === w.customerId)?.name ?? '—'}</p><p className="text-xs text-[#94A3B8]">{userName(w.leaderId)}</p></td>
                  <td className={cn(tdCls, 'max-w-[240px]')}><p className="line-clamp-2 text-xs">{j?.title ?? w.title}</p><p className="text-[11px] text-[#94A3B8]">{w.items.length} hạng mục</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-xs tabular-nums')}>{fmtDate(w.startDate)}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-xs tabular-nums', woLate(w) && 'text-[#F87171]')}>{fmtDate(w.dueDate)}{woLate(w) && <p className="text-[11px]">Trễ hạn</p>}</td>
                  <td className={tdCls}><Chip tone={WO_STAGE[w.stage].tone}>{WO_STAGE[w.stage].label}</Chip></td>
                  <td className={tdLast}><WoActionButton w={w} onSchedule={setSchedule} /></td>
                </tr>
              );
            })}
          </Table>
        </div>
        {!list.length && <EmptyState text={<>Không có lệnh sản xuất</>} hint={<>Lệnh tự tạo khi đơn hàng nhận cọc.</>} art="box" />}
        <Pagination paged={paged} unit="lệnh" />
      </Panel>
      {open && <WorkOrderDrawer id={open} onClose={() => setOpen(null)} onSchedule={(w) => { setOpen(null); setSchedule(w); }} />}
      {schedule && <InstallScheduleModal wo={schedule} onClose={() => setSchedule(null)} />}
    </div>
  );
}

// =====================================================================
//  PHÂN HỆ: LẮP ĐẶT, NGHIỆM THU, BÀN GIAO & THU TIỀN
// =====================================================================

/** Trạng thái hiển thị của 1 lịch lắp đặt (kết hợp tiền thu của đơn) */
type InstallView = 'WAIT' | 'SCHEDULED' | 'IN_PROGRESS' | 'WAIT_PAYMENT' | 'DONE';
const INSTALL_VIEW: Record<InstallView, { label: string; tone: Tone }> = {
  WAIT: { label: 'Chờ hẹn lắp', tone: 'orange' },
  SCHEDULED: { label: 'Đã hẹn lắp', tone: 'blue' },
  IN_PROGRESS: { label: 'Đang lắp đặt', tone: 'orange' },
  WAIT_PAYMENT: { label: 'Đã nghiệm thu, chờ thu tiền', tone: 'red' },
  DONE: { label: 'Hoàn tất, bảo hành', tone: 'teal' },
};
const installView = (i: InstallJob, job: Job | undefined, receipts: Receipt[]): InstallView => {
  if (i.status !== 'ACCEPTED') return i.status;
  if (!job) return 'DONE';
  const m = jobMoney(job, receipts);
  return m.confirmed >= m.value ? 'DONE' : 'WAIT_PAYMENT';
};

function InstallScheduleModal({ wo, ij, onClose }: { wo?: WorkOrder; ij?: InstallJob; onClose: () => void }) {
  const { installJobs, setInstallJobs, jobs, users, me, notify, audit, dispatch, customers } = useApp();
  const job = jobs.find((j) => j.id === (ij?.jobId ?? wo?.jobId));
  const start = new Date(Date.now() + 864e5); start.setHours(8, 0, 0, 0);
  const end = new Date(start); end.setHours(17, 0, 0, 0);
  const team0 = users.filter((u) => u.active && u.dept === 'LAP_DAT');
  const [f, setF] = useState({ from: ij?.from || toLocal(start), to: ij?.to || toLocal(end), leaderId: ij?.leaderId ?? team0[0]?.id ?? me.id, team: ij?.team ?? [], address: ij?.address ?? job?.siteAddress ?? '', note: ij?.note ?? '' });
  const [touched, setTouched] = useState(false);
  const errs: string[] = [];
  if (!f.from || !f.to || f.to <= f.from) errs.push('Giờ kết thúc phải sau giờ bắt đầu');
  if (f.address.trim().length < 5) errs.push('Nhập địa chỉ lắp đặt');
  const save = () => {
    setTouched(true);
    if (errs.length) return;
    if (ij) {
      setInstallJobs((all) => all.map((x) => (x.id === ij.id ? { ...x, ...f, address: f.address.trim(), note: f.note.trim() } : x)));
      notify('Đã đổi lịch lắp đặt', 'teal');
    } else {
      const code = nextCode(installJobs.map((x) => x.code), `LD-${new Date().getFullYear()}-`, 4);
      const n: InstallJob = { id: uid('ij'), code, title: `Lắp đặt ${job?.title ?? wo?.title ?? ''}`, workOrderId: wo?.id, jobId: job?.id, leadId: job?.leadId, customerId: job?.customerId ?? wo?.customerId, address: f.address.trim(), leaderId: f.leaderId, team: f.team, from: f.from, to: f.to, status: 'SCHEDULED', checkins: [], defects: [], note: f.note.trim(), createdAt: todayISO() };
      setInstallJobs((p) => [n, ...p]);
      const leader = users.find((u) => u.id === f.leaderId);
      if (leader && leader.id !== me.id) dispatch('APPROVAL_RESULT', { to: leader, title: `Lịch lắp đặt ${fmtDT(f.from)}`, body: `${job ? jobCustName(job, customers) : ''}, ${f.address.trim()}`, module: 'install' });
      audit('INSTALL_CREATE', `Hẹn lắp ${code} ${fmtDT(f.from)}`);
      notify(`Đã hẹn lắp đặt ${fmtDT(f.from)}, chuyển sang Lắp đặt`, 'teal');
    }
    onClose();
  };
  return (
    <Modal title={ij ? `Đổi lịch ${ij.code}` : 'Lên lịch lắp đặt'} onClose={onClose} wide footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>{ij ? 'Lưu lịch' : 'Hẹn lắp đặt'}</button></>}>
      {job && <p className="mb-4 rounded bg-[#1C2534] px-3 py-2 text-sm"><b>{jobCustName(job, customers)}</b>, {jobPhone(job, customers)}<span className="block text-xs text-[#94A3B8]">{job.title}</span></p>}
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <Field label="Bắt đầu lắp *"><input className={inputCls} type="datetime-local" value={f.from} onChange={(e) => setF({ ...f, from: e.target.value })} /></Field>
        <Field label="Dự kiến xong *"><input className={inputCls} type="datetime-local" value={f.to} onChange={(e) => setF({ ...f, to: e.target.value })} /></Field>
        <Field label="Địa chỉ lắp đặt *" className="sm:col-span-2"><input className={inputCls} value={f.address} onChange={(e) => setF({ ...f, address: e.target.value })} /></Field>
        <Field label="Đội trưởng (bàn giao, thu tiền)"><select className={inputCls} value={f.leaderId} onChange={(e) => setF({ ...f, leaderId: e.target.value })}>{users.filter((u) => u.active).map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}</select></Field>
        <Field label="Ghi chú"><input className={inputCls} value={f.note} onChange={(e) => setF({ ...f, note: e.target.value })} placeholder="Giờ thi công, thang máy, bảo vệ tòa nhà..." /></Field>
      </div>
      <p className="mb-2 mt-4 text-xs font-medium text-[#94A3B8]">Thành viên đội lắp</p>
      <div className="flex flex-wrap gap-2">
        {(team0.length ? team0 : users.filter((u) => u.active)).filter((u) => u.id !== f.leaderId).map((u) => (
          <label key={u.id} className={cn('flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs', f.team.includes(u.id) ? 'border-[#F28C33] bg-[#F28C33]/10 text-[#F7B23B]' : 'border-[#263044] text-[#94A3B8]')}>
            <input type="checkbox" className="sr-only" checked={f.team.includes(u.id)} onChange={() => setF({ ...f, team: f.team.includes(u.id) ? f.team.filter((x) => x !== u.id) : [...f.team, u.id] })} />{u.name}
          </label>
        ))}
      </div>
      {touched && errs.length > 0 && <ul className="mt-3 space-y-0.5 text-xs text-[#F87171]">{errs.map((x) => <li key={x}>{x}</li>)}</ul>}
    </Modal>
  );
}

/** Khung ký tay điện tử (chuột / cảm ứng / bút), xuất ảnh PNG nền trắng */
function SignaturePad({ label, signer, value, onChange }: { label: string; signer?: string; value?: string; onChange: (v?: string) => void }) {
  const ref = useRef<HTMLCanvasElement>(null);
  const drawing = useRef(false);
  const lastPt = useRef<{ x: number; y: number } | null>(null);
  const setup = () => {
    const c = ref.current;
    if (!c) return null;
    const r = c.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    if (c.width !== Math.round(r.width * dpr)) {
      c.width = Math.round(r.width * dpr); c.height = Math.round(r.height * dpr);
      const ctx = c.getContext('2d');
      if (ctx) { ctx.scale(dpr, dpr); ctx.fillStyle = '#FFFFFF'; ctx.fillRect(0, 0, r.width, r.height); }
    }
    return c.getContext('2d');
  };
  useEffect(() => { setup(); }, []); // eslint-disable-line react-hooks/exhaustive-deps
  const pt = (e: { clientX: number; clientY: number }) => { const r = ref.current!.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
  const down = (e: { clientX: number; clientY: number; pointerId: number; currentTarget: HTMLCanvasElement }) => { setup(); drawing.current = true; lastPt.current = pt(e); e.currentTarget.setPointerCapture(e.pointerId); };
  const move = (e: { clientX: number; clientY: number }) => {
    if (!drawing.current || !lastPt.current) return;
    const ctx = ref.current?.getContext('2d');
    if (!ctx) return;
    const p = pt(e);
    ctx.strokeStyle = '#0F172A'; ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.beginPath(); ctx.moveTo(lastPt.current.x, lastPt.current.y); ctx.lineTo(p.x, p.y); ctx.stroke();
    lastPt.current = p;
  };
  const up = () => { if (!drawing.current) return; drawing.current = false; lastPt.current = null; onChange(ref.current?.toDataURL('image/png')); };
  const clear = () => { const c = ref.current; const ctx = c?.getContext('2d'); if (c && ctx) { const r = c.getBoundingClientRect(); ctx.fillStyle = '#FFFFFF'; ctx.fillRect(0, 0, r.width, r.height); } onChange(undefined); };
  return (
    <div>
      <div className="mb-1.5 flex items-center justify-between gap-2"><span className="text-xs font-medium text-[#94A3B8]">{label}</span><button type="button" className="text-xs text-[#94A3B8] hover:text-[#F87171]" onClick={clear}>Ký lại</button></div>
      <div className={cn('relative overflow-hidden rounded border-2', value ? 'border-[#00B894]' : 'border-dashed border-[#263044]')}>
        <canvas ref={ref} className="block h-36 w-full cursor-crosshair touch-none bg-white" onPointerDown={down} onPointerMove={move} onPointerUp={up} onPointerLeave={up} aria-label={label} />
        {!value && <span className="pointer-events-none absolute inset-0 flex items-center justify-center text-sm text-slate-400">Ký vào đây</span>}
      </div>
      {signer && <p className="mt-1 text-center text-xs text-[#94A3B8]">{signer}</p>}
    </div>
  );
}

async function sha256Hex(text: string) {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
  return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('');
}
const addMonthsISO = (iso10: string, months: number) => { const d = new Date(`${iso10}T12:00:00`); d.setMonth(d.getMonth() + months); return iso(d); };

function AcceptanceModal({ ij, onClose }: { ij: InstallJob; onClose: () => void }) {
  const { me, jobs, workOrders, receipts, setReceipts, setInstallJobs, setWorkOrders, customers, users, dispatch, notify, audit, installJobs, mfgConfig } = useApp();
  const job = jobs.find((j) => j.id === ij.jobId);
  const wo = workOrders.find((w) => w.id === ij.workOrderId);
  const items = wo?.items.map((x) => x.name) ?? (job?.quotes.find((q) => q.version === job.wonVersion)?.lines.map((l) => `${l.location ? `${l.location}: ` : ''}${l.name}`) ?? []);
  const money = job ? jobMoney(job, receipts) : { value: 0, collected: 0, remaining: 0, confirmed: 0, pending: 0, receivable: 0 };
  const cust = customers.find((c) => c.id === (job?.customerId ?? ij.customerId));
  const [checked, setChecked] = useState<string[]>(items);
  const [note, setNote] = useState(ij.defects.filter((d) => !d.fixed).map((d) => d.text).join('; '));
  const [rep, setRep] = useState(job?.siteContact ?? cust?.name ?? '');
  const [repTitle, setRepTitle] = useState('Chủ nhà');
  const [repPhone, setRepPhone] = useState(job?.sitePhone ?? cust?.contactPhone ?? '');
  const [pay, setPay] = useState(money.remaining);
  const [method, setMethod] = useState<'CASH' | 'TRANSFER'>('CASH');
  const [photo, setPhoto] = useState<string | undefined>();
  const [months, setMonths] = useState(job?.warrantyMonths ?? mfgConfig.warrantyMonths);
  const [custSign, setCustSign] = useState<string | undefined>();
  const [staffSign, setStaffSign] = useState<string | undefined>();
  const [agree, setAgree] = useState(false);
  const [busy, setBusy] = useState(false);
  const [touched, setTouched] = useState(false);
  const today = todayISO();
  const until = addMonthsISO(today, months);
  const debtAfter = Math.max(0, money.remaining - pay);
  const result: 'PASS' | 'PASS_WITH_NOTES' = note.trim() || checked.length < items.length ? 'PASS_WITH_NOTES' : 'PASS';
  const errs: string[] = [];
  if (rep.trim().length < 2) errs.push('Nhập người đại diện khách nhận bàn giao');
  if (!custSign) errs.push('Khách hàng chưa ký');
  if (!staffSign) errs.push('Đại diện công ty chưa ký');
  if (!agree) errs.push('Xác nhận khách đã đọc và đồng ý nội dung biên bản');
  if (pay > 0 && method === 'TRANSFER' && !photo) errs.push('Chuyển khoản: chụp màn hình giao dịch');
  if (pay > money.remaining) errs.push('Số tiền thu vượt số còn phải thu');
  const save = async () => {
    setTouched(true);
    if (errs.length) return notify(errs[0], 'red');
    setBusy(true);
    try {
      const docCode = nextCode(installJobs.map((x) => x.acceptance?.docCode ?? ''), `BBNT-${new Date().getFullYear()}-`, 4);
      const signedAt = Date.now();
      let receiptId: string | undefined;
      if (pay > 0 && job) {
        const r: Receipt = {
          id: uid('rc'), code: nextCode(receipts.map((x) => x.code), `PT-${new Date().getFullYear()}-`, 4), jobId: job.id, stageId: job.schedule.find((s) => s.trigger === 'ACCEPT')?.id, amount: pay, method,
          collectedBy: me.id, collectedAt: signedAt, photo, note: `Thu khi bàn giao, ${docCode}`, status: method === 'CASH' ? 'HOLDING' : 'SUBMITTED', submittedAt: method === 'CASH' ? undefined : signedAt,
        };
        receiptId = r.id;
        setReceipts((p) => [r, ...p]);
        users.filter((u) => u.active && u.role === 'ACCOUNTANT').forEach((u) => dispatch('APPROVAL_RESULT', { to: u, title: `Thu khi bàn giao ${r.code}: ${vnd(pay)}`, body: `${jobCustName(job, customers)}, ${method === 'CASH' ? 'tiền mặt, nộp trong ngày' : 'chuyển khoản, chờ đối chiếu'}`, module: 'tasks' }));
      }
      const payload = { docCode, job: job?.code, install: ij.code, items: checked, note: note.trim(), rep: rep.trim(), pay, method, debtAfter, months, until, signedAt, by: me.id };
      const hash = await sha256Hex(JSON.stringify(payload) + (custSign ?? '').slice(-64) + (staffSign ?? '').slice(-64));
      const acc: InstallAcceptance = {
        at: new Date(signedAt).toISOString(), customerRep: rep.trim(), customerTitle: repTitle.trim(), customerPhone: repPhone.trim(), result, note: note.trim(), by: me.id,
        docCode, checked, customerSign: custSign, staffSign, signedAt, hash, paidAmount: pay, paidMethod: pay > 0 ? method : undefined, receiptId, debtAfter, warrantyMonths: months, warrantyUntil: until,
      };
      setInstallJobs((all) => all.map((x) => (x.id === ij.id ? { ...x, status: 'ACCEPTED', acceptance: acc } : x)));
      if (wo && wo.stage !== 'DONE') setWorkOrders((all) => all.map((w) => (w.id === wo.id ? { ...w, stage: 'DONE' } : w)));
      audit('INSTALL_ACCEPT', `${docCode}: nghiệm thu ${ij.code}, thu ${vnd(pay)}, bảo hành đến ${fmtDate(until)}`);
      notify(`Đã ký biên bản ${docCode}.${pay > 0 && method === 'CASH' ? ` Nộp ${vnd(pay)} về kế toán trong ngày.` : ''} Xuất PDF gửi khách.`, 'teal');
      onClose();
    } catch { notify('Không ký được biên bản, thử lại', 'red'); } finally { setBusy(false); }
  };
  const sec = 'rounded-md border border-[#263044] p-4';
  return (
    <Modal title="Nghiệm thu, bàn giao & thu tiền" onClose={onClose} wide
      footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={cn(btnBase, 'bg-[#00B894] px-3.5 py-2 font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} disabled={busy} onClick={() => void save()}><ShieldCheck className="h-4 w-4" aria-hidden />{busy ? 'Đang ký...' : 'Ký & hoàn tất bàn giao'}</button></>}>
      <div className="space-y-4">
        <section className={sec}>
          <h3 className="mb-2 text-sm font-semibold">1. Hạng mục bàn giao</h3>
          <ul className="space-y-1.5">
            {items.map((x) => (
              <li key={x}>
                <label className="flex cursor-pointer items-start gap-2 text-sm">
                  <input type="checkbox" className="mt-0.5 h-4 w-4 accent-[#00B894]" checked={checked.includes(x)} onChange={() => setChecked((c) => (c.includes(x) ? c.filter((y) => y !== x) : [...c, x]))} />
                  <span className={checked.includes(x) ? '' : 'text-[#94A3B8] line-through'}>{x}</span>
                </label>
              </li>
            ))}
          </ul>
          <Field label="Tồn tại cần khắc phục (nếu có)" className="mt-3"><input className={inputCls} value={note} onChange={(e) => setNote(e.target.value)} placeholder="VD: Bổ sung keo silicon góc cửa sổ phòng ngủ" /></Field>
          <p className="mt-2 text-xs"><Chip tone={result === 'PASS' ? 'teal' : 'orange'}>{result === 'PASS' ? 'Đạt yêu cầu' : 'Đạt, có tồn tại khắc phục'}</Chip></p>
        </section>

        <section className={sec}>
          <h3 className="mb-2 text-sm font-semibold">2. Thanh toán</h3>
          <div className="grid grid-cols-3 gap-2">
            <MiniStat label="Giá trị hợp đồng" value={compact(money.value)} />
            <MiniStat label="Đã thanh toán" value={compact(money.collected)} tone="teal" />
            <MiniStat label="Còn phải thu" value={compact(money.remaining)} tone={money.remaining ? 'red' : 'teal'} />
          </div>
          <div className="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <Field label="Thu khi bàn giao"><MoneyInput value={pay} onChange={setPay} /></Field>
            <Field label="Hình thức">
              <div className="flex rounded bg-[#0F141E] p-0.5" role="radiogroup" aria-label="Hình thức">
                {(['CASH', 'TRANSFER'] as const).map((m) => <button key={m} type="button" role="radio" aria-checked={method === m} onClick={() => setMethod(m)} className={cn('flex-1 rounded-md px-3 py-2 text-sm font-medium', method === m ? 'g-brand font-semibold text-[#0F141E]' : 'text-[#94A3B8]')}>{m === 'CASH' ? 'Tiền mặt' : 'Chuyển khoản'}</button>)}
              </div>
            </Field>
          </div>
          {pay > 0 && (
            <div className="mt-3 flex flex-wrap items-center gap-3">
              <FilePicker accept="image/*" onFiles={(f) => compressImage(f[0], 1000).then(setPhoto).catch(() => notify('Không đọc được ảnh', 'red'))} className={cn(btnGhost, btnSm, 'inline-flex')}><Upload className="h-3.5 w-3.5" aria-hidden />{photo ? 'Đổi ảnh' : method === 'TRANSFER' ? 'Ảnh chuyển khoản *' : 'Ảnh tiền / phiếu (tùy chọn)'}</FilePicker>
              {/* eslint-disable-next-line @next/next/no-img-element */}
              {photo && <img src={photo} alt="Chứng từ" className="h-12 rounded object-cover" />}
            </div>
          )}
          <p className={cn('mt-2 text-xs', debtAfter ? 'text-[#F7B23B]' : 'text-[#3DDBB6]')}>{debtAfter ? `Sau bàn giao còn nợ ${vnd(debtAfter)}, ghi vào biên bản.` : 'Khách thanh toán đủ khi bàn giao.'}</p>
        </section>

        <section className={sec}>
          <h3 className="mb-2 text-sm font-semibold">3. Bảo hành</h3>
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <Field label="Thời hạn (tháng)"><input className={inputCls} type="number" min={0} max={120} value={months} onChange={(e) => setMonths(Math.max(0, Number(e.target.value) || 0))} /></Field>
            <Field label="Từ ngày"><input className={inputCls} value={fmtDate(today)} disabled /></Field>
            <Field label="Đến ngày"><input className={inputCls} value={fmtDate(until)} disabled /></Field>
          </div>
          <p className="mt-2 text-xs text-[#94A3B8]">Bảo hành có hiệu lực khi khách thanh toán đủ giá trị hợp đồng. Không bảo hành hư hỏng do tác động ngoại lực, tự ý tháo lắp, thiên tai.</p>
        </section>

        <section className={sec}>
          <h3 className="mb-2 text-sm font-semibold">4. Đại diện & ký điện tử</h3>
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <Field label="Đại diện khách *"><input className={inputCls} value={rep} onChange={(e) => setRep(e.target.value)} /></Field>
            <Field label="Chức vụ / quan hệ"><input className={inputCls} value={repTitle} onChange={(e) => setRepTitle(e.target.value)} /></Field>
            <Field label="Số điện thoại"><input className={inputCls} inputMode="tel" value={repPhone} onChange={(e) => setRepPhone(e.target.value)} /></Field>
          </div>
          <div className="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <SignaturePad label="Chữ ký khách hàng *" signer={rep} value={custSign} onChange={setCustSign} />
            <SignaturePad label="Chữ ký đại diện công ty *" signer={me.name} value={staffSign} onChange={setStaffSign} />
          </div>
          <label className="mt-3 flex cursor-pointer items-start gap-2 text-sm">
            <input type="checkbox" className="mt-0.5 h-4 w-4 accent-[#00B894]" checked={agree} onChange={(e) => setAgree(e.target.checked)} />
            <span>Khách hàng đã kiểm tra, đọc và đồng ý nội dung nghiệm thu, thanh toán và điều kiện bảo hành.</span>
          </label>
          <p className="mt-2 text-xs text-[#94A3B8]">Ký lúc lưu được đóng dấu thời gian và mã xác thực SHA-256 in trên biên bản để đối chiếu, chống sửa nội dung sau khi ký.</p>
        </section>
        {touched && errs.length > 0 && <ul className="space-y-0.5 text-xs text-[#F87171]">{errs.map((x) => <li key={x}>{x}</li>)}</ul>}
      </div>
    </Modal>
  );
}

/** Biên bản nghiệm thu, bàn giao, thanh toán & xác nhận bảo hành (in PDF) */
function acceptanceHtml(i: InstallJob, job: Job | undefined, company: CompanyInfo, custName: string, staff: string, prevPaid: number) {
  const a = i.acceptance!;
  const items = (a.checked ?? []).map((x, k) => `<tr><td class="c">${k + 1}</td><td>${esc(x)}</td><td class="c">Đạt</td></tr>`).join('') || '<tr><td colspan="3" class="c">Theo hợp đồng</td></tr>';
  const value = job?.contractValue ?? 0;
  const sig = (src?: string) => (src ? `<img src="${src}" alt="Chữ ký" style="height:70px;max-width:220px;object-fit:contain">` : '<br><br><br>');
  const t = new Date(a.signedAt ?? Date.parse(a.at));
  return `<table class="layout"><tr><td><b>${esc(company.legalName)}</b><br>${esc(company.address)}<br>ĐT: ${esc(company.phone)}</td><td class="r">Số: <b>${esc(a.docCode ?? i.code)}</b><br>Ngày: ${t.toLocaleDateString('vi-VN')}</td></tr></table>
<h1>BIÊN BẢN NGHIỆM THU, BÀN GIAO,<br>THANH TOÁN VÀ XÁC NHẬN BẢO HÀNH</h1>
<p>Công trình: <b>${esc(job?.title ?? i.title)}</b>${job ? ` (đơn ${esc(job.code)})` : ''}<br>Địa chỉ: ${esc(i.address)}<br>Thời gian: ${t.toLocaleString('vi-VN')}</p>
<p><b>BÊN A (KHÁCH HÀNG):</b> ${esc(custName)}<br>Đại diện: ${esc(a.customerRep)}${a.customerTitle ? `, ${esc(a.customerTitle)}` : ''}${a.customerPhone ? `, ĐT ${esc(a.customerPhone)}` : ''}</p>
<p><b>BÊN B (ĐƠN VỊ THI CÔNG):</b> ${esc(company.legalName)}<br>Đại diện: ${esc(staff)}</p>
<h3>1. Hạng mục nghiệm thu, bàn giao</h3>
<table class="items"><thead><tr><th>STT</th><th>Hạng mục</th><th>Kết quả</th></tr></thead><tbody>${items}</tbody></table>
<p>Kết luận: ${a.result === 'PASS' ? 'Đạt yêu cầu, Bên A đồng ý nghiệm thu và nhận bàn giao đưa vào sử dụng.' : 'Đạt yêu cầu, Bên A đồng ý nghiệm thu; Bên B khắc phục tồn tại sau.'}${a.note ? `<br>Tồn tại: ${esc(a.note)}` : ''}</p>
<h3>2. Thanh toán</h3>
<table class="items"><tbody>
<tr><td>Giá trị hợp đồng</td><td class="r">${value.toLocaleString('vi-VN')} đ</td></tr>
<tr><td>Đã thanh toán trước bàn giao</td><td class="r">${prevPaid.toLocaleString('vi-VN')} đ</td></tr>
<tr><td>Thanh toán khi bàn giao${a.paidMethod ? ` (${a.paidMethod === 'CASH' ? 'tiền mặt' : 'chuyển khoản'})` : ''}</td><td class="r">${(a.paidAmount ?? 0).toLocaleString('vi-VN')} đ</td></tr>
<tr><td><b>Còn lại</b></td><td class="r"><b>${(a.debtAfter ?? 0).toLocaleString('vi-VN')} đ</b></td></tr></tbody></table>
${a.debtAfter ? `<p>Bên A cam kết thanh toán số còn lại ${moneyToWordsVN(a.debtAfter).toLowerCase()} theo thỏa thuận.</p>` : '<p>Bên A đã thanh toán đủ giá trị hợp đồng.</p>'}
<h3>3. Xác nhận bảo hành</h3>
<p>Thời hạn bảo hành <b>${a.warrantyMonths ?? job?.warrantyMonths ?? 0} tháng</b>, từ ${t.toLocaleDateString('vi-VN')} đến <b>${a.warrantyUntil ? fmtDate(a.warrantyUntil) : ''}</b>. Bảo hành có hiệu lực khi Bên A thanh toán đủ. Không áp dụng cho hư hỏng do tác động ngoại lực, tự ý tháo lắp, sửa chữa hoặc thiên tai.${company.phone ? ` Liên hệ bảo hành: ${esc(company.phone)}.` : ''}</p>
<table class="layout sign"><tr><td><b>ĐẠI DIỆN BÊN A</b><br>(ký điện tử)<br>${sig(a.customerSign)}<br><b>${esc(a.customerRep)}</b></td><td><b>ĐẠI DIỆN BÊN B</b><br>(ký điện tử)<br>${sig(a.staffSign)}<br><b>${esc(staff)}</b></td></tr></table>
<p class="small" style="font-size:9pt;color:#555;margin-top:12px">Ký điện tử lúc ${t.toLocaleString('vi-VN')}. Mã xác thực: ${esc((a.hash ?? '').slice(0, 32).toUpperCase())}</p>`;
}

function InstallDrawer({ id, onClose }: { id: string; onClose: () => void }) {
  const { installJobs, setInstallJobs, users, userName, me, canDo, notify, company, jobs, receipts, customers, openJob } = useApp();
  const i = installJobs.find((x) => x.id === id);
  const [busy, setBusy] = useState(false);
  const [modal, setModal] = useState<'accept' | 'reschedule' | 'collect' | null>(null);
  if (!i) return null;
  const job = jobs.find((j) => j.id === i.jobId);
  const view = installView(i, job, receipts);
  const can = canDo('install.manage');
  const money = job ? jobMoney(job, receipts) : null;
  const custName = job ? jobCustName(job, customers) : customers.find((c) => c.id === i.customerId)?.name ?? 'Khách hàng';
  const patch = (p: Partial<InstallJob>) => setInstallJobs((all) => all.map((x) => (x.id === i.id ? { ...x, ...p } : x)));
  const a = i.acceptance;
  const prevPaid = money ? Math.max(0, money.collected - (a?.paidAmount ?? 0)) : 0;
  const print = () => printHtml(docShell(`Biên bản ${a?.docCode ?? i.code}`, acceptanceHtml(i, job, company, custName, userName(a?.by ?? i.leaderId), prevPaid)));
  const checkin = (files: File[]) => {
    setBusy(true);
    const finish = (lat: number, lng: number, simulated: boolean) => {
      const at = new Date();
      const lines = [`${me.name} ${pad2(at.getHours())}:${pad2(at.getMinutes())} ${pad2(at.getDate())}/${pad2(at.getMonth() + 1)}/${at.getFullYear()}`, `GPS ${lat.toFixed(5)}, ${lng.toFixed(5)}${simulated ? ' (mô phỏng)' : ''}`, i.code];
      Promise.all(files.map(async (f) => ({ name: f.name, url: await watermarkPhoto(f, lines) })))
        .then((photos) => { patch({ checkins: [...i.checkins, { at: at.toISOString(), lat, lng, simulated, photos }], status: i.status === 'SCHEDULED' ? 'IN_PROGRESS' : i.status }); notify(`Đã check-in công trình${photos.length ? `, ${photos.length} ảnh có watermark` : ''}`, 'teal'); })
        .catch((e) => notify(e instanceof Error ? e.message : 'Không xử lý được ảnh', 'red'))
        .finally(() => setBusy(false));
    };
    if (typeof navigator !== 'undefined' && navigator.geolocation) navigator.geolocation.getCurrentPosition((p) => finish(p.coords.latitude, p.coords.longitude, false), () => finish(10.79 + Math.random() * 0.02, 106.68 + Math.random() * 0.02, true), { timeout: 8000 });
    else finish(10.79, 106.68, true);
  };
  return (
    <Drawer title={custName} eyebrow={`${i.code}${job ? ` · ${job.code}` : ''}`} badge={<Chip tone={INSTALL_VIEW[view].tone}>{INSTALL_VIEW[view].label}</Chip>} onClose={onClose}
      actions={<>
        {i.status !== 'ACCEPTED' && can && <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} onClick={() => setModal('accept')}><ClipboardCheck className="h-3.5 w-3.5" aria-hidden />Nghiệm thu, bàn giao & thu tiền</button>}
        {i.status !== 'ACCEPTED' && can && <button className={cn(btnGhost, btnSm)} onClick={() => setModal('reschedule')}><CalendarDays className="h-3.5 w-3.5" aria-hidden />Đổi lịch</button>}
        {a && <button className={cn(btnPrimary, btnSm)} onClick={print}><Download className="h-3.5 w-3.5" aria-hidden />Biên bản PDF</button>}
        {a && money && money.remaining > 0 && (can || canDo('job.manage')) && <button className={cn(btnGhost, btnSm)} onClick={() => setModal('collect')}><Banknote className="h-3.5 w-3.5" aria-hidden />Thu tiền còn lại</button>}
        {job && <button className={cn(btnGhost, btnSm)} onClick={() => { onClose(); openJob(job.id); }}>Mở đơn</button>}
      </>}>
      <InfoGrid rows={[
        ['Khách hàng', custName],
        ['Số điện thoại', job ? jobPhone(job, customers) : ''],
        ['Địa chỉ', i.address, true],
        ['Thời gian lắp đặt', i.from ? `${fmtDT(i.from)} – ${fmtDT(i.to)}` : ''],
        ['Đội trưởng', userName(i.leaderId)],
        ['Thành viên', i.team.map((x) => users.find((u) => u.id === x)?.name).filter(Boolean).join(', ')],
        ['Hạng mục', job?.title ?? i.title],
        ['Ghi chú', i.note],
      ]} />
      {money && (
        <div className="grid grid-cols-3 gap-2">
          <MiniStat label="Giá trị hợp đồng" value={compact(money.value)} />
          <MiniStat label="Đã thu" value={compact(money.collected)} tone="teal" />
          <MiniStat label="Còn phải thu" value={compact(money.remaining)} tone={money.remaining ? 'red' : 'teal'} />
        </div>
      )}
      <section>
        <div className="mb-2 flex items-center justify-between gap-2">
          <h3 className="flex items-center gap-2 text-sm font-semibold"><MapPin className="h-4 w-4 text-[#F28C33]" aria-hidden />Check-in công trình ({i.checkins.length})</h3>
          {can && i.status !== 'ACCEPTED' && <FilePicker accept="image/*" multiple disabled={busy} onFiles={checkin} className={cn(btnGhost, btnSm, 'inline-flex')}><Camera className="h-3.5 w-3.5" aria-hidden />{busy ? 'Đang lấy vị trí...' : 'Check-in & chụp ảnh'}</FilePicker>}
        </div>
        {i.checkins.length ? (
          <ul className="space-y-2">
            {i.checkins.map((c, k) => (
              <li key={k} className="rounded bg-[#1C2534] p-2.5 text-xs">
                <p>{new Date(c.at).toLocaleString('vi-VN')}, GPS {c.lat.toFixed(5)}, {c.lng.toFixed(5)}{c.simulated ? ' (mô phỏng)' : ''}</p>
                {/* eslint-disable-next-line @next/next/no-img-element */}
                {c.photos.length > 0 && <div className="mt-2 grid grid-cols-4 gap-1.5">{c.photos.map((p) => <a key={p.url} href={p.url} target="_blank" rel="noreferrer"><img src={p.url} alt={p.name} className="aspect-square w-full rounded object-cover" /></a>)}</div>}
              </li>
            ))}
          </ul>
        ) : <p className="text-sm text-[#94A3B8]">Đến công trình, check-in để chuyển "Đang lắp đặt".</p>}
      </section>
      {a && (
        <section className="rounded-md border border-[#00B894]/40 bg-[#00B894]/5 p-4">
          <h3 className="text-sm font-semibold text-[#3DDBB6]">Biên bản {a.docCode}: {a.result === 'PASS' ? 'Đạt' : 'Đạt, có tồn tại'}</h3>
          <dl className="mt-2 grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
            <div><dt className="text-xs text-[#94A3B8]">Ký lúc</dt><dd>{new Date(a.signedAt ?? Date.parse(a.at)).toLocaleString('vi-VN')}</dd></div>
            <div><dt className="text-xs text-[#94A3B8]">Đại diện khách</dt><dd>{a.customerRep}{a.customerTitle ? `, ${a.customerTitle}` : ''}</dd></div>
            <div><dt className="text-xs text-[#94A3B8]">Thu khi bàn giao</dt><dd className="tabular-nums">{vnd(a.paidAmount ?? 0)}{a.paidMethod ? `, ${a.paidMethod === 'CASH' ? 'tiền mặt' : 'chuyển khoản'}` : ''}</dd></div>
            <div><dt className="text-xs text-[#94A3B8]">Bảo hành</dt><dd>{a.warrantyMonths ?? 0} tháng, đến {a.warrantyUntil ? fmtDate(a.warrantyUntil) : '—'}</dd></div>
          </dl>
          {a.note && <p className="mt-2 text-xs text-[#F7B23B]">Tồn tại: {a.note}</p>}
          {(a.customerSign || a.staffSign) && (
            <div className="mt-3 grid grid-cols-2 gap-3">
              {/* eslint-disable-next-line @next/next/no-img-element */}
              {[['Khách hàng', a.customerSign], ['Công ty', a.staffSign]].map(([k, v]) => <div key={k} className="rounded bg-white p-1.5"><p className="text-[10px] text-slate-500">{k}</p>{v && <img src={v} alt={`Chữ ký ${k}`} className="h-14 w-full object-contain" />}</div>)}
            </div>
          )}
          {a.hash && <p className="mt-2 break-all font-mono text-[10px] text-[#94A3B8]">Mã xác thực {a.hash.slice(0, 32).toUpperCase()}</p>}
        </section>
      )}
      {modal === 'accept' && <AcceptanceModal ij={i} onClose={() => setModal(null)} />}
      {modal === 'reschedule' && <InstallScheduleModal ij={i} onClose={() => setModal(null)} />}
      {modal === 'collect' && job && money && <ReceiptModal job={job} amount={money.remaining} stageId={job.schedule.find((s) => s.trigger === 'ACCEPT')?.id} title="Thu tiền còn lại" onClose={() => setModal(null)} />}
    </Drawer>
  );
}

type InstallRow = { key: string; view: InstallView; job?: Job; ij?: InstallJob; wo?: WorkOrder; time: string };
function InstallModule() {
  const { installJobs, workOrders, jobs, customers, receipts, canDo, userName } = useApp();
  const inR = useInRange();
  const [st, setSt] = useState<InstallView | 'ALL'>('ALL');
  const [q, setQ] = useState('');
  const [open, setOpen] = useState<string | null>(null);
  const [schedule, setSchedule] = useState<WorkOrder | null>(null);
  const t = q.trim().toLowerCase();
  const rows: InstallRow[] = [
    ...workOrders.filter((w) => w.stage === 'DONE' && w.jobId && !installJobs.some((i) => i.workOrderId === w.id)).map((w): InstallRow => ({ key: `w${w.id}`, view: 'WAIT' as InstallView, wo: w, job: jobs.find((j) => j.id === w.jobId), time: '' })),
    ...installJobs.map((i): InstallRow => { const job = jobs.find((j) => j.id === i.jobId); return { key: i.id, view: installView(i, job, receipts), ij: i, job, time: i.from }; }),
  ].filter((r) => r.view !== 'DONE' || inR(r.ij?.acceptance?.at ?? r.time));
  const count = (v: InstallView) => rows.filter((r) => r.view === v).length;
  const order: InstallView[] = ['WAIT', 'IN_PROGRESS', 'SCHEDULED', 'WAIT_PAYMENT', 'DONE'];
  const list = rows.filter((r) => (st === 'ALL' || r.view === st) && (!t || `${r.job ? jobCustName(r.job, customers) : ''} ${r.job ? jobPhone(r.job, customers) : ''} ${r.ij?.address ?? r.job?.siteAddress ?? ''}`.toLowerCase().includes(t)))
    .sort((a, b) => order.indexOf(a.view) - order.indexOf(b.view) || (a.view === 'DONE' ? b.time.localeCompare(a.time) : a.time.localeCompare(b.time)));
  const paged = usePaged(list, 20);
  const in7 = toLocal(new Date(Date.now() + 7 * 864e5));
  const nowL = toLocal(new Date());
  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Chờ hẹn lắp" value={String(count('WAIT'))} icon={CalendarDays} color={C.orange} sub="Xưởng đã hoàn thành" />
        <StatCard label="Lịch 7 ngày tới" value={String(installJobs.filter((i) => i.status === 'SCHEDULED' && i.from >= nowL.slice(0, 10) && i.from <= in7).length)} icon={HardHat} color={C.blue} sub={`${count('IN_PROGRESS')} đang lắp đặt`} />
        <StatCard label="Chờ thu tiền" value={String(count('WAIT_PAYMENT'))} icon={Banknote} color={C.red} sub={compact(rows.filter((r) => r.view === 'WAIT_PAYMENT' && r.job).reduce((s, r) => s + jobMoney(r.job!, receipts).receivable, 0))} />
        <StatCard label="Hoàn tất trong kỳ" value={String(count('DONE'))} icon={ShieldCheck} color={C.teal} sub="Đã thu đủ, đang bảo hành" />
      </div>
      <Panel>
        <div className="mb-3 flex flex-wrap items-center gap-2"><SearchBox value={q} onChange={setQ} placeholder="Tìm khách hàng, số điện thoại, địa chỉ" /><div className="ml-auto hidden lg:block"><DateRangePicker /></div></div>
        <StagePills items={[{ id: 'ALL' as InstallView | 'ALL', label: 'Tất cả', count: rows.length }, ...order.map((v) => ({ id: v as InstallView | 'ALL', label: INSTALL_VIEW[v].label, count: count(v) }))]} value={st} onChange={(v) => { setSt(v); paged.setPage(1); }} />
        <div className="mt-3 space-y-2 md:hidden">
          {paged.slice.map((r, i) => (
            <button key={r.key} className="w-full rounded bg-[#1C2534] p-3 text-left" onClick={() => (r.ij ? setOpen(r.ij.id) : r.wo && setSchedule(r.wo))}>
              <div className="flex items-start justify-between gap-2"><p className="text-sm font-medium">{(paged.page - 1) * 20 + i + 1}. {r.job ? jobCustName(r.job, customers) : '—'}</p><Chip tone={INSTALL_VIEW[r.view].tone}>{INSTALL_VIEW[r.view].label}</Chip></div>
              <p className="mt-0.5 text-xs text-[#94A3B8]">{r.job ? jobPhone(r.job, customers) : ''}, {r.ij?.address ?? r.job?.siteAddress}</p>
              <p className="mt-1 text-xs text-[#F7B23B]">{r.time ? fmtDT(r.time) : 'Bấm để hẹn lịch lắp'}</p>
            </button>
          ))}
        </div>
        <div className="mt-3 hidden md:block">
          <Table head={['STT', 'Khách hàng', 'Số điện thoại', 'Địa chỉ', 'Thời gian lắp đặt', 'Trạng thái']} minW={960}>
            {paged.slice.map((r, i) => (
              <tr key={r.key} className={cn(rowCls, 'cursor-pointer')} onClick={() => (r.ij ? setOpen(r.ij.id) : r.wo && canDo('install.manage') && setSchedule(r.wo))}>
                <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{(paged.page - 1) * 20 + i + 1}</td>
                <td className={tdCls}><p className="font-medium">{r.job ? jobCustName(r.job, customers) : customers.find((c) => c.id === r.ij?.customerId)?.name ?? '—'}</p><p className="text-xs text-[#94A3B8]">{r.ij ? `${r.ij.code}, ${userName(r.ij.leaderId)}` : r.wo?.code}</p></td>
                <td className={cn(tdCls, 'whitespace-nowrap tabular-nums')}>{r.job ? jobPhone(r.job, customers) : ''}</td>
                <td className={cn(tdCls, 'max-w-[280px]')}><p className="line-clamp-2 text-xs">{r.ij?.address ?? r.job?.siteAddress}</p></td>
                <td className={cn(tdCls, 'whitespace-nowrap text-xs tabular-nums', r.ij?.status === 'SCHEDULED' && r.time < nowL && 'text-[#F87171]')}>{r.time ? fmtDT(r.time) : '—'}</td>
                <td className={tdLast}>
                  {r.view === 'WAIT'
                    ? <button className={cn(btnPrimary, btnSm, 'whitespace-nowrap')} disabled={!canDo('install.manage')} onClick={(e) => { e.stopPropagation(); if (r.wo) setSchedule(r.wo); }}><CalendarDays className="h-3.5 w-3.5" aria-hidden />Lên lịch lắp đặt</button>
                    : <Chip tone={INSTALL_VIEW[r.view].tone}>{INSTALL_VIEW[r.view].label}</Chip>}
                </td>
              </tr>
            ))}
          </Table>
        </div>
        {!list.length && <EmptyState text={<>Không có lịch lắp đặt.</>} art="calendar" />}
        <Pagination paged={paged} unit="lịch" />
      </Panel>
      {open && <InstallDrawer id={open} onClose={() => setOpen(null)} />}
      {schedule && <InstallScheduleModal wo={schedule} onClose={() => setSchedule(null)} />}
    </div>
  );
}

// =====================================================================
//  MÔ HÌNH XƯỞNG (quy trình rút gọn)
//  Thêm lead = đơn "Đang chờ khảo sát" -> Tạo báo giá -> Nhận cọc (tự tạo lệnh sản xuất)
//  -> Sản xuất: chờ / đang / hoàn thành -> Hẹn lắp đặt -> Nghiệm thu, bàn giao, ký điện tử, thu tiền, bảo hành
//  Doanh số ghi nhận khi Kế toán xác nhận đã nhận tiền.
// =====================================================================

/** Bộ dữ liệu suy ra cho từng đơn: giai đoạn, trạng thái chi tiết, tiền, lệnh SX, lắp đặt */
function useJobInfo() {
  const { workOrders, installJobs, receipts } = useApp();
  return (j: Job) => {
    const stage = jobStageOf(j, workOrders, installJobs, receipts);
    return {
      stage, detail: jobDetailOf(j, stage, workOrders, installJobs, receipts), money: jobMoney(j, receipts),
      wo: workOrders.find((w) => w.jobId === j.id), installs: installJobs.filter((i) => i.jobId === j.id), due: dueByStage(j, stage),
    };
  };
}
/** Phạm vi xem đơn: BOD / Kế toán / MKT xem hết; Trưởng phòng xem phòng mình; nhân viên xem đơn mình phụ trách hoặc đội lắp */
function useJobScope() {
  const { me, role, installJobs } = useApp();
  return (j: Job) => role === 'BOD' || role === 'ACCOUNTANT' || role === 'MKT_LEAD' || role === 'DEPT_HEAD' || j.ownerId === me.id || j.createdBy === me.id
    || installJobs.some((i) => i.jobId === j.id && (i.leaderId === me.id || i.team.includes(me.id)));
}
const phoneKey = (p?: string) => (p ?? '').replace(/\D/g, '');
const jobCustName = (j: Job, customers: Customer[]) => j.siteContact || customers.find((c) => c.id === j.customerId)?.name || '—';
const jobPhone = (j: Job, customers: Customer[]) => j.sitePhone || customers.find((c) => c.id === j.customerId)?.contactPhone || '';
/** Kỹ thuật / người khảo sát được giao đơn */
const techUsers = (users: User[]) => users.filter((u) => u.active && (u.role === 'SALES_REP' || u.role === 'DEPT_HEAD') && u.dept !== 'ACCOUNTING');

/** Lệnh sản xuất tạo tự động khi nhận cọc: hạng mục, kích thước lấy từ báo giá khách chốt */
function buildWorkOrder(j: Job, q: JobQuote, custName: string, code: string, leaderId: string | undefined, by: string, days: number, note: string): WorkOrder {
  return {
    id: uid('wo'), code, title: `${j.title} (${custName})`, customerId: j.customerId, leadId: j.leadId, jobId: j.id, stage: 'WAITING', priority: 'NORMAL',
    startDate: todayISO(), dueDate: iso(new Date(Date.now() + days * 864e5)), leaderId,
    items: q.lines.map((l) => ({ id: uid('wi'), name: `${l.location ? `${l.location}: ` : ''}${l.name}`, spec: lineDims(l), unit: l.unit === 'MD' ? 'md' : l.unit === 'PCS' ? 'cái' : 'bộ', qty: l.unit === 'MD' ? Math.round(l.length * l.qty * 100) / 100 : l.qty, done: 0 })),
    materials: [], qc: [], note, history: [{ stage: 'WAITING', at: Date.now(), by, note: `Nhận cọc đơn ${j.code}` }], createdAt: todayISO(), createdBy: by,
  };
}

function newCustomerRec(p: { name: string; phone: string; address: string; segment: string; sourceId: string; ownerId?: string; dept?: string; note?: string }, existing: Customer[]): Customer {
  return {
    id: uid('k'), code: nextCode(existing.map((c) => c.code), 'KH-', 6), name: p.name.trim(), taxCode: '', segment: p.segment, tier: '', region: 'SOUTH', dept: p.dept ?? '', amId: p.ownerId,
    sourceId: p.sourceId, status: 'PROSPECT', createdAt: todayISO(), contactName: p.name.trim(), contactTitle: p.note ?? '', contactPhone: p.phone.trim(), contactEmail: '', address: p.address.trim(),
    creditLimit: 0, debt: 0, ytdRevenue: 0, lastYearRevenue: 0,
  };
}

// ---------------- Phiếu thu ----------------

function ReceiptModal({ job, amount, stageId, title, onClose, onSaved }: { job: Job; amount: number; stageId?: string; title: string; onClose: () => void; onSaved?: (r: Receipt) => void }) {
  const { me, receipts, setReceipts, notify, dispatch, users, audit, mfgConfig } = useApp();
  const [amt, setAmt] = useState(amount);
  const [method, setMethod] = useState<'CASH' | 'TRANSFER'>('CASH');
  const [note, setNote] = useState('');
  const [photo, setPhoto] = useState<string | undefined>();
  const [busy, setBusy] = useState(false);
  const save = () => {
    if (amt <= 0) return notify('Nhập số tiền thu', 'red');
    if (method === 'TRANSFER' && !photo) return notify('Chuyển khoản: chụp màn hình giao dịch để kế toán đối chiếu', 'red');
    const r: Receipt = {
      id: uid('rc'), code: nextCode(receipts.map((x) => x.code), `PT-${new Date().getFullYear()}-`, 4), jobId: job.id, stageId, amount: amt, method,
      collectedBy: me.id, collectedAt: Date.now(), photo, note: note.trim() || undefined,
      status: method === 'CASH' ? 'HOLDING' : 'SUBMITTED', submittedAt: method === 'CASH' ? undefined : Date.now(),
    };
    setReceipts((p) => [r, ...p]);
    audit('RECEIPT_CREATE', `${r.code}: thu ${vnd(amt)} ${method === 'CASH' ? 'tiền mặt' : 'chuyển khoản'} đơn ${job.code}`);
    const acc = users.filter((u) => u.active && u.role === 'ACCOUNTANT');
    if (method === 'TRANSFER') acc.forEach((u) => dispatch('APPROVAL_RESULT', { to: u, title: `Chờ xác nhận ${r.code}: ${vnd(amt)}`, body: `Chuyển khoản đơn ${job.code} ${job.title}`, module: 'tasks' }));
    notify(method === 'CASH' ? `Đã lập ${r.code}. Nộp ${vnd(amt)} tiền mặt về kế toán trong ${mfgConfig.submitHours} giờ.` : `Đã lập ${r.code}, chờ kế toán đối chiếu sao kê.`, 'teal');
    onSaved?.(r);
    onClose();
  };
  return (
    <Modal title={title} onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} disabled={busy} onClick={save}><Banknote className="h-4 w-4" aria-hidden />Lập phiếu thu</button></>}>
      <p className="mb-3 text-sm text-[#94A3B8]">{job.code}: {job.title}</p>
      <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <Field label="Số tiền thu"><MoneyInput value={amt} onChange={setAmt} /></Field>
        <Field label="Hình thức">
          <div className="flex rounded bg-[#0F141E] p-0.5" role="radiogroup" aria-label="Hình thức">
            {(['CASH', 'TRANSFER'] as const).map((m) => <button key={m} type="button" role="radio" aria-checked={method === m} onClick={() => setMethod(m)} className={cn('flex-1 rounded-md px-3 py-2 text-sm font-medium', method === m ? 'g-brand font-semibold text-[#0F141E]' : 'text-[#94A3B8]')}>{m === 'CASH' ? 'Tiền mặt' : 'Chuyển khoản'}</button>)}
          </div>
        </Field>
        <Field label="Ghi chú" className="sm:col-span-2"><input className={inputCls} value={note} onChange={(e) => setNote(e.target.value)} placeholder="VD: Khách chuyển khoản Vietcombank, nội dung ALUX DH-0012" /></Field>
      </div>
      <div className="mt-3 flex flex-wrap items-center gap-3">
        <FilePicker accept="image/*" disabled={busy} onFiles={(f) => { setBusy(true); compressImage(f[0], 1000).then(setPhoto).catch(() => notify('Không đọc được ảnh', 'red')).finally(() => setBusy(false)); }} className={cn(btnGhost, btnSm, 'inline-flex')}><Upload className="h-3.5 w-3.5" aria-hidden />{photo ? 'Đổi ảnh' : method === 'TRANSFER' ? 'Ảnh chuyển khoản *' : 'Ảnh phiếu thu / tiền (tùy chọn)'}</FilePicker>
        {/* eslint-disable-next-line @next/next/no-img-element */}
        {photo && <img src={photo} alt="Chứng từ" className="h-16 rounded-md object-cover" />}
      </div>
      <p className="mt-3 text-xs text-[#94A3B8]">{method === 'CASH' ? `Tiền mặt ghi "nhân viên đang giữ" đến khi nộp về kế toán (hạn ${mfgConfig.submitHours} giờ).` : 'Chuyển khoản chờ kế toán đối chiếu sao kê.'} Doanh số chỉ ghi nhận khi kế toán xác nhận.</p>
    </Modal>
  );
}

/** Thao tác trên phiếu thu: người thu nộp tiền, kế toán xác nhận / từ chối */
function ReceiptActions({ r, job }: { r: Receipt; job?: Job }) {
  const { me, canDo, setReceipts, notify, logDecision, users, dispatch, audit, postCash, customers } = useApp();
  const patch = (p: Partial<Receipt>) => setReceipts((all) => all.map((x) => (x.id === r.id ? { ...x, ...p } : x)));
  const title = `${r.code}: ${vnd(r.amount)}${job ? `, ${job.code}` : ''}`;
  const confirm = () => {
    patch({ status: 'CONFIRMED', confirmedBy: me.id, confirmedAt: Date.now(), submittedAt: r.submittedAt ?? Date.now() });
    postCash(receiptCash(r, job, customers));
    logDecision({ kind: 'RECEIPT', refId: r.id, title, requesterId: r.collectedBy, decision: 'APPROVED', amount: r.amount });
    notify(`Đã xác nhận ${r.code}, ghi nhận doanh số ${vnd(r.amount)}`, 'teal');
  };
  const reject = () => {
    const n = window.prompt('Lý do từ chối (sai số tiền, chưa thấy tiền về...)');
    if (!n || n.trim().length < 3) return;
    patch({ status: 'REJECTED', rejectNote: n.trim() });
    logDecision({ kind: 'RECEIPT', refId: r.id, title, requesterId: r.collectedBy, decision: 'REJECTED', note: n.trim(), amount: r.amount });
    const u = users.find((x) => x.id === r.collectedBy);
    if (u) dispatch('APPROVAL_RESULT', { to: u, title: `Kế toán từ chối ${r.code}`, body: n.trim(), module: 'jobs' });
  };
  return (
    <span className="flex flex-wrap gap-1.5">
      {r.status === 'HOLDING' && (r.collectedBy === me.id || canDo('receipt.confirm')) && (
        <button className={cn(btnGhost, btnSm)} onClick={() => { patch({ status: 'SUBMITTED', submittedAt: Date.now() }); audit('CASH_SUBMIT', `${r.code}: nộp ${vnd(r.amount)} về kế toán`); notify(`Đã ghi nhận nộp ${vnd(r.amount)}, chờ kế toán xác nhận`, 'teal'); }}>Đã nộp kế toán</button>
      )}
      {(r.status === 'SUBMITTED' || r.status === 'HOLDING') && canDo('receipt.confirm') && r.collectedBy !== me.id && (
        <>
          <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E]')} onClick={confirm}>Xác nhận đã nhận</button>
          <button className={cn(btnBase, btnSm, 'bg-[#EF4444]/15 text-[#F87171]')} onClick={reject}>Từ chối</button>
        </>
      )}
    </span>
  );
}

function ReceiptList({ job }: { job: Job }) {
  const { receipts, userName, now, mfgConfig } = useApp();
  const list = receipts.filter((r) => r.jobId === job.id).sort((a, b) => b.collectedAt - a.collectedAt);
  if (!list.length) return <p className="text-sm text-[#94A3B8]">Chưa có phiếu thu.</p>;
  return (
    <ul className="space-y-2">
      {list.map((r) => {
        const late = holdingOverdue(r, now ?? Date.now(), mfgConfig.submitHours);
        return (
          <li key={r.id} className={cn('rounded border bg-[#1C2534] p-3 text-sm', late ? 'border-[#EF4444]/60' : 'border-transparent')}>
            <div className="flex flex-wrap items-center gap-2">
              <b className="tabular-nums">{vnd(r.amount)}</b>
              <span className="text-xs text-[#94A3B8]">{r.code}, {r.method === 'CASH' ? 'tiền mặt' : 'chuyển khoản'}, {userName(r.collectedBy)} thu {new Date(r.collectedAt).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' })}</span>
              <span className="ml-auto"><Chip tone={late ? 'red' : RECEIPT_STATUS[r.status].tone}>{late ? 'Quá hạn nộp' : RECEIPT_STATUS[r.status].label}</Chip></span>
            </div>
            {r.note && <p className="mt-1 text-xs text-[#94A3B8]">{r.note}</p>}
            {r.rejectNote && <p className="mt-1 text-xs text-[#F87171]">Từ chối: {r.rejectNote}</p>}
            {r.status === 'CONFIRMED' && <p className="mt-1 text-xs text-[#3DDBB6]">Kế toán {userName(r.confirmedBy)} xác nhận {r.confirmedAt ? new Date(r.confirmedAt).toLocaleString('vi-VN') : ''}</p>}
            <div className="mt-2 flex flex-wrap items-center gap-2">
              {/* eslint-disable-next-line @next/next/no-img-element */}
              {r.photo && <a href={r.photo} target="_blank" rel="noreferrer"><img src={r.photo} alt="Chứng từ" className="h-10 rounded object-cover" /></a>}
              <ReceiptActions r={r} job={job} />
            </div>
          </li>
        );
      })}
    </ul>
  );
}

// ---------------- Tạo đơn hàng ----------------

// ---------------- Báo giá in (PDF) ----------------

function jobQuoteHtml(job: Job, q: JobQuote, company: CompanyInfo, cust: Customer | undefined, owner: User | undefined, cfg: MfgConfig) {
  const rows = q.lines.map((l, i) => `<tr><td class="c">${i + 1}</td><td><b>${esc(l.name)}</b>${l.location ? `<br><span class="small">${esc(l.location)}</span>` : ''}</td><td class="c">${esc(lineDims(l))}</td><td class="r">${l.qty}</td><td class="r">${lineMeasure(l).toLocaleString('vi-VN')} ${PRICE_UNIT[l.unit].short}</td><td class="r">${Math.round(l.unitPrice * (1 - l.discountPct / 100)).toLocaleString('vi-VN')}</td><td class="r">${lineAmount(l).toLocaleString('vi-VN')}</td></tr>`).join('');
  const pay = job.schedule.map((s) => `<li>${esc(s.label)}: ${s.pct}% (${Math.round((q.total * s.pct) / 100).toLocaleString('vi-VN')} đ), ${PAY_TRIGGER[s.trigger].toLowerCase()}</li>`).join('');
  const valid = new Date(Date.parse(q.at) + cfg.quoteValidDays * 864e5);
  return `<table class="layout"><tr><td><b>${esc(company.legalName)}</b><br>${esc(company.address)}<br>ĐT: ${esc(company.phone)}</td><td class="r">Số: <b>${esc(job.code)}-BG${q.version}</b><br>Ngày: ${fmtDate(q.at.slice(0, 10))}</td></tr></table>
<h1>BÁO GIÁ THI CÔNG</h1>
<p>Kính gửi: <b>${esc(cust?.name ?? job.siteContact ?? '')}</b>, ĐT ${esc(job.sitePhone ?? cust?.contactPhone ?? '')}<br>Công trình: ${esc(job.title)}<br>Địa chỉ: ${esc(job.siteAddress)}</p>
<table class="items"><thead><tr><th>STT</th><th>Hạng mục</th><th>Kích thước</th><th>SL</th><th>Khối lượng</th><th>Đơn giá (đ)</th><th>Thành tiền (đ)</th></tr></thead><tbody>${rows}
<tr><td colspan="6" class="r">Cộng</td><td class="r">${q.subtotal.toLocaleString('vi-VN')}</td></tr>
${q.vatPct ? `<tr><td colspan="6" class="r">VAT ${q.vatPct}%</td><td class="r">${(q.total - q.subtotal).toLocaleString('vi-VN')}</td></tr>` : ''}
<tr><td colspan="6" class="r"><b>Tổng cộng${q.vatPct ? '' : ' (chưa gồm VAT)'}</b></td><td class="r"><b>${q.total.toLocaleString('vi-VN')}</b></td></tr></tbody></table>
<p><b>Bằng chữ:</b> <i>${moneyToWordsVN(q.total)}</i></p>
<h3>Thanh toán</h3><ul>${pay}</ul>
<p>Bảo hành ${job.warrantyMonths} tháng. Khối lượng m² tính theo kích thước thực tế, tối thiểu theo quy định từng hạng mục. Báo giá có hiệu lực đến ${valid.toLocaleDateString('vi-VN')}.</p>
${q.note ? `<p>Ghi chú: ${esc(q.note)}</p>` : ''}
<table class="layout sign"><tr><td><b>KHÁCH HÀNG XÁC NHẬN</b><br><br><br><br></td><td><b>NGƯỜI LẬP BÁO GIÁ</b><br><br><br><br><b>${esc(owner?.name ?? '')}</b><br>${esc(owner?.phone ?? '')}</td></tr></table>`;
}

/** Ô thông tin dạng nhãn trên / giá trị dưới, dùng chung trong ngăn chi tiết */
function InfoGrid({ rows }: { rows: [string, ReactNode, boolean?][] }) {
  return (
    <dl className="grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
      {rows.map(([k, v, wide]) => (
        <div key={k} className={cn('min-w-0', wide && 'sm:col-span-2')}>
          <dt className="text-xs text-[#94A3B8]">{k}</dt>
          <dd className="mt-0.5 break-words text-[#F1F5F9]">{v || '—'}</dd>
        </div>
      ))}
    </dl>
  );
}
/** Ô số liệu nhỏ (giá trị HĐ, đã thu...) */
function MiniStat({ label, value, tone }: { label: string; value: string; tone?: 'teal' | 'orange' | 'red' }) {
  return (
    <div className="rounded bg-[#1C2534] p-2.5">
      <p className="text-[11px] text-[#94A3B8]">{label}</p>
      <p className={cn('mt-0.5 font-semibold tabular-nums', tone === 'teal' && 'text-[#3DDBB6]', tone === 'orange' && 'text-[#F7B23B]', tone === 'red' && 'text-[#F87171]')}>{value}</p>
    </div>
  );
}
/** Thanh chọn trạng thái dạng viên, có số đếm */
function StagePills<T extends string>({ items, value, onChange }: { items: { id: T; label: string; count?: number }[]; value: T; onChange: (v: T) => void }) {
  return (
    <div className="flex gap-1.5 overflow-x-auto pb-1 [scrollbar-width:none]" role="tablist">
      {items.map((s) => (
        <button key={s.id} role="tab" aria-selected={value === s.id} onClick={() => onChange(s.id)}
          className={cn('flex shrink-0 items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium', value === s.id ? 'border-[#F28C33] bg-[#F28C33]/15 text-[#F7B23B]' : 'border-[#263044] text-[#94A3B8] hover:text-[#F1F5F9]')}>
          {s.label}{s.count !== undefined && <span className="tabular-nums opacity-80">{s.count}</span>}
        </button>
      ))}
    </div>
  );
}
/** Ô tìm kiếm dùng chung */
function SearchBox({ value, onChange, placeholder }: { value: string; onChange: (v: string) => void; placeholder: string }) {
  return (
    <div className="relative min-w-[200px] flex-1">
      <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#94A3B8]" aria-hidden />
      <input className={cn(inputCls, 'pl-9')} value={value} onChange={(e) => onChange(e.target.value)} placeholder={placeholder} aria-label={placeholder} />
    </div>
  );
}

// ---------------- Thêm lead (bước 1) = tạo đơn chờ khảo sát ----------------

function MfgLeadForm({ job, onClose }: { job?: Job; onClose: () => void }) {
  const { me, customers, setCustomers, jobs, setJobs, users, segments, sources, mfgConfig, notify, openJob, audit, dispatch } = useApp();
  const cust0 = customers.find((c) => c.id === job?.customerId);
  const techs = techUsers(users);
  const defAt = (() => { const d = new Date(Date.now() + 864e5); d.setHours(9, 0, 0, 0); return toLocal(d); })();
  const [f, setF] = useState({
    name: job?.siteContact ?? cust0?.name ?? '', phone: job?.sitePhone ?? cust0?.contactPhone ?? '', address: job?.siteAddress ?? '', title: job?.title ?? '',
    appointmentAt: job?.appointmentAt ?? defAt, ownerId: job?.ownerId ?? (techs.some((u) => u.id === me.id) ? me.id : techs[0]?.id ?? ''),
    sourceId: cust0?.sourceId ?? sources[0]?.id ?? '', segment: cust0?.segment ?? segments[0]?.code ?? 'OTHER', note: job?.note ?? '',
  });
  const [touched, setTouched] = useState(false);
  const set = (p: Partial<typeof f>) => setF((x) => ({ ...x, ...p }));
  const match = !job && phoneKey(f.phone).length >= 9 ? customers.find((c) => phoneKey(c.contactPhone) === phoneKey(f.phone)) : undefined;
  const matchJobs = match ? jobs.filter((j) => j.customerId === match.id).length : 0;
  const errs: Record<string, string> = {};
  if (f.name.trim().length < 2) errs.name = 'Nhập tên khách hàng';
  if (phoneKey(f.phone).length < 9) errs.phone = 'Số điện thoại chưa đúng';
  if (f.address.trim().length < 5) errs.address = 'Nhập địa chỉ công trình';
  if (f.title.trim().length < 3) errs.title = 'Nhập hạng mục cần làm';
  if (!f.appointmentAt) errs.appointmentAt = 'Chọn ngày giờ hẹn khảo sát';
  const err = (k: string) => (touched ? errs[k] : undefined);
  const save = () => {
    setTouched(true);
    if (Object.keys(errs).length) return;
    const owner = users.find((u) => u.id === f.ownerId);
    if (job) {
      setJobs((all) => all.map((x) => (x.id === job.id ? { ...x, siteContact: f.name.trim(), sitePhone: f.phone.trim(), siteAddress: f.address.trim(), title: f.title.trim(), appointmentAt: f.appointmentAt, ownerId: f.ownerId, dept: owner?.dept ?? x.dept, note: f.note.trim() } : x)));
      setCustomers((all) => all.map((c) => (c.id === job.customerId ? { ...c, sourceId: f.sourceId, segment: f.segment } : c)));
      notify('Đã cập nhật thông tin đơn', 'teal');
      onClose();
      return;
    }
    let c = match;
    if (!c) {
      c = { ...newCustomerRec({ name: f.name, phone: f.phone, address: f.address, segment: f.segment, sourceId: f.sourceId, ownerId: f.ownerId, dept: owner?.dept }, customers), contactTitle: '' };
      const nc = c;
      setCustomers((p) => [...p, nc]);
    }
    const id = uid('jb');
    const nj: Job = {
      id, code: nextCode(jobs.map((j) => j.code), `DH-${new Date().getFullYear()}-`, 4), title: f.title.trim(), customerId: c.id, ownerId: f.ownerId, dept: owner?.dept,
      siteAddress: f.address.trim(), siteContact: f.name.trim(), sitePhone: f.phone.trim(), appointmentAt: f.appointmentAt,
      draft: [], vatPct: mfgConfig.vatPct, quotes: [], files: [], surveyCheckins: [], schedule: mfgConfig.schedule.map((x) => ({ ...x })),
      warrantyMonths: mfgConfig.warrantyMonths, note: f.note.trim(), createdAt: todayISO(), createdBy: me.id, care: [],
    };
    setJobs((p) => [nj, ...p]);
    if (owner && owner.id !== me.id) dispatch('APPROVAL_RESULT', { to: owner, title: `Lịch khảo sát mới: ${f.name.trim()}`, body: `${fmtDT(f.appointmentAt)}, ${f.address.trim()}. Hạng mục: ${f.title.trim()}`, module: 'jobs' });
    audit('LEAD_CREATE', `Lead ${f.name.trim()} ${f.phone.trim()} -> ${nj.code} chờ khảo sát`);
    notify(`Đã thêm lead, chuyển "Đang chờ khảo sát" (${nj.code}), giao ${owner?.name ?? 'kỹ thuật'}`, 'teal');
    onClose();
    openJob(id);
  };
  return (
    <Modal title={job ? `Sửa thông tin ${job.code}` : 'Thêm lead'} onClose={onClose} wide
      footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>{job ? 'Lưu' : 'Thêm lead, chuyển khảo sát'}</button></>}>
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <Field label="Tên khách hàng *" error={err('name')}><input className={inputCls} value={f.name} onChange={(e) => set({ name: e.target.value })} placeholder="VD: Anh Nguyễn Văn A" autoFocus /></Field>
        <Field label="Số điện thoại *" error={err('phone')} hint={match ? `Khách cũ: ${match.name}, ${matchJobs} đơn trước. Đơn mới gắn vào khách này.` : undefined}>
          <input className={inputCls} inputMode="tel" value={f.phone} onChange={(e) => set({ phone: e.target.value })} placeholder="09xx xxx xxx" />
        </Field>
        <Field label="Địa chỉ công trình *" error={err('address')} className="sm:col-span-2"><input className={inputCls} value={f.address} onChange={(e) => set({ address: e.target.value })} placeholder="Số nhà, đường, phường, quận" /></Field>
        <Field label="Hạng mục *" error={err('title')} className="sm:col-span-2"><input className={inputCls} value={f.title} onChange={(e) => set({ title: e.target.value })} placeholder="VD: Cửa nhôm Xingfa, lan can kính, tủ bếp" /></Field>
        <Field label="Thời gian hẹn khảo sát *" error={err('appointmentAt')}><input className={inputCls} type="datetime-local" value={f.appointmentAt} onChange={(e) => set({ appointmentAt: e.target.value })} /></Field>
        <Field label="Kỹ thuật khảo sát">
          <select className={inputCls} value={f.ownerId} onChange={(e) => set({ ownerId: e.target.value })}>{techs.map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}</select>
        </Field>
        <Field label="Nguồn khách">
          <select className={inputCls} value={f.sourceId} onChange={(e) => set({ sourceId: e.target.value })}>{sources.map((s) => <option key={s.id} value={s.id}>{s.name}</option>)}</select>
        </Field>
        <Field label="Loại khách">
          <select className={inputCls} value={f.segment} onChange={(e) => set({ segment: e.target.value })}>{segments.map((s) => <option key={s.code} value={s.code}>{s.name}</option>)}</select>
        </Field>
        <Field label="Ghi chú" className="sm:col-span-2"><input className={inputCls} value={f.note} onChange={(e) => set({ note: e.target.value })} placeholder="Người giới thiệu, yêu cầu riêng của khách..." /></Field>
      </div>
      {!job && <p className="mt-4 rounded bg-[#1C2534] px-3 py-2 text-xs text-[#94A3B8]">Lưu xong, lead vào ngay Đơn hàng công trình với trạng thái "Đang chờ khảo sát" và báo cho kỹ thuật được giao.</p>}
    </Modal>
  );
}

// ---------------- Chăm sóc: báo giá chưa chốt / trượt ----------------

function CareModal({ job, onClose }: { job: Job; onClose: () => void }) {
  const { me, setJobs, userName, notify, customers } = useApp();
  const [note, setNote] = useState('');
  const [nextAt, setNextAt] = useState(iso(new Date(Date.now() + 3 * 864e5)));
  const logs = [...(job.care ?? [])].sort((a, b) => b.at - a.at);
  const save = () => {
    if (note.trim().length < 3) return notify('Nhập nội dung chăm sóc', 'red');
    const c: JobCare = { id: uid('cr'), at: Date.now(), by: me.id, note: note.trim(), nextAt: nextAt || undefined };
    setJobs((all) => all.map((x) => (x.id === job.id ? { ...x, care: [...(x.care ?? []), c] } : x)));
    notify('Đã ghi nhận chăm sóc', 'teal');
    onClose();
  };
  return (
    <Modal title={`Chăm sóc: ${jobCustName(job, customers)}`} onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Đóng</button><button className={btnPrimary} onClick={save}>Lưu chăm sóc</button></>}>
      <div className="space-y-3">
        <Field label="Nội dung trao đổi *"><textarea className={cn(inputCls, 'min-h-20')} value={note} onChange={(e) => setNote(e.target.value)} placeholder="VD: Khách đang so giá, hẹn gửi thêm mẫu màu nhôm vân gỗ" /></Field>
        <Field label="Hẹn chăm sóc tiếp"><input className={inputCls} type="date" value={nextAt} onChange={(e) => setNextAt(e.target.value)} /></Field>
        {logs.length > 0 && (
          <ul className="space-y-1.5 border-t border-[#263044] pt-3">
            {logs.map((c) => <li key={c.id} className="rounded bg-[#1C2534] px-3 py-2 text-sm"><p>{c.note}</p><p className="mt-0.5 text-xs text-[#94A3B8]">{userName(c.by)}, {new Date(c.at).toLocaleString('vi-VN')}{c.nextAt ? `, hẹn lại ${fmtDate(c.nextAt)}` : ''}</p></li>)}
          </ul>
        )}
      </div>
    </Modal>
  );
}

// ---------------- Khảo sát & tạo báo giá ----------------

/** Báo giá xưởng dạng Split-View: trái 38% đo đạc / hạng mục (bàn phím Tab, Enter), phải 62% bản A4 xem trước trực tiếp */
function QuoteEditorModal({ job, onClose, onWin }: { job: Job; onClose: () => void; onWin?: () => void }) {
  const { me, setJobs, priceItems, canDo, notify, audit, company, customers, users, mfgConfig, dispatch } = useApp();
  const last = job.quotes[job.quotes.length - 1];
  const [lines, setLines] = useState<JobLine[]>(job.draft.length ? job.draft : last ? last.lines.map((l) => ({ ...l, id: uid('jl') })) : []);
  const [vatPct, setVatPct] = useState(job.draft.length || !last ? job.vatPct : last.vatPct);
  const [note, setNote] = useState(job.draft.length || !last ? '' : last.note ?? '');
  const [busy, setBusy] = useState(false);
  /** Bản đã lưu trong phiên này + chữ ký nội dung: không đổi gì thì xuất / chốt dùng lại, không sinh phiên bản trùng */
  const [saved, setSaved] = useState<{ q: JobQuote; nj: Job; sig: string } | null>(null);
  const grid = useGridKeys();
  const t = quoteTotalsOf(lines, vatPct, priceItems);
  const canSeeCost = canDo('price.viewCost');
  const gm = t.subtotal ? ((t.subtotal - t.cost) / t.subtotal) * 100 : null;
  const sig = JSON.stringify([lines.map(({ id: _id, ...x }) => x), vatPct, note.trim()]);
  const current = saved && saved.sig === sig ? saved : null;
  const nextV = (last?.version ?? 0) + 1;
  const cust = customers.find((c) => c.id === job.customerId);
  const owner = users.find((u) => u.id === job.ownerId);
  const patch = (p: Partial<Job>) => setJobs((all) => all.map((x) => (x.id === job.id ? { ...x, ...p } : x)));
  const setLine = (i: number, p: Partial<JobLine>) => setLines((ls) => ls.map((l, k) => (k === i ? { ...l, ...p } : l)));
  const addLine = (pi?: PriceItem) => {
    setLines((ls) => [...ls, { id: uid('jl'), priceItemId: pi?.id, name: pi?.name ?? '', location: '', unit: pi?.unit ?? 'M2', width: 0, height: 0, length: 0, qty: 1, unitPrice: pi?.price ?? 0, unitCost: pi?.cost ?? 0, discountPct: 0 }]);
    grid.focusCell(lines.length, pi ? 1 : 0);
  };
  const close = () => { if (!current) patch({ draft: lines, vatPct }); onClose(); };
  const checkin = () => {
    setBusy(true);
    const done = (lat: number, lng: number, simulated: boolean) => { patch({ surveyCheckins: [...job.surveyCheckins, { at: new Date().toISOString(), lat, lng, simulated, by: me.id }] }); notify('Đã check-in khảo sát tại công trình', 'teal'); setBusy(false); };
    if (typeof navigator !== 'undefined' && navigator.geolocation) navigator.geolocation.getCurrentPosition((p) => done(p.coords.latitude, p.coords.longitude, false), () => done(10.79 + Math.random() * 0.02, 106.7 + Math.random() * 0.02, true), { timeout: 8000 });
    else done(10.79, 106.7, true);
  };
  const addFiles = async (files: File[], kind: JobFile['kind']) => {
    setBusy(true);
    try {
      const out: JobFile[] = [];
      for (const f of files) out.push({ id: uid('jf'), name: f.name, url: f.type.startsWith('image/') ? await compressImage(f, 1600) : URL.createObjectURL(f), kind, at: new Date().toISOString(), by: me.id });
      patch({ files: [...job.files, ...out] });
      notify(`Đã thêm ${out.length} ${kind === 'DRAWING' ? 'bản vẽ' : 'ảnh'}`, 'teal');
    } catch { notify('Không đọc được file', 'red'); } finally { setBusy(false); }
  };
  const bad = lines.find((l) => !l.name.trim() || l.qty <= 0 || l.unitPrice <= 0 || (l.unit === 'M2' && (l.width <= 0 || l.height <= 0)) || (l.unit === 'MD' && l.length <= 0));
  const err = !lines.length ? 'Thêm ít nhất một hạng mục' : bad ? `Dòng "${bad.name || 'chưa đặt tên'}": thiếu kích thước, số lượng hoặc đơn giá` : '';
  /** Lưu phiên bản mới (chỉ khi nội dung đổi so với bản vừa lưu) */
  const persist = (): { q: JobQuote; nj: Job } | null => {
    if (current) return current;
    if (err) { notify(err, 'red'); return null; }
    const q: JobQuote = { id: uid('jq'), version: nextV, at: new Date().toISOString(), by: me.id, lines: lines.map((l) => ({ ...l })), subtotal: t.subtotal, vatPct, total: t.total, cost: t.cost, note: note.trim() || undefined };
    const nj = { ...job, quotes: [...job.quotes, q], draft: [], vatPct };
    patch({ quotes: nj.quotes, draft: [], vatPct });
    audit('JOB_QUOTE', `${job.code} báo giá v${nextV}: ${vnd(t.total)}`);
    setSaved({ q, nj, sig });
    return { q, nj };
  };
  const exportAs = (format: 'PDF' | 'WORD') => {
    const r = persist();
    if (!r) return;
    const title = `Báo giá ${job.code} v${r.q.version}`;
    const body = jobQuoteHtml(r.nj, r.q, company, cust, owner, mfgConfig);
    if (format === 'PDF') printHtml(docShell(title, body)); else downloadWord(`${job.code}-BG${r.q.version}`, title, body);
    notify(`${format === 'PDF' ? 'Đã mở hộp thoại in PDF' : 'Đã tải file Word'}: báo giá v${r.q.version}`, 'teal');
  };
  const lowMargin = gm !== null && gm < 25;
  const submit = () => {
    const r = persist();
    if (!r) return;
    if (lowMargin) {
      const to = users.filter((u) => u.active && (u.role === 'BOD' || (u.role === 'DEPT_HEAD' && u.dept === owner?.dept)));
      dispatch('QUOTE_APPROVAL', { toAll: to, module: 'jobs', title: `Báo giá cần xem lại giá: ${jobCustName(job, customers)}`, body: `${job.code} v${r.q.version}, ${vnd(r.q.total)}, lãi gộp dự toán ${gm!.toFixed(1)}% (dưới 25%)` });
      notify(`Đã lưu báo giá v${r.q.version} và gửi Giám đốc xem lại (lãi gộp ${gm!.toFixed(1)}%)`, 'orange');
    } else notify(`Đã lưu báo giá v${r.q.version}: ${vnd(r.q.total)}. Đơn chuyển "Đã báo giá".`, 'teal');
    onClose();
  };
  const win = () => { if (!persist()) return; onClose(); onWin?.(); };
  const cats = Array.from(new Set(priceItems.filter((p) => p.active).map((p) => p.category)));
  const previewQ: JobQuote = current?.q ?? { id: 'preview', version: nextV, at: new Date().toISOString(), by: me.id, lines, subtotal: t.subtotal, vatPct, total: t.total, cost: t.cost, note: note.trim() || undefined };
  const html = jobQuoteHtml({ ...job, vatPct }, previewQ, company, cust, owner, mfgConfig);
  const cell = 'w-full rounded-md border border-transparent bg-[#0F141E] px-1.5 py-1 text-xs tabular-nums text-[#F1F5F9] [appearance:textfield] focus:border-[#F28C33] focus:outline-none [&::-webkit-inner-spin-button]:appearance-none';
  const num = cn(cell, 'text-right');

  const left = (
    <>
      <section className="rounded-md border border-[#263044] bg-[#151C29] p-3">
        <p className="truncate text-sm"><b>{jobCustName(job, customers)}</b> <span className="text-[#94A3B8]">{job.siteAddress}</span></p>
        <div className="mt-2 flex flex-wrap items-center gap-2">
          <button className={cn(btnGhost, btnSm)} disabled={busy} onClick={checkin}><MapPin className="h-3.5 w-3.5" aria-hidden />Check-in</button>
          <FilePicker accept="image/*" multiple disabled={busy} onFiles={(f) => void addFiles(f, 'PHOTO')} className={cn(btnGhost, btnSm, 'inline-flex')}><Camera className="h-3.5 w-3.5" aria-hidden />Ảnh hiện trạng</FilePicker>
          <FilePicker accept="image/*,.pdf,.dwg" multiple disabled={busy} onFiles={(f) => void addFiles(f, 'DRAWING')} className={cn(btnGhost, btnSm, 'inline-flex')}><Ruler className="h-3.5 w-3.5" aria-hidden />Bản vẽ</FilePicker>
          <span className="ml-auto text-[11px] text-[#94A3B8]">{job.surveyCheckins.length} check-in, {job.files.filter((x) => x.kind === 'PHOTO').length} ảnh, {job.files.filter((x) => x.kind === 'DRAWING').length} bản vẽ</span>
        </div>
      </section>

      <section>
        {secHead(1, `Hạng mục đo đạc (${lines.length})`)}
        <div ref={grid.ref} onKeyDown={grid.onKeyDown} className="rounded-md border border-[#263044]">
          <table className="w-full table-fixed text-xs">
            <colgroup><col className="w-6" /><col /><col className="w-[104px]" /><col className="w-11" /><col className="w-11" /><col className="w-[86px]" /><col className="w-6" /></colgroup>
            <thead className="bg-[#1C2534] text-[11px] text-[#94A3B8]">
              <tr><th className="rounded-tl-xl py-1.5" /><th className="px-1 text-left font-medium">Hạng mục / vị trí</th><th className="px-1 text-right font-medium">Rộng × cao / dài</th><th className="px-1 text-right font-medium">SL</th><th className="px-1 text-right font-medium">CK%</th><th className="px-2 text-right font-medium">Thành tiền</th><th className="rounded-tr-xl" /></tr>
            </thead>
            <tbody>
              {lines.map((l, i) => {
                const pi = priceItems.find((p) => p.id === l.priceItemId);
                const small = !!pi?.minMeasure && l.unit === 'M2' && l.width > 0 && (l.width * l.height) / 1e6 < pi.minMeasure;
                return (
                  <tr key={l.id} className="border-t border-[#263044] align-top hover:bg-[#1C2534]/60">
                    <td className="py-2 text-center text-[11px] tabular-nums text-[#94A3B8]">{i + 1}</td>
                    <td className="space-y-1 px-1 py-1.5">
                      <input data-r={i} data-c={0} className={cell} value={l.name} onChange={(e) => setLine(i, { name: e.target.value })} aria-label="Tên hạng mục" placeholder="Tên hạng mục" />
                      <input data-r={i} data-c={1} className={cn(cell, 'text-[#94A3B8]')} value={l.location} onChange={(e) => setLine(i, { location: e.target.value })} aria-label="Vị trí" placeholder="Vị trí, VD: cửa chính tầng 1" />
                      {!pi && (
                        <div className="grid grid-cols-2 gap-1">
                          <select className={cell} value={l.unit} onChange={(e) => setLine(i, { unit: e.target.value as PriceUnit })} aria-label="Đơn vị">{(Object.keys(PRICE_UNIT) as PriceUnit[]).map((u) => <option key={u} value={u}>{PRICE_UNIT[u].short}</option>)}</select>
                          <input data-r={i} data-c={6} className={num} inputMode="numeric" value={l.unitPrice ? l.unitPrice.toLocaleString('vi-VN') : ''} onChange={(e) => setLine(i, { unitPrice: digits(e.target.value) })} aria-label="Đơn giá" placeholder="Đơn giá" />
                        </div>
                      )}
                    </td>
                    <td className="px-1 py-1.5">
                      {l.unit === 'M2' ? (
                        <div className="grid grid-cols-2 gap-1">
                          <input data-r={i} data-c={2} className={num} type="number" min={0} value={l.width || ''} onChange={(e) => setLine(i, { width: Number(e.target.value) })} aria-label="Rộng (mm)" placeholder="R mm" />
                          <input data-r={i} data-c={3} className={num} type="number" min={0} value={l.height || ''} onChange={(e) => setLine(i, { height: Number(e.target.value) })} aria-label="Cao (mm)" placeholder="C mm" />
                        </div>
                      ) : l.unit === 'MD' ? (
                        <input data-r={i} data-c={2} className={num} type="number" min={0} step={0.1} value={l.length || ''} onChange={(e) => setLine(i, { length: Number(e.target.value) })} aria-label="Dài (m)" placeholder="Dài m" />
                      ) : <p className="py-1 text-right text-[#94A3B8]">—</p>}
                      <p className={cn('mt-0.5 text-right text-[10px] tabular-nums', small ? 'text-[#F7B23B]' : 'text-[#94A3B8]')}>{lineMeasure(l, pi?.minMeasure).toLocaleString('vi-VN')} {PRICE_UNIT[l.unit].short}{small ? ' (tối thiểu)' : ''}</p>
                    </td>
                    <td className="px-1 py-1.5"><input data-r={i} data-c={4} className={num} type="number" min={0} value={l.qty} onChange={(e) => setLine(i, { qty: Number(e.target.value) })} aria-label="Số lượng" /></td>
                    <td className="px-1 py-1.5"><input data-r={i} data-c={5} className={num} type="number" min={0} max={100} value={l.discountPct} onChange={(e) => setLine(i, { discountPct: Number(e.target.value) })} aria-label="Chiết khấu %" /></td>
                    <td className="px-2 py-1.5 text-right tabular-nums"><p className="font-medium text-[#F1F5F9]">{lineAmount(l, pi?.minMeasure).toLocaleString('vi-VN')}</p><p className="text-[10px] text-[#94A3B8]">{l.unitPrice.toLocaleString('vi-VN')}/{PRICE_UNIT[l.unit].short}</p></td>
                    <td className="py-1.5 text-center"><button tabIndex={-1} className="rounded p-1 text-[#94A3B8] hover:text-[#F87171]" onClick={() => setLines((ls) => ls.filter((_, k) => k !== i))} aria-label="Xóa dòng"><Trash2 className="h-3.5 w-3.5" /></button></td>
                  </tr>
                );
              })}
              {!lines.length && <tr><td colSpan={7} className="px-3 py-4 text-center text-[#94A3B8]">Chọn hạng mục từ bảng giá rồi nhập kích thước đo thực tế.</td></tr>}
            </tbody>
          </table>
          <div className="border-t border-[#263044] p-2" data-picker>
            <select className={cn(inputCls, 'py-1.5 text-xs')} value="" onChange={(e) => { const p = priceItems.find((x) => x.id === e.target.value); if (p) addLine(p); else if (e.target.value === 'free') addLine(); }} aria-label="Thêm hạng mục">
              <option value="">+ Thêm hạng mục từ bảng giá (Enter để mở)</option>
              {cats.map((cat) => <optgroup key={cat} label={cat}>{priceItems.filter((p) => p.active && p.category === cat).map((p) => <option key={p.id} value={p.id}>{p.name} ({compact(p.price)}/{PRICE_UNIT[p.unit].short})</option>)}</optgroup>)}
              <option value="free">Hạng mục ngoài bảng giá</option>
            </select>
          </div>
          <div className="grid grid-cols-3 gap-px rounded-b-xl border-t border-[#263044] bg-[#263044] text-xs tabular-nums">
            <p className="bg-[#151C29] px-2 py-1.5 text-right"><span className="block text-[10px] text-[#94A3B8]">Cộng</span>{t.subtotal.toLocaleString('vi-VN')}</p>
            <label className="flex flex-col items-end bg-[#151C29] px-2 py-1.5"><span className="flex items-center gap-1 text-[10px] text-[#94A3B8]">VAT<input className="w-9 rounded border border-[#263044] bg-[#0F141E] px-1 text-right text-[10px]" type="number" min={0} max={10} value={vatPct} onChange={(e) => setVatPct(Number(e.target.value))} aria-label="VAT %" />%</span>{t.vat.toLocaleString('vi-VN')}</label>
            <p className="bg-[#151C29] px-2 py-1.5 text-right font-semibold text-[#F7B23B]"><span className="block text-[10px] font-normal text-[#94A3B8]">Tổng cộng (đ)</span>{t.total.toLocaleString('vi-VN')}</p>
          </div>
        </div>
        <div className="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-[#94A3B8]">
          <span className="hidden lg:inline"><kbd className="rounded border border-[#263044] px-1">Tab</kbd> sang ô kế, <kbd className="rounded border border-[#263044] px-1">Enter</kbd> xuống dòng / thêm hạng mục</span>
          {canSeeCost && gm !== null && <span className={cn('ml-auto', lowMargin && 'text-[#F7B23B]')}>Lãi gộp dự toán {vnd(t.subtotal - t.cost)} ({gm.toFixed(1)}%)</span>}
        </div>
      </section>

      <section>
        {secHead(2, 'Điều khoản thanh toán')}
        <ul className="space-y-1 rounded-md border border-[#263044] bg-[#151C29] p-3 text-xs">
          {job.schedule.map((st) => <li key={st.id} className="flex justify-between gap-2"><span>{st.label} <span className="text-[#94A3B8]">({PAY_TRIGGER[st.trigger].toLowerCase()})</span></span><span className="tabular-nums">{st.pct}% · {Math.round((t.total * st.pct) / 100).toLocaleString('vi-VN')} đ</span></li>)}
          <li className="pt-1 text-[11px] text-[#94A3B8]">Hiệu lực {mfgConfig.quoteValidDays} ngày, bảo hành {job.warrantyMonths ?? mfgConfig.warrantyMonths} tháng. Sửa lịch thanh toán khi nhận cọc.</li>
        </ul>
        <div className="mt-2"><Fold title="Ghi chú trên báo giá" summary={note.trim() || 'Màu nhôm, loại kính, thời gian thi công...'} open={!!note}>
          <textarea className={cn(inputCls, 'min-h-[72px] text-sm')} value={note} onChange={(e) => setNote(e.target.value)} placeholder="Màu nhôm, loại kính, thời gian thi công dự kiến..." />
        </Fold></div>
      </section>
    </>
  );

  return (
    <ComposerShell
      title={current ? `Báo giá ${job.code} v${current.q.version}` : last ? `Sửa báo giá ${job.code}: lập bản v${nextV}` : `Tạo báo giá ${job.code}`}
      subtitle={`${jobCustName(job, customers)} · ${job.title}`}
      badge={current ? <Chip tone="teal">Đã lưu v{current.q.version}</Chip> : job.draft.length ? <Chip tone="orange">Nháp</Chip> : undefined}
      left={left}
      html={html}
      onClose={close}
      footer={
        <DocActionBar
          status={<span className={cn('font-medium', err ? 'text-[#F87171]' : current ? 'text-[#3DDBB6]' : 'text-[#94A3B8]')}>{err ? err : current ? `Đã lưu v${current.q.version}, ${vnd(current.q.total)}` : `Đóng để lưu nháp. Xuất file / gửi sẽ lưu bản v${nextV}`}</span>}
          pdf={{ onClick: () => exportAs('PDF'), disabled: !!err, title: current ? 'In / lưu PDF' : `Lưu bản v${nextV} rồi in PDF` }}
          word={{ onClick: () => exportAs('WORD'), disabled: !!err, title: current ? 'Tải file Word (.doc)' : `Lưu bản v${nextV} rồi tải Word` }}
          win={{ onClick: win, disabled: !!err || !onWin, title: onWin ? 'Lưu báo giá rồi nhận cọc & chuyển sản xuất' : 'Không có quyền chốt đơn' }}
          submit={{ onClick: submit, disabled: !!err, title: lowMargin ? 'Lãi gộp dưới 25%: lưu và gửi Giám đốc xem lại giá' : 'Lưu phiên bản, đơn chuyển "Đã báo giá"' }}
        />
      }
    />
  );
}

// ---------------- Nhận cọc & chuyển sản xuất ----------------

function DepositModal({ job, onClose }: { job: Job; onClose: () => void }) {
  const { me, setJobs, setCustomers, receipts, setReceipts, workOrders, setWorkOrders, notify, audit, users, dispatch, mfgConfig, customers } = useApp();
  const [ver, setVer] = useState(job.quotes[job.quotes.length - 1]?.version ?? 0);
  const q = job.quotes.find((x) => x.version === ver);
  const [schedule, setSchedule] = useState<PayStage[]>(job.schedule.map((x) => ({ ...x })));
  const sum = schedule.reduce((s, x) => s + x.pct, 0);
  const depositPct = schedule.filter((s) => s.trigger === 'SIGN').reduce((s, x) => s + x.pct, 0);
  const total = q?.total ?? 0;
  const [amt, setAmt] = useState(Math.round((total * depositPct) / 100));
  const [method, setMethod] = useState<'CASH' | 'TRANSFER'>('CASH');
  const [photo, setPhoto] = useState<string | undefined>();
  const [days, setDays] = useState(mfgConfig.productionDays);
  const [woNote, setWoNote] = useState('');
  const [busy, setBusy] = useState(false);
  const xuong = users.filter((u) => u.active && u.dept === 'XUONG');
  const [leader, setLeader] = useState(xuong.find((u) => u.role === 'DEPT_HEAD')?.id ?? xuong[0]?.id ?? '');
  const setStage = (i: number, p: Partial<PayStage>) => setSchedule((xs) => xs.map((x, k) => (k === i ? { ...x, ...p } : x)));
  const errs: string[] = [];
  if (!q) errs.push('Chưa có báo giá');
  if (sum !== 100) errs.push(`Tổng các đợt thanh toán phải bằng 100% (đang ${sum}%)`);
  if (amt <= 0) errs.push('Nhập số tiền cọc đã nhận');
  if (method === 'TRANSFER' && !photo) errs.push('Chuyển khoản: chụp màn hình giao dịch');
  const save = () => {
    if (errs.length || !q) return notify(errs[0], 'red');
    const at = todayISO();
    const nj: Job = { ...job, wonAt: at, wonVersion: q.version, contractValue: q.total, schedule };
    setJobs((all) => all.map((j) => (j.id === job.id ? nj : j)));
    const r: Receipt = {
      id: uid('rc'), code: nextCode(receipts.map((x) => x.code), `PT-${new Date().getFullYear()}-`, 4), jobId: job.id, stageId: schedule.find((s) => s.trigger === 'SIGN')?.id,
      amount: amt, method, collectedBy: me.id, collectedAt: Date.now(), photo, note: `Cọc ${job.code}`,
      status: method === 'CASH' ? 'HOLDING' : 'SUBMITTED', submittedAt: method === 'CASH' ? undefined : Date.now(),
    };
    setReceipts((p) => [r, ...p]);
    const custName = jobCustName(job, customers);
    const wo = buildWorkOrder(nj, q, custName, nextCode(workOrders.map((w) => w.code), `LSX-${new Date().getFullYear()}-`, 4), leader || undefined, me.id, days, woNote.trim());
    setWorkOrders((p) => [wo, ...p]);
    setCustomers((p) => p.map((c) => (c.id === job.customerId ? { ...c, status: 'ACTIVE' } : c)));
    users.filter((u) => u.active && (u.role === 'ACCOUNTANT' || u.id === leader)).forEach((u) => dispatch('APPROVAL_RESULT', { to: u, title: u.role === 'ACCOUNTANT' ? `Tiền cọc ${job.code}: ${vnd(amt)}` : `Lệnh sản xuất mới ${wo.code}`, body: `${custName}, ${job.title}. Hạn xưởng ${fmtDate(wo.dueDate)}.`, module: u.role === 'ACCOUNTANT' ? 'tasks' : 'production' }));
    audit('JOB_WON', `${job.code} chốt ${vnd(q.total)}, cọc ${vnd(amt)}, tạo ${wo.code}`);
    notify(`Đã nhận cọc, chuyển sản xuất (${wo.code}). ${method === 'CASH' ? `Nộp ${vnd(amt)} về kế toán trong ${mfgConfig.submitHours} giờ.` : 'Chờ kế toán đối chiếu chuyển khoản.'}`, 'teal');
    onClose();
  };
  return (
    <Modal title={`Nhận cọc & chuyển sản xuất: ${job.code}`} onClose={onClose} wide
      footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={cn(btnBase, 'bg-[#00B894] px-3.5 py-2 font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} disabled={busy} onClick={save}><CheckCircle2 className="h-4 w-4" aria-hidden />Nhận cọc, chuyển sản xuất</button></>}>
      <div className="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div className="space-y-4">
          <Field label="Báo giá khách chốt">
            <select className={inputCls} value={ver} onChange={(e) => { const v = Number(e.target.value); setVer(v); setAmt(Math.round(((job.quotes.find((x) => x.version === v)?.total ?? 0) * depositPct) / 100)); }}>
              {[...job.quotes].reverse().map((x) => <option key={x.version} value={x.version}>Báo giá v{x.version}: {vnd(x.total)}</option>)}
            </select>
          </Field>
          <div>
            <p className="mb-1.5 text-xs font-medium text-[#94A3B8]">Lịch thanh toán của đơn</p>
            <ul className="space-y-2">
              {schedule.map((s, i) => (
                <li key={s.id} className="grid grid-cols-[1fr_88px_32px] items-center gap-2">
                  <input className={cn(inputCls, 'py-1.5 text-sm')} value={s.label} onChange={(e) => setStage(i, { label: e.target.value })} aria-label="Tên đợt" />
                  <div className="relative"><input className={cn(inputCls, 'py-1.5 pr-6 text-right text-sm tabular-nums')} type="number" min={0} max={100} value={s.pct} onChange={(e) => { const v = Number(e.target.value); setStage(i, { pct: v }); if (s.trigger === 'SIGN') setAmt(Math.round((total * v) / 100)); }} aria-label="Tỷ lệ" /><span className="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-xs text-[#94A3B8]">%</span></div>
                  <button className="flex justify-center text-[#94A3B8] hover:text-[#F87171] disabled:opacity-30" disabled={schedule.length <= 1} onClick={() => setSchedule((xs) => xs.filter((_, k) => k !== i))} aria-label="Xóa đợt"><Trash2 className="h-4 w-4" /></button>
                </li>
              ))}
            </ul>
            <div className="mt-2 flex items-center justify-between">
              <button className={cn(btnGhost, btnSm)} onClick={() => setSchedule((xs) => [...xs, { id: uid('ps'), label: 'Đợt giữa', pct: 0, trigger: 'DELIVERY' }])}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm đợt</button>
              <span className={cn('text-xs tabular-nums', sum === 100 ? 'text-[#3DDBB6]' : 'text-[#F87171]')}>Tổng {sum}%</span>
            </div>
          </div>
          <div className="grid grid-cols-2 gap-3">
            <Field label="Số ngày sản xuất"><input className={inputCls} type="number" min={1} value={days} onChange={(e) => setDays(Math.max(1, Number(e.target.value) || 1))} /></Field>
            <Field label="Phụ trách xưởng"><select className={inputCls} value={leader} onChange={(e) => setLeader(e.target.value)}><option value="">Chưa giao</option>{(xuong.length ? xuong : users.filter((u) => u.active)).map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}</select></Field>
            <Field label="Ghi chú cho xưởng" className="col-span-2"><input className={inputCls} value={woNote} onChange={(e) => setWoNote(e.target.value)} placeholder="Màu sơn, ưu tiên hạng mục..." /></Field>
          </div>
        </div>
        <div className="space-y-4">
          <div className="space-y-1 rounded-md border border-[#263044] p-3 text-sm">
            <p className="flex justify-between"><span className="text-[#94A3B8]">Giá trị hợp đồng</span><b className="tabular-nums">{vnd(total)}</b></p>
            {schedule.map((s) => <p key={s.id} className="flex justify-between text-xs"><span className="text-[#94A3B8]">{s.label} {s.pct}%</span><span className="tabular-nums">{vnd((total * s.pct) / 100)}</span></p>)}
          </div>
          <Field label="Tiền cọc nhận được"><MoneyInput value={amt} onChange={setAmt} /></Field>
          <div className="flex rounded bg-[#0F141E] p-0.5" role="radiogroup" aria-label="Hình thức">
            {(['CASH', 'TRANSFER'] as const).map((m) => <button key={m} type="button" role="radio" aria-checked={method === m} onClick={() => setMethod(m)} className={cn('flex-1 rounded-md px-3 py-2 text-sm font-medium', method === m ? 'g-brand font-semibold text-[#0F141E]' : 'text-[#94A3B8]')}>{m === 'CASH' ? 'Tiền mặt' : 'Chuyển khoản'}</button>)}
          </div>
          <div className="flex flex-wrap items-center gap-3">
            <FilePicker accept="image/*" disabled={busy} onFiles={(f) => { setBusy(true); compressImage(f[0], 1000).then(setPhoto).catch(() => notify('Không đọc được ảnh', 'red')).finally(() => setBusy(false)); }} className={cn(btnGhost, btnSm, 'inline-flex')}><Upload className="h-3.5 w-3.5" aria-hidden />{photo ? 'Đổi ảnh' : method === 'TRANSFER' ? 'Ảnh chuyển khoản *' : 'Ảnh phiếu cọc (tùy chọn)'}</FilePicker>
            {/* eslint-disable-next-line @next/next/no-img-element */}
            {photo && <img src={photo} alt="Chứng từ cọc" className="h-14 rounded object-cover" />}
          </div>
          {amt > 0 && amt < Math.round((total * depositPct) / 100) && <p className="text-xs text-[#F7B23B]">Cọc thấp hơn {depositPct}% ({vnd((total * depositPct) / 100)}).</p>}
          <p className="text-xs text-[#94A3B8]">Lưu xong: tự tạo lệnh sản xuất trạng thái "Chờ sản xuất" và báo xưởng. Doanh số ghi nhận khi kế toán xác nhận tiền.</p>
        </div>
      </div>
      {errs.length > 0 && <ul className="mt-3 space-y-0.5 text-xs text-[#F87171]">{errs.map((x) => <li key={x}>{x}</li>)}</ul>}
    </Modal>
  );
}

// ---------------- Ngăn chi tiết đơn hàng ----------------

function JobDrawer({ id, onClose }: { id: string; onClose: () => void }) {
  const { jobs, setJobs, customers, users, canDo, company, mfgConfig, audit, userName, go, sources, stockMoves, cashEntries, workOrders, stockItems } = useApp();
  const info = useJobInfo();
  const j = jobs.find((x) => x.id === id);
  const [tab, setTab] = useState<'quote' | 'pay' | 'progress' | 'care'>('quote');
  const [modal, setModal] = useState<'quote' | 'deposit' | 'edit' | 'care' | 'lost' | 'schedule' | null>(null);
  const [collect, setCollect] = useState<number | null>(null);
  const [lost, setLost] = useState<{ reason: JobLostReason; note: string }>({ reason: 'PRICE', note: '' });
  if (!j) return null;
  const { stage, detail, money, wo, installs, due } = info(j);
  const cust = customers.find((c) => c.id === j.customerId);
  const owner = users.find((u) => u.id === j.ownerId);
  const can = canDo('job.manage');
  const patch = (p: Partial<Job>) => setJobs((all) => all.map((x) => (x.id === j.id ? { ...x, ...p } : x)));
  const stepIdx = stage === 'LOST' ? -1 : JOB_STAGES.indexOf(stage);
  const remaining = Math.max(0, money.value - money.collected);
  const printQuote = (q: JobQuote) => printHtml(docShell(`Báo giá ${j.code} v${q.version}`, jobQuoteHtml(j, q, company, cust, owner, mfgConfig)));
  const accepted = installs.find((i) => i.acceptance);
  const cost = jobActualCost(j, stockMoves, cashEntries, workOrders);
  const lateSurvey = stage === 'SURVEY' && j.appointmentAt && j.appointmentAt < toLocal(new Date());
  const scheduled = installs.find((i) => i.status !== 'ACCEPTED');
  const care = [...(j.care ?? [])].sort((a, b) => b.at - a.at);

  const actions = (
    <>
      {stage === 'SURVEY' && can && <button className={cn(btnPrimary, btnSm)} onClick={() => setModal('quote')}><FileText className="h-3.5 w-3.5" aria-hidden />Tạo báo giá</button>}
      {stage === 'QUOTED' && can && <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} onClick={() => setModal('deposit')}><Banknote className="h-3.5 w-3.5" aria-hidden />Nhận cọc & chuyển sản xuất</button>}
      {stage === 'QUOTED' && can && <button className={cn(btnGhost, btnSm)} onClick={() => setModal('quote')}><Pencil className="h-3.5 w-3.5" aria-hidden />Sửa báo giá</button>}
      {stage === 'INSTALL' && !scheduled && canDo('install.manage') && <button className={cn(btnPrimary, btnSm)} onClick={() => setModal('schedule')}><CalendarDays className="h-3.5 w-3.5" aria-hidden />Hẹn lắp đặt</button>}
      {j.wonAt && remaining > 0 && can && <button className={cn(btnGhost, btnSm)} onClick={() => setCollect(Math.max(0, due - money.collected) || remaining)}><Banknote className="h-3.5 w-3.5" aria-hidden />Thu tiền</button>}
      {(stage === 'QUOTED' || stage === 'LOST') && <button className={cn(btnGhost, btnSm)} onClick={() => setModal('care')}><MessageSquare className="h-3.5 w-3.5" aria-hidden />Ghi chăm sóc</button>}
      {(stage === 'SURVEY' || stage === 'QUOTED') && can && <button className={cn(btnBase, btnSm, 'bg-[#EF4444]/15 text-[#F87171]')} onClick={() => setModal('lost')}>Trượt</button>}
      {stage === 'LOST' && can && <button className={cn(btnGhost, btnSm)} onClick={() => { patch({ lostAt: undefined, lostReason: undefined, lostNote: undefined }); audit('JOB_REOPEN', `${j.code} mở lại`); }}>Mở lại đơn</button>}
    </>
  );

  return (
    <Drawer title={jobCustName(j, customers)} eyebrow={`${j.code} · ${j.title}`} badge={<Chip tone={JOB_STAGE[stage].tone}>{JOB_STAGE[stage].label}</Chip>} onClose={onClose} actions={actions}>
      <ol className="grid grid-cols-6" aria-label="Tiến độ đơn hàng">
        {JOB_STAGES.map((s, i) => {
          const done = i < stepIdx || stage === 'DONE';
          return (
            <li key={s} className="flex flex-col items-center text-center">
              <div className="flex w-full items-center">
                <span className={cn('h-0.5 flex-1', i === 0 ? 'opacity-0' : i <= stepIdx ? 'bg-[#00B894]' : 'bg-[#263044]')} />
                <span className={cn('flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] font-bold', done ? 'bg-[#00B894] text-[#0F141E]' : i === stepIdx ? 'g-brand font-semibold text-[#0F141E]' : 'border border-[#263044] bg-[#1C2534] text-[#94A3B8]')}>{done ? <CheckCircle2 className="h-3.5 w-3.5" aria-hidden /> : i + 1}</span>
                <span className={cn('h-0.5 flex-1', i === JOB_STAGES.length - 1 ? 'opacity-0' : i < stepIdx ? 'bg-[#00B894]' : 'bg-[#263044]')} />
              </div>
              <p className={cn('mt-1 px-0.5 text-[10px] leading-tight', i === stepIdx ? 'font-semibold text-[#F7B23B]' : 'text-[#94A3B8]')}>{JOB_STAGE[s].short}</p>
            </li>
          );
        })}
      </ol>
      {j.lostAt && <p className="rounded bg-[#EF4444]/10 p-3 text-sm text-[#F87171]">Trượt ngày {fmtDate(j.lostAt)}: {JOB_LOST[j.lostReason ?? 'OTHER']}{j.lostNote ? `. ${j.lostNote}` : ''}</p>}
      <p className={cn('rounded px-3 py-2 text-sm', lateSurvey ? 'bg-[#EF4444]/10 text-[#F87171]' : 'bg-[#1C2534] text-[#F1F5F9]')}>{lateSurvey ? 'Quá giờ hẹn khảo sát. ' : ''}{detail}</p>

      <section>
        <div className="mb-2 flex items-center justify-between gap-2">
          <h3 className="text-sm font-semibold">Thông tin khách hàng</h3>
          {can && !j.lostAt && <button className={cn(btnGhost, btnSm)} onClick={() => setModal('edit')}><Pencil className="h-3.5 w-3.5" aria-hidden />Sửa</button>}
        </div>
        <InfoGrid rows={[
          ['Khách hàng', jobCustName(j, customers)],
          ['Số điện thoại', jobPhone(j, customers) ? <a className="text-[#F7B23B] hover:underline" href={`tel:${phoneKey(jobPhone(j, customers))}`}>{jobPhone(j, customers)}</a> : ''],
          ['Địa chỉ', j.siteAddress, true],
          ['Thời gian hẹn khảo sát', j.appointmentAt ? fmtDT(j.appointmentAt) : ''],
          ['Kỹ thuật khảo sát', owner?.name ?? ''],
          ['Hạng mục', j.title, true],
          ['Nguồn khách', sources.find((s) => s.id === cust?.sourceId)?.name ?? ''],
          ['Ghi chú', j.note],
        ]} />
      </section>

      {(j.wonAt || j.quotes.length > 0) && (
        <div className="grid grid-cols-2 gap-2 sm:grid-cols-4">
          <MiniStat label={j.wonAt ? 'Giá trị hợp đồng' : 'Báo giá mới nhất'} value={compact(money.value || (j.quotes[j.quotes.length - 1]?.total ?? 0))} />
          <MiniStat label="Đã xác nhận thu" value={compact(money.confirmed)} tone="teal" />
          <MiniStat label="Chờ nộp / xác nhận" value={compact(money.pending)} tone="orange" />
          <MiniStat label="Còn phải thu" value={compact(remaining)} tone={remaining && stage === 'WAIT_PAYMENT' ? 'red' : undefined} />
        </div>
      )}

      <Tabs tabs={[{ id: 'quote', label: 'Báo giá', count: j.quotes.length || undefined }, { id: 'pay', label: 'Thanh toán' }, { id: 'progress', label: 'Sản xuất & lắp đặt' }, { id: 'care', label: 'Chăm sóc', count: care.length || undefined }]} value={tab} onChange={setTab} />

      {tab === 'quote' && (
        <div className="space-y-4">
          {!j.quotes.length ? (
            <div className="rounded-md border border-dashed border-[#263044] p-5 text-center">
              <p className="text-sm text-[#94A3B8]">Chưa có báo giá. Kỹ thuật khảo sát, đo đạc rồi bấm "Tạo báo giá".</p>
              {can && !j.lostAt && <button className={cn(btnPrimary, btnSm, 'mt-3')} onClick={() => setModal('quote')}><FileText className="h-3.5 w-3.5" aria-hidden />Tạo báo giá{j.draft.length ? ` (nháp ${j.draft.length} dòng)` : ''}</button>}
            </div>
          ) : (
            <ul className="space-y-1.5">
              {[...j.quotes].reverse().map((q) => (
                <li key={q.id} className="flex flex-wrap items-center gap-x-3 gap-y-1 rounded bg-[#1C2534] px-3 py-2.5 text-sm">
                  <b>v{q.version}</b>
                  <span className="text-xs text-[#94A3B8]">{new Date(q.at).toLocaleDateString('vi-VN')}, {q.lines.length} hạng mục, {userName(q.by)}</span>
                  {q.version === j.wonVersion && <Chip tone="teal">Khách chốt</Chip>}
                  <span className="ml-auto font-semibold tabular-nums">{vnd(q.total)}</span>
                  <button className={cn(btnGhost, btnSm)} onClick={() => printQuote(q)}><Download className="h-3.5 w-3.5" aria-hidden />PDF</button>
                </li>
              ))}
            </ul>
          )}
          {j.files.length > 0 && (
            <div>
              <p className="mb-2 text-xs font-medium text-[#94A3B8]">Ảnh khảo sát & bản vẽ</p>
              <div className="grid grid-cols-3 gap-2 sm:grid-cols-5">
                {j.files.map((f) => (
                  <a key={f.id} href={f.url} target="_blank" rel="noreferrer" className="relative block overflow-hidden rounded border border-[#263044] bg-[#1C2534]">
                    {/* eslint-disable-next-line @next/next/no-img-element */}
                    {f.url.startsWith('data:image') ? <img src={f.url} alt={f.name} className="aspect-square w-full object-cover" /> : <span className="flex aspect-square flex-col items-center justify-center p-2 text-center text-[11px] text-[#94A3B8]"><FileText className="mb-1 h-5 w-5" aria-hidden />{f.name}</span>}
                    <span className={cn('absolute left-1 top-1 rounded px-1.5 py-0.5 text-[10px] font-semibold', f.kind === 'DRAWING' ? 'g-brand font-semibold text-[#0F141E]' : 'bg-black/60 text-white')}>{f.kind === 'DRAWING' ? 'Bản vẽ' : 'Ảnh'}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
          {j.surveyCheckins.length > 0 && <p className="text-xs text-[#94A3B8]">Check-in: {j.surveyCheckins.map((c) => `${userName(c.by)} ${new Date(c.at).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' })}${c.simulated ? ' (GPS mô phỏng)' : ''}`).join('; ')}</p>}
        </div>
      )}

      {tab === 'pay' && (
        <div className="space-y-5">
          {!j.wonAt ? <p className="rounded bg-[#1C2534] p-3 text-sm text-[#94A3B8]">Chưa nhận cọc. Khách đồng ý báo giá thì bấm "Nhận cọc & chuyển sản xuất" (mặc định cọc {j.schedule.filter((s) => s.trigger === 'SIGN').reduce((s, x) => s + x.pct, 0)}%).</p> : (
            <section>
              <h3 className="mb-2 text-sm font-semibold">Lịch thanh toán</h3>
              <ul className="space-y-1.5">
                {j.schedule.map((s) => {
                  const reached = dueByStage({ ...j, schedule: [s] }, stage) > 0;
                  return (
                    <li key={s.id} className="grid grid-cols-[1fr_auto_auto] items-center gap-3 rounded bg-[#1C2534] px-3 py-2 text-sm">
                      <span className="min-w-0"><b className="font-medium">{s.label} {s.pct}%</b><span className="block text-xs text-[#94A3B8]">{PAY_TRIGGER[s.trigger]}</span></span>
                      <span className="tabular-nums">{vnd((money.value * s.pct) / 100)}</span>
                      <Chip tone={reached ? 'orange' : 'muted'}>{reached ? 'Đến hạn' : 'Chưa đến'}</Chip>
                    </li>
                  );
                })}
              </ul>
            </section>
          )}
          <section>
            <h3 className="mb-2 text-sm font-semibold">Phiếu thu</h3>
            <ReceiptList job={j} />
          </section>
        </div>
      )}

      {tab === 'progress' && (
        <div className="space-y-5">
          {!j.wonAt ? <p className="rounded bg-[#1C2534] p-3 text-sm text-[#94A3B8]">Nhận cọc xong, lệnh sản xuất được tạo tự động.</p> : (
            <>
              <section>
                <h3 className="mb-2 text-sm font-semibold">Sản xuất</h3>
                {wo ? (
                  <button className="grid w-full grid-cols-[1fr_auto] items-center gap-2 rounded border border-[#263044] bg-[#1C2534] p-3 text-left text-sm hover:border-[#94A3B8]/40" onClick={() => { onClose(); go('production'); }}>
                    <span className="min-w-0"><b className="font-mono text-[#F7B23B]">{wo.code}</b><span className="block text-xs text-[#94A3B8]">Hạn {fmtDate(wo.dueDate)}, phụ trách {userName(wo.leaderId)}, {wo.items.length} hạng mục</span></span>
                    <Chip tone={WO_STAGE[wo.stage].tone}>{WO_STAGE[wo.stage].label}</Chip>
                  </button>
                ) : <p className="text-sm text-[#94A3B8]">Chưa có lệnh sản xuất.</p>}
              </section>
              <section>
                <h3 className="mb-2 text-sm font-semibold">Lắp đặt & nghiệm thu</h3>
                {installs.length ? (
                  <ul className="space-y-1.5">
                    {installs.map((i) => (
                      <li key={i.id}>
                        <button className="grid w-full grid-cols-[1fr_auto] items-center gap-2 rounded bg-[#1C2534] px-3 py-2 text-left text-sm" onClick={() => { onClose(); go('install'); }}>
                          <span><b className="font-mono text-xs text-[#F7B23B]">{i.code}</b> <span className="text-xs text-[#94A3B8]">{i.from ? fmtDT(i.from) : ''}, {userName(i.leaderId)}</span></span>
                          <Chip tone={i.status === 'ACCEPTED' ? 'teal' : i.status === 'IN_PROGRESS' ? 'orange' : 'blue'}>{i.status === 'ACCEPTED' ? 'Đã nghiệm thu' : i.status === 'IN_PROGRESS' ? 'Đang lắp' : 'Đã hẹn lắp'}</Chip>
                        </button>
                      </li>
                    ))}
                  </ul>
                ) : <p className="text-sm text-[#94A3B8]">{wo?.stage === 'DONE' ? 'Xưởng đã hoàn thành, hẹn lịch lắp đặt với khách.' : 'Chờ xưởng hoàn thành.'}</p>}
                {accepted?.acceptance && <p className="mt-2 rounded bg-[#00B894]/10 p-3 text-sm text-[#3DDBB6]">Nghiệm thu {fmtDate(accepted.acceptance.at.slice(0, 10))}, bảo hành {accepted.acceptance.warrantyMonths ?? j.warrantyMonths} tháng{accepted.acceptance.warrantyUntil ? ` đến ${fmtDate(accepted.acceptance.warrantyUntil)}` : ''}{stage === 'DONE' ? '' : ' (hiệu lực khi thanh toán đủ)'}.</p>}
              </section>
              {(cost.total > 0 || canDo('price.viewCost')) && (
                <section>
                  <h3 className="mb-2 text-sm font-semibold">Chi phí thực tế</h3>
                  <div className="grid grid-cols-3 gap-2">
                    <MiniStat label="Vật tư xuất kho" value={compact(cost.material)} />
                    <MiniStat label="Chi phí khác" value={compact(cost.other)} />
                    <MiniStat label="Lãi gộp thực tế" value={money.value ? pct(money.value - cost.total, money.value) : '—'} tone={money.value && (money.value - cost.total) / money.value < 0.2 ? 'red' : 'teal'} />
                  </div>
                  {stockMoves.filter((m) => m.type === 'OUT' && (m.jobId === j.id || m.woId === wo?.id)).length > 0 && (
                    <ul className="mt-2 space-y-1 text-xs text-[#94A3B8]">
                      {stockMoves.filter((m) => m.type === 'OUT' && (m.jobId === j.id || m.woId === wo?.id)).map((m) => <li key={m.id} className="flex justify-between gap-2"><span>{m.code}: {stockItems.find((s) => s.id === m.itemId)?.name ?? m.itemId} × {m.qty}</span><span className="tabular-nums">{vnd(m.qty * m.unitCost)}</span></li>)}
                    </ul>
                  )}
                </section>
              )}
            </>
          )}
        </div>
      )}

      {tab === 'care' && (
        <div className="space-y-3">
          <button className={cn(btnGhost, btnSm)} onClick={() => setModal('care')}><Plus className="h-3.5 w-3.5" aria-hidden />Ghi chăm sóc</button>
          {care.length ? (
            <ul className="space-y-1.5">
              {care.map((c) => <li key={c.id} className="rounded bg-[#1C2534] px-3 py-2 text-sm"><p>{c.note}</p><p className="mt-0.5 text-xs text-[#94A3B8]">{userName(c.by)}, {new Date(c.at).toLocaleString('vi-VN')}{c.nextAt ? `, hẹn lại ${fmtDate(c.nextAt)}` : ''}</p></li>)}
            </ul>
          ) : <p className="text-sm text-[#94A3B8]">Chưa có lần chăm sóc nào.</p>}
        </div>
      )}

      {modal === 'quote' && <QuoteEditorModal job={j} onClose={() => setModal(null)} onWin={() => setModal('deposit')} />}
      {modal === 'deposit' && <DepositModal job={j} onClose={() => setModal(null)} />}
      {modal === 'edit' && <MfgLeadForm job={j} onClose={() => setModal(null)} />}
      {modal === 'care' && <CareModal job={j} onClose={() => setModal(null)} />}
      {modal === 'schedule' && wo && <InstallScheduleModal wo={wo} onClose={() => setModal(null)} />}
      {collect !== null && <ReceiptModal job={j} amount={collect} title={`Thu tiền: ${j.code}`} onClose={() => setCollect(null)} />}
      {modal === 'lost' && (
        <Modal title={`Trượt: ${j.code}`} onClose={() => setModal(null)} footer={<><button className={btnGhost} onClick={() => setModal(null)}>Hủy</button><button className={cn(btnBase, 'bg-[#EF4444] px-3.5 py-2 font-semibold text-white')} onClick={() => { patch({ lostAt: todayISO(), lostReason: lost.reason, lostNote: lost.note.trim() || undefined }); audit('JOB_LOST', `${j.code} trượt: ${JOB_LOST[lost.reason]}`); setModal(null); }}>Xác nhận trượt</button></>}>
          <div className="space-y-3">
            <Field label="Lý do"><select className={inputCls} value={lost.reason} onChange={(e) => setLost({ ...lost, reason: e.target.value as JobLostReason })}>{(Object.keys(JOB_LOST) as JobLostReason[]).map((r) => <option key={r} value={r}>{JOB_LOST[r]}</option>)}</select></Field>
            <Field label="Ghi chú"><input className={inputCls} value={lost.note} onChange={(e) => setLost({ ...lost, note: e.target.value })} placeholder="VD: Khách chọn đơn vị rẻ hơn 15%" /></Field>
            <p className="text-xs text-[#94A3B8]">Đơn trượt chuyển sang danh sách "Cần theo dõi, chăm sóc" ở Phân lead.</p>
          </div>
        </Modal>
      )}
    </Drawer>
  );
}

// ---------------- Danh sách đơn hàng công trình ----------------

type JobFilter = 'ACTIVE' | JobStage | 'ALL';
function JobsModule() {
  const { canDo, role } = useApp();
  const [tab, setTab] = useState<'jobs' | 'commission'>('jobs');
  const finance = canDo('cash.manage') || canDo('receipt.confirm') || role === 'BOD';
  return (
    <div className="space-y-5">
      <Tabs variant="pill" tabs={[{ id: 'jobs', label: 'Đơn hàng' }, { id: 'commission', label: finance ? 'Kế toán: quyết toán hoa hồng' : 'Hoa hồng của tôi' }]} value={tab} onChange={setTab} aside={<DateRangePicker />} />
      {tab === 'jobs' ? <JobsList /> : <CommissionPanel />}
    </div>
  );
}

function JobsList() {
  const { jobs, customers, canDo, openJob, receipts, userName } = useApp();
  const info = useJobInfo();
  const inScope = useJobScope();
  const inR = useInRange();
  const [q, setQ] = useState('');
  const [st, setSt] = useState<JobFilter>('SURVEY');
  const [form, setForm] = useState(false);
  useIntent('job.create', () => setForm(true));
  const nowLocal = toLocal(new Date());
  const t = q.trim().toLowerCase();
  const rows = jobs.filter(inScope).map((j) => ({ j, ...info(j) }));
  const count = (f: JobFilter) => rows.filter((r) => (f === 'ALL' ? true : f === 'ACTIVE' ? !['DONE', 'LOST'].includes(r.stage) : r.stage === f)).length;
  const list = rows
    .filter((r) => (st === 'ALL' || (st === 'ACTIVE' ? !['DONE', 'LOST'].includes(r.stage) : r.stage === st)) && (!['DONE', 'LOST'].includes(r.stage) || inR(r.j.wonAt ?? r.j.lostAt ?? r.j.createdAt)))
    .filter((r) => !t || `${r.j.code} ${r.j.title} ${r.j.siteAddress} ${jobCustName(r.j, customers)} ${jobPhone(r.j, customers)}`.toLowerCase().includes(t))
    .sort((a, b) => (a.stage === 'SURVEY' && b.stage === 'SURVEY' ? (a.j.appointmentAt ?? '').localeCompare(b.j.appointmentAt ?? '') : JOB_STAGES.indexOf(a.stage) - JOB_STAGES.indexOf(b.stage) || b.j.createdAt.localeCompare(a.j.createdAt)));
  const paged = usePaged(list, 20);
  const startIdx = (paged.page - 1) * 20;
  const today = todayISO();
  const holding = receipts.filter((r) => r.status !== 'CONFIRMED' && r.status !== 'REJECTED');
  const pills: { id: JobFilter; label: string; count: number }[] = [
    { id: 'SURVEY', label: 'Chờ khảo sát', count: count('SURVEY') }, { id: 'QUOTED', label: 'Đã báo giá', count: count('QUOTED') },
    { id: 'PRODUCTION', label: 'Sản xuất', count: count('PRODUCTION') }, { id: 'INSTALL', label: 'Lắp đặt', count: count('INSTALL') },
    { id: 'WAIT_PAYMENT', label: 'Chờ thu tiền', count: count('WAIT_PAYMENT') }, { id: 'DONE', label: 'Hoàn tất', count: count('DONE') },
    { id: 'LOST', label: 'Trượt', count: count('LOST') }, { id: 'ACTIVE', label: 'Đang xử lý', count: count('ACTIVE') }, { id: 'ALL', label: 'Tất cả', count: count('ALL') },
  ];
  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Chờ khảo sát" value={String(count('SURVEY'))} icon={Ruler} color={C.blue} sub={`${rows.filter((r) => r.stage === 'SURVEY' && r.j.appointmentAt?.slice(0, 10) === today).length} lịch hẹn hôm nay`} />
        <StatCard label="Đã báo giá, chờ chốt" value={String(count('QUOTED'))} icon={FileText} color="#8B5CF6" sub={compact(rows.filter((r) => r.stage === 'QUOTED').reduce((s, r) => s + (r.j.quotes[r.j.quotes.length - 1]?.total ?? 0), 0))} />
        <StatCard label="Sản xuất & lắp đặt" value={String(count('PRODUCTION') + count('INSTALL'))} icon={Factory} color={C.orange} sub={`${count('PRODUCTION')} sản xuất, ${count('INSTALL')} lắp đặt`} />
        <StatCard label="Còn phải thu" value={compact(rows.filter((r) => r.j.wonAt && !r.j.lostAt).reduce((s, r) => s + r.money.receivable, 0))} icon={Banknote} color={C.red} sub={`${holding.length} phiếu chờ nộp / xác nhận`} />
      </div>
      <Panel>
        <div className="mb-3 flex flex-wrap items-center gap-2">
          <SearchBox value={q} onChange={setQ} placeholder="Tìm tên, số điện thoại, địa chỉ, mã đơn" />
          <button className={cn(btnPrimary, 'max-md:hidden')} disabled={!canDo('job.manage') && !canDo('lead.create')} onClick={() => setForm(true)}><Plus className="h-4 w-4" aria-hidden />Thêm lead</button>
        </div>
        <StagePills items={pills} value={st} onChange={(v) => { setSt(v); paged.setPage(1); }} />
        <div className="mt-3 space-y-2 md:hidden">
          {paged.slice.map(({ j, stage, detail }, i) => (
            <button key={j.id} className="w-full rounded bg-[#1C2534] p-3 text-left" onClick={() => openJob(j.id)}>
              <div className="flex items-start justify-between gap-2"><p className="text-sm font-medium">{startIdx + i + 1}. {jobCustName(j, customers)}</p><Chip tone={JOB_STAGE[stage].tone}>{JOB_STAGE[stage].short}</Chip></div>
              <p className="mt-0.5 text-xs text-[#94A3B8]">{jobPhone(j, customers)}, {j.siteAddress}</p>
              <p className="mt-0.5 text-xs">{j.title}</p>
              <p className={cn('mt-1 text-xs', stage === 'SURVEY' && j.appointmentAt && j.appointmentAt < nowLocal ? 'text-[#F87171]' : 'text-[#F7B23B]')}>{stage === 'SURVEY' ? (j.appointmentAt ? `Hẹn ${fmtDT(j.appointmentAt)}` : 'Chưa hẹn') : detail}</p>
            </button>
          ))}
        </div>
        <div className="mt-3 hidden md:block">
          <Table head={['STT', 'Khách hàng', 'Số điện thoại', 'Địa chỉ', 'Thời gian hẹn', 'Hạng mục', 'Trạng thái']} minW={1040}>
            {paged.slice.map(({ j, stage, detail }, i) => {
              const late = stage === 'SURVEY' && j.appointmentAt && j.appointmentAt < nowLocal;
              return (
                <tr key={j.id} className={cn(rowCls, 'cursor-pointer')} onClick={() => openJob(j.id)}>
                  <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{startIdx + i + 1}</td>
                  <td className={tdCls}><p className="font-medium text-[#F1F5F9]">{jobCustName(j, customers)}</p><p className="text-xs text-[#94A3B8]">{j.code}{j.ownerId ? `, ${userName(j.ownerId)}` : ''}</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap tabular-nums')}>{jobPhone(j, customers)}</td>
                  <td className={cn(tdCls, 'max-w-[240px]')}><p className="line-clamp-2 text-xs">{j.siteAddress}</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-xs tabular-nums', late && 'text-[#F87171]')}>{j.appointmentAt ? fmtDT(j.appointmentAt) : '—'}{late && <p className="text-[11px]">Quá hẹn</p>}</td>
                  <td className={cn(tdCls, 'max-w-[220px]')}><p className="line-clamp-2 text-xs">{j.title}</p></td>
                  <td className={tdLast}><div className="flex items-start justify-between gap-2"><div><Chip tone={JOB_STAGE[stage].tone}>{JOB_STAGE[stage].label}</Chip><p className="mt-1 text-[11px] text-[#94A3B8]">{stage === 'SURVEY' ? '' : detail}</p></div><span onClick={(e) => e.stopPropagation()}><CommentButton entity="job" entityId={j.id} title={`${j.code} · ${jobCustName(j, customers)}`} module="jobs" /></span></div></td>
                </tr>
              );
            })}
          </Table>
        </div>
        {!list.length && <EmptyState text={<>Không có đơn ở trạng thái này.</>} art="box" />}
        <Pagination paged={paged} unit="đơn" />
      </Panel>
      <Fab label="Thêm lead" onClick={() => setForm(true)} disabled={!canDo('job.manage') && !canDo('lead.create')} />
      {form && <MfgLeadForm onClose={() => setForm(false)} />}
    </div>
  );
}

// ---------------- Phân lead (mô hình xưởng): 2 bước + danh sách chăm sóc ----------------

function MfgLeadsPage() {
  const { jobs, customers, sources, userName, openJob, canDo, receipts, workOrders, installJobs } = useApp();
  const inR = useInRange();
  const inScope = useJobScope();
  const [tab, setTab] = useState<'new' | 'care'>('new');
  const [q, setQ] = useState('');
  const [form, setForm] = useState(false);
  useIntent('job.create', () => setForm(true));
  const [careFor, setCareFor] = useState<Job | null>(null);
  const t = q.trim().toLowerCase();
  const today = todayISO();
  const rows = jobs.filter(inScope).map((j) => ({ j, stage: jobStageOf(j, workOrders, installJobs, receipts), cust: customers.find((c) => c.id === j.customerId) }));
  const match = (r: (typeof rows)[number]) => !t || `${jobCustName(r.j, customers)} ${jobPhone(r.j, customers)} ${r.j.siteAddress} ${r.j.title}`.toLowerCase().includes(t);
  const fresh = rows.filter((r) => inR(r.j.createdAt) || r.stage === 'SURVEY');
  const newList = fresh.filter(match).sort((a, b) => b.j.createdAt.localeCompare(a.j.createdAt) || b.j.code.localeCompare(a.j.code));
  const careRows = rows.filter((r) => needsCare(r.stage)).map((r) => {
    const logs = [...(r.j.care ?? [])].sort((a, b) => b.at - a.at);
    const lastQ = r.j.quotes[r.j.quotes.length - 1];
    const days = lastQ ? Math.floor((Date.now() - Date.parse(lastQ.at)) / 864e5) : 0;
    return { ...r, last: logs[0], next: logs[0]?.nextAt, lastQ, days };
  });
  const careList = careRows.filter(match).sort((a, b) => (a.next ?? '0').localeCompare(b.next ?? '0'));
  const won = rows.filter((r) => r.j.wonAt && inR(r.j.wonAt)).length;
  const quotedIn = rows.filter((r) => r.j.quotes.length && inR(r.j.quotes[0].at)).length;
  const pagedNew = usePaged(newList, 20);
  const pagedCare = usePaged(careList, 20);
  const srcName = (id?: string) => sources.find((s) => s.id === id)?.name ?? '—';
  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Lead mới trong kỳ" value={String(rows.filter((r) => inR(r.j.createdAt)).length)} icon={Inbox} color="#8B5CF6" />
        <StatCard label="Đang chờ khảo sát" value={String(rows.filter((r) => r.stage === 'SURVEY').length)} icon={Ruler} color={C.blue} sub={`${rows.filter((r) => r.stage === 'SURVEY' && r.j.appointmentAt?.slice(0, 10) === today).length} lịch hẹn hôm nay`} />
        <StatCard label="Cần chăm sóc" value={String(careRows.length)} icon={MessageSquare} color={C.orange} sub={`${careRows.filter((r) => r.next && r.next <= today).length} đến hẹn chăm sóc`} />
        <StatCard label="Tỷ lệ chốt (kỳ)" value={pct(won, quotedIn)} icon={Target} color={C.teal} sub={`${won} chốt / ${quotedIn} báo giá`} />
      </div>
      <div className="flex flex-wrap items-center gap-3 rounded-md border border-[#263044] bg-[#151C29] px-4 py-3 text-sm text-[#94A3B8]">
        <span className="flex items-center gap-2"><span className="flex h-6 w-6 items-center justify-center rounded-full bg-[#F28C33] text-xs font-bold text-[#0F141E]">1</span>Thêm lead: tên, SĐT, địa chỉ, hạng mục, giờ hẹn</span>
        <ArrowRight className="h-4 w-4 max-sm:hidden" aria-hidden />
        <span className="flex items-center gap-2"><span className="flex h-6 w-6 items-center justify-center rounded-full bg-[#00B894] text-xs font-bold text-[#0F141E]">2</span>Tự chuyển "Đang chờ khảo sát", kỹ thuật nhận lịch</span>
      </div>
      <Panel>
        <div className="mb-3 flex flex-wrap items-center gap-2">
          <Tabs variant="pill" tabs={[{ id: 'new', label: 'Lead & lịch khảo sát', count: newList.length }, { id: 'care', label: 'Cần theo dõi, chăm sóc', count: careRows.length }]} value={tab} onChange={setTab} />
          <SearchBox value={q} onChange={setQ} placeholder="Tìm tên, SĐT, địa chỉ" />
          <div className="ml-auto hidden lg:block"><DateRangePicker /></div><button className={cn(btnPrimary, 'max-md:hidden')} disabled={!canDo('job.manage') && !canDo('lead.create')} onClick={() => setForm(true)}><Plus className="h-4 w-4" aria-hidden />Thêm lead</button>
        </div>
        {tab === 'new' ? (
          <>
            <Table head={['STT', 'Khách hàng', 'Số điện thoại', 'Địa chỉ', 'Hạng mục', 'Thời gian hẹn', 'Kỹ thuật', 'Trạng thái']} minW={1080}>
              {pagedNew.slice.map((r, i) => (
                <tr key={r.j.id} className={cn(rowCls, 'cursor-pointer')} onClick={() => openJob(r.j.id)}>
                  <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{(pagedNew.page - 1) * 20 + i + 1}</td>
                  <td className={tdCls}><p className="font-medium">{jobCustName(r.j, customers)}</p><p className="text-xs text-[#94A3B8]">{srcName(r.cust?.sourceId)}</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap tabular-nums')}>{jobPhone(r.j, customers)}</td>
                  <td className={cn(tdCls, 'max-w-[220px]')}><p className="line-clamp-2 text-xs">{r.j.siteAddress}</p></td>
                  <td className={cn(tdCls, 'max-w-[200px]')}><p className="line-clamp-2 text-xs">{r.j.title}</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-xs tabular-nums')}>{r.j.appointmentAt ? fmtDT(r.j.appointmentAt) : '—'}</td>
                  <td className={cn(tdCls, 'text-xs')}>{userName(r.j.ownerId)}</td>
                  <td className={tdLast}><Chip tone={JOB_STAGE[r.stage].tone}>{JOB_STAGE[r.stage].short}</Chip></td>
                </tr>
              ))}
            </Table>
            {!newList.length && <EmptyState text={<>Chưa có lead nào</>} hint={<>Lead mới từ MKT hoặc do kỹ thuật tự nhập sẽ hiện ở đây kèm lịch khảo sát.</>} art="inbox" action="Tạo lead ngay" onAction={() => setForm(true)} />}
            <Pagination paged={pagedNew} unit="lead" />
          </>
        ) : (
          <>
            <Table head={['STT', 'Khách hàng', 'Số điện thoại', 'Hạng mục', 'Báo giá', 'Tình trạng', 'Chăm sóc gần nhất', 'Hẹn lại', '']} minW={1120}>
              {pagedCare.slice.map((r, i) => (
                <tr key={r.j.id} className={rowCls}>
                  <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{(pagedCare.page - 1) * 20 + i + 1}</td>
                  <td className={tdCls}><button className="text-left font-medium hover:text-[#F7B23B]" onClick={() => openJob(r.j.id)}>{jobCustName(r.j, customers)}</button><p className="text-xs text-[#94A3B8]">{r.j.code}</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap tabular-nums')}>{jobPhone(r.j, customers)}</td>
                  <td className={cn(tdCls, 'max-w-[200px]')}><p className="line-clamp-2 text-xs">{r.j.title}</p></td>
                  <td className={cn(tdCls, 'text-right tabular-nums whitespace-nowrap')}>{r.lastQ ? compact(r.lastQ.total) : '—'}</td>
                  <td className={cn(tdCls, 'text-xs')}>{r.stage === 'LOST' ? <span className="text-[#F87171]">Trượt: {JOB_LOST[r.j.lostReason ?? 'OTHER']}</span> : <span className={r.days > 7 ? 'text-[#F7B23B]' : ''}>Báo giá {r.days} ngày chưa chốt</span>}</td>
                  <td className={cn(tdCls, 'max-w-[220px] text-xs')}>{r.last ? <><p className="line-clamp-2">{r.last.note}</p><p className="text-[#94A3B8]">{new Date(r.last.at).toLocaleDateString('vi-VN')}</p></> : <span className="text-[#94A3B8]">Chưa chăm sóc</span>}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-xs tabular-nums', r.next && r.next <= today && 'text-[#F87171]')}>{r.next ? fmtDate(r.next) : '—'}</td>
                  <td className={tdLast}><button className={cn(btnGhost, btnSm, 'whitespace-nowrap')} onClick={() => setCareFor(r.j)}><MessageSquare className="h-3.5 w-3.5" aria-hidden />Chăm sóc</button></td>
                </tr>
              ))}
            </Table>
            {!careList.length && <EmptyState text={<>Không có khách cần chăm sóc.</>} art="box" />}
            <Pagination paged={pagedCare} unit="khách" />
          </>
        )}
      </Panel>
      <Fab label="Thêm lead" onClick={() => setForm(true)} disabled={!canDo('job.manage') && !canDo('lead.create')} />
      {form && <MfgLeadForm onClose={() => setForm(false)} />}
      {careFor && <CareModal job={careFor} onClose={() => setCareFor(null)} />}
    </div>
  );
}

// =====================================================================
//  PHÂN HỆ: NHẬP XUẤT TỒN (kho vật tư xưởng)
//  Phiếu nhập (NCC) / xuất (cho lệnh sản xuất, đơn hàng) / kiểm kê; tồn theo giá bình quân
// =====================================================================

type VoucherLine = { key: string; itemId: string; qty: number; unitCost: number; actual?: number };
function StockVoucherModal({ type, preset, onClose }: { type: InvMoveType; preset?: { woId?: string; jobId?: string }; onClose: () => void }) {
  const { me, stockItems, setStockItems, stockMoves, setStockMoves, postCash, workOrders, jobs, customers, notify, audit, canDo } = useApp();
  const items = stockItems.filter((s) => s.active);
  const [date, setDate] = useState(todayISO());
  const [partner, setPartner] = useState('');
  const [woId, setWoId] = useState(preset?.woId ?? '');
  const [note, setNote] = useState('');
  const [paid, setPaid] = useState<'' | CashAccount>('');
  const [lines, setLines] = useState<VoucherLine[]>([{ key: uid('vl'), itemId: '', qty: 0, unitCost: 0 }]);
  const wo = workOrders.find((w) => w.id === woId);
  const jobId = wo?.jobId ?? preset?.jobId;
  const bal = (id: string) => stockOf(id, stockMoves);
  const setLine = (k: string, p: Partial<VoucherLine>) => setLines((ls) => ls.map((l) => (l.key === k ? { ...l, ...p } : l)));
  const pick = (k: string, id: string) => { const it = stockItems.find((s) => s.id === id); const b = bal(id); setLine(k, { itemId: id, unitCost: type === 'IN' ? it?.cost ?? 0 : Math.round(b.avg || it?.cost || 0), actual: type === 'ADJUST' ? b.qty : undefined }); };
  const valid = lines.filter((l) => l.itemId && (type === 'ADJUST' ? l.actual !== undefined : l.qty > 0));
  const total = valid.reduce((s, l) => s + (type === 'ADJUST' ? ((l.actual ?? 0) - bal(l.itemId).qty) * l.unitCost : l.qty * l.unitCost), 0);
  const save = () => {
    if (!valid.length) return notify('Chọn vật tư và nhập số lượng', 'red');
    if (type === 'OUT') {
      const over = valid.find((l) => l.qty > bal(l.itemId).qty);
      if (over) return notify(`Không đủ tồn: ${stockItems.find((s) => s.id === over.itemId)?.name} còn ${bal(over.itemId).qty}`, 'red');
    }
    if (type === 'IN' && partner.trim().length < 2) return notify('Nhập nhà cung cấp', 'red');
    const year = date.slice(0, 4);
    const code = nextCode(stockMoves.filter((m) => m.type === type).map((m) => m.code), `${STOCK_MOVE[type].prefix}-${year}-`, 4);
    const at = Date.now();
    const moves: InvMove[] = valid.map((l) => ({
      id: uid('sm'), code, type, date, itemId: l.itemId, qty: type === 'ADJUST' ? Math.round(((l.actual ?? 0) - bal(l.itemId).qty) * 1000) / 1000 : l.qty, unitCost: l.unitCost,
      partner: partner.trim() || undefined, woId: type === 'OUT' ? woId || undefined : undefined, jobId: type === 'OUT' ? jobId : undefined, note: note.trim() || undefined, by: me.id, at,
    })).filter((m) => m.qty !== 0);
    if (!moves.length) return notify('Số kiểm kê khớp tồn sổ sách, không cần điều chỉnh', 'orange');
    setStockMoves((p) => [...moves, ...p]);
    if (type === 'IN') {
      // Cập nhật giá nhập gần nhất vào danh mục
      const last = new Map(valid.map((l) => [l.itemId, l.unitCost]));
      setStockItems((all) => all.map((x) => (last.has(x.id) ? { ...x, cost: last.get(x.id) ?? x.cost } : x)));
      if (paid && canDo('cash.manage')) postCash({ kind: 'OUT', date, account: paid, category: 'Vật tư, nguyên liệu', amount: Math.round(total), partner: partner.trim(), ref: code, note: `Thanh toán ${code}`, source: 'STOCK', sourceId: code });
    }
    audit('STOCK_' + type, `${code}: ${moves.length} dòng, ${vnd(Math.abs(total))}`);
    notify(`Đã lập ${STOCK_MOVE[type].label.toLowerCase()} ${code}${paid && type === 'IN' ? ', kèm phiếu chi' : ''}`, 'teal');
    onClose();
  };
  const activeWo = workOrders.filter((w) => w.stage !== 'DONE' || w.id === woId);
  return (
    <Modal title={type === 'IN' ? 'Phiếu nhập kho' : type === 'OUT' ? 'Phiếu xuất kho' : 'Phiếu kiểm kê'} onClose={onClose} wide
      footer={<><span className="mr-auto self-center text-sm text-[#94A3B8]">{type === 'ADJUST' ? 'Chênh lệch' : 'Giá trị'} <b className="tabular-nums text-[#F1F5F9]">{vnd(total)}</b></span><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Lưu phiếu</button></>}>
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <Field label="Ngày"><input className={inputCls} type="date" value={date} onChange={(e) => setDate(e.target.value)} /></Field>
        {type === 'IN' && <Field label="Nhà cung cấp *"><input className={inputCls} value={partner} onChange={(e) => setPartner(e.target.value)} placeholder="VD: Nhôm Xingfa Quảng Đông" /></Field>}
        {type === 'OUT' && (
          <Field label="Xuất cho lệnh sản xuất">
            <select className={inputCls} value={woId} onChange={(e) => setWoId(e.target.value)}>
              <option value="">Không gắn lệnh (bảo hành, dùng chung)</option>
              {activeWo.map((w) => { const j = jobs.find((x) => x.id === w.jobId); return <option key={w.id} value={w.id}>{w.code}: {j ? jobCustName(j, customers) : w.title}</option>; })}
            </select>
          </Field>
        )}
        {type === 'ADJUST' && <Field label="Người kiểm kê"><input className={inputCls} value={partner} onChange={(e) => setPartner(e.target.value)} placeholder={me.name} /></Field>}
      </div>
      <div className="mt-4">
        <div className="mb-1.5 hidden grid-cols-[1fr_96px_120px_32px] gap-2 px-1 text-xs text-[#94A3B8] sm:grid">
          <span>Vật tư</span><span className="text-right">{type === 'ADJUST' ? 'Tồn thực tế' : 'Số lượng'}</span><span className="text-right">{type === 'IN' ? 'Đơn giá nhập' : 'Giá bình quân'}</span><span />
        </div>
        <ul className="space-y-2">
          {lines.map((l) => {
            const it = stockItems.find((s) => s.id === l.itemId);
            const b = l.itemId ? bal(l.itemId) : null;
            return (
              <li key={l.key} className="rounded bg-[#1C2534] p-2 sm:bg-transparent sm:p-0">
                <div className="grid grid-cols-2 gap-2 sm:grid-cols-[1fr_96px_120px_32px] sm:items-center">
                  <select className={cn(inputCls, 'col-span-2 py-1.5 text-sm sm:col-span-1')} value={l.itemId} onChange={(e) => pick(l.key, e.target.value)} aria-label="Vật tư">
                    <option value="">Chọn vật tư...</option>
                    {Array.from(new Set(items.map((s) => s.category))).map((c) => <optgroup key={c} label={c}>{items.filter((s) => s.category === c).map((s) => <option key={s.id} value={s.id}>{s.code}: {s.name}</option>)}</optgroup>)}
                  </select>
                  {type === 'ADJUST'
                    ? <input className={cn(inputCls, 'py-1.5 text-right text-sm tabular-nums')} type="number" min={0} step="any" value={l.actual ?? ''} onChange={(e) => setLine(l.key, { actual: Number(e.target.value) })} aria-label="Tồn thực tế" />
                    : <input className={cn(inputCls, 'py-1.5 text-right text-sm tabular-nums')} type="number" min={0} step="any" value={l.qty || ''} onChange={(e) => setLine(l.key, { qty: Number(e.target.value) })} aria-label="Số lượng" />}
                  <input className={cn(inputCls, 'py-1.5 text-right text-sm tabular-nums')} inputMode="numeric" disabled={type === 'OUT'} value={l.unitCost ? l.unitCost.toLocaleString('vi-VN') : ''} onChange={(e) => setLine(l.key, { unitCost: digits(e.target.value) })} aria-label="Đơn giá" />
                  <button className="flex justify-center text-[#94A3B8] hover:text-[#F87171] disabled:opacity-30" disabled={lines.length <= 1} onClick={() => setLines((ls) => ls.filter((x) => x.key !== l.key))} aria-label="Xóa dòng"><Trash2 className="h-4 w-4" /></button>
                </div>
                {b && <p className="mt-1 px-1 text-[11px] text-[#94A3B8]">Tồn sổ sách {b.qty.toLocaleString('vi-VN')} {it?.unit}{type === 'ADJUST' && l.actual !== undefined ? `, chênh lệch ${(Math.round((l.actual - b.qty) * 1000) / 1000).toLocaleString('vi-VN')}` : ''}{type === 'OUT' && l.qty > b.qty ? ' — không đủ tồn' : ''}</p>}
              </li>
            );
          })}
        </ul>
        <button className={cn(btnGhost, btnSm, 'mt-2')} onClick={() => setLines((ls) => [...ls, { key: uid('vl'), itemId: '', qty: 0, unitCost: 0 }])}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm dòng</button>
      </div>
      <div className="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <Field label="Ghi chú"><input className={inputCls} value={note} onChange={(e) => setNote(e.target.value)} /></Field>
        {type === 'IN' && canDo('cash.manage') && (
          <Field label="Thanh toán ngay cho NCC">
            <select className={inputCls} value={paid} onChange={(e) => setPaid(e.target.value as '' | CashAccount)}><option value="">Chưa thanh toán (ghi công nợ NCC)</option><option value="CASH">Đã trả, lập phiếu chi tiền mặt</option><option value="BANK">Đã trả, lập phiếu chi ngân hàng</option></select>
          </Field>
        )}
      </div>
    </Modal>
  );
}

function StockItemModal({ item, onClose }: { item?: StockItem; onClose: () => void }) {
  const { stockItems, setStockItems, notify } = useApp();
  const [f, setF] = useState<StockItem>(item ?? { id: uid('si'), code: '', name: '', category: '', unit: '', minStock: 0, cost: 0, active: true });
  const cats = Array.from(new Set(stockItems.map((s) => s.category)));
  const save = () => {
    if (f.code.trim().length < 2 || f.name.trim().length < 3 || !f.unit.trim()) return notify('Nhập mã, tên và đơn vị tính', 'red');
    if (stockItems.some((s) => s.id !== f.id && s.code.toUpperCase() === f.code.trim().toUpperCase())) return notify('Mã vật tư đã tồn tại', 'red');
    const x = { ...f, code: f.code.trim().toUpperCase(), name: f.name.trim(), category: f.category.trim() || 'Khác', unit: f.unit.trim() };
    setStockItems((all) => (all.some((s) => s.id === x.id) ? all.map((s) => (s.id === x.id ? x : s)) : [...all, x]));
    notify(`Đã lưu ${x.code}`, 'teal');
    onClose();
  };
  return (
    <Modal title={item ? `Sửa ${item.code}` : 'Thêm vật tư'} onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Lưu</button></>}>
      <div className="grid grid-cols-2 gap-3">
        <Field label="Mã *"><input className={inputCls} value={f.code} onChange={(e) => setF({ ...f, code: e.target.value })} placeholder="NH-XF55" /></Field>
        <Field label="Nhóm"><input className={inputCls} list="si-cats" value={f.category} onChange={(e) => setF({ ...f, category: e.target.value })} /><datalist id="si-cats">{cats.map((c) => <option key={c} value={c} />)}</datalist></Field>
        <Field label="Tên vật tư *" className="col-span-2"><input className={inputCls} value={f.name} onChange={(e) => setF({ ...f, name: e.target.value })} /></Field>
        <Field label="Đơn vị tính *"><input className={inputCls} value={f.unit} onChange={(e) => setF({ ...f, unit: e.target.value })} placeholder="cây, m², tấm..." /></Field>
        <Field label="Tồn tối thiểu"><input className={inputCls} type="number" min={0} value={f.minStock} onChange={(e) => setF({ ...f, minStock: Math.max(0, Number(e.target.value) || 0) })} /></Field>
        <Field label="Giá nhập tham khảo" className="col-span-2"><MoneyInput value={f.cost} onChange={(n) => setF({ ...f, cost: n })} /></Field>
      </div>
    </Modal>
  );
}

function InventoryModule() {
  const { stockItems, setStockItems, stockMoves, setStockMoves, range, canDo, userName, jobs, workOrders, customers } = useApp();
  const [tab, setTab] = useState<'stock' | 'moves' | 'report' | 'items'>('stock');
  const [q, setQ] = useState('');
  const [voucher, setVoucher] = useState<InvMoveType | null>(null);
  const [edit, setEdit] = useState<StockItem | null | 'new'>(null);
  const [view, setView] = useState<string | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const can = canDo('stock.manage');
  const { start, end } = rangeBounds(range);
  const fromISO = iso(new Date(start)), toISO = iso(new Date(end));
  const prevDay = iso(new Date(start - 864e5));
  const t = q.trim().toLowerCase();
  const match = (s: StockItem) => !t || `${s.code} ${s.name} ${s.category}`.toLowerCase().includes(t);
  const balances = stockItems.map((s) => ({ s, ...stockOf(s.id, stockMoves) }));
  const low = balances.filter((b) => b.s.active && b.qty < b.s.minStock);
  const inPeriod = stockMoves.filter((m) => m.date >= fromISO && m.date <= toISO);
  const val = (ms: InvMove[], tp: InvMoveType) => ms.filter((m) => m.type === tp).reduce((s, m) => s + m.qty * m.unitCost, 0);
  const vouchers = Array.from(new Set(stockMoves.map((m) => m.code))).map((code) => {
    const ms = stockMoves.filter((m) => m.code === code);
    return { code, ms, first: ms[0], value: ms.reduce((s, m) => s + m.qty * m.unitCost, 0) };
  }).filter((v) => v.first.date >= fromISO && v.first.date <= toISO && (!t || `${v.code} ${v.first.partner ?? ''}`.toLowerCase().includes(t))).sort((a, b) => b.first.date.localeCompare(a.first.date) || b.code.localeCompare(a.code));
  const report = stockItems.filter(match).map((s) => {
    const open = stockOf(s.id, stockMoves, prevDay);
    const ms = inPeriod.filter((m) => m.itemId === s.id);
    const inQ = ms.filter((m) => m.type === 'IN' || (m.type === 'ADJUST' && m.qty > 0)).reduce((x, m) => x + Math.abs(m.qty), 0);
    const inV = ms.filter((m) => m.type === 'IN' || (m.type === 'ADJUST' && m.qty > 0)).reduce((x, m) => x + Math.abs(m.qty) * m.unitCost, 0);
    const outQ = ms.filter((m) => m.type === 'OUT' || (m.type === 'ADJUST' && m.qty < 0)).reduce((x, m) => x + Math.abs(m.qty), 0);
    const outV = ms.filter((m) => m.type === 'OUT' || (m.type === 'ADJUST' && m.qty < 0)).reduce((x, m) => x + Math.abs(m.qty) * m.unitCost, 0);
    const close = stockOf(s.id, stockMoves, toISO);
    return { s, open, inQ, inV, outQ, outV, close };
  }).filter((r) => r.open.qty || r.inQ || r.outQ || r.close.qty);
  const pagedStock = usePaged(balances.filter((b) => match(b.s)), 20);
  const pagedV = usePaged(vouchers, 20);
  const n = (x: number) => x.toLocaleString('vi-VN', { maximumFractionDigits: 2 });
  const viewV = vouchers.find((v) => v.code === view) ?? (view ? { code: view, ms: stockMoves.filter((m) => m.code === view), first: stockMoves.find((m) => m.code === view)!, value: 0 } : null);
  const target = (m: InvMove) => { const w = workOrders.find((x) => x.id === m.woId); const j = jobs.find((x) => x.id === (m.jobId ?? w?.jobId)); return j ? `${w?.code ?? j.code}: ${jobCustName(j, customers)}` : m.partner ?? ''; };
  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Giá trị tồn kho" value={compact(balances.reduce((s, b) => s + b.value, 0))} icon={Warehouse} color={C.blue} sub={`${balances.filter((b) => b.qty > 0).length} mặt hàng còn tồn`} />
        <StatCard label="Dưới tồn tối thiểu" value={String(low.length)} icon={AlertTriangle} color={low.length ? C.red : C.teal} sub={low.slice(0, 2).map((b) => b.s.name).join(', ') || 'Đủ hàng'} />
        <StatCard label="Nhập trong kỳ" value={compact(val(inPeriod, 'IN'))} icon={ArrowDown} color={C.teal} sub={`${new Set(inPeriod.filter((m) => m.type === 'IN').map((m) => m.code)).size} phiếu nhập`} />
        <StatCard label="Xuất trong kỳ" value={compact(val(inPeriod, 'OUT'))} icon={ArrowUp} color={C.orange} sub={`${new Set(inPeriod.filter((m) => m.type === 'OUT').map((m) => m.code)).size} phiếu xuất`} />
      </div>
      <div className="flex flex-wrap items-center gap-2">
        <Tabs variant="pill" tabs={[{ id: 'stock', label: 'Tồn kho' }, { id: 'moves', label: 'Phiếu nhập / xuất' }, { id: 'report', label: 'Báo cáo nhập xuất tồn' }, { id: 'items', label: 'Danh mục vật tư' }]} value={tab} onChange={setTab} />
        <div className="ml-auto flex flex-wrap items-center gap-2"><div className="hidden lg:block"><DateRangePicker /></div>
          <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E]')} disabled={!can} onClick={() => setVoucher('IN')}><ArrowDown className="h-3.5 w-3.5" aria-hidden />Nhập kho</button>
          <button className={cn(btnPrimary, btnSm)} disabled={!can} onClick={() => setVoucher('OUT')}><ArrowUp className="h-3.5 w-3.5" aria-hidden />Xuất kho</button>
          <button className={cn(btnGhost, btnSm)} disabled={!can} onClick={() => setVoucher('ADJUST')}><ClipboardCheck className="h-3.5 w-3.5" aria-hidden />Kiểm kê</button>
        </div>
      </div>
      <Panel>
        <div className="mb-3 flex flex-wrap items-center gap-2">
          <SearchBox value={q} onChange={setQ} placeholder={tab === 'moves' ? 'Tìm số phiếu, nhà cung cấp' : 'Tìm mã, tên vật tư'} />
          {tab === 'report' && <button className={cn(btnGhost, btnSm)} onClick={() => downloadCsv(`nhap-xuat-ton-${fromISO}-${toISO}.csv`, [['Mã', 'Tên', 'ĐVT', 'Tồn đầu SL', 'Tồn đầu GT', 'Nhập SL', 'Nhập GT', 'Xuất SL', 'Xuất GT', 'Tồn cuối SL', 'Tồn cuối GT'], ...report.map((r) => [r.s.code, r.s.name, r.s.unit, r.open.qty, r.open.value, r.inQ, Math.round(r.inV), r.outQ, Math.round(r.outV), r.close.qty, r.close.value])])}><Download className="h-3.5 w-3.5" aria-hidden />Xuất CSV</button>}
          {tab === 'items' && <button className={cn(btnPrimary, btnSm)} disabled={!can} onClick={() => setEdit('new')}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm vật tư</button>}
        </div>

        {tab === 'stock' && (
          <>
            <Table head={['STT', 'Mã', 'Tên vật tư', 'ĐVT', 'Tồn', 'Giá bình quân', 'Giá trị', 'Tối thiểu']} minW={900}>
              {pagedStock.slice.map((b, i) => (
                <tr key={b.s.id} className={cn(rowCls, !b.s.active && 'opacity-50')}>
                  <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{(pagedStock.page - 1) * 20 + i + 1}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap font-mono text-xs')}>{b.s.code}</td>
                  <td className={tdCls}>{b.s.name}<p className="text-xs text-[#94A3B8]">{b.s.category}</p></td>
                  <td className={cn(tdCls, 'text-xs')}>{b.s.unit}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums font-semibold', b.qty < b.s.minStock && 'text-[#F87171]')}>{n(b.qty)}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-xs')}>{b.avg ? vnd(b.avg) : '—'}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(b.value)}</td>
                  <td className={cn(tdLast, 'tabular-nums text-xs text-[#94A3B8]')}>{n(b.s.minStock)}{b.qty < b.s.minStock && <Chip tone="red">Cần nhập</Chip>}</td>
                </tr>
              ))}
            </Table>
            <Pagination paged={pagedStock} unit="vật tư" />
          </>
        )}

        {tab === 'moves' && (
          <>
            <Table head={['STT', 'Số phiếu', 'Ngày', 'Loại', 'Đối tượng', 'Số dòng', 'Giá trị', 'Người lập']} minW={900}>
              {pagedV.slice.map((v, i) => (
                <tr key={v.code} className={cn(rowCls, 'cursor-pointer')} onClick={() => setView(v.code)}>
                  <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{(pagedV.page - 1) * 20 + i + 1}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap font-mono text-xs text-[#F7B23B]')}>{v.code}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-xs')}>{fmtDate(v.first.date)}</td>
                  <td className={tdCls}><Chip tone={STOCK_MOVE[v.first.type].tone}>{STOCK_MOVE[v.first.type].label}</Chip></td>
                  <td className={cn(tdCls, 'max-w-[240px] text-xs')}><p className="line-clamp-2">{target(v.first) || '—'}</p></td>
                  <td className={cn(tdCls, 'tabular-nums')}>{v.ms.length}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(Math.abs(v.value))}</td>
                  <td className={cn(tdLast, 'text-xs')}>{userName(v.first.by)}</td>
                </tr>
              ))}
            </Table>
            {!vouchers.length && <EmptyState text={<>Chưa có phiếu trong kỳ.</>} art="ledger" />}
            <Pagination paged={pagedV} unit="phiếu" />
          </>
        )}

        {tab === 'report' && (
          <>
            <p className="mb-2 text-xs text-[#94A3B8]">Kỳ {fmtDate(fromISO)} – {fmtDate(toISO)} (đổi kỳ ở bộ chọn thời gian trên cùng). Giá trị tính theo giá bình quân gia quyền.</p>
            <Table head={['STT', 'Vật tư', 'ĐVT', 'Tồn đầu kỳ', 'Nhập trong kỳ', 'Xuất trong kỳ', 'Tồn cuối kỳ', 'Giá trị cuối kỳ']} minW={980}>
              {report.map((r, i) => (
                <tr key={r.s.id} className={rowCls}>
                  <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{i + 1}</td>
                  <td className={tdCls}>{r.s.name}<p className="font-mono text-[11px] text-[#94A3B8]">{r.s.code}</p></td>
                  <td className={cn(tdCls, 'text-xs')}>{r.s.unit}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{n(r.open.qty)}<p className="text-[11px] text-[#94A3B8]">{compact(r.open.value)}</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-[#3DDBB6]')}>{n(r.inQ)}<p className="text-[11px] text-[#94A3B8]">{compact(r.inV)}</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-[#F7B23B]')}>{n(r.outQ)}<p className="text-[11px] text-[#94A3B8]">{compact(r.outV)}</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums font-semibold')}>{n(r.close.qty)}</td>
                  <td className={cn(tdLast, 'whitespace-nowrap text-right tabular-nums')}>{compact(r.close.value)}</td>
                </tr>
              ))}
              {report.length > 0 && (
                <tr className="border-t border-[#263044] font-semibold">
                  <td className={tdFirst} /><td className={tdCls}>Cộng</td><td className={tdCls} />
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(report.reduce((s, r) => s + r.open.value, 0))}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(report.reduce((s, r) => s + r.inV, 0))}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(report.reduce((s, r) => s + r.outV, 0))}</td>
                  <td className={tdCls} />
                  <td className={cn(tdLast, 'whitespace-nowrap text-right tabular-nums')}>{compact(report.reduce((s, r) => s + r.close.value, 0))}</td>
                </tr>
              )}
            </Table>
            {!report.length && <EmptyState text={<>Không có phát sinh trong kỳ.</>} art="ledger" />}
          </>
        )}

        {tab === 'items' && (
          <Table head={['STT', 'Mã', 'Tên vật tư', 'Nhóm', 'ĐVT', 'Giá nhập tham khảo', 'Tối thiểu', '']} minW={900}>
            {stockItems.filter(match).map((s, i) => (
              <tr key={s.id} className={cn(rowCls, !s.active && 'opacity-50')}>
                <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{i + 1}</td>
                <td className={cn(tdCls, 'whitespace-nowrap font-mono text-xs')}>{s.code}</td>
                <td className={tdCls}>{s.name}</td>
                <td className={cn(tdCls, 'text-xs')}>{s.category}</td>
                <td className={cn(tdCls, 'text-xs')}>{s.unit}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{vnd(s.cost)}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{n(s.minStock)}</td>
                <td className={tdLast}><span className="flex justify-end gap-1.5">
                  <button className={cn(btnGhost, btnSm)} disabled={!can} onClick={() => setEdit(s)} aria-label={`Sửa ${s.code}`}><Pencil className="h-3.5 w-3.5" aria-hidden /></button>
                  <button className={cn(btnGhost, btnSm, 'whitespace-nowrap')} disabled={!can} onClick={() => setStockItems((all) => all.map((x) => (x.id === s.id ? { ...x, active: !x.active } : x)))}>{s.active ? 'Ngừng' : 'Dùng lại'}</button>
                </span></td>
              </tr>
            ))}
          </Table>
        )}
      </Panel>
      {voucher && <StockVoucherModal type={voucher} onClose={() => setVoucher(null)} />}
      {edit && <StockItemModal item={edit === 'new' ? undefined : edit} onClose={() => setEdit(null)} />}
      {viewV && viewV.first && (
        <Modal title={`${STOCK_MOVE[viewV.first.type].label} ${viewV.code}`} onClose={() => setView(null)}
          footer={<><button className={cn(btnGhost, 'mr-auto hover:text-[#F87171]')} disabled={!can} onClick={() => setConfirm({ title: `Xóa phiếu ${viewV.code}`, message: 'Xóa phiếu sẽ tính lại tồn kho. Phiếu chi đã lập (nếu có) giữ nguyên, xóa riêng ở Thu chi.', onConfirm: () => { setStockMoves((p) => p.filter((m) => m.code !== viewV.code)); setView(null); } })}><Trash2 className="h-4 w-4" aria-hidden />Xóa phiếu</button><button className={btnGhost} onClick={() => setView(null)}>Đóng</button></>}>
          <p className="mb-3 text-sm text-[#94A3B8]">Ngày {fmtDate(viewV.first.date)}, {userName(viewV.first.by)}{target(viewV.first) ? `, ${target(viewV.first)}` : ''}{viewV.first.note ? `. ${viewV.first.note}` : ''}</p>
          <ul className="space-y-1.5">
            {viewV.ms.map((m) => { const it = stockItems.find((s) => s.id === m.itemId); return <li key={m.id} className="grid grid-cols-[1fr_auto_auto] gap-3 rounded bg-[#1C2534] px-3 py-2 text-sm"><span>{it?.name ?? m.itemId}</span><span className="tabular-nums">{n(m.qty)} {it?.unit}</span><span className="tabular-nums text-[#94A3B8]">{compact(Math.abs(m.qty * m.unitCost))}</span></li>; })}
          </ul>
        </Modal>
      )}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

// =====================================================================
//  PHÂN HỆ: THU CHI (sổ quỹ tiền mặt & ngân hàng)
//  Tiền thu khách hàng lấy tự động từ phiếu thu đơn hàng đã được kế toán xác nhận
// =====================================================================

function CashEntryModal({ kind, entry, onClose, onDelete }: { kind: CashEntry['kind']; entry?: CashEntry; onClose: () => void; onDelete?: () => void }) {
  const { me, cashEntries, setCashEntries, jobs, customers, notify, audit } = useApp();
  const [f, setF] = useState<CashEntry>(entry ?? { id: uid('ce'), code: '', kind, date: todayISO(), account: 'CASH', toAccount: 'BANK', category: kind === 'IN' ? CASH_IN_CATS[0] : kind === 'OUT' ? CASH_OUT_CATS[0] : 'Chuyển quỹ', amount: 0, by: me.id, at: Date.now() });
  const cats = f.kind === 'IN' ? CASH_IN_CATS : CASH_OUT_CATS;
  const activeJobs = jobs.filter((j) => j.wonAt && !j.lostAt).sort((a, b) => b.createdAt.localeCompare(a.createdAt));
  const save = () => {
    if (f.amount <= 0) return notify('Nhập số tiền', 'red');
    if (f.kind === 'TRANSFER' && f.account === f.toAccount) return notify('Chọn hai quỹ khác nhau', 'red');
    const prefix = f.kind === 'IN' ? 'PTQ' : f.kind === 'OUT' ? 'PCQ' : 'CQ';
    const x: CashEntry = { ...f, source: f.source ?? 'MANUAL', code: f.code || nextCode(cashEntries.filter((e) => e.code.startsWith(`${prefix}-`)).map((e) => e.code), `${prefix}-${f.date.slice(0, 4)}-`, 4), partner: f.partner?.trim() || undefined, note: f.note?.trim() || undefined };
    setCashEntries((all) => (all.some((e) => e.id === x.id) ? all.map((e) => (e.id === x.id ? x : e)) : [x, ...all]));
    audit('CASH_' + x.kind, `${x.code}: ${vnd(x.amount)} ${x.category}`);
    notify(`Đã lưu ${x.code}`, 'teal');
    onClose();
  };
  const title = f.kind === 'IN' ? 'Phiếu thu' : f.kind === 'OUT' ? 'Phiếu chi' : 'Chuyển quỹ';
  return (
    <Modal title={entry ? `Sửa ${entry.code}` : title} onClose={onClose} footer={<>{entry && onDelete && <button className={cn(btnGhost, 'mr-auto hover:text-[#F87171]')} onClick={onDelete}><Trash2 className="h-4 w-4" aria-hidden />Xóa phiếu</button>}<button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Lưu</button></>}>
      <div className="grid grid-cols-2 gap-3">
        <Field label="Ngày"><input className={inputCls} type="date" value={f.date} onChange={(e) => setF({ ...f, date: e.target.value })} /></Field>
        <Field label="Số tiền *"><MoneyInput value={f.amount} onChange={(n) => setF({ ...f, amount: n })} /></Field>
        <Field label={f.kind === 'TRANSFER' ? 'Từ quỹ' : 'Quỹ'}><select className={inputCls} value={f.account} onChange={(e) => setF({ ...f, account: e.target.value as CashAccount })}>{(Object.keys(CASH_ACCOUNT) as CashAccount[]).map((a) => <option key={a} value={a}>{CASH_ACCOUNT[a]}</option>)}</select></Field>
        {f.kind === 'TRANSFER'
          ? <Field label="Sang quỹ"><select className={inputCls} value={f.toAccount} onChange={(e) => setF({ ...f, toAccount: e.target.value as CashAccount })}>{(Object.keys(CASH_ACCOUNT) as CashAccount[]).map((a) => <option key={a} value={a}>{CASH_ACCOUNT[a]}</option>)}</select></Field>
          : <Field label="Khoản mục"><select className={inputCls} value={f.category} onChange={(e) => setF({ ...f, category: e.target.value })}>{cats.map((c) => <option key={c} value={c}>{c}</option>)}</select></Field>}
        {f.kind !== 'TRANSFER' && <Field label={f.kind === 'IN' ? 'Người nộp' : 'Người nhận / NCC'} className="col-span-2"><input className={inputCls} value={f.partner ?? ''} onChange={(e) => setF({ ...f, partner: e.target.value })} /></Field>}
        {f.kind === 'OUT' && (
          <Field label="Tính vào chi phí đơn hàng" className="col-span-2">
            <select className={inputCls} value={f.jobId ?? ''} onChange={(e) => setF({ ...f, jobId: e.target.value || undefined })}>
              <option value="">Chi phí chung</option>
              {activeJobs.map((j) => <option key={j.id} value={j.id}>{j.code}: {jobCustName(j, customers)}, {j.title}</option>)}
            </select>
          </Field>
        )}
        <Field label="Diễn giải" className="col-span-2"><input className={inputCls} value={f.note ?? ''} onChange={(e) => setF({ ...f, note: e.target.value })} /></Field>
      </div>
    </Modal>
  );
}

function CashbookModule() {
  const { cashEntries, setCashEntries, receipts, jobs, customers, mfgConfig, setMfgConfig, range, canDo, openJob, stockMoves, workOrders, activities, users, company, audit, notify } = useApp();
  const mode = bizMode(company);
  const [acc, setAcc] = useState<'ALL' | CashAccount>('CASH');
  const [tab, setTab] = useState<'book' | 'summary'>('book');
  const [kind, setKind] = useState<'ALL' | 'IN' | 'OUT'>('ALL');
  const [cat, setCat] = useState('ALL');
  const [partner, setPartner] = useState('ALL');
  const [q, setQ] = useState('');
  const [modal, setModal] = useState<{ kind: CashEntry['kind']; entry?: CashEntry } | null>(null);
  useIntent('cash.in', () => setModal({ kind: 'IN' }));
  useIntent('cash.out', () => setModal({ kind: 'OUT' }));
  const [opening, setOpening] = useState<{ cash: number; bank: number } | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const can = canDo('cash.manage');
  const { start, end } = rangeBounds(range);
  const fromISO = iso(new Date(start)), toISO = iso(new Date(end));
  const prevISO = iso(new Date(start - 864e5));
  const all = cashLines(cashEntries, receipts, jobs, customers, activities, users);
  const openOf = (a: CashAccount) => (a === 'CASH' ? mfgConfig.openingCash : mfgConfig.openingBank);
  const balance = (a: 'ALL' | CashAccount, until?: string): number => (a === 'ALL' ? balance('CASH', until) + balance('BANK', until)
    : openOf(a) + all.filter((l) => l.account === a && (!until || l.date <= until)).reduce((s, l) => s + (l.kind === 'IN' ? l.amount : -l.amount), 0));
  const inAcc = (l: CashLine) => (acc === 'ALL' ? l.category !== 'Chuyển quỹ' : l.account === acc);
  const period = all.filter((l) => l.date >= fromISO && l.date <= toISO && inAcc(l)).sort((a, b) => a.date.localeCompare(b.date) || a.code.localeCompare(b.code));
  const openBal = balance(acc, prevISO);
  const sumIn = period.filter((l) => l.kind === 'IN').reduce((s, l) => s + l.amount, 0);
  const sumOut = period.filter((l) => l.kind === 'OUT').reduce((s, l) => s + l.amount, 0);
  const running = new Map<string, number>();
  period.reduce((b, l) => { const nb = b + (l.kind === 'IN' ? l.amount : -l.amount); running.set(l.id, nb); return nb; }, openBal);
  const cats = Array.from(new Set(period.map((l) => l.category))).sort();
  const partners = Array.from(new Set(period.map((l) => l.partner).filter((x): x is string => !!x))).sort();
  const t = q.trim().toLowerCase();
  const list = period.filter((l) => (kind === 'ALL' || l.kind === kind) && (cat === 'ALL' || l.category === cat) && (partner === 'ALL' || l.partner === partner)
    && (!t || `${l.code} ${l.category} ${l.partner ?? ''} ${l.note ?? ''} ${l.ref ?? ''}`.toLowerCase().includes(t)));
  const paged = usePaged(list, 25);
  const filtered = kind !== 'ALL' || cat !== 'ALL' || partner !== 'ALL' || !!t;
  const months = lastMonths(6).map((m) => ({
    name: m.label,
    Thu: all.filter((l) => inAcc(l) && l.kind === 'IN' && l.date.slice(0, 7) === m.key).reduce((s, l) => s + l.amount, 0),
    Chi: all.filter((l) => inAcc(l) && l.kind === 'OUT' && l.date.slice(0, 7) === m.key).reduce((s, l) => s + l.amount, 0),
  }));
  const byCat = Array.from(new Set(period.map((l) => `${l.kind}|${l.category}`))).map((k) => { const [kd, c] = k.split('|'); return { kd, c, v: period.filter((l) => l.kind === kd && l.category === c).reduce((s, l) => s + l.amount, 0), n: period.filter((l) => l.kind === kd && l.category === c).length }; })
    .sort((a, b) => (a.kd === b.kd ? b.v - a.v : a.kd === 'IN' ? -1 : 1));
  const jobRows = mode === 'TRADING' ? [] : jobs.filter((j) => j.wonAt && !j.lostAt).map((j) => {
    const thu = receipts.filter((r) => r.jobId === j.id && r.status === 'CONFIRMED').reduce((s, r) => s + r.amount, 0);
    const c = jobActualCost(j, stockMoves, cashEntries, workOrders);
    return { j, thu, ...c, net: thu - c.total };
  }).filter((r) => r.thu || r.total).sort((a, b) => b.thu - a.thu);
  const entryOf = (l: CashLine) => cashEntries.find((e) => e.id === l.entryId);
  const accLabel = acc === 'ALL' ? 'hai sổ' : CASH_ACCOUNT[acc].toLowerCase();
  const saveOpening = () => {
    if (!opening) return;
    setMfgConfig((c) => ({ ...c, openingCash: opening.cash, openingBank: opening.bank }));
    audit('CASH_OPENING', `Số dư đầu: tiền mặt ${vnd(opening.cash)}, ngân hàng ${vnd(opening.bank)}`, 'WARN');
    notify('Đã cập nhật số dư đầu', 'teal');
    setOpening(null);
  };
  return (
    <div className="space-y-4">
      <div className="grid grid-cols-1 gap-2 sm:grid-cols-3" role="tablist" aria-label="Sổ quỹ">
        {([['CASH', 'Quỹ tiền mặt', Wallet], ['BANK', 'Tài khoản ngân hàng', Building2], ['ALL', 'Tổng hợp 2 sổ', Coins]] as const).map(([k, label, Icon]) => (
          <button key={k} role="tab" aria-selected={acc === k} onClick={() => { setAcc(k); paged.setPage(1); }}
            className={cn('flex items-center gap-3 rounded-md border p-3 text-left transition-colors', acc === k ? 'border-[#F28C33] bg-[#F28C33]/10' : 'border-[#263044] bg-[#151C29] hover:bg-[#1C2534]')}>
            <Icon className={cn('h-5 w-5 shrink-0', acc === k ? 'text-[#F28C33]' : 'text-[#94A3B8]')} aria-hidden />
            <span className="min-w-0 flex-1"><span className="block text-sm font-medium">{label}</span><span className="block text-xs text-[#94A3B8]">Số dư hiện tại</span></span>
            <b className="tabular-nums">{compact(balance(k))}</b>
          </button>
        ))}
      </div>
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Số dư đầu kỳ" value={compact(openBal)} icon={History} color={C.blue} sub={`Ngày ${fmtDate(fromISO)}, ${accLabel}`} />
        <StatCard label="Tổng thu" value={compact(sumIn)} icon={ArrowDown} color={C.teal} sub={`${period.filter((l) => l.kind === 'IN').length} phiếu, tự sinh ${compact(period.filter((l) => l.kind === 'IN' && l.auto).reduce((s, l) => s + l.amount, 0))}`} />
        <StatCard label="Tổng chi" value={compact(sumOut)} icon={ArrowUp} color={C.red} sub={`${period.filter((l) => l.kind === 'OUT').length} phiếu trong kỳ`} />
        <StatCard label="Số dư khả dụng hiện tại" value={compact(balance(acc))} icon={Wallet} color={balance(acc) < 0 ? C.red : C.orange} sub={`Cuối kỳ ${compact(openBal + sumIn - sumOut)}`} />
      </div>
      <div className="flex flex-wrap items-center gap-2">
        <Tabs variant="pill" tabs={[{ id: 'book', label: 'Sổ chi tiết' }, { id: 'summary', label: mode === 'TRADING' ? 'Tổng hợp' : 'Tổng hợp & theo đơn hàng' }]} value={tab} onChange={setTab} />
        <div className="ml-auto flex flex-wrap items-center gap-2"><div className="hidden lg:block"><DateRangePicker /></div>
          <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E]')} disabled={!can} onClick={() => setModal({ kind: 'IN' })}><Plus className="h-3.5 w-3.5" aria-hidden />Phiếu thu</button>
          <button className={cn(btnPrimary, btnSm)} disabled={!can} onClick={() => setModal({ kind: 'OUT' })}><Plus className="h-3.5 w-3.5" aria-hidden />Phiếu chi</button>
          <button className={cn(btnGhost, btnSm)} disabled={!can} onClick={() => setModal({ kind: 'TRANSFER' })}><RefreshCw className="h-3.5 w-3.5" aria-hidden />Chuyển quỹ</button>
          <button className={cn(btnGhost, btnSm)} disabled={!can} onClick={() => setOpening({ cash: mfgConfig.openingCash, bank: mfgConfig.openingBank })}><Pencil className="h-3.5 w-3.5" aria-hidden />Số dư đầu</button>
        </div>
      </div>
      {tab === 'book' ? (
        <Panel>
          <div className="mb-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-[1fr_150px_200px_200px_auto]">
            <SearchBox value={q} onChange={(v) => { setQ(v); paged.setPage(1); }} placeholder="Tìm số phiếu, diễn giải, chứng từ gốc" />
            <select className={inputCls} value={kind} onChange={(e) => { setKind(e.target.value as 'ALL' | 'IN' | 'OUT'); paged.setPage(1); }} aria-label="Loại"><option value="ALL">Thu và chi</option><option value="IN">Chỉ thu</option><option value="OUT">Chỉ chi</option></select>
            <select className={inputCls} value={cat} onChange={(e) => { setCat(e.target.value); paged.setPage(1); }} aria-label="Khoản mục"><option value="ALL">Mọi khoản mục</option>{cats.map((c) => <option key={c} value={c}>{c}</option>)}</select>
            <select className={inputCls} value={partner} onChange={(e) => { setPartner(e.target.value); paged.setPage(1); }} aria-label="Đối tượng"><option value="ALL">Mọi đối tượng nộp / nhận</option>{partners.map((c) => <option key={c} value={c}>{c}</option>)}</select>
            <button className={cn(btnGhost, 'justify-center')} onClick={() => downloadCsv(`so-quy-${acc}-${fromISO}-${toISO}.csv`, [['Ngày', 'Số phiếu', 'Sổ', 'Khoản mục', 'Đối tượng', 'Diễn giải', 'Chứng từ gốc', 'Thu', 'Chi', 'Tồn'], ...list.map((l) => [l.date, l.code, CASH_ACCOUNT[l.account], l.category, l.partner ?? '', l.note ?? '', l.ref ?? '', l.kind === 'IN' ? l.amount : '', l.kind === 'OUT' ? l.amount : '', acc === 'ALL' ? '' : running.get(l.id) ?? ''])])}><Download className="h-4 w-4" aria-hidden />CSV</button>
          </div>
          <Table head={['STT', 'Ngày', 'Số phiếu', 'Diễn giải', 'Đối tượng', ...(acc === 'ALL' ? ['Sổ'] : []), <span key="t" className="block text-right">Thu</span>, <span key="c" className="block text-right">Chi</span>, ...(acc === 'ALL' ? [] : [<span key="b" className="block text-right">Tồn</span>])]} minW={1040}>
            {paged.page === 1 && !filtered && (
              <tr className="border-b border-[#263044]/60 bg-[#1C2534]/50">
                <td className={tdFirst} /><td className={cn(tdCls, 'whitespace-nowrap text-xs')}>{fmtDate(fromISO)}</td><td className={tdCls} />
                {acc === 'ALL'
                  ? <td className={cn(tdLast, 'font-medium')} colSpan={5}>Số dư đầu kỳ hai sổ: <span className="tabular-nums">{openBal.toLocaleString('vi-VN')}</span></td>
                  : <><td className={cn(tdCls, 'font-medium')} colSpan={4}>Số dư đầu kỳ</td><td className={cn(tdLast, 'text-right font-semibold tabular-nums')}>{openBal.toLocaleString('vi-VN')}</td></>}
              </tr>
            )}
            {paged.slice.map((l, i) => {
              const e = entryOf(l);
              const editable = !!e && can && (!e.source || e.source === 'MANUAL');
              return (
                <tr key={l.id} className={cn(rowCls, (editable || l.jobId) && 'cursor-pointer')} onClick={() => (editable && e ? setModal({ kind: e.kind, entry: e }) : l.jobId && openJob(l.jobId))}>
                  <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{(paged.page - 1) * 25 + i + 1}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-xs')}>{fmtDate(l.date)}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap')}><span className="font-mono text-xs">{l.code}</span>{l.auto && <span className="mt-0.5 block text-[10px] text-[#3DDBB6]">Tự sinh{l.ref && l.ref !== l.code ? ` từ ${l.ref}` : ''}</span>}</td>
                  <td className={cn(tdCls, 'max-w-[300px]')}><p className="text-sm">{l.category}</p>{l.note && <p className="line-clamp-1 text-xs text-[#94A3B8]">{l.note}</p>}</td>
                  <td className={cn(tdCls, 'max-w-[200px] text-xs')}><p className="line-clamp-2">{l.partner ?? '—'}</p></td>
                  {acc === 'ALL' && <td className={cn(tdCls, 'whitespace-nowrap text-xs')}>{l.account === 'CASH' ? 'Tiền mặt' : 'Ngân hàng'}</td>}
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-[#3DDBB6]')}>{l.kind === 'IN' ? l.amount.toLocaleString('vi-VN') : ''}</td>
                  <td className={cn(acc === 'ALL' ? tdLast : tdCls, 'whitespace-nowrap text-right tabular-nums text-[#F87171]')}>{l.kind === 'OUT' ? l.amount.toLocaleString('vi-VN') : ''}</td>
                  {acc !== 'ALL' && <td className={cn(tdLast, 'whitespace-nowrap text-right tabular-nums', (running.get(l.id) ?? 0) < 0 && 'text-[#F87171]')}>{(running.get(l.id) ?? 0).toLocaleString('vi-VN')}</td>}
                </tr>
              );
            })}
            {list.length > 0 && (
              <tr className="border-t border-[#263044] font-semibold">
                <td className={tdFirst} colSpan={acc === 'ALL' ? 6 : 5}>{filtered ? 'Cộng các dòng đang lọc' : 'Cộng phát sinh trong kỳ'}</td>
                <td className={cn(tdCls, 'text-right tabular-nums text-[#3DDBB6]')}>{list.filter((l) => l.kind === 'IN').reduce((s, l) => s + l.amount, 0).toLocaleString('vi-VN')}</td>
                <td className={cn(acc === 'ALL' ? tdLast : tdCls, 'text-right tabular-nums text-[#F87171]')}>{list.filter((l) => l.kind === 'OUT').reduce((s, l) => s + l.amount, 0).toLocaleString('vi-VN')}</td>
                {acc !== 'ALL' && <td className={cn(tdLast, 'text-right tabular-nums')}>{filtered ? '' : (openBal + sumIn - sumOut).toLocaleString('vi-VN')}</td>}
              </tr>
            )}
          </Table>
          {!list.length && <EmptyState text={<>Không có phát sinh trong kỳ.</>} art="ledger" />}
          <Pagination paged={paged} unit="dòng" />
          <p className="mt-3 text-xs text-[#94A3B8]">Phiếu tự sinh: thu tiền khách khi kế toán xác nhận phiếu thu, chi công tác phí / triển khai sự kiện khi kế toán xác nhận thanh toán, hoa hồng khi quyết toán, thặng dư quỹ MDF khi hạch toán. Phiếu tự sinh không sửa trực tiếp, điều chỉnh bằng phiếu thu / chi bù.</p>
        </Panel>
      ) : (
        <div className="grid grid-cols-1 gap-4 xl:grid-cols-2">
          <Panel title={`Thu chi 6 tháng (${accLabel})`}>
            <div className="h-64">
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={months} margin={{ left: 0, right: 8, top: 8 }}>
                  <CartesianGrid stroke={C.line} vertical={false} />
                  <XAxis dataKey="name" stroke={C.muted} fontSize={12} />
                  <YAxis stroke={C.muted} fontSize={11} tickFormatter={(v) => compact(Number(v))} width={64} />
                  <Tooltip {...tipStyle} formatter={(v) => vnd(Number(v))} />
                  <Legend wrapperStyle={{ fontSize: 12 }} />
                  <Bar dataKey="Thu" fill={C.teal} radius={[4, 4, 0, 0]} />
                  <Bar dataKey="Chi" fill={C.red} radius={[4, 4, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </div>
          </Panel>
          <Panel title="Theo khoản mục (trong kỳ)">
            <Table head={['Khoản mục', 'Loại', 'Số phiếu', <span key="v" className="block text-right">Số tiền</span>]} minW={460}>
              {byCat.map((r) => (
                <tr key={`${r.kd}${r.c}`} className={rowCls}>
                  <td className={tdFirst}>{r.c}</td>
                  <td className={tdCls}><Chip tone={r.kd === 'IN' ? 'teal' : 'red'}>{r.kd === 'IN' ? 'Thu' : 'Chi'}</Chip></td>
                  <td className={cn(tdCls, 'tabular-nums')}>{r.n}</td>
                  <td className={cn(tdLast, 'text-right tabular-nums')}>{vnd(r.v)}</td>
                </tr>
              ))}
            </Table>
          </Panel>
          {jobRows.length > 0 && (
            <Panel title="Dòng tiền theo đơn hàng" className="xl:col-span-2">
              <Table head={['STT', 'Đơn hàng', 'Giá trị HĐ', 'Đã thu (xác nhận)', 'Vật tư xuất kho', 'Chi phí khác', 'Chênh lệch thu - chi']} minW={980}>
                {jobRows.map((r, i) => (
                  <tr key={r.j.id} className={cn(rowCls, 'cursor-pointer')} onClick={() => openJob(r.j.id)}>
                    <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{i + 1}</td>
                    <td className={tdCls}><p className="font-medium">{jobCustName(r.j, customers)}</p><p className="text-xs text-[#94A3B8]">{r.j.code}, {r.j.title}</p></td>
                    <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(r.j.contractValue ?? 0)}</td>
                    <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-[#3DDBB6]')}>{compact(r.thu)}</td>
                    <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(r.material)}</td>
                    <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(r.other)}</td>
                    <td className={cn(tdLast, 'whitespace-nowrap text-right tabular-nums font-semibold', r.net < 0 ? 'text-[#F87171]' : '')}>{compact(r.net)}</td>
                  </tr>
                ))}
              </Table>
            </Panel>
          )}
        </div>
      )}
      {modal && <CashEntryModal kind={modal.kind} entry={modal.entry} onClose={() => setModal(null)} onDelete={modal.entry ? () => setConfirm({ title: `Xóa ${modal.entry!.code}`, message: 'Xóa phiếu này khỏi sổ quỹ?', onConfirm: () => { setCashEntries((p) => p.filter((e) => e.id !== modal.entry!.id)); setModal(null); } }) : undefined} />}
      {opening && (
        <Modal title="Số dư đầu sổ quỹ" onClose={() => setOpening(null)} footer={<><button className={btnGhost} onClick={() => setOpening(null)}>Hủy</button><button className={btnPrimary} onClick={saveOpening}>Lưu</button></>}>
          <div className="space-y-3">
            <Field label="Quỹ tiền mặt"><MoneyInput value={opening.cash} onChange={(n) => setOpening({ ...opening, cash: n })} /></Field>
            <Field label="Tài khoản ngân hàng"><MoneyInput value={opening.bank} onChange={(n) => setOpening({ ...opening, bank: n })} /></Field>
            <p className="text-xs text-[#94A3B8]">Số dư tại ngày bắt đầu dùng sổ; số dư đầu từng kỳ hệ thống tự tính từ đây.</p>
          </div>
        </Modal>
      )}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

// =====================================================================
//  TỔNG QUAN, KHÁCH HÀNG, BÁO CÁO RIÊNG CHO MÔ HÌNH XƯỞNG
//  Doanh số = tiền Kế toán đã xác nhận; công nợ = giá trị HĐ - đã xác nhận
// =====================================================================

const DAY = 864e5;
const isoMs = (iso?: string) => (iso ? Date.parse(iso.length === 10 ? `${iso}T12:00:00` : iso) : NaN);
const spanDays = (a?: string | number, b?: string | number) => {
  const x = typeof a === 'number' ? a : isoMs(a), y = typeof b === 'number' ? b : isoMs(b);
  return Number.isFinite(x) && Number.isFinite(y) ? Math.max(0, (y - x) / DAY) : null;
};
const avg = (xs: (number | null)[]) => { const v = xs.filter((x): x is number => x !== null); return v.length ? v.reduce((s, x) => s + x, 0) / v.length : null; };
const fmtDays = (d: number | null) => (d === null ? '—' : `${d.toLocaleString('vi-VN', { maximumFractionDigits: 1 })} ngày`);
const monthKey = (t: number) => { const d = new Date(t); return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}`; };
function lastMonths(n: number) {
  const out: { key: string; label: string }[] = [];
  const d = new Date(); d.setDate(1);
  for (let i = n - 1; i >= 0; i--) { const x = new Date(d.getFullYear(), d.getMonth() - i, 1); out.push({ key: monthKey(x.getTime()), label: `T${x.getMonth() + 1}` }); }
  return out;
}
const tipStyle = { contentStyle: { background: C.card, border: `1px solid ${C.line}`, borderRadius: 8, color: C.text }, labelStyle: { color: C.muted } };
/** Báo giá được chốt (hoặc bản mới nhất) của đơn */
const wonQuoteOf = (j: Job) => j.quotes.find((q) => q.version === j.wonVersion) ?? j.quotes[j.quotes.length - 1];

/** Các con số dùng chung cho Tổng quan & Báo cáo xưởng */
function useMfgData() {
  const { jobs: allJobs, receipts, workOrders, installJobs, now, gf, customers } = useApp();
  const inR = useInRange();
  const t = now ?? Date.now();
  // Bộ lọc toàn cục: phòng ban của đơn, miền theo khách hàng của đơn
  const jobs = gfCount(gf) ? allJobs.filter((j) => (gf.dept === 'ALL' || j.dept === gf.dept) && (gf.region === 'ALL' || customers.find((c) => c.id === j.customerId)?.region === gf.region)) : allJobs;
  const rows = jobs.map((j) => ({ j, stage: jobStageOf(j, workOrders, installJobs, receipts), money: jobMoney(j, receipts) }));
  const confirmedIn = receipts.filter((r) => r.status === 'CONFIRMED' && r.confirmedAt && inR(new Date(r.confirmedAt)));
  return { rows, inR, t, confirmedIn };
}

function MfgOverview() {
  const { receipts, installJobs, workOrders, mfgConfig, openJob, go, userName, customers, me, role } = useApp();
  const { rows, inR, t, confirmedIn } = useMfgData();
  const revenue = confirmedIn.reduce((s, r) => s + r.amount, 0);
  const won = rows.filter((r) => r.j.wonAt && inR(r.j.wonAt));
  const wonValue = won.reduce((s, r) => s + r.money.value, 0);
  const live = rows.filter((r) => r.j.wonAt && !r.j.lostAt);
  const receivable = live.reduce((s, r) => s + r.money.receivable, 0);
  const holding = receipts.filter((r) => r.status === 'HOLDING');
  const lateHold = holding.filter((r) => holdingOverdue(r, t, mfgConfig.submitHours));
  const submitted = receipts.filter((r) => r.status === 'SUBMITTED');
  const pipeline = rows.filter((r) => r.stage === 'QUOTED').reduce((s, r) => s + (r.j.quotes[r.j.quotes.length - 1]?.total ?? 0), 0);

  // Phễu trong kỳ: lead -> khảo sát -> báo giá -> chốt
  const jobsIn = rows.filter((r) => inR(r.j.createdAt));
  const funnel: [string, number, string][] = [
    ['Lead mới', jobsIn.length, '#8B5CF6'],
    ['Đã khảo sát', jobsIn.filter((r) => r.j.quotes.length || r.j.surveyCheckins.length || r.j.files.length).length, C.blue],
    ['Đã báo giá', jobsIn.filter((r) => r.j.quotes.length).length, '#06B6D4'],
    ['Chốt, nhận cọc', jobsIn.filter((r) => r.j.wonAt).length, C.teal],
  ];
  const fMax = Math.max(1, ...funnel.map((f) => f[1]));

  // Doanh số 6 tháng: tiền đã xác nhận và giá trị HĐ ký mới
  const months = lastMonths(6).map((m) => ({
    name: m.label,
    'Đã thu (xác nhận)': receipts.filter((r) => r.status === 'CONFIRMED' && r.confirmedAt && monthKey(r.confirmedAt) === m.key).reduce((s, r) => s + r.amount, 0),
    'HĐ ký mới': rows.filter((r) => r.j.wonAt && monthKey(isoMs(r.j.wonAt)) === m.key).reduce((s, r) => s + r.money.value, 0),
  }));
  const stageData = JOB_STAGES.filter((s) => s !== 'DONE').map((s) => ({ name: JOB_STAGE[s].short, n: rows.filter((r) => r.stage === s).length, color: JOB_STAGE[s].color }));

  // Việc cần xử lý / đơn bị kẹt
  type Stuck = { key: string; jobId?: string; title: string; why: string; tone: Tone };
  const stuck: Stuck[] = [];
  lateHold.forEach((r) => { const j = rows.find((x) => x.j.id === r.jobId)?.j; stuck.push({ key: `h${r.id}`, jobId: r.jobId, title: `${userName(r.collectedBy)} giữ ${vnd(r.amount)} tiền mặt`, why: `${r.code}${j ? `, ${j.code}` : ''}: quá hạn nộp kế toán`, tone: 'red' }); });
  rows.forEach(({ j, stage, money }) => {
    const name = jobCustName(j, customers);
    if (stage === 'WAIT_PAYMENT') stuck.push({ key: `p${j.id}`, jobId: j.id, title: name, why: `Đã nghiệm thu, còn ${compact(money.remaining || money.receivable)} chưa thu / chưa xác nhận`, tone: 'red' });
    const wo = workOrders.find((w) => w.jobId === j.id);
    if (stage === 'PRODUCTION' && wo?.stage === 'WAITING' && (spanDays(j.wonAt, t) ?? 0) > 2) stuck.push({ key: `w${j.id}`, jobId: j.id, title: name, why: `Đã cọc ${Math.floor(spanDays(j.wonAt, t) ?? 0)} ngày, xưởng chưa bắt đầu`, tone: 'orange' });
    if (stage === 'INSTALL' && !installJobs.some((i) => i.jobId === j.id)) stuck.push({ key: `i${j.id}`, jobId: j.id, title: name, why: 'Sản xuất xong, chưa hẹn lịch lắp đặt', tone: 'orange' });
    if (stage === 'QUOTED') { const last = j.quotes[j.quotes.length - 1]; const d = spanDays(last?.at, t) ?? 0; if (d > mfgConfig.quoteValidDays) stuck.push({ key: `q${j.id}`, jobId: j.id, title: name, why: `Báo giá ${Math.floor(d)} ngày chưa chốt (hiệu lực ${mfgConfig.quoteValidDays} ngày)`, tone: 'muted' }); }
    if (stage === 'SURVEY' && j.appointmentAt && isoMs(j.appointmentAt) < t - DAY) stuck.push({ key: `s${j.id}`, jobId: j.id, title: name, why: `Hẹn khảo sát ${fmtDT(j.appointmentAt)}, chưa có báo giá`, tone: 'orange' });
  });
  workOrders.filter((w) => w.jobId && w.stage !== 'DONE' && w.dueDate < todayISO()).forEach((w) => stuck.push({ key: `o${w.id}`, jobId: w.jobId, title: w.title, why: `${w.code} trễ hạn sản xuất (${fmtDate(w.dueDate)})`, tone: 'red' }));

  const week = installJobs.filter((i) => i.status !== 'ACCEPTED' && isoMs(i.from) <= t + 7 * DAY && isoMs(i.to) >= t - DAY).sort((a, b) => a.from.localeCompare(b.from));
  const myHolding = holding.filter((r) => r.collectedBy === me.id);

  return (
    <div className="space-y-5">
      <div className="hidden items-center justify-between gap-3 lg:flex"><p className="text-sm text-[#94A3B8]">Số liệu theo kỳ đang chọn</p><DateRangePicker /></div>
      {myHolding.length > 0 && (
        <div className="flex flex-wrap items-center gap-3 rounded-md border border-[#F28C33]/40 bg-[#F28C33]/10 p-3 text-sm">
          <Banknote className="h-5 w-5 text-[#F28C33]" aria-hidden />
          <span className="flex-1">Bạn đang giữ <b>{vnd(myHolding.reduce((s, r) => s + r.amount, 0))}</b> tiền mặt ({myHolding.length} phiếu). Nộp về kế toán trong ngày rồi bấm "Đã nộp" ở Trung tâm phê duyệt.</span>
          <button className={cn(btnPrimary, btnSm)} onClick={() => go('tasks')}>Mở việc của tôi</button>
        </div>
      )}
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Doanh số đã thu (kỳ)" value={compact(revenue)} icon={TrendingUp} color={C.teal} sub={`${confirmedIn.length} phiếu kế toán đã xác nhận`} />
        <StatCard label="Hợp đồng ký mới" value={compact(wonValue)} icon={FileCheck2} color={C.orange} sub={`${won.length} đơn chốt trong kỳ, đang chào ${compact(pipeline)}`} />
        <StatCard label="Còn phải thu" value={compact(receivable)} icon={Wallet} color={C.red} sub={`${live.filter((r) => r.money.receivable > 0).length} đơn còn công nợ`} />
        <StatCard label="Tiền đang ở nhân viên" value={compact(holding.reduce((s, r) => s + r.amount, 0) + submitted.reduce((s, r) => s + r.amount, 0))} icon={Banknote} color={lateHold.length ? C.red : C.sand}
          sub={lateHold.length ? `${lateHold.length} phiếu quá hạn nộp` : `${holding.length} đang giữ, ${submitted.length} chờ kế toán xác nhận`} />
      </div>

      <div className="grid grid-cols-1 gap-5 xl:grid-cols-5">
        <Panel className="xl:col-span-3" title="Doanh số đã thu và hợp đồng ký mới, 6 tháng">
          <div className="h-64">
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={months} margin={{ left: 0, right: 8, top: 8 }}>
                <CartesianGrid stroke={C.line} vertical={false} />
                <XAxis dataKey="name" stroke={C.muted} fontSize={12} />
                <YAxis stroke={C.muted} fontSize={11} tickFormatter={(v) => compact(Number(v))} width={64} />
                <Tooltip {...tipStyle} formatter={(v) => vnd(Number(v))} />
                <Legend wrapperStyle={{ fontSize: 12 }} />
                <Bar dataKey="HĐ ký mới" fill={C.orange} radius={[4, 4, 0, 0]} />
                <Bar dataKey="Đã thu (xác nhận)" fill={C.teal} radius={[4, 4, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </Panel>
        <Panel className="xl:col-span-2" title="Phễu trong kỳ">
          <ul className="space-y-3">
            {funnel.map(([label, n, color], i) => (
              <li key={label}>
                <div className="mb-1 flex justify-between text-sm"><span>{label}</span><span className="tabular-nums text-[#94A3B8]">{n}{i > 0 && funnel[i - 1][1] ? ` (${pct(n, funnel[i - 1][1])})` : ''}</span></div>
                <div className="h-2.5 rounded-full bg-[#1C2534]"><div className="h-full rounded-full" style={{ width: `${(n / fMax) * 100}%`, background: color }} /></div>
              </li>
            ))}
          </ul>
          <p className="mt-4 text-xs text-[#94A3B8]">Tỷ lệ chốt trên đơn đã báo giá: <b className="text-[#F1F5F9]">{pct(funnel[3][1], funnel[2][1])}</b></p>
        </Panel>
      </div>

      <div className="grid grid-cols-1 gap-5 xl:grid-cols-2">
        <Panel title="Đơn hàng theo giai đoạn" action={<button className={cn(btnGhost, btnSm)} onClick={() => go('jobs')}>Mở đơn hàng</button>}>
          <div className="h-56">
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={stageData} layout="vertical" margin={{ left: 8, right: 16 }}>
                <XAxis type="number" stroke={C.muted} fontSize={11} allowDecimals={false} />
                <YAxis type="category" dataKey="name" stroke={C.muted} fontSize={12} width={78} />
                <Tooltip {...tipStyle} formatter={(v) => [`${v} đơn`, 'Số đơn']} />
                <Bar dataKey="n" radius={[0, 4, 4, 0]}>{stageData.map((d) => <Cell key={d.name} fill={d.color} />)}</Bar>
              </BarChart>
            </ResponsiveContainer>
          </div>
        </Panel>
        <Panel title={`Cần xử lý (${stuck.length})`}>
          {!stuck.length ? <EmptyState text={<>Không có đơn bị kẹt.</>} art="box" /> : (
            <ul className="max-h-60 divide-y divide-[#263044] overflow-y-auto">
              {stuck.slice(0, 12).map((s) => (
                <li key={s.key}>
                  <button className="flex w-full items-start gap-2 py-2 text-left" onClick={() => s.jobId && openJob(s.jobId)}>
                    <AlertTriangle className={cn('mt-0.5 h-4 w-4 shrink-0', s.tone === 'red' ? 'text-[#F87171]' : s.tone === 'orange' ? 'text-[#F7B23B]' : 'text-[#94A3B8]')} aria-hidden />
                    <span className="min-w-0"><span className="block truncate text-sm">{s.title}</span><span className="block text-xs text-[#94A3B8]">{s.why}</span></span>
                  </button>
                </li>
              ))}
            </ul>
          )}
        </Panel>
      </div>

      <Panel title="Lịch lắp đặt 7 ngày tới" action={<button className={cn(btnGhost, btnSm)} onClick={() => go('install')}>Mở lắp đặt</button>}>
        {!week.length ? <EmptyState text={<>Chưa có lịch lắp đặt.</>} art="calendar" /> : (
          <ul className="grid grid-cols-1 gap-2 md:grid-cols-2">
            {week.map((i) => {
              const j = rows.find((r) => r.j.id === i.jobId);
              return (
                <li key={i.id} className="rounded bg-[#1C2534] p-3 text-sm">
                  <div className="flex items-start justify-between gap-2"><b className="min-w-0 truncate">{i.title}</b><Chip tone={i.status === 'IN_PROGRESS' ? 'orange' : 'blue'}>{i.status === 'IN_PROGRESS' ? 'Đang lắp' : 'Đã hẹn'}</Chip></div>
                  <p className="mt-1 text-xs text-[#94A3B8]">{fmtDT(i.from)}, {userName(i.leaderId)}{i.team.length ? ` +${i.team.length}` : ''}, {i.address}</p>
                  {j && j.money.remaining > 0 && <p className="mt-1 text-xs text-[#F7B23B]">Thu khi bàn giao: {vnd(j.money.remaining)}{customers.find((c) => c.id === j.j.customerId) ? `, ${customers.find((c) => c.id === j.j.customerId)!.contactPhone}` : ''}</p>}
                </li>
              );
            })}
          </ul>
        )}
      </Panel>
      {role === 'BOD' && <p className="text-center text-xs text-[#94A3B8]">Doanh số chỉ tính tiền Kế toán đã xác nhận. Tiền nhân viên đang giữ hoặc chờ đối chiếu không tính vào doanh số.</p>}
    </div>
  );
}

function MfgCustomersPage() {
  return <MfgCustomersList />;
}

function MfgCustomersList() {
  const { myCustomers: customers, jobs, receipts, workOrders, installJobs, sources, userName, openJob, canDo } = useApp();
  const [q, setQ] = useState('');
  const [seg, setSeg] = useState('ALL');
  const [form, setForm] = useState(false);
  const t = q.trim().toLowerCase();
  const rows = customers.map((c) => {
    const js = jobs.filter((j) => j.customerId === c.id);
    const money = js.map((j) => jobMoney(j, receipts));
    const lastJob = [...js].sort((a, b) => b.createdAt.localeCompare(a.createdAt))[0];
    return {
      c, js, lastJob, value: money.reduce((s, m) => s + m.value, 0), confirmed: money.reduce((s, m) => s + m.confirmed, 0), receivable: money.reduce((s, m) => s + m.receivable, 0),
      active: js.filter((j) => !['DONE', 'LOST'].includes(jobStageOf(j, workOrders, installJobs, receipts))).length,
    };
  }).filter((r) => (seg === 'ALL' || r.c.segment === seg) && (!t || `${r.c.code} ${r.c.name} ${r.c.contactPhone} ${r.c.address}`.toLowerCase().includes(t)))
    .sort((a, b) => b.value - a.value || b.c.createdAt.localeCompare(a.c.createdAt));
  const paged = usePaged(rows, 15);
  const segs = Array.from(new Set(customers.map((c) => c.segment)));
  const srcName = (id: string) => sources.find((s) => s.id === id)?.name ?? '—';
  const referral = customers.filter((c) => /giới thiệu|referral|cũ/i.test(srcName(c.sourceId))).length;
  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Khách hàng" value={String(customers.length)} icon={Users} sub={`${rows.filter((r) => r.active).length} đang có đơn chạy`} />
        <StatCard label="Giá trị hợp đồng" value={compact(rows.reduce((s, r) => s + r.value, 0))} icon={FileCheck2} color={C.orange} />
        <StatCard label="Còn phải thu" value={compact(rows.reduce((s, r) => s + r.receivable, 0))} icon={Wallet} color={C.red} />
        <StatCard label="Khách giới thiệu / quay lại" value={pct(referral, customers.length)} icon={UserPlus} color={C.teal} sub={`${referral} khách`} />
      </div>
      <Panel>
        <div className="mb-3 flex flex-wrap gap-2">
          <div className="relative min-w-[200px] flex-1"><Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#94A3B8]" aria-hidden /><input className={cn(inputCls, 'pl-9')} value={q} onChange={(e) => setQ(e.target.value)} placeholder="Tìm tên, số điện thoại, địa chỉ" /></div>
          <select className={cn(inputBase, 'w-auto')} value={seg} onChange={(e) => setSeg(e.target.value)} aria-label="Loại khách"><option value="ALL">Tất cả loại khách</option>{segs.map((s) => <option key={s} value={s}>{segName(s)}</option>)}</select>
          <div className="hidden lg:block"><DateRangePicker /></div>
          <button className={cn(btnGhost, btnSm)} onClick={() => downloadCsv(`khach-hang-${todayISO()}.csv`, [['Mã', 'Tên', 'SĐT', 'Địa chỉ', 'Loại', 'Nguồn', 'Số đơn', 'Giá trị HĐ', 'Đã thu', 'Còn phải thu'], ...rows.map((r) => [r.c.code, r.c.name, r.c.contactPhone, r.c.address, segName(r.c.segment), srcName(r.c.sourceId), r.js.length, r.value, r.confirmed, r.receivable])])}><Download className="h-3.5 w-3.5" aria-hidden />Xuất CSV</button>
        </div>
        <div className="space-y-2 md:hidden">
          {paged.slice.map((r) => (
            <button key={r.c.id} className="w-full rounded bg-[#1C2534] p-3 text-left" onClick={() => r.lastJob && openJob(r.lastJob.id)}>
              <p className="text-sm font-medium">{r.c.name}</p>
              <p className="text-xs text-[#94A3B8]">{r.c.contactPhone}, {segName(r.c.segment)}, {r.js.length} đơn</p>
              {r.value > 0 && <p className="mt-1 flex justify-between text-xs tabular-nums"><span>{compact(r.value)}</span><span className={r.receivable ? 'text-[#F7B23B]' : 'text-[#3DDBB6]'}>Còn {compact(r.receivable)}</span></p>}
            </button>
          ))}
        </div>
        <div className="hidden md:block">
          <Table head={['Khách hàng', 'Loại / nguồn', 'Phụ trách', 'Đơn', 'Giá trị HĐ', 'Đã thu', 'Còn phải thu']} minW={900}>
            {paged.slice.map((r) => (
              <tr key={r.c.id} className={cn(rowCls, r.lastJob && 'cursor-pointer')} onClick={() => r.lastJob && openJob(r.lastJob.id)}>
                <td className={tdFirst}><p className="font-medium">{r.c.name}</p><p className="max-w-[280px] truncate text-xs text-[#94A3B8]">{r.c.code}, {r.c.contactPhone}, {r.c.address}</p></td>
                <td className={cn(tdCls, 'text-xs')}>{segName(r.c.segment)}<p className="text-[#94A3B8]">{srcName(r.c.sourceId)}</p></td>
                <td className={cn(tdCls, 'text-xs')}>{userName(r.c.amId)}</td>
                <td className={cn(tdCls, 'tabular-nums')}>{r.js.length}{r.active > 0 && <span className="text-xs text-[#F7B23B]"> ({r.active} đang chạy)</span>}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{r.value ? compact(r.value) : '—'}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{r.confirmed ? compact(r.confirmed) : '—'}</td>
                <td className={cn(tdLast, 'whitespace-nowrap text-right tabular-nums', r.receivable ? 'text-[#F87171]' : '')}>{r.value ? compact(r.receivable) : '—'}</td>
              </tr>
            ))}
          </Table>
        </div>
        {!rows.length && <EmptyState text={<>Chưa có khách hàng</>} hint={<>Khách được tạo khi kỹ thuật lập đơn khảo sát.</>} art="box" />}
        <Pagination paged={paged} unit="khách" />
      </Panel>
      <Fab label="Khách mới + đơn khảo sát" onClick={() => setForm(true)} disabled={!canDo('job.manage')} />
      {form && <MfgLeadForm onClose={() => setForm(false)} />}
    </div>
  );
}

function MfgReports() {
  const { users, sources, customers, receipts, installJobs, workOrders, mfgConfig, openJob, stockMoves, cashEntries } = useApp();
  const { rows, inR, t } = useMfgData();
  const [tab, setTab] = useState<'margin' | 'people' | 'source' | 'cycle'>('margin');

  // ---- Lãi gộp theo đơn (giá vốn theo bảng đơn giá ở bản báo giá đã chốt) ----
  const wonRows = rows.filter((r) => r.j.wonAt && !r.j.lostAt && inR(r.j.wonAt)).map((r) => {
    const q = wonQuoteOf(r.j);
    const cost = q?.cost ?? 0;
    const value = r.money.value || q?.total || 0;
    const base = q && q.vatPct ? value / (1 + q.vatPct / 100) : value;
    const actual = jobActualCost(r.j, stockMoves, cashEntries, workOrders);
    return { ...r, cost, actual, value, base, gm: base - cost, gmPct: base ? ((base - cost) / base) * 100 : 0, realPct: actual.total && base ? ((base - actual.total) / base) * 100 : null };
  }).sort((a, b) => a.gmPct - b.gmPct);
  const totV = wonRows.reduce((s, r) => s + r.value, 0), totGm = wonRows.reduce((s, r) => s + r.gm, 0);

  // ---- Hiệu suất kỹ thuật / kinh doanh và đội lắp ----
  const owners = users.filter((u) => rows.some((r) => r.j.ownerId === u.id));
  const people = owners.map((u) => {
    const mine = rows.filter((r) => r.j.ownerId === u.id && inR(r.j.createdAt));
    const quoted = mine.filter((r) => r.j.quotes.length).length;
    const wonN = mine.filter((r) => r.j.wonAt).length;
    const value = rows.filter((r) => r.j.ownerId === u.id && r.j.wonAt && inR(r.j.wonAt)).reduce((s, r) => s + r.money.value, 0);
    return { u, surveys: mine.length, quoted, wonN, rate: quoted ? (wonN / quoted) * 100 : 0, value, lead: avg(mine.map((r) => spanDays(r.j.createdAt, r.j.quotes[0]?.at))) };
  }).sort((a, b) => b.value - a.value);
  const leaders = users.filter((u) => installJobs.some((i) => i.leaderId === u.id) || receipts.some((r) => r.collectedBy === u.id && rows.find((x) => x.j.id === r.jobId)?.j.ownerId !== u.id)).map((u) => {
    const ins = installJobs.filter((i) => i.leaderId === u.id && i.acceptance && inR(i.acceptance.at));
    const col = receipts.filter((r) => r.collectedBy === u.id && inR(new Date(r.collectedAt)) && r.status !== 'REJECTED');
    const late = receipts.filter((r) => r.collectedBy === u.id && holdingOverdue(r, t, mfgConfig.submitHours));
    return { u, accepted: ins.length, defects: ins.reduce((s, i) => s + i.defects.length, 0), collected: col.reduce((s, r) => s + r.amount, 0), late: late.reduce((s, r) => s + r.amount, 0) };
  });

  // ---- Theo nguồn khách ----
  const bySource = sources.map((s) => {
    const cs = new Set(customers.filter((c) => c.sourceId === s.id).map((c) => c.id));
    const js = rows.filter((r) => cs.has(r.j.customerId) && inR(r.j.createdAt));
    const w = js.filter((r) => r.j.wonAt);
    return { name: s.name, jobs: js.length, won: w.length, value: w.reduce((x, r) => x + r.money.value, 0), rate: js.length ? (w.length / js.length) * 100 : 0 };
  }).filter((x) => x.jobs);

  // ---- Thời gian chu trình ----
  const cyc = rows.filter((r) => inR(r.j.createdAt) || (r.j.wonAt && inR(r.j.wonAt)));
  const woOf = (id: string) => workOrders.find((w) => w.jobId === id);
  const readyAt = (id: string) => woOf(id)?.doneAt ?? woOf(id)?.history.find((h) => h.stage === 'DONE')?.at;
  const accAt = (id: string) => installJobs.find((i) => i.jobId === id && i.acceptance)?.acceptance?.at;
  const paidAt = (id: string) => { const rs = receipts.filter((r) => r.jobId === id && r.status === 'CONFIRMED' && r.confirmedAt); return rs.length ? Math.max(...rs.map((r) => r.confirmedAt!)) : undefined; };
  const cycles: [string, number | null, string][] = [
    ['Tạo đơn → báo giá đầu', avg(cyc.map((r) => spanDays(r.j.createdAt, r.j.quotes[0]?.at))), 'Kỹ thuật khảo sát, đo đạc, lên bản vẽ'],
    ['Báo giá → chốt cọc', avg(cyc.filter((r) => r.j.wonAt).map((r) => spanDays(r.j.quotes[0]?.at, r.j.wonAt))), 'Thời gian khách cân nhắc'],
    ['Chốt → sản xuất xong', avg(cyc.filter((r) => r.j.wonAt && readyAt(r.j.id)).map((r) => spanDays(r.j.wonAt, readyAt(r.j.id)))), 'Xưởng sản xuất'],
    ['Xong SX → nghiệm thu', avg(cyc.filter((r) => readyAt(r.j.id) && accAt(r.j.id)).map((r) => spanDays(readyAt(r.j.id), accAt(r.j.id)))), 'Lắp đặt, xử lý tồn tại'],
    ['Nghiệm thu → thu đủ', avg(cyc.filter((r) => r.stage === 'DONE' && accAt(r.j.id)).map((r) => spanDays(accAt(r.j.id), paidAt(r.j.id)))), 'Thu tiền còn lại, kế toán xác nhận'],
  ];
  const lost = rows.filter((r) => r.j.lostAt && inR(r.j.lostAt));
  const lostData = (Object.keys(JOB_LOST) as JobLostReason[]).map((k, i) => ({ name: JOB_LOST[k], value: lost.filter((r) => r.j.lostReason === k).length, color: ['#EF4444', '#F6B533', '#1F74D4', '#94A3B8', '#8B5CF6'][i] })).filter((x) => x.value);

  const exportCsv = () => {
    if (tab === 'margin') downloadCsv(`lai-gop-don-${todayISO()}.csv`, [['Mã đơn', 'Công trình', 'Ngày chốt', 'Giá trị HĐ', 'Giá vốn', 'Lãi gộp', 'GM %', 'Đã thu xác nhận'], ...wonRows.map((r) => [r.j.code, r.j.title, r.j.wonAt ?? '', r.value, r.cost, Math.round(r.gm), r.gmPct.toFixed(1), r.money.confirmed])]);
    else if (tab === 'people') downloadCsv(`hieu-suat-${todayISO()}.csv`, [['Nhân sự', 'Khảo sát', 'Báo giá', 'Chốt', 'Tỷ lệ chốt %', 'Giá trị chốt'], ...people.map((p) => [p.u.name, p.surveys, p.quoted, p.wonN, p.rate.toFixed(1), p.value])]);
    else if (tab === 'source') downloadCsv(`theo-nguon-${todayISO()}.csv`, [['Nguồn', 'Đơn', 'Chốt', 'Tỷ lệ %', 'Giá trị'], ...bySource.map((s) => [s.name, s.jobs, s.won, s.rate.toFixed(1), s.value])]);
    else downloadCsv(`chu-trinh-${todayISO()}.csv`, [['Chặng', 'Trung bình (ngày)'], ...cycles.map((c) => [c[0], c[1] === null ? '' : c[1].toFixed(1)])]);
  };

  return (
    <div className="space-y-4">
      <div className="flex flex-wrap items-center justify-between gap-2">
        <Tabs tabs={[{ id: 'margin', label: 'Lãi gộp theo đơn' }, { id: 'people', label: 'Hiệu suất nhân sự' }, { id: 'source', label: 'Theo nguồn khách' }, { id: 'cycle', label: 'Chu trình & lý do trượt' }]} value={tab} onChange={setTab} />
        <button className={cn(btnGhost, btnSm)} onClick={exportCsv}><Download className="h-3.5 w-3.5" aria-hidden />Xuất CSV</button>
      </div>

      {tab === 'margin' && (
        <>
          <div className={kpiGrid('lg:grid-cols-3')}>
            <StatCard label="Giá trị đơn chốt trong kỳ" value={compact(totV)} icon={FileCheck2} sub={`${wonRows.length} đơn`} />
            <StatCard label="Lãi gộp ước tính" value={compact(totGm)} icon={TrendingUp} color={C.teal} sub="Theo giá vốn trong bảng đơn giá" />
            <StatCard label="GM bình quân" value={pct(totGm, wonRows.reduce((s, r) => s + r.base, 0))} icon={BadgePercent} color={C.orange} sub={`${wonRows.filter((r) => r.gmPct < 20).length} đơn GM dưới 20%`} />
          </div>
          <Panel title="Đơn chốt trong kỳ (GM thấp ở trên)">
            <Table head={['Khách hàng / hạng mục', 'Ngày chốt', 'Giá trị HĐ', 'Giá vốn dự toán', 'Lãi gộp', 'GM dự toán', 'Chi phí thực tế', 'GM thực tế', 'Đã thu']} minW={1080}>
              {wonRows.map((r) => (
                <tr key={r.j.id} className={cn(rowCls, 'cursor-pointer')} onClick={() => openJob(r.j.id)}>
                  <td className={tdFirst}><p className="font-medium">{jobCustName(r.j, customers)}</p><p className="max-w-[240px] truncate text-xs text-[#94A3B8]">{r.j.code}, {r.j.title}</p></td>
                  <td className={cn(tdCls, 'text-xs')}>{fmtDate(r.j.wonAt)}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(r.value)}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(r.cost)}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(r.gm)}</td>
                  <td className={cn(tdCls, 'tabular-nums', r.gmPct < 20 ? 'text-[#F87171]' : r.gmPct < 28 ? 'text-[#F7B23B]' : 'text-[#3DDBB6]')}>{r.gmPct.toFixed(1)}%</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{r.actual.total ? compact(r.actual.total) : '—'}</td>
                  <td className={cn(tdCls, 'tabular-nums', r.realPct !== null && r.realPct < r.gmPct - 5 ? 'text-[#F87171]' : '')}>{r.realPct === null ? '—' : `${r.realPct.toFixed(1)}%`}</td>
                  <td className={cn(tdLast, 'tabular-nums')}>{pct(r.money.confirmed, r.value)}</td>
                </tr>
              ))}
            </Table>
            {!wonRows.length && <EmptyState text={<>Chưa có đơn chốt trong kỳ đã chọn.</>} art="box" />}
          </Panel>
        </>
      )}

      {tab === 'people' && (
        <div className="grid grid-cols-1 gap-5 xl:grid-cols-2">
          <Panel title="Kỹ thuật / kinh doanh: khảo sát đến chốt">
            <Table head={['Nhân sự', 'Khảo sát', 'Báo giá', 'Chốt', 'Tỷ lệ chốt', 'Giá trị chốt', 'Ra báo giá']} minW={640}>
              {people.map((p) => (
                <tr key={p.u.id} className={rowCls}>
                  <td className={tdFirst}>{p.u.name}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{p.surveys}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{p.quoted}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{p.wonN}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{p.rate.toFixed(0)}%</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(p.value)}</td>
                  <td className={cn(tdLast, 'text-xs')}>{fmtDays(p.lead)}</td>
                </tr>
              ))}
            </Table>
          </Panel>
          <Panel title="Đội lắp đặt: nghiệm thu và thu tiền">
            <Table head={['Đội trưởng / người thu', 'Nghiệm thu', 'Lỗi ghi nhận', 'Tiền đã thu', 'Quá hạn nộp']} minW={560}>
              {leaders.map((p) => (
                <tr key={p.u.id} className={rowCls}>
                  <td className={tdFirst}>{p.u.name}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{p.accepted}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{p.defects}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(p.collected)}</td>
                  <td className={cn(tdLast, 'whitespace-nowrap text-right tabular-nums', p.late ? 'text-[#F87171]' : '')}>{p.late ? compact(p.late) : '—'}</td>
                </tr>
              ))}
            </Table>
          </Panel>
        </div>
      )}

      {tab === 'source' && (
        <div className="grid grid-cols-1 gap-5 xl:grid-cols-2">
          <Panel title="Giá trị chốt theo nguồn khách">
            <div className="h-64">
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={bySource} margin={{ left: 0, right: 8, top: 8 }}>
                  <CartesianGrid stroke={C.line} vertical={false} />
                  <XAxis dataKey="name" stroke={C.muted} fontSize={11} />
                  <YAxis stroke={C.muted} fontSize={11} tickFormatter={(v) => compact(Number(v))} width={64} />
                  <Tooltip {...tipStyle} formatter={(v) => vnd(Number(v))} />
                  <Bar dataKey="value" name="Giá trị chốt" fill={C.orange} radius={[4, 4, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </div>
          </Panel>
          <Panel title={`Tỷ lệ chốt theo nguồn (${rows.filter((r) => inR(r.j.createdAt)).length} lead trong kỳ)`}>
            <Table head={['Nguồn', 'Đơn khảo sát', 'Chốt', 'Tỷ lệ', 'Giá trị']} minW={480}>
              {bySource.map((s) => (
                <tr key={s.name} className={rowCls}>
                  <td className={tdFirst}>{s.name}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{s.jobs}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{s.won}</td>
                  <td className={cn(tdCls, 'tabular-nums')}>{s.rate.toFixed(0)}%</td>
                  <td className={cn(tdLast, 'whitespace-nowrap text-right tabular-nums')}>{compact(s.value)}</td>
                </tr>
              ))}
            </Table>
          </Panel>
        </div>
      )}

      {tab === 'cycle' && (
        <div className="grid grid-cols-1 gap-5 xl:grid-cols-5">
          <Panel className="xl:col-span-3" title="Thời gian trung bình từng chặng">
            <ul className="space-y-3">
              {cycles.map(([label, d, hint]) => (
                <li key={label} className="flex items-center gap-3">
                  <Clock className="h-4 w-4 shrink-0 text-[#94A3B8]" aria-hidden />
                  <span className="min-w-0 flex-1"><span className="block text-sm">{label}</span><span className="block text-xs text-[#94A3B8]">{hint}</span></span>
                  <b className="tabular-nums">{fmtDays(d)}</b>
                </li>
              ))}
            </ul>
            <p className="mt-4 text-xs text-[#94A3B8]">Tổng chu trình trung bình: <b className="text-[#F1F5F9]">{fmtDays(cycles.reduce<number | null>((s, c) => (c[1] === null ? s : (s ?? 0) + c[1]), null))}</b></p>
          </Panel>
          <Panel className="xl:col-span-2" title={`Lý do trượt (${lost.length} đơn)`}>
            {!lostData.length ? <EmptyState text={<>Không có đơn trượt trong kỳ.</>} art="box" /> : (
              <div className="h-60">
                <ResponsiveContainer width="100%" height="100%">
                  <PieChart>
                    <Pie data={lostData} dataKey="value" nameKey="name" innerRadius={50} outerRadius={80} paddingAngle={2}>{lostData.map((d) => <Cell key={d.name} fill={d.color} />)}</Pie>
                    <Tooltip {...tipStyle} formatter={(v) => `${v} đơn`} />
                    <Legend wrapperStyle={{ fontSize: 12 }} />
                  </PieChart>
                </ResponsiveContainer>
              </div>
            )}
          </Panel>
        </div>
      )}
    </div>
  );
}

// =====================================================================
//  CÔNG NỢ & TUỔI NỢ KHÁCH HÀNG (AR Aging) — dùng chung 2 mô hình
//  Xưởng: theo đợt thanh toán đã đến mốc của từng đơn (cọc, giao hàng, nghiệm thu)
//  Thương mại: theo đơn hàng đã duyệt chưa thanh toán đủ, hạn = ngày đơn + số ngày công nợ
// =====================================================================

type ArItem = { key: string; customerId: string; customer: string; phone?: string; docCode: string; docLabel: string; docDate: string; dueDate: string; amount: number; paid: number; outstanding: number; jobId?: string };
type ArBucketDef = { id: string; label: string; short: string; color: string; tone: Tone; max: number };
const AGING: Record<AgingScheme, { label: string; basis: 'doc' | 'due'; note: string; buckets: ArBucketDef[] }> = {
  AGE_30_60: {
    label: 'Theo tuổi nợ: Trong hạn < 30 · Quá hạn 31–60 · Nợ xấu > 60 ngày', basis: 'doc', note: 'Tuổi nợ tính từ ngày chứng từ (ngày đơn hàng / mốc thanh toán).',
    buckets: [
      { id: 'CURRENT', label: 'Trong hạn (≤ 30 ngày)', short: 'Trong hạn', color: '#00B894', tone: 'teal', max: 30 },
      { id: 'OVER', label: 'Quá hạn (31–60 ngày)', short: '31–60 ngày', color: '#F28C33', tone: 'orange', max: 60 },
      { id: 'BAD', label: 'Nợ xấu (> 60 ngày)', short: '> 60 ngày', color: '#EF4444', tone: 'red', max: Infinity },
    ],
  },
  OVERDUE_15_30: {
    label: 'Theo ngày quá hạn: Trong hạn · 1–15 · 16–30 · > 30 ngày', basis: 'due', note: 'Số ngày quá hạn tính từ hạn thanh toán.',
    buckets: [
      { id: 'CURRENT', label: 'Trong hạn', short: 'Trong hạn', color: '#00B894', tone: 'teal', max: 0 },
      { id: 'D15', label: 'Quá hạn 1–15 ngày', short: '1–15 ngày', color: '#F9C25A', tone: 'orange', max: 15 },
      { id: 'D30', label: 'Quá hạn 16–30 ngày', short: '16–30 ngày', color: '#F28C33', tone: 'orange', max: 30 },
      { id: 'BAD', label: 'Nợ xấu > 30 ngày', short: '> 30 ngày', color: '#EF4444', tone: 'red', max: Infinity },
    ],
  },
};
const addDaysISO = (d: string, n: number) => iso(new Date(Date.parse(`${d.slice(0, 10)}T12:00:00`) + n * 864e5));
const overdueDays = (due: string, today: string) => Math.round((Date.parse(`${today}T12:00:00`) - Date.parse(`${due}T12:00:00`)) / 864e5);

/** Xưởng: mỗi đợt thanh toán đã đến mốc là 1 khoản phải thu; tiền kế toán đã xác nhận phân bổ lần lượt từ đợt đầu */
function mfgArItems(jobs: Job[], receipts: Receipt[], installs: InstallJob[], customers: Customer[], cfg: MfgConfig): ArItem[] {
  const out: ArItem[] = [];
  const order: PayTrigger[] = ['SIGN', 'DELIVERY', 'ACCEPT'];
  for (const j of jobs) {
    if (!j.wonAt || j.lostAt || !j.contractValue) continue;
    const ins = installs.filter((i) => i.jobId === j.id);
    const firstInstall = ins.map((i) => i.from).filter(Boolean).sort()[0];
    const acc = ins.find((i) => i.acceptance)?.acceptance?.at;
    const dateOf = (t: PayTrigger) => (t === 'SIGN' ? j.wonAt : t === 'DELIVERY' ? firstInstall?.slice(0, 10) : acc?.slice(0, 10));
    const stages = [...j.schedule].sort((a, b) => order.indexOf(a.trigger) - order.indexOf(b.trigger));
    let left = receipts.filter((r) => r.jobId === j.id && r.status === 'CONFIRMED').reduce((s, r) => s + r.amount, 0);
    let allocated = 0;
    stages.forEach((s, k) => {
      // Đợt cọc tính theo số tiền cọc thực nhận lúc chốt (khách có thể cọc lệch tỷ lệ); phần chênh dồn về đợt cuối
      const deposit = s.trigger === 'SIGN' ? receipts.filter((r) => r.jobId === j.id && r.stageId === s.id && r.status !== 'REJECTED').reduce((x, r) => x + r.amount, 0) : 0;
      const amount = k === stages.length - 1 ? j.contractValue! - allocated : deposit > 0 ? Math.min(deposit, j.contractValue! - allocated) : Math.round((j.contractValue! * s.pct) / 100);
      allocated += amount;
      const paid = Math.min(amount, left);
      left -= paid;
      const d = dateOf(s.trigger);
      if (!d || amount - paid <= 0) return;
      const c = customers.find((x) => x.id === j.customerId);
      out.push({ key: `${j.id}-${s.id}`, customerId: j.customerId, customer: jobCustName(j, customers), phone: jobPhone(j, customers) || c?.contactPhone, docCode: j.code, docLabel: `${s.label} ${s.pct}%: ${j.title}`,
        docDate: d, dueDate: addDaysISO(d, cfg.dueDays), amount, paid, outstanding: amount - paid, jobId: j.id });
    });
  }
  return out;
}
/** Thương mại: đơn hàng đã duyệt còn nợ; số ngày công nợ lấy theo hợp đồng gần nhất của khách, không có thì theo cấu hình */
function tradingArItems(orders: GetflyOrderRec[], customers: Customer[], docs: GeneratedDoc[], cfg: MfgConfig): ArItem[] {
  return orders.filter((o) => o.approved && o.gross > o.paid).map((o) => {
    const c = customers.find((x) => x.id === o.customerId);
    const contract = docs.filter((d) => d.customerId === o.customerId && d.status === 'APPROVED').sort((a, b) => b.createdAt.localeCompare(a.createdAt))[0];
    const days = contract?.form.creditDays ?? cfg.creditDays;
    return { key: o.orderCode, customerId: o.customerId, customer: c?.name ?? o.customerId, phone: c?.contactPhone, docCode: o.orderCode, docLabel: `Đơn hàng ${o.orderCode}, ${o.lines} dòng hàng (công nợ ${days} ngày)`,
      docDate: o.orderDate, dueDate: addDaysISO(o.orderDate, days), amount: o.gross, paid: o.paid, outstanding: o.gross - o.paid };
  });
}
function useArItems() {
  const { jobs, receipts, installJobs, customers, mfgConfig, getflyOrders, genDocs, company } = useApp();
  const mode = bizMode(company);
  return [...(mode !== 'TRADING' ? mfgArItems(jobs, receipts, installJobs, customers, mfgConfig) : []), ...(mode !== 'MFG' ? tradingArItems(getflyOrders, customers, genDocs, mfgConfig) : [])];
}

/** Biên bản đối chiếu công nợ (bản in) */
function arReconHtml(company: CompanyInfo, customer: Customer | undefined, name: string, items: ArItem[], today: string) {
  const total = items.reduce((s, x) => s + x.outstanding, 0);
  const rows = items.map((x, i) => {
    const od = overdueDays(x.dueDate, today);
    return `<tr><td class="c">${i + 1}</td><td>${esc(x.docCode)}<br><span class="small">${esc(x.docLabel)}</span></td><td class="c">${fmtDate(x.docDate)}</td><td class="c">${fmtDate(x.dueDate)}</td><td class="r">${x.amount.toLocaleString('vi-VN')}</td><td class="r">${x.paid.toLocaleString('vi-VN')}</td><td class="r"><b>${x.outstanding.toLocaleString('vi-VN')}</b></td><td class="c">${od > 0 ? `${od} ngày` : 'Trong hạn'}</td></tr>`;
  }).join('');
  const d = new Date(`${today}T12:00:00`);
  return `<p class="c"><b>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</b><br><b>Độc lập – Tự do – Hạnh phúc</b></p>
<h1>BIÊN BẢN ĐỐI CHIẾU CÔNG NỢ</h1><p class="c">Đến ngày ${fmtDate(today)}</p>
<p>Hôm nay, ngày ${d.getDate()} tháng ${d.getMonth() + 1} năm ${d.getFullYear()}, chúng tôi gồm:</p>
<p><b>BÊN BÁN: ${esc(company.legalName)}</b><br>Địa chỉ: ${esc(company.address)}${company.taxCode ? `<br>MST: ${esc(company.taxCode)}` : ''}${company.phone ? `<br>Điện thoại: ${esc(company.phone)}` : ''}</p>
<p><b>BÊN MUA: ${esc(customer?.name ?? name)}</b>${customer?.address ? `<br>Địa chỉ: ${esc(customer.address)}` : ''}${customer?.taxCode ? `<br>MST: ${esc(customer.taxCode)}` : ''}${customer?.contactPhone ? `<br>Điện thoại: ${esc(customer.contactPhone)}` : ''}</p>
<p>Cùng đối chiếu các khoản công nợ chưa thanh toán như sau (đơn vị: đồng):</p>
<table class="items"><thead><tr><th>STT</th><th>Chứng từ</th><th>Ngày</th><th>Hạn thanh toán</th><th>Giá trị</th><th>Đã thanh toán</th><th>Còn nợ</th><th>Quá hạn</th></tr></thead><tbody>${rows}
<tr><td colspan="6" class="r"><b>Tổng còn nợ</b></td><td class="r"><b>${total.toLocaleString('vi-VN')}</b></td><td></td></tr></tbody></table>
<p><b>Bằng chữ:</b> <i>${moneyToWordsVN(total)}</i></p>
<p>Đề nghị Bên mua kiểm tra, xác nhận và phản hồi trong 07 ngày kể từ ngày nhận biên bản. Quá thời hạn trên không có phản hồi, hai bên thống nhất số liệu công nợ như trên. Biên bản lập thành 02 bản, mỗi bên giữ 01 bản có giá trị như nhau.</p>
<table class="layout sign"><tr><td><b>ĐẠI DIỆN BÊN MUA</b><br>(Ký, ghi rõ họ tên, đóng dấu)<br><br><br><br></td><td><b>ĐẠI DIỆN BÊN BÁN</b><br>(Ký, ghi rõ họ tên, đóng dấu)<br><br><br><br><b>${esc(company.representative ?? '')}</b></td></tr></table>`;
}

function ArAgingPanel() {
  const { customers, company, openJob, audit, mfgConfig } = useApp();
  const sch = AGING[mfgConfig.agingScheme ?? 'AGE_30_60'];
  const bks = sch.buckets.map((b) => b.id);
  const bkm = Object.fromEntries(sch.buckets.map((b) => [b.id, b])) as Record<string, ArBucketDef>;
  const bucketOf = (n: number) => sch.buckets.find((b) => n <= b.max) ?? sch.buckets[sch.buckets.length - 1];
  const worst = bks[bks.length - 1];
  const items = useArItems();
  const today = todayISO();
  const [q, setQ] = useState('');
  const [bucket, setBucket] = useState<string>('ALL');
  const [open, setOpen] = useState<string | null>(null);
  const withAge = items.map((x) => { const d = overdueDays(x.dueDate, today); const age = sch.basis === 'doc' ? Math.max(0, overdueDays(x.docDate, today)) : d; return { ...x, days: d, age, bucket: bucketOf(age).id }; });
  const total = (b?: string) => withAge.filter((x) => !b || x.bucket === b).reduce((s, x) => s + x.outstanding, 0);
  const byCust = Array.from(new Set(withAge.map((x) => x.customerId))).map((id) => {
    const xs = withAge.filter((x) => x.customerId === id);
    const sums = Object.fromEntries(bks.map((b) => [b, xs.filter((x) => x.bucket === b).reduce((s, x) => s + x.outstanding, 0)])) as Record<string, number>;
    return { id, name: xs[0].customer, phone: xs[0].phone, xs, sums, total: xs.reduce((s, x) => s + x.outstanding, 0), maxDays: Math.max(...xs.map((x) => x.days)), maxAge: Math.max(...xs.map((x) => x.age)) };
  }).filter((r) => (!q.trim() || `${r.name} ${r.phone ?? ''}`.toLowerCase().includes(q.trim().toLowerCase())) && (bucket === 'ALL' || r.sums[bucket] > 0))
    .sort((a, b) => b.sums[worst] - a.sums[worst] || b.maxAge - a.maxAge || b.total - a.total);
  const print = (r: (typeof byCust)[number]) => {
    const cust = customers.find((c) => c.id === r.id);
    printHtml(docShell(`Đối chiếu công nợ ${r.name}`, arReconHtml(company, cust, r.name, r.xs, today)));
    audit('AR_RECON_PRINT', `In biên bản đối chiếu công nợ ${r.name}: ${vnd(r.total)}`);
  };
  const grand = total();
  return (
    <div className="space-y-4">
      <div className={cn('grid grid-cols-2 gap-3', bks.length === 3 ? 'lg:grid-cols-4' : 'lg:grid-cols-5')}>
        <button className={cn('rounded-md border p-4 text-left', bucket === 'ALL' ? 'border-[#F28C33] bg-[#F28C33]/10' : 'border-[#263044] bg-[#151C29] hover:bg-[#1C2534]')} onClick={() => setBucket('ALL')}>
          <p className="text-xs text-[#94A3B8]">Tổng phải thu</p><p className="mt-1 text-xl font-semibold tabular-nums">{compact(grand)}</p><p className="text-xs text-[#94A3B8]">{withAge.length} khoản, {new Set(withAge.map((x) => x.customerId)).size} khách</p>
        </button>
        {bks.map((b) => (
          <button key={b} className={cn('rounded-md border p-4 text-left', bucket === b ? 'border-[#F28C33] bg-[#F28C33]/10' : 'border-[#263044] bg-[#151C29] hover:bg-[#1C2534]')} onClick={() => setBucket(bucket === b ? 'ALL' : b)}>
            <p className="flex items-center gap-1.5 text-xs text-[#94A3B8]"><i className="h-2 w-2 rounded-full" style={{ background: bkm[b].color }} />{bkm[b].label}</p>
            <p className="mt-1 text-xl font-semibold tabular-nums" style={{ color: b === bks[0] ? undefined : bkm[b].color }}>{compact(total(b))}</p>
            <p className="text-xs text-[#94A3B8]">{pct(total(b), grand)} tổng nợ</p>
          </button>
        ))}
      </div>
      {grand > 0 && (
        <div className="flex h-3 overflow-hidden rounded-full bg-[#1C2534]" aria-label="Cơ cấu tuổi nợ">
          {bks.map((b) => <div key={b} style={{ width: `${(total(b) / grand) * 100}%`, background: bkm[b].color }} title={`${bkm[b].label}: ${vnd(total(b))}`} />)}
        </div>
      )}
      <Panel>
        <div className="mb-3 flex flex-wrap items-center gap-2">
          <SearchBox value={q} onChange={setQ} placeholder="Tìm khách hàng, số điện thoại" />
          <button className={cn(btnGhost, btnSm)} onClick={() => downloadCsv(`tuoi-no-${today}.csv`, [['Khách hàng', 'SĐT', 'Chứng từ', 'Diễn giải', 'Ngày', 'Hạn', 'Giá trị', 'Đã thu', 'Còn nợ', 'Tuổi nợ (ngày)', 'Quá hạn (ngày)', 'Nhóm'], ...withAge.map((x) => [x.customer, x.phone ?? '', x.docCode, x.docLabel, x.docDate, x.dueDate, x.amount, x.paid, x.outstanding, x.age, Math.max(0, x.days), bkm[x.bucket].label])])}><Download className="h-3.5 w-3.5" aria-hidden />Xuất CSV</button>
        </div>
        <Table head={['Khách hàng', <span key="t" className="block text-right">Tổng còn nợ</span>, ...bks.map((b) => <span key={b} className="block text-right">{bkm[b].short}</span>), sch.basis === 'doc' ? 'Tuổi nợ lớn nhất' : 'Quá hạn lâu nhất', '']} minW={1080}>
          {byCust.map((r) => (
            <Fragment key={r.id}>
              <tr className={cn(rowCls, 'cursor-pointer')} onClick={() => setOpen(open === r.id ? null : r.id)}>
                <td className={tdFirst}><p className="flex items-center gap-1.5 font-medium">{open === r.id ? <ChevronDown className="h-4 w-4 text-[#94A3B8]" aria-hidden /> : <ChevronRight className="h-4 w-4 text-[#94A3B8]" aria-hidden />}{r.name}</p><p className="pl-5 text-xs text-[#94A3B8]">{r.phone} · {r.xs.length} khoản</p></td>
                <td className={cn(tdCls, 'text-right font-semibold tabular-nums')}>{r.total.toLocaleString('vi-VN')}</td>
                {bks.map((b) => <td key={b} className={cn(tdCls, 'text-right tabular-nums')} style={{ color: r.sums[b] && b !== bks[0] ? bkm[b].color : undefined }}>{r.sums[b] ? r.sums[b].toLocaleString('vi-VN') : '—'}</td>)}
                <td className={cn(tdCls, 'whitespace-nowrap text-xs')}>{sch.basis === 'doc' ? <Chip tone={bucketOf(r.maxAge).tone}>{r.maxAge} ngày{r.maxDays > 0 ? `, quá hạn ${r.maxDays}` : ''}</Chip> : r.maxDays > 0 ? <Chip tone={bucketOf(r.maxDays).tone}>{r.maxDays} ngày</Chip> : <span className="text-[#3DDBB6]">Trong hạn</span>}</td>
                <td className={tdLast}><button className={cn(btnGhost, btnSm, 'whitespace-nowrap')} onClick={(e) => { e.stopPropagation(); print(r); }}><FileText className="h-3.5 w-3.5" aria-hidden />In biên bản đối chiếu công nợ</button></td>
              </tr>
              {open === r.id && r.xs.map((x) => (
                <tr key={x.key} className="border-b border-[#263044]/40 bg-[#1C2534]/40 text-xs">
                  <td className={cn(tdFirst, 'pl-12')}><button className="text-left hover:text-[#F7B23B]" onClick={() => x.jobId && openJob(x.jobId)}><b className="font-mono">{x.docCode}</b><span className="block text-[#94A3B8]">{x.docLabel}</span></button></td>
                  <td className={cn(tdCls, 'text-right tabular-nums')}>{x.outstanding.toLocaleString('vi-VN')}<span className="block text-[#94A3B8]">/ {x.amount.toLocaleString('vi-VN')}</span></td>
                  <td className={tdCls} colSpan={4}>Ngày {fmtDate(x.docDate)}, hạn {fmtDate(x.dueDate)}</td>
                  <td className={tdCls}><Chip tone={bkm[x.bucket].tone}>{sch.basis === 'doc' ? `${x.age} ngày tuổi` : ''}{sch.basis === 'doc' ? ', ' : ''}{x.days > 0 ? `quá hạn ${x.days} ngày` : x.days === 0 ? 'đến hạn hôm nay' : `còn ${-x.days} ngày`}</Chip></td>
                  <td className={tdLast} />
                </tr>
              ))}
            </Fragment>
          ))}
        </Table>
        {!byCust.length && <EmptyState text={<>Không có công nợ {bucket === 'ALL' ? '' : `nhóm "${bkm[bucket].label}"`}.</>} art="ledger" />}
        <p className="mt-3 text-xs text-[#94A3B8]">{sch.label}. {sch.note} Đổi cách nhóm ở Cài đặt › Kế toán & công nợ. Chỉ tính tiền kế toán đã xác nhận. {bizMode(company) !== 'TRADING' ? 'Khoản phải thu phát sinh khi đơn đến mốc thanh toán (cọc, giao / lắp, nghiệm thu), hạn = ngày mốc + số ngày thanh toán trong Cài đặt.' : 'Hạn = ngày đơn hàng + số ngày công nợ trên hợp đồng của khách (không có thì theo cấu hình).'}</p>
      </Panel>
    </div>
  );
}

// =====================================================================
//  QUYẾT TOÁN HOA HỒNG (ALUX): chỉ tính khi kế toán đã xác nhận thu đủ 100% đơn hàng
//  Sales / kỹ thuật phụ trách: % giá trị trước VAT; đội lắp (đội trưởng + thành viên): % chia đều
// =====================================================================

type CommissionRow = {
  j: Job; base: number; confirmed: number; pctPaid: number; status: 'PAID' | 'READY' | 'WAIT';
  lines: { userId: string; role: 'SALES' | 'INSTALL'; amount: number }[]; total: number; fullAt?: number;
};
function commissionRows(jobs: Job[], receipts: Receipt[], installs: InstallJob[], cfg: MfgConfig): CommissionRow[] {
  return jobs.filter((j) => j.wonAt && !j.lostAt && j.contractValue).map((j) => {
    const q = wonQuoteOf(j);
    const base = q ? q.subtotal : Math.round((j.contractValue ?? 0) / (1 + j.vatPct / 100));
    const conf = receipts.filter((r) => r.jobId === j.id && r.status === 'CONFIRMED');
    const confirmed = conf.reduce((s, r) => s + r.amount, 0);
    const pctPaid = j.contractValue ? Math.min(100, (confirmed / j.contractValue) * 100) : 0;
    const crew = Array.from(new Set(installs.filter((i) => i.jobId === j.id && i.status === 'ACCEPTED').flatMap((i) => [i.leaderId, ...i.team]).filter((x): x is string => !!x)));
    const lines = j.commission?.lines ?? [
      ...(j.ownerId ? [{ userId: j.ownerId, role: 'SALES' as const, amount: Math.round((base * cfg.salesCommissionPct) / 100) }] : []),
      ...crew.map((u) => ({ userId: u, role: 'INSTALL' as const, amount: Math.round((base * cfg.installCommissionPct) / 100 / crew.length) })),
    ];
    const full = confirmed >= (j.contractValue ?? 0);
    const fullAt = full ? Math.max(...conf.map((r) => r.confirmedAt ?? 0)) : undefined;
    return { j, base: j.commission?.base ?? base, confirmed, pctPaid, status: j.commission ? 'PAID' : full ? 'READY' : 'WAIT', lines, total: lines.reduce((s, l) => s + l.amount, 0), fullAt };
  });
}
const COMMISSION_STATUS: Record<CommissionRow['status'], { label: string; tone: Tone }> = {
  PAID: { label: 'Đã chi hoa hồng', tone: 'teal' },
  READY: { label: 'Đủ điều kiện, chờ chi', tone: 'orange' },
  WAIT: { label: 'Chưa thu đủ 100%', tone: 'muted' },
};

function CommissionPanel() {
  const { jobs, setJobs, receipts, installJobs, mfgConfig, customers, userName, canDo, role, me, postCash, audit, notify, openJob } = useApp();
  const inR = useInRange();
  const [st, setSt] = useState<'ALL' | CommissionRow['status']>('READY');
  const [pay, setPay] = useState<CommissionRow[] | null>(null);
  const [account, setAccount] = useState<CashAccount>('BANK');
  const canPay = canDo('cash.manage');
  const seeAll = canPay || role === 'BOD' || role === 'ACCOUNTANT';
  const all = commissionRows(jobs, receipts, installJobs, mfgConfig).filter((r) => seeAll || r.lines.some((l) => l.userId === me.id))
    .map((r) => (seeAll ? r : { ...r, lines: r.lines.filter((l) => l.userId === me.id), total: r.lines.filter((l) => l.userId === me.id).reduce((s, l) => s + l.amount, 0) }));
  const rows = all.filter((r) => (st === 'ALL' || r.status === st) && (r.status !== 'PAID' || inR(new Date(r.j.commission!.paidAt))));
  const sum = (s: CommissionRow['status']) => all.filter((r) => r.status === s && (s !== 'PAID' || inR(new Date(r.j.commission!.paidAt)))).reduce((x, r) => x + r.total, 0);
  const paged = usePaged(rows, 20);
  const doPay = () => {
    if (!pay) return;
    const at = Date.now();
    for (const r of pay) {
      setJobs((all2) => all2.map((j) => (j.id === r.j.id ? { ...j, commission: { paidAt: at, by: me.id, base: r.base, lines: r.lines } } : j)));
      r.lines.forEach((l) => postCash({ kind: 'OUT', account, category: 'Hoa hồng', amount: l.amount, partner: userName(l.userId), jobId: r.j.id, ref: r.j.code, note: `Hoa hồng ${l.role === 'SALES' ? 'sales / kỹ thuật' : 'lắp đặt'} đơn ${r.j.code}`, source: 'COMMISSION', sourceId: `${r.j.id}:${l.userId}:${l.role}` }));
      audit('COMMISSION_PAY', `${r.j.code}: chi hoa hồng ${vnd(r.total)} cho ${r.lines.length} người`, 'WARN');
    }
    notify(`Đã quyết toán hoa hồng ${pay.length} đơn, tự sinh ${pay.reduce((s, r) => s + r.lines.length, 0)} phiếu chi vào sổ quỹ`, 'teal');
    setPay(null);
  };
  const ready = all.filter((r) => r.status === 'READY');
  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Đủ điều kiện, chờ chi" value={compact(sum('READY'))} icon={Banknote} color={C.orange} sub={`${ready.length} đơn đã thu đủ 100%`} />
        <StatCard label="Đã chi trong kỳ" value={compact(sum('PAID'))} icon={CheckCircle2} color={C.teal} />
        <StatCard label="Chưa đủ điều kiện" value={compact(sum('WAIT'))} icon={Clock} color={C.muted} sub="Chờ khách thanh toán đủ" />
        <StatCard label="Tỷ lệ hoa hồng" value={`${mfgConfig.salesCommissionPct}% + ${mfgConfig.installCommissionPct}%`} icon={BadgePercent} sub="Sales / kỹ thuật + đội lắp, trên giá trị trước VAT" />
      </div>
      <Panel>
        <div className="mb-3 flex flex-wrap items-center gap-2">
          <StagePills items={[{ id: 'READY' as const, label: 'Chờ chi', count: ready.length }, { id: 'WAIT' as const, label: 'Chưa đủ điều kiện', count: all.filter((r) => r.status === 'WAIT').length }, { id: 'PAID' as const, label: 'Đã chi', count: all.filter((r) => r.status === 'PAID').length }, { id: 'ALL' as const, label: 'Tất cả', count: all.length }]} value={st} onChange={(v) => { setSt(v); paged.setPage(1); }} />
          {canPay && ready.length > 0 && <button className={cn(btnPrimary, btnSm, 'ml-auto')} onClick={() => setPay(ready)}><Banknote className="h-3.5 w-3.5" aria-hidden />Quyết toán tất cả ({ready.length} đơn, {compact(ready.reduce((s, r) => s + r.total, 0))})</button>}
        </div>
        <Table head={['STT', 'Đơn hàng', <span key="b" className="block text-right">Giá trị tính HH</span>, 'Đã xác nhận thu', 'Người nhận', <span key="t" className="block text-right">Tổng hoa hồng</span>, 'Trạng thái', '']} minW={1120}>
          {paged.slice.map((r, i) => (
            <tr key={r.j.id} className={rowCls}>
              <td className={cn(tdFirst, 'w-12 tabular-nums text-[#94A3B8]')}>{(paged.page - 1) * 20 + i + 1}</td>
              <td className={cn(tdCls, 'max-w-[220px]')}><button className="max-w-full text-left hover:text-[#F7B23B]" onClick={() => openJob(r.j.id)}><p className="truncate font-medium">{jobCustName(r.j, customers)}</p><p className="truncate text-xs text-[#94A3B8]">{r.j.code}, {r.j.title}</p></button></td>
              <td className={cn(tdCls, 'text-right tabular-nums')}>{r.base.toLocaleString('vi-VN')}</td>
              <td className={cn(tdCls, 'min-w-[120px]')}>
                <div className="flex items-center gap-2"><div className="h-1.5 flex-1 overflow-hidden rounded-full bg-[#1C2534]"><div className="h-full rounded-full" style={{ width: `${r.pctPaid}%`, background: r.pctPaid >= 100 ? C.teal : C.orange }} /></div><span className="text-xs tabular-nums">{r.pctPaid.toFixed(0)}%</span></div>
                {r.fullAt ? <p className="mt-0.5 text-[11px] text-[#94A3B8]">Thu đủ {new Date(r.fullAt).toLocaleDateString('vi-VN')}</p> : null}
              </td>
              <td className={cn(tdCls, 'min-w-[220px] text-xs')}>
                {r.lines.length ? r.lines.map((l) => <p key={`${l.userId}${l.role}`} className="flex justify-between gap-3"><span className="whitespace-nowrap">{userName(l.userId)} <span className="text-[#94A3B8]">({l.role === 'SALES' ? 'sales' : 'lắp đặt'})</span></span><span className="whitespace-nowrap tabular-nums">{compact(l.amount)}</span></p>) : <span className="text-[#94A3B8]">Chưa có người nhận (chưa nghiệm thu)</span>}
              </td>
              <td className={cn(tdCls, 'text-right font-semibold tabular-nums')}>{r.total.toLocaleString('vi-VN')}</td>
              <td className={cn(tdCls, 'whitespace-nowrap')}><Chip tone={COMMISSION_STATUS[r.status].tone}>{COMMISSION_STATUS[r.status].label}</Chip>{r.status === 'PAID' && <p className="mt-0.5 text-[11px] text-[#94A3B8]">{new Date(r.j.commission!.paidAt).toLocaleDateString('vi-VN')}, {userName(r.j.commission!.by)}</p>}</td>
              <td className={tdLast}>{r.status === 'READY' && canPay && <button className={cn(btnGhost, btnSm, 'whitespace-nowrap')} onClick={() => setPay([r])}>Chi hoa hồng</button>}</td>
            </tr>
          ))}
        </Table>
        {!rows.length && <EmptyState text={<>Không có đơn ở trạng thái này.</>} art="box" />}
        <Pagination paged={paged} unit="đơn" />
        <p className="mt-3 text-xs text-[#94A3B8]">Hoa hồng chỉ đủ điều kiện khi kế toán đã xác nhận thu đủ 100% giá trị hợp đồng. Đổi tỷ lệ ở Cài đặt &gt; Kế toán & công nợ; đơn đã quyết toán giữ nguyên số đã chi.</p>
      </Panel>
      {pay && (
        <Modal title={`Quyết toán hoa hồng ${pay.length} đơn`} onClose={() => setPay(null)} footer={<><button className={btnGhost} onClick={() => setPay(null)}>Hủy</button><button className={btnPrimary} onClick={doPay}>Xác nhận chi {vnd(pay.reduce((s, r) => s + r.total, 0))}</button></>}>
          <ul className="max-h-64 space-y-1.5 overflow-y-auto">
            {pay.map((r) => <li key={r.j.id} className="rounded bg-[#1C2534] px-3 py-2 text-sm"><p className="flex justify-between gap-2"><b>{r.j.code}</b><span className="tabular-nums">{vnd(r.total)}</span></p><p className="text-xs text-[#94A3B8]">{r.lines.map((l) => `${userName(l.userId)} ${compact(l.amount)}`).join(', ')}</p></li>)}
          </ul>
          <Field label="Chi từ" className="mt-4"><select className={inputCls} value={account} onChange={(e) => setAccount(e.target.value as CashAccount)}>{(Object.keys(CASH_ACCOUNT) as CashAccount[]).map((a) => <option key={a} value={a}>{CASH_ACCOUNT[a]}</option>)}</select></Field>
          <p className="mt-2 text-xs text-[#94A3B8]">Mỗi người nhận một phiếu chi "Hoa hồng" tự sinh trong sổ quỹ, gắn vào chi phí của đơn.</p>
        </Modal>
      )}
    </div>
  );
}

// =====================================================================
//  QUYẾT TOÁN QUỸ MDF (VASSH): 3M duyệt -> hóa đơn VAT đầu vào -> Credit Note -> cấn trừ PO; hạch toán thặng dư vào sổ quỹ
// =====================================================================

function MdfSettlementPanel({ claim }: { claim: Claim }) {
  const { setClaims, pos, canDo, postCash, audit, notify, cashEntries } = useApp();
  const [account, setAccount] = useState<CashAccount>('BANK');
  const f = claimFinance(claim);
  const can = canDo('claim.accounting');
  const update = (p: Partial<Claim>) => setClaims((all) => all.map((c) => (c.id === claim.id ? { ...c, ...p } : c)));
  const po = pos.find((p) => p.id === claim.offsetPoId);
  const posted = cashEntries.find((e) => e.id === claim.surplusEntryId || (e.source === 'MDF_SURPLUS' && e.sourceId === claim.id));
  const surplus = f.settlement === 'LUMP_SUM' ? Math.max(0, f.mdfMargin) : 0;
  const steps: { label: string; value: ReactNode; done: boolean; note?: string }[] = [
    { label: 'Tiền Hãng duyệt', value: claim.vendorApproved != null ? vnd(claim.vendorApproved) : 'Chưa duyệt', done: claim.vendorApproved != null, note: `Claim ${vnd(claim.claimed)}` },
    { label: 'Hóa đơn VAT đầu vào', value: claim.invoice ? vnd(claim.invoice.amount) : 'Chưa có', done: !!claim.invoice, note: claim.invoice ? `${claim.invoice.serial}-${claim.invoice.number}, ${claim.vatCheck === 'MATCHED' ? 'khớp' : claim.vatCheck === 'MISMATCH' ? 'lệch' : 'chưa đối soát'}` : undefined },
    { label: 'Credit Note từ 3M', value: claim.creditNote ? vnd(claim.creditNote.amount) : 'Chưa nhận', done: !!claim.creditNote, note: claim.creditNote ? `Số ${claim.creditNote.number}, ${fmtDate(claim.creditNote.date)}` : undefined },
    { label: 'Cấn trừ PO nhập khẩu', value: po ? po.code : claim.offset ? 'Đã cấn trừ' : 'Chưa cấn trừ', done: !!po || !!claim.offset, note: po ? `${po.vendor}, đặt ${fmtDate(po.orderDate)}` : undefined },
  ];
  const postSurplus = () => {
    if (surplus <= 0) return;
    const sourceId = claim.id;
    postCash({ kind: 'IN', account, category: 'Thặng dư quỹ MDF', amount: surplus, partner: '3M Việt Nam', ref: claim.code, note: `Thặng dư ${claim.code} (${SURPLUS_LABEL[claim.surplusAllocation ?? 'COMPANY_PROFIT'] ?? ''})`, source: 'MDF_SURPLUS', sourceId, claimId: claim.id });
    audit('MDF_SURPLUS_POST', `${claim.code}: hạch toán thặng dư ${vnd(surplus)} vào sổ quỹ`, 'WARN');
    notify(`Đã hạch toán thặng dư ${vnd(surplus)} vào sổ quỹ ${CASH_ACCOUNT[account].toLowerCase()}`, 'teal');
  };
  return (
    <section className="rounded-md border border-[#263044] p-4">
      <h3 className="mb-3 text-sm font-semibold">Quyết toán dòng tiền quỹ MDF</h3>
      <ol className="grid grid-cols-1 gap-2 sm:grid-cols-4">
        {steps.map((s, i) => (
          <li key={s.label} className={cn('rounded border p-2.5', s.done ? 'border-[#00B894]/40 bg-[#00B894]/5' : 'border-[#263044] bg-[#1C2534]')}>
            <p className="flex items-center gap-1.5 text-[11px] text-[#94A3B8]"><span className={cn('flex h-4 w-4 items-center justify-center rounded-full text-[9px] font-bold', s.done ? 'bg-[#00B894] text-[#0F141E]' : 'bg-[#263044] text-[#94A3B8]')}>{i + 1}</span>{s.label}</p>
            <p className="mt-1 text-sm font-semibold tabular-nums">{s.value}</p>
            {s.note && <p className="mt-0.5 text-[11px] text-[#94A3B8]">{s.note}</p>}
          </li>
        ))}
      </ol>
      <div className="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <Field label="Credit Note cấn trừ vào PO">
          <select className={inputCls} disabled={!can || !claim.creditNote} value={claim.offsetPoId ?? ''} onChange={(e) => { update({ offsetPoId: e.target.value || undefined, offset: !!e.target.value || claim.offset }); if (e.target.value) audit('MDF_OFFSET_PO', `${claim.code}: cấn trừ vào PO ${pos.find((p) => p.id === e.target.value)?.code}`); }}>
            <option value="">{claim.creditNote ? 'Chọn PO nhập khẩu...' : 'Chờ nhận Credit Note'}</option>
            {pos.filter((p) => !p.cancelled).map((p) => <option key={p.id} value={p.id}>{p.code}: {p.vendor}, {fmtDate(p.orderDate)}</option>)}
          </select>
        </Field>
        {canDo('mdf.margin') && (
          <div className="rounded bg-[#1C2534] p-3 text-sm">
            <p className="flex justify-between"><span className="text-[#94A3B8]">Thặng dư quỹ (MDF Profit Margin)</span><b className={cn('tabular-nums', surplus ? 'text-[#3DDBB6]' : '')}>{f.hasActual ? vnd(surplus) : 'Chưa nhập thực chi'}</b></p>
            {posted ? <p className="mt-1 text-xs text-[#3DDBB6]">Đã hạch toán vào sổ quỹ: {posted.code}, {fmtDate(posted.date)}</p>
              : surplus > 0 && (
                <div className="mt-2 flex flex-wrap items-center gap-2">
                  <select className={cn(inputCls, 'w-auto py-1 text-xs')} value={account} onChange={(e) => setAccount(e.target.value as CashAccount)} aria-label="Sổ quỹ">{(Object.keys(CASH_ACCOUNT) as CashAccount[]).map((a) => <option key={a} value={a}>{CASH_ACCOUNT[a]}</option>)}</select>
                  <button className={cn(btnPrimary, btnSm)} disabled={!can || !claim.creditNote} title={!claim.creditNote ? 'Hạch toán sau khi nhận Credit Note' : undefined} onClick={postSurplus}>Hạch toán vào sổ quỹ</button>
                </div>
              )}
          </div>
        )}
      </div>
    </section>
  );
}

/** Bảng tổng hợp quyết toán MDF toàn bộ claim (báo cáo kế toán VASSH) */
function MdfSettlementReport() {
  const { claims, pos, cashEntries, openClaim, canDo } = useApp();
  const rows = claims.filter((c) => c.submitted || c.vendorApproved != null || c.creditNote);
  const seeMargin = canDo('mdf.margin');
  const sum = (fn: (c: Claim) => number) => rows.reduce((s, c) => s + fn(c), 0);
  const surplusOf = (c: Claim) => { const f = claimFinance(c); return f.settlement === 'LUMP_SUM' ? Math.max(0, f.mdfMargin) : 0; };
  const R = (x: ReactNode) => <span className="block text-right">{x}</span>;
  return (
    <Panel title="Đối soát quỹ MDF & thặng dư (MDF Arbitrage)" action={<p className="text-xs text-[#94A3B8]">Mức 3M duyệt → Thực chi NCC (HĐ VAT) → Thặng dư giữ lại → Credit Note → Cấn trừ PO → Sổ quỹ</p>}>
      <Table head={['Claim / chương trình', R('Mức 3M duyệt'), R('Thực chi NCC (HĐ VAT)'), ...(seeMargin ? [R('Thặng dư giữ lại')] : []), 'Credit Note', 'Cấn trừ vào PO', ...(seeMargin ? ['Sổ quỹ'] : [])]} minW={1080}>
        {rows.map((c) => {
          const f = claimFinance(c);
          const posted = cashEntries.find((e) => e.source === 'MDF_SURPLUS' && e.sourceId === c.id);
          const approved = c.vendorApproved ?? f.vendorApprovedBudget;
          const po = pos.find((p) => p.id === c.offsetPoId);
          const surplus = surplusOf(c);
          return (
            <tr key={c.id} className={cn(rowCls, 'cursor-pointer')} onClick={() => openClaim(c.id)}>
              <td className={tdFirst}><p className="font-mono text-xs text-[#F7B23B]">{c.code}</p><p className="max-w-[240px] truncate text-xs text-[#94A3B8]">{c.programTitle}</p></td>
              <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{approved ? approved.toLocaleString('vi-VN') : '—'}<span className="block text-[11px] text-[#94A3B8]">{f.settlement === 'LUMP_SUM' ? 'Khoán trọn gói' : 'Theo thực chi'}</span></td>
              <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{f.hasActual ? f.actualExecutionCost.toLocaleString('vi-VN') : '—'}{c.invoice && <span className={cn('block text-[11px]', c.vatCheck === 'MISMATCH' ? 'text-[#F87171]' : 'text-[#94A3B8]')}>HĐ VAT {c.invoice.amount.toLocaleString('vi-VN')}{c.vatCheck === 'MISMATCH' ? ' · lệch' : ''}</span>}</td>
              {seeMargin && <td className={cn(tdCls, 'whitespace-nowrap text-right font-semibold tabular-nums', surplus > 0 ? 'text-[#3DDBB6]' : 'text-[#94A3B8]')}>{surplus > 0 ? surplus.toLocaleString('vi-VN') : '—'}{surplus > 0 && approved > 0 && <span className="block text-[11px] font-normal">{((surplus / approved) * 100).toFixed(1)}%</span>}</td>}
              <td className={cn(tdCls, 'whitespace-nowrap text-xs')}>{c.creditNote ? <><Chip tone="teal">Đã nhận {compact(c.creditNote.amount)}</Chip><span className="mt-0.5 block text-[11px] text-[#94A3B8]">{c.creditNote.number}</span></> : <Chip tone="orange">Chờ Credit Note</Chip>}</td>
              <td className={cn(tdCls, 'whitespace-nowrap text-xs')}>{c.offset || po ? <Chip tone="teal">{po?.code ?? 'Đã cấn trừ'}</Chip> : c.creditNote ? <Chip tone="orange">Chưa cấn trừ</Chip> : <span className="text-[#94A3B8]">—</span>}</td>
              {seeMargin && <td className={cn(tdLast, 'whitespace-nowrap text-xs')}>{posted ? <Chip tone="teal">{posted.code}</Chip> : surplus > 0 ? <Chip tone="orange">Chưa hạch toán</Chip> : '—'}</td>}
            </tr>
          );
        })}
        {rows.length > 0 && (
          <tr className="border-t border-[#263044] font-semibold">
            <td className={tdFirst}>Cộng {rows.length} claim</td>
            <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{sum((c) => c.vendorApproved ?? claimFinance(c).vendorApprovedBudget).toLocaleString('vi-VN')}</td>
            <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{sum((c) => claimFinance(c).actualExecutionCost).toLocaleString('vi-VN')}</td>
            {seeMargin && <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-[#3DDBB6]')}>{sum(surplusOf).toLocaleString('vi-VN')}</td>}
            <td className={cn(tdCls, 'whitespace-nowrap text-xs tabular-nums')}>{compact(sum((c) => c.creditNote?.amount ?? 0))}</td>
            <td className={tdCls} />
            {seeMargin && <td className={tdLast} />}
          </tr>
        )}
      </Table>
      {!rows.length && <EmptyState text={<>Chưa có claim đã nộp Hãng.</>} art="doc" />}
    </Panel>
  );
}

// =====================================================================
//  TRUNG TÂM PHÊ DUYỆT & CÔNG VIỆC
//  Gom mọi yêu cầu duyệt: giá báo giá / hợp đồng, công tác & giải trình công,
//  chi & claim quỹ MDF, phân lead; duyệt nhanh ngay trên thẻ, đếm ngược SLA
// =====================================================================

type HubGroup = 'PRICE' | 'WORK' | 'MDF' | 'LEAD' | 'CASH' | 'STOCK';
const HUB_GROUP: Record<HubGroup, { label: string; color: string; kinds: ApprovalKind[] }> = {
  PRICE: { label: 'Giá & chiết khấu', color: '#F28C33', kinds: ['QUOTE', 'CONTRACT'] },
  WORK: { label: 'Công tác & giải trình công', color: '#1F74D4', kinds: ['ACTIVITY', 'EXPENSE'] },
  MDF: { label: 'Chi & claim quỹ MDF', color: '#8B5CF6', kinds: ['PROGRAM', 'CLAIM'] },
  LEAD: { label: 'Phân lead', color: '#00B894', kinds: ['LEAD_ASSIGN'] },
  CASH: { label: 'Thu tiền & nộp quỹ', color: '#EC4899', kinds: ['RECEIPT', 'CASH'] },
  STOCK: { label: 'Hàng giữ chỗ', color: '#F6B533', kinds: ['STOCK'] },
};
const groupOf = (k: ApprovalKind) => (Object.keys(HUB_GROUP) as HubGroup[]).find((g) => HUB_GROUP[g].kinds.includes(k)) ?? 'STOCK';
const HUB_KIND: Record<ApprovalKind, string> = {
  QUOTE: 'Duyệt giá báo giá', CONTRACT: 'Duyệt hợp đồng', ACTIVITY: 'Duyệt công tác / công', EXPENSE: 'Duyệt chi phí công tác',
  PROGRAM: 'Duyệt đề xuất chi quỹ', CLAIM: 'Nghiệm thu POP / hóa đơn', LEAD_ASSIGN: 'Chỉ định Sales', STOCK: 'Giải phóng hàng giữ chỗ',
  RECEIPT: 'Xác nhận tiền thu', CASH: 'Nộp tiền về kế toán',
};
/** Nhãn ngắn cho cột "Phân loại" của bảng hợp nhất */
const HUB_SHORT: Record<ApprovalKind, string> = {
  QUOTE: 'Duyệt báo giá', CONTRACT: 'Duyệt hợp đồng', ACTIVITY: 'Công tác / công', EXPENSE: 'Chi phí công tác', PROGRAM: 'Đề xuất quỹ',
  CLAIM: 'Claim / POP', LEAD_ASSIGN: 'Chỉ định Sales', STOCK: 'Hàng giữ chỗ', RECEIPT: 'Xác nhận thu', CASH: 'Nộp quỹ',
};
/** SLA xử lý (phút) theo loại yêu cầu */
const HUB_SLA: Record<ApprovalKind, number> = { QUOTE: 120, CONTRACT: 480, ACTIVITY: 240, EXPENSE: 2880, PROGRAM: 1440, CLAIM: 2880, LEAD_ASSIGN: 60, STOCK: 1440, RECEIPT: 240, CASH: 1440 };
const DECISION_LABEL: Record<ApprovalDecision, { label: string; tone: Tone }> = {
  APPROVED: { label: 'Đã duyệt', tone: 'teal' }, REJECTED: { label: 'Từ chối', tone: 'red' }, NEED_INFO: { label: 'Yêu cầu bổ sung', tone: 'orange' },
};

type HubItem = {
  key: string; kind: ApprovalKind; refId: string; title: string; sub: string; reason?: string;
  requesterId?: string; deptCode?: DeptCode; requestedAt: number; slaMin: number; amount?: number; flagged?: string;
  approveLabel?: string; nextStep?: string;
  approve?: () => void; reject?: (note: string) => void; needInfo?: (note: string) => void; view?: () => void;
  /** Thao tác riêng thay cho nút duyệt (vd. chọn Sales khi chỉ định lead) */
  custom?: ReactNode;
  /** Chọn nhanh 1 người / phương án ngay trong bảng (menu gọn thay cho ô chọn) */
  pick?: { label: string; options: { id: string; label: string }[]; onPick: (id: string) => void };
};
type MineItem = { key: string; kind: ApprovalKind; title: string; sub: string; status: 'PENDING' | ApprovalDecision; requestedAt: number; slaMin: number; deciderId?: string; note?: string; view?: () => void };

const dayStart = (iso: string) => Date.parse(`${iso.slice(0, 10)}T08:00:00`);
function slaInfo(requestedAt: number, slaMin: number, now: number) {
  const deadline = requestedAt + slaMin * 60_000;
  const left = deadline - now;
  const abs = Math.abs(left);
  const d = Math.floor(abs / 864e5), h = Math.floor((abs % 864e5) / 3.6e6), m = Math.max(1, Math.round((abs % 3.6e6) / 60_000));
  const span = d ? `${d} ngày${h ? ` ${h} giờ` : ''}` : h ? `${h} giờ${m && m < 60 ? ` ${m} phút` : ''}` : `${m} phút`;
  const ratio = left / (slaMin * 60_000);
  return { text: left >= 0 ? `Còn ${span}` : `Quá hạn ${span}`, overdue: left < 0, tight: left >= 0 && ratio < 0.25, deadline };
}

/** Xây hàng đợi duyệt của người đang đăng nhập và danh sách yêu cầu họ đã gửi */
function useApprovalQueue() {
  const app = useApp();
  const { me, role, canDo, users, leads, quotes, setQuotes, genDocs, setGenDocs, activities, setActivities, programs, setPrograms, setBudget, claims, setClaims,
    reservations, canRelease, customers, approvalLogs, logDecision, dispatch, notify, openComposer, openClaim, assignLead, setLeads, departments, userName,
    jobs, receipts, setReceipts, openJob, mfgConfig, audit } = app;
  const canApproveDoc = useContractApprover();
  const canApproveAct = useActivityApprover();
  const userOf = (id?: string) => users.find((u) => u.id === id);
  const tell = (to: string | undefined, title: string, body: string, module: Module = 'tasks') => { const u = userOf(to); if (u && u.id !== me.id) dispatch('APPROVAL_RESULT', { to: u, title, body, module }); };
  const done = (kind: ApprovalKind, refId: string, title: string, requesterId: string | undefined, decision: ApprovalDecision, note: string | undefined, amount: number | undefined, msg: string) => {
    logDecision({ kind, refId, title, requesterId, decision, note, amount });
    tell(requesterId, `${DECISION_LABEL[decision].label}: ${title}`, note ?? msg);
    notify(msg, decision === 'APPROVED' ? 'teal' : 'orange');
  };
  const leadOf = (id?: string) => leads.find((l) => l.id === id);
  const deptOfDoc = (d: GeneratedDoc) => leadOf(d.leadId)?.dept ?? customers.find((c) => c.id === d.customerId)?.dept;

  const todo: HubItem[] = [];

  // ---- Giá báo giá ----
  for (const q of quotes) {
    const a = q.approval;
    if (!a || a.status !== 'PENDING' || a.requestedBy === me.id) continue;
    const l = leadOf(q.leadId);
    const ok = canDo('quote.approve') && (a.level === 'BOD' ? role === 'BOD' : role === 'BOD' || (role === 'DEPT_HEAD' && l?.dept === me.dept));
    if (!ok) continue;
    const name = q.quoteForm?.party.name ?? l?.company ?? customers.find((c) => c.id === q.customerId)?.name ?? '';
    const title = `${q.code} v${q.version}: ${name}`;
    const set = (st: ApprovalDecision, note?: string) => setQuotes((p) => p.map((x) => (x.id === q.id ? { ...x, approval: { ...a, status: st, decidedBy: me.id, decidedAt: Date.now(), note } } : x)));
    todo.push({
      key: `q-${q.id}`, kind: 'QUOTE', refId: q.id, title, sub: `${compact(q.amount)} trước VAT${q.gmPct !== undefined && canDo('price.viewCost') ? `, GM ${q.gmPct.toFixed(1)}%` : ''}, cấp duyệt ${a.level === 'BOD' ? 'BOD' : 'Trưởng phòng'}`,
      reason: a.reasons.join('; '), requesterId: a.requestedBy, deptCode: l?.dept, requestedAt: a.requestedAt, slaMin: a.level === 'BOD' ? 240 : HUB_SLA.QUOTE, amount: q.amount,
      flagged: a.level === 'BOD' ? 'Cấp BOD' : undefined, nextStep: 'Mở khóa xuất PDF báo giá',
      approve: () => { set('APPROVED'); done('QUOTE', q.id, title, a.requestedBy, 'APPROVED', undefined, q.amount, `Đã duyệt giá ${q.code}. Báo giá được mở khóa xuất PDF.`); },
      reject: (n) => { set('REJECTED', n); done('QUOTE', q.id, title, a.requestedBy, 'REJECTED', n, q.amount, `Đã từ chối báo giá ${q.code}`); },
      needInfo: (n) => { set('NEED_INFO', n); done('QUOTE', q.id, title, a.requestedBy, 'NEED_INFO', n, q.amount, `Đã yêu cầu sửa báo giá ${q.code}`); },
      view: () => openComposer({ quoteId: q.id, leadId: q.leadId || undefined, mode: 'QUOTE' }),
    });
  }
  // ---- Hợp đồng ----
  for (const d of latestContracts(genDocs)) {
    if (d.status !== 'PENDING_APPROVAL' || !canApproveDoc(d) || d.createdBy === me.id && role !== 'BOD') continue;
    const title = `${d.contractCode} v${d.version ?? 1}: ${d.partyName}`;
    const set = (p: Partial<GeneratedDoc>) => setGenDocs((all) => all.map((x) => (x.id === d.id ? { ...x, ...p } : x)));
    todo.push({
      key: `c-${d.id}`, kind: 'CONTRACT', refId: d.id, title, sub: `${compact(d.total)} sau VAT`, reason: d.special.join('; '), requesterId: d.createdBy, deptCode: deptOfDoc(d),
      requestedAt: d.submittedAt ?? dayStart(d.createdAt), slaMin: HUB_SLA.CONTRACT, amount: d.total, nextStep: 'Hợp đồng có hiệu lực, xuất được PDF',
      approve: () => { set({ status: 'APPROVED', approvedBy: me.id, approvedAt: todayISO() }); done('CONTRACT', d.id, title, d.createdBy, 'APPROVED', undefined, d.total, `Đã duyệt hợp đồng ${d.contractCode}, có hiệu lực`); },
      reject: (n) => { set({ status: 'REJECTED', rejectNote: n }); done('CONTRACT', d.id, title, d.createdBy, 'REJECTED', n, d.total, `Đã từ chối hợp đồng ${d.contractCode}`); },
      view: () => openComposer({ docId: d.id, view: true }),
    });
  }
  // ---- Lịch công tác / nghỉ / giải trình ----
  for (const a of activities) {
    if (a.status !== 'PENDING_APPROVAL' || !canApproveAct(a)) continue;
    const owner = userOf(a.userId);
    const what = a.type === 'LEAVE' ? LEAVE_KIND[a.leaveKind ?? 'LEAVE'] : ACTIVITY_TYPE[a.type].label;
    const cust = customers.find((c) => c.id === a.customerId);
    const title = `${owner?.name ?? ''}: ${what}`;
    const set = (p: Partial<Activity>) => setActivities((all) => all.map((x) => (x.id === a.id ? { ...x, ...p } : x)));
    todo.push({
      key: `a-${a.id}`, kind: 'ACTIVITY', refId: a.id, title,
      sub: `${fmtDT(a.from)} – ${fmtDT(a.to)}${cust ? `, gặp ${cust.name}` : ''}${a.location ? `, ${a.location}` : ''}${a.cost ? `, đề xuất ${compact(a.cost)}${a.advance ? ` (tạm ứng ${compact(a.advance)})` : ''}` : ''}`,
      reason: a.note ? `${a.type === 'LEAVE' ? 'Lý do' : 'Mục tiêu'}: ${a.note}` : undefined, requesterId: a.userId, deptCode: owner?.dept,
      requestedAt: a.submittedAt ?? dayStart(a.createdAt), slaMin: a.type === 'LEAVE' && a.leaveKind && a.leaveKind !== 'LEAVE' ? 120 : HUB_SLA.ACTIVITY, amount: a.cost || undefined,
      flagged: a.type === 'LEAVE' && a.from.slice(0, 10) <= todayISO() ? 'Trong ngày' : undefined,
      nextStep: a.type === 'LEAVE' ? 'Ghi nhận phép / công' : 'Xác nhận công tác, tính công',
      approve: () => { set({ status: 'APPROVED', approvedBy: me.id }); const adv = advanceCash(a, users); if (adv) app.postCash(adv); done('ACTIVITY', a.id, title, a.userId, 'APPROVED', undefined, a.cost, `Đã duyệt: ${title}. ${adv ? `Tự sinh phiếu chi tạm ứng ${compact(adv.amount)}.` : 'Đã xác nhận công.'}`); },
      reject: (n) => { set({ status: 'REJECTED', rejectNote: n }); done('ACTIVITY', a.id, title, a.userId, 'REJECTED', n, a.cost, `Đã từ chối: ${title}`); },
      needInfo: (n) => { set({ status: 'NEED_INFO', requestNote: n }); done('ACTIVITY', a.id, title, a.userId, 'NEED_INFO', n, a.cost, `Đã yêu cầu bổ sung: ${title}`); },
    });
  }
  // ---- Chứng từ chi phí công tác ----
  for (const a of activities) {
    const head = a.expenseStatus === 'SUBMITTED' && canApproveAct(a);
    const acc = a.expenseStatus === 'HEAD_APPROVED' && canDo('claim.accounting');
    if (!head && !acc) continue;
    const owner = userOf(a.userId);
    const total = (a.expenses ?? []).reduce((s, x) => s + x.amount, 0);
    const title = `${owner?.name ?? ''}: chi phí ${a.title}`;
    const set = (p: Partial<Activity>) => setActivities((all) => all.map((x) => (x.id === a.id ? { ...x, ...p } : x)));
    todo.push({
      key: `e-${a.id}`, kind: 'EXPENSE', refId: a.id, title, sub: `${(a.expenses ?? []).length} chứng từ: ${(a.expenses ?? []).map((x) => x.name).join(', ')}`, requesterId: a.userId, deptCode: owner?.dept,
      requestedAt: a.expenseSubmittedAt ?? dayStart(a.to), slaMin: HUB_SLA.EXPENSE, amount: total,
      approveLabel: acc ? 'Xác nhận thanh toán' : 'Duyệt chi', nextStep: acc ? 'Ghi nhận đã thanh toán' : 'Chuyển Kế toán thanh toán',
      approve: () => { set({ expenseStatus: acc ? 'PAID' : 'HEAD_APPROVED' }); if (acc) app.postCash(expenseCash(a, users, app.cashEntries)); done('EXPENSE', a.id, title, a.userId, 'APPROVED', undefined, total, acc ? `Đã thanh toán ${compact(total)}` : `Đã duyệt chi ${compact(total)}, chuyển Kế toán`); },
      reject: (n) => { set({ expenseStatus: 'REJECTED', expenseNote: n }); done('EXPENSE', a.id, title, a.userId, 'REJECTED', n, total, 'Đã từ chối chứng từ chi phí'); },
    });
  }
  // ---- Đề xuất chi quỹ MDF (tạm ứng sự kiện, POSM...) ----
  for (const p of programs) {
    if (p.status !== 'PENDING_INTERNAL' || !canDo('program.approveInternal') || !(role === 'BOD' || (me.dept === p.dept && me.approvalLimit >= p.held))) continue;
    const title = `${p.code}: ${p.title}`;
    todo.push({
      key: `p-${p.id}`, kind: 'PROGRAM', refId: p.id, title, sub: `${progName(p.type)}, giữ chỗ quỹ ${compact(p.held)} (đề xuất ${compact(p.requested)}, Hãng tài trợ ${p.sharePct}%), ${fmtDate(p.start)}`,
      requesterId: p.requestedBy, deptCode: p.dept, requestedAt: p.requestedAt ?? dayStart(p.start) - 14 * 864e5, slaMin: HUB_SLA.PROGRAM, amount: p.held,
      flagged: p.held >= 50e6 ? 'Trên 50 triệu' : undefined, nextStep: 'Gửi 3M duyệt Pre-Approval',
      approve: () => { setPrograms((ps) => ps.map((x) => (x.id === p.id ? { ...x, status: 'PENDING_VENDOR', approvedBy: me.id } : x))); done('PROGRAM', p.id, title, p.requestedBy, 'APPROVED', undefined, p.held, `Đã duyệt nội bộ ${p.code}, chuyển gửi 3M`); },
      reject: (n) => { setBudget((b) => ({ ...b, committed: Math.max(0, b.committed - p.held) })); setPrograms((ps) => ps.map((x) => (x.id === p.id ? { ...x, held: 0, status: 'REJECTED' } : x))); done('PROGRAM', p.id, title, p.requestedBy, 'REJECTED', n, p.held, `Đã từ chối ${p.code}, nhả ${compact(p.held)} về quỹ`); },
    });
  }
  // ---- Claim: thẩm định POP / đối soát hóa đơn ----
  for (const c of claims) {
    const pendingProofs = c.proofs.filter((x) => x.verification === 'PENDING');
    const title = `${c.code}: ${c.programTitle}`;
    const prog = programs.find((x) => x.id === c.programId);
    if (!c.submitted && pendingProofs.length && canDo('claim.verify')) {
      const setP = (v: Verification) => setClaims((all) => all.map((x) => (x.id === c.id ? { ...x, proofs: x.proofs.map((pf) => (pf.verification === 'PENDING' ? { ...pf, verification: v } : pf)) } : x)));
      todo.push({
        key: `pop-${c.id}`, kind: 'CLAIM', refId: c.id, title, sub: `Thẩm định ${pendingProofs.length} chứng từ POP (${pendingProofs.map((x) => POP_LABEL[x.type] ?? x.type).join(', ')}), claim ${compact(c.claimed)}`,
        requesterId: prog?.requestedBy, deptCode: c.dept, requestedAt: Date.now() - (30 - Math.min(30, c.daysLeft)) * 864e5, slaMin: HUB_SLA.CLAIM, amount: c.claimed,
        flagged: c.daysLeft <= 5 ? `Còn ${c.daysLeft} ngày nộp 3M` : undefined, approveLabel: 'Đạt, nghiệm thu', nextStep: 'Hồ sơ sẵn sàng nộp 3M',
        approve: () => { setP('VERIFIED'); done('CLAIM', c.id, title, prog?.requestedBy, 'APPROVED', undefined, c.claimed, `Đã nghiệm thu POP ${c.code}`); },
        reject: (n) => { setP('REJECTED'); done('CLAIM', c.id, title, prog?.requestedBy, 'REJECTED', n, c.claimed, `Chứng từ ${c.code} không đạt, yêu cầu tải lại`); },
        view: () => openClaim(c.id),
      });
    } else if (c.submitted && !c.vatCheck && c.invoice && canDo('claim.accounting')) {
      todo.push({
        key: `vat-${c.id}`, kind: 'CLAIM', refId: c.id, title, sub: `Đối soát hóa đơn ${c.invoice.serial}-${c.invoice.number}, ${compact(c.invoice.amount)} so với claim ${compact(c.claimed)}`,
        requesterId: prog?.requestedBy, deptCode: c.dept, requestedAt: dayStart(c.invoice.date), slaMin: HUB_SLA.CLAIM, amount: c.invoice.amount,
        flagged: c.invoice.amount !== c.claimed ? 'Lệch số tiền' : undefined, approveLabel: 'Hóa đơn khớp', nextStep: 'Chờ 3M duyệt thanh toán / cấn trừ',
        approve: () => { setClaims((all) => all.map((x) => (x.id === c.id ? { ...x, vatCheck: 'MATCHED' } : x))); done('CLAIM', c.id, title, prog?.requestedBy, 'APPROVED', 'Hóa đơn khớp', c.invoice?.amount, `${c.code}: hóa đơn khớp`); },
        reject: (n) => { setClaims((all) => all.map((x) => (x.id === c.id ? { ...x, vatCheck: 'MISMATCH', vatNote: n } : x))); done('CLAIM', c.id, title, prog?.requestedBy, 'REJECTED', n, c.invoice?.amount, `${c.code}: ghi nhận lệch hóa đơn`); },
        view: () => openClaim(c.id),
      });
    }
  }
  // ---- Phân lead: Trưởng phòng chỉ định Sales ----
  for (const l of leads) {
    if (l.status !== 'ROUTED' || !(role === 'BOD' || (role === 'DEPT_HEAD' && l.dept === me.dept)) || !canDo('lead.assign')) continue;
    const reps = users.filter((u) => u.active && u.role === 'SALES_REP' && u.dept === l.dept);
    const title = `${l.code}: ${l.company}`;
    todo.push({
      key: `l-${l.id}`, kind: 'LEAD_ASSIGN', refId: l.id, title, sub: `${l.boqNote}${l.boqValue ? `, BOQ ${compact(l.boqValue)}` : ''}, ${SOURCE_LABEL[l.source]}${l.score !== undefined ? `, điểm ${l.score}` : ''}`,
      deptCode: l.dept, requestedAt: l.routedAt ?? Date.now(), slaMin: HUB_SLA.LEAD_ASSIGN, amount: l.boqValue, flagged: (l.score ?? 0) >= 80 ? 'Lead nóng' : undefined,
      nextStep: 'Sales nhận lead, SLA tiếp nhận 2 giờ bắt đầu',
      custom: <AssignInline lead={l} reps={reps} onAssign={(rep) => { assignLead(l.id, rep); logDecision({ kind: 'LEAD_ASSIGN', refId: l.id, title, decision: 'APPROVED', note: `Giao ${userName(rep)}`, amount: l.boqValue }); }} />,
      pick: {
        label: 'Chỉ định',
        options: reps.map((u) => ({ u, n: leads.filter((x) => x.assignee === u.id && ['ASSIGNED', 'ACCEPTED', 'QUOTED'].includes(x.status)).length })).sort((a, b) => a.n - b.n).map(({ u, n }) => ({ id: u.id, label: `${u.name} (${n} việc)` })),
        onPick: (rep) => { assignLead(l.id, rep); logDecision({ kind: 'LEAD_ASSIGN', refId: l.id, title, decision: 'APPROVED', note: `Giao ${userName(rep)}`, amount: l.boqValue }); },
      },
      reject: (n) => {
        setLeads((all) => all.map((x) => (x.id === l.id ? { ...x, status: 'NEW', dept: undefined, routedAt: undefined, routingReason: `Trả về MKT: ${n}` } : x)));
        logDecision({ kind: 'LEAD_ASSIGN', refId: l.id, title, decision: 'REJECTED', note: n, amount: l.boqValue });
        const mkt = users.find((u) => u.role === 'MKT_LEAD' && u.active);
        tell(mkt?.id, `Lead trả về: ${l.company}`, n, 'leads');
        notify(`Đã trả ${l.code} về Marketing phân lại`, 'orange');
      },
    });
  }
  // ---- Giải phóng hàng giữ chỗ (mở hộp quyết định) ----
  for (const r of reservations) {
    if (r.status !== 'PENDING_RELEASE' || !canRelease(r)) continue;
    todo.push({
      key: `s-${r.id}`, kind: 'STOCK', refId: r.id, title: `${r.qty.toLocaleString('vi-VN')} ${r.sku} đang giữ chỗ`, sub: r.releaseRequest?.reason ?? 'Dự án trượt, chờ quyết định',
      requesterId: r.releaseRequest?.by, requestedAt: r.releaseRequest?.at ? Date.parse(r.releaseRequest.at) || Date.now() : Date.now(), slaMin: HUB_SLA.STOCK,
      custom: <ReleaseInline r={r} />,
    });
  }

  // ---- Phiếu thu: kế toán xác nhận tiền về (ghi nhận doanh số); người thu nộp tiền mặt ----
  for (const r of receipts) {
    const job = jobs.find((j) => j.id === r.jobId);
    const title = `${r.code}: ${vnd(r.amount)}${job ? `, ${job.code} ${job.title}` : ''}`;
    const patch = (p: Partial<Receipt>) => setReceipts((all) => all.map((x) => (x.id === r.id ? { ...x, ...p } : x)));
    const how = r.method === 'CASH' ? 'tiền mặt' : 'chuyển khoản';
    if (r.status === 'SUBMITTED' && canDo('receipt.confirm') && r.collectedBy !== me.id) {
      todo.push({
        key: `rc-${r.id}`, kind: 'RECEIPT', refId: r.id, title, sub: `${how}, ${userName(r.collectedBy)} thu${r.note ? `, ${r.note}` : ''}`,
        requesterId: r.collectedBy, requestedAt: r.submittedAt ?? r.collectedAt, slaMin: HUB_SLA.RECEIPT, amount: r.amount,
        flagged: r.method === 'TRANSFER' ? 'Đối chiếu sao kê' : undefined, approveLabel: 'Xác nhận đã nhận', nextStep: 'Ghi nhận doanh số, giảm công nợ',
        approve: () => { patch({ status: 'CONFIRMED', confirmedBy: me.id, confirmedAt: Date.now() }); app.postCash(receiptCash(r, job, customers)); done('RECEIPT', r.id, title, r.collectedBy, 'APPROVED', undefined, r.amount, `Đã xác nhận ${r.code}, ghi nhận doanh số ${vnd(r.amount)}`); },
        reject: (n) => { patch({ status: 'REJECTED', rejectNote: n }); done('RECEIPT', r.id, title, r.collectedBy, 'REJECTED', n, r.amount, `Đã từ chối ${r.code}`); },
        view: job ? () => openJob(job.id) : undefined,
      });
    } else if (r.status === 'HOLDING' && r.collectedBy === me.id) {
      todo.push({
        key: `cash-${r.id}`, kind: 'CASH', refId: r.id, title, sub: `Bạn đang giữ ${vnd(r.amount)} tiền mặt, nộp về kế toán trong ${mfgConfig.submitHours} giờ`,
        requesterId: r.collectedBy, requestedAt: r.collectedAt, slaMin: mfgConfig.submitHours * 60, amount: r.amount, approveLabel: 'Đã nộp kế toán', nextStep: 'Kế toán đếm tiền và xác nhận',
        approve: () => { patch({ status: 'SUBMITTED', submittedAt: Date.now() }); audit('CASH_SUBMIT', `${r.code}: nộp ${vnd(r.amount)} về kế toán`); users.filter((u) => u.active && u.role === 'ACCOUNTANT').forEach((u) => dispatch('APPROVAL_RESULT', { to: u, title: `Nhận tiền mặt ${r.code}: ${vnd(r.amount)}`, body: `${userName(r.collectedBy)} nộp tiền đơn ${job?.code ?? ''}`, module: 'tasks' })); notify(`Đã ghi nhận nộp ${vnd(r.amount)}, chờ kế toán xác nhận`, 'teal'); },
        view: job ? () => openJob(job.id) : undefined,
      });
    }
  }

  // ---- Tôi đã yêu cầu ----
  const lastLog = (refId: string) => approvalLogs.find((x) => x.refId === refId);
  const mine: MineItem[] = [
    ...quotes.filter((q) => q.approval?.requestedBy === me.id).map((q): MineItem => ({
      key: `q-${q.id}`, kind: 'QUOTE', title: `${q.code} v${q.version}: ${q.quoteForm?.party.name ?? leadOf(q.leadId)?.company ?? ''}`, sub: `${compact(q.amount)}. ${q.approval!.reasons.join('; ')}`,
      status: q.approval!.status, requestedAt: q.approval!.requestedAt, slaMin: q.approval!.level === 'BOD' ? 240 : HUB_SLA.QUOTE, deciderId: q.approval!.decidedBy, note: q.approval!.note,
      view: () => openComposer({ quoteId: q.id, leadId: q.leadId || undefined, mode: 'QUOTE' }),
    })),
    ...latestContracts(genDocs).filter((d) => d.createdBy === me.id && d.special.length).map((d): MineItem => ({
      key: `c-${d.id}`, kind: 'CONTRACT', title: `${d.contractCode} v${d.version ?? 1}: ${d.partyName}`, sub: d.special.join('; '),
      status: d.status === 'PENDING_APPROVAL' ? 'PENDING' : d.status === 'REJECTED' ? 'REJECTED' : 'APPROVED', requestedAt: d.submittedAt ?? dayStart(d.createdAt), slaMin: HUB_SLA.CONTRACT,
      deciderId: d.approvedBy ?? lastLog(d.id)?.deciderId, note: d.rejectNote, view: () => openComposer({ docId: d.id, view: true }),
    })),
    ...activities.filter((a) => a.userId === me.id && needsApproval(a) && ['PENDING_APPROVAL', 'NEED_INFO', 'APPROVED', 'REJECTED'].includes(a.status)).map((a): MineItem => ({
      key: `a-${a.id}`, kind: 'ACTIVITY', title: a.title, sub: `${fmtDT(a.from)} – ${fmtDT(a.to)}${a.cost ? `, ${compact(a.cost)}` : ''}`,
      status: a.status === 'PENDING_APPROVAL' ? 'PENDING' : a.status === 'NEED_INFO' ? 'NEED_INFO' : a.status === 'REJECTED' ? 'REJECTED' : 'APPROVED',
      requestedAt: a.submittedAt ?? dayStart(a.createdAt), slaMin: HUB_SLA.ACTIVITY, deciderId: a.approvedBy ?? lastLog(a.id)?.deciderId, note: a.requestNote ?? a.rejectNote,
    })),
    ...activities.filter((a) => a.userId === me.id && a.expenseStatus).map((a): MineItem => ({
      key: `e-${a.id}`, kind: 'EXPENSE', title: `Chi phí: ${a.title}`, sub: `${compact((a.expenses ?? []).reduce((s, x) => s + x.amount, 0))}, ${EXPENSE_STATUS[a.expenseStatus!].label.toLowerCase()}`,
      status: a.expenseStatus === 'SUBMITTED' || a.expenseStatus === 'HEAD_APPROVED' ? 'PENDING' : a.expenseStatus === 'REJECTED' ? 'REJECTED' : 'APPROVED',
      requestedAt: a.expenseSubmittedAt ?? dayStart(a.to), slaMin: HUB_SLA.EXPENSE, deciderId: lastLog(a.id)?.deciderId, note: a.expenseNote,
    })),
    ...programs.filter((p) => p.requestedBy === me.id).map((p): MineItem => ({
      key: `p-${p.id}`, kind: 'PROGRAM', title: `${p.code}: ${p.title}`, sub: `${compact(p.held)}, ${PROGRAM_STATUS[p.status].label}`,
      status: p.status === 'PENDING_INTERNAL' ? 'PENDING' : p.status === 'REJECTED' ? 'REJECTED' : 'APPROVED', requestedAt: p.requestedAt ?? dayStart(p.start) - 14 * 864e5, slaMin: HUB_SLA.PROGRAM,
      deciderId: p.approvedBy ?? lastLog(p.id)?.deciderId, note: lastLog(p.id)?.note,
    })),
    ...receipts.filter((r) => r.collectedBy === me.id && r.status !== 'HOLDING').map((r): MineItem => ({
      key: `rc-${r.id}`, kind: 'RECEIPT', title: `${r.code}: ${vnd(r.amount)}`, sub: `${jobs.find((j) => j.id === r.jobId)?.title ?? ''}, ${r.method === 'CASH' ? 'tiền mặt' : 'chuyển khoản'}`,
      status: r.status === 'SUBMITTED' ? 'PENDING' : r.status === 'REJECTED' ? 'REJECTED' : 'APPROVED', requestedAt: r.submittedAt ?? r.collectedAt, slaMin: HUB_SLA.RECEIPT,
      deciderId: r.confirmedBy ?? lastLog(r.id)?.deciderId, note: r.rejectNote, view: () => openJob(r.jobId),
    })),
  ];
  void departments;
  return { todo, mine };
}

/** Chọn Sales ngay trên thẻ để chỉ định lead */
function AssignInline({ lead, reps, onAssign }: { lead: Lead; reps: User[]; onAssign: (repId: string) => void }) {
  const { leads } = useApp();
  const load = (id: string) => leads.filter((l) => l.assignee === id && ['ASSIGNED', 'ACCEPTED', 'QUOTED'].includes(l.status)).length;
  const sorted = [...reps].sort((a, b) => load(a.id) - load(b.id));
  const [rep, setRep] = useState(sorted[0]?.id ?? '');
  if (!reps.length) return <span className="text-xs text-[#F87171]">Phòng chưa có Sales hoạt động</span>;
  return (
    <span className="flex items-center gap-1.5">
      <select className={cn(inputBase, 'w-auto max-w-[150px] py-1 text-xs')} value={rep} onChange={(e) => setRep(e.target.value)} aria-label={`Chọn Sales cho ${lead.code}`}>
        {sorted.map((u) => <option key={u.id} value={u.id}>{u.name} ({load(u.id)} việc)</option>)}
      </select>
      <button className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} disabled={!rep} onClick={() => onAssign(rep)}><UserPlus className="h-3.5 w-3.5" aria-hidden />Chỉ định</button>
    </span>
  );
}
function ReleaseInline({ r }: { r: StockReservation }) {
  const [open, setOpen] = useState(false);
  return (
    <>
      <button className={cn(btnPrimary, btnSm)} onClick={() => setOpen(true)}>Quyết định</button>
      {open && <DecideReleaseModal r={r} onClose={() => setOpen(false)} />}
    </>
  );
}

function SlaBadge({ requestedAt, slaMin, now }: { requestedAt: number; slaMin: number; now: number }) {
  const s = slaInfo(requestedAt, slaMin, now);
  return (
    <span className={cn('inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[11px] font-semibold tabular-nums', s.overdue ? 'bg-[#EF4444]/15 text-[#F87171]' : s.tight ? 'bg-[#F28C33]/15 text-[#F7B23B]' : 'bg-[#1C2534] text-[#94A3B8]')}>
      <Clock className="h-3 w-3" aria-hidden />{s.text}
    </span>
  );
}

function TasksModule() {
  const { me, role, users, userName, departments, approvalLogs, now: nowRaw, canDo } = useApp();
  const now = nowRaw ?? Date.now();
  const { todo, mine } = useApprovalQueue();
  const [tab, setTab] = useState<'todo' | 'mine' | 'history'>('todo');
  const [view, setView] = useState<'table' | 'board'>('table');
  const [grp, setGrp] = useState<'ALL' | HubGroup>('ALL');
  const [who, setWho] = useState('ALL');
  const [prio, setPrio] = useState<'ALL' | 'URGENT' | 'NORMAL'>('ALL');
  const [q, setQ] = useState('');
  const [modal, setModal] = useState<{ item: HubItem; mode: 'REJECT' | 'NEED_INFO' } | null>(null);
  const [note, setNote] = useState('');
  const [busyKeys, setBusyKeys] = useState<string[]>([]);
  const t = q.trim().toLowerCase();
  const urgentOf = (x: HubItem) => { const s = slaInfo(x.requestedAt, x.slaMin, now); return s.overdue || s.tight || !!x.flagged; };
  const personMatch = (requesterId?: string, deptCode?: DeptCode) => who === 'ALL' || (who.startsWith('d:') ? deptCode === who.slice(2) || users.find((u) => u.id === requesterId)?.dept === who.slice(2) : requesterId === who);

  const todoList = todo.filter((x) => !busyKeys.includes(x.key) && (grp === 'ALL' || groupOf(x.kind) === grp) && personMatch(x.requesterId, x.deptCode) && (prio === 'ALL' || (prio === 'URGENT') === urgentOf(x)) && (!t || `${x.title} ${x.sub} ${x.reason ?? ''}`.toLowerCase().includes(t)))
    .sort((a, b) => Number(urgentOf(b)) - Number(urgentOf(a)) || slaInfo(a.requestedAt, a.slaMin, now).deadline - slaInfo(b.requestedAt, b.slaMin, now).deadline);
  const mineList = mine.filter((x) => (grp === 'ALL' || groupOf(x.kind) === grp) && (!t || `${x.title} ${x.sub}`.toLowerCase().includes(t)))
    .sort((a, b) => Number(b.status === 'PENDING') - Number(a.status === 'PENDING') || b.requestedAt - a.requestedAt);
  const seeAllHistory = role === 'BOD' || role === 'ACCOUNTANT';
  const history = approvalLogs.filter((x) => (seeAllHistory || x.deciderId === me.id || x.requesterId === me.id) && (grp === 'ALL' || groupOf(x.kind) === grp) && personMatch(x.requesterId) && (!t || `${x.title} ${x.note ?? ''}`.toLowerCase().includes(t)));
  const histPaged = usePaged(history, 15);
  const todoPaged = usePaged(todoList, 10);
  const minePaged = usePaged(mineList, 10);
  const sel = useSelection(todoList.filter((x) => !!x.approve).map((x) => x.key));
  const bulkApprove = () => { todoList.filter((x) => sel.has(x.key) && x.approve).forEach(quick); sel.clear(); };
  const deptOf = (uid?: string, code?: DeptCode) => departments.find((d) => d.code === (code ?? users.find((u) => u.id === uid)?.dept))?.short;
  const person = (uid?: string, code?: DeptCode) => uid ? (
    <span className="flex min-w-0 items-center gap-2"><Avatar name={userName(uid)} size={28} /><span className="min-w-0"><span className="block truncate text-sm">{userName(uid)}</span><span className="block truncate text-[11px] text-[#94A3B8]">{deptOf(uid, code) ?? '—'}</span></span></span>
  ) : <span className="text-xs text-[#94A3B8]">Hệ thống</span>;
  const kindCell = (k: ApprovalKind) => <span className="inline-flex items-center gap-1.5 whitespace-nowrap text-xs" title={HUB_KIND[k]}><i className="h-2 w-2 shrink-0 rounded-full" style={{ background: HUB_GROUP[groupOf(k)].color }} />{HUB_SHORT[k]}</span>;
  const sentAt = (t0: number) => new Date(t0).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
  const selCls = 'h-4 w-4 accent-[#F28C33]';
  const overdue = todo.filter((x) => slaInfo(x.requestedAt, x.slaMin, now).overdue).length;
  const todayDone = approvalLogs.filter((x) => x.deciderId === me.id && x.at >= Date.parse(`${todayISO()}T00:00:00`)).length;
  const counts = (Object.keys(HUB_GROUP) as HubGroup[]).map((g) => [g, todo.filter((x) => groupOf(x.kind) === g).length] as const);
  const people = users.filter((u) => u.active);

  /** Duyệt nhanh: ẩn thẻ ngay (lạc quan), rồi cập nhật dữ liệu */
  const quick = (x: HubItem) => { setBusyKeys((k) => [...k, x.key]); x.approve?.(); setTimeout(() => setBusyKeys((k) => k.filter((y) => y !== x.key)), 1500); };
  const submitModal = () => {
    if (!modal || note.trim().length < 5) return;
    setBusyKeys((k) => [...k, modal.item.key]);
    if (modal.mode === 'REJECT') modal.item.reject?.(note.trim()); else modal.item.needInfo?.(note.trim());
    setTimeout(() => setBusyKeys((k) => k.filter((y) => y !== modal.item.key)), 1500);
    setModal(null);
    setNote('');
  };

  return (
    <div className="space-y-4">
      {/* Hàng chỉ số */}
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Chờ tôi duyệt" value={String(todo.length)} icon={Inbox} color={C.orange} sub={`${todo.filter(urgentOf).length} việc khẩn`} />
        <StatCard label="Quá hạn SLA" value={String(overdue)} icon={AlertTriangle} color={overdue ? C.red : C.teal} sub={overdue ? 'Xử lý ngay' : 'Không có'} />
        <StatCard label="Tôi đã yêu cầu" value={String(mine.filter((x) => x.status === 'PENDING').length)} icon={Send} color={C.orange} sub={`${mine.filter((x) => x.status === 'REJECTED' || x.status === 'NEED_INFO').length} bị trả lại`} />
        <StatCard label="Đã xử lý hôm nay" value={String(todayDone)} icon={CheckCircle2} color={C.teal} sub={`${approvalLogs.filter((x) => x.deciderId === me.id).length} tổng cộng`} />
      </div>

      {/* Thanh tab */}
      <Tabs tabs={[
        { id: 'todo', label: `Chờ tôi duyệt (${todo.length})` },
        { id: 'mine', label: `Tôi đã yêu cầu (${mine.filter((x) => x.status === 'PENDING').length})` },
        { id: 'history', label: 'Lịch sử đã xử lý' },
      ]} value={tab} onChange={(v) => { setTab(v); sel.clear(); }} />

      {/* Thanh công cụ: tìm kiếm, loại yêu cầu, phòng ban, ưu tiên, duyệt hàng loạt + tag lọc con */}
      <FilterBar q={q} onQ={setQ} placeholder="Tìm mã, khách hàng, lý do..." status={grp} onStatus={(v) => setGrp(v as 'ALL' | HubGroup)} statusLabel="Loại yêu cầu"
        statusOptions={(Object.keys(HUB_GROUP) as HubGroup[]).map((g) => ({ value: g, label: HUB_GROUP[g].label }))} extraActive={(who !== 'ALL' ? 1 : 0) + (prio !== 'ALL' ? 1 : 0)}
        actions={tab === 'todo' ? (<>
          <ViewSwitch value={view} onChange={setView} options={['table', 'board']} />
          <button className={cn(btnPrimary, 'py-2')} disabled={!sel.ids.length} onClick={bulkApprove} title={sel.ids.length ? `Duyệt ${sel.ids.length} yêu cầu đã chọn` : 'Tích chọn các dòng cần duyệt'}><Zap className="h-4 w-4" aria-hidden />Duyệt chọn{sel.ids.length ? ` (${sel.ids.length})` : ''}</button>
        </>) : undefined}
        chips={tab === 'todo' ? <ChipFilter value={grp} onChange={(v) => setGrp(v)} total={todo.length} options={counts.filter(([, n]) => n > 0).map(([g, n]) => ({ value: g, label: HUB_GROUP[g].label, count: n, color: HUB_GROUP[g].color }))} /> : undefined}>
        {tab !== 'mine' && (
          <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto sm:max-w-[200px]')} value={who} onChange={(e) => setWho(e.target.value)} aria-label="Phòng ban / nhân sự">
            <option value="ALL">Phòng ban</option>
            <optgroup label="Phòng ban">{departments.filter((d) => d.active).map((d) => <option key={d.code} value={`d:${d.code}`}>{d.short}</option>)}</optgroup>
            <optgroup label="Nhân sự">{people.map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}</optgroup>
          </select>
        )}
        {tab === 'todo' && (
          <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={prio} onChange={(e) => setPrio(e.target.value as 'ALL' | 'URGENT' | 'NORMAL')} aria-label="Độ ưu tiên">
            <option value="ALL">Độ ưu tiên</option><option value="URGENT">Khẩn cấp</option><option value="NORMAL">Bình thường</option>
          </select>
        )}
      </FilterBar>

      {/* Bảng thông tin hợp nhất */}
      {tab === 'todo' && view === 'board' && (
        <div className="-mx-3 overflow-x-auto px-3 pb-2 sm:mx-0 sm:px-0">
          <div className="flex min-w-max gap-3">
            {(Object.keys(HUB_GROUP) as HubGroup[]).filter((g) => grp === 'ALL' || g === grp).map((g) => {
              const items = todoList.filter((x) => groupOf(x.kind) === g);
              return (
                <section key={g} className="flex w-[300px] shrink-0 flex-col rounded-md border border-white/[0.06] bg-[#151C29]/70" aria-label={HUB_GROUP[g].label}>
                  <header className="flex items-center gap-2 border-b border-white/[0.06] px-3 py-2.5">
                    <i className="h-2.5 w-2.5 rounded-full" style={{ background: HUB_GROUP[g].color }} />
                    <h3 className="font-display min-w-0 flex-1 truncate text-sm font-bold">{HUB_GROUP[g].label}</h3>
                    <span className="font-num rounded-sm bg-white/[0.06] px-1.5 text-xs text-[#94A3B8]">{items.length}</span>
                  </header>
                  <div className="flex max-h-[62vh] flex-col gap-2 overflow-y-auto p-2">
                    {items.map((x) => {
                      const s2 = slaInfo(x.requestedAt, x.slaMin, now);
                      return (
                        <article key={x.key} className={cn('rounded border bg-[#0F141E] p-3', s2.overdue || urgentOf(x) ? 'border-[#EF4444]/50' : 'border-white/[0.06]')}>
                          <button className="block w-full text-left" onClick={x.view} disabled={!x.view}>
                            <p className="line-clamp-2 text-sm font-semibold text-[#F1F5F9] hover:text-[#F7B23B]">{x.title}</p>
                            <p className={cn('mt-0.5 line-clamp-2 text-xs', x.reason ? 'text-[#F7B23B]' : 'text-[#94A3B8]')}>{x.reason ?? x.sub}</p>
                          </button>
                          <div className="mt-2 flex items-center justify-between gap-2">
                            {x.requesterId ? <span className="flex min-w-0 items-center gap-1.5 text-xs text-[#94A3B8]"><Avatar name={userName(x.requesterId)} size={20} /><span className="truncate">{userName(x.requesterId)}</span></span> : <span className="text-xs text-[#94A3B8]">Hệ thống</span>}
                            {x.amount ? <span className="font-num shrink-0 text-xs font-semibold text-[#F1F5F9]">{compact(x.amount)}</span> : null}
                          </div>
                          <div className="mt-2 flex items-center justify-between gap-2">
                            <SlaBadge requestedAt={x.requestedAt} slaMin={x.slaMin} now={now} />
                            <div className="flex items-center gap-1">
                              {x.approve && <button className={cn(btnBase, 'whitespace-nowrap bg-[#00B894] px-2 py-1 text-xs font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} onClick={() => quick(x)}>{x.approveLabel ?? 'Duyệt'}</button>}
                              <RowMenu items={[
                                ...(x.view ? [{ label: 'Xem chi tiết', icon: Eye, onClick: x.view }] : []),
                                ...(x.needInfo ? [{ label: 'Yêu cầu sửa / bổ sung', icon: Pencil, onClick: () => { setModal({ item: x, mode: 'NEED_INFO' }); setNote(''); } }] : []),
                                ...(x.reject ? [{ label: x.kind === 'LEAD_ASSIGN' ? 'Trả về MKT' : 'Từ chối', icon: XCircle, danger: true, onClick: () => { setModal({ item: x, mode: 'REJECT' }); setNote(''); } }] : []),
                              ]} />
                            </div>
                          </div>
                        </article>
                      );
                    })}
                    {!items.length && <p className="rounded border border-dashed border-white/[0.08] px-3 py-6 text-center text-xs text-[#7C8796]">Không có yêu cầu</p>}
                  </div>
                </section>
              );
            })}
          </div>
        </div>
      )}

      {tab === 'todo' && view === 'table' && (
        <Panel>
          <Table minW={1000} head={[
            <input key="all" type="checkbox" className={selCls} checked={sel.allOn} onChange={sel.toggleAll} aria-label="Chọn tất cả" disabled={!todoList.some((x) => x.approve)} />,
            'Mã & nội dung', 'Phân loại', 'Người đề nghị', 'SLA / thời hạn', 'Trạng thái', <span key="act" className="block text-right">Thao tác</span>,
          ]}>
            {todoPaged.slice.map((x) => {
              const urgent = urgentOf(x);
              const s = slaInfo(x.requestedAt, x.slaMin, now);
              return (
                <tr key={x.key} className={cn(rowCls, sel.has(x.key) && 'bg-[#F28C33]/5')}>
                  <td className={cn(tdFirst, 'w-10')}><input type="checkbox" className={selCls} checked={sel.has(x.key)} onChange={() => sel.toggle(x.key)} disabled={!x.approve} aria-label={`Chọn ${x.title}`} /></td>
                  <td className={cn(tdCls, 'max-w-[320px]')}>
                    <button className="block max-w-full text-left" onClick={x.view} disabled={!x.view} title={[x.sub, x.reason].filter(Boolean).join('\n')}>
                      <p className="flex min-w-0 items-baseline gap-2"><span className="truncate font-medium text-[#F1F5F9] hover:text-[#F7B23B]">{x.title}</span>{x.amount ? <span className="shrink-0 text-xs font-semibold tabular-nums text-[#F1F5F9]/80">{compact(x.amount)}</span> : null}</p>
                      <p className={cn('truncate text-xs', x.reason ? 'text-[#F7B23B]' : 'text-[#94A3B8]')}>{x.reason ?? x.sub}</p>
                    </button>
                  </td>
                  <td className={tdCls}>{kindCell(x.kind)}</td>
                  <td className={cn(tdCls, 'max-w-[180px]')}>{person(x.requesterId, x.deptCode)}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap')}><SlaBadge requestedAt={x.requestedAt} slaMin={x.slaMin} now={now} /><span className="mt-0.5 block text-[11px] text-[#94A3B8]">Gửi {sentAt(x.requestedAt)}</span></td>
                  <td className={cn(tdCls, 'whitespace-nowrap')}>{s.overdue || urgent ? <Chip tone="red">Khẩn cấp</Chip> : x.flagged ? <Chip tone="orange">{x.flagged}</Chip> : <Chip tone="orange">Chờ duyệt</Chip>}{x.flagged && (s.overdue || urgent) && <span className="mt-0.5 block text-[11px] text-[#F7B23B]">{x.flagged}</span>}</td>
                  <td className={tdLast}>
                    <div className="flex items-center justify-end gap-1.5">
                      {x.pick ? <RowMenu text={x.pick.label} icon={UserPlus} primary items={x.pick.options.length ? x.pick.options.map((o) => ({ label: o.label, icon: UserPlus, onClick: () => { setBusyKeys((k) => [...k, x.key]); x.pick!.onPick(o.id); } })) : [{ label: 'Phòng chưa có Sales hoạt động', onClick: () => undefined, disabled: true }]} /> : x.custom}
                      {x.approve && <button className={cn(btnBase, btnSm, 'whitespace-nowrap bg-[#00B894] font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} onClick={() => quick(x)} title={x.nextStep ? `Duyệt xong: ${x.nextStep.toLowerCase()}` : undefined}><CheckCircle2 className="h-3.5 w-3.5" aria-hidden />{x.approveLabel ?? 'Duyệt'}</button>}
                      <RowMenu items={[
                        ...(x.view ? [{ label: 'Xem chi tiết', icon: Eye, onClick: x.view }] : []),
                        ...(x.needInfo ? [{ label: 'Yêu cầu sửa / bổ sung', icon: Pencil, onClick: () => { setModal({ item: x, mode: 'NEED_INFO' }); setNote(''); } }] : []),
                        ...(x.reject ? [{ label: x.kind === 'LEAD_ASSIGN' ? 'Trả về MKT' : 'Từ chối', icon: XCircle, danger: true, onClick: () => { setModal({ item: x, mode: 'REJECT' }); setNote(''); } }] : []),
                      ]} />
                    </div>
                  </td>
                </tr>
              );
            })}
          </Table>
          {!todoList.length && <EmptyState text={todo.length ? <>Không có yêu cầu khớp bộ lọc.</> : <>Không có yêu cầu nào chờ bạn duyệt</>} hint={todo.length ? undefined : <>Báo giá, công tác, chi phí, quỹ MDF, phân lead và tiền thu cần bạn duyệt sẽ xuất hiện ở đây.</>} art={todo.length ? 'search' : 'inbox'} />}
          <Pagination paged={todoPaged} unit="yêu cầu" />
        </Panel>
      )}

      {tab === 'mine' && (
        <Panel>
          <Table minW={1000} head={['Mã & nội dung', 'Phân loại', 'Gửi lúc', 'SLA / thời hạn', 'Người xử lý', 'Trạng thái', <span key="act" className="block text-right">Thao tác</span>]}>
            {minePaged.slice.map((x) => (
              <tr key={x.key} className={rowCls}>
                <td className={cn(tdFirst, 'max-w-[360px]')}><p className="truncate font-medium">{x.title}</p><p className="truncate text-xs text-[#94A3B8]">{x.sub}</p>{x.note && x.status !== 'PENDING' && <p className={cn('truncate text-[11px]', x.status === 'APPROVED' ? 'text-[#3DDBB6]' : 'text-[#F87171]')}>{x.note}</p>}</td>
                <td className={tdCls}>{kindCell(x.kind)}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-xs tabular-nums')}>{sentAt(x.requestedAt)}</td>
                <td className={cn(tdCls, 'whitespace-nowrap')}>{x.status === 'PENDING' ? <SlaBadge requestedAt={x.requestedAt} slaMin={x.slaMin} now={now} /> : <span className="text-xs text-[#94A3B8]">—</span>}</td>
                <td className={cn(tdCls, 'max-w-[200px]')}>{x.deciderId ? person(x.deciderId) : <span className="text-xs text-[#94A3B8]">Chưa xử lý</span>}</td>
                <td className={cn(tdCls, 'whitespace-nowrap')}><Chip tone={x.status === 'PENDING' ? 'orange' : DECISION_LABEL[x.status].tone}>{x.status === 'PENDING' ? 'Đang chờ duyệt' : DECISION_LABEL[x.status].label}</Chip></td>
                <td className={cn(tdLast, 'text-right')}>{x.view && <button className={cn(btnGhost, btnSm)} onClick={x.view}><Eye className="h-3.5 w-3.5" aria-hidden />Xem</button>}</td>
              </tr>
            ))}
          </Table>
          {!mineList.length && <p className="py-10 text-center text-sm text-[#94A3B8]">Bạn chưa gửi yêu cầu duyệt nào.</p>}
          <Pagination paged={minePaged} unit="yêu cầu" />
        </Panel>
      )}

      {tab === 'history' && (
        <Panel>
          <Table head={['Thời gian', 'Mã & nội dung', 'Phân loại', 'Người đề nghị', 'Người xử lý', 'Giá trị', 'Kết quả', 'Lý do / ghi chú']} minW={1120} right={[5]}>
            {histPaged.slice.map((x) => (
              <tr key={x.id} className={rowCls}>
                <td className={cn(tdFirst, 'whitespace-nowrap text-xs tabular-nums')}>{new Date(x.at).toLocaleString('vi-VN')}</td>
                <td className={cn(tdCls, 'max-w-[300px]')}><p className="truncate font-medium">{x.title}</p></td>
                <td className={tdCls}>{kindCell(x.kind)}</td>
                <td className={cn(tdCls, 'max-w-[190px]')}>{person(x.requesterId)}</td>
                <td className={cn(tdCls, 'max-w-[190px]')}>{person(x.deciderId)}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{x.amount ? x.amount.toLocaleString('vi-VN') : '—'}</td>
                <td className={cn(tdCls, 'whitespace-nowrap')}><Chip tone={DECISION_LABEL[x.decision].tone}>{DECISION_LABEL[x.decision].label}</Chip></td>
                <td className={cn(tdLast, 'max-w-[240px] truncate text-xs text-[#94A3B8]')} title={x.note}>{x.note ?? '—'}</td>
              </tr>
            ))}
          </Table>
          {!history.length && <EmptyState text={<>Chưa có quyết định nào{seeAllHistory ? '' : ' liên quan đến bạn'}.</>} art="doc" />}
          <Pagination paged={histPaged} unit="quyết định" />
        </Panel>
      )}

      {modal && (
        <Modal title={`${modal.mode === 'REJECT' ? (modal.item.kind === 'LEAD_ASSIGN' ? 'Trả lead về Marketing' : 'Từ chối') : 'Yêu cầu sửa / bổ sung'}: ${modal.item.title}`} onClose={() => setModal(null)}
          footer={<><button className={btnGhost} onClick={() => setModal(null)}>Hủy</button><button className={cn(btnBase, 'px-3.5 py-2 font-semibold', modal.mode === 'REJECT' ? 'bg-[#EF4444] text-white' : 'g-brand font-semibold text-[#0F141E]')} disabled={note.trim().length < 5} onClick={submitModal}>{modal.mode === 'REJECT' ? 'Xác nhận' : 'Gửi yêu cầu'}</button></>}>
          <p className="mb-2 text-sm text-[#94A3B8]">{modal.item.sub}</p>
          <Field label="Lý do (gửi thông báo cho người đề nghị) *" hint="Tối thiểu 5 ký tự"><textarea className={cn(inputCls, 'min-h-24')} autoFocus value={note} onChange={(e) => setNote(e.target.value)} placeholder={modal.mode === 'REJECT' ? 'VD: GM quá thấp, đề nghị giảm chiết khấu dòng đầu cáp xuống 3%' : 'VD: Bổ sung dự toán chi phí tiếp khách chi tiết'} /></Field>
        </Modal>
      )}
      {!canDo('quote.approve') && !canDo('activity.approve') && tab === 'todo' && !todo.length && <p className="text-center text-xs text-[#94A3B8]">Vai trò của bạn chủ yếu gửi yêu cầu; theo dõi ở tab "Tôi đã yêu cầu".</p>}
    </div>
  );
}

/** Số việc chờ để hiện badge trên menu */
function useTaskCount() {
  return useApprovalQueue().todo.length;
}

/** Badge số việc chờ trên menu (render bên trong Provider nên dùng được context) */
function TaskBadge({ dot }: { dot?: boolean }) {
  const n = useTaskCount();
  if (!n) return null;
  return dot
    ? <span className="absolute right-[22%] top-2 h-2 w-2 rounded-full bg-[#F28C33]" aria-label={`${n} việc cần xử lý`} />
    : <span className="min-w-[1.375rem] rounded-md bg-[#F28C33]/20 px-1.5 py-0.5 text-center text-[11px] font-semibold tabular-nums text-[#F7B23B]">{n}</span>;
}

// =====================================================================
//  DỮ LIỆU MẪU THEO YÊU CẦU — nạp / xóa bằng nút trong Cài đặt > Doanh nghiệp
//  Mọi bản ghi mẫu có id bắt đầu bằng "demo-" để xóa sạch khi không cần.
// =====================================================================

const DEMO_PREFIX = 'demo-';
const isDemo = (id?: string) => !!id && id.startsWith(DEMO_PREFIX);
const DEMO_BUDGET_NOTE = '(Dữ liệu mẫu)';

/** Dữ liệu mẫu mô hình xưởng (ALUX): đủ các giai đoạn đơn hàng, phiếu thu tiền mặt / chuyển khoản, lệnh sản xuất, lắp đặt */
function buildMfgDemo(now: number, items: PriceItem[], cfg: MfgConfig, sources: CustomerSource[], segments: SegmentDef[], stockCatalog: StockItem[]) {
  const P = `${DEMO_PREFIX}m`;
  const isoD = (n: number) => iso(new Date(now + n * DAY));
  const isoT = (n: number, h = 9) => { const d = new Date(now + n * DAY); d.setHours(h, 0, 0, 0); return d.toISOString(); };
  const ms = (n: number, h = 9) => { const d = new Date(now + n * DAY); d.setHours(h, 0, 0, 0); return d.getTime(); };
  const local = (n: number, h: number) => { const d = new Date(now + n * DAY); d.setHours(h, 0, 0, 0); return toLocal(d); };
  const seg = (code: string) => (segments.some((s) => s.code === code) ? code : segments[0]?.code ?? code);
  const src = (id: string) => (sources.some((s) => s.id === id) ? id : sources[0]?.id ?? id);

  // ---- Nhân sự (mật khẩu 123456) ----
  const u = (id: string, name: string, email: string, role: Role, dept: string, phone: string, limit = 0): User => ({ id: P + id, name, email, role, dept, phone, active: true, approvalLimit: limit });
  const users: User[] = [
    u('mkt', 'Phạm Ngọc Hân', 'han.pn@alux.vn', 'MKT_LEAD', 'MARKETING', '0901 223 668'),
    u('tp-kt', 'Nguyễn Hữu Tài', 'tai.nh@alux.vn', 'DEPT_HEAD', 'KY_THUAT', '0903 556 120', 200_000_000),
    u('kt1', 'Trần Văn Khoa', 'khoa.tv@alux.vn', 'SALES_REP', 'KY_THUAT', '0977 118 405'),
    u('kt2', 'Lý Minh Nhật', 'nhat.lm@alux.vn', 'SALES_REP', 'KY_THUAT', '0909 781 226'),
    u('kd', 'Võ Thị Mai', 'mai.vt@alux.vn', 'SALES_REP', 'KINH_DOANH', '0938 445 902'),
