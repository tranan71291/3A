  const j1 = J('j1', { title: 'Cửa nhôm Xingfa nhà phố 3 tầng', customerId: 'k1', leadId: 'l4', siteAddress: '28 Đường số 9, KDC Him Lam, Quận 7', createdAt: isoD(-1), appointmentAt: local(0, 14), surveyCheckins: [],
