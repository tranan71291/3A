// =====================================================================
//  DỮ LIỆU CÓ PHIÊN BẢN: lưu trên trình duyệt, tự nâng cấp khi đổi bản app,
//  chụp bản lưu trước mỗi lần nâng cấp / khôi phục để không mất dữ liệu
// =====================================================================

/** Tăng số này mỗi khi cấu trúc dữ liệu đổi, và thêm một bước vào MIGRATIONS */
const DATA_VERSION = 21;
/** Dữ liệu bản trước khi tách doanh nghiệp (chuyển sang VASSH ở lần mở đầu) */
const LEGACY_STORE_KEY = 'vassh-crm:data';
/** Khóa lưu tách biệt theo doanh nghiệp trên nền tảng 3A Group */
const dataKey = (org: string) => `3a:tenant:${org}`;
/** Khóa của bản v18 */
const v18DataKey = (org: string) => `3a:data:${org}`;
/** Khóa của bản trước (v16–v17), tự chép sang khóa mới ở lần mở đầu */
const oldDataKey = (org: string) => `vassh-crm:data:${org}`;
const snapPrefix = (org: string) => `3a:snapshot:${org}:`;
const LAST_ORG_KEY = '3a:last-org';
/** Tùy chọn giao diện theo trình duyệt (sidebar thu gọn, nhóm menu gấp) — không phải dữ liệu nghiệp vụ */
const UI_KEY = '3a:ui:shell';
/** Tài khoản quản trị nền tảng 3A Group (không thuộc dữ liệu doanh nghiệp nào) */
const PLATFORM_KEY = '3a:platform';
const PLATFORM_DOMAIN = '3agroup.vn';
const isPlatformEmail = (e: string) => e.trim().toLowerCase().endsWith(`@${PLATFORM_DOMAIN}`);
const INITIAL_PLATFORM_ADMINS: User[] = [
  { id: 'pa-master', name: 'Quản trị 3A Group', email: `admin@${PLATFORM_DOMAIN}`, role: 'BOD', active: true, approvalLimit: 1e13 },
  { id: 'pa-super', name: 'Super Admin 3A Group', email: `superadmin@${PLATFORM_DOMAIN}`, role: 'BOD', active: true, approvalLimit: 1e13 },
];
/** Hồ sơ doanh nghiệp trên nền tảng: gói bản quyền, hợp đồng, trạng thái, module được cấp phép */
type TenantPlan = 'STARTER' | 'BUSINESS' | 'ENTERPRISE';
type TenantReg = {
  id: string; plan: TenantPlan; seats: number; contractStart: string; contractEnd: string; status: 'ACTIVE' | 'SUSPENDED';
  /** Module được cấp phép theo hợp đồng; tắt là menu bên doanh nghiệp tự ẩn */
  modules: Partial<Record<Module, boolean>>;
  /** Tính năng tích hợp ngoài module */
  features: { getfly: boolean; zns: boolean; smtp: boolean };
  lastBackupAt?: number; lastMigrationAt?: number; note?: string;
};
type PlatformLog = { id: string; at: number; by: string; tenant?: string; action: string; detail: string };
const TENANT_PLAN: Record<TenantPlan, { label: string; seats: number; price: string }> = {
  STARTER: { label: 'Starter', seats: 10, price: '3 triệu / tháng' },
  BUSINESS: { label: 'Business', seats: 30, price: '8 triệu / tháng' },
  ENTERPRISE: { label: 'Enterprise', seats: 100, price: '20 triệu / tháng' },
};
/** 13 module nghiệp vụ cấp phép được (Tổng quan, Công việc, Cài đặt luôn bật) */
const PROVISION_MODULES: Module[] = ['leads', 'customers', 'projects', 'products', 'supply', 'claims', 'jobs', 'production', 'install', 'inventory', 'cashbook', 'staff', 'docs', 'reports'];
const defaultTenantReg = (o: Org): TenantReg => ({
  id: o.id, plan: o.id === 'vassh' ? 'ENTERPRISE' : 'BUSINESS', seats: o.id === 'vassh' ? 100 : 30,
  contractStart: '2026-01-01', contractEnd: o.id === 'vassh' ? '2027-06-30' : '2026-12-31', status: 'ACTIVE',
  modules: Object.fromEntries(PROVISION_MODULES.map((m) => [m, !BUSINESS_PROFILE[o.profile].off.includes(m)])),
  features: { getfly: o.profile === 'TRADING', zns: true, smtp: true },
});
/** Đọc thông số kỹ thuật dữ liệu của một doanh nghiệp từ khóa lưu riêng */
function tenantStats(org: string) {
  if (CLOUD_ON) {
    const c = tenantCloudStats[org];
    return { raw: null as string | null, size: c?.size ?? 0, version: c?.version ?? 0, savedAt: c?.savedAt ?? 0, users: c?.users ?? 0, activeUsers: c?.activeUsers ?? 0, customers: c?.customers ?? 0, records: c?.records ?? 0 };
  }
  const raw = storage.get(dataKey(org));
  const out = { raw, size: raw ? raw.length * 2 : 0, version: 0, savedAt: 0, users: 0, activeUsers: 0, customers: 0, records: 0 };
  if (!raw) return out;
  try {
    const st = JSON.parse(raw) as StoredData;
    const d = (st.data ?? {}) as AnyRec;
    const users = (d.users ?? []) as User[];
    return { ...out, version: st.v ?? 0, savedAt: st.savedAt ?? 0, users: users.length, activeUsers: users.filter((u) => u.active).length, customers: (d.customers ?? []).length, records: orgOf(org).profile === 'MANUFACTURING' ? (d.jobs ?? []).length : (d.leads ?? []).length };
  } catch { return out; }
}
const SNAP_KEEP = 3;
type StoredData = { v: number; savedAt: number; data: Record<string, unknown> };
type AnyRec = Record<string, any>; // eslint-disable-line @typescript-eslint/no-explicit-any

/**
 * Bước nâng cấp: nhận dữ liệu bản v-1, trả về bản v. Quy tắc: chỉ THÊM / đổi tên trường,
 * không xóa dữ liệu người dùng; trường mới để trống sẽ được lấp bằng giá trị mặc định khi nạp.
 */
const MIGRATIONS: Record<number, (d: AnyRec) => AnyRec> = {
  // Bản 15: gói phân hệ theo doanh nghiệp, báo giá có luồng duyệt giá, sản xuất & lắp đặt
  15: (d) => ({
    ...d,
    company: { profile: 'TRADING', ...(d.company ?? {}) },
    quotes: (d.quotes ?? []).map((q: AnyRec) => ({ createdAt: q.createdAt ?? Date.parse(`${q.date ?? todayISO()}T08:00:00`), ...q })),
    workOrders: d.workOrders ?? [],
    installJobs: d.installJobs ?? [],
    approvalLogs: d.approvalLogs ?? [],
    auditLogs: d.auditLogs ?? [],
  }),
  // Bản 16: xưởng sản xuất (đơn hàng công trình, phiếu thu, bảng đơn giá), dữ liệu tách theo doanh nghiệp
  16: (d) => ({ ...d, jobs: d.jobs ?? [], receipts: d.receipts ?? [] }),
  // Bản 17: quy trình xưởng rút gọn (lệnh SX 3 trạng thái, lắp đặt 3 trạng thái), kho vật tư, thu chi
  17: (d) => {
    const wo = (s: string): WoStage => (s === 'DESIGN' || s === 'WAITING' ? 'WAITING' : s === 'READY' || s === 'DELIVERED' || s === 'DONE' ? 'DONE' : 'IN_PROGRESS');
    return {
      ...d,
      workOrders: ((d.workOrders as AnyRec[] | undefined) ?? []).map((w) => ({ ...w, stage: wo(String(w.stage)), history: ((w.history as AnyRec[] | undefined) ?? []).map((h) => ({ ...h, stage: wo(String(h.stage)) })) })),
      installJobs: ((d.installJobs as AnyRec[] | undefined) ?? []).map((i) => ({ ...i, status: i.status === 'WAIT_ACCEPT' || i.status === 'DEFECT' ? 'IN_PROGRESS' : i.status })),
      stockItems: d.stockItems ?? [], stockMoves: d.stockMoves ?? [], cashEntries: d.cashEntries ?? [],
    };
  },
  // Bản 18: nền tảng 3A Group (khóa lưu 3a:data:<doanh nghiệp>), phiếu quỹ tự sinh, hoa hồng, quyết toán MDF
  18: (d) => ({ ...d, cashEntries: ((d.cashEntries as AnyRec[] | undefined) ?? []).map((e) => ({ source: 'MANUAL', ...e })) }),
  // Bản 19: khóa lưu 3a:tenant:<doanh nghiệp>, cấp phép module từ 3A Console, nhóm tuổi nợ <30 / 31–60 / >60 (chỉ thêm trường)
  19: (d) => (d.mfgConfig ? { ...d, mfgConfig: { agingScheme: 'AGE_30_60', ...(d.mfgConfig as AnyRec) } } : d),
  // Bản 20: bình luận / @nhắc tên theo từng dòng dữ liệu (chỉ thêm danh sách mới)
  20: (d) => ({ ...d, comments: d.comments ?? [] }),
  // Bản 21: nhóm chat cho trang Tin nhắn toàn màn hình (chỉ thêm danh sách mới)
  21: (d) => ({ ...d, channels: d.channels ?? [] }),
};

function migrateData(data: AnyRec, from: number): { data: AnyRec; steps: number[] } {
  let d = { ...data };
  const steps: number[] = [];
  for (let v = from + 1; v <= DATA_VERSION; v++) {
    const m = MIGRATIONS[v];
    if (m) { d = m(d); steps.push(v); }
  }
  return { data: d, steps };
}

const storage = {
  get(key: string): string | null { try { return localStorage.getItem(key); } catch { return null; } },
  set(key: string, val: string): boolean { try { localStorage.setItem(key, val); return true; } catch { return false; } },
  del(key: string) { try { localStorage.removeItem(key); } catch { /* bỏ qua */ } },
  keys(): string[] { try { return Object.keys(localStorage); } catch { return []; } },
};

/** Chụp nguyên bản dữ liệu hiện có trước khi nâng cấp / nhập / khôi phục; giữ 3 bản gần nhất */
function takeSnapshot(org: string, reason: string): string | null {
  const raw = storage.get(dataKey(org));
  if (!raw) return null;
  let v = 0;
  try { v = (JSON.parse(raw) as StoredData).v ?? 0; } catch { /* bỏ qua */ }
  const key = `${snapPrefix(org)}${Date.now()}:v${v}:${reason}`;
  storage.set(key, raw);
  const old = listSnapshots(org).slice(SNAP_KEEP);
  old.forEach((s) => storage.del(s.key));
  return key;
}
function listSnapshots(org: string): { key: string; version: number; at: number; reason: string }[] {
  return storage.keys().filter((k) => k.startsWith(snapPrefix(org))).map((key) => {
    const [at, v, reason] = key.slice(snapPrefix(org).length).split(':');
    return { key, at: Number(at), version: Number((v ?? 'v0').slice(1)), reason: reason ?? '' };
  }).sort((a, b) => b.at - a.at);
}

/** Lấp giá trị mặc định cho các khóa mới (vd. phân hệ / quyền / sự kiện vừa thêm ở bản app mới) */
function withDefaults<T extends AnyRec>(value: unknown, defaults: T): T {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return defaults;
  const out: AnyRec = { ...defaults };
  for (const [k, v] of Object.entries(value as AnyRec)) {
    out[k] = v && typeof v === 'object' && !Array.isArray(v) && defaults[k] && typeof defaults[k] === 'object' && !Array.isArray(defaults[k]) ? withDefaults(v, defaults[k]) : v;
  }
  return out as T;
}

// =====================================================================
//  BẢO MẬT PHÍA TRÌNH DUYỆT: băm mật khẩu, khóa đăng nhập, mã hóa bản sao lưu
//  (Production: xác thực phải chạy trên server — xem ghi chú ở cuối file / tài liệu)
// =====================================================================

const INITIAL_SECURITY: SecurityPolicy = { minPasswordLength: 8, lockoutAttempts: 5, lockoutMinutes: 15, idleMinutes: 30, sessionDays: 7, roleSwitch: true, forceChangeDefault: true };
const PBKDF2_ITER = 120_000;
const te = new TextEncoder();
const toB64 = (u: Uint8Array) => { let s = ''; for (let i = 0; i < u.length; i += 0x8000) s += String.fromCharCode(...Array.from(u.subarray(i, i + 0x8000))); return btoa(s); };
const fromB64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
const subtle = () => {
  if (typeof crypto === 'undefined' || !crypto.subtle) throw new Error('Trình duyệt không hỗ trợ mã hóa (cần HTTPS hoặc localhost)');
  return crypto.subtle;
};

async function pbkdf2(secret: string, salt: Uint8Array, bits = 256): Promise<Uint8Array> {
  const key = await subtle().importKey('raw', te.encode(secret), 'PBKDF2', false, ['deriveBits']);
  return new Uint8Array(await subtle().deriveBits({ name: 'PBKDF2', hash: 'SHA-256', salt: salt as BufferSource, iterations: PBKDF2_ITER }, key, bits));
}
async function hashPassword(pw: string, saltB64?: string): Promise<{ hash: string; salt: string }> {
  const salt = saltB64 ? fromB64(saltB64) : crypto.getRandomValues(new Uint8Array(16));
  return { hash: toB64(await pbkdf2(pw, salt)), salt: toB64(salt) };
}
/** So sánh thời gian hằng, tránh lộ thông tin qua thời gian phản hồi */
const safeEqual = (a: string, b: string) => { if (a.length !== b.length) return false; let r = 0; for (let i = 0; i < a.length; i++) r |= a.charCodeAt(i) ^ b.charCodeAt(i); return r === 0; };
async function verifyPassword(u: User, pw: string): Promise<boolean> {
  if (!u.passwordHash || !u.salt) return safeEqual(pw, DEMO_PASSWORD);
  return safeEqual((await hashPassword(pw, u.salt)).hash, u.passwordHash);
}
function passwordIssues(pw: string, policy: SecurityPolicy, email = ''): string[] {
  const out: string[] = [];
  if (pw.length < policy.minPasswordLength) out.push(`Tối thiểu ${policy.minPasswordLength} ký tự`);
  if (!/[a-zA-Z]/.test(pw) || !/\d/.test(pw)) out.push('Có cả chữ và số');
  if (!/[A-Z]/.test(pw)) out.push('Có ít nhất 1 chữ hoa');
  if (pw === DEMO_PASSWORD || /^(.)\1+$/.test(pw) || ['12345678', 'password', 'matkhau123'].includes(pw.toLowerCase())) out.push('Không dùng mật khẩu phổ biến / mặc định');
  if (email && pw.toLowerCase().includes(email.split('@')[0].toLowerCase())) out.push('Không chứa tên email');
  return out;
}
const tempPassword = () => {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
  const r = crypto.getRandomValues(new Uint32Array(10));
  return Array.from(r, (x) => chars[x % chars.length]).join('') + '9A';
};

type EncryptedBackup = { format: 'vassh-backup'; v: number; enc: 'AES-GCM'; kdf: 'PBKDF2-SHA256'; iter: number; salt: string; iv: string; data: string; exportedAt: number };
async function encryptBackup(obj: unknown, pass: string, v: number): Promise<EncryptedBackup> {
  const salt = crypto.getRandomValues(new Uint8Array(16));
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const key = await subtle().importKey('raw', (await pbkdf2(pass, salt)) as BufferSource, 'AES-GCM', false, ['encrypt']);
  const ct = new Uint8Array(await subtle().encrypt({ name: 'AES-GCM', iv: iv as BufferSource }, key, te.encode(JSON.stringify(obj))));
  return { format: 'vassh-backup', v, enc: 'AES-GCM', kdf: 'PBKDF2-SHA256', iter: PBKDF2_ITER, salt: toB64(salt), iv: toB64(iv), data: toB64(ct), exportedAt: Date.now() };
}
async function decryptBackup(b: EncryptedBackup, pass: string): Promise<AnyRec> {
  const key = await subtle().importKey('raw', (await pbkdf2(pass, fromB64(b.salt))) as BufferSource, 'AES-GCM', false, ['decrypt']);
  try {
    const pt = await subtle().decrypt({ name: 'AES-GCM', iv: fromB64(b.iv) as BufferSource }, key, fromB64(b.data) as BufferSource);
    return JSON.parse(new TextDecoder().decode(pt)) as AnyRec;
  } catch {
    throw new Error('Sai mật khẩu bản sao lưu hoặc file đã bị sửa');
  }
}

// =====================================================================
//  GÓI PHÂN HỆ THEO MÔ HÌNH DOANH NGHIỆP
// =====================================================================

/** Phân hệ luôn bật (dùng chung) */
const CORE_MODULES: Module[] = ['overview', 'tasks', 'messages', 'settings'];
const BUSINESS_PROFILE: Record<BusinessProfile, { label: string; desc: string; off: Module[] }> = {
  TRADING: { label: 'Phân phối & thương mại', desc: 'VD: VASSH. Lead, khách hàng doanh nghiệp, dự án BOQ, đặt hàng Hãng, quỹ MDF', off: ['jobs', 'production', 'install', 'inventory'] },
  MANUFACTURING: { label: 'Sản xuất & lắp đặt', desc: 'VD: ALUX. Lead, khảo sát báo giá m² / md, cọc, xưởng, lắp đặt, thu tiền, kho, thu chi', off: ['projects', 'products', 'supply', 'claims'] },
  ALL: { label: 'Dùng tất cả phân hệ', desc: 'Doanh nghiệp vừa thương mại vừa sản xuất', off: [] },
  CUSTOM: { label: 'Tùy chỉnh', desc: 'Tự bật / tắt từng phân hệ', off: [] },
};
const moduleEnabled = (c: CompanyInfo, m: Module) => {
  if (CORE_MODULES.includes(m)) return true;
  // Cấp phép từ 3A Platform Console (nạp vào enabledModules khi mở doanh nghiệp) được ưu tiên
  if (c.enabledModules && m in c.enabledModules) return !!c.enabledModules[m];
  const p = c.profile ?? 'TRADING';
  if (p === 'CUSTOM') return true;
  return !BUSINESS_PROFILE[p].off.includes(m);
};
/** Kiểu vận hành để chọn trang Tổng quan / Khách hàng / Báo cáo phù hợp */
const bizMode = (c: CompanyInfo): 'TRADING' | 'MFG' | 'BOTH' => {
  const mfg = moduleEnabled(c, 'jobs');
  const trade = moduleEnabled(c, 'claims') || moduleEnabled(c, 'projects') || moduleEnabled(c, 'supply');
  return mfg && trade ? 'BOTH' : mfg ? 'MFG' : 'TRADING';
};

/** Minh họa line-art cho slider trang đăng nhập (không dùng ảnh giả lập dự án thật) */
function LoginArt({ kind, accent }: { kind: 'lead' | 'mdf' | 'mfg' | 'center'; accent: string }) {
  const st = { fill: 'none', stroke: 'rgba(255,255,255,.22)', strokeWidth: 1.2 };
  const hi = { fill: 'none', stroke: 'url(#lgA)', strokeWidth: 2.2, strokeLinecap: 'round' as const };
  return (
    <svg viewBox="0 0 420 260" className="h-auto w-full max-w-[460px]" aria-hidden>
      <defs>
        <linearGradient id="lgA" x1="0" x2="1"><stop offset="0" stopColor={BRAND.o1} /><stop offset=".55" stopColor={BRAND.o2} /><stop offset="1" stopColor={BRAND.o3} /></linearGradient>
        <linearGradient id="lgB" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stopColor={accent} stopOpacity=".35" /><stop offset="1" stopColor={accent} stopOpacity="0" /></linearGradient>
      </defs>
      {kind === 'lead' && <>
        <rect x="20" y="105" width="96" height="50" rx="6" {...st} /><text x="68" y="135" textAnchor="middle" fill="#CBD5E1" fontSize="12">Lead MKT</text>
        {[40, 120, 200].map((y, i) => <g key={y}><path d={`M116 130 C170 130 170 ${y + 25} 222 ${y + 25}`} {...hi} strokeDasharray="5 6"><animate attributeName="stroke-dashoffset" from="22" to="0" dur="1.4s" repeatCount="indefinite" /></path>
          <rect x="222" y={y} width="176" height="50" rx="6" {...st} /><text x="236" y={y + 22} fill="#E2E8F0" fontSize="12">{['Dự án M&E', 'Kinh doanh thương mại', 'Kênh đại lý'][i]}</text><text x="236" y={y + 39} fill="#94A3B8" fontSize="10">Tiếp nhận ≤ 2 giờ</text><circle cx="384" cy={y + 25} r="6" fill="none" stroke={accent} strokeWidth="2" /></g>)}
      </>}
      {kind === 'mdf' && <>
        {['Ngân sách', 'Pre-Approval', 'POP', 'Claim', 'ROI'].map((l, i) => <g key={l}><circle cx={40 + i * 85} cy="80" r="18" fill={i < 3 ? 'url(#lgA)' : 'none'} stroke={i < 3 ? 'none' : 'rgba(255,255,255,.3)'} /><text x={40 + i * 85} y="85" textAnchor="middle" fill={i < 3 ? '#0F141E' : '#CBD5E1'} fontSize="12" fontWeight="700">{i + 1}</text><text x={40 + i * 85} y="122" textAnchor="middle" fill="#CBD5E1" fontSize="11">{l}</text>{i < 4 && <path d={`M${60 + i * 85} 80h45`} stroke="rgba(255,255,255,.25)" strokeWidth="1.5" />}</g>)}
        <path d="M30 230 L90 200 L150 210 L210 170 L270 180 L330 140 L390 150" {...hi} /><path d="M30 230 L90 200 L150 210 L210 170 L270 180 L330 140 L390 150 V245 H30Z" fill="url(#lgB)" />
      </>}
      {kind === 'mfg' && <>
        <rect x="40" y="30" width="140" height="190" rx="3" {...st} /><path d="M110 30v190M40 125h140" {...st} /><rect x="52" y="42" width="46" height="71" fill={`${accent}22`} /><rect x="122" y="137" width="46" height="71" fill={`${accent}22`} />
        {['Khảo sát & đo đạc', 'Báo giá m² / md', 'Sản xuất', 'Lắp đặt & nghiệm thu', 'Thu tiền & bảo hành'].map((l, i) => <g key={l}><circle cx="226" cy={44 + i * 42} r="7" fill={i < 3 ? accent : 'none'} stroke={accent} strokeWidth="2" /><text x="244" y={48 + i * 42} fill="#E2E8F0" fontSize="12">{l}</text>{i < 4 && <path d={`M226 ${52 + i * 42}v26`} stroke="rgba(255,255,255,.25)" />}</g>)}
      </>}
      {kind === 'center' && <>
        <rect x="20" y="20" width="380" height="220" rx="8" {...st} /><rect x="20" y="20" width="56" height="220" rx="8" fill="rgba(255,255,255,.04)" />
        {[0, 1, 2].map((i) => <g key={i}><rect x={92 + i * 102} y="36" width="92" height="52" rx="4" fill="rgba(255,255,255,.04)" /><rect x={100 + i * 102} y="46" width="40" height="6" rx="3" fill="rgba(255,255,255,.25)" /><rect x={100 + i * 102} y="60" width="60" height="12" rx="3" fill={i === 0 ? 'url(#lgA)' : 'rgba(255,255,255,.5)'} /></g>)}
        {[60, 90, 75, 120, 100, 150, 135].map((h, i) => <rect key={i} x={100 + i * 26} y={226 - h} width="16" height={h} rx="2" fill={i > 4 ? 'url(#lgA)' : accent} opacity={i > 4 ? 1 : 0.8} />)}
        <rect x="300" y="104" width="88" height="122" rx="4" fill="rgba(255,255,255,.04)" />{[0, 1, 2, 3].map((i) => <rect key={i} x="308" y={114 + i * 26} width={70 - i * 10} height="8" rx="4" fill={i === 0 ? '#EF4444' : 'rgba(255,255,255,.2)'} />)}
        {[0, 1, 2, 3, 4].map((i) => <circle key={i} cx="48" cy={50 + i * 34} r="7" fill={i === 1 ? accent : 'rgba(255,255,255,.18)'} />)}
      </>}
    </svg>
  );
}

const LOGIN_SLIDES: { kind: 'lead' | 'mdf' | 'mfg' | 'center'; tag: string; title: string; desc: string; points: string[]; org?: string }[] = [
  { kind: 'center', tag: '3A Group Command Center', title: 'Một nền tảng điều hành cho cả tập đoàn', desc: 'Chỉ số, dự báo doanh thu, cảnh báo rủi ro và trao đổi nhóm trên cùng một màn hình.', points: ['Bộ lọc toàn cục theo chi nhánh, phòng ban, dòng sản phẩm', 'AI Copilot phân tích SLA, dòng tiền, quỹ MDF', 'Chat theo dự án, gắn thẻ @ và liên kết # tới số liệu'] },
  { kind: 'lead', tag: 'VASSH · Phân luồng lead', title: 'Lead Marketing về đúng phòng ban, đúng SLA', desc: 'Tự động chia lead MQL / SQL cho Dự án M&E, Kinh doanh thương mại, Kênh đại lý.', points: ['Tiếp nhận trong 2 giờ, báo giá trong 24 giờ', 'Cảnh báo trễ hạn theo tải nhân sự', 'Kanban, Gantt và bình luận ngay trên từng dòng'], org: 'vassh' },
  { kind: 'mdf', tag: 'VASSH · Quỹ MDF 3M', title: 'Vòng đời quỹ MDF từ ngân sách đến ROI', desc: 'Lập ngân sách, Pre-Approval, thu hồ sơ nghiệm thu (POP), claim hoàn quỹ và đo hiệu quả.', points: ['Theo dõi tốc độ giải ngân so với kế hoạch', 'Gợi ý chương trình kích cầu theo nhóm khách', 'Quyết toán thặng dư và công nợ tự động'], org: 'vassh' },
  { kind: 'mfg', tag: 'ALUX · Xưởng nhôm kính', title: 'Từ khảo sát đến bàn giao công trình', desc: 'Báo giá theo m² / md, nhận cọc chuyển sản xuất, lịch lắp đặt, nghiệm thu và thu tiền.', points: ['Lệnh sản xuất 3 trạng thái, cảnh báo trễ hạn', 'Thu tiền tại công trình, đối chiếu nộp quỹ', 'Kho vật tư và sổ thu chi theo đơn hàng'], org: 'alux' },
];

/** Trang đăng nhập dạng chia đôi: form kính mờ phát sáng theo màu doanh nghiệp + slider giới thiệu 3A Group */
function LoginScreen({ users, company, onLogin, idleOut, dataLocked, orgId, onOrg, platformHint }: { users: User[]; company: CompanyInfo; onLogin: (email: string, password: string, remember: boolean) => Promise<string | null>; idleOut: number; dataLocked: number | null; orgId: string; onOrg: (org: string) => void; platformHint?: boolean }) {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [remember, setRemember] = useState(false);
  const [error, setError] = useState('');
  const [busy, setBusy] = useState(false);
  const [show, setShow] = useState(false);
  const [slide, setSlide] = useState(0);
  const [paused, setPaused] = useState(false);
  // Gợi ý tài khoản demo chỉ hiện khi còn tài khoản dùng mật khẩu khởi tạo
  const showDemo = !CLOUD_ON && users.some((u) => !u.passwordHash);
  // Màu phát sáng theo phân nhánh: cam VASSH, xanh dương ALUX
  const accent = orgId === 'alux' ? BRAND.blue : BRAND.o2;
  const accentHi = orgId === 'alux' ? BRAND.blueHi : BRAND.o3;
  const slides = [...LOGIN_SLIDES.filter((x) => x.org === orgId), ...LOGIN_SLIDES.filter((x) => x.org !== orgId)];
  useEffect(() => { setSlide(0); }, [orgId]);
  useEffect(() => {
    if (paused || (typeof window !== 'undefined' && window.matchMedia?.('(prefers-reduced-motion: reduce)').matches)) return;
    const t = window.setInterval(() => setSlide((x) => (x + 1) % slides.length), 6000);
    return () => window.clearInterval(t);
  }, [paused, slides.length]);
  const cur = slides[slide] ?? slides[0];

  const submit = async () => {
    if (busy) return;
    setBusy(true);
    setError('');
    const err = await onLogin(email, password, remember);
    setBusy(false);
    if (err) { setError(err); setPassword(''); }
  };
  const field = 'peer h-12 w-full rounded-md border border-white/10 bg-[#070B12]/70 pl-11 pr-3 text-[15px] text-[#F1F5F9] placeholder:text-[#64748B] transition-[border-color,box-shadow] focus:outline-none';
  const focusRing = { '--acc': accent } as CSSProperties;

  return (
    <div className="relative grid min-h-screen bg-[#070B12] text-[#F1F5F9] lg:grid-cols-[5fr_7fr]" style={focusRing}>
      <style>{`.login-field:focus{border-color:var(--acc);box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 25%,transparent)}.login-field:focus~.login-ico{color:var(--acc)}.login-btn{box-shadow:0 10px 30px -8px color-mix(in srgb,var(--acc) 70%,transparent)}.login-btn:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 16px 40px -8px color-mix(in srgb,var(--acc) 85%,transparent);filter:brightness(1.08)}.login-btn:active:not(:disabled){transform:translateY(0) scale(.99)}.login-btn:hover .login-arrow{transform:translateX(4px)}`}</style>
      {/* ---------- Bên trái: form ---------- */}
      <section className="relative flex flex-col justify-center overflow-hidden px-5 py-10 sm:px-10">
        <div className="pointer-events-none absolute -left-32 top-1/4 h-[420px] w-[420px] rounded-full opacity-40 blur-[110px] transition-colors duration-700" style={{ background: accent }} aria-hidden />
        <div className="pointer-events-none absolute -bottom-40 right-0 h-[320px] w-[320px] rounded-full opacity-20 blur-[100px]" style={{ background: accentHi }} aria-hidden />
        <div className="relative mx-auto w-full max-w-[420px]">
          <div className="mb-7 flex items-center gap-3">
            <Logo3A size={40} />
            <div className="min-w-0">
              <p className="font-display text-xl font-extrabold tracking-tight">3A GROUP</p>
              <p className="truncate text-xs text-[#94A3B8]">Enterprise Command Center · {company.appName}</p>
            </div>
          </div>
          {idleOut > 0 && <p className="mb-3 rounded-md border border-[#F28C33]/40 bg-[#F28C33]/10 px-4 py-3 text-sm text-[#F7B23B]" role="status">Phiên làm việc đã tự đăng xuất sau {idleOut} phút không thao tác.</p>}
          {dataLocked && <p className="mb-3 rounded-md border border-[#EF4444]/40 bg-[#EF4444]/10 px-4 py-3 text-sm text-[#F87171]" role="alert">Dữ liệu trên máy này thuộc phiên bản {dataLocked}, mới hơn bản app đang chạy ({DATA_VERSION}). App sẽ không ghi đè để tránh mất dữ liệu; hãy cập nhật file app mới nhất.</p>}

          {/* Thẻ kính mờ, viền sáng chuyển màu theo doanh nghiệp đang chọn */}
          <div className="rounded-xl p-px transition-[background] duration-500" style={{ background: `linear-gradient(140deg, ${accent}AA, rgba(255,255,255,.08) 40%, rgba(255,255,255,.04) 60%, ${accentHi}66)` }}>
            <form className="space-y-5 rounded-[11px] bg-[#0D131F]/80 p-6 shadow-[0_30px_80px_-20px_rgba(0,0,0,.7)] backdrop-blur-xl sm:p-7" onSubmit={(e) => { e.preventDefault(); void submit(); }}>
              <div>
                <h1 className="font-display text-2xl font-extrabold tracking-tight">Đăng nhập</h1>
                <p className="mt-1 text-sm text-[#94A3B8]">Chọn phân nhánh và đăng nhập bằng tài khoản công ty.</p>
              </div>
              <div role="radiogroup" aria-label="Phân nhánh doanh nghiệp" className="grid grid-cols-2 gap-2.5">
                {ORGS.map((o) => {
                  const on = orgId === o.id;
                  const c = o.id === 'alux' ? BRAND.blue : BRAND.o2;
                  const Icon = o.profile === 'MANUFACTURING' ? Factory : Building2;
                  return (
                    <button key={o.id} type="button" role="radio" aria-checked={on} onClick={() => { onOrg(o.id); setError(''); }}
                      className="rounded-lg p-px text-left transition-[background,transform] duration-300 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
                      style={{ background: on ? (o.id === 'alux' ? `linear-gradient(135deg, ${BRAND.blueHi}, ${BRAND.blue})` : `linear-gradient(135deg, ${BRAND.o1}, ${BRAND.o2}, ${BRAND.o3})`) : 'rgba(255,255,255,.08)' }}>
                      <span className={cn('flex h-full items-center gap-3 rounded-[7px] px-3 py-3 transition-colors duration-300', on ? 'bg-[#0D131F]/85' : 'bg-[#0B1019]')}>
                        <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-md transition-colors duration-300" style={{ background: on ? c : `${c}1F`, color: on ? '#0F141E' : c }}><Icon className="h-[18px] w-[18px]" aria-hidden /></span>
                        <span className="min-w-0"><span className="block text-sm font-bold">{o.shortName}</span><span className="block truncate text-[11px] text-[#94A3B8]">{BUSINESS_PROFILE[o.profile].label}</span></span>
                      </span>
                    </button>
                  );
                })}
              </div>
              <label className="block">
                <span className="mb-1.5 block text-xs font-medium text-[#94A3B8]">Email công ty</span>
                <span className="relative block">
                  <input className={cn(field, 'login-field')} type="email" autoComplete="username" value={email} onChange={(e) => setEmail(e.target.value)} onBlur={() => { const o = orgByEmail(email); if (o) onOrg(o.id); }} placeholder={`ten@${orgOf(orgId).domain}`} />
                  <Mail className="login-ico pointer-events-none absolute left-3.5 top-1/2 h-[18px] w-[18px] -translate-y-1/2 text-[#64748B] transition-colors" aria-hidden />
                </span>
              </label>
              <label className="block">
                <span className="mb-1.5 block text-xs font-medium text-[#94A3B8]">Mật khẩu</span>
                <span className="relative block">
                  <input className={cn(field, 'login-field pr-12')} type={show ? 'text' : 'password'} autoComplete="current-password" value={password} onChange={(e) => setPassword(e.target.value)} placeholder="••••••••" />
                  <KeyRound className="login-ico pointer-events-none absolute left-3.5 top-1/2 h-[18px] w-[18px] -translate-y-1/2 text-[#64748B] transition-colors" aria-hidden />
                  <button type="button" className="absolute right-2 top-1/2 -translate-y-1/2 rounded p-1.5 text-[#94A3B8] hover:bg-white/10 hover:text-white" onClick={() => setShow((v) => !v)} aria-label={show ? 'Ẩn mật khẩu' : 'Hiện mật khẩu'}>{show ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}</button>
                </span>
              </label>
              <label className="flex items-start gap-2.5 text-sm text-[#CBD5E1]"><input type="checkbox" className="mt-0.5 h-4 w-4 shrink-0" style={{ accentColor: accent }} checked={remember} onChange={(e) => setRemember(e.target.checked)} /><span>Ghi nhớ đăng nhập trên máy này<span className="block text-xs text-[#64748B]">Không chọn khi dùng máy chung</span></span></label>
              {error && <p className="rounded-md border border-[#EF4444]/40 bg-[#EF4444]/10 px-3 py-2 text-sm text-[#F87171]" role="alert">{error}</p>}
              <button type="submit" disabled={busy || !email || !password}
                className="login-btn flex h-12 w-full items-center justify-center gap-2 rounded-md text-[15px] font-bold text-[#0F141E] transition-[transform,box-shadow,filter] duration-200 disabled:cursor-not-allowed disabled:opacity-50"
                style={{ background: orgId === 'alux' ? `linear-gradient(100deg, ${BRAND.blueHi}, ${BRAND.blue})` : GRAD, color: orgId === 'alux' ? '#fff' : '#0F141E' }}>
                {busy ? <><RefreshCw className="h-4 w-4 motion-safe:animate-spin" aria-hidden />Đang xác thực...</> : <><LogIn className="h-4 w-4" aria-hidden />Đăng nhập<ArrowRight className="login-arrow h-4 w-4 transition-transform duration-200" aria-hidden /></>}
              </button>
              {CLOUD_ON && <p className="flex items-center justify-center gap-1.5 text-[11px] text-[#94A3B8]"><Database className="h-3 w-3" aria-hidden />Dữ liệu lưu trên máy chủ, dùng chung cho cả công ty. Quên mật khẩu: nhờ Giám đốc cấp lại.</p>}
            </form>
          </div>

          {platformHint && (
            <button type="button" className="mt-4 flex w-full items-center gap-3 rounded-lg border border-white/10 bg-white/[0.03] p-3.5 text-left backdrop-blur hover:border-[#F28C33]/50 hover:bg-[#F28C33]/5" onClick={() => { setEmail(`admin@${PLATFORM_DOMAIN}`); setPassword(DEMO_PASSWORD); setError(''); }}>
              <Logo3A size={28} />
              <span className="min-w-0 text-sm"><b className="block">3A Platform Console (Super Admin)</b><span className="text-xs text-[#94A3B8]">admin@{PLATFORM_DOMAIN} / {DEMO_PASSWORD}: quản trị doanh nghiệp, cấp phép module, dữ liệu</span></span>
            </button>
          )}
          {showDemo && (
            <details className="mt-3 rounded-lg border border-white/10 bg-white/[0.02] px-4 py-3 text-sm">
              <summary className="cursor-pointer text-[#94A3B8] hover:text-white">Tài khoản demo theo vai trò (mật khẩu {DEMO_PASSWORD})</summary>
              <div className="mt-2 space-y-1">
                {ROLES.map((r) => {
                  const u = users.find((x) => x.id === ROLE_PERSONA[r]);
                  if (!u) return null;
                  return (
                    <button key={r} type="button" className="flex w-full items-center justify-between gap-3 rounded px-2.5 py-2 text-left hover:bg-white/[0.05] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30" onClick={() => { setEmail(u.email); setPassword(DEMO_PASSWORD); setError(''); }}>
                      <span>{ROLE_LABEL[r]}</span><span className="truncate text-xs text-[#94A3B8]">{u.email}</span>
                    </button>
                  );
                })}
              </div>
            </details>
          )}
          <p className="mt-8 text-center text-[11px] text-[#475569]">© {new Date().getFullYear()} 3A Group Vietnam JSC · Kết nối được mã hóa</p>
        </div>
      </section>

      {/* ---------- Bên phải: slider giới thiệu ---------- */}
      <section className="relative hidden overflow-hidden border-l border-white/[0.06] lg:flex lg:flex-col" onMouseEnter={() => setPaused(true)} onMouseLeave={() => setPaused(false)} aria-roledescription="carousel" aria-label="Giới thiệu nền tảng 3A Group">
        <div className="absolute inset-0 transition-[background] duration-700" style={{ background: `radial-gradient(900px 600px at 70% 20%, ${accent}33, transparent 60%), radial-gradient(700px 500px at 10% 100%, ${BRAND.o1}22, transparent 60%), linear-gradient(180deg, #0B1220, #070B12)` }} aria-hidden />
        <div className="absolute inset-0 opacity-[0.07]" style={{ backgroundImage: 'linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px)', backgroundSize: '48px 48px', maskImage: 'radial-gradient(circle at 60% 40%, black, transparent 75%)' }} aria-hidden />
        <div className="relative flex flex-1 flex-col justify-center px-12 py-12 xl:px-20">
          <div key={`${orgId}-${slide}`} className="motion-safe:animate-[popIn_.5s_ease-out]" role="group" aria-roledescription="slide" aria-label={`${slide + 1} / ${slides.length}: ${cur.title}`}>
            <span className="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-semibold" style={{ color: accentHi }}><i className="h-1.5 w-1.5 rounded-full" style={{ background: accentHi }} />{cur.tag}</span>
            <h2 className="font-display mt-5 max-w-xl text-4xl font-extrabold leading-[1.1] tracking-tight xl:text-5xl">{cur.title}</h2>
            <p className="mt-4 max-w-lg text-base text-[#94A3B8]">{cur.desc}</p>
            <div className="mt-8"><LoginArt kind={cur.kind} accent={accent} /></div>
            <ul className="mt-8 grid max-w-2xl gap-3 xl:grid-cols-3">
              {cur.points.map((p) => <li key={p} className="rounded-lg border border-white/[0.08] bg-white/[0.03] px-4 py-3 text-sm text-[#CBD5E1] backdrop-blur"><CheckCircle2 className="mb-1.5 h-4 w-4" style={{ color: accentHi }} aria-hidden />{p}</li>)}
            </ul>
          </div>
        </div>
        <div className="relative flex items-center gap-3 px-12 pb-10 xl:px-20">
          {slides.map((x, i) => <button key={x.title} onClick={() => setSlide(i)} aria-label={`Xem ${x.title}`} aria-current={i === slide} className="h-1.5 rounded-full transition-all duration-300" style={{ width: i === slide ? 36 : 12, background: i === slide ? accentHi : 'rgba(255,255,255,.2)' }} />)}
          <span className="ml-auto text-xs text-[#64748B]">{paused ? 'Đang tạm dừng' : 'Tự chuyển sau 6 giây'}</span>
        </div>
      </section>
    </div>
  );
}


// =====================================================================
//  ĐỒNG BỘ ĐÁM MÂY (SUPABASE) — dùng chung dữ liệu cho nhiều người
//  Bật khi khai báo NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY (Vercel > Settings > Environment Variables).
//  Không khai báo: app chạy như cũ, dữ liệu lưu trong trình duyệt.
//
//  - Đăng nhập bằng Supabase Auth; quyền vào doanh nghiệp nào do bảng members + Row Level Security quyết định.
//  - Mỗi bản ghi (lead, khách, báo giá, phiếu thu...) là 1 dòng trong bảng records; app chỉ gửi dòng thay đổi,
//    máy khác kéo phần mới mỗi vài giây (theo số thứ tự thay đổi seq).
//  - Ảnh / file đính kèm đưa lên Storage (bucket crm-files), trong dữ liệu chỉ giữ đường dẫn.
//  - Hai người sửa cùng 1 bản ghi: bản lưu sau thắng; sửa khác bản ghi thì không ảnh hưởng nhau.
// =====================================================================

// Next.js thay process.env.NEXT_PUBLIC_* bằng giá trị lúc build; bọc try để môi trường khác không lỗi
const CLOUD_ENV = (() => { try { return { url: process.env.NEXT_PUBLIC_SUPABASE_URL, key: process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY }; } catch { return { url: '', key: '' }; } })();
const CLOUD_URL = (CLOUD_ENV.url || '').trim().replace(/\/+$/, '');
const CLOUD_KEY = (CLOUD_ENV.key || '').trim();
const CLOUD_ON = !!(CLOUD_URL && CLOUD_KEY);
const CLOUD_SESSION_KEY = '3a:cloud-session';
const CLOUD_BUCKET = 'crm-files';
const PLATFORM_TENANT = '_platform';
/** Khóa bí mật tích hợp: không bao giờ gửi lên máy chủ hay đưa vào sao lưu */
const SECRET_FIELDS: Record<string, string[]> = { getfly: ['apiKey', 'webhookSecret'], emailCfg: ['password'], zns: ['secretKey'] };
const secretless = (k: string, v: unknown): unknown => (SECRET_FIELDS[k] && v && typeof v === 'object' ? { ...(v as AnyRec), ...Object.fromEntries(SECRET_FIELDS[k].map((f) => [f, ''])) } : v);
const secretKeep = (k: string, v: unknown): AnyRec => (SECRET_FIELDS[k] && v && typeof v === 'object' ? Object.fromEntries(SECRET_FIELDS[k].map((f) => [f, (v as AnyRec)[f]]).filter(([, x]) => x)) : {});

type CloudSession = { access_token: string; refresh_token: string; expires_at: number; user: { id: string; email: string } };
type CloudRow = { tenant_id: string; coll: string; id: string; data: unknown; rank: number; deleted: boolean; seq?: number };
type CloudAccess = { tenant_id: string; is_admin: boolean; platform: boolean };
type SyncState = 'idle' | 'syncing' | 'error' | 'offline';
type SyncInfo = { state: SyncState; pending: number; lastOk: number | null; error?: string };

class CloudError extends Error {
  status: number;
  code?: string;
  constructor(msg: string, status: number, code?: string) { super(msg); this.status = status; this.code = code; }
}

/** Lỗi từ máy chủ -> câu tiếng Việt dễ hiểu */
function cloudMessage(e: unknown): string {
  const m = e instanceof Error ? e.message : String(e);
  if (/Failed to fetch|NetworkError|Load failed|network/i.test(m)) return 'Không kết nối được máy chủ. Kiểm tra mạng rồi thử lại.';
  if (/Invalid login credentials|invalid_grant/i.test(m)) return 'Email hoặc mật khẩu không đúng';
  if (/Email not confirmed/i.test(m)) return 'Tài khoản chưa xác nhận email. Nhờ quản trị bật "Auto Confirm" hoặc xác nhận trong Supabase.';
  if (/rate limit|too many/i.test(m)) return 'Thao tác quá nhanh, máy chủ tạm chặn. Thử lại sau ít phút.';
  if (/forbidden_target/.test(m)) return 'Không được đổi mật khẩu tài khoản thuộc doanh nghiệp khác hoặc tài khoản 3A Group.';
  if (/forbidden/.test(m)) return 'Tài khoản của bạn không có quyền cấp tài khoản cho doanh nghiệp này.';
  if (/weak_password|Password should be/i.test(m)) return 'Mật khẩu quá ngắn (tối thiểu 8 ký tự).';
  if (/no_user/.test(m)) return 'Chưa có tài khoản đăng nhập cho email này.';
  if (/row-level security|permission denied|42501/i.test(m)) return 'Tài khoản không có quyền ghi dữ liệu doanh nghiệp này.';
  return m;
}

/** Ứng dụng khách Supabase tối giản (gọi thẳng REST API, không cần cài thêm thư viện) */
const cloud = {
  session: null as CloudSession | null,
  remember: true,
  refreshing: null as Promise<void> | null,
  loadSession(): CloudSession | null {
    try {
      const raw = localStorage.getItem(CLOUD_SESSION_KEY) ?? sessionStorage.getItem(CLOUD_SESSION_KEY);
      this.remember = !!localStorage.getItem(CLOUD_SESSION_KEY);
      this.session = raw ? (JSON.parse(raw) as CloudSession) : null;
    } catch { this.session = null; }
    return this.session;
  },
  saveSession(s: CloudSession | null) {
    this.session = s;
    try {
      localStorage.removeItem(CLOUD_SESSION_KEY); sessionStorage.removeItem(CLOUD_SESSION_KEY);
      if (s) (this.remember ? localStorage : sessionStorage).setItem(CLOUD_SESSION_KEY, JSON.stringify(s));
    } catch { /* bỏ qua */ }
  },
  async raw(path: string, init: RequestInit & { token?: string | null } = {}): Promise<Response> {
    const headers = new Headers(init.headers);
    headers.set('apikey', CLOUD_KEY);
    const t = init.token === undefined ? this.session?.access_token : init.token;
    headers.set('Authorization', `Bearer ${t || CLOUD_KEY}`);
    if (init.body && typeof init.body === 'string' && !headers.has('Content-Type')) headers.set('Content-Type', 'application/json');
    return fetch(`${CLOUD_URL}${path}`, { ...init, headers });
  },
  async json<T>(res: Response): Promise<T> {
    const txt = await res.text();
    let body: AnyRec = {};
    try { body = txt ? JSON.parse(txt) : {}; } catch { body = { message: txt }; }
    if (!res.ok) throw new CloudError(String(body.message ?? body.msg ?? body.error_description ?? body.error ?? `HTTP ${res.status}`), res.status, body.code ?? body.error_code);
    return body as T;
  },
  async tokenRequest(grant: 'password' | 'refresh_token', body: AnyRec): Promise<CloudSession> {
    const res = await this.raw(`/auth/v1/token?grant_type=${grant}`, { method: 'POST', body: JSON.stringify(body), token: null });
    const s = await this.json<AnyRec>(res);
    return { access_token: s.access_token, refresh_token: s.refresh_token, expires_at: s.expires_at ?? Math.floor(Date.now() / 1000) + (s.expires_in ?? 3600), user: { id: s.user?.id, email: String(s.user?.email ?? '').toLowerCase() } };
  },
  async signIn(email: string, password: string, remember: boolean) {
    this.remember = remember;
    this.saveSession(await this.tokenRequest('password', { email: email.trim().toLowerCase(), password }));
    return this.session!;
  },
  /** Kiểm tra mật khẩu mà không đổi phiên đang dùng */
  async checkPassword(email: string, password: string): Promise<boolean> {
    try { await this.tokenRequest('password', { email: email.trim().toLowerCase(), password }); return true; }
    catch (e) { if (e instanceof CloudError && e.status < 500) return false; throw e; }
  },
  async refresh() {
    if (!this.session) return;
    if (!this.refreshing) {
      this.refreshing = (async () => {
        try { this.saveSession(await this.tokenRequest('refresh_token', { refresh_token: this.session!.refresh_token })); }
        catch (e) { if (e instanceof CloudError && e.status >= 400 && e.status < 500) this.saveSession(null); throw e; }
        finally { this.refreshing = null; }
      })();
    }
    return this.refreshing;
  },
  /** Gọi API có xác thực; tự gia hạn phiên khi sắp hết hạn hoặc bị từ chối 401 */
  async authed(path: string, init: RequestInit = {}): Promise<Response> {
    if (!this.session) throw new CloudError('Phiên đăng nhập đã hết, vui lòng đăng nhập lại', 401);
    if (this.session.expires_at * 1000 - Date.now() < 60_000) await this.refresh();
    let res = await this.raw(path, init);
    if (res.status === 401 && this.session) { await this.refresh(); res = await this.raw(path, init); }
    return res;
  },
  async signOut() {
    const t = this.session?.access_token;
    this.saveSession(null);
    if (t) { try { await this.raw('/auth/v1/logout', { method: 'POST', token: t }); } catch { /* bỏ qua */ } }
  },
  async updatePassword(password: string) {
    await this.json(await this.authed('/auth/v1/user', { method: 'PUT', body: JSON.stringify({ password }) }));
  },
  async rpc<T>(fn: string, args: AnyRec = {}): Promise<T> {
    return this.json<T>(await this.authed(`/rest/v1/rpc/${fn}`, { method: 'POST', body: JSON.stringify(args) }));
  },
  async access(): Promise<CloudAccess[]> { return this.rpc<CloudAccess[]>('my_access'); },
  /**
   * Tạo / cấp lại tài khoản đăng nhập cho nhân sự: đăng ký email + mật khẩu tạm (không đổi phiên của người đang thao tác),
   * rồi gắn vào doanh nghiệp. Tài khoản đã tồn tại thì chỉ đặt lại mật khẩu tạm.
   */
  async provision(email: string, tenant: string, password: string | null, admin: boolean) {
    const e = email.trim().toLowerCase();
    if (password) {
      const res = await this.raw('/auth/v1/signup', { method: 'POST', body: JSON.stringify({ email: e, password }), token: null });
      if (!res.ok && res.status !== 422 && res.status !== 400) await this.json(res);
    }
    await this.rpc('provision_member', { p_email: e, p_tenant: tenant, p_password: password, p_admin: admin });
  },
  async revoke(email: string, tenant: string) { await this.rpc('revoke_member', { p_email: email.trim().toLowerCase(), p_tenant: tenant }); },
  async select(tenant: string, afterSeq: number): Promise<CloudRow[]> {
    const out: CloudRow[] = [];
    let cursor = afterSeq;
    for (;;) {
      const p = new URLSearchParams({ select: 'tenant_id,coll,id,data,rank,deleted,seq', tenant_id: `eq.${tenant}`, seq: `gt.${cursor}`, order: 'seq.asc', limit: '1000' });
      const rows = await this.json<CloudRow[]>(await this.authed(`/rest/v1/records?${p.toString()}`));
      out.push(...rows);
      if (rows.length < 1000) return out;
      cursor = rows[rows.length - 1].seq ?? cursor;
    }
  },
  async upsert(rows: CloudRow[]) {
    for (let i = 0; i < rows.length;) {
      // gói ~800 KB mỗi lần gửi
      let size = 0; let j = i;
      while (j < rows.length && (j === i || size < 800_000) && j - i < 500) { size += JSON.stringify(rows[j].data).length; j++; }
      const res = await this.authed('/rest/v1/records', { method: 'POST', headers: { Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify(rows.slice(i, j).map(({ seq: _s, ...r }) => r)) });
      if (!res.ok) await this.json(res);
      i = j;
    }
  },
  publicUrl(path: string) { return `${CLOUD_URL}/storage/v1/object/public/${CLOUD_BUCKET}/${path}`; },
  async upload(tenant: string, blob: Blob): Promise<string> {
    const buf = await blob.arrayBuffer();
    const hash = Array.from(new Uint8Array(await subtle().digest('SHA-256', buf)), (b) => b.toString(16).padStart(2, '0')).join('').slice(0, 40);
    const type = blob.type || 'application/octet-stream';
    const ext = ({ 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/gif': 'gif', 'image/svg+xml': 'svg', 'application/pdf': 'pdf' } as Record<string, string>)[type] ?? 'bin';
    const path = `${tenant}/${hash}.${ext}`;
    const res = await this.authed(`/storage/v1/object/${CLOUD_BUCKET}/${path}`, { method: 'POST', headers: { 'Content-Type': type, 'x-upsert': 'false', 'cache-control': '31536000' }, body: blob });
    if (!res.ok) {
      const txt = await res.text();
      if (!/Duplicate|already exists|409/i.test(txt)) throw new CloudError(`Không tải được file lên: ${txt.slice(0, 160)}`, res.status);
    }
    return this.publicUrl(path);
  },
};

// ---------------------------------------------------------------------
//  So sánh dữ liệu: chuỗi JSON chuẩn hóa (khóa sắp xếp) và thay file nhúng bằng đường dẫn đã tải lên
// ---------------------------------------------------------------------

/** Chuỗi là file nhúng cần đưa lên Storage (ảnh base64 lớn hoặc blob: tạm của trình duyệt) */
const isEmbeddedFile = (s: string) => (s.startsWith('data:') && s.length > 2048) || s.startsWith('blob:');
/** Bản đồ file nhúng -> đường dẫn Storage (dùng chung, sống trong phiên) */
const fileUrlMap = new Map<string, string>();
const canonCache = new WeakMap<object, { json: string; files: string[] }>();
function canon(v: unknown): { json: string; files: string[] } {
  if (v === null || typeof v !== 'object') {
    if (typeof v === 'string' && isEmbeddedFile(v)) {
      const url = fileUrlMap.get(v);
      return url ? { json: JSON.stringify(url), files: [] } : { json: JSON.stringify(v.slice(0, 64) + '#' + v.length), files: [v] };
    }
    return { json: v === undefined ? 'null' : JSON.stringify(v), files: [] };
  }
  const hit = canonCache.get(v as object);
  if (hit && !hit.files.some((f) => fileUrlMap.has(f))) return hit;
  const files: string[] = [];
  let json: string;
  if (Array.isArray(v)) {
    json = '[' + v.map((x) => { const c = canon(x); files.push(...c.files); return c.json; }).join(',') + ']';
  } else {
    const keys = Object.keys(v as AnyRec).filter((k) => (v as AnyRec)[k] !== undefined).sort();
    json = '{' + keys.map((k) => { const c = canon((v as AnyRec)[k]); files.push(...c.files); return JSON.stringify(k) + ':' + c.json; }).join(',') + '}';
  }
  const out = { json, files };
  canonCache.set(v as object, out);
  return out;
}
/** Bản sao đã thay file nhúng bằng đường dẫn Storage (để gửi lên máy chủ) */
function withFileUrls(v: unknown): unknown {
  if (typeof v === 'string') return isEmbeddedFile(v) ? fileUrlMap.get(v) ?? v : v;
  if (Array.isArray(v)) return v.map(withFileUrls);
  if (v && typeof v === 'object') return Object.fromEntries(Object.entries(v as AnyRec).filter(([, x]) => x !== undefined).map(([k, x]) => [k, withFileUrls(x)]));
  return v;
}

/** Nhóm dữ liệu lưu theo từng bản ghi (khóa = trường định danh); nhóm khác lưu nguyên khối */
const KEYED_COLLS: Record<string, string> = {
  leads: 'id', customers: 'id', users: 'id', activities: 'id', programs: 'id', claims: 'id', quotes: 'id', pos: 'id', reservations: 'id', moves: 'id',
  genDocs: 'id', comments: 'id', channels: 'id', getflyOrders: 'orderCode', notices: 'id', docs: 'id', approvalLogs: 'id', auditLogs: 'id', workOrders: 'id', installJobs: 'id', jobs: 'id',
  receipts: 'id', stockItems: 'id', stockMoves: 'id', cashEntries: 'id', priceItems: 'id', docTemplates: 'id', skus: 'sku', mktItems: 'id',
  // nền tảng 3A
  tenants: 'id', logs: 'id',
};
const WHOLE = '$';
const META = '$meta';
const rowKey = (coll: string, id: string) => `${coll}\u0001${id}`;

type RemoteChange = { coll: string; id: string; value?: unknown; rank: number; deleted: boolean; prevBase?: string };
type RemoteBatch = { keyed: Record<string, RemoteChange[]>; whole: Record<string, { value: unknown; prevBase?: string }> };

/**
 * Bộ đồng bộ một doanh nghiệp: so dữ liệu trên máy với bản đã đồng bộ (base) theo từng bản ghi,
 * gửi phần đổi; kéo phần mới theo seq và báo cho app áp vào state.
 */
class TenantSync {
  tenant: string;
  base = new Map<string, string>();
  ranks = new Map<string, number>();
  cursor = 0;
  version = 0;
  readOnly = false;
  private latest: AnyRec | null = null;
  private timer: ReturnType<typeof setTimeout> | null = null;
  private pullTimer: ReturnType<typeof setTimeout> | null = null;
  private busy: Promise<void> | null = null;
  private stopped = false;
  private failures = 0;
  info: SyncInfo = { state: 'idle', pending: 0, lastOk: null };
  onInfo: (i: SyncInfo) => void = () => undefined;
  onRemote: (b: RemoteBatch) => void = () => undefined;
  constructor(tenant: string) { this.tenant = tenant; }

  private setInfo(p: Partial<SyncInfo>) { this.info = { ...this.info, ...p }; this.onInfo(this.info); }

  /** Tải toàn bộ dữ liệu doanh nghiệp: trả về { data, version } để app nâng cấp / nạp */
  async load(): Promise<{ data: AnyRec; version: number; rows: number }> {
    const rows = await cloud.select(this.tenant, 0);
    const data: AnyRec = {};
    const lists: Record<string, { rank: number; id: string; value: unknown }[]> = {};
    for (const r of rows) {
      this.cursor = Math.max(this.cursor, r.seq ?? 0);
      if (r.deleted) continue;
      const key = rowKey(r.coll, r.id);
      this.base.set(key, canon(r.data).json);
      this.ranks.set(key, r.rank);
      if (r.coll === META) { if (r.id === 'version') this.version = Number((r.data as AnyRec)?.v ?? 0); continue; }
      if (r.coll === WHOLE) { data[r.id] = r.data; continue; }
      (lists[r.coll] ??= []).push({ rank: r.rank, id: r.id, value: r.data });
    }
    for (const [coll, xs] of Object.entries(lists)) data[coll] = xs.sort((a, b) => a.rank - b.rank || (a.id < b.id ? -1 : 1)).map((x) => x.value);
    this.setInfo({ state: 'idle', lastOk: Date.now(), pending: 0 });
    return { data, version: this.version, rows: rows.length };
  }

  /** Dữ liệu trên máy -> danh sách dòng (giữ thứ tự trong mảng để tính rank cho bản ghi mới) */
  private flatten(data: AnyRec) {
    const out = new Map<string, { coll: string; id: string; value: unknown; order?: { list: string[]; index: number } }>();
    for (const [k, v] of Object.entries(data)) {
      const keyField = KEYED_COLLS[k];
      if (keyField && Array.isArray(v)) {
        const list: string[] = [];
        v.forEach((item) => {
          const idv = item && typeof item === 'object' ? (item as AnyRec)[keyField] : undefined;
          if (idv === undefined || idv === null || idv === '') return;
          const id = String(idv);
          const key = rowKey(k, id);
          if (out.has(key)) return;
          list.push(key);
          out.set(key, { coll: k, id, value: item, order: { list, index: list.length - 1 } });
        });
      } else out.set(rowKey(WHOLE, k), { coll: WHOLE, id: k, value: v });
    }
    out.set(rowKey(META, 'version'), { coll: META, id: 'version', value: { v: DATA_VERSION } });
    return out;
  }

  private rankFor(key: string, order?: { list: string[]; index: number }): number {
    const known = this.ranks.get(key);
    if (known !== undefined) return known;
    if (!order) return 0;
    let prev: number | undefined; let next: number | undefined;
    for (let i = order.index - 1; i >= 0 && prev === undefined; i--) prev = this.ranks.get(order.list[i]);
    for (let i = order.index + 1; i < order.list.length && next === undefined; i++) next = this.ranks.get(order.list[i]);
    const r = prev !== undefined && next !== undefined ? (prev + next) / 2 : prev !== undefined ? prev + 1 : next !== undefined ? next - 1 : order.index;
    this.ranks.set(key, r);
    return r;
  }

  /** Số bản ghi trên máy chưa gửi */
  pendingCount(data: AnyRec | null = this.latest): number {
    if (!data) return 0;
    const flat = this.flatten(data);
    let n = 0;
    for (const [key, x] of flat) if (canon(x.value).json !== this.base.get(key)) n++;
    for (const key of this.base.keys()) if (!flat.has(key)) n++;
    return n;
  }

  /** Hẹn gửi dữ liệu mới nhất (gom nhiều thay đổi liên tiếp) */
  schedule(data: AnyRec) {
    if (this.stopped || this.readOnly) return;
    this.latest = data;
    if (this.timer) clearTimeout(this.timer);
    this.timer = setTimeout(() => { this.timer = null; void this.run(); }, 700);
  }

  /** Gửi ngay phần còn chờ (trước khi đăng xuất / đổi doanh nghiệp) */
  async flush() {
    if (this.timer) { clearTimeout(this.timer); this.timer = null; }
    if (this.busy) await this.busy.catch(() => undefined);
    await this.run().catch(() => undefined);
  }

  private async run(): Promise<void> {
    if (this.busy) { await this.busy.catch(() => undefined); }
    if (this.stopped || this.readOnly || !this.latest) return;
    const data = this.latest;
    const job = this.push(data);
    this.busy = job;
    try { await job; this.failures = 0; }
    catch (e) {
      this.failures++;
      const offline = /Failed to fetch|NetworkError|Load failed/i.test(String((e as Error)?.message));
      this.setInfo({ state: offline ? 'offline' : 'error', error: cloudMessage(e), pending: this.pendingCount(data) });
      // thử lại sau 3s, 6s, 12s... tối đa 60s
      if (!this.stopped) { if (this.timer) clearTimeout(this.timer); this.timer = setTimeout(() => { this.timer = null; void this.run(); }, Math.min(60_000, 3000 * 2 ** Math.min(this.failures - 1, 5))); }
    } finally { if (this.busy === job) this.busy = null; }
  }

  private async push(data: AnyRec) {
    const flat = this.flatten(data);
    const changed: { key: string; coll: string; id: string; value: unknown; order?: { list: string[]; index: number } }[] = [];
    const files = new Set<string>();
    for (const [key, x] of flat) {
      const c = canon(x.value);
      if (c.json === this.base.get(key)) continue;
      c.files.forEach((f) => files.add(f));
      changed.push({ key, ...x });
    }
    const removed = [...this.base.keys()].filter((k) => !flat.has(k));
    if (!changed.length && !removed.length) { this.setInfo({ state: 'idle', pending: 0, lastOk: Date.now(), error: undefined }); return; }
    this.setInfo({ state: 'syncing', pending: changed.length + removed.length });
    // 1. Đưa file nhúng lên Storage
    for (const f of files) {
      if (fileUrlMap.has(f)) continue;
      let blob: Blob | null = null;
      try { blob = await (await fetch(f)).blob(); } catch { blob = null; }
      if (!blob) { fileUrlMap.set(f, ''); continue; } // blob: đã hết hạn từ phiên trước, bỏ qua
      fileUrlMap.set(f, await cloud.upload(this.tenant, blob));
    }
    // 2. Gửi bản ghi đổi + đánh dấu xóa
    const rows: CloudRow[] = [];
    const sent: [string, string][] = [];
    for (const x of changed) {
      const json = canon(x.value).json;
      rows.push({ tenant_id: this.tenant, coll: x.coll, id: x.id, data: withFileUrls(x.value), rank: this.rankFor(x.key, x.order), deleted: false });
      sent.push([x.key, json]);
    }
    for (const key of removed) {
      const [coll, id] = key.split('\u0001');
      rows.push({ tenant_id: this.tenant, coll, id, data: {}, rank: this.ranks.get(key) ?? 0, deleted: true });
    }
    await cloud.upsert(rows);
    for (const [key, json] of sent) this.base.set(key, json);
    for (const key of removed) { this.base.delete(key); this.ranks.delete(key); }
    const left = this.latest === data ? 0 : this.pendingCount();
    this.setInfo({ state: 'idle', pending: left, lastOk: Date.now(), error: undefined });
    tenantCloudStats[this.tenant] = { ...(tenantCloudStats[this.tenant] ?? statsOf(data)), ...statsOf(data), savedAt: Date.now() };
  }

  /** Kéo thay đổi của người khác (đọc lại một khoảng nhỏ phía trước để không sót giao dịch ghi chậm) */
  async pull() {
    if (this.stopped) return;
    const rows = await cloud.select(this.tenant, Math.max(0, this.cursor - 40));
    const batch: RemoteBatch = { keyed: {}, whole: {} };
    let n = 0;
    for (const r of rows) {
      this.cursor = Math.max(this.cursor, r.seq ?? 0);
      const key = rowKey(r.coll, r.id);
      const prevBase = this.base.get(key);
      if (r.deleted) {
        if (prevBase === undefined) continue;
        this.base.delete(key); this.ranks.delete(key);
        if (r.coll !== WHOLE && r.coll !== META) { (batch.keyed[r.coll] ??= []).push({ coll: r.coll, id: r.id, rank: r.rank, deleted: true, prevBase }); n++; }
        continue;
      }
      const json = canon(r.data).json;
      if (json === prevBase) continue;
      this.base.set(key, json);
      this.ranks.set(key, r.rank);
      if (r.coll === META) { const v = Number((r.data as AnyRec)?.v ?? 0); if (v > DATA_VERSION) this.readOnly = true; continue; }
      if (r.coll === WHOLE) batch.whole[r.id] = { value: r.data, prevBase };
      else (batch.keyed[r.coll] ??= []).push({ coll: r.coll, id: r.id, value: r.data, rank: r.rank, deleted: false, prevBase });
      n++;
    }
    if (n) this.onRemote(batch);
    if (this.info.state === 'offline' || this.info.state === 'error') { if (!this.timer) this.setInfo({ state: 'idle', error: undefined }); }
    else this.setInfo({ lastOk: Date.now() });
  }

  /** Kéo định kỳ: 5 giây khi đang mở tab, 60 giây khi tab ẩn */
  startPolling() {
    const tick = async () => {
      if (this.stopped) return;
      try { await this.pull(); } catch (e) { if (this.info.state !== 'error') this.setInfo({ state: /Failed to fetch|NetworkError|Load failed/i.test(String((e as Error)?.message)) ? 'offline' : 'error', error: cloudMessage(e) }); }
      const hidden = typeof document !== 'undefined' && document.visibilityState === 'hidden';
      if (!this.stopped) this.pullTimer = setTimeout(() => void tick(), hidden ? 60_000 : 5_000);
    };
    this.pullTimer = setTimeout(() => void tick(), 5_000);
  }

  /** Áp dữ liệu nhận về vào 1 mảng trên máy (bản ghi đang sửa dở trên máy thì giữ bản trên máy) */
  mergeList(prev: AnyRec[], coll: string, changes: RemoteChange[]): AnyRec[] {
    const keyField = KEYED_COLLS[coll];
    let arr = prev.slice();
    for (const c of changes) {
      const idx = arr.findIndex((x) => x && String(x[keyField]) === c.id);
      const localDirty = idx >= 0 && c.prevBase !== undefined && canon(arr[idx]).json !== c.prevBase;
      if (localDirty) continue;
      if (c.deleted) { if (idx >= 0) arr = arr.filter((_, i) => i !== idx); continue; }
      if (idx >= 0) { arr[idx] = c.value as AnyRec; continue; }
      const at = arr.findIndex((x) => { const r = x ? this.ranks.get(rowKey(coll, String(x[keyField]))) : undefined; return r !== undefined && r > c.rank; });
      if (at < 0) arr.push(c.value as AnyRec); else arr.splice(at, 0, c.value as AnyRec);
    }
    return arr;
  }

  stop() {
    this.stopped = true;
    if (this.timer) clearTimeout(this.timer);
    if (this.pullTimer) clearTimeout(this.pullTimer);
  }
}

/** Thông số dữ liệu từng doanh nghiệp cho 3A Console ở chế độ đám mây (cập nhật khi mở / đồng bộ) */
const tenantCloudStats: Record<string, { size: number; version: number; savedAt: number; users: number; activeUsers: number; customers: number; records: number }> = {};
function statsOf(d: AnyRec) {
  const users = (Array.isArray(d.users) ? d.users : []) as User[];
  return { size: JSON.stringify(d).length * 2, version: DATA_VERSION, savedAt: Date.now(), users: users.length, activeUsers: users.filter((u) => u.active).length, customers: Array.isArray(d.customers) ? d.customers.length : 0, records: (Array.isArray(d.jobs) ? d.jobs.length : 0) + (Array.isArray(d.leads) ? d.leads.length : 0) };
}

