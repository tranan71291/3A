/** Nút phụ: viền mảnh, hover chuyển xanh dương đậm (accent logo) */
const btnGhost = cn(btnBase, 'border border-[#263044] px-3 py-1.5 text-[#F1F5F9] hover:border-[#0B5FB8] hover:bg-[#0B5FB8]/15 hover:text-white');
const btnSm = 'px-2.5 py-1 text-xs';
/** Ô nhập không cố định chiều rộng (dùng khi cần w-auto / w-16 / flex-1...) */
