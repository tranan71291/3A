/** Gradient thương hiệu dùng trong style inline (thanh tiến độ, biểu đồ) */
const GRAD = `linear-gradient(90deg, ${BRAND.o1}, ${BRAND.o2} 55%, ${BRAND.o3})`;
const C = {
  bg: '#0F141E',
  surface: '#151C29',
  card: '#1C2534',
  line: '#263044',
  text: '#F1F5F9',
  muted: '#94A3B8',
  orange: '#F28C33',
  teal: '#00B894',
  red: '#EF4444',
  blue: '#2F7FD8',
  sand: '#F9C25A',
} as const;

/**
 * Ghép class Tailwind và gỡ class xung đột (class sau thắng), giống tailwind-merge rút gọn:
 * tránh lỗi inputCls có w-full / py-2 / text-sm mà truyền thêm w-auto / py-1 / text-xs không có tác dụng.
 */
const TW_GROUPS: [RegExp, string, string[]?][] = [
  [/^w-/, 'w'], [/^h-/, 'h'], [/^min-w-/, 'minw'], [/^max-w-/, 'maxw'], [/^min-h-/, 'minh'], [/^max-h-/, 'maxh'],
  [/^p-/, 'p', ['px', 'py', 'pt', 'pb', 'pl', 'pr']], [/^px-/, 'px', ['pl', 'pr']], [/^py-/, 'py', ['pt', 'pb']], [/^pt-/, 'pt'], [/^pb-/, 'pb'], [/^pl-/, 'pl'], [/^pr-/, 'pr'],
  [/^text-(xs|sm|base|lg|xl|[2-9]xl|\[\d)/, 'fs'], [/^text-(left|center|right|justify)$/, 'ta'], [/^text-/, 'tc'],
  [/^font-(thin|light|normal|medium|semibold|bold|extrabold|black)$/, 'fw'],
  [/^bg-(?!gradient)/, 'bg'], [/^rounded(-(none|sm|md|lg|xl|2xl|3xl|full))?$/, 'rounded'], [/^border-(\[#|transparent|white|black)/, 'bc'],
  [/^(block|inline-block|inline|flex|inline-flex|grid|hidden)$/, 'display'], [/^justify-(start|end|center|between|around|evenly)$/, 'justify'], [/^items-/, 'items'],
];
function cn(...c: (string | false | null | undefined)[]) {
  const list = c.filter(Boolean).join(' ').split(/\s+/).filter(Boolean);
  const seen = new Set<string>();
  const out: string[] = [];
  for (let i = list.length - 1; i >= 0; i--) {
    const cls = list[i];
    const k = cls.lastIndexOf(':');
    const variant = k >= 0 && !cls.startsWith('[') ? cls.slice(0, k + 1) : '';
    const base = (variant ? cls.slice(k + 1) : cls).replace(/^!/, '');
    const g = TW_GROUPS.find(([re]) => re.test(base));
    if (g) {
      const key = variant + g[1];
      if (seen.has(key)) continue;
      seen.add(key);
      g[2]?.forEach((x) => seen.add(variant + x));
    }
    out.push(cls);
  }
  return out.reverse().join(' ');
}
const vnd = (n: number) => new Intl.NumberFormat('vi-VN').format(Math.round(n)) + ' ₫';
const compact = (n: number) =>
  Math.abs(n) >= 1e9
    ? (n / 1e9).toLocaleString('vi-VN', { maximumFractionDigits: 2 }) + ' tỷ'
    : (n / 1e6).toLocaleString('vi-VN', { maximumFractionDigits: 1 }) + ' tr';
const pct = (a: number, b: number) =>
  (b ? ((a / b) * 100).toLocaleString('vi-VN', { maximumFractionDigits: 1 }) : '0') + '%';
const fmtDate = (iso?: string) => (iso ? iso.split('-').reverse().join('/') : '');
const todayISO = () => new Date().toISOString().slice(0, 10);
const uid = (p: string) => `${p}${Math.random().toString(36).slice(2, 9)}`;
const MST_RE = /^\d{10}(-\d{3})?$/;
const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const digits = (v: string) => Number(v.replace(/[^\d]/g, '') || 0);
const initials = (name: string) => name.split(' ').slice(-2).map((w) => w[0]).join('').toUpperCase();

/** Sinh mã kế tiếp theo hậu tố số: LD-2026-0418, KH-000108... */
const nextCode = (codes: string[], prefix: string, pad: number) => {
  const max = codes.reduce((m, c) => Math.max(m, Number(c.match(/(\d+)$/)?.[1] ?? 0)), 0);
  return `${prefix}${String(max + 1).padStart(pad, '0')}`;
};


// =====================================================================
//  TYPES
// =====================================================================

type DeptCode = string;
type Role = 'BOD' | 'MKT_LEAD' | 'DEPT_HEAD' | 'SALES_REP' | 'ACCOUNTANT';
type Region = 'NORTH' | 'SOUTH';
type GlobalFilter = { region: 'ALL' | Region; dept: string; brand: string };
const GF_ALL: GlobalFilter = { region: 'ALL', dept: 'ALL', brand: 'ALL' };
const gfCount = (f: GlobalFilter) => [f.region !== 'ALL', f.dept !== 'ALL', f.brand !== 'ALL'].filter(Boolean).length;
/** Mã danh mục động — xem phần DANH MỤC CẤU HÌNH */
type Segment = string;
type Tier = string;
type ProgramType = string;
type PopType = string;
type Source =
  | 'WEBSITE_FORM' | 'FACEBOOK_ADS' | 'GOOGLE_ADS' | 'ZALO_OA' | 'HOTLINE'
  | 'EXHIBITION' | 'TECH_SEMINAR' | 'REFERRAL' | 'VENDOR_REFERRAL';
/** NEW -> NURTURE | ROUTED (bước 1: MKT phân phòng) -> ASSIGNED (bước 2: TP chỉ định Sales, SLA 2h)
 *  -> ACCEPTED (khảo sát & lên báo giá, SLA 24h) -> QUOTED -> WON (Chốt đơn) | LOST (Trượt) */
type LeadStatus = 'NEW' | 'NURTURE' | 'ROUTED' | 'ASSIGNED' | 'ACCEPTED' | 'QUOTED' | 'WON' | 'LOST';
type LostReason = 'PRICE' | 'SCHEDULE' | 'TECHNICAL' | 'COMPETITOR';
type ProgramStatus = 'PENDING_INTERNAL' | 'PENDING_VENDOR' | 'APPROVED' | 'CLAIMING' | 'CLOSED' | 'REJECTED' | 'CANCELLED';
type Verification = 'PENDING' | 'VERIFIED' | 'REJECTED';
type Module = 'overview' | 'tasks' | 'leads' | 'customers' | 'jobs' | 'projects' | 'products' | 'supply' | 'claims' | 'production' | 'install' | 'inventory' | 'cashbook' | 'staff' | 'docs' | 'reports' | 'settings' | 'messages';
type Action =
  | 'lead.create' | 'lead.route' | 'lead.assign' | 'lead.accept' | 'customer.edit' | 'docs.manage'
  | 'program.create' | 'program.approveInternal' | 'program.vendorDecision'
  | 'claim.uploadPop' | 'claim.verify' | 'claim.submit' | 'claim.accounting'
  | 'project.update' | 'price.request' | 'price.decide' | 'settings.edit'
  | 'mdf.margin' | 'po.manage' | 'stock.deliver' | 'stock.release'
  | 'price.viewCost' | 'contract.approve' | 'template.manage' | 'activity.approve'
  | 'quote.approve' | 'production.manage' | 'install.manage' | 'data.backup' | 'security.manage'
  | 'job.manage' | 'receipt.confirm' | 'priceList.manage' | 'stock.manage' | 'cash.manage';
type Tone = 'muted' | 'orange' | 'teal' | 'red' | 'blue';
type BoqStatus = 'NOT_STARTED' | 'IN_PROGRESS' | 'DONE';
type FundCode = 'MDF' | 'CS';
/** Hình thức quyết toán với 3M: khoán theo hoạt động (giữ thặng dư) hoặc hoàn ứng theo chi phí thực tế (không giữ thặng dư) */
type Settlement = 'LUMP_SUM' | 'ACTUAL_COST';
type SurplusAllocation = 'COMPANY_PROFIT' | 'REINVEST';
/** Dòng đối soát 2 tầng: mức 3M duyệt cho hạng mục và chi phí thực trả nhà cung cấp */
type CostLine = { id: string; item: string; supplier: string; approved: number; actual: number; invoiceNo?: string };

/** basePrice: giá bán lẻ; dealerPrice: giá đại lý; projectPrice: giá dự án M&E; costPrice: giá vốn nhập Hãng (chỉ TP / BOD xem) */
type SkuItem = { sku: string; name: string; brand: string; category: string; unit: string; minStock: number; maxStock: number; leadTimeDays: number; stock: number; costPrice: number; basePrice: number; dealerPrice: number; projectPrice: number };

// ---------------- Bộ sinh báo giá & hợp đồng theo mẫu ----------------
type TxType = 'DEALER' | 'PROJECT_ME' | 'SUPPLY_INSTALL' | 'RETAIL_CASH' | 'FACTORY' | 'EPC_SUB' | 'FRAMEWORK' | 'SAMPLE' | 'SERVICE' | 'TRADING';
type PriceTier = 'BASE' | 'DEALER' | 'PROJECT' | 'BOQ';
type DocTemplate = {
  id: string;
  kind: 'QUOTE' | 'CONTRACT';
  name: string;
  txType: TxType;
  /** Mẫu báo giá: mẫu hợp đồng đi kèm được gợi ý */
  pairId?: string;
  body: string;
  /** Mẫu hợp đồng: số ngày công nợ chuẩn; vượt mức này cần duyệt */
  standardCreditDays: number;
  defaultTier: PriceTier;
  defaultDelivery: string;
  system?: boolean;
  sourceFile?: { name: string; url: string };
  updatedAt: string;
};
/** price = đơn giá chốt; listPrice / discountPct để sửa chiết khấu trên màn soạn */
type DocLine = { sku: string; name: string; unit: string; qty: number; price: number; listPrice?: number; discountPct?: number };
type GuaranteeType = 'NONE' | 'PERFORMANCE' | 'ADVANCE' | 'WARRANTY';
type ComposerForm = {
  txType: TxType;
  quoteTplId: string;
  contractTplId: string;
  tier: PriceTier;
  leadId?: string;
  customerId?: string;
  party: { name: string; taxCode: string; address: string; rep: string; repTitle: string; phone: string; email: string };
  items: DocLine[];
  vatPct: number;
  delivery: string;
  advancePct: number;
  guaranteeType: GuaranteeType;
  guaranteePct: number;
  warrantyMonths: number;
  creditDays: number;
  paymentMethod: string;
  validDays: number;
  note: string;
};
type GenDocStatus = 'DRAFT' | 'ISSUED' | 'PENDING_APPROVAL' | 'APPROVED' | 'REJECTED' | 'SUPERSEDED';
type GeneratedDoc = {
  id: string;
  quoteCode: string;
  contractCode: string;
  leadId?: string;
  customerId?: string;
  partyName: string;
  form: ComposerForm;
  total: number;
  /** Lý do cần duyệt (điều khoản công nợ đặc biệt...) */
  special: string[];
  status: GenDocStatus;
  /** Dấu vân tay nội dung lúc duyệt: sửa sau duyệt phải duyệt lại */
  fingerprint?: string;
  createdAt: string;
  createdBy?: string;
  approvedBy?: string;
  approvedAt?: string;
  rejectNote?: string;
  quoteId?: string;
  submittedAt?: number;
  /** Nhóm phiên bản của cùng một hợp đồng và số phiên bản (v1, v2...) */
  groupId?: string;
  version?: number;
  exports: { kind: 'QUOTE' | 'CONTRACT'; format: 'PDF' | 'WORD'; at: string; by?: string }[];
};
type ShipMode = 'SEA' | 'AIR' | 'ROAD';
type ShipmentStatus = 'PLANNED' | 'IN_TRANSIT' | 'ARRIVED' | 'RECEIVED';
/** Giữ chỗ hàng cho dự án (lead) hoặc khách hàng; phần còn lại nhập tồn kho tự do */
type PoAllocation = { kind: 'LEAD' | 'CUSTOMER'; refId: string; qty: number };
type PoLine = { sku: string; qty: number; unitPrice: number; allocations: PoAllocation[] };
/** Phân bổ của một đợt được chốt lại tại thời điểm nhập kho (không tính lại về sau) */
type AllocSnapshot = { sku: string; reserved: PoAllocation[]; free: number };
type Shipment = { id: string; code: string; mode: ShipMode; docNo: string; etd?: string; eta: string; status: ShipmentStatus; receivedAt?: string; lines: { sku: string; qty: number }[]; allocSnapshot?: AllocSnapshot[] };
/**
 * Hàng giữ chỗ đang nằm trong kho cho một dự án / khách hàng.
 * HELD -> (xuất giao) DELIVERED | (dự án Trượt / yêu cầu trả) PENDING_RELEASE -> (TP/BOD xác nhận) RELEASED hoặc chuyển đích
 */
type ReservationStatus = 'HELD' | 'PENDING_RELEASE' | 'DELIVERED' | 'RELEASED';
type StockReservation = {
  id: string; sku: string; kind: PoAllocation['kind']; refId: string; qty: number; delivered: number;
  poId?: string; shipmentId?: string; receivedAt: string; status: ReservationStatus;
  releaseRequest?: { at: string; by?: string; reason: string };
};
type StockMoveType = 'RECEIVE_FREE' | 'RECEIVE_RESERVED' | 'DELIVER' | 'RELEASE' | 'TRANSFER' | 'RESERVE_FROM_STOCK';
type StockMove = { id: string; at: string; sku: string; type: StockMoveType; qty: number; kind?: PoAllocation['kind']; refId?: string; poId?: string; by?: string; note: string };
type PoPurpose = 'PROJECT' | 'STOCK' | 'MIXED';
type VendorPO = { id: string; code: string; vendor: string; orderDate: string; expectedDate: string; purpose: PoPurpose; note: string; lines: PoLine[]; shipments: Shipment[]; createdBy?: string; cancelled?: boolean };
type QuoteStatus = 'SENT' | 'REVISED' | 'ACCEPTED' | 'REJECTED';
type ApprovalLevel = 'AUTO' | 'HEAD' | 'BOD';
/** Trạng thái quan hệ khách hàng */
type CustomerStatus = 'PROSPECT' | 'INTERESTED' | 'FOLLOW' | 'ACTIVE';
type DateRange = { from: string; to: string };

type Department = { code: DeptCode; name: string; short: string; slaMinutes: number; headId?: string; receivesLeads: boolean; active: boolean };
type User = {
  id: string; name: string; email: string; phone?: string; role: Role; dept?: DeptCode; active: boolean; approvalLimit: number;
  /** Mật khẩu băm PBKDF2-SHA256 (base64) + salt; chưa có thì dùng mật khẩu khởi tạo và băm ở lần đăng nhập đầu */
