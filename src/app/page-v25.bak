/** 'ALL' | 'BOD_ACC' | mã phòng ban (chỉ phòng đó xem) */
type DocVisibility = string;
type DocItem = {
  id: string;
  title: string;
  category: DocCategory;
  visibility: DocVisibility;
  ownerId: string;
  updatedAt: string; // ISO Y-m-d
  version: string;
  format: 'PDF' | 'DOCX' | 'XLSX' | 'PPTX';
  sizeKb: number;
  summary: string;
  tags: string[];
  url?: string;
};

