  lastActiveAt?: number;
  passwordChangedAt?: number;
};

type PriceProtection = { status: 'REQUESTED' | 'APPROVED' | 'REJECTED'; discountPct: number; reason: string; ref?: string; validUntil?: string };
type BoqItem = { code: string; name: string; unit: string; qty: number; price: number; discountPct: number };
type Attachment = { name: string; url: string; size: number };

