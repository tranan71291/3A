    WO('wo4', j8, 'DONE', -42, -6),
    WO('wo5', j9, 'DONE', -86, -58),
    WO('wo6', j10, 'DONE', -64, -42),
    WO('wo8', j14, 'DONE', -19, -2),
    WO('wo9', j15, 'DONE', -69, -46),
    WO('wo10', j16, 'DONE', -44, -18),
  ];
  const IJ = (id: string, j: Job, woId: string, leader: string, team: string[], fromDay: number, status: InstallStatus, extra: Partial<InstallJob> = {}): InstallJob => ({
    id: P + id, code: `LD-DEMO-${id.slice(2).padStart(2, '0')}`, title: `Lắp đặt ${j.title}`, workOrderId: P + woId, jobId: j.id, leadId: j.leadId, customerId: j.customerId, address: j.siteAddress,
    leaderId: P + leader, team: team.map((x) => P + x), from: local(fromDay, 8), to: local(fromDay, 17), status, checkins: [], defects: [], note: '', createdAt: isoD(fromDay - 3), ...extra,
  });
  let dn = 0;
  const acc = (day: number, rep: string, by: string, j: Job, paid: number, method: 'CASH' | 'TRANSFER', result: 'PASS' | 'PASS_WITH_NOTES' = 'PASS', note = ''): InstallAcceptance => ({
    at: isoT(day, 16), customerRep: rep, customerTitle: 'Chủ nhà', result, note, by: P + by, docCode: `BBNT-DEMO-${String(++dn).padStart(3, '0')}`, signedAt: ms(day, 16),
    checked: (wonQuoteOf(j)?.lines ?? []).map((l) => `${l.location ? `${l.location}: ` : ''}${l.name}`), paidAmount: paid, paidMethod: method, debtAfter: 0, warrantyMonths: j.warrantyMonths,
    warrantyUntil: addMonthsISO(isoD(day), j.warrantyMonths), hash: `demo${day}${by}`.padEnd(64, '0'),
  });
  const installJobs: InstallJob[] = [
    IJ('ij6', j14, 'wo8', 'ld1', ['ld2'], 1, 'SCHEDULED', { note: 'Khách hẹn 8h, gửi xe hầm B1' }),
    IJ('ij2', j7, 'wo3', 'ld2', [], 0, 'IN_PROGRESS', { checkins: [{ at: isoT(0, 8), lat: 10.80211, lng: 106.74432, photos: [] }], defects: [{ id: P + 'df1', text: 'Ron cao su vách tắm 2 bị hở góc dưới', fixed: false, at: ms(0, 11) }], note: 'Đăng ký thi công với BQL Masteri' }),
    IJ('ij3', j8, 'wo4', 'ld1', ['ld2'], -1, 'ACCEPTED', { checkins: [{ at: isoT(-1, 8), lat: 10.82101, lng: 106.68712, photos: [] }], acceptance: acc(-1, 'Võ Thành Nam', 'ld1', j8, rest(j8), 'CASH') }),
    IJ('ij4', j9, 'wo5', 'ld2', ['ld1'], -52, 'ACCEPTED', { acceptance: acc(-50, 'Ngô Thanh Sơn', 'ld2', j9, rest(j9), 'TRANSFER', 'PASS_WITH_NOTES', 'Bổ sung keo silicon giếng trời trong tuần'), defects: [{ id: P + 'df2', text: 'Bổ sung keo silicon mép giếng trời', fixed: true, at: ms(-50, 15) }] }),
    IJ('ij5', j10, 'wo6', 'ld1', [], -38, 'ACCEPTED', { acceptance: acc(-38, 'Đinh Thu Phương', 'ld1', j10, rest(j10), 'CASH') }),
    IJ('ij7', j15, 'wo9', 'ld2', ['ld1'], -40, 'ACCEPTED', { acceptance: { ...acc(-40, 'Tạ Quang Vinh', 'ld2', j15, 20_000_000, 'CASH'), debtAfter: rest(j15) - 20_000_000 } }),
    IJ('ij8', j16, 'wo10', 'ld1', [], -12, 'ACCEPTED', { acceptance: { ...acc(-12, 'Lưu Bảo Châu', 'ld1', j16, 0, 'CASH'), paidMethod: undefined, debtAfter: rest(j16) } }),
  ];

  // ---- Kho vật tư: nhập theo đợt, xuất cho từng lệnh sản xuất ----
  const cat = stockCatalog.length ? stockCatalog : ALUX_STOCK_ITEMS;
  const si = (id: string) => cat.find((x) => x.id === id) ?? cat[0];
  const stockMoves: InvMove[] = [];
  const voucher = (type: InvMoveType, no: number, day: number, lines: [string, number][], extra: Partial<InvMove> = {}) => {
    const code = `${STOCK_MOVE[type].prefix}-DEMO-${String(no).padStart(3, '0')}`;
    lines.forEach(([id, qty], i) => stockMoves.push({ id: `${P}sm${type}${no}-${i}`, code, type, date: isoD(day), itemId: si(id).id, qty, unitCost: si(id).cost, by: P + (type === 'IN' ? 'ketoan' : 'xuong'), at: ms(day, 10) + i, ...extra }));
    return code;
  };
  const in1 = voucher('IN', 1, -90, [['si-xf55', 160], ['si-k595', 90], ['si-kinlong', 30], ['si-silicon', 300], ['si-gioang', 900]], { partner: 'Nhôm Xingfa Đông Á' });
  const in2 = voucher('IN', 2, -70, [['si-mdf', 60], ['si-acr', 30], ['si-banle', 200]], { partner: 'Gỗ An Cường' });
  const in3 = voucher('IN', 3, -45, [['si-k10', 60], ['si-k12', 50], ['si-inox', 80], ['si-xf93', 40]], { partner: 'Kính Việt Nhật' });
  const in4 = voucher('IN', 4, -12, [['si-xf55', 120], ['si-k595', 60], ['si-kinlong', 20]], { partner: 'Nhôm Xingfa Đông Á' });
  const out = (no: number, day: number, w: WorkOrder, lines: [string, number][]) => voucher('OUT', no, day, lines, { woId: w.id, jobId: w.jobId });
  out(1, -84, workOrders[5], [['si-xf55', 52], ['si-k595', 38], ['si-kinlong', 3], ['si-silicon', 40], ['si-gioang', 180]]);
  out(2, -62, workOrders[6], [['si-mdf', 14], ['si-acr', 6], ['si-banle', 36], ['si-silicon', 10]]);
  out(3, -40, workOrders[4], [['si-xf55', 18], ['si-k595', 9], ['si-kinlong', 1], ['si-inox', 8], ['si-silicon', 20]]);
  out(4, -32, workOrders[3], [['si-k10', 7], ['si-silicon', 12], ['si-gioang', 40]]);
  out(5, -26, workOrders[2], [['si-mdf', 18], ['si-acr', 7], ['si-banle', 42], ['si-silicon', 10]]);
  out(6, -17, workOrders[7], [['si-k12', 11], ['si-inox', 19], ['si-silicon', 16]]);
  out(7, -11, workOrders[1], [['si-xf55', 96], ['si-k595', 36], ['si-xf93', 22], ['si-kinlong', 6], ['si-silicon', 90], ['si-gioang', 420]]);
  voucher('ADJUST', 1, -5, [['si-silicon', -6]], { partner: 'Kiểm kê cuối tháng', note: 'Hao hụt keo hết hạn' });

  // ---- Thu chi: thanh toán NCC, nhân công lắp, chi phí chung ----
  const val2 = (code: string) => Math.round(stockMoves.filter((m) => m.code === code).reduce((x, m) => x + m.qty * m.unitCost, 0));
  let cn = 0;
  const CE = (kind: CashEntry['kind'], day: number, account: CashAccount, category: string, amount: number, extra: Partial<CashEntry> = {}): CashEntry => ({
    id: `${P}ce${++cn}`, code: `${kind === 'IN' ? 'PTK' : kind === 'OUT' ? 'PC' : 'CQ'}-DEMO-${String(cn).padStart(3, '0')}`, kind, date: isoD(day), account, category, amount, by: P + 'ketoan', at: ms(day, 11), ...extra,
  });
  const cashEntries: CashEntry[] = [
    CE('OUT', -90, 'BANK', 'Vật tư, nguyên liệu', val2(in1), { partner: 'Nhôm Xingfa Đông Á', ref: in1 }),
    CE('OUT', -70, 'BANK', 'Vật tư, nguyên liệu', val2(in2), { partner: 'Gỗ An Cường', ref: in2 }),
    CE('OUT', -45, 'BANK', 'Vật tư, nguyên liệu', val2(in3), { partner: 'Kính Việt Nhật', ref: in3 }),
    CE('OUT', -12, 'BANK', 'Vật tư, nguyên liệu', Math.round(val2(in4) / 2), { partner: 'Nhôm Xingfa Đông Á', ref: in4, note: 'Thanh toán 50%, còn nợ 50%' }),
    CE('OUT', -50, 'CASH', 'Nhân công lắp đặt', 6_500_000, { jobId: j9.id, partner: 'Đội lắp Hùng', note: 'Khoán lắp biệt thự Long Thới' }),
    CE('OUT', -38, 'CASH', 'Nhân công lắp đặt', 1_800_000, { jobId: j10.id, partner: 'Đội lắp Hùng' }),
    CE('OUT', -1, 'CASH', 'Nhân công lắp đặt', 2_200_000, { jobId: j8.id, partner: 'Đội lắp Hùng' }),
    CE('OUT', -1, 'CASH', 'Vận chuyển', 800_000, { jobId: j8.id, partner: 'Xe tải Minh Phát' }),
    CE('OUT', -48, 'CASH', 'Hoa hồng giới thiệu', 7_000_000, { jobId: j9.id, partner: 'KTS Ngô Thanh Sơn' }),
    ...[-65, -35, -5].map((d) => CE('OUT', d, 'BANK', 'Lương, thưởng', 92_000_000, { note: 'Lương tháng' })),
    ...[-62, -32, -2].map((d) => CE('OUT', d, 'BANK', 'Mặt bằng, điện nước', 18_500_000, { partner: 'Xưởng Nhà Bè' })),
    CE('OUT', -20, 'CASH', 'Marketing', 6_000_000, { partner: 'Quảng cáo Facebook' }),
    CE('IN', -25, 'CASH', 'Bán phế liệu', 3_200_000, { partner: 'Vựa phế liệu Tấn Lộc', note: 'Nhôm vụn, kính vỡ' }),
    ...(() => { const base = wonQuoteOf(j10)!.subtotal; return [CE('OUT', -30, 'BANK', 'Hoa hồng', Math.round((base * cfg.salesCommissionPct) / 100), { jobId: j10.id, partner: 'Lý Minh Nhật', ref: j10.code, source: 'COMMISSION', sourceId: `${j10.id}:${P}kt2:SALES` }),
      CE('OUT', -30, 'BANK', 'Hoa hồng', Math.round((base * cfg.installCommissionPct) / 100), { jobId: j10.id, partner: 'Bùi Văn Hùng', ref: j10.code, source: 'COMMISSION', sourceId: `${j10.id}:${P}ld1:INSTALL` })]; })(),
    CE('TRANSFER', -30, 'CASH', 'Chuyển quỹ', 40_000_000, { toAccount: 'BANK', note: 'Nộp tiền mặt vào tài khoản' }),
  ];
  return { users, customers, leads, jobs, receipts, workOrders, installJobs, stockMoves, cashEntries, opening: { cash: 60_000_000, bank: 450_000_000 } };
}

function useDemoData() {
  const app = useApp();
  const { me, users, setUsers, departments, setDepartments, customers, setCustomers, leads, setLeads, quotes, setQuotes, skus, setSkus, setPos,
    setPrograms, setClaims, setActivities, setMktItems, setDocs, budgets, setBudgets, budget, tierRules, sources, notify, setGenDocs, routableDepts, setWorkOrders, setInstallJobs,
    company, jobs, setJobs, setReceipts, priceItems, mfgConfig, setMfgConfig, segments, stockItems, setStockItems, setStockMoves, setCashEntries, setGetflyOrders } = app;
  const mode = bizMode(company);

  /** Mô hình xưởng: nhân sự kỹ thuật / xưởng / đội lắp, khách lẻ, đơn hàng ở mọi giai đoạn, phiếu thu */
  const seedMfg = () => {
    const d = buildMfgDemo(Date.now(), priceItems, mfgConfig, sources, segments, stockItems);
    if (!stockItems.length) setStockItems(ALUX_STOCK_ITEMS);
    setStockMoves((p) => [...d.stockMoves, ...p]);
    setCashEntries((p) => [...d.cashEntries, ...p]);
    if (!mfgConfig.openingCash && !mfgConfig.openingBank) setMfgConfig((c) => ({ ...c, openingCash: d.opening.cash, openingBank: d.opening.bank }));
    const newUsers = d.users.filter((x) => !users.some((y) => y.email === x.email));
    setUsers((p) => [...p, ...newUsers]);
    const heads: Record<string, string> = { KY_THUAT: 'demo-mtp-kt', XUONG: 'demo-mxuong', MARKETING: 'demo-mmkt', ACCOUNTING: 'demo-mketoan' };
    setDepartments((p) => p.map((x) => (!x.headId && heads[x.code] && newUsers.some((u) => u.id === heads[x.code]) ? { ...x, headId: heads[x.code] } : x)));
    setCustomers((p) => [...p, ...d.customers]);
    setLeads((p) => [...d.leads, ...p]);
    setJobs((p) => [...d.jobs, ...p]);
    setReceipts((p) => [...d.receipts, ...p]);
    setWorkOrders((p) => [...d.workOrders, ...p]);
    setInstallJobs((p) => [...d.installJobs, ...p]);
    return { ...d, newUsers };
  };

  const seed = () => {
    if (users.some((u) => isDemo(u.id)) || leads.some((l) => isDemo(l.id)) || jobs.some((j) => isDemo(j.id))) return notify('Dữ liệu mẫu đã có. Xóa trước nếu muốn nạp lại.', 'orange');
    if (mode === 'MFG') {
      const d = seedMfg();
      notify(`Đã nạp dữ liệu mẫu xưởng: ${d.newUsers.length} nhân sự, ${d.customers.length} khách, ${d.jobs.length} đơn ở đủ trạng thái (chờ khảo sát, báo giá, sản xuất, lắp đặt, chờ thu tiền, hoàn tất, trượt), ${d.receipts.length} phiếu thu, phiếu kho và sổ thu chi 3 tháng. Mật khẩu: ${DEMO_PASSWORD}`, 'teal');
      return;
    }
    const fy = budget.fiscalYear;
    const now = Date.now();
    const iso10 = (offsetDays: number) => new Date(now + offsetDays * 864e5).toISOString().slice(0, 10);
    const dt = (offsetDays: number, h: number, m = 0) => { const d = new Date(now + offsetDays * 864e5); d.setHours(h, m, 0, 0); const p = (n: number) => String(n).padStart(2, '0'); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`; };
    const has = (code: string) => departments.some((d) => d.code === code);
    const dep = (code: string) => (has(code) ? code : routableDepts[0]?.code ?? departments[0]?.code ?? '');

    // ---- Tài khoản & nhân sự (mật khẩu demo 123456) ----
    const u = (id: string, name: string, email: string, role: Role, d: string, phone: string, limit = 0): User => ({ id: DEMO_PREFIX + id, name, email, role, dept: d ? dep(d) : undefined, phone, active: true, approvalLimit: limit });
    const demoUsers = [
      u('mkt', 'Nguyễn Thảo Vy', 'vy.nt@vassh.vn', 'MKT_LEAD', 'MARKETING', '0901 772 468'),
      u('tp-nam', 'Đỗ Thanh Tùng', 'tung.dt@vassh.vn', 'DEPT_HEAD', 'EMD_SOUTH', '0903 118 226', 100_000_000),
      u('sale-nam1', 'Trần Quốc Bảo', 'bao.tq@vassh.vn', 'SALES_REP', 'EMD_SOUTH', '0977 406 115'),
      u('sale-nam2', 'Lê Thu Hà', 'ha.lt@vassh.vn', 'SALES_REP', 'EMD_SOUTH', '0909 226 781'),
      u('tp-bac', 'Lương Văn Sơn', 'son.lv@vassh.vn', 'DEPT_HEAD', 'EMD_NORTH', '0912 330 468', 100_000_000),
      u('sale-bac', 'Hoàng Nam', 'nam.h@vassh.vn', 'SALES_REP', 'EMD_NORTH', '0983 208 517'),
      u('tp-nm', 'Mai Hồng Nhung', 'nhung.mh@vassh.vn', 'DEPT_HEAD', 'FACTORY_SALES', '0908 552 147', 80_000_000),
      u('sale-nm', 'Phạm Minh Đức', 'duc.pm@vassh.vn', 'SALES_REP', 'FACTORY_SALES', '0918 664 320'),
      u('kt', 'Trương Mỹ Linh', 'linh.tm@vassh.vn', 'ACCOUNTANT', 'ACCOUNTING', '0908 441 256'),
    ].filter((x) => !users.some((y) => y.email === x.email));
    setUsers((p) => [...p, ...demoUsers]);
    const heads: Record<string, string> = { MARKETING: 'demo-mkt', EMD_SOUTH: 'demo-tp-nam', EMD_NORTH: 'demo-tp-bac', FACTORY_SALES: 'demo-tp-nm', ACCOUNTING: 'demo-kt' };
    setDepartments((p) => p.map((d) => (!d.headId && heads[d.code] && demoUsers.some((x) => x.id === heads[d.code]) ? { ...d, headId: heads[d.code] } : d)));

    // ---- Sản phẩm (SKU 3 mức giá + giá vốn) ----
    const sk = (sku: string, name: string, category: string, unit: string, cost: number, base: number, dealer: number, project: number, stock: number, min: number, max: number, lead = 90): SkuItem =>
      ({ sku, name, brand: '3M', category, unit, costPrice: cost, basePrice: base, dealerPrice: dealer, projectPrice: project, stock, minStock: min, maxStock: max, leadTimeDays: lead });
    const demoSkus = [
      sk('3M-QT3-24KV', 'Đầu cáp co nguội trong nhà 24kV QT-III', 'Phụ kiện cáp trung thế', 'Bộ', 4_100_000, 5_200_000, 4_600_000, 4_800_000, 18, 20, 120),
      sk('3M-CSJ-24KV', 'Hộp nối cáp co nguội 24kV', 'Phụ kiện cáp trung thế', 'Bộ', 5_300_000, 6_900_000, 6_000_000, 6_200_000, 12, 10, 80),
      sk('3M-SCOTCH-23', 'Băng keo cách điện cao áp Scotch 23, 19mm x 9,1m', 'Băng keo điện', 'Cuộn', 230_000, 320_000, 270_000, 285_000, 420, 200, 1500, 60),
      sk('3M-VHB-4910', 'Băng keo VHB 4910 trong suốt, 19mm x 33m', 'Băng keo công nghiệp', 'Cuộn', 440_000, 620_000, 540_000, 560_000, 90, 100, 800, 75),
      sk('3M-CUB-984F', 'Đĩa nhám Cubitron II 984F, 125mm', 'Vật liệu mài', 'Hộp', 1_380_000, 1_850_000, 1_600_000, 1_650_000, 140, 50, 400, 75),
      sk('3M-FB-CP25WB', 'Keo chống cháy Fire Barrier CP 25WB+, 300ml', 'Vật liệu chống cháy', 'Tuýp', 520_000, 760_000, 650_000, 680_000, 30, 100, 600),
    ].filter((x) => !skus.some((y) => y.sku === x.sku));
    setSkus((p) => [...demoSkus, ...p]);

    // ---- Khách hàng ----
    const src = (mkt: boolean) => sources.find((s) => s.isMarketing === mkt)?.id ?? sources[0]?.id ?? '';
    const ck = (id: string, name: string, tax: string, segment: string, region: Region, d: string, am: string, status: CustomerStatus, ytd: number, credit: number, debt: number, contact: string, title: string, phone: string, address: string, mkt: boolean, created: number): Customer =>
      ({ id: DEMO_PREFIX + id, code: `KH-DEMO-${id.slice(1)}`, name, taxCode: tax, segment, tier: tierFor(ytd, tierRules), region, dept: dep(d), amId: DEMO_PREFIX + am, sourceId: src(mkt), status, createdAt: iso10(created),
        contactName: contact, contactTitle: title, contactPhone: phone, contactEmail: '', address, creditLimit: credit, debt, ytdRevenue: ytd, lastYearRevenue: Math.round(ytd * 0.6) });
    const demoCustomers = [
      ck('k1', 'Tổng thầu Điện Thành', '0310203040', 'EPC_CONTRACTOR', 'SOUTH', 'EMD_SOUTH', 'sale-nam1', 'ACTIVE', 620e6, 800e6, 310e6, 'Nguyễn Văn Điện', 'Giám đốc dự án', '0903 881 188', 'KCN Tân Bình, TP.HCM', true, -320),
      ck('k2', 'NPP Hoàng Phát', '0108990011', 'DEALER_L1', 'NORTH', 'EMD_NORTH', 'sale-bac', 'FOLLOW', 1.1e9, 1.5e9, 540e6, 'Hoàng Văn Phát', 'Chủ doanh nghiệp', '0913 771 229', 'Long Biên, Hà Nội', true, -480),
      ck('k3', 'Xưởng Nhôm kính Phú Quý', '0317002233', 'WORKSHOP', 'SOUTH', 'FACTORY_SALES', 'sale-nm', 'PROSPECT', 0, 150e6, 0, 'Lê Phú Quý', 'Chủ xưởng', '0938 220 915', 'Thủ Đức, TP.HCM', true, -12),
      ck('k4', 'Cửa hàng Vật tư điện Phúc An', '0315556677', 'RETAILER', 'NORTH', 'EMD_NORTH', 'sale-bac', 'INTERESTED', 380e6, 300e6, 285e6, 'Đoàn Phúc', 'Chủ cửa hàng', '0983 552 781', 'Cầu Giấy, Hà Nội', false, -200),
    ].filter((x) => !customers.some((y) => y.taxCode === x.taxCode));
    setCustomers((p) => [...p, ...demoCustomers]);

    // ---- Lead / dự án đủ các bước + báo giá có dòng ----
    const ql = (sku: string, qty: number, discountPct = 0): QuoteLine => {
      const k = [...demoSkus, ...skus].find((x) => x.sku === sku)!;
      return { sku, name: k.name, unit: k.unit, qty, listPrice: k.projectPrice, discountPct };
    };
    const boq = (lines: QuoteLine[]): BoqItem[] => lines.map((l) => ({ code: l.sku, name: l.name, unit: l.unit, qty: l.qty, price: l.listPrice, discountPct: 0 }));
    const qMid = [ql('3M-QT3-24KV', 60, 3), ql('3M-CSJ-24KV', 40, 5), ql('3M-SCOTCH-23', 800)];
    const qWon = [ql('3M-QT3-24KV', 20), ql('3M-SCOTCH-23', 200)];
    const qLost = [ql('3M-CUB-984F', 50, 4)];
    const lb = { hasBoqFile: false, receivedDaysAgo: 1 };
    const L = (id: string, o: Partial<Lead> & Pick<Lead, 'company' | 'segment' | 'source' | 'region' | 'status' | 'boqValue' | 'boqNote'>): Lead =>
      ({ ...lb, id: DEMO_PREFIX + id, code: `LD-DEMO-${id.slice(1).padStart(2, '0')}`, contact: 'Người liên hệ mẫu', phone: '0900 000 0' + id.slice(1).padStart(2, '0'), ...o });
    const amount = (ls: QuoteLine[]) => quoteTotals(ls, 10).sub;
    const demoLeads: Lead[] = [
      L('l1', { company: 'Công ty CP Cơ điện Cotec', segment: 'EPC_CONTRACTOR', source: 'GOOGLE_ADS', region: 'SOUTH', province: 'TP.HCM', status: 'NEW', boqValue: 1.4e9, boqNote: 'BOQ đầu cáp và ống co nhiệt cho tủ điện trung thế', taxCode: '0305556661' }),
      L('l2', { company: 'Nhôm Kính Việt Ý', segment: 'DEALER_L2', source: 'EXHIBITION', region: 'NORTH', province: 'Hà Nội', status: 'NEW', boqValue: 750e6, boqNote: 'Mở đại lý phân phối băng keo VHB', receivedDaysAgo: 2 }),
      L('l3', { company: 'Công ty CP Hạ tầng Kỹ thuật Sài Gòn', segment: 'EPC_CONTRACTOR', source: 'WEBSITE_FORM', region: 'SOUTH', province: 'TP.HCM', status: 'ROUTED', dept: dep('EMD_SOUTH'), routedAt: now - 25 * 60_000, routingReason: 'MKT phân phòng', boqValue: 2.6e9, boqNote: 'Phụ kiện cáp ngầm trung thế 3 block chung cư', score: 72 }),
      L('l4', { company: 'Đại lý Thiết bị Điện Quang Minh', segment: 'DEALER_L2', source: 'ZALO_OA', region: 'NORTH', province: 'Bắc Ninh', status: 'ASSIGNED', dept: dep('EMD_NORTH'), assignee: 'demo-sale-bac', routedAt: now - 3 * 3600_000, slaDeadline: now + 60 * 60_000, routingReason: 'MKT phân phòng', boqValue: 220e6, boqNote: 'Đăng ký đại lý khu vực Bắc Ninh', score: 49 }),
      L('l5', { company: 'Công ty TNHH Xây lắp Điện Thành Công', segment: 'EPC_CONTRACTOR', source: 'TECH_SEMINAR', region: 'SOUTH', province: 'TP.HCM', status: 'ACCEPTED', dept: dep('EMD_SOUTH'), assignee: 'demo-sale-nam1', slaMet: true, quoteDeadline: now + 18 * 3600_000, boqStatus: 'DONE', boqItems: boq([ql('3M-QT3-24KV', 30), ql('3M-CSJ-24KV', 12), ql('3M-SCOTCH-23', 300)]), boqValue: 2.1e9, boqNote: 'Đầu cáp, hộp nối cáp trung thế cho trường liên cấp', receivedDaysAgo: 6, score: 86 }),
      L('l6', { company: 'BQL Khu công nghiệp Phú Mỹ 3', segment: 'INVESTOR_OWNER', source: 'VENDOR_REFERRAL', region: 'SOUTH', province: 'Bà Rịa - Vũng Tàu', status: 'QUOTED', dept: dep('EMD_SOUTH'), assignee: 'demo-sale-nam2', slaMet: true, boqStatus: 'DONE', boqItems: boq(qMid), boqValue: 820e6, boqNote: 'Phụ kiện cáp trung thế trạm biến áp KCN', receivedDaysAgo: 14, score: 92 }),
      L('l7', { company: 'Tổng thầu Điện Thành', segment: 'EPC_CONTRACTOR', source: 'TECH_SEMINAR', region: 'SOUTH', province: 'TP.HCM', status: 'WON', dept: dep('EMD_SOUTH'), assignee: 'demo-sale-nam1', slaMet: true, boqStatus: 'DONE', boqItems: boq(qWon), customerId: 'demo-k1', taxCode: '0310203040', wonQuoteId: 'demo-q2', wonAt: iso10(-20), wonAmount: amount(qWon), boqValue: 160e6, boqNote: 'Phụ kiện cáp nhà máy nước', receivedDaysAgo: 40, score: 81 }),
      L('l8', { company: 'Xưởng Cơ khí Biển Xanh', segment: 'WORKSHOP', source: 'FACEBOOK_ADS', region: 'SOUTH', province: 'Đồng Nai', status: 'LOST', lostReason: 'PRICE', lostNote: 'Khách chọn hàng phổ thông rẻ hơn 12%', dept: dep('FACTORY_SALES'), assignee: 'demo-sale-nm', slaMet: true, boqStatus: 'DONE', boqItems: boq(qLost), boqValue: 90e6, boqNote: 'Đĩa nhám cho xưởng cơ khí', receivedDaysAgo: 25, score: 33 }),
    ];
    setLeads((p) => [...demoLeads, ...p]);
    const Q = (id: string, leadId: string, ls: QuoteLine[], status: QuoteStatus, daysAgo: number, version = 1): Quote =>
      ({ id: DEMO_PREFIX + id, code: `BG-DEMO-${id.slice(1).padStart(2, '0')}`, leadId: DEMO_PREFIX + leadId, version, date: iso10(-daysAgo), amount: amount(ls), lines: ls, vatPct: 10, tier: 'PROJECT', discountPct: 0, validUntil: iso10(30 - daysAgo), status, note: 'Báo giá mẫu', templateId: 'tq02' });
    // Báo giá trạm biến áp GM 16% chờ Trưởng phòng duyệt gấp (gửi 1 giờ 40 phút trước, SLA 2 giờ)
    const q1: Quote = { ...Q('q1', 'l6', qMid, 'SENT', 0), gmPct: 16, approvalLevel: 'HEAD', createdBy: 'demo-sale-nam2', createdAt: now - 100 * 60_000,
      approval: { status: 'PENDING', level: 'HEAD', reasons: ['GM 16.0% dưới 25%', 'Chiết khấu đầu cáp 3%, hộp nối 5% để cạnh tranh tổng thầu'], requestedAt: now - 100 * 60_000, requestedBy: 'demo-sale-nam2' } };
    setQuotes((p) => [q1, Q('q2', 'l7', qWon, 'ACCEPTED', 22), Q('q3', 'l8', qLost, 'REJECTED', 18), ...p]);

    // ---- Quỹ 3M: chương trình, claim có đối soát thặng dư, năm trước ----
    const ym = (m: number, d: number) => `${fy}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    setPrograms((p) => [
      { id: 'demo-m1', code: 'DX-DEMO-01', preApprovalId: '3M-MDF-DEMO-01', title: 'Hội thảo giải pháp cáp trung thế (mẫu)', type: 'TECH_SEMINAR', dept: dep('EMD_SOUTH'), requested: 90e6, sharePct: 100, held: 0, start: ym(3, 12), end: ym(3, 12), expectedLeads: 80, status: 'CLOSED', requestedBy: 'demo-mkt', approvedBy: me.id, vendorApprovedAt: ym(2, 25), claimId: 'demo-c1' },
      { id: 'demo-m2', code: 'DX-DEMO-02', title: 'Biển hiệu 8 đại lý Hải Phòng (mẫu)', type: 'POSM_SIGNAGE', customerId: 'demo-k2', dept: dep('EMD_NORTH'), requested: 144e6, sharePct: 50, held: 72e6, start: ym(11, 5), end: ym(11, 30), status: 'PENDING_VENDOR', requestedBy: 'demo-tp-bac', approvedBy: 'demo-tp-bac' },
      { id: 'demo-m4', code: 'DX-DEMO-04', title: 'Tạm ứng hội thảo giải pháp cáp ngầm cho tổng thầu M&E (mẫu)', type: 'TECH_SEMINAR', dept: dep('EMD_SOUTH'), requested: 60e6, sharePct: 100, held: 60e6, start: ym(11, 20), end: ym(11, 20), expectedLeads: 60, status: 'PENDING_INTERNAL', requestedBy: 'demo-mkt', requestedAt: now - 20 * 3600_000 },
      { id: 'demo-m3', code: 'DX-DEMO-03', title: 'Quà tặng tri ân đại lý (mẫu)', type: 'GIFT_DEALER', dept: dep('EMD_NORTH'), requested: 30e6, sharePct: 100, held: 30e6, start: ym(12, 1), end: ym(12, 20), status: 'PENDING_INTERNAL', requestedBy: 'demo-mkt' },
      ...p,
    ]);
    const ph = (id: string, hue: number): Proof => ({ id, type: 'SITE_PHOTO', name: `IMG_${id}.jpg`, verification: 'VERIFIED', watermark: true, inWindow: true, gps: '10.7769, 106.7009', capturedAt: `09:30 12/03/${fy}`, hue });
    setClaims((p) => [{
      id: 'demo-c1', code: 'CLM-DEMO-01', preApprovalId: '3M-MDF-DEMO-01', preApprovalApproved: true, programId: 'demo-m1', programTitle: 'Hội thảo giải pháp cáp trung thế (mẫu)', programType: 'TECH_SEMINAR',
      dept: dep('EMD_SOUTH'), period: `12/03 – 12/03/${fy}`, expectedAttendees: 80, claimed: 90e6, cap: 90e6, daysLeft: 0, submitted: true, vatCheck: 'MATCHED', vendorApproved: 90e6,
      invoice: { serial: '1C26TKH', number: '0004521', date: ym(3, 15), supplierTax: '0314567890', amount: 90e6 },
      creditNote: { number: 'CN-DEMO-01', date: ym(4, 20), amount: 90e6 }, actualCost: 50e6, surplusAllocation: 'COMPANY_PROFIT',
      costLines: [
        { id: 'demo-cl1', item: 'Thuê hội trường, âm thanh', supplier: 'Cty Sự kiện Ánh Dương', approved: 36e6, actual: 21e6, invoiceNo: '0001284' },
        { id: 'demo-cl2', item: 'Tiệc trà 80 khách', supplier: 'Nhà hàng Phương Nam', approved: 32e6, actual: 18e6, invoiceNo: '0004410' },
        { id: 'demo-cl3', item: 'In ấn, quà tặng khách mời', supplier: 'In ấn Sao Mai', approved: 22e6, actual: 11e6, invoiceNo: '0000932' },
      ],
      proofs: [ph('demo-p1', 24), ph('demo-p2', 200), ph('demo-p3', 32), { id: 'demo-p4', type: 'VAT_INVOICE', name: 'HD_0004521.pdf', verification: 'VERIFIED' }, { id: 'demo-p5', type: 'ATTENDEE_SIGN_SHEET', name: 'DS_ky_ten.pdf', verification: 'VERIFIED', attendeeCount: 72 }],
    }, ...p]);
    if (!budgets.some((b) => b.fiscalYear === fy - 1)) {
      setBudgets((list) => [...list, { ...budget, fiscalYear: fy - 1, mdfTotal: 1.1e9, csTotal: 300e6, total: 1.4e9, periodStart: `${fy - 1}-01-01`, periodEnd: `${fy - 1}-12-31`, spent: 0, committed: 0, openingSpent: 1.18e9, note: DEMO_BUDGET_NOTE }]);
    }

    // ---- PO đặt Hãng & đợt hàng về ----
    setPos((p) => [{
      id: 'demo-po1', code: 'PO-DEMO-0001', vendor: budget.vendor, orderDate: iso10(-95), expectedDate: iso10(10), purpose: 'MIXED', note: 'Hàng dự án Phú Mỹ 3 + nhập kho (mẫu)', createdBy: 'demo-tp-nam',
      lines: [
        { sku: '3M-QT3-24KV', qty: 100, unitPrice: 4_100_000, allocations: [{ kind: 'LEAD', refId: 'demo-l6', qty: 60 }] },
        { sku: '3M-SCOTCH-23', qty: 1000, unitPrice: 230_000, allocations: [{ kind: 'LEAD', refId: 'demo-l6', qty: 800 }] },
        { sku: '3M-FB-CP25WB', qty: 200, unitPrice: 520_000, allocations: [] },
      ],
      shipments: [
        { id: 'demo-s1', code: 'Đợt 1', mode: 'SEA', docNo: 'MAEU221045678', etd: iso10(-25), eta: iso10(4), status: 'IN_TRANSIT', lines: [{ sku: '3M-QT3-24KV', qty: 100 }, { sku: '3M-SCOTCH-23', qty: 600 }] },
        { id: 'demo-s2', code: 'Đợt 2', mode: 'AIR', docNo: '', eta: iso10(35), status: 'PLANNED', lines: [{ sku: '3M-SCOTCH-23', qty: 400 }] },
      ],
    }, ...p]);

    // ---- Lịch công tác ----
    const A = (id: string, o: Omit<Activity, 'id' | 'createdAt' | 'cost' | 'note' | 'location'> & Partial<Activity>): Activity => ({ id: DEMO_PREFIX + id, createdAt: iso10(-1), cost: 0, note: '', location: '', ...o });
    const receipt = (label: string) => `data:image/svg+xml;utf8,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="360" height="200"><rect width="100%" height="100%" fill="#f8fafc"/><text x="20" y="60" font-size="22" font-family="sans-serif">${label}</text><text x="20" y="110" font-size="16" font-family="sans-serif" fill="#475569">Chứng từ mẫu</text></svg>`)}`;
    setActivities((p) => [
      A('a1', { userId: 'demo-sale-nam1', type: 'MEETING', title: 'Gặp Điện Thành: trình bày giải pháp đầu cáp', from: dt(1, 9), to: dt(1, 10, 30), customerId: 'demo-k1', leadId: 'demo-l5', location: 'KCN Tân Bình, TP.HCM', status: 'PLANNED', note: 'Mang mẫu đầu cáp QT-III, chốt lịch khảo sát trạm' }),
      A('a2', { userId: 'demo-sale-nam2', type: 'SURVEY', title: 'Khảo sát trạm biến áp KCN Phú Mỹ 3', from: dt(-2, 8), to: dt(-2, 11, 30), leadId: 'demo-l6', location: 'KCN Phú Mỹ 3, Bà Rịa - Vũng Tàu', cost: 1_200_000, status: 'DONE', approvedBy: 'demo-tp-nam',
        note: 'Đo tuyến cáp ngầm 2 trạm 1.000 kVA, kiểm tra tủ RMU', result: 'Xác nhận 60 đầu cáp trong nhà, 40 hộp nối; khách đề nghị giảm thêm 2%', nextAction: 'Gửi báo giá v2 trước thứ 6',
        checkin: { at: new Date(now - 2 * 864e5 + 3600_000).toISOString(), lat: 10.58612, lng: 107.05893, accuracy: 12, lateMinutes: 0, photos: [] },
        expenses: [{ id: 'demo-ex1', name: 'Xăng xe công tác 140 km', amount: 650_000, fileName: 'hoa-don-xang.svg', url: receipt('Hóa đơn xăng 650.000đ') }, { id: 'demo-ex2', name: 'Phí cầu đường', amount: 120_000, fileName: 've-cau-duong.svg', url: receipt('Vé cầu đường 120.000đ') }], expenseStatus: 'SUBMITTED' }),
      A('a3', { userId: 'demo-sale-bac', type: 'TRIP', title: 'Công tác Hải Phòng: khảo sát 8 đại lý', from: dt(3, 7), to: dt(4, 18), customerId: 'demo-k2', programId: 'demo-m2', location: 'Hải Phòng', transport: 'Xe công ty', lodging: 'Khách sạn Sao Biển', cost: 3_500_000, advance: 2_000_000, status: 'PENDING_APPROVAL', note: 'Đo kích thước biển hiệu, chụp ảnh hiện trạng' }),
      A('a4', { userId: 'demo-sale-nam1', type: 'LEAVE', leaveKind: 'LATE', title: 'Đi muộn có lý do', from: dt(0, 8), to: dt(0, 9, 15), status: 'PENDING_APPROVAL', note: 'Đưa con đi khám, đến văn phòng lúc 9h15' }),
      A('a5', { userId: 'demo-sale-nam2', type: 'LEAVE', leaveKind: 'LEAVE', title: 'Nghỉ việc riêng', from: dt(5, 8), to: dt(5, 17, 30), status: 'PENDING_APPROVAL', note: 'Việc gia đình ở quê' }),
      A('a6', { userId: 'demo-sale-nm', type: 'LEAVE', leaveKind: 'NO_CHECKIN', title: 'Giải trình không chấm công', from: dt(-1, 8), to: dt(-1, 8, 15), status: 'APPROVED', approvedBy: 'demo-tp-nm', note: 'Máy chấm công lỗi, có mặt từ 7h55 (camera xác nhận)' }),
      A('a7', { userId: 'demo-sale-bac', type: 'MEETING', title: 'Gặp Phúc An: kệ trưng bày băng keo', from: dt(2, 14), to: dt(2, 15, 30), customerId: 'demo-k4', location: 'Cầu Giấy, Hà Nội', cost: 800_000, status: 'PENDING_APPROVAL', submittedAt: now - 3 * 3600_000, note: 'Trình bày kệ trưng bày băng keo Scotch, chốt đơn hàng quý 4' }),
      A('a8', { userId: 'demo-mkt', type: 'EVENT', title: 'Hội thảo giải pháp cáp trung thế', from: `${ym(3, 12)}T08:00`, to: `${ym(3, 12)}T12:00`, programId: 'demo-m1', location: 'TP.HCM', status: 'DONE', result: '72 khách tham dự, 9 lead mới' }),
      ...p,
    ]);

    // ---- Marketing & tài liệu ----
    setMktItems((p) => [
      { id: 'demo-mk1', name: 'Google Ads (mẫu)', source: 'GOOGLE_ADS', planned: 70e6, spent: 52e6 },
      { id: 'demo-mk2', name: 'Facebook Ads (mẫu)', source: 'FACEBOOK_ADS', planned: 45e6, spent: 38e6 },
      { id: 'demo-mk3', name: 'Zalo OA & ZNS (mẫu)', source: 'ZALO_OA', planned: 20e6, spent: 14e6 },
      { id: 'demo-mk4', name: 'Triển lãm ngành điện (mẫu)', source: 'EXHIBITION', planned: 35e6, spent: 32e6 },
      ...p,
    ]);
    setDocs((p) => [
      { id: 'demo-d1', title: 'Quy trình tiếp nhận và phân lead (mẫu)', category: 'POLICY', visibility: 'ALL', ownerId: 'demo-mkt', updatedAt: iso10(-30), version: 'v1.0', format: 'PDF', sizeKb: 420, summary: 'MKT phân lead về phòng ban, Trưởng phòng chỉ định Sales, tiếp nhận trong 2 giờ, báo giá trong 24 giờ.', tags: ['Lead', 'SLA'] },
      { id: 'demo-d2', title: 'Catalog 3M Electrical Markets (mẫu)', category: 'PROFILE', visibility: 'ALL', ownerId: 'demo-mkt', updatedAt: iso10(-60), version: '2026', format: 'PDF', sizeKb: 15600, summary: 'Đầu cáp, hộp nối co nguội, băng keo Scotch, Fire Barrier.', tags: ['Catalog'] },
      ...p,
    ]);
    // ---- Đơn hàng đã duyệt còn công nợ (tuổi nợ) và sổ quỹ thu chi ----
    const go = (n: number, cust: string, day: number, net: number, paid: number): GetflyOrderRec => ({
      orderId: 990000 + n, orderCode: `DH-DEMO-${String(n).padStart(3, '0')}`, customerId: DEMO_PREFIX + cust, orderDate: iso10(day), net, vat: Math.round(net * 0.1), gross: Math.round(net * 1.1), paid, approved: true, source: 'MDF_APP', lines: 3,
    });
    setGetflyOrders((p) => [go(1, 'k1', -12, 180e6, 0), go(2, 'k1', -52, 240e6, 100e6), go(3, 'k2', -40, 320e6, 0), go(4, 'k2', -80, 150e6, 50e6), go(5, 'k4', -20, 95e6, 0), go(6, 'k4', -95, 60e6, 20e6), go(7, 'k1', -100, 120e6, 132e6), ...p]);
    let cn = 0;
    const ce = (kind: CashEntry['kind'], day: number, account: CashAccount, category: string, amount: number, extra: Partial<CashEntry> = {}): CashEntry => ({
      id: `${DEMO_PREFIX}ce${++cn}`, code: `${kind === 'IN' ? 'PTQ' : kind === 'OUT' ? 'PCQ' : 'CQ'}-DEMO-${String(cn).padStart(3, '0')}`, kind, date: iso10(day), account, category, amount, by: 'demo-kt', at: now + cn, source: 'MANUAL', ...extra,
    });
    setCashEntries((p) => [
      ce('IN', -95, 'BANK', 'Thu tiền khách hàng', 132e6, { partner: 'Tổng thầu Điện Thành', ref: 'DH-DEMO-007' }),
      ce('IN', -60, 'BANK', 'Thu tiền khách hàng', 50e6, { partner: 'NPP Hoàng Phát', ref: 'DH-DEMO-004' }),
      ce('IN', -70, 'CASH', 'Thu tiền khách hàng', 20e6, { partner: 'Cửa hàng Vật tư điện Phúc An', ref: 'DH-DEMO-006' }),
      ce('IN', -30, 'BANK', 'Thu tiền khách hàng', 100e6, { partner: 'Tổng thầu Điện Thành', ref: 'DH-DEMO-002', note: 'Thanh toán một phần' }),
      ce('OUT', -65, 'BANK', 'Lương, thưởng', 260e6, { note: 'Lương tháng' }), ce('OUT', -35, 'BANK', 'Lương, thưởng', 260e6, { note: 'Lương tháng' }), ce('OUT', -5, 'BANK', 'Lương, thưởng', 262e6, { note: 'Lương tháng' }),
      ce('OUT', -32, 'BANK', 'Mặt bằng, điện nước', 45e6, { partner: 'Văn phòng Quận 3' }),
      ce('OUT', -25, 'CASH', 'Chi phí triển khai sự kiện', 21e6, { partner: 'Cty Sự kiện Ánh Dương', note: 'Hội trường hội thảo cáp trung thế (CLM-DEMO-01)' }),
      ce('OUT', -15, 'BANK', 'Vận chuyển', 8_500_000, { partner: 'Giao hàng nhanh 247' }),
      ce('OUT', -8, 'CASH', 'Marketing', 12e6, { partner: 'Quảng cáo Google' }),
      ce('TRANSFER', -20, 'CASH', 'Chuyển quỹ', 15e6, { toAccount: 'BANK', note: 'Nộp tiền mặt vào tài khoản' }),
      ...p,
    ]);
    if (!mfgConfig.openingCash && !mfgConfig.openingBank && mode !== 'BOTH') setMfgConfig((c) => ({ ...c, openingCash: 80e6, openingBank: 1.2e9 }));
    if (mode === 'BOTH') seedMfg();
    notify(`Đã nạp dữ liệu mẫu: ${demoUsers.length} nhân sự, ${demoCustomers.length} khách hàng, ${demoSkus.length} SKU, 8 lead / dự án, 3 báo giá (1 chờ duyệt giá), 4 chương trình quỹ, 1 claim, 1 PO, 8 lịch công tác${mode === 'BOTH' ? ', kèm 11 đơn hàng công trình của xưởng' : ''}. Xem việc chờ duyệt ở phân hệ Công việc. Mật khẩu tài khoản mẫu: ${DEMO_PASSWORD}`, 'teal');
  };

  const clear = () => {
    if (isDemo(me.id)) return notify('Đang đăng nhập bằng tài khoản mẫu. Đăng nhập tài khoản quản trị rồi xóa.', 'red');
    const keepId = <T extends { id: string }>(xs: T[]) => xs.filter((x) => !isDemo(x.id));
    setUsers(keepId);
    setDepartments((p) => p.map((d) => (isDemo(d.headId) ? { ...d, headId: undefined } : d)));
    setCustomers(keepId);
    setLeads(keepId);
    setQuotes((p) => p.filter((q) => !isDemo(q.id) && !isDemo(q.leadId)));
    setPrograms(keepId);
    setClaims(keepId);
    setPos(keepId);
    setActivities(keepId);
    setMktItems(keepId);
    setDocs(keepId);
    setWorkOrders(keepId);
    setInstallJobs(keepId);
    setJobs(keepId);
    setReceipts(keepId);
    setGetflyOrders((p) => p.filter((o) => !o.orderCode.startsWith('DH-DEMO-')));
    setStockMoves(keepId);
    setCashEntries(keepId);
    setGenDocs((p) => p.filter((d) => !isDemo(d.leadId) && !isDemo(d.customerId)));
    setBudgets((list) => list.filter((b) => b.note !== DEMO_BUDGET_NOTE || b.fiscalYear === budget.fiscalYear));
    notify('Đã xóa dữ liệu mẫu. SKU mẫu được giữ lại nếu bạn đã dùng; xóa tay ở phân hệ Sản phẩm nếu không cần.', 'orange');
  };

  const hasDemo = users.some((x) => isDemo(x.id)) || leads.some((x) => isDemo(x.id)) || customers.some((x) => isDemo(x.id)) || jobs.some((x) => isDemo(x.id));
  return { seed, clear, hasDemo, quotesCount: quotes.length, mode };
}

function DemoDataPanel() {
  const { canDo } = useApp();
  const { seed, clear, hasDemo, mode } = useDemoData();
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const canEdit = canDo('settings.edit');
  return (
    <Panel title="Dữ liệu mẫu">
      {mode === 'MFG' ? <p className="text-sm text-[#94A3B8]">Nạp ví dụ mô hình xưởng: 9 tài khoản (Marketing, Trưởng kỹ thuật, 2 kỹ thuật khảo sát, kinh doanh, quản đốc xưởng, 2 thợ lắp đặt, kế toán; mật khẩu {DEMO_PASSWORD}), 14 đơn hàng ở mọi trạng thái, lệnh sản xuất, lịch lắp đặt, biên bản nghiệm thu, phiếu thu cọc 30% / 70%, phiếu nhập xuất kho và sổ thu chi 3 tháng. Mọi bản ghi mẫu xóa được bằng một nút.</p> : <p className="text-sm text-[#94A3B8]">Nạp ví dụ cho tất cả phân hệ để thử: 9 tài khoản (Trưởng MKT, Trưởng phòng, Sales, Kế toán; mật khẩu {DEMO_PASSWORD}), khách hàng, SKU có 3 mức giá, lead ở đủ các bước, báo giá có dòng sản phẩm, dự án đã chốt đơn, chương trình quỹ và claim có đối soát thặng dư, quỹ năm trước, PO đang về, lịch công tác, ngân sách Marketing và tài liệu. Mọi bản ghi mẫu xóa được bằng một nút.</p>}
      <div className="mt-3 flex flex-wrap gap-2">
        <button className={btnPrimary} disabled={!canEdit || hasDemo} onClick={seed}><Zap className="h-4 w-4" aria-hidden />Nạp dữ liệu mẫu</button>
        <button className={cn(btnGhost, 'hover:text-[#F87171]')} disabled={!canEdit || !hasDemo} onClick={() => setConfirm({ title: 'Xóa dữ liệu mẫu', message: 'Xóa toàn bộ bản ghi mẫu (nhân sự, khách hàng, lead, báo giá, quỹ, PO, lịch công tác...)? Dữ liệu bạn tự nhập được giữ nguyên.', onConfirm: clear })}><Trash2 className="h-4 w-4" aria-hidden />Xóa dữ liệu mẫu</button>
      </div>
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </Panel>
  );
}

// =====================================================================
//  PHÂN HỆ 3: HỒ SƠ CLAIM & POP
//  Tab: Chương trình & Pre-Approval | Hồ sơ claim | Đối soát & Credit Note
// =====================================================================

function ClaimsModule() {
  const { role } = useApp();
  const [tab, setTab] = useState<'programs' | 'claims' | 'accounting'>(role === 'ACCOUNTANT' ? 'accounting' : 'claims');
  return (
    <div className="space-y-5">
      <Tabs
        tabs={[
          { id: 'programs', label: 'Kế hoạch quỹ' },
          { id: 'claims', label: 'Claim & POP' },
          { id: 'accounting', label: 'Đối soát' },
        ]}
        value={tab}
        onChange={setTab}
 aside={<DateRangePicker />} />
      {tab === 'programs' && <ProgramsTab />}
      {tab === 'claims' && <ClaimsTab />}
      {tab === 'accounting' && <AccountingTab />}
    </div>
  );
}

function ProgramsTab() {
  const { me, role, budget, setBudget, policy, programs, setPrograms, claims, setClaims, customers, canDo, notify, dept, userName, openProgramForm, openClaim, dispatch, logDecision } = useApp();
  const [showAll, setShowAll] = useState(false);
  const [approving, setApproving] = useState<Program | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const [fund, setFund] = useState<FundCode>('MDF');
  // Chỉ chương trình của năm tài chính đang xem (theo bộ lọc thời gian trên header)
  const yearPrograms = programs.filter((p) => progYear(p) === budget.fiscalYear);
  const list = showAll ? yearPrograms : yearPrograms.filter((p) => !['REJECTED', 'CANCELLED', 'CLOSED'].includes(p.status));

  /** Người đang đăng nhập có đủ hạn mức duyệt nội bộ không */
  const canApprove = (p: Program) =>
    canDo('program.approveInternal') && (role === 'BOD' || (me.dept === p.dept && me.approvalLimit >= p.held));

  const release = (p: Program, status: ProgramStatus, msg: string) => {
    setBudget((b) => ({ ...b, committed: Math.max(0, b.committed - p.held) }));
    setPrograms((ps) => ps.map((x) => (x.id === p.id ? { ...x, held: 0, status } : x)));
    notify(`${msg}. Đã nhả ${compact(p.held)} về quỹ khả dụng`, 'orange');
  };
  const patch = (p: Program, data: Partial<Program>, msg: string) => {
    setPrograms((ps) => ps.map((x) => (x.id === p.id ? { ...x, ...data } : x)));
    notify(msg, 'teal');
    dispatch('CLAIM_UPDATE', { title: 'Cập nhật duyệt Pre-Approval', body: msg, module: 'claims' });
  };

  const createClaim = (p: Program) => {
    const code = nextCode(claims.map((c) => c.code), 'CLM-2026-', 4);
    const deadline = new Date(p.end).getTime() + policy.claimWindowDays * 864e5;
    const claim: Claim = {
      id: uid('c'), code, preApprovalId: p.preApprovalId ?? '', preApprovalApproved: !!p.preApprovalId, programId: p.id,
      programTitle: p.title, programType: p.type, customerId: p.customerId, dept: p.dept,
      period: `${fmtDate(p.start)} – ${fmtDate(p.end)}`, expectedAttendees: p.expectedLeads,
      claimed: p.held, cap: p.held, invoice: null,
      daysLeft: Math.max(0, Math.ceil((deadline - Date.now()) / 864e5)), submitted: false, proofs: [],
    };
    setClaims((c) => [claim, ...c]);
    setPrograms((ps) => ps.map((x) => (x.id === p.id ? { ...x, status: 'CLAIMING', claimId: claim.id } : x)));
    notify(`Đã tạo hồ sơ ${code} theo mã ${p.preApprovalId}. Tải chứng từ POP lên để nộp 3M.`, 'teal');
    openClaim(claim.id);
  };

  return (
    <div className="space-y-5">
      <BudgetStrip />

      <div className="flex flex-wrap items-center gap-2">
        {(['MDF', 'CS'] as FundCode[]).map((fd) => {
          const cats = PROGRAM_TYPES.filter((t) => PROGRAM_FUND[t] === fd);
          const cap = cats.reduce((a, t) => a + (PROGRAM_BUDGET[t] ?? 0), 0);
          const used = cats.reduce((a, t) => a + usedByType(t, claims, programs, budget.fiscalYear), 0);
          return (
            <button key={fd} onClick={() => setFund(fd)} className={cn('rounded border px-3 py-2 text-left text-sm transition-colors', fund === fd ? 'border-[#F28C33] bg-[#F28C33]/10' : 'border-[#263044] hover:bg-[#1C2534]')}>
              <span className="block font-medium">{FUND_LABEL[fd]}</span>
              <span className="block text-xs tabular-nums text-[#94A3B8]">{compact(used)} / {compact(cap)}</span>
            </button>
          );
        })}
      </div>
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {PROGRAM_TYPES.filter((t) => PROGRAM_FUND[t] === fund).map((t) => {
          const cap = PROGRAM_BUDGET[t] ?? 0;
          const used = usedByType(t, claims, programs, budget.fiscalYear);
          return (
            <div key={t} className="rounded-md border border-[#263044] bg-[#1C2534] p-4">
              <p className="flex items-center gap-2 text-sm text-[#94A3B8]"><i className="h-2 w-2 rounded-full" style={{ background: PROGRAM_COLOR[t] }} />{progName(t)}</p>
              <p className="mt-2 text-lg font-semibold tabular-nums text-[#F1F5F9]">{compact(used)} <span className="text-sm font-normal text-[#94A3B8]">/ {compact(cap)}</span></p>
              <div className="mt-2"><ProgressBar value={used} max={cap} /></div>
              <p className="mt-1 text-xs text-[#94A3B8]">Còn {compact(Math.max(0, cap - used))}</p>
            </div>
          );
        })}
      </div>

      <Panel
        title="Đề xuất chương trình và Pre-Approval 3M"
        action={
          <div className="flex flex-wrap items-center gap-3">
            <label className="flex items-center gap-2 text-xs text-[#94A3B8]"><input type="checkbox" className="accent-[#F28C33]" checked={showAll} onChange={(e) => setShowAll(e.target.checked)} />Hiện cả chương trình đã đóng</label>
            <button className={btnPrimary} disabled={!canDo('program.create')} onClick={() => openProgramForm()}><Plus className="h-4 w-4" aria-hidden />Đề xuất chương trình</button>
          </div>
        }
      >
        <Table head={['Chương trình', 'Hạng mục', 'Khách hàng / phòng', 'Chi phí / phần 3M', 'Thời gian', 'Đề xuất / duyệt', 'Trạng thái', 'Thao tác']} minW={1260}>
          {list.map((p) => {
            const cust = customers.find((c) => c.id === p.customerId);
            const ok = canApprove(p);
            return (
              <tr key={p.id} className={rowCls}>
                <td className={tdFirst}>
                  <p className="font-medium text-[#F1F5F9]">{p.title}</p>
                  <p className="text-xs text-[#94A3B8]">Đề xuất {p.code}</p>
                  <p className={cn('text-xs', p.preApprovalId ? 'font-mono text-[#3DDBB6]' : 'text-[#94A3B8]')}>{p.preApprovalId ? `Pre-Approval ${p.preApprovalId}` : 'Chưa có mã Pre-Approval (3M cấp khi duyệt)'}</p>
                </td>
                <td className={tdCls}><span className="flex items-center gap-2"><i className="h-2 w-2 shrink-0 rounded-full" style={{ background: PROGRAM_COLOR[p.type] }} />{progName(p.type)}</span><span className="text-xs text-[#94A3B8]">{FUND_LABEL[PROGRAM_FUND[p.type] ?? 'MDF']}</span></td>
                <td className={tdCls}><p>{cust?.name ?? 'Hoạt động chung'}</p><p className="text-xs text-[#94A3B8]">{dept(p.dept)?.short}</p></td>
                <td className={tdCls}>
                  <p className="tabular-nums text-[#F1F5F9]">{compact(p.requested)}</p>
                  <p className="text-xs tabular-nums text-[#94A3B8]">3M {p.sharePct}%{p.held > 0 ? `, giữ chỗ ${compact(p.held)}` : ''}</p>
                </td>
                <td className={cn(tdCls, 'text-xs tabular-nums')}>{fmtDate(p.start)}<br />{fmtDate(p.end)}</td>
                <td className={cn(tdCls, 'text-xs')}><p>{userName(p.requestedBy)}</p><p className="text-[#94A3B8]">{p.approvedBy ? `Duyệt: ${userName(p.approvedBy)}` : 'Chưa duyệt'}</p></td>
                <td className={tdCls}><Chip tone={PROGRAM_STATUS[p.status].tone}>{PROGRAM_STATUS[p.status].label}</Chip></td>
                <td className={tdLast}>
                  <div className="flex flex-wrap gap-1.5">
                    {p.status === 'PENDING_INTERNAL' && (
                      <>
                        <button className={cn(btnGhost, btnSm)} disabled={!ok} title={ok ? undefined : 'Cần Trưởng phòng đủ hạn mức hoặc Ban Giám đốc'} onClick={() => { patch(p, { status: 'PENDING_VENDOR', approvedBy: me.id }, `Đã duyệt nội bộ ${p.code}, gửi 3M duyệt`); logDecision({ kind: 'PROGRAM', refId: p.id, title: `${p.code}: ${p.title}`, requesterId: p.requestedBy, decision: 'APPROVED', amount: p.held }); }}>Duyệt nội bộ</button>
                        <button className={cn(btnGhost, btnSm)} disabled={!ok} onClick={() => { release(p, 'REJECTED', `Đã từ chối ${p.code}`); logDecision({ kind: 'PROGRAM', refId: p.id, title: `${p.code}: ${p.title}`, requesterId: p.requestedBy, decision: 'REJECTED', amount: p.held }); }}>Từ chối</button>
                      </>
                    )}
                    {p.status === 'PENDING_VENDOR' && (
                      <>
                        <button className={cn(btnBase, btnSm, 'bg-[#00B894]/15 text-[#3DDBB6] hover:bg-[#00B894]/25')} disabled={!canDo('program.vendorDecision')} onClick={() => setApproving(p)}>3M đã duyệt (nhập mã)</button>
                        <button className={cn(btnGhost, btnSm)} disabled={!canDo('program.vendorDecision')} onClick={() => release(p, 'REJECTED', `3M từ chối ${p.code}`)}>3M từ chối</button>
                      </>
                    )}
                    {p.status === 'APPROVED' && (
                      <>
                        <button className={cn(btnBase, btnSm, 'bg-[#F28C33]/15 text-[#F7B23B] hover:bg-[#F28C33]/25')} disabled={!canDo('claim.uploadPop')} onClick={() => createClaim(p)}><FileCheck2 className="h-3.5 w-3.5" aria-hidden />Tạo hồ sơ claim</button>
                        <button className={cn(btnGhost, btnSm)} disabled={!canDo('program.create')} onClick={() => release(p, 'CANCELLED', `Đã hủy ${p.code}`)}>Hủy</button>
                      </>
                    )}
                    {(p.status === 'CLAIMING' || p.status === 'CLOSED') && p.claimId && <button className={cn(btnGhost, btnSm)} onClick={() => openClaim(p.claimId!)}>Mở hồ sơ claim</button>}
                    <button className={cn(btnGhost, 'p-1.5')} disabled={!canDo('program.create') || p.status !== 'PENDING_INTERNAL'} title={p.status !== 'PENDING_INTERNAL' ? 'Chỉ sửa được khi chưa duyệt nội bộ' : undefined} onClick={() => openProgramForm(undefined, p.id)} aria-label={`Sửa ${p.code}`}><Pencil className="h-3.5 w-3.5" /></button>
                    <button className={cn(btnGhost, 'p-1.5 hover:text-[#F87171]')} disabled={!canDo('program.create')} onClick={() => setConfirm({
                      title: 'Xóa đề xuất chương trình',
                      message: <>Xóa <b>{p.code}</b> {p.title}?{p.held > 0 ? ` Phần giữ chỗ ${compact(p.held)} sẽ nhả về quỹ.` : ''}</>,
                      blocked: ['APPROVED', 'CLAIMING', 'CLOSED'].includes(p.status) ? 'Đề xuất đã được 3M duyệt hoặc đã làm claim. Dùng nút Hủy để nhả ngân sách, không xóa để giữ lịch sử đối soát.' : undefined,
                      onConfirm: () => { if (p.held > 0) setBudget((b) => ({ ...b, committed: Math.max(0, b.committed - p.held) })); setPrograms((ps) => ps.filter((x) => x.id !== p.id)); notify(`Đã xóa đề xuất ${p.code}`, 'orange'); },
                    })} aria-label={`Xóa ${p.code}`}><Trash2 className="h-3.5 w-3.5" /></button>
                  </div>
                </td>
              </tr>
            );
          })}
        </Table>
        {!list.length && <EmptyState text={<>Chưa có chương trình quỹ nào</>} hint={<>Đề xuất chương trình để giữ chỗ ngân sách MDF / CS trước khi xin Pre-Approval của Hãng.</>} art="box" action="Đề xuất chương trình" onAction={canDo('program.create') ? () => openProgramForm() : undefined} />}
      </Panel>
      {approving && <VendorApprovalModal program={approving} onClose={() => setApproving(null)} />}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

function ClaimsTab() {
  const { claims: allClaims, programs, policy, customers, budget } = useApp();
  const claims = allClaims.filter((c) => claimYear(c, programs) === budget.fiscalYear);
  const [filter, setFilter] = useState<string>('open');
  const inR = useInRange();
  const [q, setQ] = useState('');
  const [dp, setDp] = useState('ALL');
  const list = claims
    .filter((c) => {
      const t = q.trim().toLowerCase();
      const cust = customers.find((k) => k.id === c.customerId);
      const hit = !t || [c.code, c.programTitle, c.preApprovalId, cust?.name ?? '', cust?.taxCode ?? ''].some((v) => v.toLowerCase().includes(t));
      const st = filter === 'ALL' || (filter === 'open' && !c.submitted) || (filter === 'ready' && !c.submitted && blockersOf(c, policy.rules) === 0) || (filter === 'blocked' && !c.submitted && blockersOf(c, policy.rules) > 0) || (filter === 'submitted' && c.submitted);
      return hit && st && (dp === 'ALL' || c.dept === dp) && inR(claimDate(c));
    })
    .sort((a, b) => Number(a.submitted) - Number(b.submitted) || a.daysLeft - b.daysLeft);
  const blocked = claims.filter((c) => !c.submitted && blockersOf(c, policy.rules) > 0).length;

  return (
    <div className="space-y-5">
      <div className={kpiGrid('lg:grid-cols-3')}>
        <StatCard label="Đang làm" value={String(claims.filter((c) => !c.submitted).length)} sub={`${blocked} hồ sơ còn thiếu điều kiện`} icon={FileCheck2} color={C.orange} />
        <StatCard label="Sẵn sàng nộp" value={String(claims.filter((c) => !c.submitted && blockersOf(c, policy.rules) === 0).length)} sub="Đạt toàn bộ checklist bắt buộc" icon={ShieldCheck} color={C.teal} />
        <StatCard label="Chờ hoàn quỹ" value={compact(claims.filter((c) => c.submitted && !c.creditNote).reduce((s, c) => s + c.claimed, 0))} sub="Đã nộp, chưa nhận Credit Note" icon={ReceiptIcon} />
      </div>
      <FilterBar
        q={q} onQ={setQ} placeholder="Tìm mã claim, Pre-Approval, tên khách, MST"
        dept={dp} onDept={setDp} status={filter} onStatus={setFilter} statusLabel="Tất cả hồ sơ"
        statusOptions={[{ value: 'open', label: 'Đang làm' }, { value: 'blocked', label: 'Thiếu điều kiện' }, { value: 'ready', label: 'Sẵn sàng nộp' }, { value: 'submitted', label: 'Đã nộp Hãng' }]}
        chips={<ChipFilter value={filter === 'ALL' ? 'ALL' : (filter as 'open' | 'blocked' | 'ready' | 'submitted')} onChange={(v) => setFilter(v)} total={claims.length} options={[
          { value: 'open', label: 'Đang làm', count: claims.filter((c) => !c.submitted).length, color: C.orange },
          { value: 'blocked', label: 'Thiếu điều kiện', count: blocked, color: C.red },
          { value: 'ready', label: 'Sẵn sàng nộp', count: claims.filter((c) => !c.submitted && blockersOf(c, policy.rules) === 0).length, color: C.teal },
          { value: 'submitted', label: 'Đã nộp Hãng', count: claims.filter((c) => c.submitted).length, color: C.teal },
        ]} />}
      />
      <Panel title={`Hồ sơ claim và chứng từ POP (${list.length})`}>
        <ClaimTable claims={list} />
      </Panel>
    </div>
  );
}

// ---- Ô ảnh hiện trường: ảnh thật (tải lên) hoặc ảnh mô phỏng ----
function PhotoTile({ p, onVerify, onRemove, canVerify }: { p: Proof; onVerify: (id: string, v: Verification) => void; onRemove?: (id: string) => void; canVerify: boolean }) {
  const h = p.hue ?? 30;
  const bad = !p.watermark || !p.inWindow || !!p.duplicateOf;
  return (
    <figure className={cn('overflow-hidden rounded border', p.verification === 'REJECTED' ? 'border-[#EF4444]/40 opacity-50' : bad ? 'border-[#F28C33]/50' : 'border-[#263044]')}>
      <div className="relative aspect-[4/3]" style={{ background: `linear-gradient(160deg, hsl(${h} 22% 26%), hsl(${h + 40} 28% 12%))` }}>
        {p.url ? (
          // eslint-disable-next-line @next/next/no-img-element
          <img src={p.url} alt={p.name} className="absolute inset-0 h-full w-full object-cover" />
        ) : (
          <>
            <div className="absolute inset-x-[12%] bottom-[18%] h-[38%] rounded-sm opacity-40" style={{ background: `hsl(${h} 20% 55%)` }} />
            <div className="absolute bottom-[18%] left-[30%] h-[52%] w-[16%] rounded-sm opacity-30" style={{ background: `hsl(${h + 20} 18% 70%)` }} />
            <Camera className="absolute right-2 top-2 h-4 w-4 text-white/40" aria-hidden />
          </>
        )}
        {onRemove && (
          <button className="absolute right-1.5 top-1.5 rounded-md bg-black/60 p-1 text-white/80 hover:text-white" onClick={() => onRemove(p.id)} aria-label={`Xóa ${p.name}`}>
            <Trash2 className="h-3.5 w-3.5" />
          </button>
        )}
        {p.watermark ? (
          <div className="absolute inset-x-0 bottom-0 bg-black/60 px-2 py-1 text-[10px] leading-tight text-white/85">
            <span className="flex items-center gap-1"><MapPin className="h-2.5 w-2.5" aria-hidden />{p.gps ?? 'Chưa đọc được GPS'}</span>
            <span>{p.capturedAt}</span>
          </div>
        ) : (
          <div className="absolute inset-x-0 bottom-0 bg-[#EF4444]/80 px-2 py-1 text-[10px] font-medium text-white">Không có watermark</div>
        )}
      </div>
      <div className="flex items-center justify-between gap-1 bg-[#1C2534] px-2 py-1.5">
        <span className="truncate text-[11px] text-[#94A3B8]">{p.duplicateOf ? `Trùng ${p.duplicateOf}` : p.name}</span>
        <VerifyControl p={p} onVerify={onVerify} short canVerify={canVerify} />
      </div>
    </figure>
  );
}

function VerifyControl({ p, onVerify, short, canVerify }: { p: Proof; onVerify: (id: string, v: Verification) => void; short?: boolean; canVerify: boolean }) {
  if (p.verification === 'VERIFIED') return <CheckCircle2 className="h-4 w-4 shrink-0 text-[#00B894]" aria-label="Đã xác minh" />;
  if (p.verification === 'REJECTED')
    return <button disabled={!canVerify} className="text-[11px] text-[#94A3B8] hover:underline disabled:opacity-40" onClick={() => onVerify(p.id, 'PENDING')}>Khôi phục</button>;
  if (!canVerify) return <span className="shrink-0 text-[11px] text-[#F7B23B]">Chờ xác minh</span>;
  return (
    <span className="flex shrink-0 gap-1">
      <button className={cn(btnBase, 'rounded-md bg-[#00B894]/15 px-1.5 py-0.5 text-[11px] text-[#3DDBB6] hover:bg-[#00B894]/25')} onClick={() => onVerify(p.id, 'VERIFIED')}>{short ? 'Duyệt' : 'Xác minh'}</button>
      <button className={cn(btnBase, 'rounded-md bg-[#EF4444]/15 px-1.5 py-0.5 text-[11px] text-[#F87171] hover:bg-[#EF4444]/25')} onClick={() => onVerify(p.id, 'REJECTED')}>Loại</button>
    </span>
  );
}

const ESC_MAP: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
const esc = (s: string) => s.replace(/[&<>"']/g, (ch) => ESC_MAP[ch] ?? ch);

/** Mở bản in Audit Pack — người dùng chọn "Lưu dưới dạng PDF" (production: render PDF phía server) */
function openAuditPack(c: Claim, checks: Check[], budget: Budget, customerName: string): boolean {
  const w = window.open('', '_blank');
  if (!w) return false;
  const rows = (arr: [string, string][]) => arr.map(([k, v]) => `<tr><th>${esc(k)}</th><td>${esc(v)}</td></tr>`).join('');
  w.document.write(`<!doctype html><html lang="vi"><head><meta charset="utf-8"><title>${esc(c.code)} Audit Pack</title>
  <style>body{font-family:'Be Vietnam Pro',Arial,sans-serif;color:#111;margin:40px;font-size:13px}h1{font-size:20px;margin:0 0 4px}
  h2{font-size:15px;margin:28px 0 8px;border-bottom:2px solid #F28C33;padding-bottom:4px}table{width:100%;border-collapse:collapse}
  th,td{text-align:left;padding:6px 8px;border-bottom:1px solid #ddd;vertical-align:top}th{width:34%;color:#555;font-weight:500}
  .ok{color:#00875f}.no{color:#c62828}.muted{color:#666}img{max-width:220px;margin:4px;border:1px solid #ddd}</style></head><body>
  <h1>Bộ hồ sơ claim ${esc(c.code)}</h1><p class="muted">Quỹ MDF ${budget.fiscalYear} của ${esc(budget.vendor)}. Xuất lúc ${new Date().toLocaleString('vi-VN')}</p>
  <h2>Thông tin chương trình</h2><table>${rows([
    ['Mã Pre-Approval', c.preApprovalId], ['Chương trình', c.programTitle], ['Nhóm', progName(c.programType)],
    ['Đơn vị hưởng lợi', customerName], ['Thời gian', c.period], ['Số tiền claim', vnd(c.claimed)], ['Trần Hãng duyệt', vnd(c.cap)],
    ['Hóa đơn GTGT', c.invoice ? `${c.invoice.serial}-${c.invoice.number}, ngày ${fmtDate(c.invoice.date)}, MST NCC ${c.invoice.supplierTax}, ${vnd(c.invoice.amount)}` : 'Không có'],
  ])}</table>
  <h2>Kết quả checklist kiểm toán</h2><table>${checks.map((i) => `<tr><th>${esc(i.label)}</th><td class="${i.passed ? 'ok' : 'no'}">${i.passed ? 'Đạt' : 'Chưa đạt'}: ${esc(i.detail)}</td></tr>`).join('')}</table>
  <h2>Danh mục chứng từ</h2><table>${c.proofs.filter((p) => p.verification !== 'REJECTED').map((p) => `<tr><th>${esc(POP_LABEL[p.type])}</th><td>${esc(p.name)}${p.gps ? ` (GPS ${esc(p.gps)}, ${esc(p.capturedAt ?? '')})` : ''}${p.url && p.type === 'SITE_PHOTO' ? `<br><img src="${p.url}">` : ''}</td></tr>`).join('')}</table>
  <script>window.onload=()=>setTimeout(()=>window.print(),300)</script></body></html>`);
  w.document.close();
  return true;
}

type InvoiceDraft = { serial: string; number: string; date: string; supplierTax: string; amount: number; claimed: number };

function ClaimDrawer({ id, onClose }: { id: string; onClose: () => void }) {
  const { claims, setClaims, customers, budget, policy, canDo, notify, dept, setPrograms } = useApp();
  const claim = claims.find((c) => c.id === id);
  const [confirmDel, setConfirmDel] = useState(false);
  const [wm, setWm] = useState(true);
  const [docType, setDocType] = useState<PopType>('VAT_INVOICE');
  const [attendees, setAttendees] = useState(0);
  const [busy, setBusy] = useState(false);
  const [editing, setEditing] = useState(false);
  const [inv, setInv] = useState<InvoiceDraft>({
    serial: claim?.invoice?.serial ?? '', number: claim?.invoice?.number ?? '', date: claim?.invoice?.date ?? '',
    supplierTax: claim?.invoice?.supplierTax ?? '', amount: claim?.invoice?.amount ?? claim?.claimed ?? 0, claimed: claim?.claimed ?? 0,
  });
  if (!claim) return null;

  const rules = policy.rules;
  const checks = auditClaim(claim, rules);
  const blockers = checks.filter((i) => i.severity === 'BLOCKER' && !i.passed);
  const warnings = checks.filter((i) => i.severity === 'WARNING' && !i.passed);
  const photos = claim.proofs.filter((p) => p.type === 'SITE_PHOTO');
  const docs = claim.proofs.filter((p) => p.type !== 'SITE_PHOTO');
  const cust = customers.find((c) => c.id === claim.customerId);
  const st = claimState(claim, rules);
  const canUpload = canDo('claim.uploadPop') && !claim.submitted;
  const canVerify = canDo('claim.verify') && !claim.submitted;
  const canEditInfo = (canDo('claim.uploadPop') || canDo('claim.accounting')) && !claim.submitted;

  const update = (fn: (c: Claim) => Claim) => setClaims((p) => p.map((c) => (c.id === id ? fn(c) : c)));
  const verify = (pid: string, v: Verification) => update((c) => ({ ...c, proofs: c.proofs.map((p) => (p.id === pid ? { ...p, verification: v } : p)) }));
  const remove = (pid: string) =>
    update((c) => {
      const p = c.proofs.find((x) => x.id === pid);
      if (p?.url) URL.revokeObjectURL(p.url);
      return { ...c, proofs: c.proofs.filter((x) => x.id !== pid) };
    });

  /** Tải file từ máy: tính SHA-256, phát hiện trùng với claim khác, tạo bản xem trước */
  const addFiles = async (files: File[], type: PopType) => {
    setBusy(true);
    const existing = claims.flatMap((c) => c.proofs.map((p) => ({ checksum: p.checksum, claimId: c.id, claimCode: c.code })));
    const added: Proof[] = [];
    let skipped = 0;
    let tooBig = 0;
    for (const f of files) {
      if (f.size > 20 * 1024 * 1024) { tooBig++; continue; }
      const checksum = await sha256(f);
      const hit = existing.find((p) => p.checksum === checksum);
      if ((hit && hit.claimId === id) || added.some((p) => p.checksum === checksum)) { skipped++; continue; }
      const isPhoto = type === 'SITE_PHOTO';
      added.push({
        id: uid('p'), type, name: f.name, verification: 'PENDING', url: URL.createObjectURL(f), size: f.size, checksum, uploaded: true,
        watermark: isPhoto ? wm : undefined, inWindow: isPhoto ? true : undefined,
        capturedAt: isPhoto ? new Date(f.lastModified).toLocaleString('vi-VN') : undefined,
        attendeeCount: type === 'ATTENDEE_SIGN_SHEET' ? attendees : undefined,
        duplicateOf: hit ? hit.claimCode : undefined, hue: (added.length * 53) % 360,
      });
    }
    update((c) => ({ ...c, proofs: [...c.proofs, ...added] }));
    setBusy(false);
    const dup = added.filter((p) => p.duplicateOf).length;
    const parts = [`Đã tải ${added.length} file`];
    if (skipped) parts.push(`bỏ qua ${skipped} file đã có trong hồ sơ`);
    if (tooBig) parts.push(`${tooBig} file vượt 20 MB`);
    if (dup) parts.push(`${dup} file trùng hồ sơ khác`);
    notify(parts.join(', '), dup || tooBig ? 'orange' : 'teal');
  };

  const saveInfo = () => {
    if (!inv.number || !inv.serial || !inv.date || !MST_RE.test(inv.supplierTax)) {
      notify('Nhập đủ ký hiệu, số, ngày hóa đơn và MST nhà cung cấp hợp lệ', 'red');
      return;
    }
    update((c) => ({ ...c, claimed: inv.claimed, invoice: { serial: inv.serial, number: inv.number, date: inv.date, supplierTax: inv.supplierTax, amount: inv.amount } }));
    setEditing(false);
    notify('Đã cập nhật thông tin hóa đơn và số tiền claim', 'teal');
  };

  const exportPack = () => {
    if (!openAuditPack(claim, checks, budget, cust?.name ?? 'Hoạt động chung')) {
      notify('Trình duyệt đã chặn cửa sổ mới. Cho phép pop-up rồi bấm xuất lại.', 'red');
      return;
    }
    if (!claim.submitted) {
      update((c) => ({ ...c, submitted: true }));
      notify(`Đã xuất bộ hồ sơ ${claim.code} và chuyển trạng thái Đã nộp Hãng`, 'teal');
    }
  };

  const setI = <K extends keyof InvoiceDraft>(k: K, v: InvoiceDraft[K]) => setInv((p) => ({ ...p, [k]: v }));
  const docTypes = POP_TYPES.filter((t) => t !== 'SITE_PHOTO');

  return (
    <Drawer
      title={claim.programTitle}
      eyebrow={claim.code}
      badge={<Chip tone={st.tone}>{st.label}</Chip>}
      onClose={onClose}
      actions={<button className={cn(btnGhost, btnSm, 'hover:text-[#F87171]')} disabled={!canDo('claim.submit')} onClick={() => setConfirmDel(true)}><Trash2 className="h-3.5 w-3.5" aria-hidden />Xóa hồ sơ</button>}
      footer={
        <>
          {blockers.length > 0 && !claim.submitted && <p className="mb-3 text-xs text-[#F87171]">Còn {blockers.length} điều kiện bắt buộc chưa đạt. Xử lý xong mới xuất được bộ hồ sơ.</p>}
          <button className={cn(btnPrimary, 'w-full py-2.5')} disabled={(blockers.length > 0 && !claim.submitted) || !canDo('claim.submit')} title={canDo('claim.submit') ? undefined : 'Vai trò của bạn không nộp hồ sơ Hãng'} onClick={exportPack}>
            <Download className="h-4 w-4" aria-hidden />
            {claim.submitted ? 'Xuất lại Bộ Hồ Sơ Claim PDF' : 'Xuất Bộ Hồ Sơ Claim PDF (Export Audit Pack)'}
          </button>
        </>
      }
    >
      <dl className="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
        {[
          ['Pre-Approval', claim.preApprovalId],
          ['Nhóm chương trình', progName(claim.programType)],
          ['Đơn vị hưởng lợi', cust?.name ?? 'Hoạt động chung'],
          ['Phòng phụ trách', dept(claim.dept)?.name ?? ''],
          ['Thời gian', claim.period],
          ['Hạn nộp claim', claim.submitted ? 'Đã nộp' : `Còn ${claim.daysLeft} ngày`],
        ].map(([k, v]) => (
          <div key={k}><dt className="text-xs text-[#94A3B8]">{k}</dt><dd className="mt-0.5 text-[#F1F5F9]">{v}</dd></div>
        ))}
      </dl>

      {/* Số tiền & hóa đơn */}
      <section className="rounded-md border border-[#263044] p-4">
        <div className="mb-3 flex items-center justify-between gap-2">
          <h3 className="flex items-center gap-2 text-sm font-semibold text-[#F1F5F9]"><ReceiptIcon className="h-4 w-4 text-[#94A3B8]" aria-hidden />Số tiền và hóa đơn GTGT</h3>
          {canEditInfo && !editing && <button className={cn(btnGhost, btnSm)} onClick={() => setEditing(true)}><Pencil className="h-3.5 w-3.5" aria-hidden />Cập nhật</button>}
        </div>
        {editing ? (
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <Field label="Ký hiệu hóa đơn"><input className={inputCls} value={inv.serial} onChange={(e) => setI('serial', e.target.value.toUpperCase())} placeholder="1C26TAA" /></Field>
            <Field label="Số hóa đơn"><input className={inputCls} value={inv.number} onChange={(e) => setI('number', e.target.value)} placeholder="0001234" /></Field>
            <Field label="Ngày hóa đơn"><input className={inputCls} type="date" value={inv.date} onChange={(e) => setI('date', e.target.value)} /></Field>
            <Field label="MST nhà cung cấp"><input className={inputCls} value={inv.supplierTax} onChange={(e) => setI('supplierTax', e.target.value)} /></Field>
            <Field label="Giá trị hóa đơn"><MoneyInput value={inv.amount} onChange={(n) => setI('amount', n)} /></Field>
            <Field label="Số tiền claim" hint={`Trần ${vnd(claim.cap)}`}><MoneyInput value={inv.claimed} onChange={(n) => setI('claimed', n)} /></Field>
            <div className="flex gap-2 sm:col-span-2"><button className={btnPrimary} onClick={saveInfo}>Lưu</button><button className={btnGhost} onClick={() => setEditing(false)}>Hủy</button></div>
          </div>
        ) : (
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <p className="text-xs text-[#94A3B8]">Số tiền claim</p>
              <p className={cn('mt-1 text-xl font-semibold tabular-nums', claim.claimed > claim.cap ? 'text-[#F87171]' : 'text-[#F1F5F9]')}>{vnd(claim.claimed)}</p>
              <p className="text-xs text-[#94A3B8]">Trần Hãng duyệt {vnd(claim.cap)}</p>
            </div>
            <div>
              <p className="text-xs text-[#94A3B8]">Hóa đơn GTGT</p>
              {claim.invoice ? (
                <>
                  <p className="mt-1 font-medium tabular-nums text-[#F1F5F9]">{claim.invoice.serial}-{claim.invoice.number}</p>
                  <p className="text-xs text-[#94A3B8]">Ngày {fmtDate(claim.invoice.date)}, MST NCC {claim.invoice.supplierTax}, {compact(claim.invoice.amount)}</p>
                </>
              ) : <p className="mt-1 text-sm text-[#F87171]">Chưa nhập thông tin hóa đơn</p>}
            </div>
          </div>
        )}
      </section>

      <ClaimFinancePanel claim={claim} />
      <MdfSettlementPanel claim={claim} />

      {/* Ảnh hiện trường */}
      <section>
        <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h3 className="text-sm font-semibold text-[#F1F5F9]">Ảnh hiện trường ({photos.length})</h3>
          <label className="flex items-center gap-2 text-xs text-[#94A3B8]">
            <input type="checkbox" className="accent-[#F28C33]" checked={wm} onChange={(e) => setWm(e.target.checked)} disabled={!canUpload} />
            Ảnh tải lên đã có watermark GPS và thời gian
          </label>
        </div>
        <FilePicker accept="image/*" multiple disabled={!canUpload || busy} onFiles={(f) => addFiles(f, 'SITE_PHOTO')} className="mb-3 flex items-center justify-center gap-2 rounded border border-dashed border-[#263044] px-4 py-4 text-sm text-[#94A3B8] hover:border-[#F28C33]/60 hover:text-[#F1F5F9]">
          <Camera className="h-4 w-4" aria-hidden />{busy ? 'Đang xử lý file...' : 'Chọn ảnh từ máy tính hoặc kéo thả vào đây'}
        </FilePicker>
        {photos.length > 0 ? (
          <div className="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {photos.map((p) => <PhotoTile key={p.id} p={p} onVerify={verify} onRemove={p.uploaded && canUpload ? remove : undefined} canVerify={canVerify} />)}
          </div>
        ) : <p className="text-sm text-[#94A3B8]">Chưa có ảnh hiện trường.</p>}
      </section>

      {/* Chứng từ khác */}
      <section>
        <h3 className="mb-3 text-sm font-semibold text-[#F1F5F9]">Chứng từ đính kèm</h3>
        {canUpload && (
          <div className="mb-3 flex flex-wrap items-end gap-2">
            <Field label="Loại chứng từ" className="min-w-[200px] flex-1">
              <select className={inputCls} value={docType} onChange={(e) => setDocType(e.target.value as PopType)}>
                {docTypes.map((t) => <option key={t} value={t}>{POP_LABEL[t]}</option>)}
              </select>
            </Field>
            {docType === 'ATTENDEE_SIGN_SHEET' && (
              <Field label="Số người ký tên" className="w-32"><input className={inputCls} type="number" min={0} value={attendees || ''} onChange={(e) => setAttendees(Number(e.target.value))} /></Field>
            )}
            <FilePicker accept=".pdf,image/*,.xls,.xlsx,.doc,.docx" multiple disabled={busy} onFiles={(f) => addFiles(f, docType)} className={cn(btnGhost, 'py-2')}>
              <Upload className="h-4 w-4" aria-hidden />Tải file
            </FilePicker>
          </div>
        )}
        <ul className="divide-y divide-[#263044] rounded border border-[#263044]">
          {docs.map((p) => (
            <li key={p.id} className={cn('flex items-center gap-3 px-3 py-2.5', p.verification === 'REJECTED' && 'opacity-50')}>
              <FileText className="h-4 w-4 shrink-0 text-[#94A3B8]" aria-hidden />
              <div className="min-w-0 flex-1">
                <p className="truncate text-sm text-[#F1F5F9]">{POP_LABEL[p.type]}{p.duplicateOf && <span className="ml-2 text-xs text-[#F87171]">Trùng {p.duplicateOf}</span>}</p>
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noreferrer" className="block truncate text-xs text-[#6FA8F0] hover:underline">{p.name}{p.attendeeCount != null && `, ${p.attendeeCount} người ký`}</a>
                ) : (
                  <p className="truncate text-xs text-[#94A3B8]">{p.name}{p.attendeeCount != null && `, ${p.attendeeCount} người ký`}</p>
                )}
              </div>
              <VerifyControl p={p} onVerify={verify} canVerify={canVerify} />
              {p.uploaded && canUpload && <button className="text-[#94A3B8] hover:text-[#F87171]" onClick={() => remove(p.id)} aria-label={`Xóa ${p.name}`}><Trash2 className="h-4 w-4" /></button>}
            </li>
          ))}
          {!docs.length && <li className="list-none"><EmptyState text={<>Chưa có chứng từ nào.</>} art="doc" compact /></li>}
        </ul>
      </section>

      {/* Checklist */}
      <section>
        <div className="mb-3 flex items-center justify-between">
          <h3 className="flex items-center gap-2 text-sm font-semibold text-[#F1F5F9]"><ShieldCheck className="h-4 w-4 text-[#F28C33]" aria-hidden />Checklist kiểm toán Hãng</h3>
          <span className="text-xs text-[#94A3B8]">{blockers.length} lỗi chặn, {warnings.length} cảnh báo</span>
        </div>
        <ul className="space-y-2">
          {checks.map((i) => {
            const Icon = i.passed ? CheckCircle2 : i.severity === 'BLOCKER' ? XCircle : AlertTriangle;
            const color = i.passed ? C.teal : i.severity === 'BLOCKER' ? C.red : C.orange;
            return (
              <li key={i.key} className="flex items-start gap-3 rounded bg-[#1C2534] px-3 py-2.5">
                <Icon className="mt-0.5 h-4 w-4 shrink-0" style={{ color }} aria-hidden />
                <div className="min-w-0 flex-1"><p className="text-sm text-[#F1F5F9]">{i.label}</p><p className="text-xs text-[#94A3B8]">{i.detail}</p></div>
                {!i.passed && <span className="shrink-0 text-[11px]" style={{ color }}>{i.severity === 'BLOCKER' ? 'Bắt buộc' : 'Nên bổ sung'}</span>}
              </li>
            );
          })}
        </ul>
      </section>

      {claim.submitted && (
        <section className="rounded-md bg-[#1C2534] p-4 text-sm">
          <h3 className="mb-2 font-semibold text-[#F1F5F9]">Tiến độ hoàn quỹ</h3>
          <ul className="space-y-1 text-[#94A3B8]">
            <li>Đối soát VAT: <span className="text-[#F1F5F9]">{claim.vatCheck === 'MATCHED' ? 'Khớp' : claim.vatCheck === 'MISMATCH' ? `Lệch${claim.vatNote ? `, ${claim.vatNote}` : ''}` : 'Chờ kế toán'}</span></li>
            <li>Hãng duyệt: <span className="text-[#F1F5F9]">{claim.vendorApproved != null ? vnd(claim.vendorApproved) : 'Chưa có kết quả'}</span></li>
            <li>Credit Note: <span className="text-[#F1F5F9]">{claim.creditNote ? `${claim.creditNote.number}, ${vnd(claim.creditNote.amount)}` : 'Chưa nhận'}</span></li>
            <li>Cấn trừ công nợ Hãng: <span className="text-[#F1F5F9]">{claim.offset ? 'Đã cấn trừ' : 'Chưa'}</span></li>
          </ul>
        </section>
      )}
      {confirmDel && (
        <ConfirmDialog
          title="Xóa hồ sơ claim"
          message={<>Xóa hồ sơ <b>{claim.code}</b> và toàn bộ chứng từ đã tải? Chương trình quay về trạng thái 3M đã duyệt để lập hồ sơ mới.</>}
          blocked={claim.submitted ? 'Hồ sơ đã nộp 3M, không thể xóa. Theo dõi tiếp ở tab Đối soát.' : undefined}
          onConfirm={() => {
            claim.proofs.forEach((p) => p.url && p.uploaded && URL.revokeObjectURL(p.url));
            setClaims((p) => p.filter((c) => c.id !== claim.id));
            if (claim.programId) setPrograms((ps) => ps.map((x) => (x.id === claim.programId ? { ...x, status: 'APPROVED', claimId: undefined } : x)));
            notify(`Đã xóa hồ sơ ${claim.code}`, 'orange');
            onClose();
          }}
          onClose={() => setConfirmDel(false)}
        />
      )}
    </Drawer>
  );
}

// ---- Tab kế toán: đối soát VAT, Hãng duyệt, Credit Note, cấn trừ ----
function AccountingTab() {
  const { claims, setClaims, programs, setPrograms, setBudget, budget, customers, canDo, notify, openClaim, dispatch } = useApp();
  const [modal, setModal] = useState<{ kind: 'approve' | 'cn' | 'mismatch'; claim: Claim } | null>(null);
  const [amount, setAmount] = useState(0);
  const [cnNumber, setCnNumber] = useState('');
  const [note, setNote] = useState('');
  const canAcc = canDo('claim.accounting');
  const yearClaims = claims.filter((c) => claimYear(c, programs) === budget.fiscalYear);
  const list = yearClaims.filter((c) => c.submitted).sort((a, b) => Number(!!a.offset) - Number(!!b.offset) || b.code.localeCompare(a.code));
  const update = (id: string, p: Partial<Claim>) => setClaims((all) => all.map((c) => (c.id === id ? { ...c, ...p } : c)));

  const open = (kind: 'approve' | 'cn' | 'mismatch', c: Claim) => {
    setModal({ kind, claim: c });
    setAmount(kind === 'cn' ? c.vendorApproved ?? c.claimed : c.claimed);
    setCnNumber(nextCode(claims.map((x) => x.creditNote?.number ?? ''), 'CN-3MVN-2026-', 4));
    setNote('');
  };

  /** Hãng duyệt: quyết toán giữ chỗ -> đã tiêu (chỉ với claim gắn chương trình đang giữ chỗ) */
  const approve = () => {
    if (!modal) return;
    const c = modal.claim;
    if (amount <= 0 || amount > c.claimed) { notify('Số Hãng duyệt phải lớn hơn 0 và không vượt số claim', 'red'); return; }
    const prog = programs.find((p) => p.id === c.programId);
    if (prog && prog.held > 0) {
      setBudget((b) => ({ ...b, spent: b.spent + amount, committed: Math.max(0, b.committed - prog.held) }));
      setPrograms((ps) => ps.map((p) => (p.id === prog.id ? { ...p, held: 0, status: 'CLOSED' } : p)));
    }
    update(c.id, { vendorApproved: amount });
    dispatch('CLAIM_UPDATE', { title: 'Hãng đã duyệt claim', body: `${c.code} ${c.programTitle}: Hãng chấp thuận ${vnd(amount)}`, module: 'claims' });
    notify(`Đã ghi nhận Hãng duyệt ${vnd(amount)} cho ${c.code}${prog && prog.held > amount ? `, nhả ${compact(prog.held - amount)} về quỹ` : ''}`, 'teal');
    setModal(null);
  };

  const receiveCn = () => {
    if (!modal) return;
    if (!cnNumber.trim() || amount <= 0) { notify('Nhập số Credit Note và số tiền', 'red'); return; }
    update(modal.claim.id, { creditNote: { number: cnNumber.trim(), date: todayISO(), amount } });
    notify(`Đã ghi nhận Credit Note ${cnNumber} cho ${modal.claim.code}`, 'teal');
    setModal(null);
  };

  const pendingVat = list.filter((c) => !c.vatCheck).length;
  const pendingVendor = list.filter((c) => c.vendorApproved == null);
  const pendingCn = list.filter((c) => c.vendorApproved != null && !c.creditNote);
  const offsetTotal = list.filter((c) => c.offset).reduce((s, c) => s + (c.creditNote?.amount ?? 0), 0);

  return (
    <div className="space-y-5">
      {!canAcc && <p className="rounded border border-[#263044] bg-[#1C2534] px-4 py-3 text-sm text-[#94A3B8]">Bạn đang xem ở chế độ chỉ đọc. Thao tác đối soát dành cho Kế toán và Ban Giám đốc.</p>}
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Chờ đối soát" value={String(pendingVat)} sub="Hồ sơ đã nộp Hãng" icon={Scale} color={pendingVat ? C.orange : C.teal} />
        <StatCard label="Chờ Hãng duyệt" value={compact(pendingVendor.reduce((s, c) => s + c.claimed, 0))} sub={`${pendingVendor.length} hồ sơ`} icon={Clock} />
        <StatCard label="Chờ Credit Note" value={compact(pendingCn.reduce((s, c) => s + (c.vendorApproved ?? 0), 0))} sub={`${pendingCn.length} hồ sơ Hãng đã duyệt`} icon={ReceiptIcon} color={C.sand} />
        <StatCard label="Đã cấn trừ" value={compact(offsetTotal)} sub="Tổng Credit Note đã cấn trừ" icon={CheckCircle2} color={C.teal} />
      </div>

      <Panel title="Đối soát hoàn quỹ với Hãng">
        <Table head={['Hồ sơ', 'Hóa đơn GTGT', 'Đối soát VAT', 'Hãng duyệt', 'Credit Note', 'Cấn trừ công nợ']} minW={1100}>
          {list.map((c) => {
            const diff = c.invoice ? c.invoice.amount - c.claimed : 0;
            const cust = customers.find((k) => k.id === c.customerId);
            return (
              <tr key={c.id} className={rowCls}>
                <td className={tdFirst}>
                  <button className="text-left font-medium text-[#F1F5F9] hover:underline" onClick={() => openClaim(c.id)}>{c.code}</button>
                  <p className="max-w-[240px] truncate text-xs text-[#94A3B8]">{c.programTitle}</p>
                  <p className="text-xs text-[#94A3B8]">{cust?.name ?? 'Hoạt động chung'}, claim {compact(c.claimed)}</p>
                </td>
                <td className={cn(tdCls, 'text-xs')}>
                  {c.invoice ? (
                    <>
                      <p className="text-[#F1F5F9]">{c.invoice.serial}-{c.invoice.number}</p>
                      <p className="text-[#94A3B8]">MST {c.invoice.supplierTax}, {compact(c.invoice.amount)}</p>
                      {diff !== 0 && <p className="text-[#F7B23B]">Chênh {diff > 0 ? '+' : ''}{compact(diff)} so với claim</p>}
                    </>
                  ) : <span className="text-[#F87171]">Thiếu hóa đơn</span>}
                </td>
                <td className={tdCls}>
                  {c.vatCheck ? (
                    <Chip tone={c.vatCheck === 'MATCHED' ? 'teal' : 'red'}>{c.vatCheck === 'MATCHED' ? 'Khớp' : 'Lệch'}</Chip>
                  ) : (
                    <div className="flex gap-1">
                      <button disabled={!canAcc} className={cn(btnBase, 'rounded-md bg-[#00B894]/15 px-2 py-1 text-xs text-[#3DDBB6]')} onClick={() => { update(c.id, { vatCheck: 'MATCHED' }); notify(`${c.code}: hóa đơn khớp`, 'teal'); }}>Khớp</button>
                      <button disabled={!canAcc} className={cn(btnBase, 'rounded-md bg-[#EF4444]/15 px-2 py-1 text-xs text-[#F87171]')} onClick={() => open('mismatch', c)}>Lệch</button>
                    </div>
                  )}
                  {c.vatNote && <p className="mt-1 max-w-[180px] text-xs text-[#94A3B8]">{c.vatNote}</p>}
                </td>
                <td className={tdCls}>
                  {c.vendorApproved != null ? (
                    <p className="tabular-nums text-[#F1F5F9]">{vnd(c.vendorApproved)}</p>
                  ) : (
                    <button disabled={!canAcc} className={cn(btnGhost, btnSm)} onClick={() => open('approve', c)}>Ghi nhận Hãng duyệt</button>
                  )}
                </td>
                <td className={tdCls}>
                  {c.creditNote ? (
                    <><p className="text-[#F1F5F9]">{c.creditNote.number}</p><p className="text-xs text-[#94A3B8]">{fmtDate(c.creditNote.date)}, {compact(c.creditNote.amount)}</p></>
                  ) : (
                    <button disabled={!canAcc || c.vendorApproved == null || c.vatCheck !== 'MATCHED'} title={c.vatCheck !== 'MATCHED' ? 'Cần đối soát VAT khớp trước' : c.vendorApproved == null ? 'Chờ Hãng duyệt' : undefined} className={cn(btnGhost, btnSm)} onClick={() => open('cn', c)}>Nhận Credit Note</button>
                  )}
                </td>
                <td className={tdLast}>
                  {c.offset ? (
                    <Chip tone="teal">Đã cấn trừ</Chip>
                  ) : (
                    <button disabled={!canAcc || !c.creditNote} className={cn(btnBase, btnSm, 'bg-[#F28C33]/15 text-[#F7B23B] hover:bg-[#F28C33]/25')} onClick={() => { update(c.id, { offset: true }); notify(`Đã cấn trừ ${compact(c.creditNote?.amount ?? 0)} vào công nợ phải trả Hãng`, 'teal'); }}>Cấn trừ công nợ</button>
                  )}
                </td>
              </tr>
            );
          })}
        </Table>
        {!list.length && <EmptyState text={<>Chưa có hồ sơ nào nộp Hãng.</>} art="doc" />}
      </Panel>

      {modal?.kind === 'approve' && (
        <Modal title={`Hãng duyệt ${modal.claim.code}`} onClose={() => setModal(null)} footer={<><button className={btnGhost} onClick={() => setModal(null)}>Hủy</button><button className={btnPrimary} onClick={approve}>Ghi nhận</button></>}>
          <Field label="Số tiền Hãng chấp thuận" hint={`Số claim ${vnd(modal.claim.claimed)}. Nếu thấp hơn giữ chỗ, phần chênh lệch tự nhả về quỹ.`}><MoneyInput value={amount} onChange={setAmount} /></Field>
        </Modal>
      )}
      {modal?.kind === 'cn' && (
        <Modal title={`Nhận Credit Note cho ${modal.claim.code}`} onClose={() => setModal(null)} footer={<><button className={btnGhost} onClick={() => setModal(null)}>Hủy</button><button className={btnPrimary} onClick={receiveCn}>Ghi nhận</button></>}>
          <div className="space-y-4">
            <Field label="Số Credit Note"><input className={inputCls} value={cnNumber} onChange={(e) => setCnNumber(e.target.value)} /></Field>
            <Field label="Giá trị Credit Note"><MoneyInput value={amount} onChange={setAmount} /></Field>
          </div>
        </Modal>
      )}
      {modal?.kind === 'mismatch' && (
        <Modal title={`Ghi nhận lệch hóa đơn ${modal.claim.code}`} onClose={() => setModal(null)} footer={<><button className={btnGhost} onClick={() => setModal(null)}>Hủy</button><button className={btnPrimary} onClick={() => { update(modal.claim.id, { vatCheck: 'MISMATCH', vatNote: note.trim() || 'Chưa ghi chú' }); notify(`${modal.claim.code}: đã ghi nhận lệch hóa đơn`, 'orange'); setModal(null); }}>Ghi nhận lệch</button></>}>
          <Field label="Nội dung chênh lệch"><textarea className={cn(inputCls, 'min-h-24')} value={note} onChange={(e) => setNote(e.target.value)} placeholder="VD: Giá trị hóa đơn cao hơn claim 2 triệu, cần NCC xuất hóa đơn điều chỉnh" /></Field>
        </Modal>
      )}
    </div>
  );
}

// =====================================================================
//  PHÂN HỆ 6: BÁO CÁO & PHÂN TÍCH ROI
// =====================================================================

type ReportView = 'mfg' | 'trade' | 'aging' | 'commission' | 'mdf';
function ReportsPage() {
  const { company, canDo, role } = useApp();
  const mode = bizMode(company);
  const finance = canDo('cash.manage') || canDo('receipt.confirm') || canDo('claim.accounting') || role === 'BOD';
  // Tài chính: công nợ, quyết toán; chỉ số Marketing & quỹ MDF đã gộp vào Tổng quan
  const tabs: { id: ReportView; label: string }[] = [
    ...(finance ? [{ id: 'aging' as const, label: 'Công nợ & tuổi nợ' }] : []),
    ...(finance && mode !== 'MFG' ? [{ id: 'mdf' as const, label: 'Quyết toán quỹ MDF' }] : []),
    ...(finance && mode !== 'TRADING' ? [{ id: 'commission' as const, label: 'Quyết toán hoa hồng' }] : []),
    ...(mode !== 'TRADING' ? [{ id: 'mfg' as const, label: 'Lãi gộp đơn hàng' }] : []),
  ];
  const [view, setView] = useState<ReportView>(tabs[0]?.id ?? 'aging');
  if (!tabs.length) return <Panel><p className="py-10 text-center text-sm text-[#94A3B8]">Phân hệ Tài chính dành cho Kế toán và Ban Giám đốc. Chỉ số Marketing & quỹ MDF xem ở Tổng quan.</p></Panel>;
  const cur = tabs.some((t) => t.id === view) ? view : tabs[0].id;
  return (
    <div className="space-y-5">
      <Tabs tabs={tabs} value={cur} onChange={setView} aside={<DateRangePicker />} />
      {cur === 'mfg' && <MfgReports />}
      {cur === 'aging' && <ArAgingPanel />}
      {cur === 'commission' && <CommissionPanel />}
      {cur === 'mdf' && <MdfSettlementReport />}
    </div>
  );
}

/** Chỉ số Marketing & ROI, hiển thị nối tiếp Quỹ MDF ở Tổng quan (gộp tab Marketing cũ của Báo cáo) */
function TradingReports({ embedded }: { embedded?: boolean } = {}) {
  const { customers, claims, programs, myLeads: leads, departments, now, mktItems, canDo } = useApp();
  const [preview, setPreview] = useState(false);
  const mdfOf = (id: string) => mdfOfCustomer(id, claims, programs);

  // ---- Đối soát đóng góp: Data MKT vs Quỹ MDF ----
  const groups = {
    both: customers.filter((c) => isMktCustomer(c) && mdfOf(c.id) > 0),
    mktOnly: customers.filter((c) => isMktCustomer(c) && mdfOf(c.id) === 0),
    mdfOnly: customers.filter((c) => !isMktCustomer(c) && mdfOf(c.id) > 0),
    none: customers.filter((c) => !isMktCustomer(c) && mdfOf(c.id) === 0),
  };
  const sum = (l: Customer[]) => l.reduce((s, c) => s + c.ytdRevenue, 0);
  const mktRev = sum(customers.filter((c) => isMktCustomer(c)));
  const mdfCustomers = customers.filter((c) => mdfOf(c.id) > 0);
  const mdfRev = sum(mdfCustomers);
  const mdfGiven = mdfCustomers.reduce((s, c) => s + mdfOf(c.id), 0);
  const totalRev = sum(customers);

  const byDept = departments.filter((d) => d.active).map((d) => {
    const cs = customers.filter((c) => c.dept === d.code);
    return { name: d.short, 'Từ data MKT': sum(cs.filter((c) => isMktCustomer(c))), 'Khách nhận MDF': sum(cs.filter((c) => mdfOf(c.id) > 0)) };
  });

  // ---- ROI theo nhóm chương trình (doanh thu của khách hưởng lợi / MDF nhóm đó) ----
  const byType = PROGRAM_TYPES.map((t) => {
    const ids = new Set([...claims.filter((c) => c.programType === t && c.customerId).map((c) => c.customerId!), ...programs.filter((p) => p.type === t && p.customerId && p.held > 0).map((p) => p.customerId!)]);
    const spent = claims.filter((c) => c.programType === t && c.customerId).reduce((s, c) => s + c.claimed, 0) + programs.filter((p) => p.type === t && p.customerId && p.held > 0 && p.status !== 'CLAIMING').reduce((s, p) => s + p.held, 0);
    const rev = sum(customers.filter((c) => ids.has(c.id)));
    return { t, spent, rev, n: ids.size, lev: spent ? rev / spent : null };
  });

  // ---- Phễu chuyển đổi ----
  const cnt = (s: LeadStatus[]) => leads.filter((l) => s.includes(l.status)).length;
  const funnel: [string, number][] = [
    ['Tổng lead MKT', leads.length],
    ['Đã phân về phòng ban', cnt(['ROUTED', 'ASSIGNED', 'ACCEPTED', 'QUOTED', 'WON', 'LOST'])],
    ['Đã chỉ định Sales', cnt(['ASSIGNED', 'ACCEPTED', 'QUOTED', 'WON', 'LOST'])],
    ['Sales tiếp nhận', cnt(['ACCEPTED', 'QUOTED', 'WON', 'LOST'])],
    ['Đã gửi báo giá', cnt(['QUOTED', 'WON', 'LOST'])],
    ['Chốt đơn', cnt(['WON'])],
  ];

  const sla = departments.filter((d) => d.receivesLeads).map((d) => {
    const l = leads.filter((x) => x.dept === d.code);
    const late = l.filter((x) => x.slaMet === false || isAcceptLate(x, now)).length;
    return { name: d.short, 'Đúng SLA': l.filter((x) => x.slaMet === true).length, 'Trễ SLA': late };
  });

  const roiRows = mdfCustomers.map((c) => ({ c, mdf: mdfOf(c.id), lev: c.ytdRevenue / mdfOf(c.id) })).sort((a, b) => b.lev - a.lev);
  const tooltip = { contentStyle: { background: C.card, border: `1px solid ${C.line}`, borderRadius: 8, color: C.text }, labelStyle: { color: C.muted } };

  // ---- ROI Marketing vs ROI quỹ MDF ----
  const mktSpent = mktItems.reduce((s, i) => s + i.spent, 0);
  const roiMkt = mktSpent ? mktRev / mktSpent : null;
  const roiMdf = mdfGiven ? mdfRev / mdfGiven : null;
  const roiCompare = [
    { name: 'Marketing', 'Doanh số tạo ra': mktRev, 'Chi phí': mktSpent },
    { name: 'Quỹ 3M (MDF + CS)', 'Doanh số tạo ra': mdfRev, 'Chi phí': mdfGiven },
  ];
  const won = leads.filter((l) => l.status === 'WON');
  const lost = leads.filter((l) => l.status === 'LOST');
  const lostByReason = (Object.keys(LOST_REASON) as LostReason[]).map((r) => ({ r, n: lost.filter((l) => l.lostReason === r).length, v: lost.filter((l) => l.lostReason === r).reduce((s, l) => s + boqTotal(l), 0) }));

  return (
    <div className="space-y-5">
      <div className="flex flex-wrap items-center justify-between gap-3 border-t border-[#263044] pt-5">
        <div>
          <h2 className="text-[15px] font-semibold text-[#F1F5F9]">Marketing & hiệu quả quỹ</h2>
          <p className="text-xs text-[#94A3B8]">Email báo cáo tháng tự gửi Ban Giám đốc, MKT và Kế toán đầu mỗi tháng (cấu hình Email SMTP).</p>
        </div>
        <button className={cn(btnGhost, btnSm)} onClick={() => setPreview(true)}><Eye className="h-3.5 w-3.5" aria-hidden />Xem trước email báo cáo tháng</button>
      </div>

      {!embedded && canDo('mdf.margin') && <MdfMarginPanel />}

      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Doanh số khách nguồn MKT" value={compact(mktRev)} sub={`${pct(mktRev, totalRev)} tổng doanh số, chi MKT ${compact(mktSpent)}`} icon={Inbox} color={C.orange} />
        <StatCard label="ROI Marketing" value={roiMkt ? `${roiMkt.toFixed(1)} lần` : '—'} sub="Doanh số khách MKT / chi phí MKT" icon={Megaphone} color={C.orange} />
        <StatCard label="Doanh số khách nhận quỹ" value={compact(mdfRev)} sub={`${mdfCustomers.length} khách, quỹ đã cấp ${compact(mdfGiven)}`} icon={Coins} color={C.teal} />
        <StatCard label="ROI quỹ 3M" value={roiMdf ? `${roiMdf.toFixed(1)} lần` : '—'} sub="Doanh số khách nhận quỹ / quỹ đã cấp" icon={TrendingUp} color={C.teal} />
      </div>

      <MarketingMetrics leads={leads} mktRev={mktRev} />

      <div className="grid grid-cols-1 gap-5 xl:grid-cols-3">
        <Panel title="ROI Marketing so với ROI quỹ Hãng 3M" className="xl:col-span-2">
          <div>
            <div className="h-60">
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={roiCompare} margin={{ top: 8, right: 8, left: -8, bottom: 0 }}>
                  <CartesianGrid stroke={C.line} strokeDasharray="3 3" vertical={false} />
                  <XAxis dataKey="name" stroke={C.muted} tickLine={false} axisLine={false} fontSize={12} />
                  <YAxis stroke={C.muted} tickLine={false} axisLine={false} fontSize={12} tickFormatter={(v) => compact(Number(v))} width={64} />
                  <Tooltip {...tooltip} formatter={(v) => vnd(Number(v))} cursor={{ fill: '#ffffff08' }} />
                  <Legend wrapperStyle={{ fontSize: 12, color: C.muted }} />
                  <Bar dataKey="Doanh số tạo ra" fill={C.teal} radius={[4, 4, 0, 0]} />
                  <Bar dataKey="Chi phí" fill={C.orange} radius={[4, 4, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </div>
            <p className="mt-2 text-xs text-[#94A3B8]">{roiMkt && roiMdf ? (roiMkt > roiMdf ? 'Mỗi đồng chi Marketing đang tạo doanh số cao hơn quỹ 3M.' : 'Mỗi đồng quỹ 3M đang tạo doanh số cao hơn chi phí Marketing.') : ''} Một khách có thể thuộc cả hai nhóm.</p>
          </div>
        </Panel>
        <Panel title="Chốt đơn và Trượt">
          <div className="flex items-end gap-6">
            <div><p className="text-xs text-[#94A3B8]">Chốt đơn</p><p className="text-2xl font-semibold tabular-nums text-[#3DDBB6]">{won.length}</p><p className="text-xs tabular-nums text-[#94A3B8]">{compact(won.reduce((s, l) => s + boqTotal(l), 0))}</p></div>
            <div><p className="text-xs text-[#94A3B8]">Trượt</p><p className="text-2xl font-semibold tabular-nums text-[#F87171]">{lost.length}</p><p className="text-xs tabular-nums text-[#94A3B8]">{compact(lost.reduce((s, l) => s + boqTotal(l), 0))}</p></div>
            <div><p className="text-xs text-[#94A3B8]">Tỷ lệ chốt</p><p className="text-2xl font-semibold tabular-nums">{pct(won.length, won.length + lost.length)}</p></div>
          </div>
          <p className="mb-2 mt-5 text-xs font-medium text-[#94A3B8]">Lý do trượt</p>
          <ul className="space-y-2.5">
            {lostByReason.map((x) => (
              <li key={x.r}>
                <div className="mb-1 flex justify-between text-sm"><span className="text-[#94A3B8]">{LOST_REASON[x.r]}</span><span className="tabular-nums">{x.n} dự án, {compact(x.v)}</span></div>
                <ProgressBar value={x.n} max={Math.max(1, lost.length)} tone={C.red} />
              </li>
            ))}
          </ul>
        </Panel>
      </div>

      <div className="grid grid-cols-1 gap-5 xl:grid-cols-3">
        <Panel title="Đóng góp doanh số theo phòng ban" className="xl:col-span-2">
          <div className="h-72">
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={byDept} margin={{ top: 8, right: 8, left: -8, bottom: 0 }}>
                <CartesianGrid stroke={C.line} strokeDasharray="3 3" vertical={false} />
                <XAxis dataKey="name" stroke={C.muted} tickLine={false} axisLine={false} fontSize={12} />
                <YAxis stroke={C.muted} tickLine={false} axisLine={false} fontSize={12} tickFormatter={(v) => compact(Number(v))} width={64} />
                <Tooltip {...tooltip} formatter={(v) => vnd(Number(v))} cursor={{ fill: '#ffffff08' }} />
                <Legend wrapperStyle={{ fontSize: 12, color: C.muted }} />
                <Bar dataKey="Từ data MKT" fill={C.orange} radius={[4, 4, 0, 0]} />
                <Bar dataKey="Khách nhận MDF" fill={C.teal} radius={[4, 4, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </Panel>
        <Panel title="Đối soát nguồn đóng góp">
          <ul className="space-y-3 text-sm">
            {([
              ['Vừa từ data MKT vừa nhận MDF', groups.both, C.sand],
              ['Chỉ từ data MKT', groups.mktOnly, C.orange],
              ['Chỉ nhận MDF', groups.mdfOnly, C.teal],
              ['Kinh doanh tự khai thác', groups.none, C.muted],
            ] as [string, Customer[], string][]).map(([label, l, col]) => (
              <li key={label}>
                <div className="mb-1 flex justify-between gap-2"><span className="text-[#94A3B8]">{label} ({l.length})</span><span className="tabular-nums text-[#F1F5F9]">{compact(sum(l))}</span></div>
                <ProgressBar value={sum(l)} max={totalRev} tone={col} />
              </li>
            ))}
          </ul>
          <p className="mt-4 text-xs text-[#94A3B8]">Nhóm giao thoa cho thấy data MKT và quỹ Hãng cùng tác động lên một khách hàng. Không cộng dồn hai nhóm để tránh tính trùng.</p>
        </Panel>
      </div>

      <div className="grid grid-cols-1 gap-5 xl:grid-cols-2">
        <Panel title="ROI theo nhóm chương trình MDF">
          <Table head={['Nhóm chương trình', 'MDF gắn khách hàng', 'Doanh thu khách hưởng lợi', 'ROI']} minW={520}>
            {byType.map((r) => {
              const rt = roiRating(r.lev);
              return (
                <tr key={r.t} className={rowCls}>
                  <td className={tdFirst}><span className="flex items-center gap-2"><i className="h-2 w-2 rounded-full" style={{ background: PROGRAM_COLOR[r.t] }} />{progName(r.t)}</span></td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(r.spent)}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(r.rev)} <span className="text-xs text-[#94A3B8]">({r.n} KH)</span></td>
                  <td className={tdLast}>{r.lev ? <Chip tone={rt.tone}>{r.lev.toFixed(1)} lần</Chip> : <span className="text-[#94A3B8]">—</span>}</td>
                </tr>
              );
            })}
          </Table>
        </Panel>
        <Panel title="Phễu chuyển đổi data MKT">
          <ul className="space-y-2.5">
            {funnel.map(([label, n], i) => (
              <li key={label}>
                <div className="mb-1 flex justify-between text-sm">
                  <span className="text-[#94A3B8]">{label}</span>
                  <span className="tabular-nums text-[#F1F5F9]">{n}{i > 0 && <span className="ml-2 text-xs text-[#94A3B8]">{pct(n, funnel[i - 1][1])}</span>}</span>
                </div>
                <ProgressBar value={n} max={funnel[0][1]} tone={i === funnel.length - 1 ? C.teal : C.orange} />
              </li>
            ))}
          </ul>
        </Panel>
      </div>

      <div className="grid grid-cols-1 gap-5 xl:grid-cols-3">
        <Panel title="Tuân thủ SLA tiếp nhận">
          <div className="h-60">
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={sla} margin={{ top: 8, right: 8, left: -24, bottom: 0 }}>
                <CartesianGrid stroke={C.line} strokeDasharray="3 3" vertical={false} />
                <XAxis dataKey="name" stroke={C.muted} tickLine={false} axisLine={false} fontSize={12} />
                <YAxis stroke={C.muted} tickLine={false} axisLine={false} fontSize={12} allowDecimals={false} />
                <Tooltip {...tooltip} cursor={{ fill: '#ffffff08' }} />
                <Legend wrapperStyle={{ fontSize: 12, color: C.muted }} />
                <Bar dataKey="Đúng SLA" stackId="a" fill={C.teal} />
                <Bar dataKey="Trễ SLA" stackId="a" fill={C.red} radius={[4, 4, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </Panel>
        <Panel title="MDF ROI theo khách hàng" className="xl:col-span-2">
          <Table head={['Khách hàng', 'Hạng', 'MDF đã cấp', 'Doanh thu mang lại', 'MDF ROI']} minW={600}>
            {roiRows.map(({ c, mdf, lev }) => {
              const r = roiRating(lev);
              return (
                <tr key={c.id} className={rowCls}>
                  <td className={tdFirst}><p className="text-[#F1F5F9]">{c.name}</p><p className="text-xs text-[#94A3B8]">{isMktCustomer(c) ? 'Nguồn data MKT' : 'Tự khai thác'}</p></td>
                  <td className={tdCls}><Chip tone={tierInfo(c.tier).tone}>{tierInfo(c.tier).label}</Chip></td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(mdf)}</td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(c.ytdRevenue)}</td>
                  <td className={tdLast}><Chip tone={r.tone}>{lev.toFixed(1)} lần, {r.label.toLowerCase()}</Chip></td>
                </tr>
              );
            })}
          </Table>
        </Panel>
      </div>
      {preview && <MonthlyReportModal onClose={() => setPreview(false)} />}
    </div>
  );
}

// =====================================================================
//  PHÂN HỆ 7: CÀI ĐẶT & CẤU HÌNH HỆ THỐNG
// =====================================================================



// ---- Chỉ số đo lường Marketing: chi phí nội bộ (tách khỏi quỹ 3M) so với lead, đơn chốt, doanh số ----
function MarketingMetrics({ leads, mktRev }: { leads: Lead[]; mktRev: number }) {
  const { mktItems, customers } = useApp();
  const spent = mktItems.reduce((s, i) => s + i.spent, 0);
  const mql = leads.filter((l) => (l.score ?? scoreLead(l, customers)) >= MQL_THRESHOLD).length;
  const won = leads.filter((l) => l.status === 'WON');
  const wonValue = won.reduce((s, l) => s + boqTotal(l), 0);
  const slaDone = leads.filter((l) => l.slaMet !== undefined);

  const paidSources = new Set(mktItems.map((i) => i.source).filter(Boolean) as Source[]);
  const channelRows = (Object.keys(SOURCE_LABEL) as Source[]).map((src) => {
    const cost = mktItems.filter((i) => i.source === src).reduce((s, i) => s + i.spent, 0);
    const ls = leads.filter((l) => l.source === src);
    const w = ls.filter((l) => l.status === 'WON');
    const value = w.reduce((s, l) => s + boqTotal(l), 0);
    return { src, cost, leads: ls.length, won: w.length, value, cpl: cost && ls.length ? cost / ls.length : null, roi: cost ? value / cost : null };
  }).filter((r) => r.leads > 0 || r.cost > 0).sort((a, b) => b.value - a.value);

  const kpis: [string, string, string][] = [
    ['Chi phí MKT', compact(spent), `Ngân sách nội bộ, ${mktItems.length} hạng mục`],
    ['Lead nhận / MQL', `${leads.length} / ${mql}`, `Tỷ lệ MQL ${pct(mql, leads.length)}`],
    ['CPL', leads.length ? compact(spent / leads.length) : '—', `Mỗi MQL ${mql ? compact(spent / mql) : '—'}`],
    ['Lead thành đơn', pct(won.length, leads.length), `${won.length} đơn chốt`],
    ['Chi phí / đơn', won.length ? compact(spent / won.length) : '—', `Giá trị chốt ${compact(wonValue)}`],
    ['Đúng SLA 2h', pct(slaDone.filter((l) => l.slaMet).length, slaDone.length), `${slaDone.length} lead đã tiếp nhận`],
    ['Doanh số MKT', compact(mktRev), 'Theo nguồn khách hàng có cờ Marketing'],
    ['ROI Marketing', spent ? `${(mktRev / spent).toFixed(1)} lần` : '—', `Giá trị chốt / chi phí ${spent ? (wonValue / spent).toFixed(1) : '—'} lần`],
  ];

  return (
    <Panel title="Chỉ số đo lường Marketing">
      <div className="grid grid-cols-2 gap-3 lg:grid-cols-4">
        {kpis.map(([k, v, sub]) => (
          <div key={k} className="rounded bg-[#1C2534] p-3">
            <p className="text-xs text-[#94A3B8]">{k}</p>
            <p className="mt-1 text-lg font-semibold tabular-nums">{v}</p>
            <p className="hidden text-xs text-[#94A3B8] sm:block">{sub}</p>
          </div>
        ))}
      </div>
      <h3 className="mb-2 mt-5 text-sm font-semibold">Hiệu quả theo kênh</h3>
      <Table head={['Kênh', 'Chi phí', 'Lead', 'CPL', 'Chốt đơn', 'Giá trị chốt', 'ROI kênh']} minW={760}>
        {channelRows.map((r) => (
          <tr key={r.src} className={rowCls}>
            <td className={tdFirst}>{SOURCE_LABEL[r.src]}{!paidSources.has(r.src) && <span className="ml-2 text-xs text-[#94A3B8]">không tốn phí</span>}</td>
            <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{r.cost ? compact(r.cost) : '—'}</td>
            <td className={cn(tdCls, 'tabular-nums')}>{r.leads}</td>
            <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{r.cpl ? compact(r.cpl) : '—'}</td>
            <td className={cn(tdCls, 'tabular-nums')}>{r.won}</td>
            <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{r.value ? compact(r.value) : '—'}</td>
            <td className={tdLast}>{r.roi !== null ? <Chip tone={r.roi >= 5 ? 'teal' : r.roi >= 1 ? 'orange' : 'red'}>{r.roi.toFixed(1)} lần</Chip> : <span className="text-xs text-[#94A3B8]">—</span>}</td>
          </tr>
        ))}
      </Table>
      <p className="mt-3 text-xs text-[#94A3B8]">Chi phí lấy từ Cài đặt &gt; Ngân sách Marketing (hạng mục gắn kênh lead). Giá trị chốt lấy theo BOQ bóc tách, chưa có BOQ thì theo ước tính. Quỹ MDF / CS của 3M không tính vào chi phí Marketing.</p>
    </Panel>
  );
}

// =====================================================================
//  PHÂN HỆ 8: CÀI ĐẶT & CẤU HÌNH HỆ THỐNG
// =====================================================================

// =====================================================================
//  CÀI ĐẶT: PHÂN HỆ SỬ DỤNG (gói theo mô hình doanh nghiệp)
// =====================================================================

function BusinessModulesPanel() {
  const { company, setCompany, notify, audit, org } = useApp();
  /** Gói phân hệ do nền tảng 3A Group cố định theo doanh nghiệp, không đổi tại đây */
  const canEdit = false;
  const profile = company.profile ?? 'TRADING';
  const optional = MODULES.filter((m) => !CORE_MODULES.includes(m));
  const pick = (p: BusinessProfile) => {
    setCompany((c) => ({ ...c, profile: p, enabledModules: p === 'CUSTOM' ? Object.fromEntries(optional.map((m) => [m, moduleEnabled(c, m)])) : c.enabledModules }));
    audit('MODULES_PROFILE', `Đổi gói phân hệ sang "${BUSINESS_PROFILE[p].label}"`, 'WARN');
    notify(`Đã áp dụng gói "${BUSINESS_PROFILE[p].label}". Dữ liệu các phân hệ đang tắt vẫn được giữ nguyên.`, 'teal');
  };
  const toggle = (m: Module) => setCompany((c) => ({ ...c, profile: 'CUSTOM', enabledModules: { ...Object.fromEntries(optional.map((x) => [x, moduleEnabled(c, x)])), [m]: !moduleEnabled(c, m) } }));
  const shared: Module[] = ['leads', 'customers', 'staff', 'docs', 'reports'];
  return (
    <Panel title="Phân hệ sử dụng">
      <p className="mb-3 flex items-start gap-2 rounded border border-[#F28C33]/30 bg-[#F28C33]/5 px-3 py-2 text-sm text-[#F7B23B]"><Lock className="mt-0.5 h-4 w-4 shrink-0" aria-hidden />{org.shortName} dùng gói "{BUSINESS_PROFILE[org.profile].label}", do nền tảng 3A Group cố định: {org.profile === 'TRADING' ? 'ẩn hoàn toàn các phân hệ xưởng' : 'ẩn hoàn toàn các phân hệ quỹ Hãng'}. Dữ liệu hai doanh nghiệp lưu tách riêng.</p>
      <div className="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-4">
        {(Object.keys(BUSINESS_PROFILE) as BusinessProfile[]).filter((p) => p === profile).map((p) => (
          <button key={p} disabled={!canEdit} onClick={() => pick(p)} className={cn('rounded-md border p-3 text-left transition-colors disabled:opacity-60', profile === p ? 'border-[#F28C33] bg-[#F28C33]/10' : 'border-[#263044] hover:bg-[#1C2534]')}>
            <p className="flex items-center gap-2 text-sm font-semibold">{profile === p && <CheckCircle2 className="h-4 w-4 text-[#F28C33]" aria-hidden />}{BUSINESS_PROFILE[p].label}</p>
            <p className="mt-1 text-xs text-[#94A3B8]">{BUSINESS_PROFILE[p].desc}</p>
          </button>
        ))}
      </div>
      <div className="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
        {[
          { title: 'Dùng chung', list: [...CORE_MODULES, ...shared] },
          { title: 'Thương mại & phân phối', list: ['projects', 'products', 'supply', 'claims'] as Module[] },
          { title: 'Sản xuất & lắp đặt', list: ['jobs', 'production', 'install', 'inventory'] as Module[] },
          { title: 'Kế toán', list: ['cashbook'] as Module[] },
        ].map((g) => (
          <div key={g.title} className="rounded-md border border-[#263044] p-3">
            <p className="mb-2 text-xs font-semibold uppercase tracking-wide text-[#94A3B8]">{g.title}</p>
            <ul className="space-y-1">
              {g.list.map((m) => {
                const Icon = MODULE_ICON[m];
                const on = moduleEnabled(company, m);
                const core = CORE_MODULES.includes(m);
                return (
                  <li key={m}>
                    <label className={cn('flex items-center gap-2 rounded px-2 py-1.5 text-sm', !core && canEdit && 'cursor-pointer hover:bg-[#1C2534]')}>
                      <input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={on} disabled={core || !canEdit} onChange={() => toggle(m)} />
                      <Icon className={cn('h-4 w-4', on ? 'text-[#F28C33]' : 'text-[#94A3B8]')} aria-hidden />
                      <span className={on ? '' : 'text-[#94A3B8]'}>{MODULE_LABEL[m]}</span>
                      {core && <span className="ml-auto text-[10px] text-[#94A3B8]">luôn bật</span>}
                    </label>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </Panel>
  );
}

// =====================================================================
//  CÀI ĐẶT: DỮ LIỆU & BẢO MẬT
// =====================================================================

const AUDIT_LABEL: Record<string, string> = {
  LOGIN: 'Đăng nhập', LOGIN_FAIL: 'Đăng nhập thất bại', ACCOUNT_LOCKED: 'Khóa tài khoản', LOGOUT: 'Đăng xuất', IDLE_LOGOUT: 'Tự đăng xuất',
  ROLE_SWITCH: 'Chuyển vai trò', PASSWORD_CHANGE: 'Đổi mật khẩu', PASSWORD_CHANGE_FAIL: 'Đổi mật khẩu thất bại', PASSWORD_RESET: 'Đặt lại mật khẩu', USER_CREATE: 'Tạo tài khoản',
  APPROVAL_APPROVED: 'Duyệt', APPROVAL_REJECTED: 'Từ chối', APPROVAL_NEED_INFO: 'Yêu cầu bổ sung',
  DATA_EXPORT: 'Sao lưu dữ liệu', DATA_IMPORT: 'Nhập dữ liệu', DATA_RESTORE: 'Khôi phục bản chụp', DATA_RESET: 'Xóa dữ liệu trên máy',
  SECURITY_POLICY: 'Đổi chính sách bảo mật', MODULES_PROFILE: 'Đổi gói phân hệ',
};

function SecurityDataSettings() {
  const { security, setSecurity, auditLogs, users, userName, canDo, notify, audit, dataInfo, exportData, importData, restoreSnapshot, company, org, platform } = useApp();
  const canSec = canDo('security.manage');
  // Nhật ký hệ thống: chỉ tài khoản quản trị nền tảng 3A Group được xem
  const is3A = !!platform.userId;
  const canData = canDo('data.backup');
  const [p, setP] = useState(security);
  const [pass, setPass] = useState('');
  const [pass2, setPass2] = useState('');
  const [busy, setBusy] = useState(false);
  const [importFile, setImportFile] = useState<{ name: string; raw: AnyRec } | null>(null);
  const [importPass, setImportPass] = useState('');
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const [lv, setLv] = useState<'ALL' | AuditLevel>('ALL');
  const logs = auditLogs.filter((x) => lv === 'ALL' || x.level === lv);
  const paged = usePaged(logs, 12);
  const weak = users.filter((u) => u.active && (CLOUD_ON ? !!u.mustChangePassword : !u.passwordHash || u.mustChangePassword));
  const locked = users.filter((u) => u.lockedUntil && u.lockedUntil > Date.now());
  const fails24 = auditLogs.filter((x) => (x.action === 'LOGIN_FAIL' || x.action === 'ACCOUNT_LOCKED') && x.at > Date.now() - 864e5).length;

  const savePolicy = () => {
    if (p.minPasswordLength < 8 || p.minPasswordLength > 64) return notify('Độ dài mật khẩu tối thiểu từ 8 đến 64', 'red');
    if (p.lockoutAttempts < 3 || p.lockoutAttempts > 20) return notify('Số lần sai từ 3 đến 20', 'red');
    if (p.idleMinutes < 5 || p.idleMinutes > 480) return notify('Thời gian tự đăng xuất từ 5 đến 480 phút', 'red');
    setSecurity(p);
    audit('SECURITY_POLICY', `Mật khẩu ≥${p.minPasswordLength}, khóa sau ${p.lockoutAttempts} lần / ${p.lockoutMinutes} phút, tự đăng xuất ${p.idleMinutes} phút, phiên ${p.sessionDays} ngày, chuyển vai trò ${p.roleSwitch ? 'bật' : 'tắt'}`, 'SECURITY');
    notify('Đã lưu chính sách bảo mật', 'teal');
  };
  const download = (name: string, text: string) => {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
    a.download = name;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  };
  const doExport = async () => {
    if (pass.length < 10) return notify('Mật khẩu bản sao lưu tối thiểu 10 ký tự', 'red');
    if (pass !== pass2) return notify('Nhập lại mật khẩu không khớp', 'red');
    setBusy(true);
    try {
      const enc = await encryptBackup({ v: DATA_VERSION, org: org.id, data: exportData() }, pass, DATA_VERSION);
      download(`${(company.shortName || 'crm').toLowerCase()}-saoluu-v${DATA_VERSION}-${todayISO()}.json`, JSON.stringify(enc));
      audit('DATA_EXPORT', `Sao lưu mã hóa AES-GCM, phiên bản ${DATA_VERSION}`, 'SECURITY');
      notify('Đã tải bản sao lưu đã mã hóa. Cất mật khẩu riêng, mất mật khẩu sẽ không mở được file.', 'teal');
      setPass(''); setPass2('');
    } catch (e) {
      notify(e instanceof Error ? e.message : 'Không tạo được bản sao lưu', 'red');
    } finally { setBusy(false); }
  };
  const pickImport = async (files: File[]) => {
    try {
      const raw = JSON.parse(await files[0].text()) as AnyRec;
      if (raw.format !== 'vassh-backup') return notify('File không phải bản sao lưu của hệ thống', 'red');
      if ((raw.v ?? 0) > DATA_VERSION) return notify(`Bản sao lưu thuộc phiên bản ${raw.v}, mới hơn app (${DATA_VERSION}). Cập nhật app trước khi nhập.`, 'red');
      setImportFile({ name: files[0].name, raw });
    } catch { notify('Không đọc được file', 'red'); }
  };
  const doImport = async () => {
    if (!importFile) return;
    setBusy(true);
    try {
      const plain = await decryptBackup(importFile.raw as EncryptedBackup, importPass);
      if ((plain.org ?? ORGS[0].id) !== org.id) { notify(`Bản sao lưu thuộc doanh nghiệp ${orgOf(String(plain.org ?? ORGS[0].id)).shortName}, không nhập vào ${org.shortName} được`, 'red'); return; }
      setConfirm({
        title: 'Nhập bản sao lưu',
        message: <>Thay toàn bộ dữ liệu trên máy bằng bản sao lưu <b>{importFile.name}</b> (phiên bản {plain.v})? Dữ liệu hiện tại được chụp lại trước, khôi phục được ở mục Bản chụp tự động.</>,
        onConfirm: () => { importData((plain.data ?? {}) as Record<string, unknown>, Number(plain.v ?? 0)); setImportFile(null); setImportPass(''); notify('Đã nhập bản sao lưu', 'teal'); },
      });
    } catch (e) {
      audit('DATA_IMPORT_FAIL', `Mở bản sao lưu ${importFile.name} thất bại`, 'SECURITY');
      notify(e instanceof Error ? e.message : 'Không mở được bản sao lưu', 'red');
    } finally { setBusy(false); }
  };
  const resetLocal = () => setConfirm({
    title: 'Xóa dữ liệu trên máy này',
    message: 'Xóa toàn bộ dữ liệu app lưu trên trình duyệt này (đã tự chụp một bản trước khi xóa) và tải lại trang?',
    onConfirm: () => { takeSnapshot(org.id, 'truoc-khi-xoa'); audit('DATA_RESET', `Xóa dữ liệu ${org.shortName} trên máy`, 'SECURITY'); storage.del(dataKey(org.id)); storage.del(SESSION_KEY); setTimeout(() => window.location.reload(), 300); },
  });

  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Phiên bản dữ liệu" value={`v${dataInfo.version}`} icon={Database} color={C.blue} sub={dataInfo.savedAt ? `Lưu lúc ${new Date(dataInfo.savedAt).toLocaleTimeString('vi-VN')}` : 'Chưa lưu'} />
        {CLOUD_ON ? <StatCard label="Lưu trữ" value="Máy chủ" icon={HardDrive} color={C.teal} sub="Supabase; tải bản sao lưu hằng tuần" /> : <StatCard label="Dung lượng" value={`${(dataInfo.bytes / 1024 / 1024).toFixed(2)} MB`} icon={HardDrive} color={dataInfo.bytes > 4 * 1024 * 1024 ? C.red : C.teal} sub="Giới hạn trình duyệt ~5 MB" />}
        <StatCard label="Mật khẩu yếu / tạm" value={String(weak.length)} icon={KeyRound} color={weak.length ? C.orange : C.teal} sub={locked.length ? `${locked.length} tài khoản đang bị khóa` : 'Không có tài khoản bị khóa'} />
        <StatCard label="Đăng nhập lỗi 24h" value={String(fails24)} icon={ShieldCheck} color={fails24 > 5 ? C.red : C.teal} sub="Sai mật khẩu / khóa tài khoản" />
      </div>

      <Collapse title="Sao lưu & khôi phục" summary="Tự lưu trên máy, chụp bản trước mỗi lần nâng cấp, sao lưu ra file có mã hóa" defaultOpen>
        <div className="grid grid-cols-1 gap-5 lg:grid-cols-2">
          <div className="space-y-3">
            <p className="text-sm font-semibold">Tải bản sao lưu dữ liệu {org.shortName} (mã hóa AES-256-GCM)</p>
            <p className="text-xs text-[#94A3B8]">Nên sao lưu trước khi dán bản app mới. Khóa bí mật tích hợp (API Key Getfly, mật khẩu SMTP, secret ZNS) không nằm trong bản sao lưu.</p>
            <div className="grid grid-cols-1 gap-2 sm:grid-cols-2">
              <input className={inputCls} type="password" autoComplete="new-password" disabled={!canData} value={pass} onChange={(e) => setPass(e.target.value)} placeholder="Mật khẩu file (≥10 ký tự)" />
              <input className={inputCls} type="password" autoComplete="new-password" disabled={!canData} value={pass2} onChange={(e) => setPass2(e.target.value)} placeholder="Nhập lại" />
            </div>
            <button className={btnPrimary} disabled={!canData || busy} onClick={() => void doExport()}><Download className="h-4 w-4" aria-hidden />Tải bản sao lưu</button>
          </div>
          <div className="space-y-3">
            <p className="text-sm font-semibold">Nhập bản sao lưu</p>
            {importFile ? (
              <div className="space-y-2">
                <p className="text-xs text-[#94A3B8]">{importFile.name}, phiên bản {String(importFile.raw.v)}, tạo {new Date(Number(importFile.raw.exportedAt)).toLocaleString('vi-VN')}</p>
                <input className={inputCls} type="password" autoComplete="off" value={importPass} onChange={(e) => setImportPass(e.target.value)} placeholder="Mật khẩu file" />
                <div className="flex gap-2"><button className={btnPrimary} disabled={busy || !importPass} onClick={() => void doImport()}>Mở & nhập</button><button className={btnGhost} onClick={() => setImportFile(null)}>Hủy</button></div>
              </div>
            ) : (
              <FilePicker accept=".json,application/json" disabled={!canData} onFiles={(f) => void pickImport(f)} className={cn(btnGhost, 'inline-flex')}><Upload className="h-4 w-4" aria-hidden />Chọn file sao lưu</FilePicker>
            )}
            {CLOUD_ON ? <p className="pt-2 text-xs text-[#94A3B8]">Chế độ máy chủ: nhập bản sao lưu sẽ ghi đè dữ liệu {org.shortName} trên máy chủ cho mọi người. Nên tải bản sao lưu mã hóa hằng tuần (sao lưu tự động của Supabase tùy gói đang dùng).</p> : <>
            <p className="pt-2 text-sm font-semibold">Bản chụp tự động trên máy</p>
            <ul className="space-y-1.5">
              {dataInfo.snapshots.map((x) => (
                <li key={x.key} className="flex items-center gap-2 rounded bg-[#1C2534] px-3 py-2 text-xs">
                  <History className="h-3.5 w-3.5 text-[#94A3B8]" aria-hidden />
                  <span className="flex-1">{new Date(x.at).toLocaleString('vi-VN')}, dữ liệu v{x.version}</span>
                  <button className="text-[#6FA8F0] hover:underline disabled:opacity-50" disabled={!canData} onClick={() => setConfirm({ title: 'Khôi phục bản chụp', message: `Khôi phục dữ liệu lúc ${new Date(x.at).toLocaleString('vi-VN')}? Dữ liệu hiện tại được chụp lại trước.`, onConfirm: () => restoreSnapshot(x.key) })}>Khôi phục</button>
                </li>
              ))}
              {!dataInfo.snapshots.length && <li className="text-xs text-[#94A3B8]">Chưa có. App tự chụp trước khi nâng cấp dữ liệu, nhập sao lưu hoặc khôi phục (giữ {SNAP_KEEP} bản gần nhất).</li>}
            </ul>
            <button className={cn(btnGhost, btnSm, 'text-[#F87171]')} disabled={!canData} onClick={resetLocal}><Trash2 className="h-3.5 w-3.5" aria-hidden />Xóa dữ liệu trên máy này</button>
            </>}
          </div>
        </div>
      </Collapse>

      <Collapse title="Chính sách bảo mật" summary={`Mật khẩu ≥${security.minPasswordLength} ký tự, khóa sau ${security.lockoutAttempts} lần sai, tự đăng xuất ${security.idleMinutes} phút`} action={<button className={cn(btnPrimary, btnSm)} disabled={!canSec} onClick={savePolicy}>Lưu</button>}>
        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
          <Field label="Độ dài mật khẩu tối thiểu"><input className={inputCls} type="number" disabled={!canSec} value={p.minPasswordLength} onChange={(e) => setP({ ...p, minPasswordLength: Number(e.target.value) })} /></Field>
          <Field label="Khóa sau số lần sai"><input className={inputCls} type="number" disabled={!canSec} value={p.lockoutAttempts} onChange={(e) => setP({ ...p, lockoutAttempts: Number(e.target.value) })} /></Field>
          <Field label="Thời gian khóa (phút)"><input className={inputCls} type="number" disabled={!canSec} value={p.lockoutMinutes} onChange={(e) => setP({ ...p, lockoutMinutes: Number(e.target.value) })} /></Field>
          <Field label="Tự đăng xuất (phút)"><input className={inputCls} type="number" disabled={!canSec} value={p.idleMinutes} onChange={(e) => setP({ ...p, idleMinutes: Number(e.target.value) })} /></Field>
          <Field label="Ghi nhớ đăng nhập (ngày)"><input className={inputCls} type="number" min={1} max={30} disabled={!canSec} value={p.sessionDays} onChange={(e) => setP({ ...p, sessionDays: Number(e.target.value) })} /></Field>
        </div>
        <div className="mt-3 space-y-2 text-sm">
          <label className="flex items-center gap-2"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canSec} checked={p.forceChangeDefault} onChange={(e) => setP({ ...p, forceChangeDefault: e.target.checked })} />Bắt đổi mật khẩu khi đăng nhập bằng mật khẩu mặc định / tạm</label>
          <label className="flex items-center gap-2"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canSec} checked={p.roleSwitch} onChange={(e) => setP({ ...p, roleSwitch: e.target.checked })} />Cho phép Ban Giám đốc chuyển vai trò để xem thử (tắt khi chạy thật)</label>
        </div>
        {weak.length > 0 && <p className="mt-3 rounded bg-[#F28C33]/10 p-3 text-xs text-[#F7B23B]">{weak.length} tài khoản chưa đặt mật khẩu riêng: {weak.slice(0, 6).map((u) => u.name).join(', ')}{weak.length > 6 ? '...' : ''}. Họ sẽ phải đổi ở lần đăng nhập tới.</p>}
      </Collapse>

      {is3A && <Panel title={`Nhật ký hệ thống (${auditLogs.length}) · chỉ 3A Group`} action={
        <select className={cn(inputBase, 'w-auto py-1.5 text-xs')} value={lv} onChange={(e) => setLv(e.target.value as 'ALL' | AuditLevel)} aria-label="Mức độ">
          <option value="ALL">Mọi mức</option><option value="SECURITY">Bảo mật</option><option value="WARN">Cảnh báo</option><option value="INFO">Thông tin</option>
        </select>
      }>
        <>
            <Table head={['Thời gian', 'Người thực hiện', 'Thao tác', 'Chi tiết']} minW={720}>
              {paged.slice.map((x) => (
                <tr key={x.id} className={rowCls}>
                  <td className={cn(tdFirst, 'whitespace-nowrap text-xs tabular-nums')}>{new Date(x.at).toLocaleString('vi-VN')}</td>
                  <td className={cn(tdCls, 'text-xs')}>{x.userId ? userName(x.userId) : 'Chưa đăng nhập'}</td>
                  <td className={tdCls}><Chip tone={x.level === 'SECURITY' ? 'red' : x.level === 'WARN' ? 'orange' : 'muted'}>{AUDIT_LABEL[x.action] ?? x.action}</Chip></td>
                  <td className={cn(tdLast, 'text-xs text-[#94A3B8]')}>{x.detail}</td>
                </tr>
              ))}
            </Table>
            {!logs.length && <EmptyState text={<>Chưa có sự kiện.</>} art="doc" />}
            <Pagination paged={paged} unit="sự kiện" />
        </>
      </Panel>}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

type SettingsTab = 'platform' | 'company' | 'org' | 'fund' | 'mkt' | 'segments' | 'pricing' | 'accounting' | 'getfly' | 'email' | 'zns' | 'security';

function SettingsModule() {
  const { canDo, company, platform, org } = useApp();
  const [tab, setTab] = useState<SettingsTab>('org');
  const mode = bizMode(company);
  // Tích hợp do 3A cấp phép theo hợp đồng: tắt ở Console thì ẩn tab cấu hình tương ứng
  const feat = platform.tenants.find((t) => t.id === org.id)?.features;
  const all: { id: SettingsTab; label: string; show: boolean }[] = [
    { id: 'company', label: 'Doanh nghiệp', show: true },
    { id: 'org', label: 'Phòng ban & Nhân sự', show: true },
    { id: 'pricing', label: 'Bảng đơn giá & thanh toán', show: mode !== 'TRADING' },
    { id: 'accounting', label: 'Kế toán & công nợ', show: true },
    { id: 'fund', label: 'Quỹ Hãng 3M', show: mode !== 'MFG' },
    { id: 'mkt', label: 'Ngân sách Marketing', show: true },
    { id: 'segments', label: mode === 'MFG' ? 'Loại & nguồn khách' : 'Phân loại khách hàng', show: true },
    { id: 'getfly', label: 'Getfly API', show: mode !== 'MFG' && feat?.getfly !== false },
    { id: 'email', label: 'Email SMTP', show: feat?.smtp !== false },
    { id: 'zns', label: 'Zalo ZNS', show: feat?.zns !== false },
    { id: 'security', label: 'Dữ liệu & bảo mật', show: true },
  ];
  const tabs = all.filter((x) => x.show);
  const cur = tabs.some((x) => x.id === tab) ? tab : 'org';
  return (
    <div className="flex flex-col gap-5 lg:flex-row lg:items-start">
      {/* Điều hướng dọc: danh sách mục cài đặt (màn nhỏ: ô chọn) */}
      <nav aria-label="Mục cài đặt" className="lg:sticky lg:top-20 lg:w-56 lg:shrink-0">
        <select className={cn(inputBase, 'lg:hidden')} value={cur} onChange={(e) => setTab(e.target.value as SettingsTab)} aria-label="Mục cài đặt">
          {tabs.map((x) => <option key={x.id} value={x.id}>{x.label}</option>)}
        </select>
        <ul className="hidden rounded-md border border-[#263044] bg-[#151C29] p-1.5 lg:block">
          {tabs.map((x) => (
            <li key={x.id}>
              <button
                className={cn('flex w-full items-center rounded border-l-2 px-3 py-2 text-left text-sm transition-colors', cur === x.id ? 'border-[#F28C33] bg-[#F28C33]/10 font-semibold text-[#F1F5F9]' : 'border-transparent text-[#94A3B8] hover:bg-[#1C2534] hover:text-[#F1F5F9]')}
                aria-current={cur === x.id ? 'page' : undefined}
                onClick={() => setTab(x.id)}
              >{x.label}</button>
            </li>
          ))}
        </ul>
      </nav>
      <div className="min-w-0 flex-1 space-y-5">
      {!canDo('settings.edit') && (
        <p className="flex items-center gap-2 rounded border border-[#263044] bg-[#1C2534] px-4 py-3 text-sm text-[#94A3B8]"><Lock className="h-4 w-4" aria-hidden />Chế độ chỉ xem. Chỉ Giám đốc BOD được sửa cấu hình (trừ ngân sách Marketing).</p>
      )}
      {cur === 'company' && <><CompanySettings /><BusinessModulesPanel /><DemoDataPanel /></>}
      {cur === 'security' && <SecurityDataSettings />}
      {cur === 'org' && <OrgSettings />}
      {cur === 'pricing' && <PricingSettings />}
      {cur === 'accounting' && <AccountingSettings />}

      {cur === 'fund' && <FundSettings />}
      {cur === 'mkt' && <MarketingBudgetSettings />}
      {cur === 'segments' && <SegmentSettings />}
      {cur === 'getfly' && <GetflySettings />}
      {cur === 'email' && <EmailSettings />}
      {cur === 'zns' && <ZnsSettings />}
      </div>
    </div>
  );
}

// ---------------- Kế toán & công nợ ----------------

function AccountingSettings() {
  const { mfgConfig, setMfgConfig, canDo, company, audit, notify } = useApp();
  const mode = bizMode(company);
  const can = canDo('settings.edit') || canDo('cash.manage');
  const [f, setF] = useState(mfgConfig);
  const num = (k: keyof MfgConfig, v: string, min = 0) => setF({ ...f, [k]: Math.max(min, Number(v) || 0) });
  const save = () => {
    setMfgConfig((c) => ({ ...c, agingScheme: f.agingScheme ?? 'AGE_30_60', creditDays: f.creditDays, dueDays: f.dueDays, salesCommissionPct: f.salesCommissionPct, installCommissionPct: f.installCommissionPct, openingCash: f.openingCash, openingBank: f.openingBank }));
    audit('ACCOUNTING_CONFIG', `Công nợ ${mode === 'MFG' ? f.dueDays : f.creditDays} ngày, hoa hồng ${f.salesCommissionPct}% + ${f.installCommissionPct}%, số dư đầu ${vnd(f.openingCash + f.openingBank)}`, 'WARN');
    notify('Đã lưu cấu hình kế toán', 'teal');
  };
  return (
    <Panel title="Kế toán & công nợ">
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {mode !== 'MFG' && <Field label="Số ngày công nợ mặc định (thương mại)" hint="Dùng khi khách chưa có hợp đồng ghi số ngày công nợ"><input className={inputCls} type="number" min={0} disabled={!can} value={f.creditDays} onChange={(e) => num('creditDays', e.target.value)} /></Field>}
        {mode !== 'TRADING' && <Field label="Hạn thanh toán sau mốc (ngày)" hint="Cọc, giao hàng, nghiệm thu: quá số ngày này tính vào tuổi nợ"><input className={inputCls} type="number" min={0} disabled={!can} value={f.dueDays} onChange={(e) => num('dueDays', e.target.value)} /></Field>}
        {mode !== 'TRADING' && <Field label="Hoa hồng sales / kỹ thuật (%)" hint="Trên giá trị hợp đồng trước VAT"><input className={inputCls} type="number" min={0} max={30} step={0.1} disabled={!can} value={f.salesCommissionPct} onChange={(e) => num('salesCommissionPct', e.target.value)} /></Field>}
        {mode !== 'TRADING' && <Field label="Hoa hồng đội lắp đặt (%)" hint="Chia đều đội trưởng và thành viên lắp đơn"><input className={inputCls} type="number" min={0} max={30} step={0.1} disabled={!can} value={f.installCommissionPct} onChange={(e) => num('installCommissionPct', e.target.value)} /></Field>}
        <Field label="Nhóm tuổi nợ (bảng theo dõi công nợ)" className="sm:col-span-2 xl:col-span-1" hint={AGING[f.agingScheme ?? 'AGE_30_60'].note}>
          <select className={inputCls} disabled={!can} value={f.agingScheme ?? 'AGE_30_60'} onChange={(e) => setF({ ...f, agingScheme: e.target.value as AgingScheme })}>
            {(Object.keys(AGING) as AgingScheme[]).map((k) => <option key={k} value={k}>{AGING[k].label}</option>)}
          </select>
        </Field>
        <Field label="Số dư đầu quỹ tiền mặt"><MoneyInput value={f.openingCash} disabled={!can} onChange={(n) => setF({ ...f, openingCash: n })} /></Field>
        <Field label="Số dư đầu tài khoản ngân hàng"><MoneyInput value={f.openingBank} disabled={!can} onChange={(n) => setF({ ...f, openingBank: n })} /></Field>
      </div>
      <div className="mt-4 flex gap-2"><button className={btnPrimary} disabled={!can} onClick={save}>Lưu cấu hình</button><button className={btnGhost} onClick={() => setF(mfgConfig)}>Hoàn tác</button></div>
      <p className="mt-3 text-xs text-[#94A3B8]">Phiếu thu / chi tự sinh: thu tiền khách khi kế toán xác nhận phiếu thu; chi công tác phí, chi triển khai sự kiện khi kế toán xác nhận thanh toán; chi hoa hồng khi quyết toán; thu thặng dư quỹ MDF khi hạch toán.</p>
    </Panel>
  );
}

// =====================================================================
//  3A PLATFORM CONSOLE — quản trị nền tảng: doanh nghiệp, cấp phép module, dữ liệu & nâng cấp an toàn
//  Chỉ tài khoản @3agroup.vn. Mỗi doanh nghiệp một khóa lưu riêng, thao tác trên bên này không chạm bên kia.
// =====================================================================

type ConsoleTab = 'tenants' | 'modules' | 'data' | 'admins';
const CONSOLE_TABS: { id: ConsoleTab; label: string; icon: typeof Wallet; desc: string }[] = [
  { id: 'tenants', label: 'Doanh nghiệp', icon: Building2, desc: 'Gói bản quyền, hợp đồng, trạng thái, truy cập hỗ trợ' },
  { id: 'modules', label: 'Cấp phép module', icon: SlidersHorizontal, desc: 'Bật / tắt module theo hợp đồng từng doanh nghiệp' },
  { id: 'data', label: 'Dữ liệu & nâng cấp', icon: Database, desc: 'Khóa lưu, phiên bản dữ liệu, sao lưu, nâng cấp, snapshot' },
  { id: 'admins', label: 'Quản trị nền tảng', icon: ShieldCheck, desc: 'Tài khoản @3agroup.vn và nhật ký nền tảng' },
];
const MODULE_GROUP: { title: string; list: Module[] }[] = [
  { title: 'Vận hành bán hàng', list: ['leads', 'customers', 'projects', 'jobs', 'staff'] },
  { title: 'Chuỗi cung ứng & xưởng', list: ['products', 'supply', 'production', 'install', 'inventory'] },
  { title: 'Kế toán tài chính', list: ['cashbook', 'claims', 'reports'] },
  { title: 'Hệ thống', list: ['docs'] },
];
const daysTo = (iso10: string) => Math.ceil((Date.parse(`${iso10}T23:59:59`) - Date.now()) / 864e5);

function Switch({ on, onChange, label, disabled }: { on: boolean; onChange: (v: boolean) => void; label: string; disabled?: boolean }) {
  return (
    <button type="button" role="switch" aria-checked={on} aria-label={label} disabled={disabled} onClick={() => onChange(!on)}
      className={cn('relative inline-flex h-6 w-11 shrink-0 items-center rounded-full transition-colors disabled:opacity-40', on ? 'bg-[#00B894]' : 'bg-[#263044]')}>
      <span className={cn('inline-block h-5 w-5 rounded-full bg-white shadow transition-transform', on ? 'translate-x-[22px]' : 'translate-x-0.5')} />
    </button>
  );
}

function PlatformConsole() {
  const { platform } = useApp();
  const tab = platform.consoleTab;
  const meta = CONSOLE_TABS.find((t) => t.id === tab)!;
  return (
    <div className="space-y-5">
      <div className="flex flex-wrap items-center gap-3 rounded-md border border-[#F28C33]/30 bg-gradient-to-r from-[#F28C33]/10 to-transparent px-4 py-3">
        <Globe className="h-6 w-6 text-[#F28C33]" aria-hidden />
        <div className="min-w-0 flex-1"><p className="font-semibold">3A Platform Console · {meta.label}</p><p className="text-xs text-[#94A3B8]">{meta.desc}</p></div>
        <Tabs variant="pill" tabs={CONSOLE_TABS.map((t) => ({ id: t.id, label: t.label }))} value={tab} onChange={platform.setConsoleTab} />
      </div>
      {tab === 'tenants' && <ConsoleTenants />}
      {tab === 'modules' && <ConsoleModules />}
      {tab === 'data' && <ConsoleData />}
      {tab === 'admins' && <ConsoleAdmins />}
    </div>
  );
}

function ConsoleTenants() {
  const { platform, org } = useApp();
  const [edit, setEdit] = useState<TenantReg | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  return (
    <div className="space-y-4">
      <div className="grid grid-cols-1 gap-4 xl:grid-cols-2">
        {ORGS.map((o) => {
          const r = platform.tenants.find((x) => x.id === o.id) ?? defaultTenantReg(o);
          const st = tenantStats(o.id);
          const left = daysTo(r.contractEnd);
          const on = PROVISION_MODULES.filter((m) => r.modules[m]).length;
          return (
            <section key={o.id} className={cn('rounded-md border bg-[#151C29] p-5', r.status === 'SUSPENDED' ? 'border-[#EF4444]/50' : 'border-[#263044]')}>
              <div className="flex items-start gap-3">
                <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-md text-[#0F141E]" style={{ background: o.color }}>{o.profile === 'MANUFACTURING' ? <Factory className="h-6 w-6" aria-hidden /> : <Building2 className="h-6 w-6" aria-hidden />}</span>
                <div className="min-w-0 flex-1">
                  <p className="text-lg font-semibold">{o.name}</p>
                  <p className="text-xs text-[#94A3B8]">{o.profile === 'MANUFACTURING' ? 'Xưởng nội thất, nhôm kính: báo giá m² / md, lệnh sản xuất, lắp đặt, thu tiền' : 'Thương mại B2B, đối tác Hãng 3M: quỹ MDF, PO Hãng, BOQ, Getfly'} · @{o.domain}</p>
                </div>
                <Chip tone={r.status === 'ACTIVE' ? 'teal' : 'red'}>{r.status === 'ACTIVE' ? 'Hoạt động' : 'Tạm dừng'}</Chip>
              </div>
              <dl className="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
                <div className="rounded bg-[#1C2534] p-2.5"><dt className="text-[11px] text-[#94A3B8]">Gói bản quyền</dt><dd className="font-semibold">{TENANT_PLAN[r.plan].label}</dd></div>
                <div className="rounded bg-[#1C2534] p-2.5"><dt className="text-[11px] text-[#94A3B8]">Người dùng kích hoạt</dt><dd className={cn('font-semibold tabular-nums', st.activeUsers > r.seats && 'text-[#F87171]')}>{st.activeUsers} / {r.seats}</dd></div>
                <div className="rounded bg-[#1C2534] p-2.5"><dt className="text-[11px] text-[#94A3B8]">Hết hạn hợp đồng</dt><dd className={cn('font-semibold tabular-nums', left < 0 ? 'text-[#F87171]' : left <= 30 ? 'text-[#F7B23B]' : '')}>{fmtDate(r.contractEnd)}</dd><dd className="text-[11px] text-[#94A3B8]">{left < 0 ? `Quá hạn ${-left} ngày` : `Còn ${left} ngày`}</dd></div>
                <div className="rounded bg-[#1C2534] p-2.5"><dt className="text-[11px] text-[#94A3B8]">Module cấp phép</dt><dd className="font-semibold tabular-nums">{on} / {PROVISION_MODULES.length}</dd></div>
              </dl>
              <p className="mt-3 text-xs text-[#94A3B8]">{st.customers} khách hàng, {st.records} {o.profile === 'MANUFACTURING' ? 'đơn hàng' : 'lead / dự án'}, {(st.size / 1024).toFixed(0)} KB, dữ liệu v{st.version || '—'}{st.savedAt ? `, lưu ${new Date(st.savedAt).toLocaleString('vi-VN')}` : ''}</p>
              <div className="mt-4 flex flex-wrap gap-2">
                <button className={cn(btnPrimary, btnSm)} onClick={() => platform.switchTenant(o.id)}><LogIn className="h-3.5 w-3.5" aria-hidden />Truy cập hệ thống{org.id === o.id ? ' (đang mở)' : ''}</button>
                <button className={cn(btnGhost, btnSm)} onClick={() => setEdit(r)}><Pencil className="h-3.5 w-3.5" aria-hidden />Hợp đồng & gói</button>
                <button className={cn(btnGhost, btnSm)} onClick={() => { platform.setConsoleTab('modules'); }}><SlidersHorizontal className="h-3.5 w-3.5" aria-hidden />Cấp phép module</button>
                <button className={cn(btnBase, btnSm, r.status === 'ACTIVE' ? 'border border-[#EF4444]/40 text-[#F87171] hover:bg-[#EF4444]/10' : 'bg-[#00B894] font-semibold text-[#0F141E]')}
                  onClick={() => setConfirm({ title: r.status === 'ACTIVE' ? `Tạm dừng ${o.shortName}` : `Kích hoạt lại ${o.shortName}`, confirmLabel: r.status === 'ACTIVE' ? 'Tạm dừng' : 'Kích hoạt', message: r.status === 'ACTIVE' ? `Người dùng ${o.shortName} sẽ không đăng nhập được cho tới khi kích hoạt lại. Dữ liệu giữ nguyên; kỹ thuật 3A vẫn truy cập hỗ trợ được.` : `Cho phép người dùng ${o.shortName} đăng nhập lại.`, onConfirm: () => platform.setTenantReg(o.id, { status: r.status === 'ACTIVE' ? 'SUSPENDED' : 'ACTIVE' }, r.status === 'ACTIVE' ? 'Tạm dừng doanh nghiệp' : 'Kích hoạt lại doanh nghiệp') })}>
                  {r.status === 'ACTIVE' ? <><XCircle className="h-3.5 w-3.5" aria-hidden />Tạm dừng</> : <><CheckCircle2 className="h-3.5 w-3.5" aria-hidden />Kích hoạt</>}
                </button>
              </div>
            </section>
          );
        })}
      </div>
      {edit && (
        <Modal title={`Hợp đồng & gói: ${orgOf(edit.id).shortName}`} onClose={() => setEdit(null)} footer={<><button className={btnGhost} onClick={() => setEdit(null)}>Hủy</button><button className={btnPrimary} onClick={() => { platform.setTenantReg(edit.id, { plan: edit.plan, seats: edit.seats, contractStart: edit.contractStart, contractEnd: edit.contractEnd, note: edit.note }, `Gói ${TENANT_PLAN[edit.plan].label}, ${edit.seats} người dùng, hạn ${fmtDate(edit.contractEnd)}`); setEdit(null); }}>Lưu</button></>}>
          <div className="grid grid-cols-2 gap-3">
            <Field label="Gói bản quyền"><select className={inputCls} value={edit.plan} onChange={(e) => { const p = e.target.value as TenantPlan; setEdit({ ...edit, plan: p, seats: TENANT_PLAN[p].seats }); }}>{(Object.keys(TENANT_PLAN) as TenantPlan[]).map((p) => <option key={p} value={p}>{TENANT_PLAN[p].label} ({TENANT_PLAN[p].price})</option>)}</select></Field>
            <Field label="Số người dùng"><input className={inputCls} type="number" min={1} value={edit.seats} onChange={(e) => setEdit({ ...edit, seats: Math.max(1, Number(e.target.value) || 1) })} /></Field>
            <Field label="Bắt đầu hợp đồng"><input className={inputCls} type="date" value={edit.contractStart} onChange={(e) => setEdit({ ...edit, contractStart: e.target.value })} /></Field>
            <Field label="Hết hạn hợp đồng"><input className={inputCls} type="date" value={edit.contractEnd} onChange={(e) => setEdit({ ...edit, contractEnd: e.target.value })} /></Field>
            <Field label="Ghi chú" className="col-span-2"><input className={inputCls} value={edit.note ?? ''} onChange={(e) => setEdit({ ...edit, note: e.target.value })} /></Field>
          </div>
        </Modal>
      )}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

function ConsoleModules() {
  const { platform } = useApp();
  const toggle = (id: string, m: Module, on: boolean) => {
    const r = platform.tenants.find((x) => x.id === id)!;
    platform.setTenantReg(id, { modules: { ...r.modules, [m]: on } }, `${on ? 'Bật' : 'Tắt'} module ${MODULE_LABEL[m]}`);
  };
  const preset = (id: string) => {
    const o = orgOf(id);
    platform.setTenantReg(id, { modules: defaultTenantReg(o).modules }, `Áp dụng gói chuẩn ${BUSINESS_PROFILE[o.profile].label}`);
  };
  const feature = (id: string, k: keyof TenantReg['features'], on: boolean) => {
    const r = platform.tenants.find((x) => x.id === id)!;
    platform.setTenantReg(id, { features: { ...r.features, [k]: on } }, `${on ? 'Bật' : 'Tắt'} tích hợp ${k}`);
  };
  const FEATURE_LABEL: Record<keyof TenantReg['features'], string> = { getfly: 'Tích hợp Getfly CRM', zns: 'Zalo ZNS', smtp: 'Email SMTP' };
  return (
    <Panel>
      <div className="-mx-5 overflow-x-auto">
        <table className="w-full min-w-[720px] text-sm">
          <thead className="text-xs text-[#94A3B8]">
            <tr className="border-b border-[#263044]">
              <th className="py-3 pl-5 pr-3 text-left font-medium">Module / tính năng</th>
              {ORGS.map((o) => (
                <th key={o.id} className="w-56 px-3 py-3 text-center font-medium">
                  <span className="flex items-center justify-center gap-1.5 text-sm text-[#F1F5F9]"><i className="h-2 w-2 rounded-full" style={{ background: o.color }} />{o.shortName}</span>
                  <button className="mt-1 text-[11px] text-[#F7B23B] hover:underline" onClick={() => preset(o.id)}>Gói chuẩn {BUSINESS_PROFILE[o.profile].label.toLowerCase()}</button>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr className="border-b border-[#263044]/60 bg-[#1C2534]/40"><td className="py-2 pl-5 text-xs text-[#94A3B8]" colSpan={ORGS.length + 1}>Luôn bật: Tổng quan, Công việc, Cài đặt</td></tr>
            {MODULE_GROUP.map((g) => (
              <Fragment key={g.title}>
                <tr><td className="pb-1 pl-5 pt-4 text-[11px] font-semibold uppercase tracking-wide text-[#94A3B8]" colSpan={ORGS.length + 1}>{g.title}</td></tr>
                {g.list.map((m) => {
                  const Icon = MODULE_ICON[m];
                  return (
                    <tr key={m} className="border-b border-[#263044]/60 hover:bg-[#1C2534]/50">
                      <td className="py-2.5 pl-5 pr-3"><span className="flex items-center gap-2"><Icon className="h-4 w-4 text-[#94A3B8]" aria-hidden /><span><span className="block">{MODULE_LABEL[m]}</span><span className="block text-[11px] text-[#94A3B8]">{MODULE_DESC[m]}</span></span></span></td>
                      {ORGS.map((o) => { const r = platform.tenants.find((x) => x.id === o.id)!; const on = !!r.modules[m]; return <td key={o.id} className="px-3 py-2.5 text-center"><span className="inline-flex items-center gap-2"><Switch on={on} onChange={(v) => toggle(o.id, m, v)} label={`${MODULE_LABEL[m]} cho ${o.shortName}`} /><span className={cn('w-8 text-left text-xs', on ? 'text-[#3DDBB6]' : 'text-[#94A3B8]')}>{on ? 'Bật' : 'Tắt'}</span></span></td>; })}
                    </tr>
                  );
                })}
              </Fragment>
            ))}
            <tr><td className="pb-1 pl-5 pt-4 text-[11px] font-semibold uppercase tracking-wide text-[#94A3B8]" colSpan={ORGS.length + 1}>Tích hợp</td></tr>
            {(Object.keys(FEATURE_LABEL) as (keyof TenantReg['features'])[]).map((k) => (
              <tr key={k} className="border-b border-[#263044]/60 hover:bg-[#1C2534]/50">
                <td className="py-2.5 pl-5 pr-3"><span className="flex items-center gap-2"><Plug className="h-4 w-4 text-[#94A3B8]" aria-hidden />{FEATURE_LABEL[k]}</span></td>
                {ORGS.map((o) => { const r = platform.tenants.find((x) => x.id === o.id)!; const on = !!r.features[k]; return <td key={o.id} className="px-3 py-2.5 text-center"><span className="inline-flex items-center gap-2"><Switch on={on} onChange={(v) => feature(o.id, k, v)} label={`${FEATURE_LABEL[k]} cho ${o.shortName}`} /><span className={cn('w-8 text-left text-xs', on ? 'text-[#3DDBB6]' : 'text-[#94A3B8]')}>{on ? 'Bật' : 'Tắt'}</span></span></td>; })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p className="mt-3 text-xs text-[#94A3B8]">Lưu ngay khi bấm. Doanh nghiệp đang mở cập nhật menu tức thì; doanh nghiệp còn lại áp dụng ở lần mở kế tiếp. Tắt module chỉ ẩn khỏi menu, không xóa dữ liệu.</p>
    </Panel>
  );
}

function ConsoleData() {
  const { platform, notify } = useApp();
  const [backup, setBackup] = useState<string | null>(null);
  const [pass, setPass] = useState('');
  const [pass2, setPass2] = useState('');
  const [busy, setBusy] = useState(false);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const [, force] = useState(0);
  const doBackup = async () => {
    if (!backup) return;
    if (pass.length < 10) return notify('Mật khẩu bản sao lưu tối thiểu 10 ký tự', 'red');
    if (pass !== pass2) return notify('Nhập lại mật khẩu không khớp', 'red');
    setBusy(true);
    try { await platform.backupTenant(backup, pass); setBackup(null); setPass(''); setPass2(''); } catch (e) { notify(e instanceof Error ? e.message : 'Không sao lưu được', 'red'); } finally { setBusy(false); }
  };
  return (
    <div className="space-y-4">
      <div className="grid grid-cols-1 gap-4 xl:grid-cols-2">
        {ORGS.map((o) => {
          const r = platform.tenants.find((x) => x.id === o.id)!;
          const st = tenantStats(o.id);
          const snaps = listSnapshots(o.id);
          const outdated = st.version > 0 && st.version < DATA_VERSION;
          return (
            <section key={o.id} className="rounded-md border border-[#263044] bg-[#151C29] p-5">
              <p className="flex items-center gap-2 font-semibold"><i className="h-2.5 w-2.5 rounded-full" style={{ background: o.color }} />{o.name}</p>
              <dl className="mt-3 grid grid-cols-1 gap-x-4 gap-y-2 text-sm sm:grid-cols-2">
                <div><dt className="text-[11px] text-[#94A3B8]">Khóa lưu trữ</dt><dd className="font-mono text-xs">{dataKey(o.id)}</dd></div>
                <div><dt className="text-[11px] text-[#94A3B8]">Phiên bản dữ liệu</dt><dd className="flex items-center gap-2"><span className="font-semibold tabular-nums">v{st.version || '—'}</span>{st.version ? <Chip tone={outdated ? 'orange' : st.version > DATA_VERSION ? 'red' : 'teal'}>{outdated ? `Cần nâng cấp lên v${DATA_VERSION}` : st.version > DATA_VERSION ? 'Mới hơn app' : 'Mới nhất'}</Chip> : <Chip>Chưa có dữ liệu</Chip>}</dd></div>
                <div><dt className="text-[11px] text-[#94A3B8]">Dung lượng</dt><dd className="tabular-nums">{(st.size / 1024).toFixed(1)} KB</dd></div>
                <div><dt className="text-[11px] text-[#94A3B8]">Lưu gần nhất</dt><dd className="tabular-nums">{st.savedAt ? new Date(st.savedAt).toLocaleString('vi-VN') : '—'}</dd></div>
                <div><dt className="text-[11px] text-[#94A3B8]">Sao lưu gần nhất</dt><dd className={cn('tabular-nums', !r.lastBackupAt && 'text-[#F7B23B]')}>{r.lastBackupAt ? new Date(r.lastBackupAt).toLocaleString('vi-VN') : 'Chưa sao lưu'}</dd></div>
                <div><dt className="text-[11px] text-[#94A3B8]">Nâng cấp gần nhất</dt><dd className="tabular-nums">{r.lastMigrationAt ? new Date(r.lastMigrationAt).toLocaleString('vi-VN') : '—'}</dd></div>
              </dl>
              <div className="mt-4 flex flex-wrap gap-2">
                <button className={cn(btnGhost, btnSm)} disabled={!st.raw} onClick={() => setBackup(o.id)}><Download className="h-3.5 w-3.5" aria-hidden />Sao lưu độc lập</button>
                <button className={cn(btnPrimary, btnSm)} disabled={!st.raw || st.version > DATA_VERSION}
                  onClick={() => setConfirm({ title: `Nâng cấp dữ liệu ${o.shortName}`, confirmLabel: 'Nâng cấp', message: `Chạy nâng cấp cấu trúc dữ liệu ${o.shortName} từ v${st.version} lên v${DATA_VERSION}: chỉ bổ sung trường mới với giá trị mặc định, không xóa trường cũ. Hệ thống chụp snapshot trước khi ghi. Doanh nghiệp còn lại không bị ảnh hưởng.`, onConfirm: () => { platform.runMigration(o.id); force((x) => x + 1); } })}>
                  <RefreshCw className="h-3.5 w-3.5" aria-hidden />{outdated ? `Nâng cấp lên v${DATA_VERSION}` : 'Kiểm tra & bổ sung trường mới'}
                </button>
              </div>
              <div className="mt-4">
                <p className="mb-1.5 text-xs font-medium text-[#94A3B8]">Snapshot phục hồi ({snaps.length})</p>
                {snaps.length ? (
                  <ul className="space-y-1">
                    {snaps.map((x) => (
                      <li key={x.key} className="flex items-center justify-between gap-2 rounded bg-[#1C2534] px-3 py-1.5 text-xs">
                        <span className="tabular-nums">{new Date(x.at).toLocaleString('vi-VN')} · v{x.version} · {x.reason}</span>
                        <button className="text-[#F7B23B] hover:underline" onClick={() => setConfirm({ title: `Khôi phục ${o.shortName}`, confirmLabel: 'Khôi phục', message: `Khôi phục dữ liệu ${o.shortName} về lúc ${new Date(x.at).toLocaleString('vi-VN')}? Dữ liệu hiện tại được chụp lại trước.`, onConfirm: () => { platform.restoreTenantSnapshot(o.id, x.key); force((v) => v + 1); } })}>Khôi phục</button>
                      </li>
                    ))}
                  </ul>
                ) : <p className="text-xs text-[#94A3B8]">Chưa có snapshot. Snapshot tự chụp trước mỗi lần nâng cấp, nhập hoặc khôi phục.</p>}
              </div>
            </section>
          );
        })}
      </div>
      <Panel title="Nguyên tắc nâng cấp an toàn">
        <ul className="list-disc space-y-1 pl-5 text-sm text-[#94A3B8]">
          <li>Mỗi doanh nghiệp một khóa lưu riêng (<span className="font-mono">3a:tenant:vassh</span>, <span className="font-mono">3a:tenant:alux</span>) kèm số phiên bản dữ liệu.</li>
          <li>Bước nâng cấp chỉ thêm hoặc đổi tên trường, giá trị mới lấy mặc định; không xóa dữ liệu người dùng.</li>
          <li>Trước khi nâng cấp, nhập hoặc khôi phục luôn chụp snapshot (giữ {SNAP_KEEP} bản gần nhất mỗi doanh nghiệp).</li>
          <li>Dữ liệu mới hơn bản app sẽ bị khóa ghi để không ghi đè, cho tới khi cập nhật app.</li>
        </ul>
      </Panel>
      {backup && (
        <Modal title={`Sao lưu mã hóa ${orgOf(backup).shortName}`} onClose={() => setBackup(null)} footer={<><button className={btnGhost} onClick={() => setBackup(null)}>Hủy</button><button className={btnPrimary} disabled={busy} onClick={() => void doBackup()}>{busy ? 'Đang mã hóa...' : 'Tải bản sao lưu'}</button></>}>
          <div className="space-y-3">
            <Field label="Mật khẩu bản sao lưu" hint="Tối thiểu 10 ký tự. Mất mật khẩu sẽ không mở được file."><input className={inputCls} type="password" value={pass} onChange={(e) => setPass(e.target.value)} /></Field>
            <Field label="Nhập lại mật khẩu"><input className={inputCls} type="password" value={pass2} onChange={(e) => setPass2(e.target.value)} /></Field>
            <p className="text-xs text-[#94A3B8]">File AES-256-GCM chỉ chứa dữ liệu {orgOf(backup).shortName}; nhập lại ở Cài đặt &gt; Dữ liệu & bảo mật của chính doanh nghiệp đó.</p>
          </div>
        </Modal>
      )}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

function ConsoleAdmins() {
  const { platform, notify, me } = useApp();
  const [form, setForm] = useState<{ name: string; email: string } | null>(null);
  if (CLOUD_ON) {
    return (
      <div className="grid grid-cols-1 gap-4 xl:grid-cols-5">
        <Panel title="Tài khoản quản trị nền tảng" className="xl:col-span-3">
          <p className="text-sm text-[#94A3B8]">Chế độ máy chủ: tài khoản quản trị 3A quản lý trong Supabase.</p>
          <ol className="mt-3 list-decimal space-y-1.5 pl-5 text-sm">
            <li>Supabase &gt; Authentication &gt; Users &gt; Add user: nhập email @{PLATFORM_DOMAIN}, mật khẩu, tick Auto Confirm.</li>
            <li>SQL Editor: <code className="rounded bg-[#0F141E] px-1.5 py-0.5 text-xs text-[#F7B23B]">insert into public.platform_admins (user_id, email) select id, email from auth.users where email = &apos;ten@{PLATFORM_DOMAIN}&apos;;</code></li>
            <li>Gỡ quyền: xóa dòng tương ứng trong bảng platform_admins.</li>
          </ol>
          <p className="mt-3 text-xs text-[#94A3B8]">Đang đăng nhập: {me.email}</p>
        </Panel>
        <Panel title="Nhật ký nền tảng" className="xl:col-span-2">
          {platform.logs.length ? (
            <ul className="max-h-[420px] space-y-1.5 overflow-y-auto text-xs">
              {platform.logs.map((l) => <li key={l.id} className="rounded bg-[#1C2534] px-3 py-2"><b>{l.tenant ? `${orgOf(l.tenant).shortName}: ` : ''}{l.detail}</b><p className="mt-0.5 text-[#94A3B8]">{l.by}, {new Date(l.at).toLocaleString('vi-VN')}</p></li>)}
            </ul>
          ) : <p className="text-sm text-[#94A3B8]">Chưa có thao tác.</p>}
        </Panel>
      </div>
    );
  }
  const add = () => {
    if (!form) return;
    const email = form.email.trim().toLowerCase();
    if (form.name.trim().length < 3 || !isPlatformEmail(email)) return notify(`Nhập họ tên và email @${PLATFORM_DOMAIN}`, 'red');
    if (platform.admins.some((a) => a.email === email)) return notify('Email đã có', 'red');
    platform.setAdmins((p) => [...p, { id: uid('pa'), name: form.name.trim(), email, role: 'BOD', active: true, approvalLimit: 1e13, mustChangePassword: true }]);
    platform.log('ADMIN_ADD', `Thêm quản trị ${email}`);
    notify(`Đã thêm ${email}, mật khẩu khởi tạo ${DEMO_PASSWORD} (bắt đổi khi đăng nhập)`, 'teal');
    setForm(null);
  };
  return (
    <div className="grid grid-cols-1 gap-4 xl:grid-cols-5">
      <Panel title="Tài khoản quản trị nền tảng" className="xl:col-span-3" action={<button className={cn(btnPrimary, btnSm)} onClick={() => setForm({ name: '', email: '' })}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm quản trị</button>}>
        <Table head={['Họ tên', 'Email', 'Đăng nhập gần nhất', 'Trạng thái', '']} minW={640}>
          {platform.admins.map((a) => (
            <tr key={a.id} className={rowCls}>
              <td className={tdFirst}>{a.name}{a.id === me.id && <span className="ml-1 text-xs text-[#94A3B8]">(bạn)</span>}</td>
              <td className={cn(tdCls, 'text-xs')}>{a.email}</td>
              <td className={cn(tdCls, 'whitespace-nowrap text-xs tabular-nums')}>{a.lastLoginAt ? new Date(a.lastLoginAt).toLocaleString('vi-VN') : '—'}</td>
              <td className={tdCls}><Chip tone={a.active ? 'teal' : 'red'}>{a.active ? 'Hoạt động' : 'Đã khóa'}</Chip></td>
              <td className={tdLast}><span className="flex justify-end gap-1.5">
                <button className={cn(btnGhost, btnSm)} disabled={a.id === me.id} onClick={() => { platform.setAdmins((p) => p.map((x) => (x.id === a.id ? { ...x, active: !x.active } : x))); platform.log('ADMIN_TOGGLE', `${a.active ? 'Khóa' : 'Mở'} ${a.email}`); }}>{a.active ? 'Khóa' : 'Mở khóa'}</button>
                <button className={cn(btnGhost, btnSm, 'whitespace-nowrap')} disabled={a.id === me.id} onClick={() => { platform.setAdmins((p) => p.map((x) => (x.id === a.id ? { ...x, passwordHash: undefined, salt: undefined, mustChangePassword: true, failedAttempts: 0, lockedUntil: undefined } : x))); platform.log('ADMIN_RESET', `Đặt lại mật khẩu ${a.email}`); notify(`Mật khẩu ${a.email} về ${DEMO_PASSWORD}, bắt đổi khi đăng nhập`, 'orange'); }}>Đặt lại mật khẩu</button>
              </span></td>
            </tr>
          ))}
        </Table>
      </Panel>
      <Panel title="Nhật ký nền tảng" className="xl:col-span-2">
        {platform.logs.length ? (
          <ul className="max-h-[420px] space-y-1.5 overflow-y-auto text-xs">
            {platform.logs.map((l) => <li key={l.id} className="rounded bg-[#1C2534] px-3 py-2"><p className="flex justify-between gap-2"><b>{l.tenant ? `${orgOf(l.tenant).shortName}: ` : ''}{l.detail}</b></p><p className="mt-0.5 text-[#94A3B8]">{new Date(l.at).toLocaleString('vi-VN')}, {l.by}</p></li>)}
          </ul>
        ) : <p className="text-sm text-[#94A3B8]">Chưa có thao tác.</p>}
      </Panel>
      {form && (
        <Modal title="Thêm quản trị nền tảng" onClose={() => setForm(null)} footer={<><button className={btnGhost} onClick={() => setForm(null)}>Hủy</button><button className={btnPrimary} onClick={add}>Thêm</button></>}>
          <div className="space-y-3">
            <Field label="Họ tên"><input className={inputCls} value={form.name} onChange={(e) => setForm({ ...form, name: e.target.value })} /></Field>
            <Field label="Email" hint={`Phải thuộc tên miền @${PLATFORM_DOMAIN}`}><input className={inputCls} type="email" value={form.email} onChange={(e) => setForm({ ...form, email: e.target.value })} placeholder={`ten@${PLATFORM_DOMAIN}`} /></Field>
          </div>
        </Modal>
      )}
    </div>
  );
}

// ---------------- Bảng đơn giá m² / md & lịch thanh toán (mô hình xưởng) ----------------

function PricingSettings() {
  const { priceItems, setPriceItems, mfgConfig, setMfgConfig, canDo, notify, audit } = useApp();
  const can = canDo('priceList.manage');
  const canCfg = canDo('settings.edit') || can;
  const [q, setQ] = useState('');
  const [cat, setCat] = useState('ALL');
  const [edit, setEdit] = useState<PriceItem | null>(null);
  const [cfg, setCfg] = useState<MfgConfig>(mfgConfig);
  const cats = Array.from(new Set(priceItems.map((p) => p.category))).sort();
  const t = q.trim().toLowerCase();
  const list = priceItems.filter((p) => (cat === 'ALL' || p.category === cat) && (!t || `${p.code} ${p.name}`.toLowerCase().includes(t)));
  const sumPct = cfg.schedule.reduce((s, x) => s + x.pct, 0);
  const saveItem = () => {
    if (!edit) return;
    if (edit.code.trim().length < 2 || edit.name.trim().length < 3) return notify('Nhập mã và tên hạng mục', 'red');
    if (edit.price <= 0) return notify('Nhập đơn giá bán', 'red');
    if (priceItems.some((p) => p.id !== edit.id && p.code.trim().toUpperCase() === edit.code.trim().toUpperCase())) return notify('Mã hạng mục đã tồn tại', 'red');
    const item = { ...edit, code: edit.code.trim().toUpperCase(), name: edit.name.trim(), category: edit.category.trim() || 'Khác' };
    setPriceItems((all) => (all.some((p) => p.id === item.id) ? all.map((p) => (p.id === item.id ? item : p)) : [...all, item]));
    audit('PRICE_ITEM_SAVE', `${item.code}: ${vnd(item.price)}/${PRICE_UNIT[item.unit].short}`);
    notify(`Đã lưu ${item.code}. Báo giá đã lưu trước đó giữ nguyên giá cũ.`, 'teal');
    setEdit(null);
  };
  const saveCfg = () => {
    if (sumPct !== 100) return notify(`Tổng các đợt thanh toán phải bằng 100% (đang ${sumPct}%)`, 'red');
    if (cfg.schedule.some((s) => !s.label.trim() || s.pct <= 0)) return notify('Mỗi đợt cần tên và tỷ lệ lớn hơn 0', 'red');
    setMfgConfig((c) => ({ ...c, schedule: cfg.schedule, vatPct: cfg.vatPct, quoteValidDays: cfg.quoteValidDays, warrantyMonths: cfg.warrantyMonths, submitHours: cfg.submitHours, productionDays: cfg.productionDays }));
    audit('MFG_CONFIG', `Lịch thanh toán ${cfg.schedule.map((s) => `${s.label} ${s.pct}%`).join(' / ')}`);
    notify('Đã lưu cấu hình. Áp dụng cho đơn tạo mới.', 'teal');
  };
  const setStage = (i: number, p: Partial<PayStage>) => setCfg((c) => ({ ...c, schedule: c.schedule.map((s, k) => (k === i ? { ...s, ...p } : s)) }));
  return (
    <div className="space-y-5">
      <Panel title="Lịch thanh toán mặc định & quy định thu tiền">
        <p className="mb-3 text-xs text-[#94A3B8]">Mặc định khi chốt đơn; kỹ thuật vẫn sửa được % từng đơn lúc chốt. Doanh số chỉ ghi nhận khi kế toán xác nhận phiếu thu.</p>
        <ul className="space-y-2">
          {cfg.schedule.map((s, i) => (
            <li key={s.id} className="grid grid-cols-12 items-center gap-2">
              <input className={cn(inputCls, 'col-span-12 sm:col-span-5')} value={s.label} disabled={!canCfg} onChange={(e) => setStage(i, { label: e.target.value })} aria-label="Tên đợt" />
              <div className="relative col-span-4 sm:col-span-2"><input className={cn(inputCls, 'pr-7 text-right tabular-nums')} type="number" min={1} max={100} value={s.pct} disabled={!canCfg} onChange={(e) => setStage(i, { pct: Math.max(0, Math.min(100, Number(e.target.value) || 0)) })} aria-label="Tỷ lệ" /><span className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-[#94A3B8]">%</span></div>
              <select className={cn(inputCls, 'col-span-6 sm:col-span-4')} value={s.trigger} disabled={!canCfg} onChange={(e) => setStage(i, { trigger: e.target.value as PayTrigger })} aria-label="Mốc thu">{(Object.keys(PAY_TRIGGER) as PayTrigger[]).map((k) => <option key={k} value={k}>{PAY_TRIGGER[k]}</option>)}</select>
              <button className={cn(btnGhost, btnSm, 'col-span-2 sm:col-span-1 justify-center')} disabled={!canCfg || cfg.schedule.length <= 1} onClick={() => setCfg((c) => ({ ...c, schedule: c.schedule.filter((_, k) => k !== i) }))} aria-label="Xóa đợt"><Trash2 className="h-3.5 w-3.5" aria-hidden /></button>
            </li>
          ))}
        </ul>
        <div className="mt-2 flex flex-wrap items-center gap-3">
          <button className={cn(btnGhost, btnSm)} disabled={!canCfg || cfg.schedule.length >= 5} onClick={() => setCfg((c) => ({ ...c, schedule: [...c.schedule, { id: uid('ps'), label: 'Đợt giữa', pct: 0, trigger: 'DELIVERY' }] }))}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm đợt</button>
          <span className={cn('text-sm tabular-nums', sumPct === 100 ? 'text-[#3DDBB6]' : 'text-[#F87171]')}>Tổng {sumPct}%</span>
        </div>
        <div className="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
          <Field label="VAT mặc định (%)"><input className={inputCls} type="number" min={0} max={10} value={cfg.vatPct} disabled={!canCfg} onChange={(e) => setCfg({ ...cfg, vatPct: Math.max(0, Number(e.target.value) || 0) })} /></Field>
          <Field label="Hiệu lực báo giá (ngày)"><input className={inputCls} type="number" min={1} value={cfg.quoteValidDays} disabled={!canCfg} onChange={(e) => setCfg({ ...cfg, quoteValidDays: Math.max(1, Number(e.target.value) || 1) })} /></Field>
          <Field label="Bảo hành (tháng)"><input className={inputCls} type="number" min={0} value={cfg.warrantyMonths} disabled={!canCfg} onChange={(e) => setCfg({ ...cfg, warrantyMonths: Math.max(0, Number(e.target.value) || 0) })} /></Field>
          <Field label="Hạn nộp tiền mặt (giờ)" hint="Quá hạn: báo đỏ ở Tổng quan và Trung tâm phê duyệt"><input className={inputCls} type="number" min={1} max={72} value={cfg.submitHours} disabled={!canCfg} onChange={(e) => setCfg({ ...cfg, submitHours: Math.max(1, Number(e.target.value) || 24) })} /></Field>
          <Field label="Số ngày sản xuất mặc định"><input className={inputCls} type="number" min={1} value={cfg.productionDays} disabled={!canCfg} onChange={(e) => setCfg({ ...cfg, productionDays: Math.max(1, Number(e.target.value) || 10) })} /></Field>
        </div>
        <div className="mt-3 flex gap-2"><button className={btnPrimary} disabled={!canCfg} onClick={saveCfg}>Lưu cấu hình</button><button className={btnGhost} onClick={() => setCfg(mfgConfig)}>Hoàn tác</button></div>
      </Panel>

      <Panel title={`Bảng đơn giá theo sản phẩm / vật liệu (${priceItems.length})`} action={<button className={cn(btnPrimary, btnSm)} disabled={!can} onClick={() => setEdit({ id: uid('pi'), code: '', name: '', category: cat !== 'ALL' ? cat : '', unit: 'M2', price: 0, cost: 0, minMeasure: 1, active: true })}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm hạng mục</button>}>
        <div className="mb-3 flex flex-wrap gap-2">
          <div className="relative min-w-[180px] flex-1"><Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#94A3B8]" aria-hidden /><input className={cn(inputCls, 'pl-9')} value={q} onChange={(e) => setQ(e.target.value)} placeholder="Tìm mã, tên" /></div>
          <select className={cn(inputBase, 'w-auto')} value={cat} onChange={(e) => setCat(e.target.value)} aria-label="Nhóm"><option value="ALL">Tất cả nhóm</option>{cats.map((c) => <option key={c} value={c}>{c}</option>)}</select>
          <button className={cn(btnGhost, btnSm)} onClick={() => downloadCsv(`bang-don-gia-${todayISO()}.csv`, [['Mã', 'Tên', 'Nhóm', 'ĐVT', 'Đơn giá', 'Giá vốn', 'Tối thiểu', 'Đang dùng'], ...priceItems.map((p) => [p.code, p.name, p.category, PRICE_UNIT[p.unit].short, p.price, p.cost, p.minMeasure ?? '', p.active ? 'Có' : 'Không'])])}><Download className="h-3.5 w-3.5" aria-hidden />Xuất CSV</button>
        </div>
        <Table head={['Hạng mục', 'Nhóm', 'ĐVT', 'Đơn giá bán', 'Giá vốn', 'GM', 'Tối thiểu / tấm', '']} minW={860}>
          {list.map((p) => {
            const gm = p.price ? ((p.price - p.cost) / p.price) * 100 : 0;
            return (
              <tr key={p.id} className={cn(rowCls, !p.active && 'opacity-50')}>
                <td className={tdFirst}><p className="font-medium">{p.name}</p><p className="text-xs text-[#94A3B8]">{p.code}{p.note ? `, ${p.note}` : ''}</p></td>
                <td className={cn(tdCls, 'text-xs')}>{p.category}</td>
                <td className={cn(tdCls, 'text-xs')}>{PRICE_UNIT[p.unit].short}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{vnd(p.price)}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-[#94A3B8]')}>{vnd(p.cost)}</td>
                <td className={cn(tdCls, 'tabular-nums', gm < 20 ? 'text-[#F87171]' : 'text-[#3DDBB6]')}>{gm.toFixed(0)}%</td>
                <td className={cn(tdCls, 'text-xs')}>{p.unit === 'M2' || p.unit === 'MD' ? `${p.minMeasure ?? 0} ${PRICE_UNIT[p.unit].short}` : '—'}</td>
                <td className={tdLast}><span className="flex gap-1.5">
                  <button className={cn(btnGhost, btnSm)} disabled={!can} onClick={() => setEdit(p)} aria-label={`Sửa ${p.code}`}><Pencil className="h-3.5 w-3.5" aria-hidden /></button>
                  <button className={cn(btnGhost, btnSm)} disabled={!can} onClick={() => setPriceItems((all) => all.map((x) => (x.id === p.id ? { ...x, active: !x.active } : x)))}>{p.active ? 'Ngừng' : 'Dùng lại'}</button>
                </span></td>
              </tr>
            );
          })}
        </Table>
        {!list.length && <EmptyState text={<>Chưa có hạng mục.</>} art="box" />}
        <p className="mt-3 text-xs text-[#94A3B8]">m²: rộng × cao (mm) / 1.000.000 × số lượng, mỗi tấm tính tối thiểu theo cột "Tối thiểu". md: chiều dài (m) × số lượng. Ngừng hạng mục không ảnh hưởng báo giá đã lưu.</p>
      </Panel>

      {edit && (
        <Modal title={priceItems.some((p) => p.id === edit.id) ? `Sửa ${edit.code}` : 'Thêm hạng mục đơn giá'} onClose={() => setEdit(null)} footer={<><button className={btnGhost} onClick={() => setEdit(null)}>Hủy</button><button className={btnPrimary} onClick={saveItem}>Lưu</button></>}>
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <Field label="Mã *"><input className={inputCls} value={edit.code} onChange={(e) => setEdit({ ...edit, code: e.target.value })} placeholder="XF55-DI" /></Field>
            <Field label="Nhóm"><input className={inputCls} list="pi-cats" value={edit.category} onChange={(e) => setEdit({ ...edit, category: e.target.value })} placeholder="Cửa nhôm, Kính, Nội thất..." /><datalist id="pi-cats">{cats.map((c) => <option key={c} value={c} />)}</datalist></Field>
            <Field label="Tên hạng mục *" className="sm:col-span-2"><input className={inputCls} value={edit.name} onChange={(e) => setEdit({ ...edit, name: e.target.value })} placeholder="Cửa đi nhôm Xingfa hệ 55, kính hộp" /></Field>
            <Field label="Đơn vị tính"><select className={inputCls} value={edit.unit} onChange={(e) => setEdit({ ...edit, unit: e.target.value as PriceUnit })}>{(Object.keys(PRICE_UNIT) as PriceUnit[]).map((u) => <option key={u} value={u}>{PRICE_UNIT[u].label}</option>)}</select></Field>
            {(edit.unit === 'M2' || edit.unit === 'MD') && <Field label={`Tối thiểu mỗi tấm (${PRICE_UNIT[edit.unit].short})`}><input className={inputCls} type="number" min={0} step={0.1} value={edit.minMeasure ?? 0} onChange={(e) => setEdit({ ...edit, minMeasure: Math.max(0, Number(e.target.value) || 0) })} /></Field>}
            <Field label={`Đơn giá bán / ${PRICE_UNIT[edit.unit].short} *`}><MoneyInput value={edit.price} onChange={(n) => setEdit({ ...edit, price: n })} /></Field>
            <Field label={`Giá vốn / ${PRICE_UNIT[edit.unit].short}`} hint="Chỉ dùng tính lãi gộp, không in ra báo giá"><MoneyInput value={edit.cost} onChange={(n) => setEdit({ ...edit, cost: n })} /></Field>
            <Field label="Ghi chú" className="sm:col-span-2"><input className={inputCls} value={edit.note ?? ''} onChange={(e) => setEdit({ ...edit, note: e.target.value || undefined })} placeholder="Màu, phụ kiện kèm theo..." /></Field>
          </div>
        </Modal>
      )}
    </div>
  );
}

// ---------------- Phòng ban & Nhân sự ----------------

/** Vai trò được làm trưởng phòng; Sales Rep tự nâng thành Trưởng phòng KD */
const headRoleFor = (r: Role): Role => (r === 'SALES_REP' ? 'DEPT_HEAD' : r);

/**
 * Đồng bộ 2 chiều trưởng phòng <-> thông tin nhân sự:
 * gán userId làm trưởng phòng `code` -> cập nhật vai trò / phòng của người mới,
 * hạ người cũ về Sales Rep và gỡ chức trưởng phòng cũ của người mới (nếu có).
 */
function applyHead(code: DeptCode, userId: string | undefined, departments: Department[], users: User[]) {
  const dept = departments.find((d) => d.code === code);
  const oldHeadId = dept?.headId;
  const nextDepts = departments.map((d) => {
    if (d.code === code) return { ...d, headId: userId };
    if (userId && d.headId === userId) return { ...d, headId: undefined };
    return d;
  });
  const nextUsers = users.map((u) => {
    if (u.id === userId) return { ...u, dept: code, role: headRoleFor(u.role) };
    if (u.id === oldHeadId && oldHeadId !== userId && u.role === 'DEPT_HEAD') return { ...u, role: 'SALES_REP' as Role, approvalLimit: 0 };
    return u;
  });
  return { nextDepts, nextUsers };
}

function DeptModal({ code, onClose }: { code?: string; onClose: () => void }) {
  const { departments, setDepartments, users, setUsers, leads, notify } = useApp();
  const existing = departments.find((d) => d.code === code);
  const [f, setF] = useState<Department>(existing ?? { code: '', name: '', short: '', slaMinutes: 120, receivesLeads: true, active: true });
  const [touched, setTouched] = useState(false);
  // Danh sách đầy đủ nhân sự đang hoạt động; người của phòng này lên đầu
  const candidates = users.filter((u) => u.active).sort((a, b) => Number(b.dept === f.code) - Number(a.dept === f.code) || a.name.localeCompare(b.name));
  const openLeads = existing ? leads.filter((l) => l.dept === existing.code && OPEN_STATUSES.includes(l.status)).length : 0;
  const newHead = users.find((u) => u.id === f.headId);
  const oldHead = users.find((u) => u.id === existing?.headId);
  const e: Partial<Record<keyof Department, string>> = {};
  if (!existing && !/^[A-Z][A-Z0-9_]{2,24}$/.test(f.code)) e.code = 'Mã viết hoa không dấu, 3–25 ký tự, VD: EMD_CENTRAL';
  else if (!existing && departments.some((d) => d.code === f.code)) e.code = 'Mã phòng ban đã tồn tại';
  if (f.name.trim().length < 3) e.name = 'Nhập tên phòng ban';
  if (!f.short.trim()) e.short = 'Nhập tên ngắn';
  if (f.slaMinutes < 15 || f.slaMinutes > 1440) e.slaMinutes = 'SLA từ 15 đến 1.440 phút';
  if (existing && !f.active && openLeads > 0) e.active = `Còn ${openLeads} lead đang xử lý, cần chuyển trước khi ngừng hoạt động`;
  const err = (k: keyof Department) => (touched ? e[k] : undefined);
  const set = <K extends keyof Department>(k: K, v: Department[K]) => setF((p) => ({ ...p, [k]: v }));

  const save = () => {
    setTouched(true);
    if (Object.keys(e).length) return;
    const clean: Department = { ...f, name: f.name.trim(), short: f.short.trim(), headId: existing?.headId };
    const base = existing ? departments.map((d) => (d.code === existing.code ? clean : d)) : [...departments, clean];
    const { nextDepts, nextUsers } = f.headId !== existing?.headId ? applyHead(clean.code, f.headId, base, users) : { nextDepts: base, nextUsers: users };
    setDepartments(nextDepts);
    setUsers(nextUsers);
    notify(existing ? `Đã cập nhật ${clean.name}` : `Đã thêm ${clean.name}`, 'teal');
    onClose();
  };

  return (
    <Modal title={existing ? `Sửa ${existing.name}` : 'Thêm phòng ban'} onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Lưu</button></>}>
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <Field label="Tên phòng ban *" error={err('name')} className="sm:col-span-2"><input className={inputCls} value={f.name} onChange={(ev) => set('name', ev.target.value)} placeholder="VD: Phòng EMD Miền Trung" /></Field>
        <Field label="Mã phòng ban *" error={err('code')} hint={existing ? 'Mã không đổi được sau khi tạo' : undefined}><input className={inputCls} disabled={!!existing} value={f.code} onChange={(ev) => set('code', ev.target.value.toUpperCase())} /></Field>
        <Field label="Tên ngắn *" error={err('short')}><input className={inputCls} value={f.short} onChange={(ev) => set('short', ev.target.value)} placeholder="EMD Trung" /></Field>
        <Field label="Trưởng phòng" className="sm:col-span-2" hint="Chọn bất kỳ nhân sự đang hoạt động; thông tin nhân sự được cập nhật tự động">
          <select className={inputCls} value={f.headId ?? ''} onChange={(ev) => set('headId', ev.target.value || undefined)}>
            <option value="">Chưa chỉ định</option>
            {candidates.map((u) => <option key={u.id} value={u.id}>{u.name} ({ROLE_LABEL[u.role]}{u.dept ? `, ${departments.find((d) => d.code === u.dept)?.short ?? u.dept}` : ''})</option>)}
          </select>
        </Field>
        {f.headId !== existing?.headId && (newHead || oldHead) && (
          <div className="rounded bg-[#F28C33]/10 p-3 text-xs text-[#F7B23B] sm:col-span-2">
            {newHead && <p>{newHead.name} sẽ chuyển về {f.name || 'phòng này'} với vai trò {ROLE_LABEL[headRoleFor(newHead.role)]}.</p>}
            {oldHead && oldHead.role === 'DEPT_HEAD' && <p>{oldHead.name} thôi làm trưởng phòng, chuyển về Sales Rep.</p>}
          </div>
        )}
        <Field label="SLA tiếp nhận lead (phút)" error={err('slaMinutes')}><input className={inputCls} type="number" min={15} max={1440} value={f.slaMinutes} onChange={(ev) => set('slaMinutes', Number(ev.target.value))} /></Field>
        <div className="space-y-2 self-end pb-1">
          <label className="flex items-center gap-2 text-sm"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={f.receivesLeads} onChange={(ev) => set('receivesLeads', ev.target.checked)} />Nhận lead từ Marketing</label>
          <label className="flex items-center gap-2 text-sm"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={f.active} onChange={(ev) => set('active', ev.target.checked)} />Đang hoạt động</label>
          {err('active') && <p className="text-xs text-[#F87171]">{err('active')}</p>}
        </div>
      </div>
    </Modal>
  );
}

function UserModal({ id, onClose }: { id?: string; onClose: () => void }) {
  const { users, setUsers, departments, setDepartments, me, notify, audit, canDo, org } = useApp();
  const [cloudBusy, setCloudBusy] = useState(false);
  const [issued, setIssued] = useState<{ email: string; pw: string } | null>(null);
  const existing = users.find((u) => u.id === id);
  const [f, setF] = useState<User>(existing ?? { id: '', name: '', email: '', phone: '', role: 'SALES_REP', dept: departments.find((d) => d.receivesLeads)?.code, active: true, approvalLimit: 0 });
  const wasHeadOf = existing ? departments.find((d) => d.headId === existing.id)?.code : undefined;
  const [isHead, setIsHead] = useState(!!wasHeadOf);
  const [touched, setTouched] = useState(false);
  const needsDept = f.role !== 'BOD';
  const e: Partial<Record<keyof User, string>> = {};
  if (f.name.trim().length < 3) e.name = 'Nhập họ tên';
  if (!EMAIL_RE.test(f.email)) e.email = 'Email chưa đúng định dạng';
  else if (users.some((u) => u.email.toLowerCase() === f.email.toLowerCase() && u.id !== f.id)) e.email = 'Email đã được dùng';
  if (needsDept && !f.dept) e.dept = 'Chọn phòng ban';
  if (existing && existing.id === me.id && !f.active) e.active = 'Không thể tự khóa tài khoản đang đăng nhập';
  const err = (k: keyof User) => (touched ? e[k] : undefined);
  const set = <K extends keyof User>(k: K, v: User[K]) => setF((p) => ({ ...p, [k]: v }));
  const deptOf = departments.find((d) => d.code === f.dept);
  const currentHead = deptOf?.headId && deptOf.headId !== f.id ? users.find((u) => u.id === deptOf.headId) : undefined;

  const save = () => {
    setTouched(true);
    if (Object.keys(e).length) return;
    const uidNew = existing?.id ?? uid('u');
    let role = f.role;
    if (isHead && role === 'SALES_REP') role = 'DEPT_HEAD';
    if (!isHead && wasHeadOf && role === 'DEPT_HEAD') role = 'SALES_REP';
    const clean: User = { ...f, id: uidNew, role, name: f.name.trim(), email: f.email.trim().toLowerCase(), dept: needsDept ? f.dept : undefined, approvalLimit: role === 'DEPT_HEAD' || role === 'BOD' ? f.approvalLimit : 0 };
    let nextUsers = existing ? users.map((u) => (u.id === existing.id ? clean : u)) : [...users, clean];
    let nextDepts = departments.map((d) => (d.headId === uidNew && (!isHead || d.code !== clean.dept) ? { ...d, headId: undefined } : d));
    if (isHead && clean.dept) ({ nextDepts, nextUsers } = applyHead(clean.dept, uidNew, nextDepts, nextUsers));
    setUsers(nextUsers);
    setDepartments(nextDepts);
    if (existing && CLOUD_ON) {
      // Máy chủ: khóa tài khoản = thu hồi quyền đọc dữ liệu; đổi vai trò Giám đốc = đổi quyền cấp tài khoản
      if (existing.active && !clean.active) void cloud.revoke(clean.email, org.id).then(() => notify(`Đã khóa ${clean.name}, thu hồi quyền truy cập dữ liệu`, 'orange'), (er) => notify(cloudMessage(er), 'red'));
      else if (!existing.active && clean.active) notify(`Mở lại ${clean.name}: bấm "Đặt lại mật khẩu" để cấp lại quyền đăng nhập`, 'orange');
      else if ((existing.role === 'BOD') !== (clean.role === 'BOD') && clean.active) void cloud.provision(clean.email, org.id, null, clean.role === 'BOD').catch((er) => { if (!/no_user/.test(String(er?.message))) notify(cloudMessage(er), 'red'); });
      if (existing.email.toLowerCase() !== clean.email) notify('Đã đổi email: bấm "Đặt lại mật khẩu" để tạo đăng nhập cho email mới', 'orange');
    }
    if (existing) { notify(`Đã cập nhật ${clean.name}`, 'teal'); onClose(); }
    else void issueTemp(uidNew, clean.email, 'CREATE', role);
  };

  /** Cấp mật khẩu tạm ngẫu nhiên (băm trước khi lưu), bắt đổi ở lần đăng nhập đầu */
  const issueTemp = async (id: string, email: string, why: 'CREATE' | 'RESET', roleNow?: Role) => {
    const pw = tempPassword();
    if (CLOUD_ON) {
      // Máy chủ: tạo / đặt lại tài khoản đăng nhập Supabase + gắn quyền vào doanh nghiệp
      const r = roleNow ?? users.find((u) => u.id === id)?.role;
      setCloudBusy(true);
      try { await cloud.provision(email, org.id, pw, r === 'BOD'); }
      catch (er) { notify(cloudMessage(er), 'red'); if (why === 'CREATE') onClose(); return; }
      finally { setCloudBusy(false); }
      setUsers((p) => p.map((u) => (u.id === id ? { ...u, passwordHash: undefined, salt: undefined, mustChangePassword: true, failedAttempts: 0, lockedUntil: undefined, active: true } : u)));
      audit(why === 'CREATE' ? 'USER_CREATE' : 'PASSWORD_RESET', `${why === 'CREATE' ? 'Tạo tài khoản' : 'Đặt lại mật khẩu'} ${email}`, 'SECURITY');
      setIssued({ email, pw });
      return;
    }
    const h = await hashPassword(pw);
    setUsers((p) => p.map((u) => (u.id === id ? { ...u, passwordHash: h.hash, salt: h.salt, mustChangePassword: true, failedAttempts: 0, lockedUntil: undefined } : u)));
    audit(why === 'CREATE' ? 'USER_CREATE' : 'PASSWORD_RESET', `${why === 'CREATE' ? 'Tạo tài khoản' : 'Đặt lại mật khẩu'} ${email}`, 'SECURITY');
    setIssued({ email, pw });
  };
  if (issued) {
    return (
      <Modal title="Mật khẩu tạm" onClose={onClose} footer={<button className={btnPrimary} onClick={onClose}>Đã ghi lại</button>}>
        <p className="text-sm text-[#94A3B8]">Gửi mật khẩu này cho <b className="text-[#F1F5F9]">{issued.email}</b> qua kênh riêng. Người dùng phải đổi mật khẩu ở lần đăng nhập đầu. Mật khẩu chỉ hiện một lần.</p>
        <div className="mt-3 flex items-center gap-2 rounded border border-[#263044] bg-[#0F141E] p-3">
          <code className="flex-1 select-all text-lg tracking-wider text-[#F7B23B]">{issued.pw}</code>
          <button className={cn(btnGhost, btnSm)} onClick={() => navigator.clipboard?.writeText(issued.pw).then(() => notify('Đã sao chép', 'teal'))}><Copy className="h-3.5 w-3.5" aria-hidden />Sao chép</button>
        </div>
      </Modal>
    );
  }

  return (
    <Modal title={existing ? `Sửa nhân sự ${existing.name}` : 'Thêm nhân sự'} onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button>{existing && canDo('security.manage') && <button className={cn(btnGhost, 'mr-auto')} disabled={cloudBusy} onClick={() => void issueTemp(existing.id, existing.email, 'RESET')}><KeyRound className="h-4 w-4" aria-hidden />{existing.lockedUntil && existing.lockedUntil > Date.now() ? 'Mở khóa & đặt lại mật khẩu' : 'Đặt lại mật khẩu'}</button>}<button className={btnPrimary} onClick={save}>Lưu</button></>}>
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <Field label="Họ tên *" error={err('name')} className="sm:col-span-2"><input className={inputCls} value={f.name} onChange={(ev) => set('name', ev.target.value)} /></Field>
        <Field label="Email đăng nhập *" error={err('email')}><input className={inputCls} type="email" value={f.email} onChange={(ev) => set('email', ev.target.value)} /></Field>
        <Field label="Điện thoại (nhận Zalo ZNS)"><input className={inputCls} value={f.phone ?? ''} onChange={(ev) => set('phone', ev.target.value)} /></Field>
        <Field label="Vai trò">
          <select className={inputCls} value={f.role} onChange={(ev) => set('role', ev.target.value as Role)}>
            {ROLES.map((r) => <option key={r} value={r}>{ROLE_LABEL[r]}</option>)}
          </select>
        </Field>
        <Field label="Phòng ban" error={err('dept')}>
          <select className={inputCls} disabled={!needsDept} value={needsDept ? f.dept ?? '' : ''} onChange={(ev) => set('dept', ev.target.value || undefined)}>
            <option value="">{needsDept ? 'Chọn phòng ban' : 'Ban Giám đốc'}</option>
            {departments.filter((d) => d.active).map((d) => <option key={d.code} value={d.code}>{d.name}</option>)}
          </select>
        </Field>
        {needsDept && f.dept && (
          <label className="flex items-start gap-2 text-sm sm:col-span-2">
            <input type="checkbox" className="mt-0.5 h-4 w-4 accent-[#F28C33]" checked={isHead} onChange={(ev) => setIsHead(ev.target.checked)} />
            <span>Là trưởng phòng {deptOf?.name}{isHead && currentHead ? <span className="block text-xs text-[#F7B23B]">Thay {currentHead.name}; người này sẽ chuyển về Sales Rep.</span> : null}</span>
          </label>
        )}
        {(f.role === 'DEPT_HEAD' || f.role === 'BOD' || isHead) && (
          <Field label="Hạn mức duyệt đề xuất MDF" hint="Vượt hạn mức sẽ chuyển lên Ban Giám đốc" className="sm:col-span-2"><MoneyInput value={f.approvalLimit} onChange={(n) => set('approvalLimit', n)} /></Field>
        )}
        <div className="sm:col-span-2">
          <label className="flex items-center gap-2 text-sm"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={f.active} onChange={(ev) => set('active', ev.target.checked)} />Tài khoản đang hoạt động</label>
          {err('active') && <p className="mt-1 text-xs text-[#F87171]">{err('active')}</p>}
        </div>
      </div>
    </Modal>
  );
}

function OrgSettings() {
  const { departments, setDepartments, users, setUsers, leads, customers, programs, perms, setPerms, me, canDo, userName, dept, notify, org } = useApp();
  const canEdit = canDo('settings.edit');
  const [deptModal, setDeptModal] = useState<{ code?: string } | null>(null);
  const [userModal, setUserModal] = useState<{ id?: string } | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const [userFilter, setUserFilter] = useState<'ALL' | DeptCode>('ALL');
  const shownUsers = users.filter((u) => userFilter === 'ALL' || u.dept === userFilter);

  const askDeleteDept = (d: Department) => {
    const staff = users.filter((u) => u.dept === d.code).length;
    const open = leads.filter((l) => l.dept === d.code && OPEN_STATUSES.includes(l.status)).length;
    const cust = customers.filter((c) => c.dept === d.code).length;
    const prog = programs.filter((p) => p.dept === d.code).length;
    const reasons = [staff && `${staff} nhân sự`, open && `${open} lead đang xử lý`, cust && `${cust} khách hàng`, prog && `${prog} chương trình quỹ`].filter(Boolean);
    setConfirm({
      title: 'Xóa phòng ban',
      message: <>Xóa <b>{d.name}</b>?</>,
      blocked: reasons.length ? `Phòng đang có ${reasons.join(', ')}. Chuyển sang phòng khác trước khi xóa, hoặc bỏ chọn "Đang hoạt động" để ngừng phòng.` : undefined,
      onConfirm: () => { setDepartments((p) => p.filter((x) => x.code !== d.code)); notify(`Đã xóa ${d.name}`, 'orange'); },
    });
  };

  const askDeleteUser = (u: User) => {
    const open = leads.filter((l) => l.assignee === u.id && OPEN_STATUSES.includes(l.status)).length;
    const cust = customers.filter((c) => c.amId === u.id).length;
    const reasons = [open && `${open} lead đang xử lý`, cust && `${cust} khách hàng phụ trách`].filter(Boolean);
    setConfirm({
      title: 'Xóa nhân sự',
      message: <>Xóa tài khoản <b>{u.name}</b> ({u.email})? Lịch sử thao tác vẫn giữ tên người tạo.</>,
      blocked: u.id === me.id ? 'Không thể xóa tài khoản đang đăng nhập.' : reasons.length ? `Nhân sự đang có ${reasons.join(', ')}. Chuyển giao trước khi xóa, hoặc khóa tài khoản (Inactive) để giữ dữ liệu.` : undefined,
      onConfirm: () => {
        setUsers((p) => p.filter((x) => x.id !== u.id));
        setDepartments((p) => p.map((d) => (d.headId === u.id ? { ...d, headId: undefined } : d)));
        notify(`Đã xóa ${u.name}`, 'orange');
      },
    });
  };

  const toggleModule = (r: Role, m: Module) => {
    if (r === 'BOD' && m === 'settings') return;
    setPerms((p) => ({ ...p, modules: { ...p.modules, [r]: { ...p.modules[r], [m]: !p.modules[r][m] } } }));
  };
  const toggleAction = (a: Action, r: Role) => {
    if (a === 'settings.edit' && r === 'BOD') return;
    setPerms((p) => ({ ...p, actions: { ...p.actions, [a]: p.actions[a].includes(r) ? p.actions[a].filter((x) => x !== r) : [...p.actions[a], r] } }));
  };

  return (
    <div className="space-y-4">
      <Collapse
        title="Phòng ban"
        summary={`${departments.length} phòng, ${departments.filter((d) => d.receivesLeads && d.active).length} phòng nhận lead`}
        action={<button className={cn(btnPrimary, btnSm)} disabled={!canEdit} onClick={() => setDeptModal({})}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm phòng ban</button>}
      >
        <Table head={['Phòng ban', 'Trưởng phòng', 'Nhân sự', 'Nhận lead / SLA', 'Lead đang xử lý', 'Trạng thái', '']} minW={900}>
          {departments.map((d) => {
            const Icon = deptIcon(d.code);
            return (
              <tr key={d.code} className={rowCls}>
                <td className={tdFirst}><p className="flex items-center gap-2 font-medium text-[#F1F5F9]"><Icon className="h-4 w-4 text-[#94A3B8]" aria-hidden />{d.name}</p><p className="text-xs text-[#94A3B8]">{d.code}</p></td>
                <td className={tdCls}>{d.headId ? userName(d.headId) : <span className="text-[#94A3B8]">Chưa chỉ định</span>}</td>
                <td className={cn(tdCls, 'tabular-nums')}>{users.filter((u) => u.dept === d.code && u.active).length}</td>
                <td className={tdCls}>{d.receivesLeads ? <span>Có, {d.slaMinutes} phút</span> : <span className="text-[#94A3B8]">Không nhận lead</span>}</td>
                <td className={cn(tdCls, 'tabular-nums')}>{leads.filter((l) => l.dept === d.code && OPEN_STATUSES.includes(l.status)).length}</td>
                <td className={tdCls}><Chip tone={d.active ? 'teal' : 'muted'}>{d.active ? 'Hoạt động' : 'Ngừng'}</Chip></td>
                <td className={cn(tdLast, 'whitespace-nowrap text-right')}>
                  <button className={cn(btnGhost, 'mr-1 p-1.5')} disabled={!canEdit} onClick={() => setDeptModal({ code: d.code })} aria-label={`Sửa ${d.name}`}><Pencil className="h-3.5 w-3.5" /></button>
                  <button className={cn(btnGhost, 'p-1.5 hover:text-[#F87171]')} disabled={!canEdit} onClick={() => askDeleteDept(d)} aria-label={`Xóa ${d.name}`}><Trash2 className="h-3.5 w-3.5" /></button>
                </td>
              </tr>
            );
          })}
        </Table>
      </Collapse>

      <Collapse
        title="Nhân sự và tài khoản"
        summary={`${users.filter((u) => u.active).length} đang hoạt động, ${users.filter((u) => !u.active).length} đã khóa`}
        action={
          <div className="flex flex-wrap gap-2">
            <select className={cn(inputBase, 'w-auto py-1.5')} value={userFilter} onChange={(e) => setUserFilter(e.target.value)} aria-label="Lọc phòng ban">
              <option value="ALL">Mọi phòng ban</option>
              {departments.map((d) => <option key={d.code} value={d.code}>{d.short}</option>)}
            </select>
            <button className={cn(btnPrimary, btnSm)} disabled={!canEdit} onClick={() => setUserModal({})}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm nhân sự</button>
          </div>
        }
      >
        <Table head={['Nhân sự', 'Vai trò', 'Phòng ban', 'Hạn mức duyệt', 'Trạng thái', '']} minW={880}>
          {shownUsers.map((u) => {
            const headOf = departments.find((d) => d.headId === u.id);
            return (
              <tr key={u.id} className={rowCls}>
                <td className={tdFirst}>
                  <div className="flex items-center gap-3">
                    <span className="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#1C2534] text-xs font-semibold text-[#F7B23B]">{initials(u.name)}</span>
                    <div><p className="text-[#F1F5F9]">{u.name}{u.id === me.id && <span className="ml-2 text-xs text-[#94A3B8]">(bạn)</span>}</p><p className="text-xs text-[#94A3B8]">{u.email}</p></div>
                  </div>
                </td>
                <td className={tdCls}>{ROLE_LABEL[u.role]}{headOf && <p className="text-xs text-[#F7B23B]">Trưởng {headOf.short}</p>}</td>
                <td className={tdCls}>{dept(u.dept)?.short ?? <span className="text-[#94A3B8]">Ban Giám đốc</span>}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{u.approvalLimit ? compact(u.approvalLimit) : <span className="text-[#94A3B8]">—</span>}</td>
                <td className={tdCls}>
                  <button disabled={!canEdit || u.id === me.id} onClick={() => {
                    setUsers((p) => p.map((x) => (x.id === u.id ? { ...x, active: !x.active } : x)));
                    if (CLOUD_ON && u.active) void cloud.revoke(u.email, org.id).catch((er) => notify(cloudMessage(er), 'red'));
                    notify(CLOUD_ON && !u.active ? `Đã mở ${u.name}: bấm "Đặt lại mật khẩu" để cấp lại quyền đăng nhập` : `${u.active ? 'Đã khóa' : 'Đã mở'} tài khoản ${u.name}`, u.active ? 'orange' : 'teal');
                  }} className="disabled:cursor-not-allowed" aria-label={`${u.active ? 'Khóa' : 'Mở'} tài khoản ${u.name}`}>
                    <Chip tone={u.active ? 'teal' : 'muted'}>{u.active ? 'Active' : 'Inactive'}</Chip>
                  </button>
                </td>
                <td className={cn(tdLast, 'whitespace-nowrap text-right')}>
                  <button className={cn(btnGhost, 'mr-1 p-1.5')} disabled={!canEdit} onClick={() => setUserModal({ id: u.id })} aria-label={`Sửa ${u.name}`}><Pencil className="h-3.5 w-3.5" /></button>
                  <button className={cn(btnGhost, 'p-1.5 hover:text-[#F87171]')} disabled={!canEdit} onClick={() => askDeleteUser(u)} aria-label={`Xóa ${u.name}`}><Trash2 className="h-3.5 w-3.5" /></button>
                </td>
              </tr>
            );
          })}
        </Table>
      </Collapse>

      <Collapse title="Phân quyền theo vai trò" summary="Phân hệ được truy cập và thao tác nghiệp vụ">
        <h3 className="mb-2 text-sm font-semibold">Phân hệ được truy cập</h3>
        <Table head={['Phân hệ', ...ROLES.map((r) => ROLE_LABEL[r])]} minW={820}>
          {MODULES.map((m) => (
            <tr key={m} className={rowCls}>
              <td className={tdFirst}>{MODULE_LABEL[m]}</td>
              {ROLES.map((r, i) => (
                <td key={r} className={i === ROLES.length - 1 ? tdLast : tdCls}>
                  <input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={perms.modules[r][m]} disabled={!canEdit || (r === 'BOD' && m === 'settings')} onChange={() => toggleModule(r, m)} aria-label={`${ROLE_LABEL[r]} truy cập ${MODULE_LABEL[m]}`} />
                </td>
              ))}
            </tr>
          ))}
        </Table>
        <h3 className="mb-2 mt-5 text-sm font-semibold">Thao tác nghiệp vụ</h3>
        <Table head={['Thao tác', ...ROLES.map((r) => ROLE_LABEL[r])]} minW={820}>
          {(Object.keys(ACTION_LABEL) as Action[]).map((a) => (
            <tr key={a} className={rowCls}>
              <td className={tdFirst}>{ACTION_LABEL[a]}</td>
              {ROLES.map((r, i) => (
                <td key={r} className={i === ROLES.length - 1 ? tdLast : tdCls}>
                  <input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={perms.actions[a].includes(r)} disabled={!canEdit || (a === 'settings.edit' && r === 'BOD')} onChange={() => toggleAction(a, r)} aria-label={`${ROLE_LABEL[r]}: ${ACTION_LABEL[a]}`} />
                </td>
              ))}
            </tr>
          ))}
        </Table>
        <p className="mt-3 text-xs text-[#94A3B8]">Phạm vi dữ liệu lead: Giám đốc và Marketing thấy toàn bộ; Trưởng phòng chỉ thấy lead của phòng mình; Sales chỉ thấy lead được giao.</p>
      </Collapse>

      {deptModal && <DeptModal code={deptModal.code} onClose={() => setDeptModal(null)} />}
      {userModal && <UserModal id={userModal.id} onClose={() => setUserModal(null)} />}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

// ---------------- Quỹ Hãng 3M: MDF + CS theo số tiền ----------------

function CategoryTable({ fund }: { fund: FundCode }) {
  const { categories, setCategories, popDocs, programs, claims, budget, setBudget, canDo, notify } = useApp();
  const canEdit = canDo('settings.edit');
  // Số tiền hiển thị là phân bổ của năm tài chính đang xem
  const rows = categories.filter((c) => c.fund === fund).map((c) => ({ ...c, amount: budget.declared === false ? 0 : budget.allocations?.[c.code] ?? c.amount }));
  const fundTotal = fund === 'MDF' ? budget.mdfTotal : budget.csTotal;
  const allocated = rows.reduce((s, c) => s + c.amount, 0);
  const docOpts: Opt[] = popDocs.map((d) => ({ value: d.code, label: d.name }));
  const palette = [C.orange, C.teal, C.blue, C.sand, '#A78BFA', '#F472B6', '#34D399', '#60A5FA', '#FBBF24'];
  return (
    <>
      <div className="mb-3 flex flex-wrap items-center gap-3 text-sm">
        <span className="text-[#94A3B8]">Đã phân bổ</span>
        <span className="tabular-nums font-medium">{vnd(allocated)} / {vnd(fundTotal)}</span>
        <div className="w-48"><ProgressBar value={allocated} max={fundTotal} /></div>
        {allocated < fundTotal && <span className="text-xs text-[#94A3B8]">Chưa phân bổ {compact(fundTotal - allocated)}</span>}
        {allocated > fundTotal && <span className="text-xs text-[#F87171]">Vượt tổng {compact(allocated - fundTotal)}</span>}
      </div>
      <CatalogTable<BudgetCategory>
        rows={rows}
        rowKey={(r) => r.code}
        entity="hạng mục"
        canEdit={canEdit}
        columns={[
          { label: 'Hạng mục', render: (r) => r.name },
          { label: 'Ngân sách', render: (r) => <span className="tabular-nums">{compact(r.amount)}</span> },
          { label: 'Đã dùng', render: (r) => { const u = usedByType(r.code, claims, programs, budget.fiscalYear); return <div className="w-36"><ProgressBar value={u} max={r.amount} /><p className="mt-1 text-xs tabular-nums text-[#94A3B8]">{compact(u)}</p></div>; } },
          { label: 'Quyết toán', render: (r) => <Chip tone={r.settlement === 'LUMP_SUM' ? 'orange' : 'blue'}>{SETTLEMENT_LABEL[r.settlement]}</Chip> },
          { label: 'Chứng từ claim', render: (r) => <span className="text-xs text-[#94A3B8]">{r.required.map((d) => POP_LABEL[d] ?? d).join(', ') || 'Chưa cấu hình'}</span> },
          { label: 'Màu', render: (r) => <i className="block h-3 w-3 rounded-full" style={{ background: r.color }} /> },
        ]}
        fields={[
          { key: 'name', label: 'Tên hạng mục', type: 'text', wide: true },
          { key: 'amount', label: 'Ngân sách (VNĐ)', type: 'money' },
          { key: 'settlement', label: 'Hình thức quyết toán với 3M', type: 'select', options: (Object.keys(SETTLEMENT_LABEL) as Settlement[]).map((x) => ({ value: x, label: SETTLEMENT_LABEL[x] })), hint: 'Khoán: được giữ thặng dư. Hoàn ứng: claim tối đa bằng chi phí thực tế' },
          { key: 'color', label: 'Màu biểu đồ', type: 'color' },
          { key: 'required', label: 'Chứng từ bắt buộc khi claim', type: 'multi', options: docOpts },
        ]}
        blank={() => ({ name: '', amount: 0, settlement: 'ACTUAL_COST', color: palette[rows.length % palette.length], required: ['VAT_INVOICE'] })}
        toForm={(r) => ({ ...r })}
        fromForm={(v, prev) => ({ code: prev?.code ?? codeFrom(String(v.name), categories.map((c) => c.code)), name: String(v.name).trim(), fund, amount: Number(v.amount), color: String(v.color), required: (v.required as string[]) ?? [], settlement: (v.settlement as Settlement) ?? 'ACTUAL_COST' })}
        validate={(v, prev) => {
          const e: Record<string, string> = {};
          const amount = Number(v.amount);
          const used = prev ? usedByType(prev.code, claims, programs, budget.fiscalYear) : 0;
          if (String(v.name ?? '').trim().length < 3) e.name = 'Tối thiểu 3 ký tự';
          if (amount <= 0) e.amount = 'Nhập số tiền';
          else if (amount < used) e.amount = `Đã dùng ${compact(used)}, không thể thấp hơn`;
          else if (allocated - (prev?.amount ?? 0) + amount > fundTotal) e.amount = `Vượt tổng ${FUND_LABEL[fund]} (còn ${compact(fundTotal - allocated + (prev?.amount ?? 0))})`;
          if (!((v.required as string[]) ?? []).length) e.required = 'Chọn ít nhất một chứng từ';
          return e;
        }}
        onSave={(row, prev) => {
          setCategories((p) => (prev ? p.map((c) => (c.code === prev.code ? { ...row, amount: c.amount } : c)) : [...p, row]));
          setBudget((b) => ({ ...b, allocations: { ...(b.allocations ?? {}), [row.code]: row.amount } }));
          notify(`Đã lưu hạng mục ${row.name}, ngân sách năm ${budget.fiscalYear}: ${compact(row.amount)}`, 'teal');
        }}
        onDelete={(r) => { setCategories((p) => p.filter((c) => c.code !== r.code)); notify(`Đã xóa hạng mục ${r.name}`, 'orange'); }}
        deleteBlocked={(r) => { const n = programs.filter((p) => p.type === r.code).length + claims.filter((c) => c.programType === r.code).length; return n ? `Hạng mục đang có ${n} chương trình / hồ sơ claim. Không thể xóa để giữ số liệu quyết toán.` : undefined; }}
      />
    </>
  );
}

/** Tiêu chí duyệt claim: chứng từ, ảnh, hạn nộp — dùng chung cho mọi năm */
function ClaimRulesSection({ defaultOpen = false }: { defaultOpen?: boolean }) {
  const { policy, setPolicy, categories, setCategories, popDocs, setPopDocs, claims, canDo, notify } = useApp();
  const canEdit = canDo('settings.edit');
  const [p, setP] = useState(policy);
  const [touched, setTouched] = useState(false);
  const e: Record<string, string> = {};
  if (p.claimWindowDays < 15 || p.claimWindowDays > 180) e.window = 'Từ 15 đến 180 ngày';
  if (p.rules.minPhotos < 1 || p.rules.minPhotos > 10) e.photos = 'Từ 1 đến 10 ảnh';
  const err = (k: string) => (touched ? e[k] : undefined);
  const savePolicy = () => {
    setTouched(true);
    if (Object.keys(e).length) return notify('Kiểm tra lại các ô đang báo lỗi', 'red');
    setPolicy(p);
    notify('Đã lưu tiêu chí duyệt claim', 'teal');
  };
  const toggleDoc = (cat: string, d: string) =>
    setCategories((cs) => cs.map((c) => (c.code === cat ? { ...c, required: c.required.includes(d) ? c.required.filter((x) => x !== d) : [...c.required, d] } : c)));
  return (
      <Collapse defaultOpen={defaultOpen} title="Tiêu chí duyệt claim (áp dụng mọi năm)" summary={`${popDocs.length} loại chứng từ, tối thiểu ${policy.rules.minPhotos} ảnh`} action={<button className={cn(btnPrimary, btnSm)} disabled={!canEdit} onClick={savePolicy}>Lưu quy tắc</button>}>
        <div className="mb-5 grid grid-cols-1 gap-4 sm:grid-cols-4">
          <Field label="Hạn nộp claim sau chương trình (ngày)" error={err('window')}><input className={inputCls} type="number" disabled={!canEdit} value={p.claimWindowDays} onChange={(ev) => setP({ ...p, claimWindowDays: Number(ev.target.value) })} /></Field>
          <Field label="Số ảnh hiện trường tối thiểu" error={err('photos')}><input className={inputCls} type="number" min={1} max={10} disabled={!canEdit} value={p.rules.minPhotos} onChange={(ev) => setP({ ...p, rules: { ...p.rules, minPhotos: Number(ev.target.value) } })} /></Field>
          <label className="flex items-center gap-2 self-end pb-2 text-sm"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canEdit} checked={p.rules.requireWatermark} onChange={(ev) => setP({ ...p, rules: { ...p.rules, requireWatermark: ev.target.checked } })} />Bắt buộc ảnh có watermark</label>
          <label className="flex items-center gap-2 self-end pb-2 text-sm"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canEdit} checked={p.rules.gpsBlocking} onChange={(ev) => setP({ ...p, rules: { ...p.rules, gpsBlocking: ev.target.checked } })} />Thiếu GPS là lỗi chặn</label>
        </div>

        <h3 className="mb-2 text-sm font-semibold">Loại chứng từ</h3>
        <CatalogTable<PopDocDef>
          rows={popDocs}
          rowKey={(r) => r.code}
          entity="loại chứng từ"
          canEdit={canEdit}
          columns={[
            { label: 'Tên chứng từ', render: (r) => r.name },
            { label: 'Loại', render: (r) => (r.system ? <Chip tone="blue">Hệ thống</Chip> : <Chip>Tùy chỉnh</Chip>) },
            { label: 'Dùng ở hạng mục', render: (r) => categories.filter((c) => c.required.includes(r.code)).length },
          ]}
          fields={[{ key: 'name', label: 'Tên chứng từ', type: 'text', wide: true, hint: 'Ảnh hiện trường, hóa đơn GTGT và danh sách ký tên có kiểm tra tự động' }]}
          blank={() => ({ name: '' })}
          toForm={(r) => ({ name: r.name })}
          fromForm={(v, prev) => ({ code: prev?.code ?? codeFrom(String(v.name), popDocs.map((d) => d.code)), name: String(v.name).trim(), system: prev?.system })}
          validate={(v, prev): Record<string, string> => (String(v.name ?? '').trim().length < 3 ? { name: 'Tối thiểu 3 ký tự' } : popDocs.some((d) => d.code !== prev?.code && d.name.toLowerCase() === String(v.name).trim().toLowerCase()) ? { name: 'Tên đã có' } : {})}
          onSave={(row, prev) => { setPopDocs((d) => (prev ? d.map((x) => (x.code === prev.code ? row : x)) : [...d, row])); notify('Đã lưu loại chứng từ', 'teal'); }}
          onDelete={(r) => { setPopDocs((d) => d.filter((x) => x.code !== r.code)); setCategories((cs) => cs.map((c) => ({ ...c, required: c.required.filter((x) => x !== r.code) }))); notify(`Đã xóa ${r.name}`, 'orange'); }}
          deleteBlocked={(r) => (r.system ? 'Chứng từ hệ thống có kiểm tra tự động, không thể xóa. Có thể bỏ yêu cầu ở bảng bên dưới.' : claims.some((c) => c.proofs.some((x) => x.type === r.code)) ? 'Đã có hồ sơ claim tải chứng từ loại này.' : undefined)}
        />

        <h3 className="mb-2 mt-6 text-sm font-semibold">Chứng từ bắt buộc theo hạng mục</h3>
        <Table head={['Chứng từ', ...categories.map((c) => c.name)]} minW={Math.max(720, 180 + categories.length * 110)}>
          {popDocs.map((d) => (
            <tr key={d.code} className={rowCls}>
              <td className={tdFirst}>{d.name}</td>
              {categories.map((c, i) => (
                <td key={c.code} className={i === categories.length - 1 ? tdLast : tdCls}>
                  <input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canEdit} checked={c.required.includes(d.code)} onChange={() => toggleDoc(c.code, d.code)} aria-label={`${d.name} cho ${c.name}`} />
                </td>
              ))}
            </tr>
          ))}
        </Table>
      </Collapse>
  );
}

/** Khai báo / sửa hạn mức một năm: Hãng, MDF, CS và phân bổ từng hạng mục (theo % hoặc số tiền) */
function BudgetYearModal({ year, initialYear, onClose }: { year?: number; initialYear?: number; onClose: () => void }) {
  const { budgets, setBudgets, categories, programs, claims, setFiscalYear, notify, budget } = useApp();
  const existing = budgets.find((b) => b.fiscalYear === year);
  const latest = [...budgets].sort((a, c) => c.fiscalYear - a.fiscalYear)[0];
  const base = existing ?? latest ?? budget;
  const [y, setY] = useState(existing?.fiscalYear ?? initialYear ?? (latest ? latest.fiscalYear + 1 : new Date().getFullYear()));
  const [vendor, setVendor] = useState(base.vendor);
  const [mdf, setMdf] = useState(base.mdfTotal);
  const [cs, setCs] = useState(base.csTotal);
  const [mode, setMode] = useState<'AMOUNT' | 'PERCENT'>('AMOUNT');
  const [alloc, setAlloc] = useState<Record<string, number>>(() => Object.fromEntries(categories.map((c) => [c.code, base.allocations?.[c.code] ?? c.amount])));
  const [touched, setTouched] = useState(false);
  const fundOf = (f: FundCode) => (f === 'MDF' ? mdf : cs);
  const sumOf = (f: FundCode) => categories.filter((c) => c.fund === f).reduce((s, c) => s + (alloc[c.code] ?? 0), 0);
  const usage = existing ? fundUsage(existing.fiscalYear, programs, claims) : { spent: 0, committed: 0 };
  const errs: string[] = [];
  if (!existing && budgets.some((b) => b.fiscalYear === y)) errs.push(`Năm ${y} đã được khai báo`);
  if (y < 2000 || y > 2100) errs.push('Năm không hợp lệ');
  if (vendor.trim().length < 2) errs.push('Nhập tên Hãng tài trợ');
  if (mdf <= 0) errs.push('Nhập hạn mức quỹ MDF');
  if (cs < 0) errs.push('Hạn mức CS không âm');
  if (sumOf('MDF') > mdf) errs.push(`Phân bổ MDF vượt hạn mức ${compact(sumOf('MDF') - mdf)}`);
  if (sumOf('CS') > cs) errs.push(`Phân bổ CS vượt hạn mức ${compact(sumOf('CS') - cs)}`);
  if (existing && mdf + cs < (existing.openingSpent ?? 0) + usage.spent + usage.committed) errs.push(`Tổng trần không thấp hơn số đã tiêu và giữ chỗ (${compact((existing.openingSpent ?? 0) + usage.spent + usage.committed)})`);

  const save = () => {
    setTouched(true);
    if (errs.length) return;
    const rec: Budget = { ...base, fiscalYear: y, vendor: vendor.trim(), mdfTotal: mdf, csTotal: cs, total: mdf + cs, allocations: alloc, periodStart: `${y}-01-01`, periodEnd: `${y}-12-31`, spent: 0, committed: 0, openingSpent: existing?.openingSpent ?? 0, note: existing?.note ?? '', declared: undefined };
    setBudgets((list) => (existing ? list.map((b) => (b.fiscalYear === existing.fiscalYear ? rec : b)) : [...list, rec]));
    if (!existing) setFiscalYear(y);
    notify(existing ? `Đã cập nhật hạn mức năm ${y}` : `Đã khai báo ngân sách năm ${y}: ${compact(mdf + cs)}`, 'teal');
    onClose();
  };

  return (
    <Modal title={existing ? `Sửa hạn mức năm ${y}` : 'Khai báo ngân sách năm mới'} onClose={onClose} wide footer={<><span className="mr-auto self-center text-sm tabular-nums">Tổng trần <b>{vnd(mdf + cs)}</b></span><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>{existing ? 'Lưu' : 'Khai báo'}</button></>}>
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-4">
        <Field label="Năm tài chính"><input className={inputCls} type="number" disabled={!!existing} value={y} onChange={(e) => setY(Number(e.target.value))} /></Field>
        <Field label="Hãng tài trợ" className="sm:col-span-3"><input className={inputCls} value={vendor} onChange={(e) => setVendor(e.target.value)} /></Field>
        <Field label="Hạn mức quỹ MDF" className="sm:col-span-2"><MoneyInput value={mdf} onChange={setMdf} /></Field>
        <Field label="Hạn mức quỹ CS" className="sm:col-span-2"><MoneyInput value={cs} onChange={setCs} /></Field>
      </div>
      <div className="mb-2 mt-5 flex flex-wrap items-center justify-between gap-2">
        <h3 className="text-sm font-semibold">Phân bổ theo hạng mục</h3>
        <div className="flex rounded bg-[#0F141E] p-0.5 text-xs" role="radiogroup" aria-label="Cách nhập">
          {(['AMOUNT', 'PERCENT'] as const).map((m) => <button key={m} role="radio" aria-checked={mode === m} className={cn('rounded-md px-3 py-1.5 font-medium', mode === m ? 'g-brand font-semibold text-[#0F141E]' : 'text-[#94A3B8]')} onClick={() => setMode(m)}>{m === 'AMOUNT' ? 'Số tiền' : 'Tỷ lệ %'}</button>)}
        </div>
      </div>
      {(['MDF', 'CS'] as FundCode[]).map((f) => (
        <div key={f} className="mb-4">
          <p className={cn('mb-1.5 text-xs font-medium', sumOf(f) > fundOf(f) ? 'text-[#F87171]' : 'text-[#94A3B8]')}>{FUND_LABEL[f]}: đã phân bổ {compact(sumOf(f))} / {compact(fundOf(f))}{fundOf(f) > sumOf(f) ? `, còn ${compact(fundOf(f) - sumOf(f))}` : ''}</p>
          <div className="grid grid-cols-1 gap-2 sm:grid-cols-2">
            {categories.filter((c) => c.fund === f).map((c) => {
              const amt = alloc[c.code] ?? 0;
              const pctv = fundOf(f) ? Math.round((amt / fundOf(f)) * 1000) / 10 : 0;
              return (
                <label key={c.code} className="flex items-center gap-2 rounded bg-[#1C2534] px-3 py-2 text-sm">
                  <i className="h-2 w-2 shrink-0 rounded-full" style={{ background: c.color }} />
                  <span className="min-w-0 flex-1 truncate">{c.name}</span>
                  {mode === 'AMOUNT' ? (
                    <input className={cn(inputBase, 'w-36 py-1 text-right text-xs tabular-nums')} inputMode="numeric" value={amt ? amt.toLocaleString('vi-VN') : ''} onChange={(e) => setAlloc({ ...alloc, [c.code]: digits(e.target.value) })} aria-label={`Ngân sách ${c.name}`} />
                  ) : (
                    <span className="flex items-center gap-1"><input className={cn(inputBase, 'w-20 py-1 text-right text-xs tabular-nums')} type="number" min={0} max={100} step={0.5} value={pctv} onChange={(e) => setAlloc({ ...alloc, [c.code]: Math.round((fundOf(f) * Number(e.target.value)) / 100) })} aria-label={`Tỷ lệ ${c.name}`} />%<span className="w-16 text-right text-[11px] tabular-nums text-[#94A3B8]">{compact(amt)}</span></span>
                  )}
                </label>
              );
            })}
          </div>
        </div>
      ))}
      {touched && errs.length > 0 && <ul className="space-y-0.5 text-xs text-[#F87171]">{errs.map((x) => <li key={x}>{x}</li>)}</ul>}
    </Modal>
  );
}

/** Cấu hình một năm: hạn mức, ngân sách từng hạng mục (thêm / sửa / xóa) và tiêu chí claim */
function YearConfigModal({ onClose }: { onClose: () => void }) {
  const { budget } = useApp();
  const [editLimits, setEditLimits] = useState(false);
  return (
    <div className="fixed inset-0 z-50 flex flex-col bg-[#0F141E]" role="dialog" aria-modal="true" aria-label="Cấu hình năm tài chính">
      <header className="flex items-center gap-3 border-b border-[#263044] px-4 py-3 pt-[calc(0.75rem+env(safe-area-inset-top))] sm:px-6">
        <Settings className="h-5 w-5 text-[#F28C33]" aria-hidden />
        <div className="min-w-0 flex-1">
          <p className="truncate font-semibold">Cấu hình hạng mục & tiêu chí claim năm {budget.fiscalYear}</p>
          <p className="truncate text-xs text-[#94A3B8]">{budget.vendor}: MDF {compact(budget.mdfTotal)} + CS {compact(budget.csTotal)} = {compact(budget.total)}</p>
        </div>
        <button className={cn(btnGhost, btnSm)} onClick={() => setEditLimits(true)}><Pencil className="h-3.5 w-3.5" aria-hidden />Sửa hạn mức</button>
        <button className={cn(btnGhost, 'p-2')} onClick={onClose} aria-label="Đóng"><X className="h-5 w-5" /></button>
      </header>
      <div className="flex-1 space-y-4 overflow-y-auto p-4 sm:p-6">
        <Collapse defaultOpen title={`Ngân sách MDF theo hạng mục (${budget.fiscalYear})`}><CategoryTable fund="MDF" /></Collapse>
        <Collapse defaultOpen title={`Ngân sách CS theo hạng mục (${budget.fiscalYear})`}><CategoryTable fund="CS" /></Collapse>
        <ClaimRulesSection />
      </div>
      {editLimits && <BudgetYearModal year={budget.fiscalYear} onClose={() => setEditLimits(false)} />}
    </div>
  );
}

function FundSettings() {
  const { budget, budgets, setBudgets, setFiscalYear, programs, canDo } = useApp();
  const canEdit = canDo('settings.edit');
  const [declare, setDeclare] = useState<{ year?: number } | null>(null);
  const [config, setConfig] = useState(false);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const rows = [...budgets].sort((a, c) => c.fiscalYear - a.fiscalYear);
  return (
    <div className="space-y-4">
      {budget.declared === false && (
        <div className="flex flex-col gap-2 rounded-md border border-[#F28C33]/40 bg-[#F28C33]/10 px-4 py-3 sm:flex-row sm:items-center">
          <AlertTriangle className="hidden h-5 w-5 text-[#F7B23B] sm:block" aria-hidden />
          <p className="flex-1 text-sm text-[#F7B23B]">Năm {budget.fiscalYear} (đang chọn trên bộ lọc thời gian) chưa khai báo ngân sách Hãng.</p>
          <button className={cn(btnPrimary, btnSm)} disabled={!canEdit} onClick={() => setDeclare({ year: budget.fiscalYear })}><Plus className="h-3.5 w-3.5" aria-hidden />Khai báo năm {budget.fiscalYear}</button>
        </div>
      )}
      <Panel title="Hạn mức quỹ theo năm" action={<button className={cn(btnPrimary, btnSm)} disabled={!canEdit} onClick={() => setDeclare({})}><Plus className="h-3.5 w-3.5" aria-hidden />Khai báo ngân sách năm mới</button>}>
        <Table head={['Năm tài chính', 'Hãng tài trợ', 'Hạn mức MDF', 'Hạn mức CS', 'Tổng trần', 'Thao tác']} minW={860}>
          {rows.map((x) => {
            const active = x.fiscalYear === budget.fiscalYear;
            return (
              <tr key={x.fiscalYear} className={cn(rowCls, active && 'bg-[#F28C33]/5')}>
                <td className={tdFirst}><b className="tabular-nums">{x.fiscalYear}</b>{active && <Chip tone="orange">Đang kích hoạt</Chip>}</td>
                <td className={tdCls}>{x.vendor}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{vnd(x.mdfTotal)}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{vnd(x.csTotal)}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums font-semibold')}>{vnd(x.mdfTotal + x.csTotal)}</td>
                <td className={cn(tdLast, 'whitespace-nowrap')}>
                  <button className={cn(btnGhost, btnSm, 'mr-1')} onClick={() => { setFiscalYear(x.fiscalYear); setConfig(true); }}><Settings className="h-3.5 w-3.5" aria-hidden />Cấu hình hạng mục & tiêu chí claim</button>
                  <button className={cn(btnGhost, 'p-1.5 hover:text-[#F87171]')} disabled={!canEdit} onClick={() => setConfirm({
                    title: `Xóa ngân sách năm ${x.fiscalYear}`, message: <>Xóa khai báo ngân sách năm {x.fiscalYear}?</>,
                    blocked: programs.some((p) => progYear(p) === x.fiscalYear) ? 'Năm này đã có chương trình / claim, giữ lại để tra cứu lịch sử.' : undefined,
                    onConfirm: () => setBudgets((list) => list.filter((y) => y.fiscalYear !== x.fiscalYear)),
                  })} aria-label={`Xóa năm ${x.fiscalYear}`}><Trash2 className="h-3.5 w-3.5" /></button>
                </td>
              </tr>
            );
          })}
        </Table>
        <p className="mt-3 text-xs text-[#94A3B8]">Năm đang kích hoạt theo bộ lọc thời gian trên header. Số đã tiêu, giữ chỗ, còn lại xem ở Tổng quan và Hồ sơ MDF.</p>
      </Panel>
      <ClaimRulesSection />
      {declare && <BudgetYearModal initialYear={declare.year} onClose={() => setDeclare(null)} />}
      {config && <YearConfigModal onClose={() => setConfig(false)} />}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

// ---------------- Phân loại khách hàng: nhóm & hạng ----------------

function SegmentSettings() {
  const { segments, setSegments, tierRules, setTierRules, customers, setCustomers, leads, departments, canDo, notify } = useApp();
  const canEdit = canDo('settings.edit');
  const routable = departments.filter((d) => d.active && d.receivesLeads);
  const deptOpts: Opt[] = routable.map((d) => ({ value: d.code, label: d.name }));
  const mismatched = customers.filter((c) => tierFor(c.ytdRevenue, tierRules) !== c.tier);
  const dShort = (code: string) => departments.find((d) => d.code === code)?.short ?? code;

  return (
    <div className="space-y-4">
      <Collapse title="Nhóm khách hàng (đại lý / nhà thầu)" summary={`${segments.length} nhóm, phân lead theo khu vực Bắc / Nam`}>
        <p className="mb-3 text-sm text-[#94A3B8]">Khi Marketing phân lead tự động: khách hiện hữu giữ phòng đang phụ trách, còn lại chọn phòng theo nhóm và khu vực của lead.</p>
        <CatalogTable<SegmentDef>
          rows={segments}
          rowKey={(r) => r.code}
          entity="nhóm khách hàng"
          canEdit={canEdit}
          columns={[
            { label: 'Nhóm', render: (r) => r.name },
            { label: 'Miền Bắc', render: (r) => dShort(r.deptNorth) },
            { label: 'Miền Nam', render: (r) => dShort(r.deptSouth) },
            { label: 'Nhận MDF', render: (r) => (r.mdfEligible ? <Chip tone="teal">Có</Chip> : <Chip>Không</Chip>) },
            { label: 'Điểm lead', render: (r) => r.points },
            { label: 'Khách / lead', render: (r) => `${customers.filter((c) => c.segment === r.code).length} / ${leads.filter((l) => l.segment === r.code).length}` },
          ]}
          fields={[
            { key: 'name', label: 'Tên nhóm', type: 'text', wide: true },
            { key: 'deptNorth', label: 'Phòng tiếp nhận Miền Bắc', type: 'select', options: deptOpts },
            { key: 'deptSouth', label: 'Phòng tiếp nhận Miền Nam', type: 'select', options: deptOpts },
            { key: 'points', label: 'Điểm chấm lead (0–20)', type: 'number' },
            { key: 'mdfEligible', label: 'Thuộc diện nhận quỹ MDF / CS', type: 'checkbox' },
          ]}
          blank={() => ({ name: '', deptNorth: routable[0]?.code ?? '', deptSouth: routable[0]?.code ?? '', points: 10, mdfEligible: true })}
          toForm={(r) => ({ ...r })}
          fromForm={(v, prev) => ({ code: prev?.code ?? codeFrom(String(v.name), segments.map((s) => s.code)), name: String(v.name).trim(), deptNorth: String(v.deptNorth), deptSouth: String(v.deptSouth), points: Number(v.points), mdfEligible: !!v.mdfEligible, system: prev?.system })}
          validate={(v, prev) => {
            const e: Record<string, string> = {};
            if (String(v.name ?? '').trim().length < 3) e.name = 'Tối thiểu 3 ký tự';
            else if (segments.some((s) => s.code !== prev?.code && s.name.toLowerCase() === String(v.name).trim().toLowerCase())) e.name = 'Tên nhóm đã có';
            if (!v.deptNorth) e.deptNorth = 'Chọn phòng';
            if (!v.deptSouth) e.deptSouth = 'Chọn phòng';
            if (Number(v.points) < 0 || Number(v.points) > 20) e.points = 'Từ 0 đến 20';
            return e;
          }}
          onSave={(row, prev) => { setSegments((p) => (prev ? p.map((s) => (s.code === prev.code ? row : s)) : [...p, row])); notify(`Đã lưu nhóm ${row.name}`, 'teal'); }}
          onDelete={(r) => { setSegments((p) => p.filter((s) => s.code !== r.code)); notify(`Đã xóa nhóm ${r.name}`, 'orange'); }}
          deleteBlocked={(r) => {
            if (r.system) return 'Nhóm mặc định của hệ thống, không thể xóa.';
            const n = customers.filter((c) => c.segment === r.code).length + leads.filter((l) => l.segment === r.code).length;
            return n ? `Đang có ${n} khách hàng / lead thuộc nhóm này. Chuyển sang nhóm khác trước khi xóa.` : undefined;
          }}
        />
      </Collapse>

      <Collapse
        title="Hạng khách hàng và hạn mức tài trợ"
        summary={`${tierRules.length} hạng${mismatched.length ? `, ${mismatched.length} khách lệch hạng` : ''}`}
        action={<button className={cn(btnGhost, btnSm)} disabled={!canEdit || !mismatched.length} onClick={() => { setCustomers((p) => p.map((c) => ({ ...c, tier: tierFor(c.ytdRevenue, tierRules) }))); notify(`Đã phân hạng lại ${mismatched.length} khách hàng`, 'teal'); }}><Zap className="h-3.5 w-3.5" aria-hidden />Áp dụng phân hạng tự động ({mismatched.length})</button>}
      >
        <CatalogTable<TierRule>
          rows={[...tierRules].sort((a, b) => b.minRevenue - a.minRevenue)}
          rowKey={(r) => r.tier}
          entity="hạng"
          canEdit={canEdit}
          columns={[
            { label: 'Hạng', render: (r) => r.name },
            { label: 'Doanh số năm từ', render: (r) => <span className="tabular-nums">{compact(r.minRevenue)}</span> },
            { label: 'Hạn mức MDF / năm', render: (r) => <span className="tabular-nums">{compact(r.mdfCap)}</span> },
            { label: 'Hiển thị', render: (r) => <Chip tone={r.tone}>{r.name}</Chip> },
            { label: 'Khách hiện tại / theo quy tắc', render: (r) => `${customers.filter((c) => c.tier === r.tier).length} / ${customers.filter((c) => tierFor(c.ytdRevenue, tierRules) === r.tier).length}` },
          ]}
          fields={[
            { key: 'name', label: 'Tên hạng', type: 'text' },
            { key: 'tone', label: 'Màu nhãn', type: 'select', options: TONES.map((t) => ({ value: t, label: { blue: 'Xanh dương', orange: 'Cam', teal: 'Xanh ngọc', muted: 'Xám', red: 'Đỏ' }[t] })) },
            { key: 'minRevenue', label: 'Doanh số năm từ', type: 'money' },
            { key: 'mdfCap', label: 'Hạn mức tài trợ MDF / năm', type: 'money' },
          ]}
          blank={() => ({ name: '', tone: 'muted', minRevenue: 0, mdfCap: 0 })}
          toForm={(r) => ({ ...r })}
          fromForm={(v, prev) => ({ tier: prev?.tier ?? codeFrom(String(v.name), tierRules.map((t) => t.tier)), name: String(v.name).trim(), tone: v.tone as Tone, minRevenue: Number(v.minRevenue), mdfCap: Number(v.mdfCap) })}
          validate={(v, prev) => {
            const e: Record<string, string> = {};
            if (String(v.name ?? '').trim().length < 2) e.name = 'Nhập tên hạng';
            if (tierRules.some((t) => t.tier !== prev?.tier && t.minRevenue === Number(v.minRevenue))) e.minRevenue = 'Ngưỡng doanh số trùng với hạng khác';
            if (prev && prev.minRevenue === 0 && Number(v.minRevenue) !== 0 && !tierRules.some((t) => t.tier !== prev.tier && t.minRevenue === 0)) e.minRevenue = 'Cần giữ một hạng có ngưỡng 0 cho khách mới';
            if (Number(v.mdfCap) < 0) e.mdfCap = 'Không âm';
            return e;
          }}
          onSave={(row, prev) => { setTierRules((p) => (prev ? p.map((t) => (t.tier === prev.tier ? row : t)) : [...p, row])); notify(`Đã lưu hạng ${row.name}`, 'teal'); }}
          onDelete={(r) => { setTierRules((p) => p.filter((t) => t.tier !== r.tier)); notify(`Đã xóa hạng ${r.name}`, 'orange'); }}
          deleteBlocked={(r) => {
            const n = customers.filter((c) => c.tier === r.tier).length;
            if (n) return `Đang có ${n} khách hàng thuộc hạng này. Phân hạng lại trước khi xóa.`;
            if (r.minRevenue === 0) return 'Hạng có ngưỡng 0 dành cho khách mới, không thể xóa.';
            return undefined;
          }}
        />
      </Collapse>
    </div>
  );
}

// =====================================================================
//  GETFLY: TAB "LỊCH SỬ ĐƠN HÀNG GETFLY" TRONG THẺ KHÁCH HÀNG 360
// =====================================================================

function GetflyOrdersPanel({ customer: c }: { customer: Customer }) {
  const { getflyOrders, claims, programs, budget, getfly } = useApp();
  const [from, setFrom] = useState('');
  const [to, setTo] = useState('');
  const [q, setQ] = useState('');
  const [band, setBand] = useState<'ALL' | 'LT200' | '200_1000' | 'GT1000'>('ALL');
  const all = getflyOrders.filter((o) => o.customerId === c.id).sort((a, b) => b.orderDate.localeCompare(a.orderDate));

  if (!c.getflyAccountId) {
    return (
      <div className="rounded-md border border-dashed border-[#263044] p-6 text-center text-sm text-[#94A3B8]">
        <Plug className="mx-auto mb-2 h-6 w-6 text-[#94A3B8]" aria-hidden />
        Khách hàng chưa liên kết Getfly. Liên kết tự động khi dự án chốt đơn được đồng bộ, hoặc khi webhook đơn hàng khớp MST / số điện thoại.
      </div>
    );
  }

  const bandOk = (v: number) => band === 'ALL' || (band === 'LT200' && v < 200e6) || (band === '200_1000' && v >= 200e6 && v <= 1e9) || (band === 'GT1000' && v > 1e9);
  const orders = all.filter((o) => (!from || o.orderDate >= from) && (!to || o.orderDate <= to) && (!q.trim() || o.orderCode.toLowerCase().includes(q.trim().toLowerCase())) && bandOk(o.gross));
  // Doanh thu Getfly = tổng đơn đã duyệt (chưa VAT) trong năm tài chính -> dùng tính đòn bẩy
  const gfRevenue = all.filter((o) => o.approved && o.orderDate.startsWith(String(budget.fiscalYear))).reduce((s, o) => s + o.net, 0);
  const debt = all.filter((o) => o.approved).reduce((s, o) => s + Math.max(0, o.gross - o.paid), 0);
  const mdf = mdfOfCustomer(c.id, claims, programs);
  const roi = mdf ? gfRevenue / mdf : null;
  const r = roiRating(roi);
  const orderUrl = (id: number) => `${getfly.baseUrl.replace(/\/+$/, '')}/orders/view/${id}`;

  return (
    <div className="space-y-4">
      <div className="flex flex-wrap items-center gap-2 text-sm">
        <Chip tone="teal"><Link2 className="h-3 w-3" aria-hidden />Getfly {c.getflyAccountCode}</Chip>
        <span className="text-[#94A3B8]">account_id {c.getflyAccountId}</span>
      </div>

      <section className="rounded-md border border-[#263044] bg-[#1C2534] p-4">
        <p className="text-xs text-[#94A3B8]">MDF ROI = Doanh thu Getfly / Quỹ MDF tài trợ</p>
        <div className="mt-1 flex flex-wrap items-end justify-between gap-3">
          <p className="text-2xl font-semibold tabular-nums text-[#F1F5F9]">{roi ? `${roi.toFixed(1)} lần` : '—'}</p>
          <Chip tone={r.tone}>{r.label}</Chip>
        </div>
        <p className="mt-1 text-sm tabular-nums text-[#94A3B8]">{vnd(gfRevenue)} / {mdf ? vnd(mdf) : 'chưa nhận MDF'}</p>
        <div className="mt-3 grid grid-cols-3 gap-3 text-sm">
          <div><p className="text-xs text-[#94A3B8]">Số đơn</p><p className="tabular-nums">{all.length}</p></div>
          <div><p className="text-xs text-[#94A3B8]">Chờ duyệt</p><p className="tabular-nums">{all.filter((o) => !o.approved).length}</p></div>
          <div><p className="text-xs text-[#94A3B8]">Công nợ Getfly</p><p className={cn('tabular-nums', debt > c.creditLimit && 'text-[#F87171]')}>{compact(debt)}</p></div>
        </div>
      </section>

      <div className="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <Field label="Từ ngày"><input className={cn(inputCls, 'py-1.5')} type="date" value={from} onChange={(e) => setFrom(e.target.value)} /></Field>
        <Field label="Đến ngày"><input className={cn(inputCls, 'py-1.5')} type="date" value={to} onChange={(e) => setTo(e.target.value)} /></Field>
        <Field label="Mã đơn"><input className={cn(inputCls, 'py-1.5')} value={q} onChange={(e) => setQ(e.target.value)} placeholder="DH18..." /></Field>
        <Field label="Giá trị đơn">
          <select className={cn(inputCls, 'py-1.5')} value={band} onChange={(e) => setBand(e.target.value as typeof band)}>
            <option value="ALL">Mọi giá trị</option>
            <option value="LT200">Dưới 200 triệu</option>
            <option value="200_1000">200 triệu – 1 tỷ</option>
            <option value="GT1000">Trên 1 tỷ</option>
          </select>
        </Field>
      </div>

      <div className="-mx-6 overflow-x-auto">
        <table className="w-full min-w-[640px] text-left text-sm">
          <thead className="text-xs text-[#94A3B8]">
            <tr className="border-b border-[#263044]">
              <th className="py-2 pl-6 pr-3 font-medium">Mã đơn hàng</th>
              <th className="px-3 py-2 font-medium">Ngày</th>
              <th className="px-3 py-2 text-right font-medium">Giá trị (gồm VAT)</th>
              <th className="px-3 py-2 text-right font-medium">Còn nợ</th>
              <th className="py-2 pl-3 pr-6 font-medium">Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            {orders.map((o) => {
              const pay = paymentLabel(o);
              return (
                <tr key={o.orderId} className="border-b border-[#263044]/60">
                  <td className="py-2.5 pl-6 pr-3">
                    <a href={orderUrl(o.orderId)} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1 font-medium text-[#6FA8F0] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F28C33]" title="Mở đơn trên Getfly CRM (tab mới)">
                      {o.orderCode}<ExternalLink className="h-3.5 w-3.5" aria-hidden />
                    </a>
                    <p className="text-xs text-[#94A3B8]">{o.source === 'MDF_APP' ? `Từ dự án ${o.leadCode}` : 'Tạo trên Getfly'}, {o.lines} dòng</p>
                    {o.products?.length ? <p className="max-w-[320px] text-[11px] text-[#94A3B8]">{o.products.map((p) => `${p.code} x${p.qty.toLocaleString('vi-VN')}`).join(', ')}</p> : null}
                  </td>
                  <td className="px-3 py-2.5 tabular-nums">{fmtDate(o.orderDate)}</td>
                  <td className="px-3 py-2.5 text-right tabular-nums">{vnd(o.gross)}</td>
                  <td className="px-3 py-2.5 text-right tabular-nums">{vnd(Math.max(0, o.gross - o.paid))}</td>
                  <td className="py-2.5 pl-3 pr-6">
                    <div className="flex flex-wrap gap-1">
                      <Chip tone={o.approved ? 'blue' : 'orange'}>{o.approved ? 'Đã duyệt' : 'Chờ duyệt'}</Chip>
                      <Chip tone={pay.tone}>{pay.label}</Chip>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {!orders.length && <p className="text-center text-sm text-[#94A3B8]">{all.length ? 'Không có đơn khớp bộ lọc.' : 'Chưa có đơn hàng nào.'}</p>}
    </div>
  );
}

// =====================================================================
//  GETFLY: TAB CÀI ĐẶT "CẤU HÌNH GETFLY API"
//  Bản demo mô phỏng phản hồi Getfly. Khi nối backend, thay các hàm dưới bằng:
//   Lưu -> saveGetflySettings | Kiểm tra -> testGetflyConnection | Đồng bộ -> syncAllRevenueFromGetfly
// =====================================================================

type HookEvent = 'order.created' | 'order.approved' | 'order.updated';
const HOOK_LABEL: Record<HookEvent, string> = {
  'order.created': 'Tạo đơn hàng mới',
  'order.approved': 'Duyệt đơn hàng',
  'order.updated': 'Sửa đơn / ghi nhận thanh toán công nợ',
};

const FIELD_MAP: [string, string, string][] = [
  ['Khách hàng', 'Tên công ty', 'account.account_name'],
  ['Khách hàng', 'Mã số thuế', 'custom_fields[ma_so_thue] (trường tùy biến)'],
  ['Khách hàng', 'Số điện thoại', 'account.phone_office'],
  ['Khách hàng', 'Địa chỉ', 'account.billing_address_street'],
  ['Khách hàng', 'Người liên hệ', 'contacts[0].first_name, phone_home, email'],
  ['Khách hàng', 'Liên kết đối soát', 'account_id, account_code'],
  ['Đơn hàng', 'Mã khách Getfly', 'order_info.account_code'],
  ['Đơn hàng', 'Ngày chốt đơn', 'order_info.order_date (d/m/Y)'],
  ['Đơn hàng', 'Bảo vệ giá Hãng duyệt', 'order_info.discount, discount_amount'],
  ['Đơn hàng', 'Mã dự án VASSH-CRM', 'order_info.source_name, terms[]'],
  ['Đơn hàng', 'Dòng BOQ: mã, tên, SL, đơn giá', 'products[].product_code, product_name, quantity, price'],
  ['Đơn hàng', 'Chiết khấu dòng BOQ', 'products[].product_sale_off, cash_discount'],
  ['Chiều về', 'Doanh số ròng', 'order_info.amount trừ VAT các dòng'],
  ['Chiều về', 'Đã thanh toán / công nợ', 'payments[], payment_status'],
];

function GetflySettings() {
  const { getfly, setGetfly, getflyOrders, setGetflyOrders, customers, getflyLogs, addGetflyLog, recomputeLinked, canDo, role, notify, budget } = useApp();
  const canEdit = canDo('settings.edit');
  const canRun = canEdit || role === 'MKT_LEAD';
  const [f, setF] = useState<GetflyConfig>(getfly);
  const [touched, setTouched] = useState(false);
  const [showKey, setShowKey] = useState(false);
  const [showSecret, setShowSecret] = useState(false);
  const [busy, setBusy] = useState<'test' | 'sync' | 'hook' | null>(null);
  const [origin, setOrigin] = useState('');
  useEffect(() => setOrigin(window.location.origin), []);

  const linked = customers.filter((c) => c.getflyAccountId);
  const [hookCustomer, setHookCustomer] = useState(linked[0]?.id ?? '');
  const [hookEvent, setHookEvent] = useState<HookEvent>('order.created');
  const [hookOrder, setHookOrder] = useState('');
  const [hookAmount, setHookAmount] = useState(150_000_000);
  const [hookToken, setHookToken] = useState(getfly.webhookSecret);
  const [resend, setResend] = useState(false);
  const [lastUid, setLastUid] = useState('');
  const [processed, setProcessed] = useState<string[]>([]);

  const e: Partial<Record<keyof GetflyConfig, string>> = {};
  // Chế độ mô phỏng: cho phép lưu khi chưa có thông tin kết nối thật
  if (!f.demoMode) {
    if (!/^https:\/\/[^\s/]+\.[^\s/]+/.test(f.baseUrl)) e.baseUrl = 'Dạng https://tencongty.getflycrm.com';
    if (!/^[A-Za-z0-9]{20,64}$/.test(f.apiKey)) e.apiKey = 'API Key gồm 20–64 ký tự chữ và số (Getfly cấp 30 ký tự)';
    if (f.webhookSecret.length < 24) e.webhookSecret = 'Tối thiểu 24 ký tự';
  }
  if (!/^[a-z0-9_]{2,64}$/.test(f.taxCodeField)) e.taxCodeField = 'Chữ thường, số, dấu _';
  const err = (k: keyof GetflyConfig) => (touched ? e[k] : undefined);
  const dirty = JSON.stringify({ ...f, lastTest: undefined, lastFullSyncAt: undefined }) !== JSON.stringify({ ...getfly, lastTest: undefined, lastFullSyncAt: undefined });
  const webhookUrl = `${origin || 'https://app-cua-ban.vn'}/api/webhooks/getfly?token=${encodeURIComponent(getfly.webhookSecret)}`;
  const delay = (ms: number) => new Promise((r) => setTimeout(r, ms));

  const save = () => {
    setTouched(true);
    if (Object.keys(e).length) return;
    setGetfly((p) => ({ ...f, baseUrl: f.baseUrl.replace(/\/+$/, ''), lastTest: p.lastTest, lastFullSyncAt: p.lastFullSyncAt }));
    setHookToken(f.webhookSecret);
    notify('Đã lưu cấu hình Getfly. API Key và Secret được mã hóa khi lưu ở backend.', 'teal');
  };

  const genSecret = () => {
    const a = new Uint8Array(24);
    crypto.getRandomValues(a);
    const s = 'whsec_' + btoa(String.fromCharCode(...a)).replace(/[+/=]/g, '').slice(0, 32);
    setF((p) => ({ ...p, webhookSecret: s }));
  };

  /** Mô phỏng testGetflyConnection: GET /api/v3/accounts?limit=1 */
  const test = async () => {
    setBusy('test');
    const t0 = Date.now();
    await delay(600 + Math.random() * 500);
    const ms = Date.now() - t0;
    let ok = true;
    let message: string;
    if (!/^https:\/\/.+/.test(f.baseUrl)) { ok = false; message = 'Base URL không hợp lệ'; }
    else if (!/^[A-Za-z0-9]{30}$/.test(f.apiKey)) { ok = false; message = 'API Key không hợp lệ hoặc không đủ quyền (HTTP 401)'; }
    else {
      const host = f.baseUrl.replace(/^https:\/\//, '').replace(/\/.*$/, '');
      message = `Kết nối thành công tới ${host} (${ms} ms)${host.endsWith('.getflycrm.com') ? '' : '. Lưu ý: tên miền không thuộc getflycrm.com'}`;
    }
    setGetfly((p) => ({ ...p, lastTest: { at: Date.now(), ok, message } }));
    addGetflyLog({ direction: 'OUT', title: 'Kiểm tra kết nối', ok, detail: message });
    notify(message, ok ? 'teal' : 'red');
    setBusy(null);
  };

  /** Mô phỏng syncAllRevenueFromGetfly: kéo đơn bán trong kỳ, tính lại doanh số, công nợ, ROI */
  const fullSync = async () => {
    if (!getfly.isActive) return notify('Kết nối Getfly đang tắt', 'red');
    setBusy('sync');
    await delay(1200);
    const counted = getflyOrders.filter((o) => o.approved && linked.some((c) => c.id === o.customerId));
    recomputeLinked(getflyOrders);
    setGetfly((p) => ({ ...p, lastFullSyncAt: Date.now() }));
    const msg = `${counted.length} đơn đã duyệt / ${linked.length} khách hàng liên kết. Đã tính lại doanh số lũy kế, công nợ và MDF ROI.`;
    addGetflyLog({ direction: 'IN', title: 'Đồng bộ toàn bộ doanh số', ok: true, detail: msg });
    notify(msg, 'teal');
    setBusy(null);
  };

  /** Mô phỏng route /api/webhooks/getfly: token -> uid chống trùng -> đọc đơn -> tính lại */
  const sendHook = async () => {
    setBusy('hook');
    await delay(500);
    const uid = resend && lastUid ? lastUid : crypto.randomUUID();
    const cust = customers.find((c) => c.id === hookCustomer);
    const log = (ok: boolean, detail: string) => addGetflyLog({ direction: 'IN', title: `Webhook ${hookEvent}`, ok, detail: `uid ${uid.slice(0, 8)}: ${detail}` });
    try {
      if (!getfly.isActive) return log(false, 'HTTP 503, kết nối đang tắt');
      if (hookToken !== getfly.webhookSecret) return log(false, 'HTTP 401, token không khớp Webhook Secret');
      if (processed.includes(uid)) return log(true, 'HTTP 200, uid đã xử lý trước đó nên bỏ qua (chống trùng)');
      if (!cust) return log(false, 'Không tìm thấy khách hàng khớp account_id / MST / SĐT, đã bỏ qua');

      let next = getflyOrders;
      let detail = '';
      if (hookEvent === 'order.created') {
        if (hookAmount <= 0) return log(false, 'Giá trị đơn phải lớn hơn 0');
        const id = Math.max(18300, ...getflyOrders.map((o) => o.orderId)) + 1;
        const vat = Math.round((hookAmount * getfly.defaultVatPct) / 100);
        next = [{ orderId: id, orderCode: `DH${id}`, customerId: cust.id, orderDate: todayISO(), net: hookAmount, vat, gross: hookAmount + vat, paid: 0, approved: false, source: 'GETFLY', lines: 1 }, ...getflyOrders];
        detail = `Nhận đơn DH${id} (${compact(hookAmount + vat)}) của ${cust.name}, chờ duyệt nên chưa tính doanh số`;
      } else {
        const o = getflyOrders.find((x) => x.orderCode === hookOrder && x.customerId === cust.id);
        if (!o) return log(false, 'Chọn đơn hàng cần cập nhật');
        if (hookEvent === 'order.approved') {
          next = getflyOrders.map((x) => (x.orderCode === o.orderCode ? { ...x, approved: true } : x));
          detail = `Đơn ${o.orderCode} đã duyệt, cộng ${compact(o.net)} doanh số ròng cho ${cust.name}`;
        } else {
          const pay = Math.min(hookAmount, o.gross - o.paid);
          if (pay <= 0) return log(false, `Đơn ${o.orderCode} đã thanh toán đủ`);
          next = getflyOrders.map((x) => (x.orderCode === o.orderCode ? { ...x, paid: x.paid + pay } : x));
          detail = `Đơn ${o.orderCode} ghi nhận thanh toán ${compact(pay)}, giảm công nợ ${cust.name}`;
        }
      }
      setGetflyOrders(next);
      recomputeLinked(next, [cust.id]);
      const fin = financialsFromOrders(cust.id, next, budget.fiscalYear);
      log(true, `${detail}. Doanh số Getfly năm ${compact(fin.ytd)}, công nợ ${compact(fin.debt)}`);
      notify(detail, 'teal');
    } finally {
      setProcessed((p) => (p.includes(uid) ? p : [...p, uid]));
      setLastUid(uid);
      setBusy(null);
    }
  };

  const custOrders = getflyOrders.filter((o) => o.customerId === hookCustomer);
  const orderOptions = hookEvent === 'order.approved' ? custOrders.filter((o) => !o.approved) : custOrders.filter((o) => o.approved && o.paid < o.gross);

  return (
    <div className="space-y-5">
      <Panel
        title="Thông tin kết nối Getfly API v3"
        action={getfly.lastTest && <Chip tone={getfly.lastTest.ok ? 'teal' : 'red'}>{getfly.lastTest.ok ? 'Kết nối tốt' : 'Lỗi kết nối'}, {new Date(getfly.lastTest.at).toLocaleTimeString('vi-VN')}</Chip>}
      >
        <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
          <Field label="Getfly Base URL (Domain)" error={err('baseUrl')} hint="VD: https://tencongty.getflycrm.com">
            <input className={inputCls} disabled={!canEdit} value={f.baseUrl} onChange={(ev) => setF({ ...f, baseUrl: ev.target.value.trim() })} placeholder="https://tencongty.getflycrm.com" />
          </Field>
          <Field label="Getfly API Key" error={err('apiKey')} hint="Getfly > Cài đặt > Tích hợp > Tích hợp phần mềm khác > Getfly API Key">
            <div className="flex gap-2">
              <input className={inputCls} disabled={!canEdit} type={showKey ? 'text' : 'password'} autoComplete="off" value={f.apiKey} onChange={(ev) => setF({ ...f, apiKey: ev.target.value.trim() })} />
              <button type="button" className={cn(btnGhost, 'shrink-0')} onClick={() => setShowKey((v) => !v)}>{showKey ? 'Ẩn' : 'Hiện'}</button>
            </div>
          </Field>
          <Field label="Webhook Secret Token" error={err('webhookSecret')} hint="Gắn vào URL webhook, dùng để xác thực sự kiện từ Getfly">
            <div className="flex gap-2">
              <input className={inputCls} disabled={!canEdit} type={showSecret ? 'text' : 'password'} autoComplete="off" value={f.webhookSecret} onChange={(ev) => setF({ ...f, webhookSecret: ev.target.value.trim() })} />
              <button type="button" className={cn(btnGhost, 'shrink-0')} onClick={() => setShowSecret((v) => !v)}>{showSecret ? 'Ẩn' : 'Hiện'}</button>
              <button type="button" className={cn(btnGhost, 'shrink-0')} disabled={!canEdit} onClick={genSecret}>Tạo mới</button>
            </div>
          </Field>
          <Field label="Mã trường Mã số thuế trên Getfly" error={err('taxCodeField')} hint="Getfly không có trường MST mặc định: tạo trường này ở Định nghĩa dữ liệu khách hàng">
            <input className={inputCls} disabled={!canEdit} value={f.taxCodeField} onChange={(ev) => setF({ ...f, taxCodeField: ev.target.value.trim() })} />
          </Field>
          <Field label="VAT mặc định cho dòng BOQ (%)">
            <input className={inputCls} disabled={!canEdit} type="number" min={0} max={20} value={f.defaultVatPct} onChange={(ev) => setF({ ...f, defaultVatPct: Number(ev.target.value) })} />
          </Field>
          <label className="flex items-center gap-2 self-end pb-2 text-sm text-[#F1F5F9]">
            <input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canEdit} checked={f.isActive} onChange={(ev) => setF({ ...f, isActive: ev.target.checked })} />
            Bật đồng bộ 2 chiều với Getfly
          </label>
          <label className="flex items-start gap-2 text-sm md:col-span-2">
            <input type="checkbox" className="mt-0.5 h-4 w-4 accent-[#F28C33]" disabled={!canEdit} checked={!!f.demoMode} onChange={(ev) => setF({ ...f, demoMode: ev.target.checked })} />
            <span>Chế độ mô phỏng<span className="block text-xs text-[#94A3B8]">Không gọi Getfly thật; tạo đơn giả lập để thử luồng báo giá → chốt đơn → đơn hàng. Tắt khi đã có API Key thật.</span></span>
          </label>
        </div>
        {getfly.lastTest && <p className={cn('mt-3 text-sm', getfly.lastTest.ok ? 'text-[#3DDBB6]' : 'text-[#F87171]')}>{getfly.lastTest.message}</p>}
        <div className="mt-4 flex flex-wrap gap-2">
          <button className={btnPrimary} disabled={!canEdit || !dirty} onClick={save}>Lưu cấu hình</button>
          <button className={btnGhost} disabled={!canRun || busy !== null} onClick={test}>
            <Plug className="h-4 w-4" aria-hidden />{busy === 'test' ? 'Đang kiểm tra...' : 'Kiểm tra kết nối'}
          </button>
          <button className={btnGhost} disabled={!canRun || busy !== null || dirty} title={dirty ? 'Lưu cấu hình trước khi đồng bộ' : undefined} onClick={fullSync}>
            <RefreshCw className={cn('h-4 w-4', busy === 'sync' && 'motion-safe:animate-spin')} aria-hidden />{busy === 'sync' ? 'Đang đồng bộ...' : 'Đồng bộ toàn bộ doanh số thủ công'}
          </button>
        </div>
        {getfly.lastFullSyncAt && <p className="mt-2 text-xs text-[#94A3B8]">Đồng bộ toàn bộ gần nhất: {new Date(getfly.lastFullSyncAt).toLocaleString('vi-VN')}</p>}
      </Panel>

      <div className="grid grid-cols-1 gap-5 xl:grid-cols-2">
        <Panel title="Khai báo webhook trên Getfly">
          <p className="text-sm text-[#94A3B8]">Vào Getfly &gt; Cài đặt &gt; Tích hợp &gt; Webhook, dán URL dưới đây và bật các sự kiện đơn hàng.</p>
          <div className="mt-3 flex gap-2">
            <input className={cn(inputCls, 'font-mono text-xs')} readOnly value={canEdit ? webhookUrl : webhookUrl.replace(/token=.*/, 'token=••••••')} aria-label="URL webhook" />
            <button className={cn(btnGhost, 'shrink-0')} disabled={!canEdit} onClick={() => navigator.clipboard?.writeText(webhookUrl).then(() => notify('Đã sao chép URL webhook', 'teal'), () => notify('Trình duyệt chặn sao chép', 'red'))}>
              <Copy className="h-4 w-4" aria-hidden />Sao chép
            </button>
          </div>
          <ul className="mt-4 space-y-1.5 text-sm">
            {(['Tạo đơn hàng mới', 'Duyệt đơn hàng', 'Sửa đơn hàng'] as const).map((t) => <li key={t} className="flex items-center gap-2"><CheckCircle2 className="h-4 w-4 text-[#00B894]" aria-hidden />{t}</li>)}
          </ul>
          <p className="mt-4 rounded bg-[#F28C33]/10 p-3 text-xs text-[#F7B23B]">
            Webhook Getfly không có sự kiện riêng cho thanh toán công nợ. Công nợ được cập nhật khi đơn được sửa / duyệt (hệ thống đọc lại payments của đơn) và qua nút Đồng bộ toàn bộ. Nên đặt thêm cron đồng bộ hằng đêm.
          </p>
        </Panel>

        <Panel title="Giả lập sự kiện webhook (bản demo)">
          {linked.length === 0 ? (
            <p className="text-sm text-[#94A3B8]">Chưa có khách hàng liên kết Getfly.</p>
          ) : (
            <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <Field label="Khách hàng (khớp theo account_id / MST / SĐT)">
                <select className={inputCls} value={hookCustomer} onChange={(ev) => { setHookCustomer(ev.target.value); setHookOrder(''); }}>
                  {linked.map((c) => <option key={c.id} value={c.id}>{c.name} ({c.getflyAccountCode})</option>)}
                </select>
              </Field>
              <Field label="Sự kiện">
                <select className={inputCls} value={hookEvent} onChange={(ev) => { setHookEvent(ev.target.value as HookEvent); setHookOrder(''); }}>
                  {(Object.keys(HOOK_LABEL) as HookEvent[]).map((k) => <option key={k} value={k}>{HOOK_LABEL[k]}</option>)}
                </select>
              </Field>
              {hookEvent !== 'order.created' && (
                <Field label="Đơn hàng" className="sm:col-span-2">
                  <select className={inputCls} value={hookOrder} onChange={(ev) => setHookOrder(ev.target.value)}>
                    <option value="">{orderOptions.length ? 'Chọn đơn' : hookEvent === 'order.approved' ? 'Không có đơn chờ duyệt' : 'Không có đơn còn nợ'}</option>
                    {orderOptions.map((o) => <option key={o.orderCode} value={o.orderCode}>{o.orderCode}, {compact(o.gross)}, còn nợ {compact(o.gross - o.paid)}</option>)}
                  </select>
                </Field>
              )}
              {hookEvent !== 'order.approved' && (
                <Field label={hookEvent === 'order.created' ? 'Giá trị đơn chưa VAT' : 'Số tiền khách thanh toán'}><MoneyInput value={hookAmount} onChange={setHookAmount} /></Field>
              )}
              <Field label="Token trong URL" hint="Sửa để thử trường hợp token sai">
                <input className={cn(inputCls, 'font-mono text-xs')} value={hookToken} onChange={(ev) => setHookToken(ev.target.value)} />
              </Field>
              <label className="flex items-center gap-2 text-sm text-[#F1F5F9] sm:col-span-2">
                <input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={resend} disabled={!lastUid} onChange={(ev) => setResend(ev.target.checked)} />
                Gửi lại uid của sự kiện trước (thử chống xử lý trùng)
              </label>
              <button className={cn(btnPrimary, 'sm:col-span-2')} disabled={busy !== null} onClick={sendHook}>{busy === 'hook' ? 'Đang gửi...' : 'Gửi sự kiện tới /api/webhooks/getfly'}</button>
            </div>
          )}
        </Panel>
      </div>

      <Panel title="Ánh xạ trường dữ liệu App MDF và Getfly">
        <Table head={['Nhóm', 'App MDF', 'Getfly API v3']} minW={640}>
          {FIELD_MAP.map(([g, a, b]) => (
            <tr key={g + a} className={rowCls}>
              <td className={cn(tdFirst, 'text-[#94A3B8]')}>{g}</td>
              <td className={tdCls}>{a}</td>
              <td className={cn(tdLast, 'font-mono text-xs text-[#6FA8F0]')}>{b.replace('ma_so_thue', getfly.taxCodeField)}</td>
            </tr>
          ))}
        </Table>
      </Panel>

      <Panel title={`Nhật ký đồng bộ (${getflyLogs.length})`}>
        {getflyLogs.length === 0 ? (
          <EmptyState text={<>Chưa có hoạt động</>} hint={<>Chốt một dự án, kiểm tra kết nối hoặc gửi webhook giả lập để xem nhật ký.</>} art="box" compact />
        ) : (
          <ul className="divide-y divide-[#263044]">
            {getflyLogs.slice(0, 30).map((l) => (
              <li key={l.id} className="flex items-start gap-3 py-2.5 text-sm">
                {l.ok ? <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-[#00B894]" aria-hidden /> : <XCircle className="mt-0.5 h-4 w-4 shrink-0 text-[#EF4444]" aria-hidden />}
                <div className="min-w-0 flex-1">
                  <p className="text-[#F1F5F9]"><Chip tone={l.direction === 'OUT' ? 'orange' : 'blue'}>{l.direction === 'OUT' ? 'App → Getfly' : 'Getfly → App'}</Chip> <span className="ml-1">{l.title}</span></p>
                  <p className="mt-0.5 break-words text-xs text-[#94A3B8]">{l.detail}</p>
                </div>
                <span className="shrink-0 text-xs tabular-nums text-[#94A3B8]">{new Date(l.at).toLocaleTimeString('vi-VN')}</span>
              </li>
            ))}
          </ul>
        )}
      </Panel>
    </div>
  );
}

// =====================================================================
//  PHÂN HỆ 6: KHO TÀI LIỆU & QUY CHẾ NỘI BỘ (lọc theo phân quyền hiển thị)
// =====================================================================

const FORMAT_COLOR: Record<DocItem['format'], string> = { PDF: C.red, DOCX: C.blue, XLSX: C.teal, PPTX: C.orange };

const slug = (s: string) =>
  s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').replace(/[^A-Za-z0-9]+/g, '_').replace(/^_|_$/g, '');

function downloadDoc(d: DocItem, ownerName: string, departments: Department[]) {
  const a = document.createElement('a');
  if (d.url) {
    a.href = d.url;
    a.download = d.title;
  } else {
    const text = [
      d.title,
      `Danh mục: ${DOC_CATEGORY[d.category]}`,
      `Phạm vi xem: ${docVisibility(d.visibility, departments).label}`,
      `Phiên bản: ${d.version}, cập nhật ${fmtDate(d.updatedAt)}, phụ trách ${ownerName}`,
      '',
      'Tóm tắt:',
      d.summary,
      '',
      `Từ khóa: ${d.tags.join(', ')}`,
      '',
      '(Tệp mẫu từ bản demo VASSH-CRM. Bản thật lưu ở Supabase Storage, quyền tải theo phạm vi hiển thị.)',
    ].join('\r\n');
    a.href = URL.createObjectURL(new Blob(['\uFEFF' + text], { type: 'text/plain;charset=utf-8' }));
    a.download = `${slug(d.title)}_mau.txt`;
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }
  a.click();
}

function DocUploadModal({ doc: existing, onClose }: { doc?: DocItem; onClose: () => void }) {
  const { setDocs, me, notify, departments } = useApp();
  const [title, setTitle] = useState(existing?.title ?? '');
  const [category, setCategory] = useState<DocCategory>(existing?.category ?? 'POLICY');
  const [visibility, setVisibility] = useState<DocVisibility>(existing?.visibility ?? 'ALL');
  const [summary, setSummary] = useState(existing?.summary ?? '');
  const [tags, setTags] = useState((existing?.tags ?? []).join(', '));
  const [file, setFile] = useState<File | null>(null);
  const [touched, setTouched] = useState(false);
  const e = { title: title.trim().length < 5 ? 'Tên tài liệu tối thiểu 5 ký tự' : '', file: !file && !existing ? 'Chọn file tài liệu' : '' };

  const save = () => {
    setTouched(true);
    if (e.title || e.file) return;
    const tagList = tags.split(',').map((t) => t.trim()).filter(Boolean);
    if (existing) {
      setDocs((p) => p.map((d) => (d.id === existing.id ? {
        ...d, title: title.trim(), category, visibility, summary: summary.trim() || d.summary, tags: tagList, updatedAt: todayISO(),
        ...(file ? { url: URL.createObjectURL(file), sizeKb: Math.max(1, Math.round(file.size / 1024)), version: `v${(parseFloat(d.version.replace(/[^\d.]/g, '')) || 1) + 0.1}`.replace(/(\.\d)\d+$/, '$1') } : {}),
      } : d)));
      notify(`Đã cập nhật "${title.trim()}"`, 'teal');
      onClose();
      return;
    }
    if (!file) return;
    const ext = file.name.split('.').pop()?.toUpperCase() ?? '';
    const format: DocItem['format'] = ext.startsWith('DOC') ? 'DOCX' : ext.startsWith('XLS') ? 'XLSX' : ext.startsWith('PPT') ? 'PPTX' : 'PDF';
    setDocs((p) => [{ id: uid('d'), title: title.trim(), category, visibility, ownerId: me.id, updatedAt: todayISO(), version: 'v1.0', format, sizeKb: Math.max(1, Math.round(file.size / 1024)), summary: summary.trim() || 'Chưa có tóm tắt.', tags: tagList, url: URL.createObjectURL(file) }, ...p]);
    notify(`Đã tải lên "${title.trim()}" với phạm vi ${docVisibility(visibility, departments).label}`, 'teal');
    onClose();
  };

  return (
    <Modal title={existing ? "Sửa tài liệu" : "Tải lên tài liệu"} onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Tải lên</button></>}>
      <div className="space-y-4">
        <FilePicker accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" onFiles={(f) => { setFile(f[0]); if (!title) setTitle(f[0].name.replace(/\.[^.]+$/, '')); }} className="rounded-md border border-dashed border-[#263044] bg-[#0F141E] px-4 py-6 text-center hover:border-[#F28C33]/60">
          <Upload className="mx-auto h-6 w-6 text-[#F28C33]" aria-hidden />
          <p className="mt-2 text-sm">{file ? `${file.name} (${Math.round(file.size / 1024)} KB)` : (existing ? 'Tải phiên bản mới (không bắt buộc)' : 'Chọn hoặc kéo thả file PDF, Word, Excel, PowerPoint')}</p>
        </FilePicker>
        {touched && e.file && <p className="text-xs text-[#F87171]">{e.file}</p>}
        <Field label="Tên tài liệu *" error={touched ? e.title || undefined : undefined}><input className={inputCls} value={title} onChange={(ev) => setTitle(ev.target.value)} /></Field>
        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <Field label="Danh mục">
            <select className={inputCls} value={category} onChange={(ev) => setCategory(ev.target.value as DocCategory)}>
              {(Object.keys(DOC_CATEGORY) as DocCategory[]).map((c) => <option key={c} value={c}>{DOC_CATEGORY[c]}</option>)}
            </select>
          </Field>
          <Field label="Phạm vi hiển thị">
            <select className={inputCls} value={visibility} onChange={(ev) => setVisibility(ev.target.value as DocVisibility)}>
              {visibilityOptions(departments).map((v) => <option key={v} value={v}>{docVisibility(v, departments).label}</option>)}
            </select>
          </Field>
        </div>
        <Field label="Từ khóa (cách nhau dấu phẩy)"><input className={inputCls} value={tags} onChange={(ev) => setTags(ev.target.value)} /></Field>
        <Field label="Tóm tắt nội dung"><textarea className={cn(inputCls, 'min-h-20')} value={summary} onChange={(ev) => setSummary(ev.target.value)} /></Field>
      </div>
    </Modal>
  );
}

function DocsPage() {
  const { docs, setDocs, me, canDo, userName, departments, notify } = useApp();
  const [editDoc, setEditDoc] = useState<DocItem | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const inR = useInRange();
  const [q, setQ] = useState('');
  const [cat, setCat] = useState('ALL');
  const [vis, setVis] = useState<'ALL_VIS' | DocVisibility>('ALL_VIS');
  const [view, setView] = useState<DocItem | null>(null);
  const [uploading, setUploading] = useState(false);

  const visible = docs.filter((d) => canViewDoc(d, me));
  const hidden = docs.length - visible.length;
  const list = visible.filter((d) => {
    const t = q.trim().toLowerCase();
    return (!t || [d.title, d.summary, ...d.tags].some((v) => v.toLowerCase().includes(t))) && (cat === 'ALL' || d.category === cat) && (vis === 'ALL_VIS' || d.visibility === vis) && inR(d.updatedAt);
  });

  const paged = usePaged(list, 12);
  const sizeOf = (kb: number) => (kb >= 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${kb} KB`);
  const recent = visible.filter((d) => inR(d.updatedAt)).length;
  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Tài liệu được xem" value={String(visible.length)} icon={FolderOpen} color={C.orange} sub={`${Object.keys(DOC_CATEGORY).length} danh mục`} />
        <StatCard label="Cập nhật trong kỳ" value={String(recent)} icon={RefreshCw} color={C.teal} sub="Theo bộ lọc thời gian" />
        <StatCard label="Ẩn theo phạm vi" value={String(hidden)} icon={Lock} color={hidden ? C.red : C.teal} sub={`Vai trò ${ROLE_LABEL[me.role]}`} />
        <StatCard label="Dung lượng" value={sizeOf(visible.reduce((x, d) => x + d.sizeKb, 0))} icon={HardDrive} color={C.orange} sub="Tổng các tài liệu xem được" />
      </div>

      <FilterBar
        q={q} onQ={setQ} placeholder="Tìm tên tài liệu, nội dung, từ khóa"
        status={cat} onStatus={setCat} statusLabel="Danh mục" extraActive={vis !== 'ALL_VIS' ? 1 : 0}
        statusOptions={(Object.keys(DOC_CATEGORY) as DocCategory[]).map((c) => ({ value: c, label: DOC_CATEGORY[c] }))}
        actions={<button className={cn(btnPrimary, 'py-2')} disabled={!canDo('docs.manage')} onClick={() => setUploading(true)}><Upload className="h-4 w-4" aria-hidden />Tải lên tài liệu</button>}
        chips={<ChipFilter value={cat === 'ALL' ? 'ALL' : (cat as DocCategory)} onChange={(v) => setCat(v)} total={visible.length} options={(Object.keys(DOC_CATEGORY) as DocCategory[]).map((c) => ({ value: c, label: DOC_CATEGORY[c], count: visible.filter((d) => d.category === c).length }))} />}
      >
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={vis} onChange={(e) => setVis(e.target.value as 'ALL_VIS' | DocVisibility)} aria-label="Phạm vi hiển thị">
          <option value="ALL_VIS">Phạm vi</option>
          {visibilityOptions(departments).map((v) => <option key={v} value={v}>{docVisibility(v, departments).label}</option>)}
        </select>
      </FilterBar>

      <Panel>
        <Table minW={1000} head={['Tài liệu', 'Danh mục', 'Phạm vi', 'Người phụ trách', 'Phiên bản / cập nhật', <span key="s" className="block text-right">Dung lượng</span>, <span key="a" className="block text-right">Thao tác</span>]}>
          {paged.slice.map((d) => (
            <tr key={d.id} className={rowCls}>
              <td className={cn(tdFirst, 'max-w-[300px]')}>
                <button className="flex max-w-full items-start gap-3 text-left" onClick={() => setView(d)}>
                  <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded text-[10px] font-bold" style={{ background: `${FORMAT_COLOR[d.format]}22`, color: FORMAT_COLOR[d.format] }}>{d.format}</span>
                  <span className="min-w-0"><span className="block truncate font-medium text-[#F1F5F9] hover:text-[#F7B23B]">{d.title}</span><span className="block truncate text-xs text-[#94A3B8]">{d.summary}</span></span>
                </button>
              </td>
              <td className={cn(tdCls, 'whitespace-nowrap text-xs')}>{DOC_CATEGORY[d.category]}</td>
              <td className={cn(tdCls, 'whitespace-nowrap')}><Chip tone={docVisibility(d.visibility, departments).tone}>{docVisibility(d.visibility, departments).label}</Chip></td>
              <td className={cn(tdCls, 'whitespace-nowrap text-xs')}>{userName(d.ownerId)}</td>
              <td className={cn(tdCls, 'whitespace-nowrap text-xs tabular-nums')}>{d.version}<span className="block text-[#94A3B8]">{fmtDate(d.updatedAt)}</span></td>
              <td className={cn(tdCls, 'whitespace-nowrap text-right text-xs tabular-nums')}>{sizeOf(d.sizeKb)}</td>
              <td className={tdLast}>
                <div className="flex items-center justify-end gap-1.5">
                  <button className={cn(btnGhost, btnSm)} onClick={() => setView(d)} aria-label={`Xem ${d.title}`}><Eye className="h-3.5 w-3.5" aria-hidden /></button>
                  <button className={cn(btnGhost, btnSm)} onClick={() => downloadDoc(d, userName(d.ownerId), departments)} aria-label={`Tải ${d.title}`}><Download className="h-3.5 w-3.5" aria-hidden /></button>
                  <RowMenu items={[
                    { label: 'Sửa / cập nhật phiên bản', icon: Pencil, onClick: () => setEditDoc(d), disabled: !canDo('docs.manage') },
                    { label: 'Xóa tài liệu', icon: Trash2, danger: true, disabled: !canDo('docs.manage'), onClick: () => setConfirm({ title: 'Xóa tài liệu', message: <>Xóa <b>{d.title}</b> khỏi kho tài liệu?</>, onConfirm: () => { setDocs((p) => p.filter((x) => x.id !== d.id)); notify(`Đã xóa ${d.title}`, 'orange'); } }) },
                  ]} />
                </div>
              </td>
            </tr>
          ))}
        </Table>
        {!list.length && <EmptyState text={<>Không có tài liệu khớp bộ lọc.</>} art="search" />}
        <Pagination paged={paged} unit="tài liệu" />
      </Panel>

      {view && (
        <Modal
          title={view.title}
          onClose={() => setView(null)}
          footer={<><button className={btnGhost} onClick={() => setView(null)}>Đóng</button><button className={btnPrimary} onClick={() => downloadDoc(view, userName(view.ownerId), departments)}><Download className="h-4 w-4" aria-hidden />{view.url ? 'Tải file' : 'Tải file mẫu'}</button></>}
        >
          <div className="space-y-4 text-sm">
            <div className="flex flex-wrap gap-1.5">
              <Chip tone={docVisibility(view.visibility, departments).tone}>{docVisibility(view.visibility, departments).label}</Chip>
              <Chip>{DOC_CATEGORY[view.category]}</Chip>
            </div>
            <div>
              <p className="mb-1 text-xs font-medium text-[#94A3B8]">Tóm tắt</p>
              <p className="leading-relaxed text-[#F1F5F9]">{view.summary}</p>
            </div>
            <dl className="grid grid-cols-2 gap-3">
              {[
                ['Phiên bản', view.version],
                ['Cập nhật', fmtDate(view.updatedAt)],
                ['Người phụ trách', userName(view.ownerId)],
                ['Định dạng', `${view.format}, ${view.sizeKb >= 1024 ? `${(view.sizeKb / 1024).toFixed(1)} MB` : `${view.sizeKb} KB`}`],
              ].map(([k, v]) => <div key={k}><dt className="text-xs text-[#94A3B8]">{k}</dt><dd className="mt-0.5">{v}</dd></div>)}
            </dl>
            {view.tags.length > 0 && <div className="flex flex-wrap gap-1.5">{view.tags.map((t) => <Chip key={t}>{t}</Chip>)}</div>}
          </div>
        </Modal>
      )}
      {uploading && <DocUploadModal onClose={() => setUploading(false)} />}
      {editDoc && <DocUploadModal doc={editDoc} onClose={() => setEditDoc(null)} />}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

// =====================================================================
//  EMAIL BÁO CÁO THÁNG — HTML dạng bảng, style inline (tương thích Gmail / Outlook)
// =====================================================================

type ReportData = {
  monthLabel: string;
  vendor: string;
  leads30: number;
  slaRate: string;
  slaDetail: string;
  won: number;
  lost: number;
  winRate: string;
  topLost: string;
  gfMonth: number;
  gfYtd: number;
  mdfSpentPct: number;
  mdfCommitPct: number;
  mdfSpent: number;
  mdfTotal: number;
  quoteOverdue: number;
  claimsBlocked: number;
  claimsPending: number;
};

function buildReportHtml(d: ReportData, company: CompanyInfo): string {
  const kpi = (label: string, value: string, sub: string, color: string) =>
    `<td width="50%" style="padding:6px"><div style="background:#ffffff;border:1px solid #e5e7eb;border-radius:10px;padding:14px">
      <div style="font-size:12px;color:#64748b">${esc(label)}</div>
      <div style="font-size:24px;font-weight:700;color:${color};margin-top:4px">${esc(value)}</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px">${esc(sub)}</div></div></td>`;
  const row = (k: string, v: string, warn = false) =>
    `<tr><td style="padding:8px 0;border-bottom:1px solid #eef0f3;color:#475569;font-size:13px">${esc(k)}</td><td align="right" style="padding:8px 0;border-bottom:1px solid #eef0f3;font-size:13px;font-weight:600;color:${warn ? '#dc2626' : '#0f172a'}">${esc(v)}</td></tr>`;
  const vnd0 = (n: number) => new Intl.NumberFormat('vi-VN').format(Math.round(n)) + ' ₫';
  return `<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Báo cáo ${esc(d.monthLabel)}</title></head>
<body style="margin:0;background:#f1f3f6;font-family:'Be Vietnam Pro',Arial,Helvetica,sans-serif;color:#0f172a">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f1f3f6;padding:24px 0"><tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%">
  <tr><td style="background:#0F141E;border-radius:12px 12px 0 0;padding:22px 24px">
    <table role="presentation" cellpadding="0" cellspacing="0"><tr>${company.logo ? `<td style="padding-right:10px"><img src="${company.logo}" alt="" width="36" height="36" style="display:block;border-radius:6px;background:#fff"></td>` : ''}<td style="font-size:13px;color:#F28C33;font-weight:600;letter-spacing:.2px">${esc(company.appName)}, ${esc(company.legalName)}</td></tr></table>
    <div style="font-size:22px;color:#F1F5F9;font-weight:700;margin-top:4px">Báo cáo vận hành ${esc(d.monthLabel)}</div>
    <div style="font-size:13px;color:#94A3B8;margin-top:4px">Lead Marketing, bán hàng, Getfly và quỹ MDF ${esc(d.vendor)}</div>
  </td></tr>
  <tr><td style="background:#f8fafc;padding:12px 18px">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>${kpi('Lead nhận 30 ngày', String(d.leads30), 'Từ các kênh Marketing', '#0f172a')}${kpi('Tiếp nhận đúng SLA 2 giờ', d.slaRate, d.slaDetail, '#00a383')}</tr>
      <tr>${kpi('Chốt đơn / Trượt', `${d.won} / ${d.lost}`, `Tỷ lệ chốt ${d.winRate}`, '#00a383')}${kpi('Doanh số Getfly lũy kế', compact(d.gfYtd), `Trong tháng ${compact(d.gfMonth)}`, '#0f172a')}</tr>
    </table>
  </td></tr>
  <tr><td style="background:#ffffff;padding:20px 24px">
    <div style="font-size:15px;font-weight:700">Tiến độ giải ngân quỹ MDF</div>
    <div style="margin-top:10px;background:#eef0f3;border-radius:6px;height:12px;overflow:hidden;font-size:0">
      <span style="display:inline-block;height:12px;width:${d.mdfSpentPct.toFixed(1)}%;background:#F28C33"></span><span style="display:inline-block;height:12px;width:${d.mdfCommitPct.toFixed(1)}%;background:#F9C25A"></span>
    </div>
    <div style="font-size:12px;color:#64748b;margin-top:6px">Đã tiêu ${vnd0(d.mdfSpent)} / ${vnd0(d.mdfTotal)} (${d.mdfSpentPct.toFixed(1)}%), đang giữ chỗ ${d.mdfCommitPct.toFixed(1)}%</div>
    <div style="font-size:15px;font-weight:700;margin-top:22px">Việc cần xử lý</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:6px">
      ${row('Dự án quá hạn nộp báo giá 24 giờ', String(d.quoteOverdue), d.quoteOverdue > 0)}
      ${row('Hồ sơ claim còn thiếu chứng từ', String(d.claimsBlocked), d.claimsBlocked > 0)}
      ${row('Claim đã nộp, chờ Hãng hoàn quỹ', String(d.claimsPending))}
      ${row('Lý do trượt nhiều nhất', d.topLost)}
    </table>
    <div style="margin-top:22px"><a href="#" style="display:inline-block;background:#F28C33;color:#0F141E;text-decoration:none;font-weight:600;font-size:14px;padding:10px 18px;border-radius:8px">Mở bảng điều khiển</a></div>
  </td></tr>
  <tr><td style="background:#0F141E;border-radius:0 0 12px 12px;padding:14px 24px;font-size:11px;color:#94A3B8">
    Email tự động gửi ngày đầu tháng tới Ban Giám đốc, Marketing và Kế toán. Số liệu Getfly cập nhật qua webhook và đồng bộ hằng đêm.
  </td></tr>
</table></td></tr></table></body></html>`;
}

function MonthlyReportModal({ onClose }: { onClose: () => void }) {
  const { myLeads: leads, getflyOrders, budget, claims, policy, emailCfg, addMsgLog, notify, now, company } = useApp();
  const [to, setTo] = useState(emailCfg.reportRecipients.split(',')[0]?.trim() ?? '');
  const [sending, setSending] = useState(false);
  const d = new Date();
  const ym = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  const slaDone = leads.filter((l) => l.slaMet !== undefined);
  const met = slaDone.filter((l) => l.slaMet).length;
  const won = leads.filter((l) => l.status === 'WON').length;
  const lost = leads.filter((l) => l.status === 'LOST');
  const top = (Object.keys(LOST_REASON) as LostReason[]).map((r) => ({ r, n: lost.filter((l) => l.lostReason === r).length })).sort((a, b) => b.n - a.n)[0];
  const approved = getflyOrders.filter((o) => o.approved);
  const data: ReportData = {
    monthLabel: `tháng ${d.getMonth() + 1}/${d.getFullYear()}`,
    vendor: budget.vendor,
    leads30: leads.filter((l) => l.receivedDaysAgo <= 30).length,
    slaRate: pct(met, slaDone.length),
    slaDetail: `${met}/${slaDone.length} lead đã tiếp nhận`,
    won,
    lost: lost.length,
    winRate: pct(won, won + lost.length),
    topLost: top && top.n ? `${LOST_REASON[top.r]} (${top.n})` : 'Chưa có',
    gfMonth: approved.filter((o) => o.orderDate.startsWith(ym)).reduce((s, o) => s + o.net, 0),
    gfYtd: approved.filter((o) => o.orderDate.startsWith(String(budget.fiscalYear))).reduce((s, o) => s + o.net, 0),
    mdfSpentPct: budget.total ? (budget.spent / budget.total) * 100 : 0,
    mdfCommitPct: budget.total ? (budget.committed / budget.total) * 100 : 0,
    mdfSpent: budget.spent,
    mdfTotal: budget.total,
    quoteOverdue: leads.filter((l) => isQuoteOverdue(l, now)).length,
    claimsBlocked: claims.filter((c) => !c.submitted && blockersOf(c, policy.rules) > 0).length,
    claimsPending: claims.filter((c) => c.submitted && !c.creditNote).length,
  };
  const html = buildReportHtml(data, company);
  const subject = `[${company.appName}] Báo cáo vận hành ${data.monthLabel}`;

  const send = async () => {
    if (!EMAIL_RE.test(to.trim())) return notify('Email người nhận chưa đúng định dạng', 'red');
    if (!emailCfg.enabled) return notify('Kênh Email đang tắt (Cài đặt > Email SMTP)', 'red');
    setSending(true);
    await new Promise((r) => setTimeout(r, 900));
    const ok = !!emailCfg.password && !!emailCfg.host;
    addMsgLog({ channel: 'EMAIL', to: to.trim(), subject, ok, detail: ok ? `Gửi qua ${EMAIL_PRESET[emailCfg.provider].label} (${emailCfg.host}:${emailCfg.port}) từ ${emailCfg.fromEmail}` : 'Xác thực SMTP thất bại: thiếu máy chủ hoặc mật khẩu' });
    notify(ok ? `Đã gửi thử email báo cáo tới ${to.trim()}` : 'Gửi thất bại: kiểm tra cấu hình SMTP', ok ? 'teal' : 'red');
    setSending(false);
  };
  const downloadHtml = () => {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([html], { type: 'text/html;charset=utf-8' }));
    a.download = `bao_cao_${ym}.html`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  };

  return (
    <Modal
      title="Xem trước Email Báo cáo Tháng"
      onClose={onClose}
      wide
      footer={
        <>
          <button className={btnGhost} onClick={downloadHtml}><Download className="h-4 w-4" aria-hidden />Tải HTML</button>
          <button className={btnPrimary} disabled={sending} onClick={send}><Send className="h-4 w-4" aria-hidden />{sending ? 'Đang gửi...' : 'Gửi thử nghiệm'}</button>
        </>
      }
    >
      <div className="mb-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <Field label="Gửi thử tới"><input className={inputCls} type="email" value={to} onChange={(e) => setTo(e.target.value)} /></Field>
        <div className="text-xs text-[#94A3B8]">
          <p className="mb-1.5 font-medium">Tiêu đề</p>
          <p className="text-sm text-[#F1F5F9]">{subject}</p>
          <p className="mt-1">Từ: {emailCfg.fromName} &lt;{emailCfg.fromEmail}&gt;</p>
        </div>
      </div>
      <iframe title="Mẫu email báo cáo tháng" srcDoc={html} sandbox="" className="h-[560px] w-full rounded border border-[#263044] bg-white" />
    </Modal>
  );
}

// =====================================================================
//  CÀI ĐẶT: EMAIL SMTP
// =====================================================================

function MsgLogList({ channel }: { channel: 'EMAIL' | 'ZNS' }) {
  const { msgLogs } = useApp();
  const list = msgLogs.filter((m) => m.channel === channel).slice(0, 20);
  if (!list.length) return <EmptyState text={<>Chưa có tin nào được gửi.</>} art="inbox" compact />;
  return (
    <ul className="divide-y divide-[#263044]">
      {list.map((m) => (
        <li key={m.id} className="flex items-start gap-3 py-2.5 text-sm">
          {m.ok ? <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-[#00B894]" aria-hidden /> : <XCircle className="mt-0.5 h-4 w-4 shrink-0 text-[#EF4444]" aria-hidden />}
          <div className="min-w-0 flex-1">
            <p className="truncate text-[#F1F5F9]">{m.subject}</p>
            <p className="break-words text-xs text-[#94A3B8]">Tới {m.to}. {m.detail}</p>
          </div>
          <span className="shrink-0 text-xs tabular-nums text-[#94A3B8]">{new Date(m.at).toLocaleTimeString('vi-VN')}</span>
        </li>
      ))}
    </ul>
  );
}

function EmailSettings() {
  const { emailCfg, setEmailCfg, canDo, notify, addMsgLog, company } = useApp();
  const canEdit = canDo('settings.edit');
  const [f, setF] = useState(emailCfg);
  const [show, setShow] = useState(false);
  const [testTo, setTestTo] = useState('');
  const [touched, setTouched] = useState(false);
  const set = <K extends keyof EmailConfig>(k: K, v: EmailConfig[K]) => setF((p) => ({ ...p, [k]: v }));
  const recipients = f.reportRecipients.split(',').map((x) => x.trim()).filter(Boolean);
  const e: Partial<Record<keyof EmailConfig, string>> = {};
  if (!f.host.trim()) e.host = 'Nhập máy chủ SMTP';
  if (!(f.port > 0 && f.port < 65536)) e.port = 'Cổng không hợp lệ';
  if (!EMAIL_RE.test(f.fromEmail)) e.fromEmail = 'Email gửi chưa đúng';
  if (f.replyTo && !EMAIL_RE.test(f.replyTo)) e.replyTo = 'Email trả lời chưa đúng';
  if (recipients.some((r) => !EMAIL_RE.test(r))) e.reportRecipients = 'Có email người nhận sai định dạng';
  const err = (k: keyof EmailConfig) => (touched ? e[k] : undefined);

  const pickProvider = (p: EmailProvider) => {
    const pr = EMAIL_PRESET[p];
    setF((x) => ({ ...x, provider: p, host: pr.host || x.host, port: pr.port, secure: pr.secure, username: pr.username || x.username }));
  };
  const save = () => {
    setTouched(true);
    if (Object.keys(e).length) return;
    setEmailCfg(f);
    notify('Đã lưu cấu hình Email. Mật khẩu / API Key được mã hóa khi lưu ở backend.', 'teal');
  };
  const test = async () => {
    if (!EMAIL_RE.test(testTo)) return notify('Nhập email nhận thử hợp lệ', 'red');
    await new Promise((r) => setTimeout(r, 700));
    const ok = emailCfg.enabled && !!emailCfg.password;
    addMsgLog({ channel: 'EMAIL', to: testTo, subject: `[${company.appName}] Email kiểm tra cấu hình`, ok, detail: ok ? `Kết nối ${emailCfg.host}:${emailCfg.port} ${emailCfg.secure ? 'SSL/TLS' : 'STARTTLS'} thành công` : !emailCfg.enabled ? 'Kênh Email đang tắt' : 'Xác thực SMTP thất bại, kiểm tra mật khẩu / API Key' });
    notify(ok ? `Đã gửi email kiểm tra tới ${testTo}` : 'Gửi thất bại, xem nhật ký', ok ? 'teal' : 'red');
  };

  return (
    <div className="space-y-5">
      <Panel title="Máy chủ gửi email" action={<label className="flex items-center gap-2 text-sm"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canEdit} checked={f.enabled} onChange={(ev) => set('enabled', ev.target.checked)} />Bật kênh Email</label>}>
        <div className="mb-4 flex flex-wrap gap-2" role="radiogroup" aria-label="Nhà cung cấp">
          {(Object.keys(EMAIL_PRESET) as EmailProvider[]).map((p) => (
            <button key={p} role="radio" aria-checked={f.provider === p} disabled={!canEdit} onClick={() => pickProvider(p)} className={cn('rounded border px-3 py-2 text-sm transition-colors disabled:opacity-50', f.provider === p ? 'border-[#F28C33] bg-[#F28C33]/10 text-[#F7B23B]' : 'border-[#263044] text-[#94A3B8] hover:text-[#F1F5F9]')}>
              {EMAIL_PRESET[p].label}
            </button>
          ))}
        </div>
        <p className="mb-4 text-xs text-[#94A3B8]">{EMAIL_PRESET[f.provider].hint}</p>
        <div className="grid grid-cols-1 gap-4 md:grid-cols-3">
          <Field label="Máy chủ SMTP" error={err('host')} className="md:col-span-2"><input className={inputCls} disabled={!canEdit} value={f.host} onChange={(ev) => set('host', ev.target.value.trim())} /></Field>
          <Field label="Cổng" error={err('port')}><input className={inputCls} type="number" disabled={!canEdit} value={f.port} onChange={(ev) => set('port', Number(ev.target.value))} /></Field>
          <Field label="Tên đăng nhập"><input className={inputCls} disabled={!canEdit} value={f.username} onChange={(ev) => set('username', ev.target.value.trim())} /></Field>
          <Field label="Mật khẩu / API Key" className="md:col-span-2">
            <div className="flex gap-2">
              <input className={inputCls} disabled={!canEdit} type={show ? 'text' : 'password'} autoComplete="off" value={f.password} onChange={(ev) => set('password', ev.target.value)} />
              <button type="button" className={cn(btnGhost, 'shrink-0')} onClick={() => setShow((v) => !v)}>{show ? 'Ẩn' : 'Hiện'}</button>
            </div>
          </Field>
          <Field label="Tên người gửi"><input className={inputCls} disabled={!canEdit} value={f.fromName} onChange={(ev) => set('fromName', ev.target.value)} /></Field>
          <Field label="Email người gửi" error={err('fromEmail')}><input className={inputCls} disabled={!canEdit} value={f.fromEmail} onChange={(ev) => set('fromEmail', ev.target.value.trim())} /></Field>
          <Field label="Email trả lời" error={err('replyTo')}><input className={inputCls} disabled={!canEdit} value={f.replyTo} onChange={(ev) => set('replyTo', ev.target.value.trim())} /></Field>
          <label className="flex items-center gap-2 text-sm md:col-span-3"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canEdit} checked={f.secure} onChange={(ev) => set('secure', ev.target.checked)} />Kết nối SSL/TLS trực tiếp (cổng 465). Bỏ chọn để dùng STARTTLS (cổng 587).</label>
        </div>
      </Panel>

      <Panel title="Email báo cáo tháng">
        <div className="grid grid-cols-1 gap-4 md:grid-cols-3">
          <Field label="Người nhận (cách nhau bởi dấu phẩy)" error={err('reportRecipients')} className="md:col-span-2"><input className={inputCls} disabled={!canEdit} value={f.reportRecipients} onChange={(ev) => set('reportRecipients', ev.target.value)} /></Field>
          <Field label="Gửi vào ngày trong tháng" hint="Lúc 08:00 giờ Việt Nam"><input className={inputCls} type="number" min={1} max={28} disabled={!canEdit} value={f.reportDay} onChange={(ev) => set('reportDay', Math.min(28, Math.max(1, Number(ev.target.value))))} /></Field>
        </div>
        <div className="mt-4 flex flex-wrap items-end gap-2">
          <button className={btnPrimary} disabled={!canEdit} onClick={save}>Lưu cấu hình Email</button>
          <div className="ml-auto flex items-end gap-2">
            <Field label="Gửi email kiểm tra tới"><input className={cn(inputBase, 'w-64')} value={testTo} onChange={(ev) => setTestTo(ev.target.value.trim())} placeholder="ten@congty.vn" /></Field>
            <button className={btnGhost} onClick={test}><Send className="h-4 w-4" aria-hidden />Gửi thử</button>
          </div>
        </div>
      </Panel>

      <Panel title="Nhật ký gửi email"><MsgLogList channel="EMAIL" /></Panel>
    </div>
  );
}

// =====================================================================
//  CÀI ĐẶT: ZALO ZNS / OA + QUY TẮC THÔNG BÁO ĐA KÊNH
// =====================================================================

const znsPhone = (p?: string) => {
  const d = (p ?? '').replace(/\D/g, '');
  return d.startsWith('0') ? '84' + d.slice(1) : d;
};

function ZnsSettings() {
  const { zns, setZns, notifyRules, setNotifyRules, canDo, notify, addMsgLog } = useApp();
  const canEdit = canDo('settings.edit');
  const [f, setF] = useState(zns);
  const [show, setShow] = useState(false);
  const [phone, setPhone] = useState('');
  const [tpl, setTpl] = useState<ZnsTemplateKey>('LEAD_ROUTED');
  const [touched, setTouched] = useState(false);
  const e: Record<string, string> = {};
  if (!/^\d{8,25}$/.test(f.appId)) e.appId = 'App ID gồm chữ số';
  if (f.secretKey.length < 16) e.secretKey = 'Secret Key tối thiểu 16 ký tự';
  if (!/^\d{8,25}$/.test(f.oaId)) e.oaId = 'OA ID gồm chữ số';
  (Object.keys(f.templates) as ZnsTemplateKey[]).forEach((k) => { if (!/^\d{3,12}$/.test(f.templates[k])) e[k] = 'Template ID gồm chữ số'; });
  const err = (k: string) => (touched ? e[k] : undefined);

  const save = () => {
    setTouched(true);
    if (Object.keys(e).length) return;
    setZns(f);
    notify('Đã lưu cấu hình Zalo ZNS', 'teal');
  };
  const test = async () => {
    const to = znsPhone(phone);
    if (!/^84\d{9}$/.test(to)) return notify('Số điện thoại chưa đúng (VD: 0903xxxxxx)', 'red');
    await new Promise((r) => setTimeout(r, 700));
    const ok = zns.enabled && /^\d{8,25}$/.test(zns.appId) && !!zns.templates[tpl];
    addMsgLog({ channel: 'ZNS', to, subject: `Mẫu ${zns.templates[tpl]}: ${EVENT_LABEL[tpl]}`, ok, detail: ok ? `Gửi qua OA ${zns.oaId}` : zns.enabled ? 'Thiếu App ID hoặc Template ID' : 'Kênh ZNS đang tắt' });
    notify(ok ? `Đã gửi ZNS thử tới ${to}` : 'Gửi ZNS thất bại, xem nhật ký', ok ? 'teal' : 'red');
  };
  const toggleRule = (ev: NotifyEvent, ch: Channel) =>
    setNotifyRules((p) => ({ ...p, [ev]: p[ev].includes(ch) ? p[ev].filter((x) => x !== ch) : [...p[ev], ch] }));

  return (
    <div className="space-y-5">
      <Panel title="Kết nối Zalo Official Account" action={<label className="flex items-center gap-2 text-sm"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canEdit} checked={f.enabled} onChange={(ev) => setF({ ...f, enabled: ev.target.checked })} />Bật kênh ZNS</label>}>
        <div className="grid grid-cols-1 gap-4 md:grid-cols-3">
          <Field label="App ID" error={err('appId')}><input className={inputCls} disabled={!canEdit} value={f.appId} onChange={(ev) => setF({ ...f, appId: ev.target.value.trim() })} /></Field>
          <Field label="Secret Key" error={err('secretKey')}>
            <div className="flex gap-2">
              <input className={inputCls} disabled={!canEdit} type={show ? 'text' : 'password'} autoComplete="off" value={f.secretKey} onChange={(ev) => setF({ ...f, secretKey: ev.target.value.trim() })} />
              <button type="button" className={cn(btnGhost, 'shrink-0')} onClick={() => setShow((v) => !v)}>{show ? 'Ẩn' : 'Hiện'}</button>
            </div>
          </Field>
          <Field label="OA ID" error={err('oaId')}><input className={inputCls} disabled={!canEdit} value={f.oaId} onChange={(ev) => setF({ ...f, oaId: ev.target.value.trim() })} /></Field>
          {(Object.keys(f.templates) as ZnsTemplateKey[]).map((k) => (
            <Field key={k} label={`Template ID: ${EVENT_LABEL[k]}`} error={err(k)}>
              <input className={inputCls} disabled={!canEdit} value={f.templates[k]} onChange={(ev) => setF({ ...f, templates: { ...f.templates, [k]: ev.target.value.trim() } })} />
            </Field>
          ))}
        </div>
        <p className="mt-3 text-xs text-[#94A3B8]">Mẫu ZNS phải được Zalo duyệt trước khi gửi. Tham số gợi ý cho mẫu: ten_nguoi_nhan, ma_lead, ten_khach_hang, han_xu_ly. Số điện thoại gửi theo dạng 84xxxxxxxxx.</p>
        <div className="mt-4 flex flex-wrap items-end gap-2">
          <button className={btnPrimary} disabled={!canEdit} onClick={save}>Lưu cấu hình ZNS</button>
          <div className="ml-auto flex flex-wrap items-end gap-2">
            <Field label="Số nhận thử"><input className={cn(inputBase, 'w-40')} value={phone} onChange={(ev) => setPhone(ev.target.value)} placeholder="0903xxxxxx" /></Field>
            <Field label="Mẫu">
              <select className={cn(inputBase, 'w-56')} value={tpl} onChange={(ev) => setTpl(ev.target.value as ZnsTemplateKey)}>
                {(Object.keys(zns.templates) as ZnsTemplateKey[]).map((k) => <option key={k} value={k}>{EVENT_LABEL[k]}</option>)}
              </select>
            </Field>
            <button className={btnGhost} onClick={test}><MessageSquare className="h-4 w-4" aria-hidden />Gửi ZNS thử</button>
          </div>
        </div>
      </Panel>

      <Panel title="Kênh gửi theo sự kiện">
        <Table head={['Sự kiện', ...(Object.keys(CHANNEL_LABEL) as Channel[]).map((c) => CHANNEL_LABEL[c])]} minW={560}>
          {(Object.keys(EVENT_LABEL) as NotifyEvent[]).map((ev) => (
            <tr key={ev} className={rowCls}>
              <td className={tdFirst}>{EVENT_LABEL[ev]}</td>
              {(Object.keys(CHANNEL_LABEL) as Channel[]).map((ch, i, arr) => (
                <td key={ch} className={i === arr.length - 1 ? tdLast : tdCls}>
                  <input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canEdit || (ev === 'MONTHLY_REPORT' && ch !== 'EMAIL')} checked={notifyRules[ev].includes(ch)} onChange={() => toggleRule(ev, ch)} aria-label={`${EVENT_LABEL[ev]} qua ${CHANNEL_LABEL[ch]}`} />
                </td>
              ))}
            </tr>
          ))}
        </Table>
      </Panel>

      <Panel title="Nhật ký gửi Zalo ZNS"><MsgLogList channel="ZNS" /></Panel>
    </div>
  );
}

// =====================================================================
//  HEADER: CHUÔNG THÔNG BÁO & MENU TÀI KHOẢN
// =====================================================================

const timeAgo = (at: number) => {
  const m = Math.floor((Date.now() - at) / 60_000);
  if (m < 1) return 'vừa xong';
  if (m < 60) return `${m} phút trước`;
  const h = Math.floor(m / 60);
  return h < 24 ? `${h} giờ trước` : `${Math.floor(h / 24)} ngày trước`;
};
const NOTICE_ICON: Record<NoticeKind, { icon: typeof Bell; color: string }> = {
  LEAD: { icon: Inbox, color: C.orange },
  SLA: { icon: Clock, color: C.red },
  QUOTE: { icon: AlertTriangle, color: C.red },
  CLAIM: { icon: FileCheck2, color: C.teal },
  STOCK: { icon: Warehouse, color: C.orange },
  DOC: { icon: FileText, color: C.blue },
  SYSTEM: { icon: RefreshCw, color: C.muted },
  MENTION: { icon: AtSign, color: BRAND.blueHi },
};

function useOutsideClose(open: boolean, close: () => void) {
  const ref = useRef<HTMLDivElement>(null);
  useEffect(() => {
    if (!open) return;
    const onDown = (e: MouseEvent) => { if (ref.current && !ref.current.contains(e.target as Node)) close(); };
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') close(); };
    document.addEventListener('mousedown', onDown);
    window.addEventListener('keydown', onKey);
    return () => { document.removeEventListener('mousedown', onDown); window.removeEventListener('keydown', onKey); };
  }, [open, close]);
  return ref;
}

function NotificationBell() {
  const { notices, markNoticeRead, go, ringKey } = useApp();
  const [open, setOpen] = useState(false);
  const ref = useOutsideClose(open, () => setOpen(false));
  const unread = notices.filter((n) => !n.read).length;

  return (
    <div className="relative" ref={ref}>
      <button className={cn(btnGhost, 'relative p-2')} onClick={() => setOpen((v) => !v)} aria-expanded={open} aria-haspopup="true" aria-label={`Thông báo, ${unread} chưa đọc`}>
        <Bell key={ringKey} className="h-4 w-4 motion-safe:animate-[ring_.9s_ease-in-out]" aria-hidden />
        {unread > 0 && <span className="absolute -right-1.5 -top-1.5 flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-[#EF4444] px-1 text-[11px] font-semibold text-white tabular-nums">{unread > 9 ? '9+' : unread}</span>}
      </button>
      {open && (
        <div className="absolute right-0 top-full z-50 mt-2 w-[380px] max-w-[calc(100vw-1.5rem)] overflow-hidden rounded-md border border-[#263044] bg-[#151C29] shadow-2xl motion-safe:animate-[popIn_.15s_ease-out]">
          <div className="flex items-center justify-between border-b border-[#263044] px-4 py-3">
            <p className="text-sm font-semibold">Thông báo</p>
            <button className="text-xs text-[#94A3B8] hover:text-[#F1F5F9] disabled:opacity-40" disabled={!unread} onClick={() => markNoticeRead()}>Đánh dấu đã đọc tất cả</button>
          </div>
          <ul className="max-h-[420px] overflow-y-auto">
            {notices.slice(0, 25).map((n) => {
              const I = NOTICE_ICON[n.kind];
              return (
                <li key={n.id}>
                  <button className={cn('flex w-full items-start gap-3 px-4 py-3 text-left hover:bg-[#1C2534]', !n.read && 'bg-[#F28C33]/5')} onClick={() => { markNoticeRead(n.id); if (n.module) go(n.module); setOpen(false); }}>
                    <I.icon className="mt-0.5 h-4 w-4 shrink-0" style={{ color: I.color }} aria-hidden />
                    <span className="min-w-0 flex-1">
                      <span className={cn('block text-sm', n.read ? 'text-[#94A3B8]' : 'font-medium text-[#F1F5F9]')}>{n.title}</span>
                      <span className="block text-xs text-[#94A3B8]">{n.body}</span>
                      <span className="mt-1 block text-[11px] text-[#94A3B8]/80">{timeAgo(n.at)}{n.to ? `, tới ${n.to}` : ''}</span>
                    </span>
                    {!n.read && <span className="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#EF4444]" aria-label="Chưa đọc" />}
                  </button>
                </li>
              );
            })}
            {!notices.length && <li className="list-none"><EmptyState text={<>Chưa có thông báo.</>} art="inbox" compact /></li>}
          </ul>
        </div>
      )}
    </div>
  );
}

/** Đổi mật khẩu: kiểm tra mật khẩu hiện tại, chính sách độ mạnh, băm PBKDF2 trước khi lưu */
/** Bộ chọn doanh nghiệp nhanh cho tài khoản nền tảng 3A Group */
/** Trạng thái đồng bộ máy chủ trên header */
function SyncChip({ info }: { info: SyncInfo }) {
  const ago = info.lastOk ? Math.max(0, Math.round((Date.now() - info.lastOk) / 1000)) : null;
  const tone = info.state === 'error' || info.state === 'offline' ? 'red' : info.state === 'syncing' || info.pending > 0 ? 'orange' : 'teal';
  const label = info.state === 'offline' ? 'Mất kết nối' : info.state === 'error' ? 'Lỗi đồng bộ' : info.state === 'syncing' ? 'Đang lưu...' : info.pending > 0 ? `Chờ lưu ${info.pending}` : 'Đã đồng bộ';
  const title = `${label}${info.error ? `: ${info.error}` : ''}${ago !== null ? `. Lần cuối ${ago < 60 ? `${ago} giây` : `${Math.round(ago / 60)} phút`} trước` : ''}${info.state === 'offline' || info.state === 'error' ? '. Thay đổi vẫn giữ trên máy và tự gửi lại khi có mạng; đừng đóng tab.' : ''}`;
  const color = tone === 'red' ? 'border-[#EF4444]/50 text-[#F87171]' : tone === 'orange' ? 'border-[#F28C33]/50 text-[#F7B23B]' : 'border-[#00B894]/40 text-[#3DDBB6]';
  return (
    <span className={cn('hidden items-center gap-1.5 whitespace-nowrap rounded border px-2 py-1.5 text-xs font-medium sm:flex', color)} title={title} role="status" aria-label={title}>
      {info.state === 'syncing' ? <RefreshCw className="h-3.5 w-3.5 motion-safe:animate-spin" aria-hidden /> : tone === 'red' ? <AlertTriangle className="h-3.5 w-3.5" aria-hidden /> : <CheckCircle2 className="h-3.5 w-3.5" aria-hidden />}
      <span className="hidden xl:inline">{label}</span>
    </span>
  );
}

/** Biểu tượng tam giác 3A Group */
function Logo3A({ size = 28 }: { size?: number }) {
  // eslint-disable-next-line @next/next/no-img-element
  return <img src={LOGO_3A} alt="3A Group" width={size} height={Math.round(size * 0.875)} className="shrink-0 object-contain" style={{ width: size, height: Math.round(size * 0.875) }} />;
}

/** Breadcrumb dạng dropdown cho quản trị 3A: 3A Group › [Console | VASSH | ALUX] ▾ */
function TenantSwitcher({ orgId, consoleOn, onConsole, onSwitch }: { orgId: string; consoleOn: boolean; onConsole: () => void; onSwitch: (org: string) => void }) {
  const [open, setOpen] = useState(false);
  const ref = useRef<HTMLDivElement>(null);
  useEffect(() => {
    if (!open) return;
    const close = (e: MouseEvent) => { if (!ref.current?.contains(e.target as Node)) setOpen(false); };
    const key = (e: KeyboardEvent) => { if (e.key === 'Escape') setOpen(false); };
    window.addEventListener('mousedown', close);
    window.addEventListener('keydown', key);
    return () => { window.removeEventListener('mousedown', close); window.removeEventListener('keydown', key); };
  }, [open]);
  const items = [
    { id: '__console', label: '3A Platform Console', desc: 'Doanh nghiệp, cấp phép, dữ liệu', icon: Globe, color: BRAND.o2 },
    ...ORGS.map((o) => ({ id: o.id, label: `${o.shortName} Instance`, desc: o.name, icon: o.profile === 'MANUFACTURING' ? Factory : Building2, color: o.color })),
  ];
  const cur = consoleOn ? '__console' : orgId;
  const curItem = items.find((x) => x.id === cur) ?? items[0];
  return (
    <div ref={ref} className="relative">
      <button type="button" onClick={() => setOpen((v) => !v)} aria-haspopup="listbox" aria-expanded={open} aria-label={`Đang ở: ${curItem.label}. Chuyển doanh nghiệp`}
        className={cn('flex items-center gap-1.5 rounded px-1.5 py-1 text-sm transition-colors hover:bg-[#0B5FB8]/15', open && 'bg-[#0B5FB8]/15')}>
        <Logo3A size={18} />
        <span className="hidden text-[#94A3B8] sm:inline">3A Group</span>
        <ChevronRight className="hidden h-3.5 w-3.5 text-[#4B5567] sm:block" aria-hidden />
        <span className="hidden font-semibold text-[#F1F5F9] sm:inline">{consoleOn ? 'Console' : orgOf(orgId).shortName}</span>
        <ChevronDown className={cn('h-3.5 w-3.5 text-[#94A3B8] transition-transform', open && 'rotate-180')} aria-hidden />
      </button>
      {open && (
        <ul role="listbox" aria-label="Chọn không gian làm việc" className="glass absolute left-0 top-full z-[60] mt-1.5 w-72 rounded-md border border-white/10 p-1 shadow-2xl motion-safe:animate-[popIn_.14s_ease-out]">
          {items.map((it) => {
            const on = it.id === cur;
            const Icon = it.icon;
            return (
              <li key={it.id} role="option" aria-selected={on}>
                <button type="button" className={cn('flex w-full items-center gap-3 rounded px-2.5 py-2 text-left hover:bg-[#0B5FB8]/20', on && 'bg-white/[0.05]')}
                  onClick={() => { setOpen(false); if (!on) { if (it.id === '__console') onConsole(); else onSwitch(it.id); } }}>
                  <span className="flex h-8 w-8 shrink-0 items-center justify-center rounded" style={{ background: `${it.color}22`, color: it.color }}><Icon className="h-4 w-4" aria-hidden /></span>
                  <span className="min-w-0 flex-1"><span className="block truncate text-sm font-semibold">{it.label}</span><span className="block truncate text-xs text-[#94A3B8]">{it.desc}</span></span>
                  {on && <CheckCircle2 className="h-4 w-4 shrink-0 text-[#F28C33]" aria-hidden />}
                </button>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  );
}

function ChangePasswordModal({ forced, onClose }: { forced?: boolean; onClose: () => void }) {
  const { me, setUsers, security, audit, notify, logout, platform } = useApp();
  const [cur, setCur] = useState('');
  const [pw, setPw] = useState('');
  const [pw2, setPw2] = useState('');
  const [err, setErr] = useState('');
  const [busy, setBusy] = useState(false);
  const issues = passwordIssues(pw, security, me.email);
  const submit = async () => {
    setErr('');
    if (issues.length) return setErr(issues[0]);
    if (pw !== pw2) return setErr('Nhập lại mật khẩu mới không khớp');
    setBusy(true);
    try {
      if (CLOUD_ON) {
        // Máy chủ: kiểm tra mật khẩu hiện tại rồi đổi trên Supabase Auth; app không giữ mật khẩu
        if (!(await cloud.checkPassword(me.email, cur))) { audit('PASSWORD_CHANGE_FAIL', 'Sai mật khẩu hiện tại khi đổi mật khẩu', 'SECURITY'); setErr('Mật khẩu hiện tại không đúng'); return; }
        if (cur === pw) { setErr('Mật khẩu mới phải khác mật khẩu cũ'); return; }
        await cloud.updatePassword(pw);
        const updC = (p: User[]) => p.map((u) => (u.id === me.id ? { ...u, passwordHash: undefined, salt: undefined, mustChangePassword: false, passwordChangedAt: Date.now() } : u));
        if (platform.userId === me.id) platform.setAdmins(updC); else setUsers(updC);
        audit('PASSWORD_CHANGE', 'Đổi mật khẩu', 'SECURITY');
        notify('Đã đổi mật khẩu', 'teal');
        onClose();
        return;
      }
      if (!(await verifyPassword(me, cur))) { audit('PASSWORD_CHANGE_FAIL', 'Sai mật khẩu hiện tại khi đổi mật khẩu', 'SECURITY'); setErr('Mật khẩu hiện tại không đúng'); return; }
      if (cur === pw) { setErr('Mật khẩu mới phải khác mật khẩu cũ'); return; }
      const h = await hashPassword(pw);
      const upd = (p: User[]) => p.map((u) => (u.id === me.id ? { ...u, passwordHash: h.hash, salt: h.salt, mustChangePassword: false, passwordChangedAt: Date.now() } : u));
      if (platform.userId === me.id) platform.setAdmins(upd); else setUsers(upd);
      audit('PASSWORD_CHANGE', 'Đổi mật khẩu', 'SECURITY');
      notify('Đã đổi mật khẩu', 'teal');
      onClose();
    } catch (e) {
      setErr(CLOUD_ON ? cloudMessage(e) : e instanceof Error ? e.message : 'Không đổi được mật khẩu');
    } finally {
      setBusy(false);
    }
  };
  return (
    <Modal title={forced ? 'Đổi mật khẩu trước khi tiếp tục' : 'Đổi mật khẩu'} onClose={forced ? logout : onClose} footer={<>{forced ? <button className={btnGhost} onClick={logout}>Đăng xuất</button> : <button className={btnGhost} onClick={onClose}>Hủy</button>}<button className={btnPrimary} disabled={busy} onClick={() => void submit()}>{busy ? 'Đang lưu...' : 'Đổi mật khẩu'}</button></>}>
      {forced && <p className="mb-3 rounded bg-[#F28C33]/10 p-3 text-sm text-[#F7B23B]">Tài khoản đang dùng mật khẩu tạm hoặc mật khẩu mặc định. Đặt mật khẩu riêng để tiếp tục.</p>}
      <form className="space-y-3" onSubmit={(e) => { e.preventDefault(); void submit(); }}>
        <Field label="Mật khẩu hiện tại"><input className={inputCls} type="password" autoComplete="current-password" value={cur} onChange={(e) => setCur(e.target.value)} /></Field>
        <Field label="Mật khẩu mới"><input className={inputCls} type="password" autoComplete="new-password" value={pw} onChange={(e) => setPw(e.target.value)} /></Field>
        <Field label="Nhập lại mật khẩu mới"><input className={inputCls} type="password" autoComplete="new-password" value={pw2} onChange={(e) => setPw2(e.target.value)} /></Field>
        <ul className="space-y-0.5 text-xs">
          {[`Tối thiểu ${security.minPasswordLength} ký tự`, 'Có cả chữ và số', 'Có ít nhất 1 chữ hoa', 'Không dùng mật khẩu phổ biến / mặc định', 'Không chứa tên email'].map((rule) => (
            <li key={rule} className={cn('flex items-center gap-1.5', pw && !issues.includes(rule) ? 'text-[#3DDBB6]' : 'text-[#94A3B8]')}><CheckCircle2 className="h-3.5 w-3.5" aria-hidden />{rule}</li>
          ))}
        </ul>
        {err && <p className="text-sm text-[#F87171]" role="alert">{err}</p>}
        <button type="submit" className="hidden" aria-hidden />
      </form>
    </Modal>
  );
}

/** Trạng thái hoạt động: online (< 3 phút), away (< 20 phút), offline. Bản thân luôn online */
type Presence = 'online' | 'away' | 'offline';
const PRESENCE_META: Record<Presence, { label: string; color: string }> = { online: { label: 'Đang hoạt động', color: '#22C55E' }, away: { label: 'Vắng mặt', color: '#F6B533' }, offline: { label: 'Ngoại tuyến', color: '#64748B' } };
const presenceOf = (u: Pick<User, 'id' | 'lastActiveAt' | 'lastLoginAt'> | undefined, meId?: string, now = Date.now()): Presence => {
  if (!u) return 'offline';
  if (u.id === meId) return 'online';
  const t = u.lastActiveAt ?? 0;
  return now - t < 3 * 60000 ? 'online' : now - t < 20 * 60000 ? 'away' : 'offline';
};
/** Avatar có chấm trạng thái */
function PAvatar({ user, name, size = 32, meId }: { user?: Pick<User, 'id' | 'name' | 'lastActiveAt' | 'lastLoginAt'>; name?: string; size?: number; meId?: string }) {
  const p = presenceOf(user, meId);
  const dot = Math.max(8, Math.round(size * 0.3));
  return (
    <span className="relative inline-flex shrink-0 self-start" title={`${user?.name ?? name ?? ''} · ${PRESENCE_META[p].label}`}>
      <Avatar name={user?.name ?? name ?? '?'} size={size} />
      {user && <i className="absolute -bottom-0.5 -right-0.5 rounded-full ring-2 ring-[#0F141E]" style={{ width: dot, height: dot, background: PRESENCE_META[p].color }} aria-label={PRESENCE_META[p].label} />}
    </span>
  );
}

/** Avatar + tên + chức danh; popover gọn: công ty, email, tài khoản, đổi mật khẩu, giao diện, vai trò xem thử, đăng xuất */
function UserMenu({ theme, onTheme, roleSwitch }: { theme?: 'dark' | 'light'; onTheme?: () => void; roleSwitch?: { role: Role; onRole: (r: Role) => void } }) {
  const { me, role, dept, logout, loginAt, security, platform, org, company, go, canSee } = useApp();
  const isPlatform = platform.userId === me.id;
  const unit = isPlatform ? `3A Group Platform · ${org.shortName}` : dept(me.dept)?.short ?? 'Toàn công ty';
  const [open, setOpen] = useState(false);
  const [pwOpen, setPwOpen] = useState(false);
  const ref = useOutsideClose(open, () => setOpen(false));
  const row = 'flex w-full items-center gap-3 rounded px-3 py-2 text-left text-sm text-[#CBD5E1] transition-colors hover:bg-white/[0.06] hover:text-white';
  return (
    <div className="relative" ref={ref}>
      <button className="flex items-center gap-2.5 rounded-md py-1 pl-1 pr-2 transition-colors hover:bg-white/[0.05] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#6FA8F0]" onClick={() => setOpen((v) => !v)} aria-expanded={open} aria-haspopup="true" aria-label={`Tài khoản ${me.name}`}>
        <PAvatar user={me} size={32} meId={me.id} />
        <span className="hidden max-w-[180px] text-left lg:block"><span className="block truncate text-sm font-semibold leading-tight">{me.name}</span><span className="block truncate text-xs text-[#94A3B8]">{ROLE_LABEL[role]}</span></span>
        <ChevronDown className={cn('hidden h-4 w-4 text-[#94A3B8] transition-transform lg:block', open && 'rotate-180')} aria-hidden />
      </button>
      {open && (
        <div className="glass absolute right-0 top-full z-50 mt-2 w-72 rounded-lg border border-white/10 p-2 shadow-2xl motion-safe:animate-[popIn_.15s_ease-out]" role="menu">
          <div className="flex items-center gap-3 px-3 pb-3 pt-2">
            <PAvatar user={me} size={40} meId={me.id} />
            <div className="min-w-0">
              <p className="truncate text-[15px] font-semibold">{me.name}</p>
              <p className="truncate text-xs text-[#94A3B8]">{me.email}</p>
              <p className="mt-0.5 truncate text-xs text-[#F7B23B]" title={ROLE_DESC[role]}>{ROLE_LABEL[role]} · {isPlatform ? 'Quản trị 3A Group' : company.legalName || company.shortName}</p>
            </div>
          </div>
          <div className="border-t border-white/[0.06] py-1">
            {canSee('settings') && <button className={row} role="menuitem" onClick={() => { setOpen(false); go('settings'); }}><Settings className="h-4 w-4" aria-hidden />Cài đặt tài khoản</button>}
            <button className={row} role="menuitem" onClick={() => { setOpen(false); setPwOpen(true); }}><KeyRound className="h-4 w-4" aria-hidden />Đổi mật khẩu</button>
            {onTheme && <button className={row} role="menuitem" onClick={onTheme}>{theme === 'dark' ? <Sun className="h-4 w-4" aria-hidden /> : <Moon className="h-4 w-4" aria-hidden />}<span className="flex-1">Giao diện {theme === 'dark' ? 'sáng' : 'tối'}</span><span className="text-[11px] text-[#7C8796]">Đang: {theme === 'dark' ? 'Tối' : 'Sáng'}</span></button>}
            {roleSwitch && (
              <label className="flex items-center gap-3 px-3 py-2 text-sm text-[#CBD5E1]"><Eye className="h-4 w-4 shrink-0" aria-hidden /><span className="flex-1">Xem với vai trò</span>
                <select className={cn(inputBase, 'w-auto max-w-[130px] py-1 text-xs')} value={roleSwitch.role} onChange={(e) => roleSwitch.onRole(e.target.value as Role)} aria-label="Chuyển vai trò">{ROLES.map((r) => <option key={r} value={r}>{ROLE_LABEL[r]}</option>)}</select>
              </label>
            )}
          </div>
          <p className="border-t border-white/[0.06] px-3 py-2 text-[11px] text-[#7C8796]">{unit} · đăng nhập {loginAt ? new Date(loginAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) : '—'} · tự thoát sau {security.idleMinutes} phút</p>
          <div className="border-t border-white/[0.06] pt-1">
            <button className={cn(row, 'text-[#F87171] hover:bg-[#EF4444]/10 hover:text-[#F87171]')} role="menuitem" onClick={logout}><LogOut className="h-4 w-4" aria-hidden />Đăng xuất</button>
          </div>
        </div>
      )}
      {pwOpen && <ChangePasswordModal onClose={() => setPwOpen(false)} />}
    </div>
  );
}
// =====================================================================
//  MÀN HÌNH ĐĂNG NHẬP
// =====================================================================

// =====================================================================
//  LÕI MÔ HÌNH XƯỞNG: bảng đơn giá m² / md, đơn hàng công trình, lịch thanh toán, phiếu thu
// =====================================================================

const PRICE_UNIT: Record<PriceUnit, { label: string; short: string }> = {
  M2: { label: 'Mét vuông (rộng × cao)', short: 'm²' },
  MD: { label: 'Mét dài', short: 'md' },
  SET: { label: 'Bộ', short: 'bộ' },
  PCS: { label: 'Cái', short: 'cái' },
};
const PAY_TRIGGER: Record<PayTrigger, string> = { SIGN: 'Khi chốt đơn (cọc)', DELIVERY: 'Khi giao hàng / bắt đầu lắp', ACCEPT: 'Khi lắp đặt, nghiệm thu' };
const JOB_LOST: Record<JobLostReason, string> = { PRICE: 'Giá cao', COMPETITOR: 'Chọn đơn vị khác', POSTPONED: 'Khách hoãn công trình', NO_RESPONSE: 'Khách không phản hồi', OTHER: 'Khác' };
const RECEIPT_STATUS: Record<ReceiptStatus, { label: string; tone: Tone }> = {
  HOLDING: { label: 'Nhân viên đang giữ', tone: 'orange' },
  SUBMITTED: { label: 'Chờ kế toán xác nhận', tone: 'blue' },
  CONFIRMED: { label: 'Đã xác nhận', tone: 'teal' },
  REJECTED: { label: 'Kế toán từ chối', tone: 'red' },
};
const DEFAULT_MFG_CONFIG: MfgConfig = {
  schedule: [{ id: 'ps-coc', label: 'Đặt cọc', pct: 30, trigger: 'SIGN' }, { id: 'ps-nt', label: 'Lắp đặt, nghiệm thu', pct: 70, trigger: 'ACCEPT' }],
  vatPct: 0, quoteValidDays: 15, warrantyMonths: 24, submitHours: 24, productionDays: 10, openingCash: 0, openingBank: 0,
  creditDays: 30, dueDays: 3, salesCommissionPct: 3, installCommissionPct: 1.5, agingScheme: 'AGE_30_60',
};

/** Khối lượng tính tiền của 1 dòng: m² = rộng × cao (mm) / 1e6 × SL (áp tối thiểu / tấm), md = dài × SL, bộ / cái = SL */
function lineMeasure(l: JobLine, minMeasure = 0) {
  if (l.unit === 'M2') return Math.round(Math.max((l.width * l.height) / 1e6, minMeasure) * l.qty * 100) / 100;
  if (l.unit === 'MD') return Math.round(Math.max(l.length, minMeasure) * l.qty * 100) / 100;
  return l.qty;
}
const lineAmount = (l: JobLine, minMeasure = 0) => Math.round(lineMeasure(l, minMeasure) * l.unitPrice * (1 - l.discountPct / 100));
const lineCost = (l: JobLine, minMeasure = 0) => Math.round(lineMeasure(l, minMeasure) * l.unitCost);
function quoteTotalsOf(lines: JobLine[], vatPct: number, items: PriceItem[]) {
  const min = (l: JobLine) => items.find((p) => p.id === l.priceItemId)?.minMeasure ?? 0;
  const subtotal = lines.reduce((s, l) => s + lineAmount(l, min(l)), 0);
  const cost = lines.reduce((s, l) => s + lineCost(l, min(l)), 0);
  return { subtotal, vat: Math.round((subtotal * vatPct) / 100), total: subtotal + Math.round((subtotal * vatPct) / 100), cost };
}
const lineDims = (l: JobLine) => (l.unit === 'M2' ? `${l.width} × ${l.height} mm` : l.unit === 'MD' ? `${l.length} m` : '');

/** Giai đoạn đơn hàng (quy trình rút gọn): suy ra từ báo giá, cọc, lệnh sản xuất, lắp đặt, tiền đã thu */
type JobStage = 'SURVEY' | 'QUOTED' | 'PRODUCTION' | 'INSTALL' | 'WAIT_PAYMENT' | 'DONE' | 'LOST';
const JOB_STAGES: JobStage[] = ['SURVEY', 'QUOTED', 'PRODUCTION', 'INSTALL', 'WAIT_PAYMENT', 'DONE'];
const JOB_STAGE: Record<JobStage, { label: string; short: string; color: string; tone: Tone }> = {
  SURVEY: { label: 'Đang chờ khảo sát', short: 'Chờ khảo sát', color: '#8B5CF6', tone: 'blue' },
  QUOTED: { label: 'Đã báo giá, chờ chốt', short: 'Đã báo giá', color: '#1F74D4', tone: 'blue' },
  PRODUCTION: { label: 'Sản xuất', short: 'Sản xuất', color: '#F28C33', tone: 'orange' },
  INSTALL: { label: 'Lắp đặt', short: 'Lắp đặt', color: '#06B6D4', tone: 'orange' },
  WAIT_PAYMENT: { label: 'Đã nghiệm thu, chờ thu tiền', short: 'Chờ thu tiền', color: '#EF4444', tone: 'red' },
  DONE: { label: 'Hoàn tất, đang bảo hành', short: 'Hoàn tất', color: '#00B894', tone: 'teal' },
  LOST: { label: 'Trượt', short: 'Trượt', color: '#94A3B8', tone: 'muted' },
};
const WO_STAGES: WoStage[] = ['WAITING', 'IN_PROGRESS', 'DONE'];
const WO_STAGE: Record<WoStage, { label: string; color: string; tone: Tone }> = {
  WAITING: { label: 'Chờ sản xuất', color: '#F6B533', tone: 'orange' },
  IN_PROGRESS: { label: 'Đang sản xuất', color: '#1F74D4', tone: 'blue' },
  DONE: { label: 'Đã hoàn thành', color: '#00B894', tone: 'teal' },
};
function jobMoney(job: Job, receipts: Receipt[]) {
  const mine = receipts.filter((r) => r.jobId === job.id && r.status !== 'REJECTED');
  const confirmed = mine.filter((r) => r.status === 'CONFIRMED').reduce((s, r) => s + r.amount, 0);
  const pending = mine.filter((r) => r.status !== 'CONFIRMED').reduce((s, r) => s + r.amount, 0);
  const value = job.contractValue ?? 0;
  return { value, confirmed, pending, collected: confirmed + pending, remaining: Math.max(0, value - confirmed - pending), receivable: Math.max(0, value - confirmed) };
}
function jobStageOf(job: Job, wos: WorkOrder[], installs: InstallJob[], receipts: Receipt[]): JobStage {
  if (job.lostAt) return 'LOST';
  if (!job.wonAt) return job.quotes.length ? 'QUOTED' : 'SURVEY';
  if (installs.some((i) => i.jobId === job.id && i.status === 'ACCEPTED')) {
    const m = jobMoney(job, receipts);
    return m.confirmed >= m.value ? 'DONE' : 'WAIT_PAYMENT';
  }
  const wo = wos.find((w) => w.jobId === job.id);
  return wo?.stage === 'DONE' ? 'INSTALL' : 'PRODUCTION';
}
/** Trạng thái chi tiết hiển thị trong bảng (vd. "Đang sản xuất", "Đã hẹn lắp 12/10 08:00") */
function jobDetailOf(job: Job, stage: JobStage, wos: WorkOrder[], installs: InstallJob[], receipts: Receipt[]) {
  const wo = wos.find((w) => w.jobId === job.id);
  const ins = installs.filter((i) => i.jobId === job.id).sort((a, b) => b.from.localeCompare(a.from))[0];
  const m = jobMoney(job, receipts);
  switch (stage) {
    case 'SURVEY': return job.appointmentAt ? `Hẹn khảo sát ${fmtDT(job.appointmentAt)}` : 'Chưa hẹn lịch khảo sát';
    case 'QUOTED': { const q = job.quotes[job.quotes.length - 1]; return `Báo giá v${q.version}: ${compact(q.total)}`; }
    case 'PRODUCTION': return wo ? WO_STAGE[wo.stage].label : 'Chờ sản xuất';
    case 'INSTALL': return ins ? (ins.status === 'IN_PROGRESS' ? 'Đang lắp đặt' : `Đã hẹn lắp ${fmtDT(ins.from)}`) : 'Sản xuất xong, chờ hẹn lắp';
    case 'WAIT_PAYMENT': return m.pending > 0 && m.remaining <= 0 ? `Chờ kế toán xác nhận ${compact(m.pending)}` : `Còn phải thu ${compact(m.remaining)}`;
    case 'DONE': return job.warrantyMonths ? `Bảo hành ${job.warrantyMonths} tháng` : 'Hoàn tất';
    default: return job.lostReason ? JOB_LOST[job.lostReason] : '';
  }
}
/** Số tiền phải thu tới mốc hiện tại theo lịch thanh toán */
function dueByStage(job: Job, stage: JobStage) {
  const reached: PayTrigger[] = ['SIGN', ...(['INSTALL', 'WAIT_PAYMENT', 'DONE'].includes(stage) ? ['DELIVERY' as PayTrigger] : []), ...(['WAIT_PAYMENT', 'DONE'].includes(stage) ? ['ACCEPT' as PayTrigger] : [])];
  const pct = job.schedule.filter((s) => reached.includes(s.trigger)).reduce((s, x) => s + x.pct, 0);
  return Math.round(((job.contractValue ?? 0) * pct) / 100);
}
/** Cần chăm sóc: đã báo giá chưa chốt, hoặc đã trượt */
const needsCare = (stage: JobStage) => stage === 'QUOTED' || stage === 'LOST';

// ---------------- Kho vật tư & thu chi: tính toán ----------------
const STOCK_MOVE: Record<InvMoveType, { label: string; prefix: string; tone: Tone }> = {
  IN: { label: 'Nhập kho', prefix: 'PN', tone: 'teal' },
  OUT: { label: 'Xuất kho', prefix: 'PX', tone: 'orange' },
  ADJUST: { label: 'Kiểm kê', prefix: 'KK', tone: 'blue' },
};
const signedQty = (m: InvMove) => (m.type === 'OUT' ? -m.qty : m.qty);
/** Tồn và giá bình quân của 1 vật tư đến hết ngày `until` (ISO, bỏ trống = tới nay) */
function stockOf(itemId: string, moves: InvMove[], until?: string) {
  let qty = 0, value = 0;
  for (const m of [...moves].filter((x) => x.itemId === itemId && (!until || x.date <= until)).sort((a, b) => a.date.localeCompare(b.date) || a.at - b.at)) {
    const avg = qty > 0 ? value / qty : m.unitCost;
    if (m.type === 'IN') { qty += m.qty; value += m.qty * m.unitCost; }
    else { const d = signedQty(m); qty += d; value += d * (m.type === 'ADJUST' && d > 0 ? m.unitCost || avg : avg); }
    if (qty <= 0) { value = 0; }
  }
  return { qty: Math.round(qty * 1000) / 1000, value: Math.max(0, Math.round(value)), avg: qty > 0 ? value / qty : 0 };
}
const CASH_ACCOUNT: Record<CashAccount, string> = { CASH: 'Quỹ tiền mặt', BANK: 'Tài khoản ngân hàng' };
const CASH_IN_CATS = ['Thu khác', 'Góp vốn / vay', 'Hoàn tiền nhà cung cấp', 'Bán phế liệu'];
const CASH_OUT_CATS = ['Vật tư, nguyên liệu', 'Nhân công lắp đặt', 'Vận chuyển', 'Lương, thưởng', 'Mặt bằng, điện nước', 'Marketing', 'Hoa hồng giới thiệu', 'Bảo hành, sửa chữa', 'Chi khác'];
/** Phiếu thu quỹ tự sinh khi kế toán xác nhận tiền khách hàng */
function receiptCash(r: Receipt, job: Job | undefined, customers: Customer[]): CashDraft {
  return {
    kind: 'IN', account: r.method === 'CASH' ? 'CASH' : 'BANK', category: 'Thu tiền khách hàng', amount: r.amount, partner: job ? jobCustName(job, customers) : undefined,
    jobId: r.jobId, ref: r.code, note: job ? `${job.code} ${job.title}` : r.note, source: 'RECEIPT', sourceId: r.id,
  };
}
/** Phiếu chi tạm ứng công tác tự sinh khi lịch công tác có tạm ứng được duyệt */
function advanceCash(a: Activity, users: User[]): CashDraft | null {
  if (a.type !== 'TRIP' || !(a.advance && a.advance > 0)) return null;
  return {
    kind: 'OUT', account: 'CASH', category: 'Tạm ứng công tác', amount: a.advance, partner: users.find((u) => u.id === a.userId)?.name,
    ref: a.title, note: `Tạm ứng${a.location ? ` đi ${a.location}` : ''}, quyết toán khi nộp chứng từ`, source: 'ADVANCE', sourceId: a.id,
  };
}
/** Quyết toán công tác phí khi kế toán xác nhận thanh toán: trừ phần đã tạm ứng (nếu đã chi); tạm ứng thừa thì sinh phiếu thu hoàn ứng */
function expenseCash(a: Activity, users: User[], entries: CashEntry[] = []): CashDraft {
  const total = (a.expenses ?? []).reduce((s, x) => s + x.amount, 0);
  const adv = entries.filter((e) => e.source === 'ADVANCE' && e.sourceId === a.id).reduce((s, e) => s + e.amount, 0);
  const net = total - adv;
  return {
    kind: net >= 0 ? 'OUT' : 'IN', account: 'CASH', category: net >= 0 ? (a.programId ? 'Chi phí triển khai sự kiện' : 'Công tác phí') : 'Hoàn ứng công tác', amount: Math.abs(net), partner: users.find((u) => u.id === a.userId)?.name,
    ref: a.title, note: `${(a.expenses ?? []).map((x) => x.name).join(', ')}${adv ? `. Chứng từ ${vnd(total)}, đã tạm ứng ${vnd(adv)}` : ''}`, source: 'EXPENSE', sourceId: a.id,
  };
}
/** Dòng sổ quỹ: phiếu thu / chi tự lập + tiền thu khách hàng đã được kế toán xác nhận */
type CashLine = { id: string; code: string; date: string; account: CashAccount; kind: 'IN' | 'OUT'; category: string; amount: number; partner?: string; jobId?: string; note?: string; ref?: string; auto?: boolean; source?: CashSource; entryId?: string };
/**
 * Sổ quỹ = phiếu đã lập (kể cả phiếu tự sinh khi kế toán xác nhận thu tiền / thanh toán công tác phí)
 * + phần ghi nhận từ dữ liệu cũ chưa có phiếu (phiếu thu đã xác nhận, công tác phí đã thanh toán trước bản v18).
 */
function cashLines(entries: CashEntry[], receipts: Receipt[], jobs: Job[], customers: Customer[], activities: Activity[] = [], users: User[] = []): CashLine[] {
  const out: CashLine[] = [];
  for (const e of entries) {
    const auto = !!e.source && e.source !== 'MANUAL';
    if (e.kind === 'TRANSFER') {
      out.push({ id: `${e.id}-o`, entryId: e.id, code: e.code, date: e.date, account: e.account, kind: 'OUT', category: 'Chuyển quỹ', amount: e.amount, note: `Sang ${CASH_ACCOUNT[e.toAccount ?? 'BANK']}${e.note ? `. ${e.note}` : ''}` });
      out.push({ id: `${e.id}-i`, entryId: e.id, code: e.code, date: e.date, account: e.toAccount ?? 'BANK', kind: 'IN', category: 'Chuyển quỹ', amount: e.amount, note: `Từ ${CASH_ACCOUNT[e.account]}${e.note ? `. ${e.note}` : ''}` });
    } else out.push({ id: e.id, entryId: e.id, code: e.code, date: e.date, account: e.account, kind: e.kind, category: e.category, amount: e.amount, partner: e.partner, jobId: e.jobId, note: e.note, ref: e.ref, auto, source: e.source });
  }
  const has = (src: CashSource, id: string) => entries.some((e) => e.source === src && e.sourceId === id);
  for (const r of receipts) {
    if (r.status !== 'CONFIRMED' || !r.confirmedAt || has('RECEIPT', r.id)) continue;
    const j = jobs.find((x) => x.id === r.jobId);
    out.push({ id: `rc-${r.id}`, code: r.code, date: iso(new Date(r.confirmedAt)), account: r.method === 'CASH' ? 'CASH' : 'BANK', kind: 'IN', category: 'Thu tiền khách hàng', amount: r.amount,
      partner: j ? jobCustName(j, customers) : undefined, jobId: r.jobId, note: j ? `${j.code} ${j.title}` : r.note, ref: r.code, auto: true, source: 'RECEIPT' });
  }
  for (const a of activities) {
    if (a.expenseStatus !== 'PAID' || has('EXPENSE', a.id)) continue;
    const total = (a.expenses ?? []).reduce((s, x) => s + x.amount, 0);
    if (!total) continue;
    out.push({ id: `ex-${a.id}`, code: `CTP-${a.id.slice(-5).toUpperCase()}`, date: iso(new Date(a.expenseSubmittedAt ?? Date.parse(a.to))), account: 'CASH', kind: 'OUT', category: a.programId ? 'Chi phí triển khai sự kiện' : 'Công tác phí', amount: total,
      partner: users.find((u) => u.id === a.userId)?.name, note: a.title, auto: true, source: 'EXPENSE' });
  }
  return out.sort((a, b) => b.date.localeCompare(a.date) || b.code.localeCompare(a.code));
}
/** Chi phí thực tế của đơn: vật tư xuất kho cho đơn / lệnh SX + phiếu chi gắn đơn */
function jobActualCost(job: Job, moves: InvMove[], entries: CashEntry[], wos: WorkOrder[]) {
  const woIds = new Set(wos.filter((w) => w.jobId === job.id).map((w) => w.id));
  const material = moves.filter((m) => m.type === 'OUT' && (m.jobId === job.id || (m.woId && woIds.has(m.woId)))).reduce((s, m) => s + m.qty * m.unitCost, 0);
  const other = entries.filter((e) => e.kind === 'OUT' && e.jobId === job.id).reduce((s, e) => s + e.amount, 0);
  return { material: Math.round(material), other, total: Math.round(material) + other };
}
/** Phiếu tiền mặt giữ quá hạn nộp (mặc định trong ngày) */
const holdingOverdue = (r: Receipt, now: number, hours: number) => r.status === 'HOLDING' && (now - r.collectedAt > hours * 3.6e6 || new Date(r.collectedAt).toDateString() !== new Date(now).toDateString() && new Date(now).getHours() >= 8);

/** Nén ảnh (khảo sát, chuyển khoản, bản vẽ dạng ảnh) để lưu được trong dữ liệu */
async function compressImage(file: File, maxSide = 1280): Promise<string> {
  const src = URL.createObjectURL(file);
  try {
    const img = await new Promise<HTMLImageElement>((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = () => rej(new Error('Không đọc được ảnh')); i.src = src; });
    const k = Math.min(1, maxSide / Math.max(img.width, img.height));
    const c = document.createElement('canvas');
    c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
    c.getContext('2d')?.drawImage(img, 0, 0, c.width, c.height);
    return c.toDataURL('image/jpeg', 0.72);
  } finally { URL.revokeObjectURL(src); }
}

