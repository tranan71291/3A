  const j4 = won(J('j4', { title: 'Cửa nhôm, lan can kính biệt thự Thảo Điền', customerId: 'k4', leadId: 'l7', ownerId: P + 'kt2', siteAddress: '42/7 Nguyễn Văn Hưởng, Thảo Điền', createdAt: isoD(-9), surveyCheckins: ci(-9, 'kt2'),
