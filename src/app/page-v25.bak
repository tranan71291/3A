  // ---- Lệnh sản xuất & lắp đặt gắn đơn ----
  const hist = (stages: WoStage[], start: number) => stages.map((st, i) => ({ stage: st, at: ms(start + i * 3, 10), by: P + 'xuong' }));
  const WO = (id: string, j: Job, stage: WoStage, startDay: number, dueDay: number): WorkOrder => {
    const stages = WO_STAGES.slice(0, WO_STAGES.indexOf(stage) + 1);
    const w = buildWorkOrder(j, wonQuoteOf(j)!, customers.find((c) => c.id === j.customerId)?.name ?? '', `LSX-DEMO-${id.slice(2).padStart(2, '0')}`, P + 'xuong', P + 'kt1', dueDay - startDay, '');
    return { ...w, id: P + id, stage, startDate: isoD(startDay), dueDate: isoD(dueDay), createdAt: isoD(startDay), history: hist(stages, startDay),
      startedAt: stage !== 'WAITING' ? ms(startDay + 1, 8) : undefined, doneAt: stage === 'DONE' ? ms(Math.min(dueDay, -1), 16) : undefined, items: w.items.map((x) => ({ ...x, done: stage === 'DONE' ? x.qty : 0 })) };
