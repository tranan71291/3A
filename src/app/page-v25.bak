  'rounded border border-[#263044] bg-[#0B1019] px-3 py-2 text-sm text-[#F1F5F9] placeholder:text-[#94A3B8]/60 focus:border-[#0B5FB8] focus:outline-none focus:ring-1 focus:ring-[#0B5FB8]/60 disabled:opacity-50 [&>option]:bg-[#151C29]';
const inputCls = `w-full ${inputBase}`;

function Panel({ title, action, children, className }: { title?: ReactNode; action?: ReactNode; children: ReactNode; className?: string }) {
  return (
    <section className={cn('glass-card rounded-md p-5', className)}>
      {(title || action) && (
        <div className="mb-4 flex flex-wrap items-center justify-between gap-3">
          {title && <h2 className="font-display text-[15px] font-bold tracking-tight text-[#F1F5F9]">{title}</h2>}
          {action}
        </div>
      )}
      {children}
    </section>
  );
}

function Chip({ tone = 'muted', children }: { tone?: Tone; children: ReactNode }) {
  const t: Record<Tone, string> = {
    muted: 'bg-white/[0.06] text-[#94A3B8]',
    orange: 'bg-[#F28C33]/15 text-[#F7B23B]',
    teal: 'bg-[#00B894]/15 text-[#3DDBB6]',
    red: 'bg-[#EF4444]/15 text-[#F87171]',
    // Chuẩn 3 màu trạng thái: Teal = chốt / đủ, Cam = chờ / đang tiến hành, Đỏ = trượt / quá hạn / nợ xấu.
    // "blue" cũ (đã gửi, chờ xác nhận...) quy về họ Cam dạng viền để vẫn phân biệt với "đang làm"
    blue: 'bg-[#0B5FB8]/15 text-[#6FA8F0] ring-1 ring-inset ring-[#0B5FB8]/45',
  };
  return <span className={cn('inline-flex items-center gap-1 whitespace-nowrap rounded-sm px-2 py-0.5 text-xs font-medium', t[tone])}>{children}</span>;
}

/**
 * Chuỗi theo tháng (cũ → mới) cho sparkline dưới KPI: đếm hoặc cộng giá trị theo tháng phát sinh.
 * `cumulative` = lũy kế (vd. tổng khách hàng). Mặc định 6 tháng tính đến tháng hiện tại.
 */
function monthly<T>(items: T[], when: (x: T) => string | number | undefined, val: (x: T) => number = () => 1, n = 6, cumulative = false): number[] {
  const now = new Date();
  const keys = Array.from({ length: n }, (_, i) => { const d = new Date(now.getFullYear(), now.getMonth() - (n - 1 - i), 1); return d.getFullYear() * 12 + d.getMonth(); });
  const out = keys.map(() => 0);
  let before = 0;
  for (const x of items) {
    const w = when(x);
    if (w === undefined || w === '') continue;
    const d = new Date(typeof w === 'number' ? w : w.length <= 10 ? `${w}T12:00:00` : w);
    if (Number.isNaN(d.getTime())) continue;
    const k = d.getFullYear() * 12 + d.getMonth();
    const i = keys.indexOf(k);
    if (i >= 0) out[i] += val(x);
    else if (k < keys[0]) before += val(x);
  }
  if (!cumulative) return out;
  let acc = before;
  return out.map((v) => (acc += v));
}
/** Thời điểm nhận lead (dữ liệu lưu số ngày trước) */
const leadAt = (l: { receivedDaysAgo: number; routedAt?: number }) => l.routedAt ?? Date.now() - l.receivedDaysAgo * 864e5;

/** Biểu đồ mini (sparkline) SVG thuần, không phụ thuộc thư viện: thể hiện xu hướng dưới con số KPI */
function Sparkline({ data, color = BRAND.o2, height = 26, className }: { data: number[]; color?: string; height?: number; className?: string }) {
  const pts = data.filter((x) => Number.isFinite(x));
  if (pts.length < 2 || pts.every((v) => v === 0)) return null;
  const w = 100;
  const max = Math.max(...pts);
  const min = Math.min(...pts);
  const span = max - min || 1;
  const xy = pts.map((v, i) => [(i / (pts.length - 1)) * w, height - 2 - ((v - min) / span) * (height - 4)] as const);
  const line = xy.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
  const id = `sp${color.replace('#', '')}${pts.length}`;
  return (
    <svg viewBox={`0 0 ${w} ${height}`} preserveAspectRatio="none" className={cn('block w-full', className)} style={{ height }} aria-hidden>
      <defs><linearGradient id={id} x1="0" x2="0" y1="0" y2="1"><stop offset="0" stopColor={color} stopOpacity=".28" /><stop offset="1" stopColor={color} stopOpacity="0" /></linearGradient></defs>
      <polygon points={`0,${height} ${line} ${w},${height}`} fill={`url(#${id})`} />
      <polyline points={line} fill="none" stroke={color} strokeWidth="1.6" vectorEffect="non-scaling-stroke" strokeLinejoin="round" strokeLinecap="round" />
      <circle cx={xy[xy.length - 1][0]} cy={xy[xy.length - 1][1]} r="2" fill={color} vectorEffect="non-scaling-stroke" />
    </svg>
  );
}

/**
 * Thẻ KPI phong cách "Data-Driven Minimalism": không nền khối, không viền; icon + tên chỉ số + số lớn,
 * phân cách bằng vạch dọc siêu mờ, sparkline xu hướng (cam = chỉ số chính, xanh dương = đối chiếu).
 * `highlight` = KPI quan trọng: số hiển thị bằng gradient cam → vàng của logo.
 */
function StatCard({ label, value, sub, icon: Icon, color = C.orange, delta, deltaLabel = 'so với kỳ trước', spark, highlight }: { label: string; value: string; sub?: string; icon: typeof Wallet; color?: string; delta?: number | null; deltaLabel?: string; spark?: number[]; highlight?: boolean }) {
  const tint = color === C.text || color === C.muted ? BRAND.blueHi : color;
  const sparkColor = color === C.teal || color === C.red ? color : color === C.orange || color === BRAND.o2 ? BRAND.o2 : BRAND.blueHi;
  return (
    <div className="kpi flex min-w-0 flex-col gap-2 border-l border-white/[0.07] py-1 pl-4 pr-2">
      <div className="flex min-w-0 items-center gap-2">
        <Icon className="h-4 w-4 shrink-0" style={{ color: tint }} aria-hidden />
        <p className="min-w-0 truncate text-xs font-medium uppercase tracking-wide text-[#94A3B8]">{label}</p>
      </div>
      <p className={cn('font-display truncate text-2xl font-extrabold tracking-tight tabular-nums sm:text-[28px] sm:leading-8', highlight ? 'g-brand-text' : 'text-[#F1F5F9]')}>{value}</p>
      {spark && spark.length > 1 ? <Sparkline data={spark} color={sparkColor} /> : null}
      {delta !== undefined && delta !== null && Number.isFinite(delta) ? (
        <p className={cn('flex items-center gap-1 text-xs tabular-nums', delta >= 0 ? 'text-[#3DDBB6]' : 'text-[#F87171]')}>
          {delta >= 0 ? <ArrowUp className="h-3 w-3" aria-hidden /> : <ArrowDown className="h-3 w-3" aria-hidden />}
          {Math.abs(delta).toFixed(0)}% <span className="hidden truncate text-[#94A3B8] sm:inline">{deltaLabel}</span>
        </p>
      ) : sub ? <p className="truncate text-xs text-[#94A3B8]">{sub}</p> : null}
    </div>
  );
}

/** Thanh tab; `aside` = nội dung nằm cùng hàng bên phải (vd. bộ lọc thời gian) */
function Tabs<T extends string>({ tabs, value, onChange, variant = 'line', aside }: { tabs: { id: T; label: string; count?: number }[]; value: T; onChange: (v: T) => void; variant?: 'line' | 'pill'; aside?: ReactNode }) {
  const side = aside ? <div className="hidden shrink-0 lg:block">{aside}</div> : null;
  if (variant === 'pill') {
    return (
      <div className="flex items-center gap-3">
        <div className="flex min-w-0 flex-1 gap-1 overflow-x-auto rounded-md border border-[#263044] bg-[#151C29] p-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="tablist">
          {tabs.map((t) => (
            <button key={t.id} role="tab" aria-selected={value === t.id} onClick={() => onChange(t.id)}
              className={cn('whitespace-nowrap rounded px-3.5 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F28C33]', value === t.id ? 'g-brand font-semibold text-[#0F141E]' : 'text-[#94A3B8] hover:bg-[#0B5FB8]/15 hover:text-[#F1F5F9]')}>
              {t.label}{t.count !== undefined && <span className="ml-1.5 tabular-nums opacity-80">{t.count}</span>}
            </button>
          ))}
        </div>
        {side}
      </div>
    );
  }
  return (
    <div className="flex items-center gap-3 border-b border-[#263044]">
      <div className="flex min-w-0 flex-1 gap-1 overflow-x-auto overflow-y-hidden [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="tablist">
        {tabs.map((t) => (
          <button
            key={t.id}
            role="tab"
            aria-selected={value === t.id}
            onClick={() => onChange(t.id)}
            className={cn(
              '-mb-px whitespace-nowrap border-b-2 px-4 py-2.5 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F28C33]',
              value === t.id ? 'border-[#F28C33] text-[#F7B23B]' : 'border-transparent text-[#94A3B8] hover:text-[#F1F5F9]',
            )}
          >
            {t.label}{t.count !== undefined && <span className="ml-1.5 tabular-nums opacity-80">{t.count}</span>}
          </button>
        ))}
      </div>
      {side && <div className="pb-1.5">{side}</div>}
    </div>
  );
}

function Field({ label, error, hint, children, className }: { label: string; error?: string; hint?: string; children: ReactNode; className?: string }) {
  return (
    <label className={cn('block', className)}>
      <span className="mb-1.5 block text-xs font-medium text-[#94A3B8]">{label}</span>
      {children}
      {error ? <span className="mt-1 block text-xs text-[#F87171]">{error}</span> : hint ? <span className="mt-1 block text-xs text-[#94A3B8]">{hint}</span> : null}
    </label>
  );
}

/** Ô nhập tiền VNĐ — hiển thị có dấu chấm phân cách */
function MoneyInput({ value, onChange, disabled }: { value: number; onChange: (n: number) => void; disabled?: boolean }) {
  return (
    <div className="relative">
      <input
        className={cn(inputCls, 'pr-8 tabular-nums')}
        inputMode="numeric"
        disabled={disabled}
        value={value ? new Intl.NumberFormat('vi-VN').format(value) : ''}
        onChange={(e) => onChange(digits(e.target.value))}
        placeholder="0"
      />
      <span className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-sm text-[#94A3B8]">₫</span>
    </div>
  );
}

/** Đưa lớp phủ ra thẳng <body>: không bị cha có transform / overflow (drawer, bảng cuộn) cắt mất (lỗi hộp Sửa khách hàng bị che) */
const portal = (node: ReactNode) => (typeof document === 'undefined' ? node : createPortal(node, document.body));

/** Khung trượt từ cạnh phải (bộ lọc, bình luận...) */
function SideSheet({ title, sub, onClose, children, footer, width = 'sm:w-[400px]' }: { title: string; sub?: ReactNode; onClose: () => void; children: ReactNode; footer?: ReactNode; width?: string }) {
  useEffect(() => {
    const k = (e: KeyboardEvent) => { if (e.key === 'Escape') onClose(); };
    window.addEventListener('keydown', k);
    return () => window.removeEventListener('keydown', k);
  }, [onClose]);
  return portal(
    <div className="fixed inset-0 z-[62]" role="dialog" aria-modal="true" aria-label={title}>
      <div className="absolute inset-0 bg-black/50 motion-safe:animate-[fadeIn_.15s_ease-out]" onClick={onClose} />
      <aside className={cn('absolute inset-y-0 right-0 flex w-full flex-col border-l border-white/[0.08] bg-[#121928] shadow-[-20px_0_60px_rgba(0,0,0,.5)] motion-safe:animate-[slideIn_.2s_ease-out]', width)}>
        <header className="flex items-start justify-between gap-3 border-b border-white/[0.06] px-5 py-4">
          <div className="min-w-0"><h2 className="font-display text-base font-bold">{title}</h2>{sub && <div className="mt-0.5 text-xs text-[#94A3B8]">{sub}</div>}</div>
          <button className={cn(btnGhost, 'p-1.5')} onClick={onClose} aria-label="Đóng"><X className="h-4 w-4" /></button>
        </header>
        <div className="flex-1 overflow-y-auto px-5 py-4">{children}</div>
        {footer && <footer className="flex flex-wrap items-center gap-2 border-t border-white/[0.06] px-5 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-3">{footer}</footer>}
      </aside>
    </div>,
  );
}

function Modal({ title, onClose, children, footer, wide }: { title: string; onClose: () => void; children: ReactNode; footer?: ReactNode; wide?: boolean }) {
  useEffect(() => {
    const k = (e: KeyboardEvent) => { if (e.key === 'Escape') onClose(); };
    window.addEventListener('keydown', k);
    return () => window.removeEventListener('keydown', k);
  }, [onClose]);
  return portal(
    <div className="fixed inset-0 z-[65] flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-label={title}>
      <div className="absolute inset-0 bg-black/60 motion-safe:animate-[fadeIn_.15s_ease-out]" onClick={onClose} />
      <div className={cn('relative flex max-h-[92vh] w-full flex-col rounded-t-lg border border-[#263044] bg-[#151C29] shadow-2xl sm:rounded motion-safe:animate-[popIn_.18s_ease-out]', wide ? 'sm:max-w-3xl' : 'sm:max-w-lg')}>
        <header className="flex items-center justify-between gap-3 border-b border-[#263044] px-5 py-4">
          <h2 className="text-base font-semibold text-[#F1F5F9]">{title}</h2>
          <button className={cn(btnGhost, 'p-1.5')} onClick={onClose} aria-label="Đóng"><X className="h-4 w-4" /></button>
        </header>
        <div className="flex-1 overflow-y-auto px-5 py-4">{children}</div>
        {footer && <footer className="flex flex-wrap justify-end gap-2 border-t border-[#263044] px-5 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-4 sm:pb-4">{footer}</footer>}
      </div>
    </div>
  );
}

/** Vùng chọn / kéo-thả file từ máy tính */
function FilePicker({ accept, multiple, onFiles, children, disabled, className }: { accept?: string; multiple?: boolean; onFiles: (f: File[]) => void; children: ReactNode; disabled?: boolean; className?: string }) {
  const ref = useRef<HTMLInputElement>(null);
  const [over, setOver] = useState(false);
  return (
    <div
      role="button"
      tabIndex={disabled ? -1 : 0}
      aria-disabled={disabled}
      onClick={() => !disabled && ref.current?.click()}
      onKeyDown={(e) => { if (!disabled && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); ref.current?.click(); } }}
      onDragOver={(e) => { e.preventDefault(); if (!disabled) setOver(true); }}
      onDragLeave={() => setOver(false)}
      onDrop={(e: DragEvent) => {
        e.preventDefault();
        setOver(false);
        if (!disabled && e.dataTransfer.files.length) onFiles(Array.from(e.dataTransfer.files));
      }}
      className={cn('cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-[#F28C33]', over && 'ring-2 ring-[#F28C33]', disabled && 'cursor-not-allowed opacity-40', className)}
    >
      <input
        ref={ref}
        type="file"
        hidden
        accept={accept}
        multiple={multiple}
        onChange={(e) => {
          if (e.target.files?.length) onFiles(Array.from(e.target.files));
          e.target.value = '';
        }}
      />
      {children}
    </div>
  );
}


/** Hình minh họa nét mảnh cho trạng thái trống (line-art, theo màu thương hiệu) */
function EmptyArt({ kind }: { kind: 'search' | 'box' | 'calendar' | 'doc' | 'ledger' | 'inbox' }) {
  const stroke = { fill: 'none', stroke: 'currentColor', strokeWidth: 1.4, strokeLinecap: 'round' as const, strokeLinejoin: 'round' as const };
  const accent = { fill: 'none', stroke: 'url(#emptyGrad)', strokeWidth: 2, strokeLinecap: 'round' as const };
  return (
    <svg viewBox="0 0 120 84" width="120" height="84" className="text-[#3A4660]" aria-hidden>
      <defs><linearGradient id="emptyGrad" x1="0" x2="1"><stop offset="0" stopColor={BRAND.o1} /><stop offset=".55" stopColor={BRAND.o2} /><stop offset="1" stopColor={BRAND.o3} /></linearGradient></defs>
      <path d="M14 74h92" {...stroke} strokeDasharray="2 5" />
      {kind === 'search' && <><rect x="26" y="14" width="50" height="46" rx="3" {...stroke} /><path d="M34 26h30M34 34h22M34 42h26" {...stroke} /><circle cx="78" cy="50" r="12" {...accent} /><path d="M87 59l10 10" {...accent} /><circle cx="78" cy="50" r="4" fill={BRAND.blue} opacity=".8" /></>}
      {kind === 'box' && <><path d="M30 34l30-14 30 14v28L60 76 30 62z" {...stroke} /><path d="M30 34l30 14 30-14M60 48v28" {...stroke} /><path d="M45 27l30 14" {...accent} /><circle cx="60" cy="48" r="3" fill={BRAND.blue} /></>}
      {kind === 'calendar' && <><rect x="28" y="18" width="64" height="52" rx="3" {...stroke} /><path d="M28 32h64M42 12v12M78 12v12" {...stroke} /><path d="M40 44h8M56 44h8M72 44h8M40 56h8M56 56h8" {...stroke} /><rect x="70" y="52" width="12" height="10" rx="2" {...accent} /></>}
      {kind === 'doc' && <><path d="M36 10h34l14 14v50H36z" {...stroke} /><path d="M70 10v14h14" {...stroke} /><path d="M44 38h30M44 46h30M44 54h18" {...stroke} /><path d="M44 30h16" {...accent} /><circle cx="78" cy="62" r="3" fill={BRAND.blue} /></>}
      {kind === 'ledger' && <><rect x="30" y="12" width="60" height="60" rx="3" {...stroke} /><path d="M40 26h40M40 36h40M40 46h40M40 56h24" {...stroke} /><path d="M66 56h14" {...accent} /><path d="M58 12v60" {...stroke} strokeDasharray="2 3" /></>}
      {kind === 'inbox' && <><path d="M24 44l12-26h48l12 26v24H24z" {...stroke} /><path d="M24 44h22l4 8h20l4-8h22" {...stroke} /><path d="M48 30h24" {...accent} /><circle cx="60" cy="38" r="3" fill={BRAND.blue} /></>}
    </svg>
  );
}

/** Trạng thái trống: minh họa + thông điệp rõ ràng + nút hành động (nếu có) */
function EmptyState({ text, hint, art, action, onAction, compact }: { text: ReactNode; hint?: ReactNode; art?: 'search' | 'box' | 'calendar' | 'doc' | 'ledger' | 'inbox'; action?: string; onAction?: () => void; compact?: boolean }) {
  const kind = art ?? 'box';
  return (
    <div className={cn('flex flex-col items-center justify-center text-center', compact ? 'gap-2 py-6' : 'gap-3 py-10')}>
      {!compact && <EmptyArt kind={kind} />}
      <p className="max-w-md text-sm font-medium text-[#CBD5E1]">{text}</p>
      {hint && <p className="max-w-md text-xs text-[#94A3B8]">{hint}</p>}
      {action && onAction && <button className={cn(btnPrimary, 'mt-1')} onClick={onAction}><Plus className="h-4 w-4" aria-hidden />{action}</button>}
    </div>
  );
}

/** Chuyển chế độ xem (Bảng / Kanban / Gantt / Lịch): nút phân đoạn nổi bật có icon */
type ViewKind = 'table' | 'board' | 'gantt';
const VIEW_META: Record<ViewKind, { label: string; icon: typeof Wallet }> = {
  table: { label: 'Bảng', icon: Rows3 },
  board: { label: 'Kanban', icon: Columns3 },
  gantt: { label: 'Gantt', icon: CalendarRange },
};
function ViewSwitch<T extends ViewKind>({ value, onChange, options }: { value: T; onChange: (v: T) => void; options: T[] }) {
  return (
    <div className="flex shrink-0 rounded-md border border-white/10 bg-[#0B1019] p-1" role="radiogroup" aria-label="Chế độ xem">
      {options.map((v) => {
        const M = VIEW_META[v];
        return (
          <button key={v} type="button" role="radio" aria-checked={value === v} onClick={() => onChange(v)} title={`Xem dạng ${M.label}`}
            className={cn('flex items-center gap-1.5 rounded px-3 py-1.5 text-xs font-semibold transition-colors', value === v ? 'g-brand text-[#0F141E] shadow-sm' : 'text-[#94A3B8] hover:bg-[#0B5FB8]/20 hover:text-white')}>
            <M.icon className="h-3.5 w-3.5" aria-hidden />{M.label}
          </button>
        );
      })}
    </div>
  );
}

/** Bảng dữ liệu: cột tiền / số lượng căn phải (td có text-right) thì tiêu đề cột tự căn phải theo, hoặc chỉ định qua `right` */
function Table({ head, children, minW = 760, right }: { head: ReactNode[]; children: ReactNode; minW?: number; right?: number[] }) {
  const ref = useRef<HTMLTableElement>(null);
  const [auto, setAuto] = useState<number[]>([]);
  useEffect(() => {
    const rows = ref.current?.tBodies[0]?.rows;
    const row = rows ? [...rows].find((r) => r.cells.length === head.length) : undefined;
    if (!row) return;
    const r = [...row.cells].flatMap((c, i) => (c.classList.contains('text-right') ? [i] : []));
    setAuto((p) => (p.join() === r.join() ? p : r));
  });
  const alignR = right ?? auto;
  return (
    <div className="-mx-5 overflow-x-auto">
      <table ref={ref} className="dt w-full text-left text-sm" style={{ minWidth: minW }}>
        <thead className="text-[11px] uppercase tracking-wider text-[#94A3B8]/80">
          <tr className="border-b border-white/10">
            {head.map((h, i) => <th key={i} className={cn('whitespace-nowrap py-2.5 font-semibold', i === 0 ? 'pl-5 pr-3' : i === head.length - 1 ? 'pl-3 pr-5' : 'px-3', alignR.includes(i) && 'text-right')}>{h}</th>)}
          </tr>
        </thead>
        <tbody>{children}</tbody>
      </table>
    </div>
  );
}
const tdCls = 'px-3 py-3 align-middle';
const tdFirst = 'pl-5 pr-3 py-3 align-middle';
const tdLast = 'pl-3 pr-5 py-3 align-middle';
/** Dòng bảng: chỉ kẻ ngang mờ 10%, zebra rất nhẹ (class .dt trong <style>), hover ánh xanh dương */
const rowCls = 'border-b border-white/[0.06] hover:bg-[#0B5FB8]/10';

function ProgressBar({ value, max, tone }: { value: number; max: number; tone?: string }) {
  const p = max ? Math.min(100, (value / max) * 100) : 0;
  return (
    <div className="h-1.5 w-full overflow-hidden rounded-full bg-[#263044]">
      <div className="h-full rounded-full" style={{ width: `${p}%`, background: tone === C.orange || (!tone && p >= 70 && p < 90) ? GRAD : tone ?? (p >= 90 ? C.red : C.teal) }} />
    </div>
  );
}

// =====================================================================
//  IMPORT CSV — dùng chung cho Lead và Khách hàng
// =====================================================================

type ParseResult<T> = { ok: true; item: T } | { ok: false; error: string };
type ImportSpec<T> = {
  title: string;
  templateName: string;
  headers: string[];
  sample: string[];
  parseRow: (r: Record<string, string>, line: number) => ParseResult<T>;
  onImport: (items: T[]) => void;
};

function ImportModal<T>({ spec, onClose }: { spec: ImportSpec<T>; onClose: () => void }) {
  const [fileName, setFileName] = useState('');
  const [valid, setValid] = useState<T[]>([]);
  const [errors, setErrors] = useState<string[]>([]);
  const [readError, setReadError] = useState('');

  const handle = async (files: File[]) => {
    const f = files[0];
    setReadError('');
    if (!/\.csv$/i.test(f.name)) {
      setReadError('Chỉ nhận file .csv. Trong Excel chọn Lưu thành > CSV UTF-8 rồi tải lên lại.');
      return;
    }
    setFileName(f.name);
    const rows = parseCsv(await f.text());
    if (rows.length < 2) {
      setValid([]);
      setErrors(['File không có dòng dữ liệu nào bên dưới dòng tiêu đề']);
      return;
    }
    const header = rows[0].map((h) => h.trim().toLowerCase());
    const missing = spec.headers.filter((h) => !header.includes(h));
    if (missing.length) {
      setValid([]);
      setErrors([`Thiếu cột: ${missing.join(', ')}. Hãy dùng file mẫu.`]);
      return;
    }
    const ok: T[] = [];
    const errs: string[] = [];
    rows.slice(1).forEach((r, i) => {
      const rec: Record<string, string> = {};
      header.forEach((h, j) => (rec[h] = (r[j] ?? '').trim()));
      const res = spec.parseRow(rec, i + 2);
      if (res.ok) ok.push(res.item);
      else errs.push(`Dòng ${i + 2}: ${res.error}`);
    });
    setValid(ok);
    setErrors(errs);
  };

  return (
    <Modal
      title={spec.title}
      onClose={onClose}
      footer={
        <>
          <button className={btnGhost} onClick={onClose}>Hủy</button>
          <button className={btnPrimary} disabled={!valid.length} onClick={() => { spec.onImport(valid); onClose(); }}>
            <Upload className="h-4 w-4" aria-hidden />Nhập {valid.length} dòng hợp lệ
          </button>
        </>
      }
    >
      <FilePicker accept=".csv,text/csv" onFiles={handle} className="rounded-md border border-dashed border-[#263044] bg-[#0F141E] px-4 py-8 text-center hover:border-[#F28C33]/60">
        <FileSpreadsheet className="mx-auto h-8 w-8 text-[#F28C33]" aria-hidden />
        <p className="mt-2 text-sm text-[#F1F5F9]">{fileName || 'Chọn file CSV từ máy tính hoặc kéo thả vào đây'}</p>
        <p className="mt-1 text-xs text-[#94A3B8]">Từ Excel: Tệp &gt; Lưu thành &gt; CSV UTF-8 (phân tách bằng dấu phẩy)</p>
      </FilePicker>
      <button className={cn(btnGhost, btnSm, 'mt-3')} onClick={() => downloadCsv(spec.templateName, [spec.headers, spec.sample])}>
        <Download className="h-3.5 w-3.5" aria-hidden />Tải file mẫu
      </button>
      {readError && <p className="mt-3 text-sm text-[#F87171]">{readError}</p>}
      {fileName && !readError && (
        <div className="mt-4 space-y-2 text-sm">
          <p className="flex items-center gap-2 text-[#3DDBB6]"><CheckCircle2 className="h-4 w-4" aria-hidden />{valid.length} dòng hợp lệ</p>
          {errors.length > 0 && (
            <div className="rounded bg-[#EF4444]/10 p-3">
              <p className="mb-1 text-[#F87171]">{errors.length} dòng bị bỏ qua</p>
              <ul className="max-h-40 space-y-0.5 overflow-y-auto text-xs text-[#F1F5F9]/80">
                {errors.slice(0, 50).map((e) => <li key={e}>{e}</li>)}
              </ul>
            </div>
          )}
        </div>
      )}
    </Modal>
  );
}

// =====================================================================
//  THÔNG BÁO ĐA KÊNH, EMAIL SMTP, ZALO ZNS, KHO TÀI LIỆU — kiểu & dữ liệu mẫu
// =====================================================================

type Channel = 'INAPP' | 'ZNS' | 'EMAIL';
type NotifyEvent = 'LEAD_ROUTED' | 'LEAD_ASSIGNED' | 'SLA_BREACH' | 'QUOTE_OVERDUE' | 'CLAIM_UPDATE' | 'STOCK_RELEASE' | 'CONTRACT_APPROVAL' | 'ACTIVITY_APPROVAL' | 'QUOTE_APPROVAL' | 'PROGRAM_APPROVAL' | 'APPROVAL_RESULT' | 'MONTHLY_REPORT';
type NoticeKind = 'LEAD' | 'SLA' | 'QUOTE' | 'CLAIM' | 'STOCK' | 'DOC' | 'SYSTEM' | 'MENTION';
/** Bình luận theo từng dòng dữ liệu (lead, dự án, khách hàng, đơn xưởng...) kèm @nhắc tên đồng nghiệp */
type CommentEntity = 'lead' | 'customer' | 'job' | 'po' | 'channel';
type ChatFile = { name: string; url: string; size: number; type: string };
type RowComment = {
  id: string; entity: CommentEntity; entityId: string; text: string; authorId: string; at: number; mentions: string[]; module: Module; files?: ChatFile[];
  /** Trả lời trong chủ đề (thread) của tin gốc */
  parentId?: string;
  /** Phản ứng nhanh: emoji -> danh sách người thả */
  reactions?: Record<string, string[]>;
  /** Tin được ghim lên đầu kênh */
  pinned?: { by: string; at: number };
};
/** Nhóm chat (kênh dự án / phòng ban). Tin nhắn trực tiếp không cần bản ghi: mã kênh dm:<id1>:<id2> */
type ChatChannel = { id: string; name: string; desc?: string; members: string[]; createdBy: string; at: number };

type Notice = { id: string; at: number; kind: NoticeKind; title: string; body: string; read: boolean; module?: Module; to?: string };
type MsgLog = { id: string; at: number; channel: 'ZNS' | 'EMAIL'; to: string; subject: string; ok: boolean; detail: string };

type EmailProvider = 'RESEND' | 'SENDGRID' | 'GMAIL' | 'SMTP';
type EmailConfig = {
  enabled: boolean;
  provider: EmailProvider;
  host: string;
  port: number;
  secure: boolean;
  username: string;
  password: string;
  fromName: string;
  fromEmail: string;
  replyTo: string;
  reportRecipients: string;
  reportDay: number;
};
type ZnsTemplateKey = 'LEAD_ROUTED' | 'LEAD_ASSIGNED' | 'QUOTE_OVERDUE';
type ZnsConfig = { enabled: boolean; appId: string; secretKey: string; oaId: string; templates: Record<ZnsTemplateKey, string> };

