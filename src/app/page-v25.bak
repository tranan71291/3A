  expenseSubmittedAt?: number;
  createdAt: string;
  createdBy?: string;
};
/** Gói phân hệ theo mô hình kinh doanh: thương mại – phân phối, sản xuất – lắp đặt, hoặc dùng tất cả */
type BusinessProfile = 'TRADING' | 'MANUFACTURING' | 'ALL' | 'CUSTOM';
type CompanyInfo = { appName: string; legalName: string; shortName: string; taxCode: string; address: string; phone: string; email: string; website: string; logo?: string; representative: string; representativeTitle: string; bankAccount: string; bankName: string; stamp?: string; profile?: BusinessProfile; enabledModules?: Partial<Record<Module, boolean>> };

// ---------------- Trung tâm phê duyệt ----------------
type ApprovalKind = 'QUOTE' | 'CONTRACT' | 'ACTIVITY' | 'EXPENSE' | 'PROGRAM' | 'CLAIM' | 'LEAD_ASSIGN' | 'STOCK' | 'RECEIPT' | 'CASH';
type ApprovalDecision = 'APPROVED' | 'REJECTED' | 'NEED_INFO';
/** Duyệt giá báo giá theo GM% / giá trị đơn */
type QuoteApproval = { status: 'PENDING' | ApprovalDecision; level: 'HEAD' | 'BOD'; reasons: string[]; requestedAt: number; requestedBy?: string; decidedBy?: string; decidedAt?: number; note?: string };
/** Nhật ký quyết định (lịch sử đã xử lý) */
type ApprovalLog = { id: string; kind: ApprovalKind; refId: string; title: string; requesterId?: string; deciderId: string; decision: ApprovalDecision; note?: string; at: number; amount?: number };
/** Nhật ký bảo mật & thao tác nhạy cảm */
type AuditLevel = 'INFO' | 'WARN' | 'SECURITY';
type AuditLog = { id: string; at: number; userId?: string; action: string; detail: string; level: AuditLevel };
type SecurityPolicy = { minPasswordLength: number; lockoutAttempts: number; lockoutMinutes: number; idleMinutes: number; sessionDays: number; roleSwitch: boolean; forceChangeDefault: boolean };

// ---------------- Sản xuất (xưởng nội thất / nhôm kính) ----------------
/** Lệnh sản xuất rút gọn 3 trạng thái */
type WoStage = 'WAITING' | 'IN_PROGRESS' | 'DONE';
type WoItem = { id: string; name: string; spec: string; unit: string; qty: number; done: number };
type WoMaterial = { id: string; name: string; unit: string; required: number; issued: number };
type QcCheck = { key: string; label: string; passed?: boolean; note?: string };
type WorkOrder = {
  id: string; code: string; title: string; leadId?: string; customerId?: string; contractId?: string; jobId?: string;
  stage: WoStage; priority: 'NORMAL' | 'URGENT'; startDate: string; dueDate: string; leaderId?: string;
  items: WoItem[]; materials: WoMaterial[]; qc: QcCheck[]; note: string;
  history: { stage: WoStage; at: number; by?: string; note?: string }[];
  createdAt: string; createdBy?: string; startedAt?: number; doneAt?: number;
};
// ---------------- Đơn hàng công trình (mô hình xưởng sản xuất – lắp đặt) ----------------
/** Đơn vị tính bảng đơn giá: m² (rộng × cao), mét dài, bộ, cái */
type PriceUnit = 'M2' | 'MD' | 'SET' | 'PCS';
type PriceItem = { id: string; code: string; name: string; category: string; unit: PriceUnit; price: number; cost: number; minMeasure?: number; note?: string; active: boolean };
/** Dòng khảo sát / báo giá: kích thước mm, chiều dài m */
type JobLine = { id: string; priceItemId?: string; name: string; location: string; unit: PriceUnit; width: number; height: number; length: number; qty: number; unitPrice: number; unitCost: number; discountPct: number; note?: string };
type JobQuote = { id: string; version: number; at: string; by?: string; lines: JobLine[]; subtotal: number; vatPct: number; total: number; cost: number; note?: string };
/** Đợt thanh toán: mốc kích hoạt khi chốt (cọc), khi giao / lắp đặt, khi nghiệm thu */
type PayTrigger = 'SIGN' | 'DELIVERY' | 'ACCEPT';
type PayStage = { id: string; label: string; pct: number; trigger: PayTrigger };
type JobLostReason = 'PRICE' | 'COMPETITOR' | 'POSTPONED' | 'NO_RESPONSE' | 'OTHER';
type JobFile = { id: string; name: string; url: string; kind: 'DRAWING' | 'PHOTO'; at: string; by?: string };
type Job = {
  id: string; code: string; title: string; customerId: string; leadId?: string; ownerId?: string; dept?: DeptCode;
  siteAddress: string; siteContact?: string; sitePhone?: string;
  /** Bản nháp đang khảo sát; mỗi lần "Lưu báo giá" chụp thành 1 phiên bản */
  draft: JobLine[]; vatPct: number; quotes: JobQuote[]; files: JobFile[];
  surveyCheckins: { at: string; lat: number; lng: number; simulated?: boolean; by?: string }[];
  schedule: PayStage[];
  wonAt?: string; wonVersion?: number; contractValue?: number;
  lostAt?: string; lostReason?: JobLostReason; lostNote?: string;
  warrantyMonths: number; note: string; createdAt: string; createdBy?: string;
  /** Thời gian hẹn khảo sát (yyyy-MM-ddTHH:mm) */
  appointmentAt?: string;
  /** Nhật ký chăm sóc khi báo giá chưa chốt hoặc đã trượt */
  care?: JobCare[];
  commission?: JobCommission;
};
type JobCare = { id: string; at: number; by?: string; note: string; nextAt?: string };
/** Phiếu thu: tiền mặt đang giữ -> đã nộp -> kế toán xác nhận (mới ghi nhận doanh số) */
type ReceiptStatus = 'HOLDING' | 'SUBMITTED' | 'CONFIRMED' | 'REJECTED';
type Receipt = {
  id: string; code: string; jobId: string; stageId?: string; amount: number; method: 'CASH' | 'TRANSFER';
  collectedBy: string; collectedAt: number; photo?: string; note?: string;
  status: ReceiptStatus; submittedAt?: number; confirmedBy?: string; confirmedAt?: number; rejectNote?: string;
};
type MfgConfig = { schedule: PayStage[]; vatPct: number; quoteValidDays: number; warrantyMonths: number; submitHours: number; productionDays: number; openingCash: number; openingBank: number; creditDays: number; dueDays: number; salesCommissionPct: number; installCommissionPct: number; agingScheme?: AgingScheme };
/** Cách phân nhóm tuổi nợ: theo tuổi chứng từ (<30 / 31–60 / >60 ngày) hoặc theo số ngày quá hạn (1–15 / 16–30 / >30) */
type AgingScheme = 'AGE_30_60' | 'OVERDUE_15_30';
// ---------------- Kho vật tư: nhập xuất tồn ----------------
type StockItem = { id: string; code: string; name: string; category: string; unit: string; minStock: number; cost: number; active: boolean; note?: string };
/** IN nhập kho, OUT xuất kho (cho lệnh sản xuất / đơn hàng), ADJUST kiểm kê (+/-) */
type InvMoveType = 'IN' | 'OUT' | 'ADJUST';
type InvMove = { id: string; code: string; type: InvMoveType; date: string; itemId: string; qty: number; unitCost: number; partner?: string; jobId?: string; woId?: string; note?: string; by?: string; at: number };
// ---------------- Thu chi ----------------
type CashAccount = 'CASH' | 'BANK';
/** Phiếu thu / chi / chuyển quỹ (tiền thu khách đã xác nhận lấy tự động từ phiếu thu đơn hàng) */
type CashSource = 'MANUAL' | 'RECEIPT' | 'EXPENSE' | 'ADVANCE' | 'STOCK' | 'MDF_SURPLUS' | 'COMMISSION';
type CashEntry = {
  id: string; code: string; kind: 'IN' | 'OUT' | 'TRANSFER'; date: string; account: CashAccount; toAccount?: CashAccount; category: string; amount: number;
  partner?: string; jobId?: string; ref?: string; note?: string; by?: string; at: number;
  /** Phiếu tự sinh: nguồn nghiệp vụ và mã bản ghi gốc (chống sinh trùng) */
  source?: CashSource; sourceId?: string; claimId?: string;
};
/** Hoa hồng đã quyết toán của 1 đơn (chỉ khi kế toán đã xác nhận thu đủ 100%) */
type JobCommission = { paidAt: number; by: string; base: number; lines: { userId: string; role: 'SALES' | 'INSTALL'; amount: number }[] };
/** Doanh nghiệp dùng chung hệ thống, dữ liệu tách riêng */
type Org = { id: string; name: string; shortName: string; domain: string; profile: BusinessProfile; color: string };

// ---------------- Lắp đặt & nghiệm thu ----------------
type InstallStatus = 'SCHEDULED' | 'IN_PROGRESS' | 'ACCEPTED';
type InstallDefect = { id: string; text: string; fixed: boolean; at: number };
/** Biên bản nghiệm thu, bàn giao, thanh toán & bảo hành, ký điện tử 2 bên */
type InstallAcceptance = {
  at: string; customerRep: string; customerTitle: string; customerPhone?: string; result: 'PASS' | 'PASS_WITH_NOTES'; note: string; by?: string;
  docCode?: string; checked?: string[]; customerSign?: string; staffSign?: string; signedAt?: number; hash?: string;
  paidAmount?: number; paidMethod?: 'CASH' | 'TRANSFER'; receiptId?: string; debtAfter?: number; warrantyMonths?: number; warrantyUntil?: string;
};
type InstallJob = {
  id: string; code: string; title: string; workOrderId?: string; leadId?: string; customerId?: string; jobId?: string;
  address: string; leaderId?: string; team: string[]; from: string; to: string; status: InstallStatus;
  checkins: { at: string; lat: number; lng: number; simulated?: boolean; photos: { name: string; url: string }[] }[];
  defects: InstallDefect[];
  acceptance?: InstallAcceptance;
  note: string; createdAt: string;
};

type Program = {
  id: string;
  /** Mã đề xuất nội bộ, hệ thống tự sinh khi lập */
  code: string;
  /** Mã Pre-Approval do 3M cấp — nhập khi ghi nhận Hãng duyệt */
  preApprovalId?: string;
  title: string;
  type: ProgramType;
  customerId?: string;
  dept: DeptCode;
  requested: number;
  sharePct: number;
  held: number;
  start: string;
  end: string;
  expectedLeads?: number;
  status: ProgramStatus;
  requestedBy?: string;
  requestedAt?: number;
  approvedBy?: string;
  vendorApprovedAt?: string;
  claimId?: string;
};

type Proof = {
  id: string;
  type: PopType;
  name: string;
  verification: Verification;
  watermark?: boolean;
  inWindow?: boolean;
  gps?: string;
  capturedAt?: string;
  attendeeCount?: number;
  duplicateOf?: string;
  hue?: number;
  url?: string;
  size?: number;
  checksum?: string;
  uploaded?: boolean;
};

type Claim = {
  id: string;
  code: string;
  preApprovalId: string;
  preApprovalApproved: boolean;
  programId?: string;
  programTitle: string;
  programType: ProgramType;
  customerId?: string;
  dept: DeptCode;
  period: string;
  expectedAttendees?: number;
  claimed: number;
  cap: number;
  invoice: { serial: string; number: string; date: string; supplierTax: string; amount: number } | null;
  daysLeft: number;
  submitted: boolean;
  vatCheck?: 'MATCHED' | 'MISMATCH';
  vatNote?: string;
  vendorApproved?: number;
  creditNote?: { number: string; date: string; amount: number };
  offset?: boolean;
  /** Chi phí thực tế triển khai — tổng costLines nếu có, không thì dùng actualCost */
  actualCost?: number;
  costLines?: CostLine[];
  /** Phân bổ thặng dư (chỉ với hạng mục khoán theo hoạt động) */
  surplusAllocation?: SurplusAllocation;
  /** Credit Note cấn trừ vào PO nhập khẩu nào */
  offsetPoId?: string;
  /** Phiếu thu nội bộ đã hạch toán thặng dư quỹ */
  surplusEntryId?: string;
  proofs: Proof[];
};

type Check = { key: string; label: string; severity: 'BLOCKER' | 'WARNING'; passed: boolean; detail: string };
type Perms = { modules: Record<Role, Record<Module, boolean>>; actions: Record<Action, Role[]> };

