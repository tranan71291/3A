};
type GetflyLog = { id: string; at: number; direction: 'OUT' | 'IN'; title: string; ok: boolean; detail: string };

/**
 * Ngân sách Hãng theo từng năm tài chính (lưu lịch sử nhiều năm).
 * spent / committed hiển thị được tính lại từ chương trình & claim của năm đó (+ openingSpent nhập tay cho năm cũ).
 */
type Budget = {
  /** Phân bổ theo hạng mục của năm này; thiếu thì lấy số mặc định của hạng mục */
  allocations?: Record<string, number>;
  /** Số đã tiêu ghi nhận ngoài hệ thống (năm trước khi dùng app) */
  openingSpent?: number;
  note?: string;
  /** false = năm chưa khai báo ngân sách (bản ghi tạm để giao diện không lỗi) */
  declared?: boolean;
  vendor: string;
  vendorCode: string;
  fiscalYear: number;
  mdfTotal: number;
  csTotal: number;
  total: number;
  spent: number;
  committed: number;
  periodStart: string;
  periodEnd: string;
};

type ClaimRules = { minPhotos: number; requireWatermark: boolean; gpsBlocking: boolean };
type Policy = { claimWindowDays: number; rules: ClaimRules };

/** Nhóm khách hàng (phân loại đại lý / nhà thầu) */
type SegmentDef = { code: string; name: string; deptNorth: DeptCode; deptSouth: DeptCode; mdfEligible: boolean; points: number; system?: boolean };
type SegmentRules = Record<Segment, SegmentDef>;
type TierRule = { tier: Tier; name: string; minRevenue: number; mdfCap: number; tone: Tone };
/** Hạng mục ngân sách Hãng: số tiền phân bổ + chứng từ bắt buộc khi claim */
type BudgetCategory = { code: string; name: string; fund: FundCode; amount: number; color: string; required: PopType[]; settlement: Settlement };
type PopDocDef = { code: string; name: string; system?: boolean };
type CustomerSource = { id: string; name: string; isMarketing: boolean };
/** Ngân sách Marketing nội bộ VASSH — tách riêng, không thuộc quỹ Hãng */
type MktItem = { id: string; name: string; source: Source | ''; planned: number; spent: number };
// ---------------- Lịch công tác / hoạt động nhân sự ----------------
type ActivityType = 'MEETING' | 'SURVEY' | 'TRIP' | 'LEAVE' | 'TRAINING' | 'EVENT' | 'OTHER';
type ActivityStatus = 'PLANNED' | 'PENDING_APPROVAL' | 'NEED_INFO' | 'APPROVED' | 'REJECTED' | 'DONE' | 'CANCELLED';
/** Nghỉ / giải trình chấm công */
type LeaveKind = 'LEAVE' | 'LATE' | 'EARLY' | 'NO_CHECKIN';
type ExpenseStatus = 'SUBMITTED' | 'HEAD_APPROVED' | 'PAID' | 'REJECTED';
type ActivityExpense = { id: string; name: string; amount: number; fileName: string; url: string };
type ActivityCheckin = { at: string; lat: number; lng: number; accuracy?: number; simulated?: boolean; lateMinutes: number; photos: { name: string; url: string }[] };
type Activity = {
  id: string;
  userId: string;
  type: ActivityType;
  title: string;
  from: string; // yyyy-mm-ddThh:mm
  to: string;
  location: string;
  customerId?: string;
  leadId?: string;
  programId?: string;
  /** Chi phí dự kiến */
