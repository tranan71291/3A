  /** Đợt cuối = giá trị HĐ - cọc, tránh lệch 1 đồng do làm tròn */
  const rest = (j: Job) => val(j) - pctOf(j, 'SIGN');
  const stageId = (j: Job, trigger: PayTrigger) => j.schedule.find((s) => s.trigger === trigger)?.id;
  let rn = 0;
  const R = (j: Job, trigger: PayTrigger, amount: number, method: 'CASH' | 'TRANSFER', by: string, day: number, status: ReceiptStatus, extra: Partial<Receipt> = {}): Receipt => ({
    id: `${P}rc${++rn}`, code: `PT-DEMO-${String(rn).padStart(3, '0')}`, jobId: j.id, stageId: stageId(j, trigger), amount, method, collectedBy: P + by, collectedAt: ms(day, trigger === 'SIGN' ? 16 : 15),
    status, submittedAt: status === 'HOLDING' ? undefined : ms(day, 18), confirmedBy: status === 'CONFIRMED' ? P + 'ketoan' : undefined, confirmedAt: status === 'CONFIRMED' ? ms(day + 1, 9) : undefined, ...extra,
