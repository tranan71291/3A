  FACTORY: {
    quote: 'Giá giao tại kho nhà máy Bên mua; Bên bán hỗ trợ hướng dẫn sử dụng sản phẩm.',
    contract: 'Bên B giao hàng tại kho nhà máy Bên A và hướng dẫn sử dụng, bảo quản sản phẩm cho nhân sự kỹ thuật của Bên A.',
