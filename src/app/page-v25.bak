const DOC_CATEGORY: Record<DocCategory, string> = {
  POLICY: 'Quy chế & Chính sách chung',
  MDF_RULES: 'Quy định Quỹ MDF Hãng',
  KPI: 'Chính sách Thưởng / KPI',
  PROFILE: 'Hồ sơ năng lực & Catalog',
};
/** Phạm vi hiển thị: Toàn công ty, Chỉ BOD & Kế toán, hoặc Chỉ một phòng ban */
const docVisibility = (v: DocVisibility, departments: Department[]): { label: string; tone: Tone } =>
  v === 'ALL' ? { label: 'Toàn công ty', tone: 'teal' }
  : v === 'BOD_ACC' ? { label: 'Chỉ Ban Giám đốc & Kế toán', tone: 'red' }
  : { label: `Chỉ ${departments.find((d) => d.code === v)?.name ?? v}`, tone: 'blue' };
const visibilityOptions = (departments: Department[]): DocVisibility[] => ['ALL', 'BOD_ACC', ...departments.filter((d) => d.active).map((d) => d.code)];

/** Quy tắc xem tài liệu theo vai trò / phòng ban */
const canViewDoc = (d: DocItem, me: User) =>
  me.role === 'BOD' || d.visibility === 'ALL' || d.visibility === me.dept || (d.visibility === 'BOD_ACC' && me.role === 'ACCOUNTANT');

const INITIAL_DOCS: DocItem[] = [];

function initialNotices(): Notice[] {
  return [];
}

// =====================================================================
//  KHOẢNG THỜI GIAN TOÀN CỤC & THANH BỘ LỌC DÙNG CHUNG
//  Bộ chọn ngày trên tiêu đề trang và các nút Năm / Q1–Q4 cùng ghi vào ctx.range
// =====================================================================

type Period = 'YEAR' | 'Q1' | 'Q2' | 'Q3' | 'Q4';
const PERIOD_LABEL: Record<Period, string> = { YEAR: 'Năm', Q1: 'Q1', Q2: 'Q2', Q3: 'Q3', Q4: 'Q4' };

const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
function periodRange(p: Period, fy: number): DateRange {
  if (p === 'YEAR') return { from: `${fy}-01-01`, to: `${fy}-12-31` };
  const q = Number(p[1]) - 1;
  return { from: iso(new Date(fy, q * 3, 1)), to: iso(new Date(fy, q * 3 + 3, 0)) };
}
const rangeBounds = (r: DateRange) => ({ start: new Date(`${r.from}T00:00:00`).getTime(), end: new Date(`${r.to}T23:59:59`).getTime() });
/** Kỳ liền trước có cùng độ dài — dùng tính % biến động trên thẻ KPI */
function prevRange(r: DateRange): DateRange {
  const { start, end } = rangeBounds(r);
  const len = end - start;
  return { from: iso(new Date(start - len - 1000)), to: iso(new Date(start - 1000)) };
}
const inRangeOf = (r: DateRange) => (d: Date | string | null | undefined) => {
  if (!d) return true;
  const t = (typeof d === 'string' ? new Date(d.length === 10 ? `${d}T12:00:00` : d) : d).getTime();
  const { start, end } = rangeBounds(r);
  return t >= start && t <= end;
};
const pctDelta = (cur: number, prev: number) => (prev > 0 ? ((cur - prev) / prev) * 100 : null);

function useInRange() {
  const { range } = useApp();
  return inRangeOf(range);
}

const leadDate = (l: Lead) => new Date(Date.now() - l.receivedDaysAgo * 864e5);
/** "12/09 – 12/09/2026" -> ngày kết thúc chương trình */
function claimDate(c: Claim): Date | null {
  const m = c.period.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})\s*$/);
  return m ? new Date(+m[3], +m[2] - 1, +m[1]) : null;
}

type Opt = { value: string; label: string };

/**
 * Thanh lọc dùng chung. Khoảng thời gian chọn ở tiêu đề trang (DateRangePicker).
 * Mobile: chỉ hiện ô tìm kiếm + nút "Lọc" (có số bộ lọc đang bật), bấm để mở các ô chọn.
 */
function FilterBar({
  q, onQ, placeholder, dept, onDept, status, onStatus, statusOptions, statusLabel = 'Tất cả trạng thái', children, onAdvanced, advancedCount = 0, extraActive = 0, actions, chips,
}: {
  q: string; onQ: (v: string) => void; placeholder: string;
  dept?: string; onDept?: (v: string) => void; status?: string; onStatus?: (v: string) => void; statusOptions?: Opt[]; statusLabel?: string; children?: ReactNode;
  onAdvanced?: () => void; advancedCount?: number; extraActive?: number;
  /** Nút thao tác ở cuối hàng (vd. ⚡ Duyệt chọn, + Thêm mới) */
  actions?: ReactNode;
  /** Hàng tag lọc nhanh bên dưới (ChipFilter) */
  chips?: ReactNode;
}) {
  const { departments } = useApp();
  const [open, setOpen] = useState(false);
  const active = (onDept && dept && dept !== 'ALL' ? 1 : 0) + (onStatus && status && status !== 'ALL' ? 1 : 0) + advancedCount + extraActive;
  const hasFilters = !!onDept || !!onStatus || !!children || !!onAdvanced;
  const sel = cn(inputCls, 'w-full py-2.5');
  // Thanh công cụ tối giản: [Tìm kiếm ........][Bộ lọc (n)][thao tác]; mọi ô lọc nằm trong khung trượt cạnh phải
  return (
    <div className="space-y-2">
    <div className="flex flex-col gap-2 sm:flex-row sm:items-center">
      <div className="flex min-w-[200px] flex-1 gap-2">
        <div className="relative flex-1">
          <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#94A3B8]" aria-hidden />
          <input className={cn(inputCls, 'border-white/[0.08] bg-[#151C29]/70 py-2.5 pl-9')} value={q} onChange={(e) => onQ(e.target.value)} placeholder={placeholder} aria-label={placeholder} />
        </div>
        {hasFilters && (
          <button className={cn(btnGhost, 'relative shrink-0 px-3.5 py-2', active > 0 && 'border-[#F28C33]/60 text-[#F7B23B]')} onClick={() => setOpen(true)} aria-haspopup="dialog" aria-label={`Bộ lọc${active ? `, ${active} đang bật` : ''}`}>
            <SlidersHorizontal className="h-4 w-4" aria-hidden /><span>Bộ lọc{active > 0 ? ` (${active})` : ''}</span>
          </button>
        )}
      </div>
      {actions && <div className="flex shrink-0 flex-wrap items-center gap-2 sm:ml-auto">{actions}</div>}
    </div>
    {chips && <div>{chips}</div>}
    {open && (
      <SideSheet title="Bộ lọc" sub={active ? `${active} điều kiện đang áp dụng, kết quả cập nhật ngay` : 'Chọn điều kiện, kết quả cập nhật ngay'} onClose={() => setOpen(false)}
        footer={<>
          {(onDept || onStatus) && <button className={cn(btnGhost, 'mr-auto')} onClick={() => { onDept?.('ALL'); onStatus?.('ALL'); }}><X className="h-4 w-4" aria-hidden />Xóa phòng ban / trạng thái</button>}
          <button className={btnPrimary} onClick={() => setOpen(false)}>Xem kết quả</button>
        </>}>
        <div className="space-y-4 [&_select]:w-full [&_select]:max-w-none [&_input]:max-w-none [&>div>*]:w-full">
          {onDept && (
            <Field label="Phòng ban">
              <select className={sel} value={dept} onChange={(e) => onDept(e.target.value)}>
                <option value="ALL">Tất cả phòng ban</option>
                {departments.filter((d) => d.active).map((d) => <option key={d.code} value={d.code}>{d.short}</option>)}
              </select>
            </Field>
          )}
          {onStatus && statusOptions && (
            <Field label="Trạng thái">
              <select className={sel} value={status} onChange={(e) => onStatus(e.target.value)}>
                <option value="ALL">{statusLabel}</option>
                {statusOptions.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
              </select>
            </Field>
          )}
          {children && (
            <div>
              <p className="mb-1.5 text-xs font-medium text-[#94A3B8]">Điều kiện khác</p>
              <div className="flex flex-col gap-3">{children}</div>
            </div>
          )}
          {onAdvanced && (
            <button className={cn(btnGhost, 'w-full justify-center py-2.5')} onClick={() => { setOpen(false); onAdvanced(); }}>
              <SlidersHorizontal className="h-4 w-4" aria-hidden />Lọc nâng cao{advancedCount > 0 && <span className="rounded-full g-brand px-1.5 text-[11px] font-semibold text-[#0F141E]">{advancedCount}</span>}
            </button>
          )}
        </div>
      </SideSheet>
    )}
    </div>
  );
}

/** Tag lọc nhanh: (• Tất cả 9) (• Báo giá 2) (• Công tác 5)... — bấm lại để bỏ lọc */
function ChipFilter<T extends string>({ options, value, onChange, allLabel = 'Tất cả', total }: { options: { value: T; label: string; count?: number; color?: string }[]; value: T | 'ALL'; onChange: (v: T | 'ALL') => void; allLabel?: string; total?: number }) {
  const chip = (on: boolean, label: string, count: number | undefined, color: string | undefined, onClick: () => void, key: string) => (
    <button key={key} type="button" onClick={onClick} aria-pressed={on}
      className={cn('flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border px-3 py-1 text-xs font-medium transition-colors', on ? 'border-[#F28C33] bg-[#F28C33]/15 text-[#F7B23B]' : 'border-[#263044] text-[#94A3B8] hover:border-[#94A3B8]/40 hover:text-[#F1F5F9]')}>
      <i className="h-1.5 w-1.5 rounded-full" style={{ background: color ?? (on ? '#F28C33' : '#94A3B8') }} />{label}{count !== undefined && <span className="tabular-nums opacity-80">{count}</span>}
    </button>
  );
  return (
    <div className="flex gap-1.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="group" aria-label="Lọc nhanh">
      {chip(value === 'ALL', allLabel, total, undefined, () => onChange('ALL'), '__all')}
      {options.map((o) => chip(value === o.value, o.label, o.count, o.color, () => onChange(value === o.value ? 'ALL' : o.value), o.value))}
    </div>
  );
}

// =====================================================================
//  CỘNG TÁC THEO NGỮ CẢNH: bình luận + @nhắc tên ngay trên từng dòng bảng
// =====================================================================

/** Liên kết sâu trong chat: #MÃ (dự án, khách hàng, đơn xưởng, PO, claim) hoặc #Báo-cáo — bấm là mở đúng số liệu */
type DeepLink = { token: string; label: string; sub: string; open: () => void };
function useDeepLinks(): DeepLink[] {
  const { leads, customers, jobs, pos, claims, programs, go, openCustomer, openJob, openClaim, canSee } = useApp();
  return [
    ...(canSee('reports') ? [
      { token: 'Báo-cáo-quỹ-MDF', label: 'Báo cáo quyết toán quỹ MDF', sub: 'Tài chính', open: () => go('reports') },
      { token: 'Công-nợ', label: 'Công nợ & tuổi nợ', sub: 'Tài chính', open: () => go('reports') },
    ] : []),
    { token: 'Dự-báo', label: 'Dự báo doanh thu & cảnh báo', sub: 'Tổng quan', open: () => go('overview') },
    ...leads.map((l) => ({ token: l.code, label: l.company, sub: `${LEAD_STATUS[l.status].label} · ${compact(boqTotal(l))}`, open: () => go(['ACCEPTED', 'QUOTED', 'WON', 'LOST'].includes(l.status) ? 'projects' : 'leads', l.code) })),
    ...customers.map((c) => ({ token: c.code, label: c.name, sub: `Khách hàng · nợ ${compact(c.debt)}`, open: () => { go('customers'); openCustomer(c.id); } })),
    ...jobs.map((j) => ({ token: j.code, label: j.title || jobCustName(j, customers), sub: 'Đơn hàng công trình', open: () => openJob(j.id) })),
    ...pos.map((p) => ({ token: p.code, label: `${p.vendor}`, sub: `PO · ${p.lines.length} SKU`, open: () => go('supply', p.code) })),
    ...claims.map((c) => ({ token: c.code, label: c.programTitle, sub: 'Hồ sơ claim MDF', open: () => openClaim(c.id) })),
    ...programs.map((p) => ({ token: p.code, label: p.title, sub: 'Chương trình quỹ', open: () => go('claims') })),
  ];
}

/** Hiển thị nội dung bình luận: tô sáng @Tên, biến #MÃ thành nút mở đúng dữ liệu */
function MentionText({ text }: { text: string }) {
  const { users } = useApp();
  const links = useDeepLinks();
  const names = users.map((u) => u.name).sort((a, b) => b.length - a.length);
  const esc2 = (x: string) => x.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const pat = [names.length ? `@(?:${names.map(esc2).join('|')})` : '', '#[\\p{L}\\p{N}][\\p{L}\\p{N}\\-_/.]*[\\p{L}\\p{N}]'].filter(Boolean).join('|');
  const parts = text.split(new RegExp(`(${pat})`, 'gu'));
  return <>{parts.map((p, i) => {
    if (p.startsWith('@') && names.includes(p.slice(1))) return <span key={i} className="rounded-sm bg-[#0B5FB8]/25 px-1 font-medium text-[#9CC3F5]">{p}</span>;
    if (p.startsWith('#')) {
      const d = links.find((x) => x.token.toLowerCase() === p.slice(1).toLowerCase());
      if (d) return <button key={i} type="button" onClick={d.open} title={`${d.label} · ${d.sub}`} className="mx-0.5 inline-flex items-center gap-1 rounded-sm border border-[#F28C33]/40 bg-[#F28C33]/10 px-1.5 align-baseline font-mono text-[12px] font-semibold text-[#F7B23B] hover:bg-[#F28C33]/20"><ExternalLink className="h-3 w-3" aria-hidden />{d.token}</button>;
    }
    return <Fragment key={i}>{p}</Fragment>;
  })}</>;
}

/** Ô soạn bình luận có gợi ý @nhắc tên (↑ ↓ Enter để chọn) */
function MentionComposer({ onSend, placeholder = 'Viết bình luận, gõ @ để nhắc đồng nghiệp, # để chèn liên kết…', toolbar, canSendEmpty, rows = 3 }: { onSend: (text: string, mentions: string[]) => void; placeholder?: string; toolbar?: ReactNode; canSendEmpty?: boolean; rows?: number }) {
  const { users, me } = useApp();
  const [text, setText] = useState('');
  const [picked, setPicked] = useState<string[]>([]);
  const [q, setQ] = useState<string | null>(null);
  const [hi, setHi] = useState(0);
  const ref = useRef<HTMLTextAreaElement>(null);
  const links = useDeepLinks();
  const caretRef = useRef<number | null>(null);
  const [trig, setTrig] = useState<'@' | '#'>('@');
  type Opt = { key: string; label: string; sub: string; user?: User; link?: DeepLink };
  const opts: Opt[] = q === null ? [] : trig === '@'
    ? users.filter((u) => u.active && u.id !== me?.id && fold(u.name).includes(fold(q))).slice(0, 6).map((u) => ({ key: u.id, label: u.name, sub: ROLE_LABEL[u.role], user: u }))
    : links.filter((d) => !q || fold(`${d.token} ${d.label}`).includes(fold(q))).slice(0, 7).map((d) => ({ key: d.token, label: d.token, sub: `${d.label} · ${d.sub}`, link: d }));
  const onChange = (v: string, caret: number) => {
    setText(v);
    const m = /(^|\s)([@#])([^\s@#]{0,24})$/.exec(v.slice(0, caret));
    setQ(m ? m[3] : null);
    if (m) setTrig(m[2] as '@' | '#');
    setHi(0);
  };
  const choose = (o: Opt) => {
    const el = ref.current;
    const caret = el?.selectionStart ?? text.length;
    const ins = o.user ? `@${o.user.name} ` : `#${o.link!.token} `;
    const before = text.slice(0, caret).replace(/[@#]([^\s@#]{0,24})$/, ins);
    const next = before + text.slice(caret);
    setText(next);
    if (o.user) setPicked((p) => (p.includes(o.user!.id) ? p : [...p, o.user!.id]));
    setQ(null);
    caretRef.current = before.length;
  };
  // Đặt lại con trỏ ngay sau khi chèn @Tên / #MÃ (trước khi người dùng gõ tiếp)
  useEffect(() => {
    if (caretRef.current === null) return;
    const el = ref.current;
    el?.focus();
    el?.setSelectionRange(caretRef.current, caretRef.current);
    caretRef.current = null;
  }, [text]);
  const send = () => {
    const t = text.trim();
    if (!t && !canSendEmpty) return;
    const mentions = picked.filter((id) => { const u = users.find((x) => x.id === id); return !!u && t.includes(`@${u.name}`); });
    onSend(t, mentions);
    setText(''); setPicked([]); setQ(null);
  };
  return (
    <div className="relative">
      {opts.length > 0 && (
        <ul className="absolute bottom-full left-0 z-10 mb-1.5 w-full overflow-hidden rounded-md border border-white/10 bg-[#121928] py-1 shadow-2xl" role="listbox" aria-label={trig === '@' ? 'Nhắc tên' : 'Chèn liên kết dữ liệu'}>
          <li className="px-3 pb-1 pt-0.5 text-[10px] font-semibold uppercase tracking-wider text-[#7C8796]">{trig === '@' ? 'Nhắc đồng nghiệp' : 'Liên kết tới dự án / đơn / báo cáo'}</li>
          {opts.map((o, i) => (
            <li key={o.key} role="option" aria-selected={i === hi}>
              <button type="button" className={cn('flex w-full items-center gap-2.5 px-3 py-1.5 text-left text-sm', i === hi ? 'bg-[#0B5FB8]/30' : 'hover:bg-white/[0.05]')} onMouseDown={(e) => { e.preventDefault(); choose(o); }}>
                {o.user ? <Avatar name={o.user.name} size={22} /> : <Hash className="h-4 w-4 shrink-0 text-[#F7B23B]" aria-hidden />}
                <span className={cn('min-w-0 shrink-0 truncate', o.link && 'font-mono text-xs font-semibold')}>{o.label}</span><span className="min-w-0 flex-1 truncate text-right text-[11px] text-[#94A3B8]">{o.sub}</span>
              </button>
            </li>
          ))}
        </ul>
      )}
      <div className="rounded-lg border border-white/10 bg-[#0B1019] transition-colors focus-within:border-[#0B5FB8]/70">
        <div className="flex items-center gap-0.5 px-2 pt-1.5">
          <button type="button" className="flex h-7 w-7 items-center justify-center rounded text-[#7C8796] transition-colors hover:bg-white/[0.06] hover:text-white" title="Nhắc tên (@)" aria-label="Nhắc tên đồng nghiệp" onClick={() => { const v = `${text}${text && !text.endsWith(' ') ? ' ' : ''}@`; setText(v); setTrig('@'); setQ(''); ref.current?.focus(); }}><AtSign className="h-4 w-4" aria-hidden /></button>
          <button type="button" className="flex h-7 w-7 items-center justify-center rounded text-[#7C8796] transition-colors hover:bg-white/[0.06] hover:text-white" title="Chèn liên kết tới dự án / đơn / báo cáo (#)" aria-label="Chèn liên kết dữ liệu" onClick={() => { const v = `${text}${text && !text.endsWith(' ') ? ' ' : ''}#`; setText(v); setTrig('#'); setQ(''); ref.current?.focus(); }}><Hash className="h-4 w-4" aria-hidden /></button>
          {toolbar}
          <span className="ml-auto hidden pr-1 text-[11px] text-[#5B6577] sm:inline">Enter gửi · Shift + Enter xuống dòng</span>
        </div>
        <div className="flex items-end gap-2 px-3 pb-2">
          <textarea
            ref={ref}
            rows={rows}
            className="block min-h-[44px] w-full flex-1 resize-none bg-transparent py-2 text-[15px] leading-relaxed text-[#F1F5F9] placeholder:text-[#7C8796] focus:outline-none"
            value={text}
            placeholder={placeholder}
            aria-label="Nội dung bình luận"
            onChange={(e) => onChange(e.target.value, e.target.selectionStart ?? e.target.value.length)}
            onKeyDown={(e) => {
              if (opts.length) {
                if (e.key === 'ArrowDown') { e.preventDefault(); setHi((h) => Math.min(h + 1, opts.length - 1)); return; }
                if (e.key === 'ArrowUp') { e.preventDefault(); setHi((h) => Math.max(h - 1, 0)); return; }
                if (e.key === 'Enter' || e.key === 'Tab') { e.preventDefault(); choose(opts[hi]); return; }
                if (e.key === 'Escape') { e.stopPropagation(); setQ(null); return; }
              }
              if (e.key === 'Enter' && !e.shiftKey && !e.nativeEvent.isComposing) { e.preventDefault(); send(); }
            }}
          />
          {/* Nút gửi dạng icon: chỉ nổi bật khi đã có nội dung */}
          <button type="button" onClick={send} disabled={!text.trim() && !canSendEmpty} aria-label="Gửi" title="Gửi (Enter)"
            className={cn('mb-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full transition-all duration-200', text.trim() || canSendEmpty ? 'g-brand text-[#0F141E] shadow-[0_6px_18px_-6px_rgba(242,140,51,.8)] hover:brightness-110' : 'text-[#5B6577]')}>
            <Send className="h-4 w-4" aria-hidden />
          </button>
        </div>
      </div>
    </div>
  );
}

/** Nút bình luận trên dòng bảng: hiện số bình luận, chấm xanh nếu có người nhắc mình; bấm mở khung trượt thảo luận */
function CommentButton({ entity, entityId, title, module }: { entity: CommentEntity; entityId: string; title: string; module: Module }) {
  const { comments, me } = useApp();
  const [open, setOpen] = useState(false);
  const list = comments.filter((c) => c.entity === entity && c.entityId === entityId);
  const mentioned = !!me && list.some((c) => c.mentions.includes(me.id));
  return (
    <>
      <button type="button" onClick={(e) => { e.stopPropagation(); setOpen(true); }} title={list.length ? `${list.length} bình luận` : 'Bình luận, nhắc tên đồng nghiệp'} aria-label={`Bình luận về ${title}${list.length ? `, ${list.length} bình luận` : ''}`}
        className={cn('relative inline-flex h-8 min-w-8 items-center justify-center gap-1 rounded border px-1.5 text-xs transition-colors', list.length ? 'border-[#0B5FB8]/50 text-[#9CC3F5] hover:bg-[#0B5FB8]/20' : 'border-white/[0.08] text-[#94A3B8] hover:border-[#0B5FB8] hover:text-white')}>
        <MessageSquare className="h-3.5 w-3.5" aria-hidden />{list.length > 0 && <span className="tabular-nums">{list.length}</span>}
        {mentioned && <i className="absolute -right-1 -top-1 h-2.5 w-2.5 rounded-full border-2 border-[#0F141E] bg-[#F28C33]" aria-hidden />}
      </button>
      {open && <CommentSheet entity={entity} entityId={entityId} title={title} module={module} onClose={() => setOpen(false)} />}
    </>
  );
}

function CommentSheet({ entity, entityId, title, module, onClose }: { entity: CommentEntity; entityId: string; title: string; module: Module; onClose: () => void }) {
  const { comments, addComment, userName, me } = useApp();
  const list = comments.filter((c) => c.entity === entity && c.entityId === entityId).sort((a, b) => a.at - b.at);
  const endRef = useRef<HTMLDivElement>(null);
  useEffect(() => { endRef.current?.scrollIntoView({ block: 'end' }); }, [list.length]);
  return (
    <SideSheet title="Thảo luận" sub={title} onClose={onClose} width="sm:w-[440px]" footer={<div className="w-full"><MentionComposer onSend={(text, mentions) => addComment({ entity, entityId, text, mentions, module }, title)} /></div>}>
      {!list.length ? (
        <EmptyState text={<>Chưa có trao đổi nào</>} hint={<>Gõ @ để nhắc đồng nghiệp xử lý dòng này. Người được nhắc nhận thông báo ngay trong chuông thông báo.</>} art="inbox" />
      ) : (
        <ol className="space-y-4">
          {list.map((c) => (
            <li key={c.id} className="flex gap-3">
              <Avatar name={userName(c.authorId)} size={30} />
              <div className="min-w-0 flex-1">
                <p className="flex flex-wrap items-baseline gap-x-2 text-xs"><b className="text-sm text-[#F1F5F9]">{c.authorId === me?.id ? 'Bạn' : userName(c.authorId)}</b><span className="text-[#7C8796]">{new Date(c.at).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' })}</span></p>
                <p className="mt-1 whitespace-pre-wrap break-words rounded-md rounded-tl-none bg-white/[0.04] px-3 py-2 text-sm leading-relaxed text-[#E2E8F0]"><MentionText text={c.text} /></p>
              </div>
            </li>
          ))}
          <div ref={endRef} />
        </ol>
      )}
    </SideSheet>
  );
}

// =====================================================================
//  ĐỒNG HỒ SLA TIẾP NHẬN (2h) & HẠN BÁO GIÁ (24h)
// =====================================================================

const fmtDur = (ms: number) => {
  const a = Math.abs(ms);
  const h = Math.floor(a / 3.6e6);
  const m = Math.floor((a % 3.6e6) / 6e4);
  const s = Math.floor((a % 6e4) / 1000);
  return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
};

function QuoteTimer({ deadline, now }: { deadline?: number; now: number | null }) {
  if (!deadline || now == null) return <span className="text-xs text-[#94A3B8]">—</span>;
  const diff = deadline - now;
  if (diff < 0) {
    return <Chip tone="red"><AlertTriangle className="h-3 w-3" aria-hidden />QUÁ HẠN BÁO GIÁ {Math.ceil(-diff / 3.6e6)}h</Chip>;
  }
  return <Chip tone={diff < 4 * 3.6e6 ? 'orange' : 'muted'}><Clock className="h-3 w-3" aria-hidden />Báo giá còn {fmtDur(diff)}</Chip>;
}

const isQuoteOverdue = (l: Lead, now: number | null) => l.status === 'ACCEPTED' && !!l.quoteDeadline && now != null && l.quoteDeadline < now;
const isAcceptLate = (l: Lead, now: number | null) => l.status === 'ASSIGNED' && !!l.slaDeadline && now != null && l.slaDeadline < now;

// =====================================================================
//  THÀNH PHẦN GIAO DIỆN v5 (theo mockup): chọn khoảng ngày, menu thao tác,
//  phân trang, chọn hàng loạt, avatar, nút nổi mobile, bảng lệnh ⌘K
// =====================================================================

const AVATAR_COLORS = ['#E8562A', '#1F74D4', '#10B981', '#8B5CF6', '#EF4444', '#F6B533', '#06B6D4', '#EC4899'];
function Avatar({ name, size = 36 }: { name: string; size?: number }) {
  const h = [...name].reduce((a, ch) => (a * 31 + ch.charCodeAt(0)) >>> 0, 7);
  const bg = AVATAR_COLORS[h % AVATAR_COLORS.length];
  return (
    <span className="flex shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white" style={{ width: size, height: size, background: bg }} aria-hidden>
      {initials(name.replace(/^(Công ty|Cty|CP|TNHH|NPP|Đại lý)\s+/gi, ''))}
    </span>
  );
}

/** Tuổi lead tính bằng giờ: từ lúc phân phòng, chưa phân thì từ lúc nhận */
const leadAgeH = (l: Lead, now: number | null) => (l.routedAt && now ? (now - l.routedAt) / 3.6e6 : l.receivedDaysAgo * 24 + 7);
function AgeBadge({ hours }: { hours: number }) {
  const h = Math.max(0, hours);
  const tone = h >= 48 ? 'bg-[#EF4444]/15 text-[#F87171]' : h >= 8 ? 'bg-[#F28C33]/15 text-[#F7B23B]' : 'bg-[#263044] text-[#94A3B8]';
  return <span className={cn('shrink-0 rounded-md px-1.5 py-0.5 text-[11px] font-semibold tabular-nums', tone)} title="Thời gian chờ">{h < 10 ? h.toFixed(1).replace('.', ',') : Math.round(h)}h</span>;
}

/** Bộ chọn khoảng ngày toàn cục (tiêu đề trang) */
/** compact = chỉ hiện icon lịch (dùng trên thanh header mobile) */
function DateRangePicker({ compact: iconOnly }: { compact?: boolean } = {}) {
  const { range, setRange, budget } = useApp();
  const [open, setOpen] = useState(false);
  const [draft, setDraft] = useState(range);
  const ref = useOutsideClose(open, () => setOpen(false));
  const today = new Date();
  const presets: [string, DateRange][] = [
    ['Tháng này', { from: iso(new Date(today.getFullYear(), today.getMonth(), 1)), to: iso(new Date(today.getFullYear(), today.getMonth() + 1, 0)) }],
    ['30 ngày qua', { from: iso(new Date(Date.now() - 29 * 864e5)), to: iso(today) }],
    ['Quý này', periodRange(`Q${Math.floor(today.getMonth() / 3) + 1}` as Period, today.getFullYear())],
  ];
  return (
    <div className="relative" ref={ref}>
      {iconOnly ? (
        <button className={cn(btnGhost, 'p-2')} onClick={() => { setDraft(range); setOpen((v) => !v); }} aria-expanded={open} aria-haspopup="dialog" aria-label={`Khoảng thời gian ${fmtDate(range.from)} - ${fmtDate(range.to)}`}>
          <CalendarDays className="h-5 w-5" aria-hidden />
        </button>
      ) : (
        <button className={cn(btnGhost, 'w-full justify-between gap-2 py-2 sm:w-auto')} onClick={() => { setDraft(range); setOpen((v) => !v); }} aria-expanded={open} aria-haspopup="dialog">
          <CalendarDays className="h-4 w-4 text-[#94A3B8]" aria-hidden />
          <span className="tabular-nums">{fmtDate(range.from)} - {fmtDate(range.to)}</span>
          <ChevronDown className="h-4 w-4 text-[#94A3B8]" aria-hidden />
        </button>
      )}
      {open && (
        <div className="absolute right-0 top-full z-40 mt-2 w-[min(340px,calc(100vw-2rem))] rounded-md border border-[#263044] bg-[#151C29] p-4 shadow-2xl motion-safe:animate-[popIn_.15s_ease-out]" role="dialog" aria-label="Chọn khoảng thời gian">
          <div className="mb-2 flex rounded bg-[#0F141E] p-0.5" role="radiogroup" aria-label="Năm / quý">
            {(Object.keys(PERIOD_LABEL) as Period[]).map((p) => {
              const r = periodRange(p, budget.fiscalYear);
              const on = r.from === range.from && r.to === range.to;
              return <button key={p} role="radio" aria-checked={on} className={cn('flex-1 rounded-md px-2 py-1.5 text-xs font-medium', on ? 'g-brand font-semibold text-[#0F141E]' : 'text-[#94A3B8] hover:text-[#F1F5F9]')} onClick={() => { setRange(r); setOpen(false); }}>{p === 'YEAR' ? budget.fiscalYear : PERIOD_LABEL[p]}</button>;
            })}
          </div>
          <div className="mb-3 flex flex-wrap gap-1.5">
            {presets.map(([label, r]) => (
              <button key={label} className={cn(btnGhost, btnSm)} onClick={() => { setRange(r); setOpen(false); }}>{label}</button>
            ))}
          </div>
          <div className="grid grid-cols-2 gap-2">
            <Field label="Từ ngày"><input className={inputCls} type="date" value={draft.from} max={draft.to} onChange={(e) => setDraft({ ...draft, from: e.target.value })} /></Field>
            <Field label="Đến ngày"><input className={inputCls} type="date" value={draft.to} min={draft.from} onChange={(e) => setDraft({ ...draft, to: e.target.value })} /></Field>
          </div>
          <button className={cn(btnPrimary, 'mt-3 w-full')} disabled={!draft.from || !draft.to || draft.from > draft.to} onClick={() => { setRange(draft); setOpen(false); }}>Áp dụng</button>
        </div>
      )}
    </div>
  );
}

type MenuItem = { label: string; icon?: typeof Wallet; onClick: () => void; danger?: boolean; disabled?: boolean };
/** Nút "⋮" mở menu thao tác của một dòng / thẻ */
function RowMenu({ items, label = 'Thao tác khác', text, icon: TIcon, primary, align = 'right' }: { items: MenuItem[]; label?: string; text?: string; icon?: typeof Wallet; primary?: boolean; align?: 'left' | 'right' }) {
  const [open, setOpen] = useState(false);
  /** Vị trí menu theo màn hình (fixed): không bị bảng có thanh cuộn cắt mất; gần đáy màn hình thì mở lên trên */
  const [pos, setPos] = useState<CSSProperties>({});
  const ref = useOutsideClose(open, () => setOpen(false));
  useEffect(() => {
    if (!open) return;
    const close = () => setOpen(false);
    window.addEventListener('scroll', close, true);
    window.addEventListener('resize', close);
    return () => { window.removeEventListener('scroll', close, true); window.removeEventListener('resize', close); };
  }, [open]);
  const toggle = (e: { currentTarget: HTMLElement }) => {
    if (open) { setOpen(false); return; }
    const r = e.currentTarget.getBoundingClientRect();
    const h = items.length * 37 + 10;
    const up = r.bottom + h + 8 > window.innerHeight && r.top - h - 8 > 0;
    const x = align === 'right' ? { right: Math.max(8, window.innerWidth - r.right) } : { left: Math.max(8, r.left) };
    setPos({ position: 'fixed', ...x, ...(up ? { bottom: window.innerHeight - r.top + 4 } : { top: r.bottom + 4 }), maxHeight: Math.max(160, up ? r.top - 16 : window.innerHeight - r.bottom - 16), overflowY: 'auto' });
    setOpen(true);
  };
  return (
    <div className="relative inline-block" ref={ref} onClick={(e) => e.stopPropagation()}>
      {text ? (
        <button className={cn(primary ? btnPrimary : btnGhost, primary ? 'px-2.5 py-1 text-xs' : btnSm)} onClick={toggle} aria-haspopup="menu" aria-expanded={open}>
          {TIcon && <TIcon className="h-3.5 w-3.5" aria-hidden />}{text}<ChevronDown className="h-3.5 w-3.5" aria-hidden />
        </button>
      ) : (
        <button className={cn(btnGhost, 'p-1.5')} onClick={toggle} aria-label={label} aria-haspopup="menu" aria-expanded={open}><MoreVertical className="h-4 w-4" /></button>
      )}
      {open && (
        <ul role="menu" style={pos} className="z-[60] min-w-[200px] rounded-md border border-[#263044] bg-[#151C29] py-1 text-left shadow-2xl motion-safe:animate-[popIn_.12s_ease-out]">
          {items.map((it) => (
            <li key={it.label} role="none">
              <button role="menuitem" disabled={it.disabled} onClick={() => { setOpen(false); it.onClick(); }}
                className={cn('flex w-full items-center gap-2.5 px-3 py-2 text-left text-sm disabled:cursor-not-allowed disabled:opacity-40', it.danger ? 'text-[#F87171] hover:bg-[#EF4444]/10' : 'text-[#F1F5F9] hover:bg-[#1C2534]')}>
                {it.icon && <it.icon className="h-4 w-4 shrink-0" aria-hidden />}{it.label}
              </button>
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}

function usePaged<T>(rows: T[], size = 10) {
  const [page, setPage] = useState(1);
  const pages = Math.max(1, Math.ceil(rows.length / size));
  const p = Math.min(page, pages);
  return { page: p, pages, setPage, slice: rows.slice((p - 1) * size, p * size), from: rows.length ? (p - 1) * size + 1 : 0, to: Math.min(p * size, rows.length), total: rows.length };
}

function Pagination({ paged, unit }: { paged: ReturnType<typeof usePaged>; unit: string }) {
  if (!paged.total) return null;
  const nums = Array.from({ length: paged.pages }, (_, i) => i + 1).filter((n) => n === 1 || n === paged.pages || Math.abs(n - paged.page) <= 1);
  return (
    <div className="flex flex-wrap items-center justify-between gap-2 pt-4 text-sm">
      <span className="text-[#94A3B8]">Hiển thị {paged.from} - {paged.to} trong tổng số {paged.total} {unit}</span>
      <div className="flex items-center gap-1">
        <button className={cn(btnGhost, 'h-8 w-8 p-0')} disabled={paged.page <= 1} onClick={() => paged.setPage(paged.page - 1)} aria-label="Trang trước"><ChevronRight className="h-4 w-4 rotate-180" /></button>
        {nums.map((n, i) => (
          <span key={n} className="flex items-center gap-1">
            {i > 0 && n - nums[i - 1] > 1 && <span className="px-1 text-[#94A3B8]">…</span>}
            <button className={cn('h-8 min-w-[2rem] rounded px-2 text-sm font-medium tabular-nums', n === paged.page ? 'g-brand font-semibold text-[#0F141E]' : 'border border-[#263044] text-[#F1F5F9] hover:bg-[#1C2534]')} onClick={() => paged.setPage(n)} aria-current={n === paged.page ? 'page' : undefined}>{n}</button>
          </span>
        ))}
        <button className={cn(btnGhost, 'h-8 w-8 p-0')} disabled={paged.page >= paged.pages} onClick={() => paged.setPage(paged.page + 1)} aria-label="Trang sau"><ChevronRight className="h-4 w-4" /></button>
      </div>
    </div>
  );
}

/** Thanh thao tác hàng loạt khi có dòng được chọn */
function BulkBar({ count, onClear, children }: { count: number; onClear: () => void; children: ReactNode }) {
  if (!count) return null;
  return (
    <div className="sticky top-[4.5rem] z-20 flex flex-wrap items-center gap-2 rounded-md border border-[#F28C33]/50 bg-[#1C2534] px-4 py-2.5 shadow-xl motion-safe:animate-[popIn_.15s_ease-out]">
      <span className="text-sm font-medium">Đã chọn <b className="tabular-nums text-[#F7B23B]">{count}</b></span>
      <div className="flex flex-1 flex-wrap gap-2">{children}</div>
      <button className={cn(btnGhost, btnSm)} onClick={onClear}>Bỏ chọn</button>
    </div>
  );
}

function useSelection(ids: string[]) {
  const [sel, setSel] = useState<string[]>([]);
  const valid = sel.filter((x) => ids.includes(x));
  return {
    ids: valid,
    has: (id: string) => valid.includes(id),
    toggle: (id: string) => setSel((p) => (p.includes(id) ? p.filter((x) => x !== id) : [...p, id])),
    allOn: ids.length > 0 && ids.every((x) => valid.includes(x)),
    toggleAll: () => setSel((p) => (ids.every((x) => p.includes(x)) ? p.filter((x) => !ids.includes(x)) : Array.from(new Set([...p, ...ids])))),
    clear: () => setSel([]),
  };
}

/** Nút nổi trên mobile (ẩn từ lg) — nằm trên thanh điều hướng dưới */
function Fab({ label, icon: Icon = Plus, onClick, disabled }: { label: string; icon?: typeof Wallet; onClick: () => void; disabled?: boolean }) {
  return (
    <button className="fixed bottom-[calc(5.5rem+env(safe-area-inset-bottom))] right-4 z-30 flex h-14 w-14 items-center justify-center rounded-full g-brand text-[#0F141E] shadow-[0_8px_24px_rgba(242,140,51,.35)] disabled:opacity-40 lg:hidden" onClick={onClick} disabled={disabled} aria-label={label}>
      <Icon className="h-6 w-6" aria-hidden />
    </button>
  );
}

/** Thẻ dòng dữ liệu dùng cho danh sách trên mobile */
function MobileRow({ title, sub, avatar, badge, value, status, onClick, menu }: { title: string; sub?: ReactNode; avatar?: string; badge?: ReactNode; value?: ReactNode; status?: ReactNode; onClick?: () => void; menu?: ReactNode }) {
  return (
    <article className="flex items-start gap-3 rounded-md border border-[#263044] bg-[#151C29] p-3" onClick={onClick} role={onClick ? 'button' : undefined} tabIndex={onClick ? 0 : undefined} onKeyDown={(e) => { if (onClick && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); onClick(); } }}>
      {avatar && <Avatar name={avatar} size={40} />}
      <div className="min-w-0 flex-1">
        <div className="flex items-start justify-between gap-2">
          <p className="min-w-0 truncate text-sm font-medium text-[#F1F5F9]">{title}</p>
          {badge}
        </div>
        {sub && <div className="mt-0.5 truncate text-xs text-[#94A3B8]">{sub}</div>}
        {(value || status) && (
          <div className="mt-2 flex items-center justify-between gap-2">
            <span className="text-base font-semibold tabular-nums">{value}</span>
            {status}
          </div>
        )}
      </div>
      {menu ?? (onClick && <ChevronRight className="mt-3 h-4 w-4 shrink-0 text-[#94A3B8]" aria-hidden />)}
    </article>
  );
}

// =====================================================================
//  BẢNG LỆNH ⌘K / Ctrl+K — tìm nhanh và thao tác nhanh
// =====================================================================

type PaletteItem = { id: string; group: string; label: string; sub?: string; icon: typeof Wallet; run: () => void; keys?: string; cmd?: boolean };

/** Bỏ dấu tiếng Việt để gõ "tao po" vẫn khớp "Tạo PO" */
const fold = (x: string) => x.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();

/** Mở form tạo mới của một phân hệ khi được gọi từ Spotlight (lệnh "> Tạo PO mới"...) */
function useIntent(key: string, fn: () => void) {
  const { intent, setIntent } = useApp();
  useEffect(() => {
    if (intent !== key) return;
    setIntent(null);
    fn();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [intent]);
}

/**
 * Spotlight (Ctrl/⌘ + K): thanh tìm kiếm kính mờ giữa màn hình + Command Palette.
 * - Gõ bình thường: tìm khách hàng, lead / dự án, chương trình quỹ, claim và lệnh.
 * - Gõ ">" ở đầu: chỉ hiện lệnh (tạo mới, chuyển trang, chuyển doanh nghiệp...). Không dấu vẫn khớp.
 */
/** Danh sách lệnh dùng chung cho Spotlight và AI Copilot */
function useCommandItems(extra: PaletteItem[] = []): PaletteItem[] {
  const { canSee, canDo, go, openCustomerForm, openProgramForm, openLeadForm, setIntent, company } = useApp();
  const mfg = bizMode(company) === 'MFG';
  const open = (m: Module, intent: string) => () => { go(m); setTimeout(() => setIntent(intent), 0); };

  return [
    ...(canDo('lead.create') ? [{ id: 'a-lead', group: 'Lệnh tạo mới', label: 'Tạo lead mới', icon: Plus, run: () => (mfg ? open('leads', 'job.create')() : openLeadForm()), keys: 'them lead' }] : []),
    ...(canDo('project.update') && !mfg ? [{ id: 'a-proj', group: 'Lệnh tạo mới', label: 'Tạo dự án mới', icon: Target, run: () => openLeadForm(true) }] : []),
    ...(canDo('customer.edit') ? [{ id: 'a-cust', group: 'Lệnh tạo mới', label: 'Thêm khách hàng', icon: Users, run: () => openCustomerForm() }] : []),
    ...(canDo('program.create') && !mfg ? [{ id: 'a-prog', group: 'Lệnh tạo mới', label: 'Lập đề xuất quỹ 3M', icon: Coins, run: () => openProgramForm(), keys: 'mdf' }] : []),
    ...(canSee('supply') && canDo('po.manage') ? [{ id: 'a-po', group: 'Lệnh tạo mới', label: 'Tạo PO mới', sub: 'Đơn đặt hàng Hãng', icon: Ship, run: open('supply', 'po.create'), keys: 'dat hang purchase order' }] : []),
    ...(canSee('products') && canDo('po.manage') ? [{ id: 'a-sku', group: 'Lệnh tạo mới', label: 'Thêm sản phẩm / SKU', icon: Package, run: open('products', 'sku.create') }] : []),
    ...(canSee('cashbook') ? [
      { id: 'a-in', group: 'Lệnh tạo mới', label: 'Lập phiếu thu', icon: Coins, run: open('cashbook', 'cash.in'), keys: 'thu tien' },
      { id: 'a-out', group: 'Lệnh tạo mới', label: 'Lập phiếu chi', icon: Coins, run: open('cashbook', 'cash.out'), keys: 'chi tien' },
    ] : []),
    ...(canSee('staff') ? [{ id: 'a-trip', group: 'Lệnh tạo mới', label: 'Thêm lịch công tác / gặp khách', icon: CalendarDays, run: open('staff', 'staff.create') }] : []),
    ...(canSee('jobs') ? [{ id: 'a-job', group: 'Lệnh tạo mới', label: 'Thêm lead khảo sát (xưởng)', icon: Ruler, run: open('jobs', 'job.create') }] : []),
    ...MODULES.filter((m) => canSee(m)).map((m) => ({ id: `m-${m}`, group: 'Chuyển đến', label: `Chuyển đến ${MODULE_LABEL[m]}`, sub: MODULE_DESC[m], icon: MODULE_ICON[m], run: () => go(m), keys: MODULE_SHORT[m] })),
    ...extra,
  ].map((x) => ({ ...x, cmd: true }));
}

/** Hiểu câu lệnh tiếng Việt tự nhiên: bỏ động từ / hư từ, mọi từ còn lại phải xuất hiện trong lệnh. "tạo phiếu chi" → "Lập phiếu chi" */
const NL_CREATE = new Set(['tao', 'them', 'lap', 'moi', 'nhap', 'mo', 'form', 'cho', 'toi', 'minh', 'giup', 'hay', 'mot', 'cai', 'de', 'xuat']);
const NL_GO = new Set(['di', 'toi', 'den', 'chuyen', 'sang', 'mo', 'xem', 'vao', 'trang', 'phan', 'he', 'man', 'hinh']);
const looksLikeQuestion = (q: string) => /\?|^(phan tich|du bao|goi y|vi sao|tai sao|bao nhieu|tom tat|rui ro|ai |nhung|liet ke|danh gia|so sanh|lam sao|co nen)/.test(fold(q).trim());
function nlScore(q: string, it: PaletteItem): number {
  const words = fold(q).replace(/[^a-z0-9\s]/g, ' ').split(/\s+/).filter(Boolean);
  if (!words.length) return 0;
  const hay = fold(`${it.label} ${it.keys ?? ''} ${it.sub ?? ''}`);
  const create = words.some((w) => ['tao', 'them', 'lap', 'nhap'].includes(w));
  const nav = words.some((w) => ['di', 'chuyen', 'den', 'sang', 'vao', 'xem'].includes(w));
  const core = words.filter((w) => !NL_CREATE.has(w) && !NL_GO.has(w));
  if (!core.length) return 0;
  const hit = core.filter((w) => hay.includes(w)).length;
  if (hit < core.length) return 0;
  return 10 + hit + (create && it.group === 'Lệnh tạo mới' ? 5 : 0) + (nav && it.group === 'Chuyển đến' ? 5 : 0);
}

function CommandPalette({ onClose, extra = [], onAsk }: { onClose: () => void; extra?: PaletteItem[]; onAsk?: (q: string) => void }) {
  const { myCustomers: customers, myLeads, programs, claims, canSee, go, openCustomer, openClaim } = useApp();
  const [q, setQ] = useState('');
  const [active, setActive] = useState(0);
  const inputRef = useRef<HTMLInputElement>(null);
  const listRef = useRef<HTMLUListElement>(null);
  useEffect(() => { inputRef.current?.focus(); }, []);
  const cmdMode = q.trimStart().startsWith('>');
  const t = fold(q.replace(/^\s*>\s*/, '').trim());
  const match = (...v: (string | undefined)[]) => !t || v.some((x) => x && fold(x).includes(t));
  const cmds = useCommandItems(extra);
  const records: PaletteItem[] = cmdMode || t.length < 1 ? [] : [
    ...(canSee('customers') ? customers.map((c) => ({ id: `c-${c.id}`, group: 'Khách hàng', label: c.name, sub: `${c.code}, MST ${c.taxCode}, ${c.contactPhone}`, icon: Users, run: () => { go('customers'); openCustomer(c.id); } })) : []),
    ...(canSee('leads') ? myLeads.map((l) => ({ id: `l-${l.id}`, group: 'Lead / dự án', label: l.company, sub: `${l.code}, ${LEAD_STATUS[l.status].label}, ${l.phone}`, icon: Inbox, run: () => go(['ACCEPTED', 'QUOTED', 'WON', 'LOST'].includes(l.status) ? 'projects' : 'leads', l.code) })) : []),
    ...(canSee('claims') ? programs.map((p) => ({ id: `p-${p.id}`, group: 'Chương trình quỹ', label: p.title, sub: p.preApprovalId ?? p.code, icon: Briefcase, run: () => go('claims') })) : []),
    ...(canSee('claims') ? claims.map((c) => ({ id: `cl-${c.id}`, group: 'Hồ sơ claim', label: c.code, sub: c.programTitle, icon: FileCheck2, run: () => openClaim(c.id) })) : []),
  ];
  const raw = q.replace(/^\s*>\s*/, '').trim();
  const plain = cmds.filter((i) => match(i.label, i.keys, i.sub && cmdMode ? i.sub : undefined));
  // Câu lệnh tự nhiên: chấm điểm theo từ khóa, xếp lên đầu
  const nl = raw.length > 2 ? cmds.map((i) => [i, nlScore(raw, i)] as const).filter(([, sc]) => sc > 0).sort((x, y) => y[1] - x[1]).map(([i]) => i) : [];
  const cmdHits = [...nl, ...plain.filter((i) => !nl.includes(i))];
  const askItem: PaletteItem[] = onAsk && raw.length > 3 ? [{ id: 'ask-ai', group: 'AI Copilot', label: `Hỏi AI Copilot: “${raw}”`, sub: 'Phân tích trên dữ liệu đang xem (SLA, dòng tiền, quỹ MDF, công nợ...)', icon: Sparkles, run: () => onAsk(raw), cmd: true }] : [];
  const question = looksLikeQuestion(raw);
  const results = cmdMode
    ? [...cmdHits.slice(0, 16), ...(cmdHits.length ? [] : askItem)]
    : t ? [...(question ? askItem : []), ...records.filter((i) => match(i.label, i.sub)).slice(0, 10), ...cmdHits.slice(0, 6), ...(question ? [] : askItem)] : cmdHits.filter((x) => x.group !== 'Chuyển đến').slice(0, 8);
  const run = (i?: PaletteItem) => { if (!i) return; onClose(); i.run(); };
  useEffect(() => { listRef.current?.querySelector('[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' }); }, [active]);

  return (
    <div className="fixed inset-0 z-[70] flex items-start justify-center bg-[#05070B]/55 p-4 pt-[16vh] backdrop-blur-[2px] motion-safe:animate-[fadeIn_.12s_ease-out]" onClick={onClose} role="dialog" aria-modal="true" aria-label="Spotlight: tìm kiếm và lệnh">
      <div className="glass w-full max-w-2xl overflow-hidden rounded-lg border border-white/10 shadow-[0_30px_80px_rgba(0,0,0,.6)] motion-safe:animate-[popIn_.16s_ease-out]" onClick={(e) => e.stopPropagation()}>
        <div className="flex items-center gap-3 border-b border-white/[0.08] px-5">
          {cmdMode ? <span className="g-brand-text font-mono text-xl font-bold" aria-hidden>&gt;</span> : <Search className="h-5 w-5 text-[#94A3B8]" aria-hidden />}
          <input
            ref={inputRef}
            className="h-16 flex-1 bg-transparent text-lg text-[#F1F5F9] placeholder:text-[#94A3B8]/80 focus:outline-none"
            placeholder="Tìm, gõ lệnh (“tạo phiếu chi”, “> đi tới thu chi”) hoặc hỏi AI (“rủi ro trễ SLA?”)"
            value={q}
            onChange={(e) => { setQ(e.target.value); setActive(0); }}
            onKeyDown={(e) => {
              if (e.key === 'ArrowDown') { e.preventDefault(); setActive((a) => Math.min(a + 1, results.length - 1)); }
              if (e.key === 'ArrowUp') { e.preventDefault(); setActive((a) => Math.max(a - 1, 0)); }
              if (e.key === 'Enter') { e.preventDefault(); run(results[active]); }
              if (e.key === 'Escape') onClose();
            }}
            aria-label="Tìm kiếm hoặc nhập lệnh"
            aria-controls="spotlight-list"
            aria-activedescendant={results[active] ? `sp-${results[active].id}` : undefined}
          />
          <kbd className="rounded-sm border border-white/10 px-1.5 py-0.5 text-[11px] text-[#94A3B8]">Esc</kbd>
        </div>
        {!q && (
          <div className="flex flex-wrap gap-1.5 border-b border-white/[0.06] px-5 py-2.5">
            {['> Tạo PO mới', 'tạo phiếu chi', 'đi tới công nợ', 'Dự án nào có rủi ro trễ SLA?'].map((x) => (
              <button key={x} className="rounded-sm border border-white/10 px-2 py-1 font-mono text-[11px] text-[#94A3B8] hover:border-[#0B5FB8] hover:text-white" onClick={() => { setQ(x); setActive(0); inputRef.current?.focus(); }}>{x}</button>
            ))}
          </div>
        )}
        <ul id="spotlight-list" ref={listRef} className="max-h-[52vh] overflow-y-auto py-2" role="listbox">
          {results.map((r, i) => (
            <li key={r.id} id={`sp-${r.id}`} role="option" aria-selected={i === active}>
              {(i === 0 || results[i - 1].group !== r.group) && <p className="px-5 pb-1 pt-2 text-[10px] font-semibold uppercase tracking-wider text-[#7C8796]">{r.group}</p>}
              <button className={cn('flex w-full items-center gap-3 px-5 py-2.5 text-left', i === active ? 'bg-[#0B5FB8]/25' : 'hover:bg-white/[0.04]')} onMouseEnter={() => setActive(i)} onClick={() => run(r)}>
                <span className={cn('flex h-7 w-7 shrink-0 items-center justify-center rounded', r.cmd ? 'bg-[#F28C33]/12 text-[#F7B23B]' : 'bg-white/[0.05] text-[#94A3B8]')}><r.icon className="h-4 w-4" aria-hidden /></span>
                <span className="min-w-0 flex-1"><span className="block truncate text-sm">{r.label}</span>{r.sub && <span className="block truncate text-xs text-[#94A3B8]">{r.sub}</span>}</span>
                {i === active && <kbd className="rounded-sm border border-white/10 px-1.5 py-0.5 text-[10px] text-[#94A3B8]">Enter</kbd>}
              </button>
            </li>
          ))}
          {!results.length && <li className="px-5 py-10 text-center text-sm text-[#94A3B8]">Không có kết quả cho "{q}". Thử gõ <span className="font-mono text-[#F7B23B]">&gt;</span> để xem danh sách lệnh.</li>}
        </ul>
        <p className="flex flex-wrap gap-x-4 gap-y-1 border-t border-white/[0.06] px-5 py-2 text-[11px] text-[#7C8796]"><span>↑ ↓ chọn</span><span>Enter mở</span><span><b className="font-mono text-[#F7B23B]">&gt;</b> chế độ lệnh</span><span>Ctrl/⌘ + K mở từ mọi màn hình</span></p>
      </div>
    </div>
  );
}

/** Lưới thẻ KPI: 2 cột trên mobile, thẻ lẻ cuối cùng trải rộng 2 cột */
const kpiGrid = (lgCols: string) => cn('kpi-row grid grid-cols-2 gap-x-3 gap-y-5 py-1', lgCols, '[&>*:last-child:nth-child(odd)]:col-span-2 lg:[&>*:last-child:nth-child(odd)]:col-span-1');

/** Chọn phòng ban để phân lead (thủ công); phòng gợi ý theo quy tắc nhóm khách / khu vực được đánh dấu */
function RouteMenu({ lead, primary = true }: { lead: Lead; primary?: boolean }) {
  const { routableDepts, routeLeads, canDo, customers, segRules, departments } = useApp();
  const hint = decideDept(lead, customers, segRules, departments).code;
  return (
    <RowMenu
      text="Phân phòng"
      icon={ArrowRight}
      primary={primary}
      items={routableDepts.filter((d) => d.code !== lead.dept).map((d) => ({ label: `${d.name}${d.code === hint ? ' (gợi ý)' : ''}`, onClick: () => routeLeads([lead.id], d.code), disabled: !canDo('lead.route') }))}
    />
  );
}


// =====================================================================
//  THÀNH PHẦN DÙNG CHUNG: THU GỌN, XÁC NHẬN XÓA, BẢNG DANH MỤC CRUD
// =====================================================================

/** Khối thu gọn — mặc định đóng, bấm tiêu đề để mở chỉnh sửa */
function Collapse({ title, summary, defaultOpen = false, action, children }: { title: string; summary?: ReactNode; defaultOpen?: boolean; action?: ReactNode; children: ReactNode }) {
  const [open, setOpen] = useState(defaultOpen);
  return (
    <section className="rounded-md border border-[#263044] bg-[#151C29]">
      <div className="flex flex-wrap items-center gap-3 px-5 py-4">
        <button className="flex min-w-0 flex-1 items-center gap-2 rounded text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F28C33]" onClick={() => setOpen((v) => !v)} aria-expanded={open}>
          {open ? <ChevronDown className="h-4 w-4 shrink-0 text-[#F28C33]" aria-hidden /> : <ChevronRight className="h-4 w-4 shrink-0 text-[#94A3B8]" aria-hidden />}
          <span className="text-[15px] font-semibold text-[#F1F5F9]">{title}</span>
          {summary && <span className="truncate text-xs text-[#94A3B8]">{summary}</span>}
        </button>
        {open ? action : <button className={cn(btnGhost, btnSm)} onClick={() => setOpen(true)}><Pencil className="h-3.5 w-3.5" aria-hidden />Mở để chỉnh sửa</button>}
      </div>
      {open && <div className="border-t border-[#263044] px-5 pb-5 pt-4">{children}</div>}
    </section>
  );
}

type ConfirmState = { title: string; message: ReactNode; blocked?: string; confirmLabel?: string; onConfirm: () => void };

function ConfirmDialog({ title, message, blocked, confirmLabel = 'Xóa', onConfirm, onClose }: ConfirmState & { onClose: () => void }) {
  return (
    <Modal
      title={title}
      onClose={onClose}
      footer={
        <>
          <button className={btnGhost} onClick={onClose}>{blocked ? 'Đóng' : 'Hủy'}</button>
          {!blocked && <button className={cn(btnBase, 'bg-[#EF4444] px-3.5 py-2 text-white hover:bg-[#F05252]')} onClick={() => { onConfirm(); onClose(); }}><Trash2 className="h-4 w-4" aria-hidden />{confirmLabel}</button>}
        </>
      }
    >
      <div className="text-sm text-[#F1F5F9]">{message}</div>
      {blocked && <p className="mt-3 flex items-start gap-2 rounded bg-[#EF4444]/10 p-3 text-sm text-[#F87171]"><AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" aria-hidden />{blocked}</p>}
    </Modal>
  );
}

/** Mã viết hoa không dấu, không trùng — dùng cho danh mục tạo mới */
function codeFrom(name: string, existing: string[]): string {
  const base = slug(name).toUpperCase().slice(0, 24) || 'MUC';
  let code = base;
  for (let i = 2; existing.includes(code); i++) code = `${base}_${i}`;
  return code;
}

type FieldSpec = {
  key: string;
  label: string;
  type: 'text' | 'number' | 'money' | 'select' | 'checkbox' | 'color' | 'multi';
  options?: Opt[];
  hint?: string;
  wide?: boolean;
};

function EntityModal({ title, initial, fields, validate, onSave, onClose }: {
  title: string;
  initial: Record<string, unknown>;
  fields: FieldSpec[];
  validate: (v: Record<string, unknown>) => Record<string, string>;
  onSave: (v: Record<string, unknown>) => void;
  onClose: () => void;
}) {
  const [v, setV] = useState<Record<string, unknown>>(initial);
  const [touched, setTouched] = useState(false);
  const errors = validate(v);
  const set = (k: string, val: unknown) => setV((p) => ({ ...p, [k]: val }));
  const save = () => {
    setTouched(true);
    if (Object.keys(errors).length) return;
    onSave(v);
    onClose();
  };
  return (
    <Modal title={title} onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Lưu</button></>}>
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {fields.map((f) => {
          const err = touched ? errors[f.key] : undefined;
          const val = v[f.key];
          if (f.type === 'checkbox') {
            return (
              <label key={f.key} className={cn('flex items-center gap-2 text-sm text-[#F1F5F9]', f.wide && 'sm:col-span-2')}>
                <input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={!!val} onChange={(e) => set(f.key, e.target.checked)} />{f.label}
              </label>
            );
          }
          if (f.type === 'multi') {
            const arr = (val as string[]) ?? [];
            return (
              <fieldset key={f.key} className="sm:col-span-2">
                <legend className="mb-1.5 text-xs font-medium text-[#94A3B8]">{f.label}</legend>
                <div className="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
                  {f.options?.map((o) => (
                    <label key={o.value} className="flex items-center gap-2 text-sm">
                      <input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={arr.includes(o.value)} onChange={() => set(f.key, arr.includes(o.value) ? arr.filter((x) => x !== o.value) : [...arr, o.value])} />{o.label}
                    </label>
                  ))}
                </div>
                {err && <p className="mt-1 text-xs text-[#F87171]">{err}</p>}
              </fieldset>
            );
          }
          return (
            <Field key={f.key} label={f.label} error={err} hint={f.hint} className={f.wide ? 'sm:col-span-2' : undefined}>
              {f.type === 'select' ? (
                <select className={inputCls} value={String(val ?? '')} onChange={(e) => set(f.key, e.target.value)}>
                  {f.options?.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
                </select>
              ) : f.type === 'money' ? (
                <MoneyInput value={Number(val ?? 0)} onChange={(n) => set(f.key, n)} />
              ) : f.type === 'number' ? (
                <input className={inputCls} type="number" value={Number(val ?? 0)} onChange={(e) => set(f.key, Number(e.target.value))} />
              ) : f.type === 'color' ? (
                <input className="h-10 w-full cursor-pointer rounded border border-[#263044] bg-[#0F141E] p-1" type="color" value={String(val ?? '#F28C33')} onChange={(e) => set(f.key, e.target.value)} />
              ) : (
                <input className={inputCls} value={String(val ?? '')} onChange={(e) => set(f.key, e.target.value)} />
              )}
            </Field>
          );
        })}
      </div>
    </Modal>
  );
}

/** Bảng danh mục có Thêm / Sửa / Xóa dùng chung cho các cấu hình */
function CatalogTable<T>({ rows, rowKey, columns, fields, entity, canEdit, blank, toForm, fromForm, validate, onSave, onDelete, deleteBlocked }: {
  rows: T[];
  rowKey: (r: T) => string;
  columns: { label: string; render: (r: T) => ReactNode }[];
  fields: FieldSpec[];
  entity: string;
  canEdit: boolean;
  blank: () => Record<string, unknown>;
  toForm: (r: T) => Record<string, unknown>;
  fromForm: (v: Record<string, unknown>, prev?: T) => T;
  validate: (v: Record<string, unknown>, prev?: T) => Record<string, string>;
  onSave: (row: T, prev?: T) => void;
  onDelete: (r: T) => void;
  deleteBlocked?: (r: T) => string | undefined;
}) {
  const [editing, setEditing] = useState<{ row?: T } | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  return (
    <>
      <Table head={[...columns.map((c) => c.label), '']} minW={640}>
        {rows.map((r) => (
          <tr key={rowKey(r)} className={rowCls}>
            {columns.map((c, i) => <td key={c.label} className={i === 0 ? tdFirst : tdCls}>{c.render(r)}</td>)}
            <td className={cn(tdLast, 'whitespace-nowrap text-right')}>
              <button className={cn(btnGhost, 'mr-1 p-1.5')} disabled={!canEdit} onClick={() => setEditing({ row: r })} aria-label={`Sửa ${entity}`}><Pencil className="h-3.5 w-3.5" /></button>
              <button
                className={cn(btnGhost, 'p-1.5 hover:border-[#EF4444]/50 hover:text-[#F87171]')}
                disabled={!canEdit}
                onClick={() => setConfirm({ title: `Xóa ${entity}`, message: <>Xóa <b>{String(columns[0].render(r))}</b>? Thao tác không hoàn tác được.</>, blocked: deleteBlocked?.(r), onConfirm: () => onDelete(r) })}
                aria-label={`Xóa ${entity}`}
              >
                <Trash2 className="h-3.5 w-3.5" />
              </button>
            </td>
          </tr>
        ))}
      </Table>
      {!rows.length && <EmptyState text={<>Chưa có {entity}.</>} art="box" compact />}
      <button className={cn(btnGhost, btnSm, 'mt-3')} disabled={!canEdit} onClick={() => setEditing({})}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm {entity}</button>
      {editing && (
        <EntityModal
          title={editing.row ? `Sửa ${entity}` : `Thêm ${entity}`}
          initial={editing.row ? toForm(editing.row) : blank()}
          fields={fields}
          validate={(v) => validate(v, editing.row)}
          onSave={(v) => onSave(fromForm(v, editing.row), editing.row)}
          onClose={() => setEditing(null)}
        />
      )}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </>
  );
}

// =====================================================================
//  LEAD: THÊM / SỬA (kèm tải file nhu cầu)
// =====================================================================

type LeadForm = { company: string; contact: string; phone: string; taxCode: string; email: string; segment: Segment; source: Source; region: Region; province: string; boqValue: number; boqNote: string; attachments: Attachment[] };

function validateLead(f: LeadForm, leads: Lead[], selfId?: string): Partial<Record<keyof LeadForm, string>> {
  const e: Partial<Record<keyof LeadForm, string>> = {};
  if (f.company.trim().length < 3) e.company = 'Nhập tên công ty';
  if (!f.contact.trim()) e.contact = 'Nhập người liên hệ';
  if (f.phone.replace(/\D/g, '').length < 9) e.phone = 'Số điện thoại chưa đúng';
  if (f.taxCode && !MST_RE.test(f.taxCode.trim())) e.taxCode = 'MST gồm 10 số hoặc 13 số (dạng 0123456789-001)';
  else if (f.taxCode) {
    const dup = leads.find((l) => l.id !== selfId && l.taxCode === f.taxCode.trim() && !['WON', 'LOST'].includes(l.status));
    if (dup) e.taxCode = `Trùng MST với lead ${dup.code} đang mở`;
  }
  if (f.email && !EMAIL_RE.test(f.email)) e.email = 'Email chưa đúng định dạng';
  if (!(f.segment in SEGMENT_LABEL)) e.segment = 'Chọn nhóm khách hàng';
  return e;
}

function formToLead(f: LeadForm, code: string): Lead {
  return {
    id: uid('l'), code, company: f.company.trim(), contact: f.contact.trim(), phone: f.phone.trim(),
    taxCode: f.taxCode.trim() || undefined, email: f.email.trim() || undefined, segment: f.segment, source: f.source, region: f.region, province: f.province.trim() || undefined,
    boqValue: f.boqValue, boqNote: f.boqNote.trim(), attachments: f.attachments, hasBoqFile: f.attachments.length > 0,
    boqFile: f.attachments[0] ? { name: f.attachments[0].name, url: f.attachments[0].url } : undefined,
    receivedDaysAgo: 0, status: 'NEW',
  };
}

function LeadFormModal({ id, asProject, onClose }: { id?: string; asProject?: boolean; onClose: () => void }) {
  const { leads, setLeads, notify, me, users, routableDepts, customers } = useApp();
  /** Dự án do Sales tự khai thác: bỏ qua bước phân lead, vào thẳng khảo sát & báo giá */
  const [pDept, setPDept] = useState<DeptCode>(me.dept && routableDepts.some((d) => d.code === me.dept) ? me.dept : routableDepts[0]?.code ?? '');
  const [pRep, setPRep] = useState<string>(me.role === 'SALES_REP' ? me.id : '');
  const [pCust, setPCust] = useState('');
  const reps = users.filter((u) => u.active && u.dept === pDept && (u.role === 'SALES_REP' || u.role === 'DEPT_HEAD'));
  const existing = leads.find((l) => l.id === id);
  const [f, setF] = useState<LeadForm>(() =>
    existing
      ? { company: existing.company, contact: existing.contact, phone: existing.phone, taxCode: existing.taxCode ?? '', email: existing.email ?? '', segment: existing.segment, source: existing.source, region: existing.region, province: existing.province ?? '', boqValue: existing.boqValue, boqNote: existing.boqNote, attachments: existing.attachments ?? [] }
      : { company: '', contact: '', phone: '', taxCode: '', email: '', segment: 'OTHER', source: 'WEBSITE_FORM', region: 'SOUTH', province: '', boqValue: 0, boqNote: '', attachments: [] },
  );
  const [touched, setTouched] = useState(false);
  const errors = validateLead(f, leads, id);
  const set = <K extends keyof LeadForm>(k: K, v: LeadForm[K]) => setF((p) => ({ ...p, [k]: v }));
  const err = (k: keyof LeadForm) => (touched ? errors[k] : undefined);

  const addFiles = (files: File[]) => {
    const ok = files.filter((x) => x.size <= 20 * 1024 * 1024);
    if (ok.length < files.length) notify('Bỏ qua file vượt 20 MB', 'orange');
    set('attachments', [...f.attachments, ...ok.map((x) => ({ name: x.name, url: URL.createObjectURL(x), size: x.size }))]);
  };
  const removeFile = (i: number) => {
    URL.revokeObjectURL(f.attachments[i].url);
    set('attachments', f.attachments.filter((_, j) => j !== i));
  };

  const save = () => {
    setTouched(true);
    if (Object.keys(errors).length) return;
    if (existing) {
      setLeads((p) => p.map((l) => (l.id === existing.id ? {
        ...l, company: f.company.trim(), contact: f.contact.trim(), phone: f.phone.trim(), taxCode: f.taxCode.trim() || undefined, email: f.email.trim() || undefined,
        segment: f.segment, source: f.source, region: f.region, province: f.province.trim() || undefined, boqValue: f.boqValue, boqNote: f.boqNote.trim(), attachments: f.attachments,
        hasBoqFile: f.attachments.length > 0 || l.hasBoqFile, boqFile: l.boqFile ?? (f.attachments[0] ? { name: f.attachments[0].name, url: f.attachments[0].url } : undefined),
      } : l)));
      notify(`Đã cập nhật ${existing.code}`, 'teal');
    } else if (asProject) {
      if (!pDept || !pRep) return notify('Chọn phòng ban và người phụ trách dự án', 'red');
      const base = formToLead(f, nextCode(leads.map((l) => l.code), 'LD-2026-', 4));
      const now = Date.now();
      const lead: Lead = { ...base, status: 'ACCEPTED', dept: pDept, assignee: pRep, routedAt: now, slaMet: true, quoteDeadline: now + QUOTE_SLA_MS, boqStatus: 'NOT_STARTED', routingReason: 'Sales tự khai thác', score: scoreLead(base, customers), customerId: pCust || undefined };
      setLeads((p) => [lead, ...p]);
      notify(`Đã tạo dự án ${lead.code}. Hạn nộp BOQ và báo giá: 24 giờ.`, 'teal');
    } else {
      const lead = formToLead(f, nextCode(leads.map((l) => l.code), 'LD-2026-', 4));
      setLeads((p) => [lead, ...p]);
      notify(`Đã thêm lead ${lead.code}, chờ Marketing phân phòng ban`, 'teal');
    }
    onClose();
  };

  return (
    <Modal
      title={existing ? `Sửa ${existing.code}` : asProject ? 'Tạo dự án mới' : 'Thêm lead mới'}
      onClose={onClose}
      wide
      footer={
        existing || asProject ? (
          <><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>{existing ? 'Lưu thay đổi' : 'Tạo dự án'}</button></>
        ) : (
          <><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Lưu lead</button></>
        )
      }
    >
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {asProject && !existing && (
          <>
            <p className="rounded bg-[#1C2534] p-3 text-xs text-[#94A3B8] sm:col-span-2">Dự án Sales tự khai thác không qua bước phân lead của Marketing; vào thẳng giai đoạn khảo sát và báo giá (SLA 24 giờ).</p>
            <Field label="Khách hàng có sẵn trong CRM" className="sm:col-span-2" hint="Chọn để tự điền pháp nhân, MST, liên hệ; để trống nếu là khách mới">
              <select className={inputCls} value={pCust} onChange={(e) => {
                const c = customers.find((x) => x.id === e.target.value);
                setPCust(e.target.value);
                if (c) setF((p) => ({ ...p, company: c.name, taxCode: c.taxCode, contact: c.contactName, phone: c.contactPhone, email: c.contactEmail, segment: c.segment, region: c.region }));
              }}>
                <option value="">Khách hàng mới</option>
                {customers.map((c) => <option key={c.id} value={c.id}>{c.name} (MST {c.taxCode})</option>)}
              </select>
            </Field>
            <Field label="Phòng ban">
              <select className={inputCls} value={pDept} onChange={(e) => { setPDept(e.target.value); setPRep(''); }}>
                {routableDepts.map((d) => <option key={d.code} value={d.code}>{d.name}</option>)}
              </select>
            </Field>
            <Field label="Người phụ trách">
              <select className={inputCls} value={pRep} onChange={(e) => setPRep(e.target.value)}>
                <option value="">Chọn nhân sự</option>
                {reps.map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}
              </select>
            </Field>
          </>
        )}
        <Field label="Tên công ty *" error={err('company')} className="sm:col-span-2"><input className={inputCls} value={f.company} onChange={(e) => set('company', e.target.value)} /></Field>
        <Field label="Người liên hệ *" error={err('contact')}><input className={inputCls} value={f.contact} onChange={(e) => set('contact', e.target.value)} /></Field>
        <Field label="Số điện thoại *" error={err('phone')}><input className={inputCls} inputMode="tel" value={f.phone} onChange={(e) => set('phone', e.target.value)} /></Field>
        <Field label="Mã số thuế" error={err('taxCode')} hint="Dùng nhận diện khách hàng hiện hữu"><input className={inputCls} value={f.taxCode} onChange={(e) => set('taxCode', e.target.value)} /></Field>
        <Field label="Email" error={err('email')}><input className={inputCls} type="email" value={f.email} onChange={(e) => set('email', e.target.value)} /></Field>
        <Field label="Nhóm khách hàng" error={err('segment')}>
          <select className={inputCls} value={f.segment} onChange={(e) => set('segment', e.target.value)}>
            {Object.keys(SEGMENT_LABEL).map((s) => <option key={s} value={s}>{segName(s)}</option>)}
          </select>
        </Field>
        <Field label="Khu vực" hint="Quyết định phòng EMD Bắc / Nam khi phân lead">
          <select className={inputCls} value={f.region} onChange={(e) => set('region', e.target.value as Region)}>
            {(Object.keys(REGION_LABEL) as Region[]).map((r) => <option key={r} value={r}>{REGION_LABEL[r]}</option>)}
          </select>
        </Field>
        <Field label="Tỉnh / thành phố"><input className={inputCls} value={f.province} onChange={(e) => set('province', e.target.value)} placeholder="VD: Hà Nội" /></Field>
        <Field label="Kênh nguồn lead">
          <select className={inputCls} value={f.source} onChange={(e) => set('source', e.target.value as Source)}>
            {(Object.keys(SOURCE_LABEL) as Source[]).map((s) => <option key={s} value={s}>{SOURCE_LABEL[s]}</option>)}
          </select>
        </Field>
        <Field label="Giá trị ước tính" hint="MKT nhập ước tính; giá trị chính thức lấy từ BOQ bóc tách"><MoneyInput value={f.boqValue} onChange={(n) => set('boqValue', n)} /></Field>
        <Field label="Nhu cầu" className="sm:col-span-2"><textarea className={cn(inputCls, 'min-h-20')} value={f.boqNote} onChange={(e) => set('boqNote', e.target.value)} placeholder="VD: Đầu cáp co nguội 24kV cho trạm biến áp 2 x 1.000 kVA" /></Field>
        <div className="sm:col-span-2">
          <p className="mb-1.5 text-xs font-medium text-[#94A3B8]">File nhu cầu (BOQ, bản vẽ, hồ sơ mời thầu)</p>
          <FilePicker accept=".pdf,.xls,.xlsx,.csv,.doc,.docx,.dwg,.jpg,.jpeg,.png,.zip" multiple onFiles={addFiles} className="flex items-center justify-center gap-2 rounded border border-dashed border-[#263044] px-4 py-4 text-sm text-[#94A3B8] hover:border-[#F28C33]/60 hover:text-[#F1F5F9]">
            <Paperclip className="h-4 w-4" aria-hidden />Chọn hoặc kéo thả file (tối đa 20 MB / file)
          </FilePicker>
          {f.attachments.length > 0 && (
            <ul className="mt-2 space-y-1">
              {f.attachments.map((a, i) => (
                <li key={a.url} className="flex items-center gap-2 rounded bg-[#1C2534] px-3 py-1.5 text-sm">
                  <FileText className="h-4 w-4 shrink-0 text-[#94A3B8]" aria-hidden />
                  <a href={a.url} target="_blank" rel="noreferrer" className="min-w-0 flex-1 truncate text-[#6FA8F0] hover:underline">{a.name}</a>
                  <span className="text-xs text-[#94A3B8]">{Math.max(1, Math.round(a.size / 1024))} KB</span>
                  <button className="text-[#94A3B8] hover:text-[#F87171]" onClick={() => removeFile(i)} aria-label={`Bỏ ${a.name}`}><X className="h-4 w-4" /></button>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </Modal>
  );
}

// =====================================================================
//  DỰ ÁN: BÓC TÁCH BOQ & BÁO GIÁ
// =====================================================================

function BoqEditorModal({ lead, onClose }: { lead: Lead; onClose: () => void }) {
  const { setLeads, notify, skus } = useApp();
  const [rows, setRows] = useState<BoqItem[]>(lead.boqItems?.length ? lead.boqItems : [{ code: '', name: '', unit: 'Bộ', qty: 1, price: 0, discountPct: 0 }]);
  const [touched, setTouched] = useState(false);
  const setRow = (i: number, p: Partial<BoqItem>) => setRows((r) => r.map((x, j) => (j === i ? { ...x, ...p } : x)));
  const lineTotal = (x: BoqItem) => x.qty * x.price * (1 - x.discountPct / 100);
  const total = rows.reduce((s, x) => s + lineTotal(x), 0);
  const invalid = rows.some((x) => !x.code.trim() || !x.name.trim() || x.qty <= 0 || x.price <= 0 || x.discountPct < 0 || x.discountPct > 100);

  const save = () => {
    setTouched(true);
    const clean = rows.filter((x) => x.code.trim() || x.name.trim());
    if (clean.some((x) => !x.code.trim() || !x.name.trim() || x.qty <= 0 || x.price <= 0)) return;
    setLeads((p) => p.map((l) => (l.id === lead.id ? { ...l, boqItems: clean, boqStatus: clean.length ? 'DONE' : l.boqStatus } : l)));
    notify(`Đã lưu ${clean.length} dòng BOQ, tổng ${compact(Math.round(clean.reduce((s, x) => s + lineTotal(x), 0)))}`, 'teal');
    onClose();
  };

  return (
    <Modal title={`Bóc tách BOQ: ${lead.company}`} onClose={onClose} wide footer={<><span className="mr-auto self-center text-sm tabular-nums">Tổng BOQ: <b>{vnd(total)}</b> (ước tính MKT {compact(lead.boqValue)})</span><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Lưu BOQ</button></>}>
      <p className="mb-3 text-xs text-[#94A3B8]">Mã sản phẩm nên trùng mã trên Getfly để đơn hàng đồng bộ đúng. Sau khi lưu, giá trị dự án lấy theo tổng BOQ thay cho số ước tính.</p>
      <div className="-mx-5 overflow-x-auto">
        <table className="w-full min-w-[760px] text-sm">
          <thead className="text-xs text-[#94A3B8]">
            <tr className="border-b border-[#263044] text-left">
              <th className="py-2 pl-5 pr-2 font-medium">Mã SP</th><th className="px-2 py-2 font-medium">Tên vật tư</th><th className="px-2 py-2 font-medium">ĐVT</th>
              <th className="px-2 py-2 font-medium">SL</th><th className="px-2 py-2 font-medium">Đơn giá</th><th className="px-2 py-2 font-medium">CK %</th>
              <th className="px-2 py-2 text-right font-medium">Thành tiền</th><th className="py-2 pl-2 pr-5" />
            </tr>
          </thead>
          <tbody>
            {rows.map((x, i) => (
              <tr key={i} className="border-b border-[#263044]/60">
                <td className="py-1.5 pl-5 pr-2"><input className={cn(inputBase, 'w-36 py-1 text-xs', touched && !x.code.trim() && 'border-[#EF4444]')} list="boq-skus" value={x.code} onChange={(e) => { const code = e.target.value.toUpperCase(); const k = skus.find((s) => s.sku === code); setRow(i, k ? { code, name: x.name || k.name, unit: k.unit, price: x.price || k.projectPrice || k.basePrice } : { code }); }} aria-label="Mã sản phẩm" /></td>
                <td className="px-2 py-1.5"><input className={cn(inputCls, 'min-w-[200px] py-1 text-xs', touched && !x.name.trim() && 'border-[#EF4444]')} value={x.name} onChange={(e) => setRow(i, { name: e.target.value })} aria-label="Tên vật tư" /></td>
                <td className="px-2 py-1.5"><input className={cn(inputBase, 'w-16 py-1 text-xs')} value={x.unit} onChange={(e) => setRow(i, { unit: e.target.value })} aria-label="Đơn vị tính" /></td>
                <td className="px-2 py-1.5"><input className={cn(inputBase, 'w-20 py-1 text-xs')} type="number" min={0} value={x.qty} onChange={(e) => setRow(i, { qty: Number(e.target.value) })} aria-label="Số lượng" /></td>
                <td className="px-2 py-1.5"><input className={cn(inputBase, 'w-32 py-1 text-xs tabular-nums')} inputMode="numeric" value={x.price ? new Intl.NumberFormat('vi-VN').format(x.price) : ''} onChange={(e) => setRow(i, { price: digits(e.target.value) })} aria-label="Đơn giá" /></td>
                <td className="px-2 py-1.5"><input className={cn(inputBase, 'w-16 py-1 text-xs')} type="number" min={0} max={100} value={x.discountPct} onChange={(e) => setRow(i, { discountPct: Number(e.target.value) })} aria-label="Chiết khấu" /></td>
                <td className="px-2 py-1.5 text-right tabular-nums">{vnd(lineTotal(x))}</td>
                <td className="py-1.5 pl-2 pr-5"><button className="text-[#94A3B8] hover:text-[#F87171]" onClick={() => setRows((r) => r.filter((_, j) => j !== i))} aria-label="Xóa dòng"><Trash2 className="h-4 w-4" /></button></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <datalist id="boq-skus">{skus.map((s) => <option key={s.sku} value={s.sku}>{s.name}</option>)}</datalist>
      <button className={cn(btnGhost, btnSm, 'mt-3')} onClick={() => setRows((r) => [...r, { code: '', name: '', unit: 'Bộ', qty: 1, price: 0, discountPct: 0 }])}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm dòng</button>
      {touched && invalid && <p className="mt-2 text-xs text-[#F87171]">Mỗi dòng cần mã, tên, số lượng và đơn giá lớn hơn 0.</p>}
    </Modal>
  );
}

// =====================================================================
//  HỒ SƠ MDF: GHI NHẬN 3M DUYỆT (nhập mã Pre-Approval do 3M cấp)
// =====================================================================

function VendorApprovalModal({ program, onClose }: { program: Program; onClose: () => void }) {
  const { programs, claims, setPrograms, setBudget, notify, dispatch } = useApp();
  const [pa, setPa] = useState('');
  const [amount, setAmount] = useState(program.held);
  const [date, setDate] = useState(todayISO());
  const [touched, setTouched] = useState(false);
  const code = pa.trim().toUpperCase();
  const dup = programs.some((p) => p.id !== program.id && p.preApprovalId?.toUpperCase() === code) || claims.some((c) => c.preApprovalId.toUpperCase() === code);
  const e = { pa: !code ? 'Nhập mã Pre-Approval 3M cấp trong email / thư duyệt' : dup ? 'Mã này đã dùng cho chương trình khác' : '', amount: amount <= 0 || amount > program.held ? `Từ 1 đến ${vnd(program.held)}` : '' };

  const save = () => {
    setTouched(true);
    if (e.pa || e.amount) return;
    const release = program.held - amount;
    if (release > 0) setBudget((b) => ({ ...b, committed: Math.max(0, b.committed - release) }));
    setPrograms((ps) => ps.map((x) => (x.id === program.id ? { ...x, status: 'APPROVED', preApprovalId: code, held: amount, vendorApprovedAt: date } : x)));
    const msg = `3M duyệt ${program.title}: mã ${code}, ${vnd(amount)}${release > 0 ? `, nhả ${compact(release)} về quỹ` : ''}`;
    notify(msg, 'teal');
    dispatch('CLAIM_UPDATE', { title: '3M đã duyệt Pre-Approval', body: msg, module: 'claims' });
    onClose();
  };

  return (
    <Modal title="Ghi nhận 3M duyệt Pre-Approval" onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Xác nhận</button></>}>
      <div className="space-y-4">
        <div className="rounded bg-[#1C2534] p-3 text-sm">
          <p className="font-medium">{program.title}</p>
          <p className="text-xs text-[#94A3B8]">Mã đề xuất nội bộ {program.code}, đang giữ chỗ {vnd(program.held)}</p>
        </div>
        <p className="text-xs text-[#94A3B8]">Mã Pre-Approval do 3M cấp sau khi duyệt đề xuất. Hồ sơ claim và Audit Pack dùng mã này để đối chiếu với 3M.</p>
        <Field label="Mã Pre-Approval (3M cấp) *" error={touched ? e.pa || undefined : undefined}><input className={cn(inputCls, 'font-mono')} value={pa} onChange={(ev) => setPa(ev.target.value)} placeholder="VD: 3M-MDF-26-0051" /></Field>
        <div className="grid grid-cols-2 gap-3">
          <Field label="Số tiền 3M duyệt" error={touched ? e.amount || undefined : undefined} hint="Thấp hơn giữ chỗ thì phần dư tự nhả về quỹ"><MoneyInput value={amount} onChange={setAmount} /></Field>
          <Field label="Ngày duyệt"><input className={inputCls} type="date" value={date} onChange={(ev) => setDate(ev.target.value)} /></Field>
        </div>
      </div>
    </Modal>
  );
}

// =====================================================================
//  KHÁCH HÀNG: QUẢN LÝ NGUỒN KHÁCH
// =====================================================================

function SourceManagerModal({ onClose }: { onClose: () => void }) {
  const { sources, setSources, customers, canDo, notify } = useApp();
  return (
    <Modal title="Nguồn khách hàng" onClose={onClose} wide footer={<button className={btnPrimary} onClick={onClose}>Xong</button>}>
      <p className="mb-3 text-sm text-[#94A3B8]">Nguồn có đánh dấu Marketing được tính vào doanh số và ROI Marketing.</p>
      <CatalogTable<CustomerSource>
        rows={sources}
        rowKey={(r) => r.id}
        entity="nguồn khách"
        canEdit={canDo('customer.edit')}
        columns={[
          { label: 'Tên nguồn', render: (r) => r.name },
          { label: 'Tính cho Marketing', render: (r) => (r.isMarketing ? <Chip tone="orange">Marketing</Chip> : <Chip>Không</Chip>) },
          { label: 'Số khách', render: (r) => customers.filter((c) => c.sourceId === r.id).length },
        ]}
        fields={[{ key: 'name', label: 'Tên nguồn', type: 'text', wide: true }, { key: 'isMarketing', label: 'Nguồn do Marketing tạo ra', type: 'checkbox', wide: true }]}
        blank={() => ({ name: '', isMarketing: false })}
        toForm={(r) => ({ ...r })}
        fromForm={(v, prev) => ({ id: prev?.id ?? codeFrom(String(v.name), sources.map((s) => s.id)), name: String(v.name).trim(), isMarketing: !!v.isMarketing })}
        validate={(v, prev): Record<string, string> => (String(v.name ?? '').trim().length < 3 ? { name: 'Tối thiểu 3 ký tự' } : sources.some((s) => s.id !== prev?.id && s.name.toLowerCase() === String(v.name).trim().toLowerCase()) ? { name: 'Tên nguồn đã có' } : {})}
        onSave={(row, prev) => { setSources((p) => (prev ? p.map((s) => (s.id === prev.id ? row : s)) : [...p, row])); notify(prev ? 'Đã sửa nguồn khách' : 'Đã thêm nguồn khách', 'teal'); }}
        onDelete={(r) => { setSources((p) => p.filter((s) => s.id !== r.id)); notify(`Đã xóa nguồn ${r.name}`, 'orange'); }}
        deleteBlocked={(r) => { const n = customers.filter((c) => c.sourceId === r.id).length; return n ? `Đang có ${n} khách hàng thuộc nguồn này. Chuyển các khách hàng sang nguồn khác trước khi xóa.` : sources.length <= 1 ? 'Cần giữ ít nhất một nguồn.' : undefined; }}
      />
    </Modal>
  );
}

// =====================================================================
//  CÀI ĐẶT: THÔNG TIN DOANH NGHIỆP & LOGO
// =====================================================================

function BrandMark({ size = 32 }: { size?: number }) {
  const { company } = useApp();
  return company.logo ? (
    // eslint-disable-next-line @next/next/no-img-element
    <img src={company.logo} alt={company.shortName} style={{ width: size, height: size }} className="shrink-0 rounded bg-white object-contain p-0.5" />
  ) : (
    <span style={{ width: size, height: size }} className="flex shrink-0 items-center justify-center rounded bg-[#F28C33] text-xs font-bold text-[#0F141E]">{initials(company.shortName || company.appName)}</span>
  );
}

function CompanySettings() {
  const { company, setCompany, canDo, notify } = useApp();
  const canEdit = canDo('settings.edit');
  const [f, setF] = useState(company);
  const [touched, setTouched] = useState(false);
  const set = <K extends keyof CompanyInfo>(k: K, v: CompanyInfo[K]) => setF((p) => ({ ...p, [k]: v }));
  const e: Partial<Record<keyof CompanyInfo, string>> = {};
  if (f.appName.trim().length < 2) e.appName = 'Nhập tên hệ thống';
  if (f.legalName.trim().length < 5) e.legalName = 'Nhập tên pháp lý';
  if (f.taxCode && !MST_RE.test(f.taxCode)) e.taxCode = 'MST gồm 10 hoặc 13 số';
  if (f.email && !EMAIL_RE.test(f.email)) e.email = 'Email chưa đúng';
  const err = (k: keyof CompanyInfo) => (touched ? e[k] : undefined);

  const pickLogo = (files: File[]) => {
    const file = files[0];
    if (!file.type.startsWith('image/')) return notify('Chọn file ảnh (PNG, JPG, SVG)', 'red');
    if (file.size > 1024 * 1024) return notify('Logo tối đa 1 MB', 'red');
    const reader = new FileReader();
    reader.onload = () => set('logo', String(reader.result));
    reader.onerror = () => notify('Không đọc được file ảnh', 'red');
    reader.readAsDataURL(file);
  };
  const save = () => {
    setTouched(true);
    if (Object.keys(e).length) return;
    setCompany({ ...f, appName: f.appName.trim(), legalName: f.legalName.trim(), shortName: f.shortName.trim() || f.appName.trim() });
    notify('Đã lưu thông tin doanh nghiệp', 'teal');
  };

  return (
    <Panel title="Thông tin doanh nghiệp">
      <div className="grid grid-cols-1 gap-6 lg:grid-cols-[200px_1fr]">
        <div>
          <p className="mb-2 text-xs font-medium text-[#94A3B8]">Logo</p>
          <FilePicker accept="image/png,image/jpeg,image/svg+xml,image/webp" onFiles={pickLogo} disabled={!canEdit} className="flex aspect-square w-full max-w-[200px] items-center justify-center overflow-hidden rounded-md border border-dashed border-[#263044] bg-[#0F141E] hover:border-[#F28C33]/60">
            {f.logo ? (
              // eslint-disable-next-line @next/next/no-img-element
              <img src={f.logo} alt="Logo doanh nghiệp" className="h-full w-full bg-white object-contain p-3" />
            ) : (
              <span className="flex flex-col items-center gap-2 text-xs text-[#94A3B8]"><ImagePlus className="h-6 w-6" aria-hidden />Tải logo (tối đa 1 MB)</span>
            )}
          </FilePicker>
          {f.logo && <button className={cn(btnGhost, btnSm, 'mt-2')} disabled={!canEdit} onClick={() => set('logo', undefined)}><Trash2 className="h-3.5 w-3.5" aria-hidden />Gỡ logo</button>}
          <p className="mt-2 text-xs text-[#94A3B8]">Hiển thị ở thanh bên, màn hình đăng nhập và email báo cáo.</p>
        </div>
        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <Field label="Tên hệ thống" error={err('appName')}><input className={inputCls} disabled={!canEdit} value={f.appName} onChange={(ev) => set('appName', ev.target.value)} /></Field>
          <Field label="Tên viết tắt"><input className={inputCls} disabled={!canEdit} value={f.shortName} onChange={(ev) => set('shortName', ev.target.value)} /></Field>
          <Field label="Tên pháp lý" error={err('legalName')} className="sm:col-span-2"><input className={inputCls} disabled={!canEdit} value={f.legalName} onChange={(ev) => set('legalName', ev.target.value)} /></Field>
          <Field label="Mã số thuế" error={err('taxCode')}><input className={inputCls} disabled={!canEdit} value={f.taxCode} onChange={(ev) => set('taxCode', ev.target.value.trim())} /></Field>
          <Field label="Điện thoại"><input className={inputCls} disabled={!canEdit} value={f.phone} onChange={(ev) => set('phone', ev.target.value)} /></Field>
          <Field label="Địa chỉ" className="sm:col-span-2"><input className={inputCls} disabled={!canEdit} value={f.address} onChange={(ev) => set('address', ev.target.value)} /></Field>
          <Field label="Email" error={err('email')}><input className={inputCls} disabled={!canEdit} value={f.email} onChange={(ev) => set('email', ev.target.value.trim())} /></Field>
          <Field label="Website"><input className={inputCls} disabled={!canEdit} value={f.website} onChange={(ev) => set('website', ev.target.value.trim())} /></Field>
          <Field label="Người đại diện ký báo giá / hợp đồng"><input className={inputCls} disabled={!canEdit} value={f.representative} onChange={(ev) => set('representative', ev.target.value)} /></Field>
          <Field label="Chức vụ"><input className={inputCls} disabled={!canEdit} value={f.representativeTitle} onChange={(ev) => set('representativeTitle', ev.target.value)} /></Field>
          <Field label="Số tài khoản"><input className={inputCls} disabled={!canEdit} value={f.bankAccount} onChange={(ev) => set('bankAccount', ev.target.value)} /></Field>
          <Field label="Ngân hàng, chi nhánh"><input className={inputCls} disabled={!canEdit} value={f.bankName} onChange={(ev) => set('bankName', ev.target.value)} /></Field>
          <div className="sm:col-span-2">
            <p className="mb-1.5 text-xs font-medium text-[#94A3B8]">Ảnh mộc và chữ ký (chèn vào {'{{company_stamp}}'} trên báo giá / hợp đồng)</p>
            <div className="flex flex-wrap items-center gap-3">
              {/* eslint-disable-next-line @next/next/no-img-element */}
              {f.stamp && <img src={f.stamp} alt="Mộc và chữ ký" className="h-20 rounded bg-white object-contain p-1" />}
              <FilePicker accept="image/png,image/jpeg,image/webp" disabled={!canEdit} onFiles={(files) => { const file = files[0]; if (!file.type.startsWith('image/') || file.size > 1024 * 1024) return notify('Chọn ảnh PNG / JPG tối đa 1 MB (nên dùng PNG nền trong suốt)', 'red'); const r = new FileReader(); r.onload = () => set('stamp', String(r.result)); r.readAsDataURL(file); }} className={cn(btnGhost, btnSm)}><ImagePlus className="h-3.5 w-3.5" aria-hidden />{f.stamp ? 'Đổi ảnh' : 'Tải ảnh mộc / chữ ký'}</FilePicker>
              {f.stamp && <button className={cn(btnGhost, btnSm)} disabled={!canEdit} onClick={() => set('stamp', undefined)}>Gỡ ảnh</button>}
            </div>
            <p className="mt-1 text-xs text-[#94A3B8]">Đây là ảnh mộc chèn vào bản in, không thay thế chữ ký số. Ký số cần chứng thư số và thực hiện phía máy chủ.</p>
          </div>
          <div className="sm:col-span-2"><button className={btnPrimary} disabled={!canEdit} onClick={save}>Lưu thông tin doanh nghiệp</button></div>
        </div>
      </div>
    </Panel>
  );
}

// =====================================================================
//  CÀI ĐẶT: NGÂN SÁCH MARKETING NỘI BỘ (tách khỏi quỹ 3M)
// =====================================================================

function MarketingBudgetSettings() {
  const { mktItems, setMktItems, canDo, notify, leads } = useApp();
  const canEdit = canDo('settings.edit') || canDo('lead.create');
  const planned = mktItems.reduce((s, i) => s + i.planned, 0);
  const spent = mktItems.reduce((s, i) => s + i.spent, 0);
  const sourceOpts: Opt[] = [{ value: '', label: 'Không gắn kênh lead' }, ...(Object.keys(SOURCE_LABEL) as Source[]).map((s) => ({ value: s, label: SOURCE_LABEL[s] }))];
  return (
    <div className="space-y-5">
      <p className="flex items-start gap-2 rounded border border-[#263044] bg-[#1C2534] px-4 py-3 text-sm text-[#94A3B8]">
        <Megaphone className="mt-0.5 h-4 w-4 shrink-0 text-[#F28C33]" aria-hidden />
        Ngân sách Marketing do VASSH tự chi, không thuộc quỹ MDF / CS của 3M. Chi phí thực tế ở đây dùng tính CPL, chi phí trên mỗi đơn chốt và ROI Marketing trong Báo cáo.
      </p>
      <div className={kpiGrid('lg:grid-cols-3')}>
        <StatCard label="Kế hoạch năm" value={compact(planned)} icon={Wallet} />
        <StatCard label="Đã chi" value={compact(spent)} sub={pct(spent, planned) + ' kế hoạch'} icon={Coins} color={C.orange} />
        <StatCard label="Chi phí / lead" value={leads.length ? compact(spent / leads.length) : '—'} sub={`${leads.length} lead trong hệ thống`} icon={Target} />
      </div>
      <Collapse title="Hạng mục chi Marketing" summary={`${mktItems.length} hạng mục`}>
        <CatalogTable<MktItem>
          rows={mktItems}
          rowKey={(r) => r.id}
          entity="hạng mục chi"
          canEdit={canEdit}
          columns={[
            { label: 'Hạng mục', render: (r) => r.name },
            { label: 'Kênh lead', render: (r) => (r.source ? SOURCE_LABEL[r.source] : '—') },
            { label: 'Kế hoạch', render: (r) => <span className="tabular-nums">{compact(r.planned)}</span> },
            { label: 'Đã chi', render: (r) => <div className="w-36"><ProgressBar value={r.spent} max={r.planned} /><p className="mt-1 text-xs tabular-nums text-[#94A3B8]">{compact(r.spent)}</p></div> },
          ]}
          fields={[
            { key: 'name', label: 'Tên hạng mục', type: 'text', wide: true },
            { key: 'source', label: 'Kênh lead tương ứng', type: 'select', options: sourceOpts, hint: 'Để tính CPL và ROI theo kênh' },
            { key: 'planned', label: 'Kế hoạch năm', type: 'money' },
            { key: 'spent', label: 'Đã chi thực tế', type: 'money' },
          ]}
          blank={() => ({ name: '', source: '', planned: 0, spent: 0 })}
          toForm={(r) => ({ ...r })}
          fromForm={(v, prev) => ({ id: prev?.id ?? uid('mk'), name: String(v.name).trim(), source: String(v.source ?? '') as Source | '', planned: Number(v.planned), spent: Number(v.spent) })}
          validate={(v) => {
            const e: Record<string, string> = {};
            if (String(v.name ?? '').trim().length < 3) e.name = 'Tối thiểu 3 ký tự';
            if (Number(v.planned) <= 0) e.planned = 'Nhập kế hoạch';
            if (Number(v.spent) < 0) e.spent = 'Không âm';
            return e;
          }}
          onSave={(row, prev) => { setMktItems((p) => (prev ? p.map((x) => (x.id === prev.id ? row : x)) : [...p, row])); notify('Đã lưu hạng mục chi Marketing', 'teal'); }}
          onDelete={(r) => { setMktItems((p) => p.filter((x) => x.id !== r.id)); notify(`Đã xóa ${r.name}`, 'orange'); }}
        />
      </Collapse>
    </div>
  );
}

// =====================================================================
//  THẶNG DƯ QUỸ MDF — đối soát 2 tầng (mức 3M duyệt vs thực chi nhà cung cấp)
//  Chỉ vai trò có quyền 'mdf.margin' (mặc định BOD, Kế toán) xem được số thực chi.
// =====================================================================

function MarginBadge({ c }: { c: Claim }) {
  const f = claimFinance(c);
  if (!f.hasActual) return <span className="text-xs text-[#94A3B8]">Chưa nhập thực chi</span>;
  if (f.settlement === 'ACTUAL_COST') return f.returned > 0 ? <Chip>Hoàn quỹ {compact(f.returned)}</Chip> : <span className="text-xs text-[#94A3B8]">Hoàn ứng đủ</span>;
  if (f.mdfMargin < 0) return <Chip tone="red">Vượt duyệt {compact(-f.mdfMargin)}</Chip>;
  return <Chip tone="teal">Thặng dư Quỹ: +{compact(f.mdfMargin)} ({f.marginPct.toFixed(1).replace('.', ',')}%)</Chip>;
}

function ClaimFinancePanel({ claim }: { claim: Claim }) {
  const { setClaims, canDo, notify } = useApp();
  const canSee = canDo('mdf.margin');
  const canEdit = (canDo('claim.accounting') || canDo('claim.submit')) && canSee;
  const f = claimFinance(claim);
  const [draft, setDraft] = useState<CostLine>({ id: '', item: '', supplier: '', approved: 0, actual: 0, invoiceNo: '' });
  const [editingId, setEditingId] = useState<string | null>(null);
  const update = (p: Partial<Claim>) => setClaims((all) => all.map((c) => (c.id === claim.id ? { ...c, ...p } : c)));
  const lines = claim.costLines ?? [];
  const sumApproved = lines.reduce((s, l) => s + l.approved, 0);

  // Sales Rep: chỉ thấy ngân sách danh nghĩa
  if (!canSee) {
    return (
      <section className="rounded-md border border-[#263044] p-4">
        <h3 className="mb-2 text-sm font-semibold">Ngân sách chương trình</h3>
        <div className="grid grid-cols-2 gap-3 text-sm">
          <div><p className="text-xs text-[#94A3B8]">3M duyệt</p><p className="mt-0.5 font-semibold tabular-nums">{vnd(f.vendorApprovedBudget)}</p></div>
          <div><p className="text-xs text-[#94A3B8]">Số claim</p><p className="mt-0.5 font-semibold tabular-nums">{vnd(claim.claimed)}</p></div>
        </div>
      </section>
    );
  }

  const saveLine = () => {
    if (draft.item.trim().length < 3 || !draft.supplier.trim() || draft.approved < 0 || draft.actual <= 0) return notify('Nhập hạng mục, nhà cung cấp và chi phí thực tế', 'red');
    const line = { ...draft, id: editingId ?? uid('cl'), item: draft.item.trim(), supplier: draft.supplier.trim() };
    update({ costLines: editingId ? lines.map((l) => (l.id === editingId ? line : l)) : [...lines, line] });
    setDraft({ id: '', item: '', supplier: '', approved: 0, actual: 0, invoiceNo: '' });
    setEditingId(null);
  };

  return (
    <section className="rounded-md border border-[#263044] p-4">
      <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h3 className="flex items-center gap-2 text-sm font-semibold"><Scale className="h-4 w-4 text-[#F28C33]" aria-hidden />Đối soát chi phí 2 tầng</h3>
        <div className="flex flex-wrap items-center gap-2">
          <Chip tone={f.settlement === 'LUMP_SUM' ? 'orange' : 'blue'}>{SETTLEMENT_LABEL[f.settlement]}</Chip>
          <MarginBadge c={claim} />
        </div>
      </div>

      <div className="mb-3 grid grid-cols-3 gap-2 text-sm">
        <div className="rounded bg-[#1C2534] p-2.5"><p className="text-[11px] text-[#94A3B8]">3M duyệt (nộp claim)</p><p className="font-semibold tabular-nums">{compact(f.vendorApprovedBudget)}</p></div>
        <div className="rounded bg-[#1C2534] p-2.5"><p className="text-[11px] text-[#94A3B8]">Thực chi triển khai</p><p className="font-semibold tabular-nums">{f.hasActual ? compact(f.actualExecutionCost) : '—'}</p></div>
        <div className="rounded bg-[#1C2534] p-2.5">
          <p className="text-[11px] text-[#94A3B8]">{f.settlement === 'LUMP_SUM' ? 'Thặng dư quỹ' : 'Hoàn lại quỹ'}</p>
          <p className={cn('font-semibold tabular-nums', f.settlement === 'LUMP_SUM' ? (f.mdfMargin >= 0 ? 'text-[#3DDBB6]' : 'text-[#F87171]') : 'text-[#F1F5F9]')}>{f.hasActual ? compact(f.settlement === 'LUMP_SUM' ? f.mdfMargin : f.returned) : '—'}</p>
        </div>
      </div>

      <div className="-mx-4 overflow-x-auto">
        <table className="w-full min-w-[620px] text-sm">
          <thead className="text-xs text-[#94A3B8]">
            <tr className="border-b border-[#263044] text-left">
              <th className="py-2 pl-4 pr-2 font-medium">Hạng mục chi</th>
              <th className="px-2 py-2 font-medium">Nhà cung cấp</th>
              <th className="px-2 py-2 text-right font-medium">Mức 3M duyệt</th>
              <th className="px-2 py-2 text-right font-medium">Thực chi NCC</th>
              <th className="px-2 py-2 text-right font-medium">Chênh lệch</th>
              <th className="py-2 pl-2 pr-4" />
            </tr>
          </thead>
          <tbody>
            {lines.map((l) => (
              <tr key={l.id} className="border-b border-[#263044]/60">
                <td className="py-2 pl-4 pr-2">{l.item}{l.invoiceNo && <span className="block text-[11px] text-[#94A3B8]">HĐ {l.invoiceNo}</span>}</td>
                <td className="px-2 py-2 text-[#94A3B8]">{l.supplier}</td>
                <td className="px-2 py-2 text-right tabular-nums">{compact(l.approved)}</td>
                <td className="px-2 py-2 text-right tabular-nums">{compact(l.actual)}</td>
                <td className={cn('px-2 py-2 text-right tabular-nums', l.approved - l.actual >= 0 ? 'text-[#3DDBB6]' : 'text-[#F87171]')}>{l.approved - l.actual >= 0 ? '+' : ''}{compact(l.approved - l.actual)}</td>
                <td className="whitespace-nowrap py-2 pl-2 pr-4 text-right">
                  <button className="mr-2 text-[#94A3B8] hover:text-[#F1F5F9] disabled:opacity-40" disabled={!canEdit} onClick={() => { setDraft(l); setEditingId(l.id); }} aria-label={`Sửa ${l.item}`}><Pencil className="h-3.5 w-3.5" /></button>
                  <button className="text-[#94A3B8] hover:text-[#F87171] disabled:opacity-40" disabled={!canEdit} onClick={() => update({ costLines: lines.filter((x) => x.id !== l.id) })} aria-label={`Xóa ${l.item}`}><Trash2 className="h-3.5 w-3.5" /></button>
                </td>
              </tr>
            ))}
            {lines.length > 0 && (
              <tr className="font-semibold">
                <td className="py-2 pl-4 pr-2" colSpan={2}>Tổng cộng</td>
                <td className={cn('px-2 py-2 text-right tabular-nums', sumApproved !== f.vendorApprovedBudget && 'text-[#F7B23B]')} title={sumApproved !== f.vendorApprovedBudget ? `Khác mức 3M duyệt ${vnd(f.vendorApprovedBudget)}` : undefined}>{compact(sumApproved)}</td>
                <td className="px-2 py-2 text-right tabular-nums">{compact(f.actualExecutionCost)}</td>
                <td className="px-2 py-2 text-right tabular-nums text-[#3DDBB6]">{compact(sumApproved - f.actualExecutionCost)}</td>
                <td />
              </tr>
            )}
          </tbody>
        </table>
      </div>
      {!lines.length && (
        <div className="mt-2 flex flex-wrap items-end gap-2">
          <Field label="Chi phí thực tế tổng (chưa tách theo nhà cung cấp)" className="min-w-[220px] flex-1"><MoneyInput disabled={!canEdit} value={claim.actualCost ?? 0} onChange={(n) => update({ actualCost: n })} /></Field>
        </div>
      )}
      {canEdit && (
        <div className="mt-3 grid grid-cols-2 gap-2 rounded bg-[#1C2534] p-3 sm:grid-cols-6">
          <input className={cn(inputCls, 'col-span-2 py-1.5 text-xs')} placeholder="Hạng mục chi" value={draft.item} onChange={(e) => setDraft({ ...draft, item: e.target.value })} />
          <input className={cn(inputCls, 'py-1.5 text-xs')} placeholder="Nhà cung cấp" value={draft.supplier} onChange={(e) => setDraft({ ...draft, supplier: e.target.value })} />
          <input className={cn(inputCls, 'py-1.5 text-xs tabular-nums')} inputMode="numeric" placeholder="Mức 3M duyệt" value={draft.approved ? new Intl.NumberFormat('vi-VN').format(draft.approved) : ''} onChange={(e) => setDraft({ ...draft, approved: digits(e.target.value) })} />
          <input className={cn(inputCls, 'py-1.5 text-xs tabular-nums')} inputMode="numeric" placeholder="Thực chi" value={draft.actual ? new Intl.NumberFormat('vi-VN').format(draft.actual) : ''} onChange={(e) => setDraft({ ...draft, actual: digits(e.target.value) })} />
          <div className="flex gap-1">
            <input className={cn(inputCls, 'min-w-0 py-1.5 text-xs')} placeholder="Số HĐ" value={draft.invoiceNo ?? ''} onChange={(e) => setDraft({ ...draft, invoiceNo: e.target.value })} />
            <button className={cn(btnPrimary, 'px-2 py-1 text-xs')} onClick={saveLine}>{editingId ? 'Lưu' : 'Thêm'}</button>
          </div>
        </div>
      )}

      {f.settlement === 'LUMP_SUM' && f.mdfMargin > 0 && (
        <fieldset className="mt-4">
          <legend className="mb-2 text-xs font-medium text-[#94A3B8]">Phân bổ thặng dư {compact(f.mdfMargin)}</legend>
          <div className="grid grid-cols-1 gap-2 sm:grid-cols-2">
            {(Object.keys(SURPLUS_LABEL) as SurplusAllocation[]).map((k) => (
              <label key={k} className={cn('flex cursor-pointer items-center gap-2 rounded border px-3 py-2.5 text-sm', claim.surplusAllocation === k ? 'border-[#00B894] bg-[#00B894]/10' : 'border-[#263044] hover:bg-[#1C2534]', !canEdit && 'cursor-not-allowed opacity-60')}>
                <input type="radio" name={`surplus-${claim.id}`} className="accent-[#00B894]" disabled={!canEdit} checked={claim.surplusAllocation === k} onChange={() => { update({ surplusAllocation: k }); notify(`Thặng dư ${claim.code}: ${SURPLUS_LABEL[k]}`, 'teal'); }} />
                {SURPLUS_LABEL[k]}
              </label>
            ))}
          </div>
        </fieldset>
      )}
      {f.settlement === 'ACTUAL_COST' && (
        <div className="mt-3 space-y-2 text-xs text-[#94A3B8]">
          <p>Hạng mục hoàn ứng theo chi phí thực tế: số claim tối đa bằng chi phí có hóa đơn, phần 3M duyệt chưa chi trả về quỹ, không ghi nhận lợi nhuận. Đổi hình thức quyết toán ở Cài đặt &gt; Quỹ Hãng 3M nếu hợp đồng với 3M là khoán.</p>
          {f.hasActual && claim.claimed > f.actualExecutionCost && !claim.submitted && (
            <button className={cn(btnGhost, btnSm)} disabled={!canEdit} onClick={() => { update({ claimed: f.actualExecutionCost }); notify(`Đã điều chỉnh số claim ${claim.code} bằng thực chi ${compact(f.actualExecutionCost)}`, 'teal'); }}>Điều chỉnh số claim bằng thực chi</button>
          )}
        </div>
      )}
    </section>
  );
}

/** KPI "Lợi nhuận ròng từ Quỹ MDF" và biểu đồ cơ cấu: 3M cấp -> thực chi -> thặng dư giữ lại */
function MdfMarginPanel() {
  const { claims } = useApp();
  const m = marginSummary(claims);
  const data = [
    { name: 'Tổng 3M duyệt', value: m.approved, color: C.blue },
    { name: 'Thực chi sự kiện', value: m.actual, color: C.orange },
    { name: 'Thặng dư giữ lại', value: m.margin, color: C.teal },
    { name: 'Hoàn lại quỹ', value: m.returned, color: C.muted },
  ];
  const tooltip = { contentStyle: { background: C.card, border: `1px solid ${C.line}`, borderRadius: 8, color: C.text }, labelStyle: { color: C.muted } };
  return (
    <div className="grid grid-cols-1 gap-4 xl:grid-cols-3">
      <div className="space-y-3">
        <StatCard label="Lợi nhuận quỹ" value={compact(m.margin)} icon={PiggyBank} color={C.teal} sub={`Biên thặng dư ${m.pct.toFixed(1).replace('.', ',')}% trên mức 3M duyệt, từ đầu năm`} />
        <div className="rounded-md border border-[#263044] bg-[#151C29] p-4 text-sm">
          <p className="mb-2 text-xs font-medium text-[#94A3B8]">Phân bổ thặng dư</p>
          {[
            [SURPLUS_LABEL.COMPANY_PROFIT, m.profit, C.teal],
            [SURPLUS_LABEL.REINVEST, m.reinvest, C.blue],
            ['Chờ phân bổ', m.pending, C.orange],
          ].map(([k, v, col]) => (
            <div key={k as string} className="mb-2 last:mb-0">
              <div className="mb-1 flex justify-between gap-2"><span className="text-[#94A3B8]">{k}</span><span className="tabular-nums">{compact(v as number)}</span></div>
              <ProgressBar value={v as number} max={m.margin || 1} tone={col as string} />
            </div>
          ))}
        </div>
      </div>
      <Panel title="Cơ cấu quỹ: 3M duyệt, thực chi, thặng dư" className="xl:col-span-2">
        <div className="h-60">
          <ResponsiveContainer width="100%" height="100%">
            <BarChart data={data} layout="vertical" margin={{ top: 4, right: 16, left: 8, bottom: 0 }}>
              <CartesianGrid stroke={C.line} strokeDasharray="3 3" horizontal={false} />
              <XAxis type="number" stroke={C.muted} tickLine={false} axisLine={false} fontSize={12} tickFormatter={(v) => compact(Number(v))} />
              <YAxis type="category" dataKey="name" stroke={C.muted} tickLine={false} axisLine={false} fontSize={12} width={120} />
              <Tooltip {...tooltip} formatter={(v) => vnd(Number(v))} cursor={{ fill: '#ffffff08' }} />
              <Bar dataKey="value" radius={[0, 4, 4, 0]}>{data.map((d) => <Cell key={d.name} fill={d.color} />)}</Bar>
            </BarChart>
          </ResponsiveContainer>
        </div>
        <p className="mt-2 text-xs text-[#94A3B8]">Chỉ tính hồ sơ đã nhập thực chi. Thặng dư chỉ phát sinh ở hạng mục khoán theo hoạt động; hạng mục hoàn ứng theo chi phí thực tế trả phần dư về quỹ.</p>
      </Panel>
    </div>
  );
}

// =====================================================================
//  TỔNG QUAN — 3 tab theo sơ đồ: Data MKT | Khách hàng & Dự án | Quỹ MDF
// =====================================================================

// =====================================================================
//  PHÂN TÍCH DỰ ĐOÁN (thống kê trong app, không gửi dữ liệu ra ngoài)
//  - Dự báo doanh thu 3 tháng: pipeline có trọng số theo tỷ lệ chốt lịch sử + phần doanh số từ lead chưa phát sinh
//  - Cảnh báo thông minh: rủi ro trễ SLA theo tải nhân sự, chi phí MDF bất thường, công nợ, tồn kho, hạn nộp claim...
// =====================================================================

type Insight = { id: string; tone: 'red' | 'orange' | 'blue'; title: string; detail: string; go?: Module; goLabel?: string };
type Forecast = {
  months: { key: string; label: string; actual?: number; forecast?: number; pipeline?: number; low?: number; high?: number }[];
  next3: number; low3: number; high3: number; winRate: number; cycleDays: number; runRate: number; openDeals: number; samples: number;
  confidence: 'Thấp' | 'Trung bình' | 'Cao';
};

const median = (xs: number[]) => { const a = xs.filter(Number.isFinite).sort((x, y) => x - y); return a.length ? (a.length % 2 ? a[(a.length - 1) / 2] : (a[a.length / 2 - 1] + a[a.length / 2]) / 2) : NaN; };
const monthLabel = (d: Date) => `T${d.getMonth() + 1}/${String(d.getFullYear()).slice(2)}`;

/** Lõi dự báo dùng chung cho thương mại (lead / BOQ) và xưởng (đơn công trình) */
function buildForecast(o: { history: number[]; deals: { value: number; p: number; etaMs: number }[]; won: number; lost: number; cycleDays: number }): Forecast {
  const now = new Date();
  const hist = o.history;
  const runRate = hist.slice(-3).reduce((a, b) => a + b, 0) / 3;
  const mean = hist.reduce((a, b) => a + b, 0) / (hist.length || 1);
  const sd = Math.sqrt(hist.reduce((a, b) => a + (b - mean) ** 2, 0) / (hist.length || 1));
  const months: Forecast['months'] = hist.map((v, i) => {
    const d = new Date(now.getFullYear(), now.getMonth() - (hist.length - 1 - i), 1);
    return { key: `h${i}`, label: monthLabel(d), actual: v };
  });
  let next3 = 0; let low3 = 0; let high3 = 0;
  for (let k = 1; k <= 3; k++) {
    const start = new Date(now.getFullYear(), now.getMonth() + k, 1).getTime();
    const end = new Date(now.getFullYear(), now.getMonth() + k + 1, 1).getTime();
    const pipe = o.deals.filter((d) => d.etaMs >= start && d.etaMs < end).reduce((a, d) => a + d.value * d.p, 0);
    // Lead chưa phát sinh chỉ kịp chốt khi khoảng cách tới tháng đó dài hơn chu kỳ bán hàng
    const fresh = Math.max(0, Math.min(1, ((end - Date.now()) / 864e5 - o.cycleDays) / 30));
    const f = pipe + runRate * fresh;
    const band = Math.max(sd, f * 0.2);
    next3 += f; low3 += Math.max(0, f - band); high3 += f + band;
    months.push({ key: `f${k}`, label: monthLabel(new Date(start)), forecast: Math.round(f), pipeline: Math.round(pipe), low: Math.max(0, Math.round(f - band)), high: Math.round(f + band) });
  }
  const samples = o.won + o.lost;
  return {
    months, next3, low3, high3, runRate, cycleDays: o.cycleDays, openDeals: o.deals.length, samples,
    winRate: (o.won + 1) / (samples + 2),
    confidence: samples >= 15 && hist.filter((x) => x > 0).length >= 4 ? 'Cao' : samples >= 5 ? 'Trung bình' : 'Thấp',
  };
}

function useInsights(): { forecast: Forecast; alerts: Insight[] } {
  const app = useApp();
  const { company, myLeads: leads, quotes, users, departments, budget, programs, claims, customers, skus, now, workOrders, receipts, mfgConfig, userName } = app;
  const { rows } = useMfgData();
  const t = now ?? Date.now();
  const mfg = bizMode(company) === 'MFG';
  const alerts: Insight[] = [];
  let forecast: Forecast;

  if (!mfg) {
    // ---------- Dự báo: thương mại ----------
    const won = leads.filter((l) => l.status === 'WON' && l.wonAt);
    const lost = leads.filter((l) => l.status === 'LOST');
    const rate = (won.length + 1) / (won.length + lost.length + 2);
    const cyc = median(won.map((l) => (isoMs(l.wonAt) - leadAt(l)) / 864e5).filter((x) => x > 0));
    const cycleDays = Number.isFinite(cyc) ? Math.max(7, cyc) : 45;
    const P: Partial<Record<LeadStatus, number>> = { QUOTED: Math.min(0.9, rate * 1.25), ACCEPTED: rate * 0.75, ASSIGNED: rate * 0.45, ROUTED: rate * 0.35, NEW: rate * 0.25, NURTURE: rate * 0.12 };
    const deals = leads.filter((l) => P[l.status] !== undefined).map((l) => {
      const age = (t - leadAt(l)) / 864e5;
      const lq = lastQuoteOf(l.id, quotes);
      const value = lq?.amount ?? boqTotal(l);
      const remain = l.status === 'QUOTED' ? Math.max(7, cycleDays * 0.35) : Math.max(10, cycleDays - age);
      return { value, p: P[l.status] ?? 0, etaMs: t + remain * 864e5 };
    }).filter((d) => d.value > 0);
    forecast = buildForecast({ history: monthly(won, (l) => l.wonAt, (l) => l.wonAmount ?? boqTotal(l)), deals, won: won.length, lost: lost.length, cycleDays });

    // ---------- Cảnh báo: SLA theo tải nhân sự ----------
    const open = leads.filter((l) => ['ASSIGNED', 'ACCEPTED', 'QUOTED'].includes(l.status));
    departments.filter((d) => d.active && d.receivesLeads).forEach((d) => {
      const reps = users.filter((u) => u.active && u.dept === d.code && (u.role === 'SALES_REP' || u.role === 'DEPT_HEAD'));
      const inDept = open.filter((l) => l.dept === d.code);
      const risk = inDept.filter((l) => (l.status === 'ASSIGNED' && l.slaDeadline && l.slaDeadline - t < 2 * 3.6e6) || (l.status === 'ACCEPTED' && l.quoteDeadline && l.quoteDeadline - t < 12 * 3.6e6));
      const waiting = leads.filter((l) => l.dept === d.code && l.status === 'ROUTED');
      const load = reps.length ? (inDept.length + waiting.length) / reps.length : inDept.length + waiting.length;
      if (risk.length || (waiting.length && !reps.length)) {
        const overdue = risk.filter((l) => (l.status === 'ASSIGNED' ? l.slaDeadline! < t : l.quoteDeadline! < t)).length;
        alerts.push({ id: `sla-${d.code}`, tone: overdue ? 'red' : 'orange', title: `Có ${risk.length || waiting.length} dự án khả năng cao trễ SLA ở ${d.short}`, detail: `${overdue ? `${overdue} đã quá hạn. ` : ''}Tải trung bình ${load.toFixed(1).replace('.', ',')} việc / người (${reps.length} nhân sự)${reps.length < 2 ? ', thiếu nhân sự dự phòng' : ''}.`, go: 'projects', goLabel: 'Xem dự án' });
      }
    });
    // Nhân sự ôm quá nhiều việc
    const byRep = new Map<string, number>();
    open.forEach((l) => { if (l.assignee) byRep.set(l.assignee, (byRep.get(l.assignee) ?? 0) + 1); });
    const avg = byRep.size ? [...byRep.values()].reduce((a, b) => a + b, 0) / byRep.size : 0;
    [...byRep.entries()].filter(([, n]) => n >= 4 && n > avg * 1.5).forEach(([id, n]) => alerts.push({ id: `load-${id}`, tone: 'orange', title: `${userName(id)} đang xử lý ${n} dự án`, detail: `Cao hơn ${Math.round((n / avg - 1) * 100)}% mức trung bình của nhóm (${avg.toFixed(1).replace('.', ',')}). Cân nhắc chia lại để không trễ báo giá.`, go: 'projects', goLabel: 'Phân lại' }));

    // ---------- Cảnh báo: chi phí MDF bất thường ----------
    const spendSeries = monthly([...programs.map((p) => ({ at: p.start, v: p.held || p.requested })), ...claims.filter((c) => c.invoice).map((c) => ({ at: c.invoice!.date, v: c.actualCost ?? c.invoice!.amount }))], (x) => x.at, (x) => x.v, 4);
    const cur = spendSeries[3];
    const base = (spendSeries[0] + spendSeries[1] + spendSeries[2]) / 3;
    if (base > 0 && cur > base * 1.2) alerts.push({ id: 'mdf-spike', tone: 'orange', title: `Chi phí MDF tháng này đang tăng bất thường ${Math.round((cur / base - 1) * 100)}%`, detail: `${compact(cur)} so với trung bình ${compact(base)} / tháng của 3 tháng trước. Rà soát các chương trình mới giữ chỗ.`, go: 'claims', goLabel: 'Xem hồ sơ MDF' });
    // Tốc độ giải ngân so với thời gian trong năm tài chính
    if (budget.total > 0 && new Date(t).getFullYear() === budget.fiscalYear) {
      const yStart = new Date(budget.fiscalYear, 0, 1).getTime();
      const elapsed = (t - yStart) / (365 * 864e5);
      const used = (budget.spent + budget.committed) / budget.total;
      if (used > elapsed + 0.15) alerts.push({ id: 'mdf-fast', tone: 'orange', title: `Quỹ 3M giải ngân nhanh hơn kế hoạch`, detail: `Đã dùng + giữ chỗ ${Math.round(used * 100)}% quỹ khi năm mới qua ${Math.round(elapsed * 100)}%.`, go: 'claims', goLabel: 'Xem quỹ' });
      else if (elapsed > 0.5 && used < elapsed - 0.3) alerts.push({ id: 'mdf-slow', tone: 'blue', title: `Quỹ 3M đang giải ngân chậm`, detail: `Mới dùng ${Math.round(used * 100)}% quỹ khi năm đã qua ${Math.round(elapsed * 100)}%: nguy cơ không dùng hết ngân sách Hãng cấp.`, go: 'claims', goLabel: 'Lập chương trình' });
    }
    // Claim sắp hết hạn nộp Hãng
    const due = claims.filter((c) => !c.submitted && c.daysLeft <= 7);
    if (due.length) alerts.push({ id: 'claim-due', tone: due.some((c) => c.daysLeft <= 2) ? 'red' : 'orange', title: `${due.length} hồ sơ claim sắp hết hạn nộp Hãng`, detail: due.slice(0, 3).map((c) => `${c.code} (còn ${c.daysLeft} ngày)`).join(', '), go: 'claims', goLabel: 'Nộp hồ sơ' });
    // Tồn kho dưới định mức
    const low = skus.filter((x) => x.stock < x.minStock);
    if (low.length) alerts.push({ id: 'stock-low', tone: 'orange', title: `${low.length} SKU dưới tồn tối thiểu`, detail: `${low.slice(0, 3).map((x) => x.sku).join(', ')}${low.length > 3 ? '…' : ''}. Lead-time đặt Hãng ${Math.max(...low.map((x) => x.leadTimeDays))} ngày, nên lập PO sớm.`, go: 'supply', goLabel: 'Tạo PO' });
    // Pipeline tháng tới mỏng so với nhịp doanh số
    const nextM = forecast.months.find((m) => m.key === 'f1');
    if (nextM && forecast.runRate > 0 && (nextM.forecast ?? 0) < forecast.runRate * 0.7) alerts.push({ id: 'pipe-thin', tone: 'blue', title: 'Pipeline tháng tới mỏng', detail: `Dự báo ${compact(nextM.forecast ?? 0)}, thấp hơn 30% nhịp trung bình ${compact(forecast.runRate)} / tháng. Đẩy nhanh báo giá các dự án đang khảo sát.`, go: 'leads', goLabel: 'Xem lead' });
  } else {
    // ---------- Dự báo: xưởng ----------
    const won = rows.filter((r) => r.j.wonAt);
    const lost = rows.filter((r) => r.j.lostAt && !r.j.wonAt);
    const rate = (won.length + 1) / (won.length + lost.length + 2);
    const cyc = median(won.map((r) => (isoMs(r.j.wonAt) - isoMs(r.j.createdAt)) / 864e5).filter((x) => x > 0));
    const cycleDays = Number.isFinite(cyc) ? Math.max(5, cyc) : 21;
    const deals = rows.filter((r) => !r.j.wonAt && !r.j.lostAt).map((r) => {
      const q = r.j.quotes[r.j.quotes.length - 1]?.total ?? 0;
      const age = (t - isoMs(r.j.createdAt)) / 864e5;
      return { value: q, p: q ? Math.min(0.9, rate * 1.2) : rate * 0.4, etaMs: t + Math.max(5, cycleDays - age) * 864e5 };
    }).filter((d) => d.value > 0);
    forecast = buildForecast({ history: monthly(won, (r) => r.j.wonAt, (r) => r.money.value), deals, won: won.length, lost: lost.length, cycleDays });
    const lateHold = receipts.filter((r) => holdingOverdue(r, t, mfgConfig.submitHours));
    if (lateHold.length) alerts.push({ id: 'hold', tone: 'red', title: `${lateHold.length} khoản tiền mặt chưa nộp quỹ đúng hạn`, detail: `Tổng ${compact(lateHold.reduce((a, r) => a + r.amount, 0))}, quá ${mfgConfig.submitHours} giờ kể từ lúc thu.`, go: 'tasks', goLabel: 'Đối chiếu' });
    const late = workOrders.filter(woLate);
    if (late.length) alerts.push({ id: 'wo-late', tone: 'orange', title: `${late.length} lệnh sản xuất trễ hạn`, detail: 'Có nguy cơ lùi lịch lắp đặt đã hẹn với khách.', go: 'production', goLabel: 'Xem xưởng' });
    const missSurvey = rows.filter((r) => r.stage === 'SURVEY' && r.j.appointmentAt && isoMs(r.j.appointmentAt) < t - 3.6e6);
    if (missSurvey.length) alerts.push({ id: 'survey', tone: 'orange', title: `${missSurvey.length} lịch khảo sát đã quá giờ hẹn chưa cập nhật`, detail: 'Nhắc kỹ thuật check-in, chụp ảnh hiện trạng để kịp báo giá.', go: 'leads', goLabel: 'Xem lead' });
    const wait = rows.filter((r) => r.stage === 'WAIT_PAYMENT');
    if (wait.length) alerts.push({ id: 'pay', tone: 'red', title: `${wait.length} công trình đã nghiệm thu chưa thu đủ tiền`, detail: `Còn ${compact(wait.reduce((a, r) => a + (r.money.remaining || r.money.receivable), 0))} phải thu.`, go: 'jobs', goLabel: 'Thu tiền' });
  }
  // ---------- Công nợ (dùng chung) ----------
  const over = customers.filter((c) => c.creditLimit > 0 && c.debt > c.creditLimit * 0.9);
  if (over.length) alerts.push({ id: 'debt', tone: over.some((c) => c.debt > c.creditLimit) ? 'red' : 'orange', title: `${over.length} khách sát / vượt hạn mức công nợ`, detail: over.slice(0, 3).map((c) => `${c.name} ${Math.round((c.debt / c.creditLimit) * 100)}%`).join(', '), go: 'reports', goLabel: 'Xem công nợ' });
  const order = { red: 0, orange: 1, blue: 2 };
  return { forecast, alerts: alerts.sort((a, b) => order[a.tone] - order[b.tone]) };
}

/** Widget: dự báo doanh thu 3 tháng tới (cột thực tế + cột dự báo có khoảng tin cậy) */
function ForecastWidget() {
  const { forecast: f } = useInsights();
  const max = Math.max(1, ...f.months.map((m) => Math.max(m.actual ?? 0, m.high ?? 0)));
  return (
    <div className="space-y-4">
      <div className="flex flex-wrap items-end gap-x-8 gap-y-3">
        <div>
          <p className="text-xs uppercase tracking-wide text-[#94A3B8]">Dự báo 3 tháng tới</p>
          <p className="font-display g-brand-text text-3xl font-extrabold tabular-nums">{compact(f.next3)}</p>
          <p className="text-xs text-[#94A3B8]">Khoảng {compact(f.low3)} – {compact(f.high3)}</p>
        </div>
        <dl className="grid grid-cols-3 gap-x-6 gap-y-1 text-xs">
          <dt className="text-[#94A3B8]">Tỷ lệ chốt</dt><dt className="text-[#94A3B8]">Chu kỳ chốt</dt><dt className="text-[#94A3B8]">Độ tin cậy</dt>
          <dd className="font-num text-sm text-[#F1F5F9]">{Math.round(f.winRate * 100)}%</dd><dd className="font-num text-sm text-[#F1F5F9]">{Math.round(f.cycleDays)} ngày</dd>
          <dd><Chip tone={f.confidence === 'Cao' ? 'teal' : f.confidence === 'Trung bình' ? 'orange' : 'muted'}>{f.confidence}</Chip></dd>
        </dl>
      </div>
      <div className="flex h-44 gap-2" role="img" aria-label={`Doanh số 6 tháng qua và dự báo 3 tháng tới, tổng dự báo ${compact(f.next3)}`}>
        {f.months.map((m) => {
          const isF = m.forecast !== undefined;
          const v = isF ? m.forecast ?? 0 : m.actual ?? 0;
          return (
            <div key={m.key} className="flex h-full min-w-0 flex-1 flex-col items-center justify-end gap-1.5" title={isF ? `${m.label}: dự báo ${compact(v)} (từ pipeline ${compact(m.pipeline ?? 0)}, khoảng ${compact(m.low ?? 0)} – ${compact(m.high ?? 0)})` : `${m.label}: thực tế ${compact(v)}`}>
              <span className="font-num text-[10px] text-[#94A3B8]">{v ? compact(v).replace(' ', '') : ''}</span>
              <div className="relative flex min-h-0 w-full max-w-[44px] flex-1 items-end">
                {isF && <div className="absolute inset-x-0 rounded-sm border border-dashed border-[#F28C33]/50" style={{ bottom: `${((m.low ?? 0) / max) * 100}%`, height: `${(((m.high ?? 0) - (m.low ?? 0)) / max) * 100}%` }} />}
                <div className={cn('w-full rounded-t-sm', isF ? 'g-brand opacity-90' : 'bg-[#0B5FB8]')} style={{ height: `${Math.max(2, (v / max) * 100)}%` }} />
              </div>
              <span className={cn('text-[11px]', isF ? 'font-semibold text-[#F7B23B]' : 'text-[#94A3B8]')}>{m.label}</span>
            </div>
          );
        })}
      </div>
      <p className="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-[#7C8796]">
        <span className="flex items-center gap-1.5"><i className="h-2.5 w-2.5 rounded-sm bg-[#0B5FB8]" />Thực tế (chốt đơn)</span>
        <span className="flex items-center gap-1.5"><i className="g-brand h-2.5 w-2.5 rounded-sm" />Dự báo</span>
        <span className="flex items-center gap-1.5"><i className="h-2.5 w-2.5 rounded-sm border border-dashed border-[#F28C33]/60" />Khoảng dao động</span>
        <span>Từ {f.openDeals} cơ hội đang mở × tỷ lệ chốt theo giai đoạn, cộng phần lead mới ước theo trung bình 3 tháng ({compact(f.runRate)}/tháng); {f.samples} đơn chốt / trượt làm mẫu.</span>
      </p>
    </div>
  );
}

/** Widget: cảnh báo thông minh */
function AlertsWidget({ limit = 6 }: { limit?: number }) {
  const { go } = useApp();
  const { alerts } = useInsights();
  const [all, setAll] = useState(false);
  if (!alerts.length) return <EmptyState text={<>Không có rủi ro nổi bật</>} hint={<>Hệ thống theo dõi SLA, tải nhân sự, chi phí MDF, công nợ, tồn kho và hạn nộp claim.</>} art="inbox" compact />;
  const shown = all ? alerts : alerts.slice(0, limit);
  const tone = { red: 'border-[#EF4444] bg-[#EF4444]/[0.07]', orange: 'border-[#F28C33] bg-[#F28C33]/[0.06]', blue: 'border-[#0B5FB8] bg-[#0B5FB8]/[0.08]' };
  const icon = { red: 'text-[#F87171]', orange: 'text-[#F7B23B]', blue: 'text-[#6FA8F0]' };
  return (
    <ul className="space-y-2">
      {shown.map((a) => (
        <li key={a.id} className={cn('flex items-start gap-3 rounded border-l-2 px-3 py-2.5', tone[a.tone])}>
          <AlertTriangle className={cn('mt-0.5 h-4 w-4 shrink-0', icon[a.tone])} aria-hidden />
          <div className="min-w-0 flex-1"><p className="text-sm font-semibold text-[#F1F5F9]">{a.title}</p><p className="mt-0.5 text-xs text-[#94A3B8]">{a.detail}</p></div>
          {a.go && <button className={cn(btnGhost, btnSm, 'shrink-0')} onClick={() => go(a.go!)}>{a.goLabel ?? 'Xem'}<ArrowRight className="h-3.5 w-3.5" aria-hidden /></button>}
        </li>
      ))}
      {alerts.length > limit && <li><button className="text-xs text-[#6FA8F0] hover:underline" onClick={() => setAll((v) => !v)}>{all ? 'Thu gọn' : `Xem thêm ${alerts.length - limit} cảnh báo`}</button></li>}
    </ul>
  );
}

/** Widget: hàng KPI tổng (theo kiểu vận hành) */
function KpiWidget() {
  const { company, myLeads: leads, customers, quotes } = useApp();
  const { rows } = useMfgData();
  const { forecast } = useInsights();
  if (bizMode(company) === 'MFG') {
    const won = rows.filter((r) => r.j.wonAt);
    return (
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="HĐ ký 6 tháng" value={compact(won.filter((r) => isoMs(r.j.wonAt) > Date.now() - 183 * 864e5).reduce((a, r) => a + r.money.value, 0))} icon={TrendingUp} color={C.orange} highlight spark={monthly(won, (r) => r.j.wonAt, (r) => r.money.value)} />
        <StatCard label="Lead mới" value={String(rows.filter((r) => isoMs(r.j.createdAt) > Date.now() - 30 * 864e5).length)} sub="30 ngày qua" icon={Inbox} color={C.blue} spark={monthly(rows, (r) => r.j.createdAt)} />
        <StatCard label="Còn phải thu" value={compact(rows.filter((r) => r.j.wonAt && !r.j.lostAt).reduce((a, r) => a + r.money.receivable, 0))} icon={Banknote} color={C.red} />
        <StatCard label="Dự báo 3 tháng" value={compact(forecast.next3)} sub={`Độ tin cậy ${forecast.confidence.toLowerCase()}`} icon={Sparkles} color={C.teal} />
      </div>
    );
  }
  const won = leads.filter((l) => l.status === 'WON' && l.wonAt);
  const open = leads.filter((l) => !['WON', 'LOST'].includes(l.status));
  return (
    <div className={kpiGrid('lg:grid-cols-4')}>
      <StatCard label="Doanh số chốt 6 tháng" value={compact(won.filter((l) => isoMs(l.wonAt) > Date.now() - 183 * 864e5).reduce((a, l) => a + (l.wonAmount ?? boqTotal(l)), 0))} icon={TrendingUp} color={C.orange} highlight spark={monthly(won, (l) => l.wonAt, (l) => l.wonAmount ?? boqTotal(l))} />
      <StatCard label="Pipeline đang mở" value={compact(open.reduce((a, l) => a + boqTotal(l), 0))} sub={`${open.length} cơ hội`} icon={FolderKanban} color={C.blue} spark={monthly(open, leadAt, (l) => boqTotal(l))} />
      <StatCard label="Báo giá đã gửi" value={compact(quotes.reduce((a, q) => a + q.amount, 0))} sub={`${quotes.length} phiên bản, ${customers.length} khách`} icon={FileText} color="#8B5CF6" spark={monthly(quotes, (q) => q.date, (q) => q.amount)} />
      <StatCard label="Dự báo 3 tháng" value={compact(forecast.next3)} sub={`Độ tin cậy ${forecast.confidence.toLowerCase()}`} icon={Sparkles} color={C.teal} />
    </div>
  );
}

/** Widget: phễu chuyển đổi tương tác — bấm một tầng để xem danh sách và mở nhanh từng hồ sơ */
function FunnelWidget() {
  const { company, myLeads: leads, go, openJob, customers } = useApp();
  const { rows } = useMfgData();
  const [sel, setSel] = useState<number | null>(null);
  type Rec = { key: string; title: string; sub: string; value: number; open: () => void };
  const L = (xs: Lead[]): Rec[] => xs.map((l) => ({ key: l.id, title: l.company, sub: `${l.code} · ${LEAD_STATUS[l.status].label}`, value: boqTotal(l), open: () => go(['ACCEPTED', 'QUOTED', 'WON', 'LOST'].includes(l.status) ? 'projects' : 'leads', l.code) }));
  const J = (xs: typeof rows): Rec[] => xs.map((r) => ({ key: r.j.id, title: jobCustName(r.j, customers), sub: `${r.j.code} · ${JOB_STAGE[r.stage].label}`, value: r.money.value || (r.j.quotes[r.j.quotes.length - 1]?.total ?? 0), open: () => openJob(r.j.id) }));
  const steps: [string, Rec[]][] = bizMode(company) === 'MFG'
    ? [['Lead', J(rows)], ['Đã khảo sát', J(rows.filter((r) => r.j.quotes.length || r.j.surveyCheckins.length || r.j.files.length))], ['Đã báo giá', J(rows.filter((r) => r.j.quotes.length))], ['Chốt, nhận cọc', J(rows.filter((r) => r.j.wonAt))]]
    : [['Lead nhận', L(leads)], ['Đã phân phòng', L(leads.filter((l) => l.status !== 'NEW' && l.status !== 'NURTURE'))], ['Sales tiếp nhận', L(leads.filter((l) => ['ACCEPTED', 'QUOTED', 'WON', 'LOST'].includes(l.status)))], ['Đã báo giá', L(leads.filter((l) => ['QUOTED', 'WON', 'LOST'].includes(l.status)))], ['Chốt đơn', L(leads.filter((l) => l.status === 'WON'))]];
  const max = Math.max(1, steps[0][1].length);
  const cur = sel !== null ? steps[sel] : null;
  return (
    <div className="space-y-3">
      <ol className="space-y-1.5">
        {steps.map(([label, recs], i) => {
          const n = recs.length;
          const prev = i > 0 ? steps[i - 1][1].length : 0;
          return (
            <li key={label}>
              <button className={cn('group w-full rounded px-2 py-1.5 text-left transition-colors', sel === i ? 'bg-[#0B5FB8]/20 ring-1 ring-[#0B5FB8]/60' : 'hover:bg-white/[0.04]')} onClick={() => setSel(sel === i ? null : i)} aria-expanded={sel === i} title={`${label}: ${n} — bấm để xem danh sách`}>
                <div className="mb-1 flex items-baseline justify-between text-xs"><span className="text-[#CBD5E1] group-hover:text-white">{label}</span><span className="font-num text-[#F1F5F9]">{n}{i > 0 && prev ? <span className="ml-2 text-[#94A3B8]">{Math.round((n / prev) * 100)}%</span> : null}</span></div>
                <div className="mx-auto h-2.5 overflow-hidden rounded-full bg-white/[0.05]" style={{ width: `${100 - i * 6}%` }}><div className={cn('h-full rounded-full transition-[width] duration-500', i === steps.length - 1 ? 'g-brand' : 'bg-[#0B5FB8]')} style={{ width: `${(n / max) * 100}%` }} /></div>
              </button>
            </li>
          );
        })}
      </ol>
      {cur && (
        <div className="rounded border border-white/[0.06] bg-white/[0.02] p-2 motion-safe:animate-[popIn_.14s_ease-out]">
          <p className="mb-1 flex items-center justify-between px-1 text-[11px] text-[#94A3B8]"><span>{cur[0]} · {cur[1].length} hồ sơ · {compact(cur[1].reduce((a, r) => a + r.value, 0))}</span><button className="hover:text-white" onClick={() => setSel(null)} aria-label="Đóng danh sách"><X className="h-3.5 w-3.5" /></button></p>
          <ul className="max-h-48 overflow-y-auto">
            {cur[1].slice(0, 30).map((r) => <li key={r.key}><button className="flex w-full items-center gap-2 rounded px-1.5 py-1 text-left text-xs hover:bg-[#0B5FB8]/15" onClick={r.open}><span className="min-w-0 flex-1"><span className="block truncate text-[#E2E8F0]">{r.title}</span><span className="block truncate text-[10px] text-[#7C8796]">{r.sub}</span></span><span className="font-num shrink-0 text-[#CBD5E1]">{r.value ? compact(r.value) : ''}</span></button></li>)}
            {!cur[1].length && <li className="px-1.5 py-2 text-xs text-[#7C8796]">Không có hồ sơ ở tầng này.</li>}
          </ul>
        </div>
      )}
    </div>
  );
}

/** Widget: bình luận nhắc tên tôi gần đây */
function MentionsWidget() {
  const { comments, me, userName, go } = useApp();
  const mine = comments.filter((c) => me && (c.mentions.includes(me.id) || c.authorId === me.id)).sort((a, b) => b.at - a.at).slice(0, 6);
  if (!mine.length) return <EmptyState text={<>Chưa có trao đổi nào nhắc bạn</>} hint={<>Bấm biểu tượng bình luận trên dòng bảng (lead, dự án, khách hàng, PO, đơn xưởng) và gõ @ để nhắc đồng nghiệp.</>} art="inbox" compact />;
  return (
    <ul className="divide-y divide-white/[0.06]">
      {mine.map((c) => (
        <li key={c.id}>
          <div role="button" tabIndex={0} className="flex w-full cursor-pointer items-start gap-3 py-2.5 text-left hover:bg-white/[0.03]" onClick={() => go(c.module)} onKeyDown={(e) => { if (e.key === 'Enter') go(c.module); }}>
            <Avatar name={userName(c.authorId)} size={28} />
            <span className="min-w-0 flex-1"><span className="block text-xs text-[#94A3B8]"><b className="text-[#F1F5F9]">{userName(c.authorId)}</b> · {MODULE_LABEL[c.module]} · {new Date(c.at).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' })}</span><span className="line-clamp-2 text-sm text-[#E2E8F0]"><MentionText text={c.text} /></span></span>
          </div>
        </li>
      ))}
    </ul>
  );
}

// =====================================================================
//  BẢNG ĐIỀU KHIỂN CÁ NHÂN HÓA: kéo-thả sắp xếp, ẩn / hiện, đổi kích thước widget (lưu theo người dùng)
// =====================================================================

type WidgetDef = { id: string; title: string; node: ReactNode; size: 4 | 6 | 8 | 12 };
type WidgetPref = { id: string; size: 4 | 6 | 8 | 12; hidden?: boolean };
const SIZE_CLS: Record<WidgetPref['size'], string> = { 4: 'lg:col-span-4', 6: 'lg:col-span-6', 8: 'lg:col-span-8', 12: 'lg:col-span-12' };
const SIZE_LABEL: Record<WidgetPref['size'], string> = { 4: '1/3', 6: '1/2', 8: '2/3', 12: 'Rộng' };

function WidgetBoard({ widgets, storeKey, canEdit }: { widgets: WidgetDef[]; storeKey: string; canEdit: boolean }) {
  const defaults: WidgetPref[] = widgets.map((w) => ({ id: w.id, size: w.size }));
  const [prefs, setPrefs] = useState<WidgetPref[]>(defaults);
  const [edit, setEdit] = useState(false);
  const [drag, setDrag] = useState<string | null>(null);
  const [over, setOver] = useState<string | null>(null);
  useEffect(() => {
    try {
      const v = JSON.parse(localStorage.getItem(storeKey) ?? 'null') as WidgetPref[] | null;
      if (Array.isArray(v)) setPrefs([...v.filter((p) => widgets.some((w) => w.id === p.id)), ...defaults.filter((d) => !v.some((p) => p.id === d.id))]);
    } catch { /* bỏ qua */ }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [storeKey]);
  const save = (next: WidgetPref[]) => { setPrefs(next); try { localStorage.setItem(storeKey, JSON.stringify(next)); } catch { /* bỏ qua */ } };
  const move = (from: string, to: string) => {
    if (from === to) return;
    const a = [...prefs];
    const i = a.findIndex((p) => p.id === from);
    const [x] = a.splice(i, 1);
    a.splice(a.findIndex((p) => p.id === to), 0, x);
    save(a);
  };
  const shift = (id: string, d: -1 | 1) => {
    const vis = prefs.filter((p) => !p.hidden);
    const i = vis.findIndex((p) => p.id === id);
    const j = vis[i + d];
    if (j) move(id, j.id);
  };
  const visible = prefs.filter((p) => !p.hidden);
  const hidden = prefs.filter((p) => p.hidden);
  return (
    <div className="space-y-3">
      {canEdit && (
        <div className="flex flex-wrap items-center gap-2">
          {edit && <p className="mr-auto text-xs text-[#94A3B8]">Kéo thẻ để sắp xếp (hoặc dùng mũi tên), chọn kích thước, ẩn widget không cần. Lưu riêng cho bạn trên trình duyệt này.</p>}
          {edit && hidden.length > 0 && hidden.map((p) => (
            <button key={p.id} className={cn(btnGhost, btnSm, 'border-dashed')} onClick={() => save(prefs.map((x) => (x.id === p.id ? { ...x, hidden: false } : x)))}><Plus className="h-3.5 w-3.5" aria-hidden />{widgets.find((w) => w.id === p.id)?.title}</button>
          ))}
          {edit && <button className={cn(btnGhost, btnSm)} onClick={() => save(defaults)}><RefreshCw className="h-3.5 w-3.5" aria-hidden />Mặc định</button>}
          <button className={cn(edit ? btnPrimary : btnGhost, btnSm, !edit && 'ml-auto')} onClick={() => setEdit((v) => !v)} aria-pressed={edit}><SlidersHorizontal className="h-3.5 w-3.5" aria-hidden />{edit ? 'Xong' : 'Tùy chỉnh bảng điều khiển'}</button>
        </div>
      )}
      <div className="grid grid-cols-1 gap-4 lg:grid-cols-12">
        {visible.map((p, idx) => {
          const w = widgets.find((x) => x.id === p.id);
          if (!w) return null;
          return (
            <section
              key={p.id}
              className={cn('glass-card min-w-0 rounded-md p-5 transition-[border-color,opacity,box-shadow]', SIZE_CLS[p.size], edit && '!border-dashed !border-[#0B5FB8]/60', drag === p.id && 'opacity-40', over === p.id && drag !== p.id && 'shadow-[0_0_0_2px_#F28C33]')}
              draggable={edit}
              onDragStart={(e) => { setDrag(p.id); e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', p.id); }}
              onDragOver={(e) => { if (!edit || !drag) return; e.preventDefault(); setOver(p.id); }}
              onDragLeave={() => setOver((o) => (o === p.id ? null : o))}
              onDrop={(e) => { e.preventDefault(); if (drag) move(drag, p.id); setDrag(null); setOver(null); }}
              onDragEnd={() => { setDrag(null); setOver(null); }}
              aria-label={w.title}
            >
              <header className="mb-4 flex flex-wrap items-center gap-2">
                {edit && <GripVertical className="h-4 w-4 cursor-grab text-[#6FA8F0]" aria-hidden />}
                <h2 className="font-display mr-auto text-[15px] font-bold tracking-tight">{w.title}</h2>
                {edit && (
                  <div className="flex items-center gap-1">
                    <button className="rounded p-1 text-[#94A3B8] hover:bg-white/10 disabled:opacity-30" disabled={idx === 0} onClick={() => shift(p.id, -1)} aria-label={`Đưa ${w.title} lên trước`}><ArrowUp className="h-3.5 w-3.5" /></button>
                    <button className="rounded p-1 text-[#94A3B8] hover:bg-white/10 disabled:opacity-30" disabled={idx === visible.length - 1} onClick={() => shift(p.id, 1)} aria-label={`Đưa ${w.title} ra sau`}><ArrowDown className="h-3.5 w-3.5" /></button>
                    <div className="flex rounded border border-white/10 p-0.5" role="radiogroup" aria-label="Kích thước">
                      {([4, 6, 8, 12] as const).map((z) => <button key={z} role="radio" aria-checked={p.size === z} className={cn('rounded-sm px-1.5 py-0.5 text-[10px] font-semibold', p.size === z ? 'g-brand text-[#0F141E]' : 'text-[#94A3B8] hover:text-white')} onClick={() => save(prefs.map((x) => (x.id === p.id ? { ...x, size: z } : x)))}>{SIZE_LABEL[z]}</button>)}
                    </div>
                    <button className="rounded p-1 text-[#94A3B8] hover:bg-white/10 hover:text-white" onClick={() => save(prefs.map((x) => (x.id === p.id ? { ...x, hidden: true } : x)))} aria-label={`Ẩn ${w.title}`}><EyeOff className="h-3.5 w-3.5" /></button>
                  </div>
                )}
              </header>
              {w.node}
            </section>
          );
        })}
      </div>
      {!visible.length && <EmptyState text={<>Bạn đã ẩn hết widget</>} hint={<>Bấm các nút “+” phía trên để hiện lại, hoặc khôi phục bố cục mặc định.</>} art="box" action="Khôi phục mặc định" onAction={() => save(defaults)} />}
    </div>
  );
}

/** Trang "Bảng điều khiển" đầu tiên của Tổng quan: KPI, dự báo, cảnh báo, phễu, trao đổi, + module chuyên sâu theo kiểu vận hành */
function CommandCenter() {
  const { me, role, org, company } = useApp();
  const orgId = org.id;
  const mfg = bizMode(company) === 'MFG';
  const widgets: WidgetDef[] = [
    { id: 'kpi', title: 'Chỉ số chính', node: <KpiWidget />, size: 12 },
    { id: 'forecast', title: 'Dự báo doanh thu', node: <ForecastWidget />, size: 8 },
    { id: 'alerts', title: 'Cảnh báo thông minh', node: <AlertsWidget />, size: 4 },
    { id: 'funnel', title: 'Phễu chuyển đổi', node: <FunnelWidget />, size: 4 },
    { id: 'mentions', title: 'Trao đổi nhắc tên tôi', node: <MentionsWidget />, size: 8 },
    ...(!mfg ? [{ id: 'mdf', title: 'Quỹ MDF 3M', node: <MdfOverview />, size: 12 as const }] : []),
  ];
  return <WidgetBoard widgets={widgets} storeKey={`3a:ui:board:${orgId}:${me?.id ?? 'x'}`} canEdit={role === 'BOD' || role === 'DEPT_HEAD' || role === 'MKT_LEAD'} />;
}

// =====================================================================
//  COMMUNICATION & AI HUB (cột phải): Chat nội bộ theo ngữ cảnh + AI Copilot
//  AI Copilot = bộ phân tích thống kê chạy ngay trong app trên dữ liệu đang xem (không gửi dữ liệu ra ngoài).
// =====================================================================

type AiItem = { title: string; detail?: string; tone?: 'red' | 'orange' | 'blue' | 'teal'; action?: { label: string; run: () => void } };
type AiMsg = { id: string; role: 'user' | 'ai'; text: string; kpis?: { label: string; value: string; tone?: 'red' | 'teal' }[]; items?: AiItem[]; chips?: string[]; note?: string };
const AI_STARTERS = ['Tóm tắt việc cần làm hôm nay', 'Dự án nào có rủi ro trễ SLA?', 'Dự báo dòng tiền 3 tháng tới', 'Gợi ý chương trình kích cầu quỹ MDF', 'Khách nào sắp vượt hạn mức công nợ?'];

function useCopilot(): (q: string) => AiMsg {
  const app = useApp();
  const { company, myLeads: leads, myCustomers: customers, users, budget, programs, categories, cashEntries, mfgConfig, canDo, go, openCustomer, openProgramForm, userName, segments, now } = app;
  const { forecast, alerts } = useInsights();
  const { todo } = useApprovalQueue();
  const { rows } = useMfgData();
  const cmds = useCommandItems();
  const mfg = bizMode(company) === 'MFG';
  const t = now ?? Date.now();
  const id = () => uid('ai');
  const has = (q: string, ...k: string[]) => k.some((x) => q.includes(x));
  const openLead = (l: Lead) => () => go(['ACCEPTED', 'QUOTED', 'WON', 'LOST'].includes(l.status) ? 'projects' : 'leads', l.code);
  const toneOf = (a: Insight['tone']): AiItem['tone'] => a;
  const dur = (ms: number) => { const h = Math.abs(ms) / 3.6e6; return h < 24 ? `${Math.max(1, Math.round(h))} giờ` : `${Math.round(h / 24)} ngày`; };

  const sla = (): AiMsg => {
    const open = leads.filter((l) => ['ASSIGNED', 'ACCEPTED', 'QUOTED'].includes(l.status));
    const load = (uidv?: string) => open.filter((l) => l.assignee === uidv).length;
    const risk = open.map((l) => {
      const dl = l.status === 'ASSIGNED' ? l.slaDeadline : l.status === 'ACCEPTED' ? l.quoteDeadline : undefined;
      return { l, dl, kind: l.status === 'ASSIGNED' ? 'tiếp nhận' : 'báo giá' };
    }).filter((x) => x.dl && x.dl - t < (x.kind === 'tiếp nhận' ? 2 : 12) * 3.6e6).sort((a, b) => (a.dl ?? 0) - (b.dl ?? 0));
    const items: AiItem[] = risk.slice(0, 6).map(({ l, dl, kind }) => {
      const peers = users.filter((u) => u.active && u.dept === l.dept && u.role === 'SALES_REP' && u.id !== l.assignee).sort((a, b) => load(a.id) - load(b.id));
      const best = peers[0];
      const mine = load(l.assignee);
      const tip = best && mine > load(best.id) + 1 ? ` Gợi ý chuyển cho ${best.name} (đang ${load(best.id)} việc).` : '';
      return { title: `${l.code} · ${l.company}`, detail: `${dl! < t ? `Quá hạn ${kind} ${dur(t - dl!)}` : `Còn ${dur(dl! - t)} để ${kind}`} · ${userName(l.assignee) || 'chưa giao'} đang ${mine} việc.${tip}`, tone: dl! < t ? 'red' : 'orange', action: { label: 'Mở', run: openLead(l) } };
    });
    const deptAlerts = alerts.filter((a) => a.id.startsWith('sla-') || a.id.startsWith('load-')).map((a) => ({ title: a.title, detail: a.detail, tone: toneOf(a.tone), action: a.go ? { label: a.goLabel ?? 'Xem', run: () => go(a.go!) } : undefined }));
    const done = leads.filter((l) => l.slaMet !== undefined);
    const met = done.filter((l) => l.slaMet).length;
    return {
      id: id(), role: 'ai',
      text: risk.length ? `Có ${risk.length} dự án / lead có nguy cơ trễ SLA (tiếp nhận trong 2 giờ hoặc báo giá trong 12 giờ tới). Ưu tiên xử lý theo thứ tự dưới đây.` : 'Không có dự án nào có nguy cơ trễ SLA trong 12 giờ tới.',
      kpis: [{ label: 'Đúng SLA tiếp nhận', value: done.length ? `${Math.round((met / done.length) * 100)}%` : '—' }, { label: 'Đang xử lý', value: String(open.length) }, { label: 'Nguy cơ trễ', value: String(risk.length), tone: risk.length ? 'red' : 'teal' }],
      items: [...items, ...deptAlerts].slice(0, 8),
      chips: ['Ai đang quá tải việc?', 'Tóm tắt việc cần làm hôm nay'],
      note: `Dựa trên ${open.length} dự án đang mở, hạn SLA và tải việc từng người.`,
    };
  };

  const cash = (): AiMsg => {
    const ins = monthly(cashEntries.filter((e) => e.kind === 'IN'), (e) => e.date, (e) => e.amount, 4);
    const outs = monthly(cashEntries.filter((e) => e.kind === 'OUT'), (e) => e.date, (e) => e.amount, 4);
    const avgIn = (ins[0] + ins[1] + ins[2]) / 3;
    const avgOut = (outs[0] + outs[1] + outs[2]) / 3;
    const balance = mfgConfig.openingCash + mfgConfig.openingBank + cashEntries.reduce((a, e) => a + (e.kind === 'IN' ? e.amount : e.kind === 'OUT' ? -e.amount : 0), 0);
    const receivable = mfg ? rows.filter((r) => r.j.wonAt && !r.j.lostAt).reduce((a, r) => a + r.money.receivable, 0) : customers.reduce((a, c) => a + c.debt, 0);
    const net = avgIn - avgOut;
    const end3 = balance + net * 3;
    const items: AiItem[] = [1, 2, 3].map((k) => {
      const m = forecast.months.find((x) => x.key === `f${k}`);
      const bal = balance + net * k;
      return { title: `${m?.label ?? `Tháng +${k}`}: số dư dự kiến ${compact(bal)}`, detail: `Thu ${compact(avgIn)} – chi ${compact(avgOut)} theo nhịp 3 tháng; doanh số dự báo tháng này ${compact(m?.forecast ?? 0)} (sẽ thành công nợ / tiền về theo điều khoản thanh toán).`, tone: bal < 0 ? 'red' : net < 0 ? 'orange' : 'teal' };
    });
    if (receivable > 0) items.push({ title: `Thu được 50% công nợ hiện tại: +${compact(receivable / 2)}`, detail: 'Kịch bản tích cực nếu đẩy mạnh thu hồi các khoản đến hạn.', tone: 'blue', action: canDo('settings.edit') || true ? { label: 'Xem công nợ', run: () => go('reports') } : undefined });
    return {
      id: id(), role: 'ai',
      text: net >= 0 ? `Dòng tiền ròng bình quân dương ${compact(net)}/tháng. Nếu giữ nhịp này, số dư sau 3 tháng khoảng ${compact(end3)}.` : `Dòng tiền ròng bình quân âm ${compact(-net)}/tháng. Với số dư hiện tại, quỹ đủ dùng khoảng ${balance > 0 ? (balance / -net).toFixed(1).replace('.', ',') : '0'} tháng nếu không thu thêm công nợ.`,
      kpis: [{ label: 'Số dư hiện tại', value: compact(balance) }, { label: 'Phải thu', value: compact(receivable) }, { label: 'Số dư sau 3 tháng', value: compact(end3), tone: end3 < 0 ? 'red' : 'teal' }],
      items, chips: ['Khách nào sắp vượt hạn mức công nợ?', 'Dự báo doanh thu 3 tháng'],
      note: 'Ước tính tuyến tính theo thu chi thực tế 3 tháng gần nhất trong sổ quỹ và công nợ hiện tại; chưa gồm khoản chi bất thường.',
    };
  };

  const fc = (): AiMsg => ({
    id: id(), role: 'ai',
    text: `Dự báo doanh thu 3 tháng tới khoảng ${compact(forecast.next3)} (dao động ${compact(forecast.low3)} – ${compact(forecast.high3)}), độ tin cậy ${forecast.confidence.toLowerCase()}.`,
    kpis: [{ label: 'Tỷ lệ chốt', value: `${Math.round(forecast.winRate * 100)}%` }, { label: 'Chu kỳ chốt', value: `${Math.round(forecast.cycleDays)} ngày` }, { label: 'Cơ hội đang mở', value: String(forecast.openDeals) }],
    items: forecast.months.filter((m) => m.forecast !== undefined).map((m) => ({ title: `${m.label}: ${compact(m.forecast ?? 0)}`, detail: `Từ pipeline có trọng số ${compact(m.pipeline ?? 0)}, phần còn lại ước từ lead mới theo nhịp ${compact(forecast.runRate)}/tháng.`, tone: 'blue' as const })),
    chips: ['Dự báo dòng tiền 3 tháng tới', 'Dự án nào có rủi ro trễ SLA?'],
    note: `Mẫu lịch sử: ${forecast.samples} đơn chốt / trượt. Độ tin cậy tăng khi có thêm dữ liệu.`,
  });

  const mdf = (): AiMsg => {
    if (mfg) return { id: id(), role: 'ai', text: 'Doanh nghiệp này không dùng quỹ MDF của Hãng. Bạn có thể hỏi về dòng tiền, công nợ hoặc rủi ro trễ hẹn.', chips: ['Dự báo dòng tiền 3 tháng tới'] };
    const fy = String(budget.fiscalYear);
    const remaining = Math.max(0, budget.total - budget.spent - budget.committed);
    const used = (code: string) => programs.filter((p) => p.type === code && p.start?.startsWith(fy) && !['REJECTED', 'CANCELLED'].includes(String(p.status))).reduce((a, p) => a + (p.held || p.requested), 0);
    const cats = categories.map((c) => { const alloc = budget.allocations?.[c.code] ?? c.amount; return { c, alloc, u: used(c.code) }; }).filter((x) => x.alloc > 0);
    const under = cats.filter((x) => x.u / x.alloc < 0.3).sort((a, b) => b.alloc - b.u - (a.alloc - a.u));
    const segName = (code: string) => segments.find((x) => x.code === code)?.name ?? code;
    const pick = (seg: string) => {
      const n = fold(segName(seg));
      const want = /dai ly|dealer|phan phoi|cua hang/.test(n) ? ['POSM_SIGNAGE', 'GIFT_DEALER'] : /thau|epc|m&e|co dien/.test(n) ? ['TECH_SEMINAR', 'TECH_TRAINING'] : /chu dau tu|nha may|xuong|end/.test(n) ? ['PROJECT_SAMPLE', 'GIFT_END_USER'] : ['TECH_TRAINING'];
      return cats.find((x) => want.includes(x.c.code) && x.alloc - x.u > 0) ?? under[0];
    };
    const cands = customers.filter((c) => !programs.some((p) => p.customerId === c.id && p.start?.startsWith(fy))).sort((a, b) => (b.ytdRevenue - b.lastYearRevenue * 0.5) - (a.ytdRevenue - a.lastYearRevenue * 0.5)).slice(0, 4);
    const items: AiItem[] = cands.map((c) => {
      const cat = pick(c.segment);
      const amt = Math.min(remaining * 0.1, Math.max(10e6, Math.round((c.ytdRevenue * 0.03) / 1e6) * 1e6));
      return { title: `${c.name}: ${cat ? cat.c.name : 'chương trình phù hợp'} ~${compact(amt)}`, detail: `${segName(c.segment)}, doanh số năm nay ${compact(c.ytdRevenue)} (năm trước ${compact(c.lastYearRevenue)}), chưa nhận quỹ năm ${fy}.`, tone: 'teal', action: canDo('program.create') ? { label: 'Lập đề xuất', run: () => openProgramForm(c.id) } : { label: 'Xem khách', run: () => { go('customers'); openCustomer(c.id); } } };
    });
    under.slice(0, 3).forEach((x) => items.push({ title: `Hạng mục “${x.c.name}” mới dùng ${Math.round((x.u / x.alloc) * 100)}%`, detail: `Còn ${compact(x.alloc - x.u)} trong phân bổ ${compact(x.alloc)}: nên lên lịch chương trình trước khi hết năm tài chính.`, tone: 'blue' }));
    const pace = alerts.find((a) => a.id === 'mdf-fast' || a.id === 'mdf-slow');
    return {
      id: id(), role: 'ai',
      text: `Quỹ 3M còn khả dụng ${compact(remaining)} / ${compact(budget.total)}.${pace ? ` ${pace.title}: ${pace.detail}` : ''} Gợi ý kích cầu cho khách tăng trưởng tốt chưa nhận quỹ và các hạng mục còn dư:`,
      kpis: [{ label: 'Đã tiêu', value: compact(budget.spent) }, { label: 'Đang giữ chỗ', value: compact(budget.committed) }, { label: 'Khả dụng', value: compact(remaining), tone: 'teal' }],
      items, chips: ['Khách nào sắp vượt hạn mức công nợ?', 'Dự báo doanh thu 3 tháng'],
      note: 'Mức đề xuất ≈ 3% doanh số năm của khách, tối đa 10% quỹ còn lại; hạng mục chọn theo nhóm khách (đại lý → biển hiệu / quà dealer, nhà thầu → hội thảo kỹ thuật, chủ đầu tư → mẫu thử).',
    };
  };

  const debt = (): AiMsg => {
    const list = customers.filter((c) => c.debt > 0).map((c) => ({ c, r: c.creditLimit ? c.debt / c.creditLimit : 1 })).sort((a, b) => b.r - a.r).slice(0, 6);
    return {
      id: id(), role: 'ai',
      text: list.length ? `Tổng công nợ ${compact(customers.reduce((a, c) => a + c.debt, 0))}. Các khách sát hoặc vượt hạn mức:` : 'Chưa có công nợ phát sinh.',
      items: list.map(({ c, r }) => ({ title: `${c.name}: ${compact(c.debt)} / hạn mức ${compact(c.creditLimit)}`, detail: `${Math.round(r * 100)}% hạn mức${r > 1 ? ', đã vượt: tạm dừng giao hàng mới hoặc yêu cầu thanh toán trước' : r > 0.9 ? ', sắp chạm hạn mức' : ''}.`, tone: r > 1 ? 'red' : r > 0.9 ? 'orange' : 'blue', action: { label: 'Hồ sơ', run: () => { go('customers'); openCustomer(c.id); } } })),
      chips: ['Dự báo dòng tiền 3 tháng tới'],
    };
  };

  const brief = (): AiMsg => ({
    id: id(), role: 'ai',
    text: `Hôm nay có ${todo.length} yêu cầu chờ bạn duyệt và ${alerts.length} cảnh báo cần chú ý.`,
    kpis: [{ label: 'Chờ duyệt', value: String(todo.length), tone: todo.length ? 'red' : 'teal' }, { label: 'Cảnh báo', value: String(alerts.length) }, { label: 'Dự báo 3 tháng', value: compact(forecast.next3) }],
    items: [
      ...(todo.length ? [{ title: `${todo.length} yêu cầu chờ duyệt`, detail: todo.slice(0, 3).map((x) => x.title).join(' · '), tone: 'orange' as const, action: { label: 'Mở Công việc', run: () => go('tasks') } }] : []),
      ...alerts.slice(0, 5).map((a) => ({ title: a.title, detail: a.detail, tone: toneOf(a.tone), action: a.go ? { label: a.goLabel ?? 'Xem', run: () => go(a.go!) } : undefined })),
    ],
    chips: ['Dự án nào có rủi ro trễ SLA?', 'Gợi ý chương trình kích cầu quỹ MDF'],
  });

  return (raw: string): AiMsg => {
    const q = fold(raw);
    // Lệnh thao tác: "tạo PO mới", "đi tới thu chi"...
    const cmd = cmds.map((i) => [i, nlScore(raw, i)] as const).filter(([, sc]) => sc > 0).sort((a, b) => b[1] - a[1])[0]?.[0];
    if (cmd && /^(tao|them|lap|nhap|di|chuyen|mo|vao)\b/.test(q)) { setTimeout(cmd.run, 0); return { id: id(), role: 'ai', text: `Đã thực hiện: ${cmd.label}.`, chips: ['Tóm tắt việc cần làm hôm nay'] }; }
    if (has(q, 'sla', 'tre han', 'tre ', 'qua han', 'qua tai', 'rui ro')) return sla();
    if (has(q, 'dong tien', 'cash', 'thanh khoan', 'so du', 'quy tien')) return cash();
    if (has(q, 'mdf', 'kich cau', 'chuong trinh', 'quy 3m', 'tai tro')) return mdf();
    if (has(q, 'cong no', 'phai thu', 'han muc', 'no xau')) return debt();
    if (has(q, 'du bao', 'doanh thu', 'doanh so', 'forecast')) return fc();
    if (has(q, 'tom tat', 'hom nay', 'tong quan', 'can lam', 'viec')) return brief();
    const c = customers.find((x) => q.includes(fold(x.code)) || (fold(x.name).length > 4 && (q.includes(fold(x.name)) || fold(x.name).includes(q))));
    if (c) {
      const ls = leads.filter((l) => l.customerId === c.id || (!!l.taxCode && l.taxCode === c.taxCode));
      return { id: id(), role: 'ai', text: `${c.name} (${c.code}): doanh số năm nay ${compact(c.ytdRevenue)}, công nợ ${compact(c.debt)} / ${compact(c.creditLimit)}.`, kpis: [{ label: 'Doanh số YTD', value: compact(c.ytdRevenue) }, { label: 'Công nợ', value: compact(c.debt), tone: c.creditLimit && c.debt > c.creditLimit * 0.9 ? 'red' : undefined }, { label: 'Dự án', value: String(ls.length) }], items: ls.slice(0, 4).map((l) => ({ title: `${l.code} · ${LEAD_STATUS[l.status].label}`, detail: `${l.boqNote || l.company} · ${compact(boqTotal(l))}`, tone: 'blue' as const, action: { label: 'Mở', run: openLead(l) } })), chips: ['Gợi ý chương trình kích cầu quỹ MDF'] };
    }
    if (cmd) { setTimeout(cmd.run, 0); return { id: id(), role: 'ai', text: `Đã thực hiện: ${cmd.label}.` }; }
    return { id: id(), role: 'ai', text: 'Mình chưa hiểu câu hỏi. Mình có thể phân tích rủi ro trễ SLA, dự báo doanh thu và dòng tiền, gợi ý chương trình quỹ MDF, công nợ, tóm tắt việc hôm nay, tra cứu khách hàng hoặc thực hiện lệnh (vd. “tạo PO mới”).', chips: AI_STARTERS };
  };
}

function AiBubble({ m, onChip }: { m: AiMsg; onChip: (q: string) => void }) {
  const tone = { red: 'border-[#EF4444]', orange: 'border-[#F28C33]', blue: 'border-[#0B5FB8]', teal: 'border-[#00B894]' };
  if (m.role === 'user') return <div className="flex justify-end"><p className="max-w-[85%] rounded-md rounded-tr-none bg-[#0B5FB8] px-3 py-2 text-sm text-white">{m.text}</p></div>;
  return (
    <div className="flex gap-2.5">
      <span className="g-brand mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded text-[#0F141E]"><Sparkles className="h-4 w-4" aria-hidden /></span>
      <div className="min-w-0 flex-1 space-y-2">
        <p className="text-sm leading-relaxed text-[#E2E8F0]">{m.text}</p>
        {m.kpis && <div className="grid grid-cols-3 gap-2">{m.kpis.map((k) => <div key={k.label} className="rounded border border-white/[0.06] bg-white/[0.03] px-2 py-1.5"><p className="truncate text-[10px] uppercase tracking-wide text-[#94A3B8]">{k.label}</p><p className={cn('font-num truncate text-sm font-semibold', k.tone === 'red' ? 'text-[#F87171]' : k.tone === 'teal' ? 'text-[#3DDBB6]' : 'text-[#F1F5F9]')}>{k.value}</p></div>)}</div>}
        {m.items && m.items.length > 0 && (
          <ul className="space-y-1.5">
            {m.items.map((it, i) => (
              <li key={i} className={cn('flex items-start gap-2 rounded border-l-2 bg-white/[0.03] px-2.5 py-2', tone[it.tone ?? 'blue'])}>
                <div className="min-w-0 flex-1"><p className="text-[13px] font-semibold text-[#F1F5F9]">{it.title}</p>{it.detail && <p className="mt-0.5 text-xs text-[#94A3B8]">{it.detail}</p>}</div>
                {it.action && <button className={cn(btnGhost, 'shrink-0 px-2 py-1 text-xs')} onClick={it.action.run}>{it.action.label}</button>}
              </li>
            ))}
          </ul>
        )}
        {m.note && <p className="text-[11px] italic text-[#7C8796]">{m.note}</p>}
        {m.chips && <div className="flex flex-wrap gap-1.5">{m.chips.map((c) => <button key={c} className="rounded-full border border-white/10 px-2.5 py-1 text-[11px] text-[#94A3B8] hover:border-[#0B5FB8] hover:text-white" onClick={() => onChip(c)}>{c}</button>)}</div>}
      </div>
    </div>
  );
}

function AiCopilotTab({ ask, onAsked }: { ask: string | null; onAsked: () => void }) {
  const answer = useCopilot();
  const [msgs, setMsgs] = useState<AiMsg[]>([]);
  const [text, setText] = useState('');
  const endRef = useRef<HTMLDivElement>(null);
  const send = (q: string) => {
    const v = q.trim();
    if (!v) return;
    setMsgs((p) => [...p, { id: uid('u'), role: 'user', text: v }, answer(v)]);
    setText('');
  };
  useEffect(() => { if (ask) { send(ask); onAsked(); } /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, [ask]);
  useEffect(() => { endRef.current?.scrollIntoView({ block: 'end', behavior: 'smooth' }); }, [msgs.length]);
  return (
    <div className="flex min-h-0 flex-1 flex-col">
      <div className="min-h-0 flex-1 space-y-4 overflow-y-auto px-4 py-4">
        {!msgs.length && (
          <div className="flex h-full flex-col items-center justify-center gap-2 text-center opacity-50">
            <Sparkles className="h-6 w-6 text-[#7C8796]" aria-hidden />
            <p className="max-w-[240px] text-[13px] text-[#7C8796]">Hỏi AI về rủi ro SLA, dòng tiền, quỹ MDF, công nợ…</p>
          </div>
        )}
        {msgs.map((m) => <AiBubble key={m.id} m={m} onChip={send} />)}
        <div ref={endRef} />
      </div>
      <form className="border-t border-white/[0.06] p-3" onSubmit={(e) => { e.preventDefault(); send(text); }}>
        <div className="flex items-center gap-2 rounded-md border border-white/10 bg-[#0B1019] px-2 focus-within:border-[#0B5FB8]">
          <Sparkles className="h-4 w-4 shrink-0 text-[#7C8796]" aria-hidden />
          <input className="h-11 flex-1 bg-transparent text-sm text-[#F1F5F9] placeholder:text-[#94A3B8]/70 focus:outline-none" value={text} onChange={(e) => setText(e.target.value)} placeholder="Hỏi về SLA, dòng tiền, quỹ MDF…" aria-label="Câu hỏi cho AI Copilot" />
          <button className={cn('flex h-8 w-8 shrink-0 items-center justify-center rounded-full transition-all', text.trim() ? 'g-brand text-[#0F141E]' : 'text-[#5B6577]')} disabled={!text.trim()} aria-label="Gửi câu hỏi"><Send className="h-4 w-4" aria-hidden /></button>
        </div>
      </form>
    </div>
  );
}

/** Khóa luồng chat: kênh chung hoặc theo bản ghi */
type Thread = { entity: CommentEntity; entityId: string; title: string; sub?: string; module: Module; token?: string };
const threadKey = (t: { entity: string; entityId: string }) => `${t.entity}:${t.entityId}`;

function ChatTab({ seen, markSeen }: { seen: Record<string, number>; markSeen: (k: string) => void }) {
  const { comments, addComment, userName, me, leads, customers, jobs, pos, channels, users, go } = useApp();
  const links = useDeepLinks();
  const [cur, setCur] = useState<Thread | null>(null);
  const [q, setQ] = useState('');
  const general: Thread = { entity: 'channel', entityId: 'general', title: 'Kênh chung', sub: 'Toàn doanh nghiệp', module: 'overview' };
  const resolve = (entity: CommentEntity, entityId: string): Thread | null => {
    if (entity === 'channel') {
      if (entityId === 'general') return general;
      if (entityId.startsWith('dm:')) { const o = users.find((u) => u.id !== me?.id && entityId.split(':').includes(u.id)); return o && me && entityId.split(':').includes(me.id) ? { entity, entityId, title: o.name, sub: 'Tin nhắn trực tiếp', module: 'messages' } : null; }
      const g = channels.find((x) => x.id === entityId && !!me && (x.members.includes(me.id) || x.createdBy === me.id));
      return g ? { entity, entityId, title: g.name, sub: `Nhóm · ${g.members.length} người`, module: 'messages' } : null;
    }
    if (entity === 'lead') { const l = leads.find((x) => x.id === entityId); return l ? { entity, entityId, title: l.company, sub: `${l.code} · ${LEAD_STATUS[l.status].label}`, module: 'projects', token: l.code } : null; }
    if (entity === 'customer') { const c = customers.find((x) => x.id === entityId); return c ? { entity, entityId, title: c.name, sub: `${c.code} · Khách hàng`, module: 'customers', token: c.code } : null; }
    if (entity === 'job') { const j = jobs.find((x) => x.id === entityId); return j ? { entity, entityId, title: jobCustName(j, customers), sub: `${j.code} · Đơn hàng`, module: 'jobs', token: j.code } : null; }
    const p = pos.find((x) => x.id === entityId); return p ? { entity, entityId, title: p.vendor, sub: `${p.code} · PO`, module: 'supply', token: p.code } : null;
  };
  const groups = new Map<string, RowComment[]>();
  comments.forEach((c) => { const k = threadKey(c); groups.set(k, [...(groups.get(k) ?? []), c]); });
  const threads = [...groups.entries()].filter(([k]) => k !== 'channel:general').map(([k, list]) => ({ k, last: list.reduce((a, b) => (a.at > b.at ? a : b)), list })).sort((a, b) => b.last.at - a.last.at);
  const unread = (k: string, list: RowComment[]) => list.filter((c) => c.authorId !== me?.id && c.at > (seen[k] ?? 0)).length;
  const t = fold(q.trim());
  const found: Thread[] = t ? [
    ...leads.filter((l) => fold(`${l.code} ${l.company}`).includes(t)).slice(0, 5).map((l) => resolve('lead', l.id)!),
    ...jobs.filter((j) => fold(`${j.code} ${j.title} ${jobCustName(j, customers)}`).includes(t)).slice(0, 5).map((j) => resolve('job', j.id)!),
    ...pos.filter((p) => fold(`${p.code} ${p.vendor}`).includes(t)).slice(0, 3).map((p) => resolve('po', p.id)!),
    ...customers.filter((c) => fold(`${c.code} ${c.name}`).includes(t)).slice(0, 3).map((c) => resolve('customer', c.id)!),
  ].filter(Boolean) : [];
  const open = (th: Thread) => { setCur(th); markSeen(threadKey(th)); };
  const list = cur ? comments.filter((c) => c.entity === cur.entity && c.entityId === cur.entityId).sort((a, b) => a.at - b.at) : [];
  const endRef = useRef<HTMLDivElement>(null);
  useEffect(() => { endRef.current?.scrollIntoView({ block: 'end' }); if (cur) markSeen(threadKey(cur)); /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, [list.length, cur?.entityId]);
  if (cur) {
    const link = cur.token ? links.find((d) => d.token === cur.token) : undefined;
    return (
      <div className="flex min-h-0 flex-1 flex-col">
        <div className="flex items-center gap-2 border-b border-white/[0.06] px-3 py-2.5">
          <button className="rounded p-1 text-[#94A3B8] hover:bg-white/10 hover:text-white" onClick={() => setCur(null)} aria-label="Quay lại danh sách kênh"><ArrowLeft className="h-4 w-4" /></button>
          <span className="flex h-7 w-7 shrink-0 items-center justify-center rounded bg-white/[0.06] text-[#F7B23B]">{cur.entity === 'channel' ? <Hash className="h-4 w-4" aria-hidden /> : <MessageSquare className="h-4 w-4" aria-hidden />}</span>
          <div className="min-w-0 flex-1"><p className="truncate text-sm font-semibold">{cur.title}</p><p className="truncate text-[11px] text-[#94A3B8]">{cur.sub}</p></div>
          {link && <button className={cn(btnGhost, 'px-2 py-1 text-xs')} onClick={link.open} title="Mở đúng bản ghi"><ExternalLink className="h-3.5 w-3.5" aria-hidden />Mở</button>}
        </div>
        <div className="min-h-0 flex-1 space-y-3 overflow-y-auto px-4 py-3">
          {!list.length && <EmptyState text={<>Bắt đầu trao đổi</>} hint={<>Gõ @ để gắn thẻ đồng nghiệp, # để chèn liên kết tới dự án, đơn hàng hoặc báo cáo.</>} art="inbox" compact />}
          {list.map((c) => (
            <div key={c.id} className={cn('flex gap-2.5', c.authorId === me?.id && 'flex-row-reverse')}>
              <Avatar name={userName(c.authorId)} size={26} />
              <div className={cn('min-w-0 max-w-[85%]', c.authorId === me?.id && 'text-right')}>
                <p className="text-[11px] text-[#7C8796]"><b className="text-[#CBD5E1]">{c.authorId === me?.id ? 'Bạn' : userName(c.authorId)}</b> · {new Date(c.at).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' })}</p>
                {c.text && <p className={cn('mt-0.5 inline-block whitespace-pre-wrap break-words rounded-md px-3 py-2 text-left text-sm leading-relaxed', c.authorId === me?.id ? 'rounded-tr-none bg-[#0B5FB8]/30 text-[#E2E8F0]' : 'rounded-tl-none bg-white/[0.05] text-[#E2E8F0]')}><MentionText text={c.text} /></p>}
                {c.files?.length ? <ChatFiles files={c.files} /> : null}
              </div>
            </div>
          ))}
          <div ref={endRef} />
        </div>
        <div className="border-t border-white/[0.06] p-3"><MentionComposer onSend={(text, mentions) => addComment({ entity: cur.entity, entityId: cur.entityId, text, mentions, module: cur.module }, cur.title)} /></div>
      </div>
    );
  }
  const gList = groups.get('channel:general') ?? [];
  const row = (th: Thread, last?: RowComment, n = 0) => (
    <button key={threadKey(th)} className="flex w-full items-center gap-3 rounded px-2.5 py-2 text-left hover:bg-white/[0.04]" onClick={() => open(th)}>
      <span className={cn('flex h-8 w-8 shrink-0 items-center justify-center rounded', th.entity === 'channel' ? 'g-brand text-[#0F141E]' : 'bg-white/[0.06] text-[#94A3B8]')}>{th.entity === 'channel' ? <Hash className="h-4 w-4" aria-hidden /> : <MessageSquare className="h-4 w-4" aria-hidden />}</span>
      <span className="min-w-0 flex-1"><span className="flex items-center gap-2"><span className="truncate text-sm font-medium">{th.title}</span>{th.token && <span className="shrink-0 font-mono text-[10px] text-[#7C8796]">{th.token}</span>}</span><span className="block truncate text-xs text-[#94A3B8]">{last ? `${last.authorId === me?.id ? 'Bạn' : userName(last.authorId)}: ${last.text || (last.files?.length ? `[${last.files.length} file]` : '')}` : th.sub}</span></span>
      {n > 0 && <span className="g-brand flex h-5 min-w-5 items-center justify-center rounded-full px-1.5 text-[10px] font-bold text-[#0F141E]">{n}</span>}
    </button>
  );
  return (
    <div className="flex min-h-0 flex-1 flex-col">
      <div className="border-b border-white/[0.06] p-3">
        <div className="flex gap-2">
          <div className="relative flex-1"><Search className="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-[#94A3B8]" aria-hidden /><input className={cn(inputCls, 'py-2 pl-8 text-sm')} value={q} onChange={(e) => setQ(e.target.value)} placeholder="Mở kênh theo dự án, mã đơn, PO…" aria-label="Tìm kênh trao đổi" /></div>
          <button className={cn(btnGhost, 'shrink-0 px-2.5')} onClick={() => go('messages')} title="Mở Tin nhắn toàn màn hình: nhóm, tin nhắn trực tiếp, gửi file, tìm lịch sử" aria-label="Mở Tin nhắn toàn màn hình"><Maximize2 className="h-4 w-4" aria-hidden /></button>
        </div>
      </div>
      <div className="min-h-0 flex-1 overflow-y-auto p-2">
        {t ? (
          <>{found.map((th) => row(th, groups.get(threadKey(th))?.slice(-1)[0], unread(threadKey(th), groups.get(threadKey(th)) ?? [])))}{!found.length && <p className="px-3 py-6 text-center text-xs text-[#94A3B8]">Không tìm thấy dự án / đơn khớp “{q}”.</p>}</>
        ) : (
          <>
            {row(general, gList.slice(-1)[0], unread('channel:general', gList))}
            <p className="px-2.5 pb-1 pt-3 text-[10px] font-semibold uppercase tracking-wider text-[#7C8796]">Nhóm, tin nhắn & dự án</p>
            {threads.map(({ k, last, list: l2 }) => { const cut = k.indexOf(':'); const th = resolve(k.slice(0, cut) as CommentEntity, k.slice(cut + 1)); return th ? row(th, last, unread(k, l2)) : null; })}
            {!threads.length && <p className="px-3 py-4 text-xs text-[#94A3B8]">Chưa có trao đổi theo dự án. Tìm mã dự án / đơn ở ô phía trên để mở kênh, hoặc bấm biểu tượng bình luận trên dòng bảng.</p>}
          </>
        )}
      </div>
    </div>
  );
}

/** Cột phải: Chat nội bộ + AI Copilot. Màn rộng (≥1280px) neo cố định, đẩy nội dung sang trái; màn hẹp trượt phủ */
function CommHub({ tab, onTab, onClose, ask, onAsked, seen, markSeen }: { tab: 'chat' | 'ai'; onTab: (t: 'chat' | 'ai') => void; onClose: () => void; ask: string | null; onAsked: () => void; seen: Record<string, number>; markSeen: (k: string) => void }) {
  return (
    <div className="glass flex h-full flex-col border-l border-white/[0.08]">
      <div className="flex h-16 shrink-0 items-center gap-2 border-b border-white/[0.06] px-3">
        <div className="flex flex-1 rounded-md border border-white/10 bg-[#0B1019] p-1" role="tablist" aria-label="Trung tâm trao đổi">
          {([['chat', 'Chat nội bộ', MessageSquare], ['ai', 'AI Copilot', Sparkles]] as const).map(([v, l, I]) => (
            <button key={v} role="tab" aria-selected={tab === v} onClick={() => onTab(v)} className={cn('flex flex-1 items-center justify-center gap-1.5 rounded px-2 py-1.5 text-xs font-semibold', tab === v ? 'g-brand text-[#0F141E]' : 'text-[#94A3B8] hover:text-white')}><I className="h-3.5 w-3.5" aria-hidden />{l}</button>
          ))}
        </div>
        <button className={cn(btnGhost, 'p-1.5')} onClick={onClose} aria-label="Đóng trung tâm trao đổi"><X className="h-4 w-4" /></button>
      </div>
      {tab === 'chat' ? <ChatTab seen={seen} markSeen={markSeen} /> : <AiCopilotTab ask={ask} onAsked={onAsked} />}
    </div>
  );
}

// =====================================================================
//  TIN NHẮN TOÀN MÀN HÌNH (Messenger kiểu Zalo / Slack)
//  Kênh chung + nhóm dự án / phòng ban + tin nhắn trực tiếp + kênh theo bản ghi; gửi file; tìm lịch sử
// =====================================================================

const fmtSize = (b: number) => (b >= 1048576 ? `${(b / 1048576).toFixed(1).replace('.', ',')} MB` : `${Math.max(1, Math.round(b / 1024))} KB`);
const dmId = (a: string, b: string) => `dm:${[a, b].sort().join(':')}`;
/** Giới hạn mỗi file: chạy máy chủ thì file đưa lên Storage; chạy trong trình duyệt bị giới hạn dung lượng lưu trữ */
const chatFileMax = () => (CLOUD_ON ? 25 * 1048576 : 2 * 1048576);

const isTextFile = (f: ChatFile) => /^text\/|json|csv|xml|markdown/.test(f.type) || /\.(txt|csv|md|json|log|xml)$/i.test(f.name);
/** Xem trước file ngay trong chat: ảnh, PDF, văn bản; định dạng khác thì tải xuống */
function FilePreview({ f, onClose }: { f: ChatFile; onClose: () => void }) {
  const [url, setUrl] = useState<string | null>(null);
  const [text, setText] = useState<string | null>(null);
  const img = f.type.startsWith('image/');
  const pdf = f.type === 'application/pdf' || /\.pdf$/i.test(f.name);
  useEffect(() => {
    let obj: string | undefined;
    (async () => {
      try {
        const blob = await (await fetch(f.url)).blob();
        if (isTextFile(f)) setText((await blob.text()).slice(0, 200000));
        else { obj = URL.createObjectURL(pdf ? new Blob([blob], { type: 'application/pdf' }) : blob); setUrl(obj); }
      } catch { setUrl(f.url); }
    })();
    return () => { if (obj) URL.revokeObjectURL(obj); };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [f.url]);
  return (
    <Modal title={f.name} onClose={onClose} wide footer={<><span className="mr-auto text-xs text-[#94A3B8]">{fmtSize(f.size)} · {f.type || 'không rõ định dạng'}</span><a className={btnGhost} href={f.url} download={f.name}><Download className="h-4 w-4" aria-hidden />Tải xuống</a><button className={btnPrimary} onClick={onClose}>Đóng</button></>}>
      {img ? (
        // eslint-disable-next-line @next/next/no-img-element
        <img src={url ?? f.url} alt={f.name} className="mx-auto max-h-[70vh] rounded object-contain" />
      ) : pdf ? (
        url ? <iframe title={f.name} src={url} className="h-[70vh] w-full rounded border border-white/10 bg-white" /> : <p className="py-10 text-center text-sm text-[#94A3B8]">Đang mở PDF…</p>
      ) : text !== null ? (
        <pre className="max-h-[70vh] overflow-auto whitespace-pre-wrap rounded bg-[#0B1019] p-4 font-mono text-[13px] leading-relaxed text-[#E2E8F0]">{text}</pre>
      ) : (
        <EmptyState text={<>Chưa xem trước được định dạng này</>} hint={<>File Word, Excel, nén… hãy tải xuống để mở bằng ứng dụng tương ứng.</>} art="doc" />
      )}
    </Modal>
  );
}

function ChatFiles({ files }: { files: ChatFile[] }) {
  const [view, setView] = useState<ChatFile | null>(null);
  return (
    <div className="mt-2 flex flex-wrap gap-2">
      {files.map((f, i) => f.type.startsWith('image/') ? (
        <button key={i} type="button" onClick={() => setView(f)} className="block overflow-hidden rounded-lg border border-white/10 transition-opacity hover:opacity-90" title={`${f.name} · ${fmtSize(f.size)} · bấm để xem`}>
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img src={f.url} alt={f.name} className="h-36 max-w-[240px] object-cover" />
        </button>
      ) : (
        <button key={i} type="button" onClick={() => setView(f)} className="flex max-w-[280px] items-center gap-3 rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2.5 text-left transition-colors hover:border-[#0B5FB8]/70">
          <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-white/10 text-[#94A3B8]"><FileText className="h-5 w-5" aria-hidden /></span>
          <span className="min-w-0"><span className="block truncate text-sm font-medium text-[#E2E8F0]">{f.name}</span><span className="block text-xs text-[#94A3B8]">{fmtSize(f.size)} · Xem trước</span></span>
        </button>
      ))}
      {view && <FilePreview f={view} onClose={() => setView(null)} />}
    </div>
  );
}

const QUICK_REACTIONS = ['👍', '❤️', '😂', '🎉', '😮', '✅'];

function MessengerPage() {
  const { me } = useApp();
  return me ? <MessengerInner me={me} /> : null;
}

function MessengerInner({ me }: { me: User }) {
  const CHAT_FILE_MAX = chatFileMax();
  const { comments, addComment, patchComment, channels, setChannels, users, userName, leads, customers, jobs, pos, chatSeen, markChatSeen, notify, role } = useApp();
  const links = useDeepLinks();
  const [cur, setCur] = useState<Thread | null>(null);
  const [q, setQ] = useState('');
  const [inThread, setInThread] = useState('');
  const [side, setSide] = useState<'info' | 'none'>('info');
  const [threadOf, setThreadOf] = useState<string | null>(null);
  const [pinsOpen, setPinsOpen] = useState(false);
  const [pending, setPending] = useState<ChatFile[]>([]);
  const [replyPending, setReplyPending] = useState<ChatFile[]>([]);
  const [dragging, setDragging] = useState(0);
  const [pickReact, setPickReact] = useState<string | null>(null);
  const [newGroup, setNewGroup] = useState(false);
  const [newDm, setNewDm] = useState(false);
  const [gName, setGName] = useState('');
  const [gDesc, setGDesc] = useState('');
  const [gMembers, setGMembers] = useState<string[]>([]);
  const endRef = useRef<HTMLDivElement>(null);
  const userById = (id: string) => users.find((u) => u.id === id) ?? (id === me.id ? me : undefined);
  const general: Thread = { entity: 'channel', entityId: 'general', title: 'Kênh chung', sub: 'Toàn doanh nghiệp', module: 'messages' };
  const myGroups = channels.filter((g) => g.members.includes(me.id) || g.createdBy === me.id);
  const groupThread = (g: ChatChannel): Thread => ({ entity: 'channel', entityId: g.id, title: g.name, sub: `${g.members.length} thành viên`, module: 'messages' });
  const dmThread = (u: User): Thread => ({ entity: 'channel', entityId: dmId(me.id, u.id), title: u.name, sub: ROLE_LABEL[u.role], module: 'messages' });
  const resolve = (entity: CommentEntity, id: string): Thread | null => {
    if (entity === 'channel') {
      if (id === 'general') return general;
      if (id.startsWith('dm:')) { const other = users.find((u) => u.id !== me.id && id.split(':').includes(u.id)); return other && id.split(':').includes(me.id) ? dmThread(other) : null; }
      const g = myGroups.find((x) => x.id === id); return g ? groupThread(g) : null;
    }
    if (entity === 'lead') { const l = leads.find((x) => x.id === id); return l ? { entity, entityId: id, title: l.company, sub: `${l.code} · Dự án`, module: 'projects', token: l.code } : null; }
    if (entity === 'customer') { const c = customers.find((x) => x.id === id); return c ? { entity, entityId: id, title: c.name, sub: `${c.code} · Khách hàng`, module: 'customers', token: c.code } : null; }
    if (entity === 'job') { const j = jobs.find((x) => x.id === id); return j ? { entity, entityId: id, title: jobCustName(j, customers), sub: `${j.code} · Đơn hàng`, module: 'jobs', token: j.code } : null; }
    const p = pos.find((x) => x.id === id); return p ? { entity, entityId: id, title: p.vendor, sub: `${p.code} · PO`, module: 'supply', token: p.code } : null;
  };
  const byThread = new Map<string, { th: Thread; list: RowComment[] }>();
  comments.forEach((c) => {
    const k = threadKey(c);
    const hit = byThread.get(k);
    if (hit) { hit.list.push(c); return; }
    const th = resolve(c.entity, c.entityId);
    if (th) byThread.set(k, { th, list: [c] });
  });
  const lastAt = (k: string) => { const l = byThread.get(k)?.list; return l?.length ? Math.max(...l.map((x) => x.at)) : 0; };
  const unread = (k: string) => (byThread.get(k)?.list ?? []).filter((c) => c.authorId !== me.id && c.at > (chatSeen[k] ?? 0)).length;
  const sel = cur ?? general;
  const selKey = threadKey(sel);
  const all = (byThread.get(selKey)?.list ?? []).slice().sort((a, b) => a.at - b.at);
  const roots = all.filter((c) => !c.parentId);
  const repliesOf = (id: string) => all.filter((c) => c.parentId === id);
  const pins = all.filter((c) => c.pinned).sort((a, b) => (b.pinned?.at ?? 0) - (a.pinned?.at ?? 0));
  const tq = fold(inThread.trim());
  const shown = tq ? roots.filter((c) => fold(`${c.text} ${(c.files ?? []).map((f) => f.name).join(' ')} ${repliesOf(c.id).map((r) => r.text).join(' ')}`).includes(tq)) : roots;
  const open = (th: Thread) => { setCur(th); setInThread(''); setPending([]); setThreadOf(null); setPinsOpen(false); markChatSeen(threadKey(th)); };
  useEffect(() => { markChatSeen(selKey); endRef.current?.scrollIntoView({ block: 'end' }); /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, [selKey, roots.length]);

  const isDm = sel.entity === 'channel' && sel.entityId.startsWith('dm:');
  const group = sel.entity === 'channel' ? myGroups.find((g) => g.id === sel.entityId) : undefined;
  const dmOther = isDm ? users.find((u) => u.id !== me.id && sel.entityId.split(':').includes(u.id)) : undefined;
  const members = (isDm ? [me, dmOther].filter(Boolean) as User[] : group ? users.filter((u) => group.members.includes(u.id)) : users.filter((u) => u.active))
    .slice().sort((a, b) => ['online', 'away', 'offline'].indexOf(presenceOf(a, me.id)) - ['online', 'away', 'offline'].indexOf(presenceOf(b, me.id)));
  const files = all.flatMap((c) => (c.files ?? []).map((f) => ({ f, c })));
  const link = sel.token ? links.find((d) => d.token === sel.token) : undefined;
  const parent = threadOf ? all.find((c) => c.id === threadOf) : undefined;

  const readFiles = (fs: File[], into: (f: ChatFile) => void) => {
    fs.forEach((f) => {
      if (f.size > CHAT_FILE_MAX) { notify(`${f.name} vượt ${fmtSize(CHAT_FILE_MAX)}${CLOUD_ON ? '' : ' (bản chạy trên trình duyệt; bật máy chủ Supabase để gửi file lớn)'}`, 'red'); return; }
      const r = new FileReader();
      r.onload = () => into({ name: f.name, size: f.size, type: f.type || 'application/octet-stream', url: String(r.result) });
      r.readAsDataURL(f);
    });
  };
  const send = (text: string, mentions: string[], parentId?: string) => {
    const fl = parentId ? replyPending : pending;
    if (!text && !fl.length) return;
    const extra = [...(isDm && dmOther ? [dmOther.id] : []), ...(parentId ? [all.find((c) => c.id === parentId)?.authorId ?? ''] : [])].filter((x) => x && x !== me.id);
    addComment({ entity: sel.entity, entityId: sel.entityId, text, mentions: [...new Set([...mentions, ...extra])], module: sel.module, ...(fl.length ? { files: fl } : {}), ...(parentId ? { parentId } : {}) }, sel.title);
    if (parentId) setReplyPending([]); else setPending([]);
  };
  const react = (c: RowComment, emo: string) => patchComment(c.id, (x) => {
    const r = { ...(x.reactions ?? {}) };
    const who = r[emo] ?? [];
    r[emo] = who.includes(me.id) ? who.filter((u) => u !== me.id) : [...who, me.id];
    if (!r[emo].length) delete r[emo];
    return { ...x, reactions: r };
  });
  const togglePin = (c: RowComment) => { patchComment(c.id, (x) => ({ ...x, pinned: x.pinned ? undefined : { by: me.id, at: Date.now() } })); notify(c.pinned ? 'Đã bỏ ghim' : 'Đã ghim tin nhắn lên đầu kênh', 'teal'); };
  const jumpTo = (id: string) => { const el = document.getElementById(`msg-${id}`); el?.scrollIntoView({ block: 'center', behavior: 'smooth' }); el?.animate?.([{ backgroundColor: 'rgba(242,140,51,.18)' }, { backgroundColor: 'transparent' }], { duration: 1400 }); };
  const createGroup = () => {
    const name = gName.trim();
    if (name.length < 3) return notify('Đặt tên nhóm tối thiểu 3 ký tự', 'red');
    const g: ChatChannel = { id: uid('ch'), name, desc: gDesc.trim() || undefined, members: [...new Set([me.id, ...gMembers])], createdBy: me.id, at: Date.now() };
    setChannels((p) => [...p, g]);
    setNewGroup(false); setGName(''); setGDesc(''); setGMembers([]);
    open(groupThread(g));
    notify(`Đã tạo nhóm ${name}`, 'teal');
  };

  const gq = fold(q.trim());
  const hits = gq.length >= 2 ? [...byThread.values()].flatMap(({ th, list: l }) => l.filter((c) => fold(`${c.text} ${(c.files ?? []).map((f) => f.name).join(' ')}`).includes(gq)).map((c) => ({ th, c }))).sort((a, b) => b.c.at - a.c.at).slice(0, 30) : [];
  const recordThreads = [...byThread.entries()].filter(([, v]) => v.th.entity !== 'channel').sort((a, b) => lastAt(b[0]) - lastAt(a[0]));
  const dmUsers = users.filter((u) => u.active && u.id !== me.id).map((u) => ({ u, k: `channel:${dmId(me.id, u.id)}` })).filter(({ k }) => byThread.has(k)).sort((a, b) => lastAt(b.k) - lastAt(a.k));
  const tile = (icon: ReactNode) => <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 text-[#94A3B8]">{icon}</span>;

  const item = (th: Thread, k: string, icon: ReactNode) => {
    const l = byThread.get(k)?.list ?? [];
    const last = l.length ? l.reduce((x, y) => (x.at > y.at ? x : y)) : undefined;
    const n = unread(k);
    const on = k === selKey;
    return (
      <button key={k} className={cn('flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left transition-colors', on ? 'bg-white/[0.07]' : 'hover:bg-white/[0.04]')} onClick={() => open(th)} aria-current={on || undefined}>
        {icon}
        <span className="min-w-0 flex-1">
          <span className="flex items-center gap-2"><span className={cn('truncate text-[15px]', n ? 'font-bold text-white' : 'font-semibold text-[#E2E8F0]')}>{th.title}</span>{last && <span className="ml-auto shrink-0 text-[11px] text-[#7C8796]">{new Date(last.at).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}</span>}</span>
          <span className={cn('mt-0.5 block truncate text-[13px]', n ? 'text-[#CBD5E1]' : 'text-[#7C8796]')}>{last ? `${last.authorId === me.id ? 'Bạn' : userName(last.authorId).split(' ').slice(-1)[0]}: ${last.text || (last.files?.length ? `[${last.files.length} file]` : '')}` : th.sub}</span>
        </span>
        {n > 0 && <span className="flex h-5 min-w-5 items-center justify-center rounded-full bg-[#F28C33] px-1.5 text-[11px] font-bold text-[#0F141E]">{n}</span>}
      </button>
    );
  };
  const sec = (title: string, action?: ReactNode) => <div className="flex items-center justify-between px-3 pb-2 pt-5"><p className="text-[11px] font-semibold uppercase tracking-wider text-[#7C8796]">{title}</p>{action}</div>;
  const plus = (label: string, onClick: () => void) => <button className="flex h-7 w-7 items-center justify-center rounded-md text-[#7C8796] hover:bg-white/10 hover:text-white" onClick={onClick} aria-label={label} title={label}><Plus className="h-4 w-4" /></button>;

  /** Một tin nhắn: thanh thao tác khi rê chuột (thả cảm xúc, trả lời theo chủ đề, ghim), cảm xúc, số trả lời */
  const renderMsg = (c: RowComment, compactRow?: boolean, inPanel?: boolean) => {
    const mine = c.authorId === me.id;
    const reps = inPanel ? [] : repliesOf(c.id);
    const au = userById(c.authorId);
    return (
      <div key={c.id} id={inPanel ? undefined : `msg-${c.id}`} className={cn('group relative -mx-3 flex gap-3 rounded-lg px-3 py-1.5 transition-colors hover:bg-white/[0.025]', !compactRow && 'mt-3')}>
        {compactRow ? <span className="w-9 shrink-0" /> : <PAvatar user={au} name={userName(c.authorId)} size={36} meId={me.id} />}
        <div className="min-w-0 flex-1">
          {!compactRow && <p className="flex items-baseline gap-2"><b className="text-[15px] font-semibold text-[#F1F5F9]">{mine ? 'Bạn' : userName(c.authorId)}</b><span className="text-xs text-[#7C8796]">{new Date(c.at).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}</span>{c.pinned && <span className="flex items-center gap-1 text-[11px] text-[#F7B23B]"><Pin className="h-3 w-3" aria-hidden />Đã ghim</span>}</p>}
          {c.text && <p className="whitespace-pre-wrap break-words text-[15px] leading-[1.6] text-[#E2E8F0]"><MentionText text={c.text} /></p>}
          {c.files?.length ? <ChatFiles files={c.files} /> : null}
          {c.reactions && Object.keys(c.reactions).length > 0 && (
            <div className="mt-1.5 flex flex-wrap gap-1.5">
              {Object.entries(c.reactions).map(([emo, who]) => (
                <button key={emo} onClick={() => react(c, emo)} title={who.map((u) => (u === me.id ? 'Bạn' : userName(u))).join(', ')}
                  className={cn('flex items-center gap-1 rounded-full border px-2 py-0.5 text-[13px] transition-colors', who.includes(me.id) ? 'border-[#0B5FB8]/70 bg-[#0B5FB8]/20 text-white' : 'border-white/10 text-[#CBD5E1] hover:border-white/25')}>
                  <span>{emo}</span><span className="font-num text-xs">{who.length}</span>
                </button>
              ))}
            </div>
          )}
          {reps.length > 0 && (
            <button className="mt-1.5 flex items-center gap-2 rounded-md px-1.5 py-1 text-[13px] font-semibold text-[#6FA8F0] hover:bg-[#0B5FB8]/10" onClick={() => setThreadOf(c.id)}>
              <span className="flex -space-x-1.5">{[...new Set(reps.map((r) => r.authorId))].slice(0, 3).map((u) => <Avatar key={u} name={userName(u)} size={20} />)}</span>
              {reps.length} trả lời<span className="font-normal text-[#7C8796]">· {new Date(reps[reps.length - 1].at).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}</span>
            </button>
          )}
        </div>
        {/* Thanh thao tác nổi */}
        <div className={cn('absolute -top-3 right-2 hidden items-center gap-0.5 rounded-md border border-white/10 bg-[#121928] p-0.5 shadow-lg group-hover:flex', pickReact === c.id && 'flex')}>
          {QUICK_REACTIONS.slice(0, 3).map((e) => <button key={e} className="flex h-7 w-7 items-center justify-center rounded text-[15px] hover:bg-white/10" onClick={() => react(c, e)} aria-label={`Thả ${e}`}>{e}</button>)}
          <div className="relative">
            <button className="flex h-7 w-7 items-center justify-center rounded text-[#94A3B8] hover:bg-white/10 hover:text-white" onClick={() => setPickReact(pickReact === c.id ? null : c.id)} aria-label="Thêm cảm xúc" title="Thêm cảm xúc"><SmilePlus className="h-4 w-4" /></button>
            {pickReact === c.id && <div className="absolute right-0 top-full z-10 mt-1 flex gap-0.5 rounded-md border border-white/10 bg-[#121928] p-1 shadow-xl">{QUICK_REACTIONS.map((e) => <button key={e} className="flex h-8 w-8 items-center justify-center rounded text-base hover:bg-white/10" onClick={() => { react(c, e); setPickReact(null); }}>{e}</button>)}</div>}
          </div>
          {!inPanel && <button className="flex h-7 w-7 items-center justify-center rounded text-[#94A3B8] hover:bg-white/10 hover:text-white" onClick={() => setThreadOf(c.id)} aria-label="Trả lời theo chủ đề" title="Trả lời theo chủ đề"><Reply className="h-4 w-4" /></button>}
          {!inPanel && <button className={cn('flex h-7 w-7 items-center justify-center rounded hover:bg-white/10', c.pinned ? 'text-[#F7B23B]' : 'text-[#94A3B8] hover:text-white')} onClick={() => togglePin(c)} aria-label={c.pinned ? 'Bỏ ghim' : 'Ghim lên đầu kênh'} title={c.pinned ? 'Bỏ ghim' : 'Ghim lên đầu kênh'}><Pin className="h-4 w-4" /></button>}
        </div>
      </div>
    );
  };
  const pendingChips = (fl: ChatFile[], set: (f: ChatFile[]) => void) => fl.length > 0 && (
    <div className="mb-2 flex flex-wrap gap-1.5">{fl.map((f, i) => <span key={i} className="flex items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.04] py-1 pl-2.5 pr-1 text-xs"><Paperclip className="h-3 w-3 text-[#94A3B8]" aria-hidden />{f.name}<span className="text-[#7C8796]">{fmtSize(f.size)}</span><button className="rounded p-0.5 hover:bg-white/10" onClick={() => set(fl.filter((_, j) => j !== i))} aria-label={`Bỏ ${f.name}`}><X className="h-3 w-3" /></button></span>)}</div>
  );
  const attachBtn = (onFiles: (f: File[]) => void) => <FilePicker multiple onFiles={onFiles} className="flex h-7 w-7 items-center justify-center rounded text-[#7C8796] transition-colors hover:bg-white/[0.06] hover:text-white"><span title="Gửi file (hoặc kéo thả vào khung chat)" className="flex"><Paperclip className="h-4 w-4" aria-label="Gửi file" /></span></FilePicker>;
  let lastDay = '';

  return (
    <div className="glass-card -mx-3 flex h-[calc(100vh-7.5rem)] min-h-[520px] overflow-hidden rounded-lg sm:mx-0">
      {/* ---------- Danh sách kênh ---------- */}
      <aside className={cn('flex w-full shrink-0 flex-col border-r border-white/[0.06] md:w-[320px]', cur && 'max-md:hidden')}>
        <div className="px-4 pb-2 pt-4">
          <h2 className="font-display text-lg font-bold">Tin nhắn</h2>
          <div className="relative mt-3"><Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#7C8796]" aria-hidden /><input className={cn(inputCls, 'rounded-lg border-white/[0.08] py-2.5 pl-9 text-sm')} value={q} onChange={(e) => setQ(e.target.value)} placeholder="Tìm trong lịch sử, tên file…" aria-label="Tìm lịch sử tin nhắn" /></div>
        </div>
        <div className="min-h-0 flex-1 overflow-y-auto px-2 pb-4">
          {gq.length >= 2 ? (
            <>
              {sec(`${hits.length} kết quả`)}
              {hits.map(({ th, c }) => (
                <button key={c.id} className="w-full rounded-lg px-3 py-2.5 text-left hover:bg-white/[0.04]" onClick={() => { open(th); setInThread(q); setQ(''); }}>
                  <span className="flex items-center gap-2 text-xs text-[#7C8796]"><b className="truncate text-[13px] text-[#E2E8F0]">{th.title}</b><span className="ml-auto shrink-0">{new Date(c.at).toLocaleDateString('vi-VN')}</span></span>
                  <span className="mt-0.5 line-clamp-2 text-sm text-[#CBD5E1]">{userName(c.authorId)}: {c.text || (c.files ?? []).map((f) => f.name).join(', ')}</span>
                </button>
              ))}
              {!hits.length && <p className="px-3 py-8 text-center text-sm text-[#7C8796]">Không tìm thấy tin nhắn nào chứa “{q}”.</p>}
            </>
          ) : (
            <>
              {sec('Kênh & nhóm', plus('Tạo nhóm chat', () => { setNewGroup(true); setGMembers([]); }))}
              {item(general, 'channel:general', tile(<Hash className="h-[18px] w-[18px]" aria-hidden />))}
              {myGroups.slice().sort((a, b) => lastAt(`channel:${b.id}`) - lastAt(`channel:${a.id}`)).map((g) => item(groupThread(g), `channel:${g.id}`, tile(<Users2 className="h-[18px] w-[18px]" aria-hidden />)))}
              {sec('Tin nhắn trực tiếp', plus('Nhắn tin trực tiếp', () => setNewDm(true)))}
              {dmUsers.map(({ u, k }) => item(dmThread(u), k, <PAvatar user={u} size={40} meId={me.id} />))}
              {!dmUsers.length && <button className="w-full rounded-lg px-3 py-2.5 text-left text-sm text-[#7C8796] hover:bg-white/[0.04]" onClick={() => setNewDm(true)}>+ Bắt đầu trò chuyện với đồng nghiệp</button>}
              {recordThreads.length > 0 && sec('Theo dự án / đơn hàng')}
              {recordThreads.map(([k, v]) => item(v.th, k, tile(<MessageSquare className="h-[18px] w-[18px]" aria-hidden />)))}
            </>
          )}
        </div>
      </aside>

      {/* ---------- Hội thoại (kéo thả file vào bất kỳ đâu) ---------- */}
      <section className={cn('relative flex min-w-0 flex-1 flex-col', !cur && 'max-md:hidden')}
        onDragEnter={(e) => { if (e.dataTransfer.types.includes('Files')) { e.preventDefault(); setDragging((d) => d + 1); } }}
        onDragOver={(e) => { if (e.dataTransfer.types.includes('Files')) e.preventDefault(); }}
        onDragLeave={() => setDragging((d) => Math.max(0, d - 1))}
        onDrop={(e) => { e.preventDefault(); setDragging(0); if (e.dataTransfer.files.length) readFiles(Array.from(e.dataTransfer.files), (f) => (threadOf ? setReplyPending((p) => [...p, f]) : setPending((p) => [...p, f]))); }}>
        {dragging > 0 && (
          <div className="pointer-events-none absolute inset-3 z-20 flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-[#0B5FB8] bg-[#0B1019]/85 text-[#E2E8F0]">
            <Upload className="h-8 w-8 text-[#6FA8F0]" aria-hidden /><p className="text-base font-semibold">Thả file để gửi vào {threadOf ? 'chủ đề' : sel.title}</p><p className="text-xs text-[#94A3B8]">Tối đa {fmtSize(CHAT_FILE_MAX)} mỗi file</p>
          </div>
        )}
        <header className="flex items-center gap-3 border-b border-white/[0.06] px-5 py-3.5">
          <button className="rounded p-1 text-[#94A3B8] hover:bg-white/10 md:hidden" onClick={() => setCur(null)} aria-label="Danh sách kênh"><ArrowLeft className="h-4 w-4" /></button>
          {isDm && dmOther ? <PAvatar user={dmOther} size={40} meId={me.id} /> : tile(sel.entity === 'channel' ? (group ? <Users2 className="h-[18px] w-[18px]" /> : <Hash className="h-[18px] w-[18px]" />) : <MessageSquare className="h-[18px] w-[18px]" />)}
          <div className="min-w-0 flex-1">
            <h2 className="font-display truncate text-[17px] font-bold">{sel.title}</h2>
            <p className="truncate text-[13px] text-[#94A3B8]">{isDm && dmOther ? `${PRESENCE_META[presenceOf(dmOther, me.id)].label} · ${ROLE_LABEL[dmOther.role]}` : group ? `${group.desc ? `${group.desc} · ` : ''}${group.members.length} thành viên` : `${sel.sub} · ${members.length} người`}</p>
          </div>
          <div className="relative hidden sm:block"><Search className="pointer-events-none absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[#7C8796]" aria-hidden /><input className={cn(inputBase, 'w-44 rounded-lg border-white/[0.08] py-1.5 pl-8 text-[13px]')} value={inThread} onChange={(e) => setInThread(e.target.value)} placeholder="Tìm trong kênh" aria-label="Tìm trong kênh" /></div>
          {link && <button className="flex h-8 items-center gap-1.5 rounded-md px-2 text-[13px] text-[#94A3B8] hover:bg-white/[0.06] hover:text-white" onClick={link.open} title={`Mở ${sel.token}`}><ExternalLink className="h-4 w-4" aria-hidden /><span className="hidden xl:inline">{sel.token}</span></button>}
          <button className={cn('hidden h-8 w-8 items-center justify-center rounded-md lg:flex', side === 'info' && !threadOf ? 'bg-white/[0.08] text-white' : 'text-[#94A3B8] hover:bg-white/[0.06] hover:text-white')} onClick={() => { setThreadOf(null); setSide((v) => (v === 'info' && !threadOf ? 'none' : 'info')); }} aria-label="Thông tin kênh" title="Thông tin kênh"><Info className="h-[18px] w-[18px]" /></button>
        </header>
        {pins.length > 0 && (
          <div className="border-b border-white/[0.06] px-5 py-2">
            <button className="flex w-full items-center gap-2 text-left text-[13px]" onClick={() => setPinsOpen((v) => !v)} aria-expanded={pinsOpen}>
              <Pin className="h-4 w-4 shrink-0 text-[#F7B23B]" aria-hidden /><span className="min-w-0 flex-1 truncate text-[#CBD5E1]"><b className="text-[#F1F5F9]">{userName(pins[0].authorId)}:</b> {pins[0].text || (pins[0].files ?? []).map((f) => f.name).join(', ')}</span>
              <span className="shrink-0 text-xs text-[#7C8796]">{pins.length} tin ghim</span><ChevronDown className={cn('h-4 w-4 text-[#7C8796] transition-transform', pinsOpen && 'rotate-180')} aria-hidden />
            </button>
            {pinsOpen && <ul className="mt-2 space-y-1">{pins.map((p) => <li key={p.id} className="flex items-center gap-2 rounded-md px-2 py-1.5 text-[13px] hover:bg-white/[0.04]"><button className="min-w-0 flex-1 truncate text-left text-[#CBD5E1]" onClick={() => (p.parentId ? setThreadOf(p.parentId) : jumpTo(p.id))}><b className="text-[#F1F5F9]">{userName(p.authorId)}:</b> {p.text || (p.files ?? []).map((f) => f.name).join(', ')}</button><button className="shrink-0 text-xs text-[#7C8796] hover:text-white" onClick={() => togglePin(p)}>Bỏ ghim</button></li>)}</ul>}
          </div>
        )}
        <div className="min-h-0 flex-1 overflow-y-auto px-5 py-4">
          {tq && <p className="mb-3 rounded-md bg-[#F28C33]/10 px-3 py-2 text-[13px] text-[#F7B23B]">{shown.length} tin khớp “{inThread}” <button className="ml-2 underline" onClick={() => setInThread('')}>Bỏ lọc</button></p>}
          {!roots.length && <EmptyState text={<>Chưa có tin nhắn trong {sel.title}</>} hint={<>Gõ @ để gắn thẻ, # để chèn liên kết, hoặc kéo thả file vào đây để gửi.</>} art="inbox" />}
          {shown.map((c, i) => {
            const day = new Date(c.at).toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
            const sepDay = day !== lastDay; lastDay = day;
            const prev = shown[i - 1];
            const compactRow = !sepDay && !!prev && prev.authorId === c.authorId && c.at - prev.at < 5 * 60000;
            return (
              <Fragment key={c.id}>
                {sepDay && <div className="flex items-center gap-3 py-3 text-xs font-medium text-[#7C8796]"><span className="h-px flex-1 bg-white/[0.06]" />{day}<span className="h-px flex-1 bg-white/[0.06]" /></div>}
                {renderMsg(c, compactRow)}
              </Fragment>
            );
          })}
          <div ref={endRef} />
        </div>
        <div className="px-5 pb-4 pt-1">
          {pendingChips(pending, setPending)}
          <MentionComposer rows={1} placeholder={`Nhắn tới ${sel.title}…`} canSendEmpty={pending.length > 0} onSend={(t, m) => send(t, m)} toolbar={attachBtn((fs) => readFiles(fs, (f) => setPending((p) => [...p, f])))} />
        </div>
      </section>

      {/* ---------- Cột phải: chủ đề (thread) hoặc thông tin kênh dạng accordion ---------- */}
      {parent ? (
        <aside className="hidden w-[340px] shrink-0 flex-col border-l border-white/[0.06] lg:flex">
          <div className="flex items-center gap-2 border-b border-white/[0.06] px-4 py-3.5"><Reply className="h-4 w-4 text-[#94A3B8]" aria-hidden /><div className="min-w-0 flex-1"><p className="font-display text-[15px] font-bold">Chủ đề</p><p className="truncate text-xs text-[#7C8796]">{sel.title}</p></div><button className="rounded p-1.5 text-[#94A3B8] hover:bg-white/10 hover:text-white" onClick={() => setThreadOf(null)} aria-label="Đóng chủ đề"><X className="h-4 w-4" /></button></div>
          <div className="min-h-0 flex-1 overflow-y-auto px-4 py-3">
            {renderMsg(parent, false, true)}
            <div className="my-3 flex items-center gap-3 text-xs text-[#7C8796]"><span className="h-px flex-1 bg-white/[0.06]" />{repliesOf(parent.id).length} trả lời<span className="h-px flex-1 bg-white/[0.06]" /></div>
            {repliesOf(parent.id).map((r) => renderMsg(r, false, true))}
          </div>
          <div className="px-4 pb-4">{pendingChips(replyPending, setReplyPending)}<MentionComposer rows={1} placeholder="Trả lời trong chủ đề…" canSendEmpty={replyPending.length > 0} onSend={(t, m) => send(t, m, parent.id)} toolbar={attachBtn((fs) => readFiles(fs, (f) => setReplyPending((p) => [...p, f])))} /></div>
        </aside>
      ) : side === 'info' && (
        <aside className="hidden w-[300px] shrink-0 flex-col overflow-y-auto border-l border-white/[0.06] lg:flex">
          <details open className="group border-b border-white/[0.06]">
            <summary className="flex cursor-pointer list-none items-center gap-2 px-5 py-4 text-sm font-semibold hover:bg-white/[0.02]"><Users2 className="h-4 w-4 text-[#94A3B8]" aria-hidden />Thành viên<span className="text-[#7C8796]">{members.length}</span><ChevronDown className="ml-auto h-4 w-4 text-[#7C8796] transition-transform group-open:rotate-180" aria-hidden /></summary>
            <ul className="space-y-1 px-3 pb-4">{members.slice(0, 15).map((u) => <li key={u.id} className="flex items-center gap-3 rounded-md px-2 py-1.5"><PAvatar user={u} size={30} meId={me.id} /><span className="min-w-0 flex-1"><span className="block truncate text-sm">{u.name}{u.id === me.id ? ' (bạn)' : ''}</span><span className="block truncate text-xs text-[#7C8796]">{ROLE_LABEL[u.role]}</span></span></li>)}{members.length > 15 && <li className="px-2 text-xs text-[#7C8796]">+{members.length - 15} người khác</li>}</ul>
            {group && (group.createdBy === me.id || role === 'BOD') && (
              <div className="px-5 pb-4"><select className={cn(inputCls, 'py-1.5 text-xs')} value="" onChange={(e) => { const id = e.target.value; if (id) setChannels((p) => p.map((x) => (x.id === group.id ? { ...x, members: [...new Set([...x.members, id])] } : x))); }} aria-label="Thêm thành viên">
                <option value="">+ Thêm thành viên…</option>{users.filter((u) => u.active && !group.members.includes(u.id)).map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}
              </select></div>
            )}
          </details>
          <details className="group border-b border-white/[0.06]">
            <summary className="flex cursor-pointer list-none items-center gap-2 px-5 py-4 text-sm font-semibold hover:bg-white/[0.02]"><Pin className="h-4 w-4 text-[#94A3B8]" aria-hidden />Tin đã ghim<span className="text-[#7C8796]">{pins.length}</span><ChevronDown className="ml-auto h-4 w-4 text-[#7C8796] transition-transform group-open:rotate-180" aria-hidden /></summary>
            <ul className="space-y-1 px-3 pb-4">{pins.map((p) => <li key={p.id}><button className="w-full rounded-md px-2 py-1.5 text-left text-[13px] text-[#CBD5E1] hover:bg-white/[0.04]" onClick={() => (p.parentId ? setThreadOf(p.parentId) : jumpTo(p.id))}><b>{userName(p.authorId)}:</b> {p.text || (p.files ?? []).map((f) => f.name).join(', ')}</button></li>)}{!pins.length && <li className="px-2 text-xs text-[#7C8796]">Rê chuột vào tin nhắn và bấm biểu tượng ghim.</li>}</ul>
          </details>
          <details className="group border-b border-white/[0.06]">
            <summary className="flex cursor-pointer list-none items-center gap-2 px-5 py-4 text-sm font-semibold hover:bg-white/[0.02]"><Paperclip className="h-4 w-4 text-[#94A3B8]" aria-hidden />File đã chia sẻ<span className="text-[#7C8796]">{files.length}</span><ChevronDown className="ml-auto h-4 w-4 text-[#7C8796] transition-transform group-open:rotate-180" aria-hidden /></summary>
            <div className="px-4 pb-4">{files.length ? <ChatFiles files={files.slice().reverse().slice(0, 20).map((x) => x.f)} /> : <p className="px-1 text-xs text-[#7C8796]">Chưa có file.</p>}</div>
          </details>
          {link && <button className="mx-5 mt-4 flex items-center gap-2 text-[13px] text-[#6FA8F0] hover:underline" onClick={link.open}><ExternalLink className="h-4 w-4" aria-hidden />Mở bản ghi {sel.token}</button>}
          {!CLOUD_ON && <p className="mt-auto px-5 pb-4 pt-6 text-[11px] leading-relaxed text-[#5B6577]">File tối đa {fmtSize(CHAT_FILE_MAX)} khi chạy trong trình duyệt; bật máy chủ Supabase để gửi đến {fmtSize(25 * 1048576)}.</p>}
        </aside>
      )}

      {newGroup && (
        <Modal title="Tạo nhóm chat" onClose={() => setNewGroup(false)} footer={<><button className={btnGhost} onClick={() => setNewGroup(false)}>Hủy</button><button className={btnPrimary} onClick={createGroup}>Tạo nhóm</button></>}>
          <div className="space-y-3">
            <Field label="Tên nhóm"><input className={inputCls} value={gName} onChange={(e) => setGName(e.target.value)} placeholder="VD: Dự án KCN Phú Mỹ 3, Phòng EMD Nam…" autoFocus /></Field>
            <Field label="Mô tả (không bắt buộc)"><input className={inputCls} value={gDesc} onChange={(e) => setGDesc(e.target.value)} /></Field>
            <div>
              <p className="mb-1.5 text-xs font-medium text-[#94A3B8]">Thành viên ({gMembers.length} đã chọn)</p>
              <div className="max-h-60 space-y-1 overflow-y-auto rounded border border-white/[0.08] p-2">
                {users.filter((u) => u.active && u.id !== me.id).map((u) => (
                  <label key={u.id} className="flex items-center gap-2.5 rounded px-2 py-1.5 text-sm hover:bg-white/[0.04]">
                    <input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={gMembers.includes(u.id)} onChange={(e) => setGMembers((p) => (e.target.checked ? [...p, u.id] : p.filter((x) => x !== u.id)))} />
                    <PAvatar user={u} size={24} meId={me.id} /><span className="flex-1">{u.name}</span><span className="text-[11px] text-[#94A3B8]">{ROLE_LABEL[u.role]}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>
        </Modal>
      )}
      {newDm && (
        <Modal title="Nhắn tin trực tiếp" onClose={() => setNewDm(false)}>
          <ul className="space-y-1">
            {users.filter((u) => u.active && u.id !== me.id).map((u) => <li key={u.id}><button className="flex w-full items-center gap-3 rounded px-2 py-2 text-left hover:bg-white/[0.05]" onClick={() => { setNewDm(false); open(dmThread(u)); }}><PAvatar user={u} size={32} meId={me.id} /><span className="flex-1"><span className="block text-sm">{u.name}</span><span className="block text-xs text-[#94A3B8]">{ROLE_LABEL[u.role]} · {PRESENCE_META[presenceOf(u, me.id)].label}</span></span></button></li>)}
          </ul>
        </Modal>
      )}
    </div>
  );
}

function OverviewPage() {
  const { company } = useApp();
  const mode = bizMode(company);
  const [view, setView] = useState<'board' | 'trade' | 'mfg'>('board');
  if (mode === 'TRADING') return <TradingOverview />;
  const tabs = mode === 'MFG'
    ? [{ id: 'board' as const, label: 'Bảng điều khiển' }, { id: 'mfg' as const, label: 'Xưởng & công trình' }]
    : [{ id: 'board' as const, label: 'Bảng điều khiển' }, { id: 'mfg' as const, label: 'Xưởng & công trình' }, { id: 'trade' as const, label: 'Thương mại & MDF' }];
  return (
    <div className="space-y-5">
      <Tabs tabs={tabs} value={view} onChange={setView} aside={<DateRangePicker />} />
      {view === 'board' ? <CommandCenter /> : view === 'mfg' ? <MfgOverview /> : <TradingOverview />}
    </div>
  );
}

function TradingOverview() {
  const { company } = useApp();
  const [tab, setTab] = useState<'board' | 'mkt' | 'cust' | 'mdf'>(bizMode(company) === 'TRADING' ? 'board' : 'mdf');
  return (
    <div className="space-y-5">
      <Tabs
        tabs={[
          ...(bizMode(company) === 'TRADING' ? [{ id: 'board' as const, label: 'Bảng điều khiển' }] : []),
          { id: 'mdf', label: 'Quỹ MDF & Marketing' },
          { id: 'mkt', label: 'Data MKT' },
          { id: 'cust', label: 'Khách & dự án' },
        ]}
        value={tab}
        onChange={setTab}
 aside={<DateRangePicker />} />
      {tab === 'board' && <CommandCenter />}
      {tab === 'mkt' && <MktOverview />}
      {tab === 'cust' && <CustomerProjectOverview />}
      {tab === 'mdf' && <div className="space-y-5"><MdfOverview /><TradingReports embedded /></div>}
    </div>
  );
}

function MktOverview() {
  const { myLeads: leads, customers, programs, claims, now, routeLeads, openCustomer, go, canDo, dept, routableDepts, policy } = useApp();
  const canRoute = canDo('lead.route');

  // ---- 1. Hàng thống kê nhanh ----
  const week = leads.filter((l) => l.receivedDaysAgo <= 7);
  const mqlWeek = week.filter((l) => (l.score ?? scoreLead(l, customers)) >= MQL_THRESHOLD).length;
  const slaDone = leads.filter((l) => l.slaMet !== undefined);
  const slaMet = slaDone.filter((l) => l.slaMet).length;
  const quoted = leads.filter((l) => l.status === 'QUOTED');
  const mktCustomers = customers.filter(isMktCustomer);
  const mktRevenue = mktCustomers.reduce((s, c) => s + c.ytdRevenue, 0);

  // ---- 2. Hộp thư lead chờ phân bổ ----
  const inbox = leads.filter((l) => l.status === 'NEW' || l.status === 'NURTURE').slice(0, 6);

  // ---- 3. Khách hàng kết nối chương trình Hãng ----
  const mdfCustomers = customers
    .map((c) => {
      const cClaims = claims.filter((x) => x.customerId === c.id);
      const cProgs = programs.filter((p) => p.customerId === c.id && p.held > 0);
      const amount = cClaims.reduce((s, x) => s + x.claimed, 0) + cProgs.reduce((s, p) => s + p.held, 0);
      const types = Array.from(new Set([...cClaims.map((x) => x.programType), ...cProgs.map((p) => p.type)]));
      const latest = [...cClaims].sort((a, b) => b.code.localeCompare(a.code))[0];
      const status = latest ? claimState(latest, policy.rules) : cProgs[0] ? PROGRAM_STATUS[cProgs[0].status] : null;
      return { c, amount, types, status };
    })
    .filter((r) => r.amount > 0)
    .sort((a, b) => b.amount - a.amount);

  return (
    <div className="space-y-5">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="MQL tuần này" value={`${mqlWeek} lead`} highlight spark={monthly(leads, leadAt)} sub={`${week.length} lead nhận trong 7 ngày`} icon={Inbox} color={C.orange} />
        <StatCard label="Đúng SLA" value={pct(slaMet, slaDone.length)} sub={`${slaMet}/${slaDone.length} lead đã tiếp nhận`} icon={Clock} color={slaDone.length && slaMet / slaDone.length < 0.8 ? C.red : C.teal} />
        <StatCard label="Đang chào giá" value={`${quoted.length} dự án`} sub={`Giá trị BOQ ${compact(quoted.reduce((s, l) => s + boqTotal(l), 0))}`} icon={Target} />
        <StatCard label="Doanh thu MKT" value={compact(mktRevenue)} spark={monthly(leads, (l) => l.wonAt, (l) => l.wonAmount ?? 0)} sub={`${mktCustomers.length} khách hàng đến từ MKT`} icon={TrendingUp} color={C.teal} />
      </div>

      <div className="grid grid-cols-1 gap-5 xl:grid-cols-5">
        <Panel
          className="xl:col-span-3"
          title="Hộp thư lead chờ phân bổ"
          action={<button className={cn(btnGhost, btnSm)} onClick={() => go('leads')}>Mở bảng phân bổ</button>}
        >
          {inbox.length === 0 ? (
            <EmptyState text={<>Không còn lead chờ phân bổ</>} hint={<>Lead mới từ MKT sẽ hiện ở đây.</>} art="inbox" />
          ) : (
            <ul className="divide-y divide-[#263044]">
              {inbox.map((l) => {
                const score = l.score ?? scoreLead(l, customers);
                return (
                  <li key={l.id} className="py-3 first:pt-0 last:pb-0">
                    <div className="flex flex-wrap items-start justify-between gap-2">
                      <div className="min-w-0">
                        <p className="text-sm font-medium text-[#F1F5F9]">{l.company}</p>
                        <p className="text-xs text-[#94A3B8]">{l.boqNote}</p>
                      </div>
                      <Chip tone={score >= 80 ? 'red' : score >= MQL_THRESHOLD ? 'orange' : 'muted'}>
                        {score} điểm{score >= 80 ? ', Hot' : ''}
                      </Chip>
                    </div>
                    <p className="mt-1 text-xs text-[#94A3B8]">Nguồn: {SOURCE_LABEL[l.source]}{l.boqValue > 0 && `, ước tính ${compact(l.boqValue)}`}, {REGION_LABEL[l.region]}</p>
                    <div className="mt-2 flex flex-wrap gap-1.5">
                      {routableDepts.map((rd) => (
                        <button key={rd.code} disabled={!canRoute} className={cn(btnGhost, btnSm)} onClick={() => routeLeads([l.id], rd.code)}>
                          {rd.short}
                        </button>
                      ))}
                    </div>
                    {l.status === 'NURTURE' && <p className="mt-1.5 text-xs text-[#94A3B8]">Điểm dưới {MQL_THRESHOLD}, đang giữ lại để MKT nuôi dưỡng.</p>}
                  </li>
                );
              })}
            </ul>
          )}
        </Panel>

        <Panel className="xl:col-span-2" title="Tiến độ xử lý theo phòng ban">
          <ul className="space-y-3">
            {routableDepts.map(({ code }) => {
              const Icon = deptIcon(code);
              const list = leads.filter((l) => l.dept === code);
              const open = list.filter((l) => OPEN_STATUSES.includes(l.status)).length;
              const overdue = list.filter((l) => isAcceptLate(l, now) || isQuoteOverdue(l, now)).length;
              const q = list.filter((l) => l.status === 'QUOTED').length;
              const mdf = programs.filter((p) => p.dept === code && ['PENDING_INTERNAL', 'PENDING_VENDOR', 'APPROVED'].includes(p.status)).length;
              return (
                <li key={code} className="rounded bg-[#1C2534] p-3">
                  <p className="flex items-center gap-2 text-sm font-medium text-[#F1F5F9]"><Icon className="h-4 w-4 text-[#94A3B8]" aria-hidden />{dept(code)?.name}</p>
                  <div className="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-xs text-[#94A3B8]">
                    <span><b className="font-semibold tabular-nums text-[#F1F5F9]">{open}</b> lead đang xử lý</span>
                    <span><b className="font-semibold tabular-nums text-[#F1F5F9]">{q}</b> đang chào giá</span>
                    <span><b className="font-semibold tabular-nums text-[#F1F5F9]">{mdf}</b> đề xuất MDF</span>
                    <span className={overdue ? 'text-[#F87171]' : ''}><b className="font-semibold tabular-nums">{overdue}</b> quá hạn SLA / báo giá</span>
                  </div>
                </li>
              );
            })}
          </ul>
        </Panel>
      </div>

      <Panel title="Khách hàng kết nối chương trình Hãng" action={<button className={cn(btnGhost, btnSm)} onClick={() => go('customers')}>Xem tất cả khách hàng</button>}>
        <Table head={['Tên khách hàng', 'Phòng ban', 'Tài trợ MDF', 'Doanh số đạt (YTD)', 'Trạng thái claim']} minW={720}>
          {mdfCustomers.map(({ c, amount, types, status }) => (
            <tr key={c.id} className={cn(rowCls, 'cursor-pointer')} onClick={() => openCustomer(c.id)}>
              <td className={tdFirst}>
                <p className="font-medium text-[#F1F5F9]">{c.name}</p>
                <p className="text-xs text-[#94A3B8]">{c.code}</p>
              </td>
              <td className={tdCls}>{dept(c.dept)?.short}</td>
              <td className={tdCls}>
                <p className="tabular-nums text-[#F1F5F9]">{compact(amount)}</p>
                <p className="text-xs text-[#94A3B8]">{types.map((t) => progName(t)).join(', ')}</p>
              </td>
              <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{compact(c.ytdRevenue)}</td>
              <td className={tdLast}>{status && <Chip tone={status.tone}>{status.label}</Chip>}</td>
            </tr>
          ))}
        </Table>
      </Panel>
    </div>
  );
}

function CustomerProjectOverview() {
  const { customers, myLeads: leads, userName, dept, openCustomer, go } = useApp();
  const vip = customers.filter((c) => c.tier === 'DIAMOND' || c.tier === 'GOLD').length;
  const pipeline = leads.filter((l) => l.status === 'ACCEPTED' || l.status === 'QUOTED');
  const won = leads.filter((l) => l.status === 'WON').length;
  const lost = leads.filter((l) => l.status === 'LOST').length;
  const stages: LeadStatus[] = ['ACCEPTED', 'QUOTED', 'WON'];
  const maxVal = Math.max(1, ...stages.map((s) => leads.filter((l) => l.status === s).reduce((a, l) => a + boqTotal(l), 0)));
  const top = [...customers].sort((a, b) => b.ytdRevenue - a.ytdRevenue).slice(0, 6);

  return (
    <div className="space-y-5">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Khách chính thức" value={String(customers.length)} sub={`${vip} khách Diamond / Gold`} icon={Users} />
        <StatCard label="Pipeline đang mở" value={compact(pipeline.reduce((s, l) => s + boqTotal(l), 0))} highlight spark={monthly(pipeline, leadAt, (l) => boqTotal(l))} sub={`${pipeline.length} cơ hội đang khảo sát và báo giá`} icon={FolderKanban} color={C.orange} />
        <StatCard label="Tỷ lệ chốt đơn" value={pct(won, won + lost)} sub={`${won} chốt đơn, ${lost} trượt`} icon={Target} color={C.teal} />
        <StatCard label="Doanh số YTD" value={compact(customers.reduce((s, c) => s + c.ytdRevenue, 0))} sub="Tổng các khách hàng" icon={TrendingUp} />
      </div>

      <div className="grid grid-cols-1 gap-5 xl:grid-cols-3">
        <Panel title="Giá trị pipeline theo giai đoạn" action={<button className={cn(btnGhost, btnSm)} onClick={() => go('projects')}>Mở Dự án / BOM</button>}>
          <ul className="space-y-3">
            {stages.map((s) => {
              const list = leads.filter((l) => l.status === s);
              const val = list.reduce((a, l) => a + boqTotal(l), 0);
              return (
                <li key={s}>
                  <div className="mb-1 flex justify-between text-sm">
                    <span className="text-[#94A3B8]">{LEAD_STATUS[s].label} ({list.length})</span>
                    <span className="tabular-nums text-[#F1F5F9]">{compact(val)}</span>
                  </div>
                  <ProgressBar value={val} max={maxVal} tone={s === 'WON' ? C.teal : C.orange} />
                </li>
              );
            })}
          </ul>
        </Panel>

        <Panel title="Khách hàng doanh số cao nhất" className="xl:col-span-2">
          <Table head={['Khách hàng', 'Hạng', 'Phòng / phụ trách', 'Doanh số YTD', 'Công nợ / hạn mức']} minW={640}>
            {top.map((c) => {
              const growth = c.lastYearRevenue ? (c.ytdRevenue - c.lastYearRevenue) / c.lastYearRevenue : null;
              return (
                <tr key={c.id} className={cn(rowCls, 'cursor-pointer')} onClick={() => openCustomer(c.id)}>
                  <td className={tdFirst}><p className="font-medium text-[#F1F5F9]">{c.name}</p><p className="text-xs text-[#94A3B8]">MST {c.taxCode}</p></td>
                  <td className={tdCls}><Chip tone={tierInfo(c.tier).tone}>{tierInfo(c.tier).label}</Chip></td>
                  <td className={tdCls}><p>{dept(c.dept)?.short}</p><p className="text-xs text-[#94A3B8]">{userName(c.amId)}</p></td>
                  <td className={tdCls}>
                    <p className="tabular-nums text-[#F1F5F9]">{compact(c.ytdRevenue)}</p>
                    {growth !== null && <p className={cn('text-xs tabular-nums', growth >= 0 ? 'text-[#3DDBB6]' : 'text-[#F87171]')}>{growth >= 0 ? '+' : ''}{(growth * 100).toFixed(0)}% so với năm trước</p>}
                  </td>
                  <td className={cn(tdLast, 'w-40')}>
                    <ProgressBar value={c.debt} max={c.creditLimit} />
                    <p className="mt-1 text-xs tabular-nums text-[#94A3B8]">{compact(c.debt)} / {compact(c.creditLimit)}</p>
                  </td>
                </tr>
              );
            })}
          </Table>
        </Panel>
      </div>
    </div>
  );
}

function BudgetStrip() {
  const { budget } = useApp();
  const available = budget.total - budget.spent - budget.committed;
  return (
    <Panel>
      <div className="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p className="text-sm text-[#94A3B8]">Quỹ MDF + CS năm {budget.fiscalYear} của {budget.vendor}</p>
          <p className="mt-1 text-3xl font-semibold tabular-nums tracking-tight text-[#F1F5F9] sm:text-4xl">
            {vnd(available)}<span className="ml-2 text-base font-normal text-[#94A3B8]">còn khả dụng</span>
          </p>
        </div>
        <p className="text-sm text-[#94A3B8]">Trần quỹ <span className="font-medium tabular-nums text-[#F1F5F9]">{vnd(budget.total)}</span></p>
      </div>
      <div className="mt-5 flex h-4 w-full overflow-hidden rounded-full bg-[#1C2534]" role="img" aria-label={`Đã tiêu ${pct(budget.spent, budget.total)}, đang giữ chỗ ${pct(budget.committed, budget.total)}`}>
        <div style={{ width: `${budget.total ? (budget.spent / budget.total) * 100 : 0}%`, background: GRAD }} />
        <div style={{ width: `${budget.total ? (budget.committed / budget.total) * 100 : 0}%`, background: `repeating-linear-gradient(-45deg, ${C.orange}66 0 6px, ${C.orange}26 6px 12px)` }} />
      </div>
      <div className="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-xs text-[#94A3B8]">
        <span className="flex items-center gap-2"><i className="h-2.5 w-2.5 rounded-sm" style={{ background: C.orange }} />Đã tiêu {compact(budget.spent)}</span>
        <span className="flex items-center gap-2"><i className="h-2.5 w-2.5 rounded-sm" style={{ background: `${C.orange}66` }} />Đang giữ chỗ {compact(budget.committed)}</span>
        <span className="flex items-center gap-2"><i className="h-2.5 w-2.5 rounded-sm bg-[#1C2534] ring-1 ring-[#263044]" />Khả dụng {compact(available)}</span>
      </div>
    </Panel>
  );
}

function MdfOverview() {
  const { budget, claims, programs, canDo } = useApp();
  // Giải ngân lũy kế theo tháng của năm đang xem (3M đã duyệt claim), so với kế hoạch chia đều
  const fy = budget.fiscalYear;
  const nowD = new Date();
  const lastMonth = fy < nowD.getFullYear() ? 12 : fy > nowD.getFullYear() ? 0 : nowD.getMonth() + 1;
  const monthOf = (c: Claim) => { const p = programs.find((x) => x.id === c.programId); const d = claimDate(c) ?? (p ? new Date(`${p.start}T12:00:00`) : null); return d ? d.getMonth() + 1 : 12; };
  const opening = budget.openingSpent ?? 0;
  const burn = Array.from({ length: 12 }, (_, i) => {
    const m = i + 1;
    const cum = opening + claims.filter((c) => claimYear(c, programs) === fy && (c.vendorApproved ?? 0) > 0 && monthOf(c) <= m).reduce((a, c) => a + (c.vendorApproved ?? 0), 0);
    return { month: `T${m}`, actual: m <= lastMonth ? cum : null, plan: (budget.total / 12) * m };
  });
  const alloc = (Object.keys(PROGRAM_LABEL) as ProgramType[]).map((t) => ({
    name: progName(t),
    color: PROGRAM_COLOR[t],
    value:
      claims.filter((c) => c.programType === t).reduce((s, c) => s + c.claimed, 0) +
      programs.filter((p) => p.type === t && p.held > 0 && p.status !== 'CLAIMING').reduce((s, p) => s + p.held, 0),
  }));
  const totalAlloc = alloc.reduce((s, a) => s + a.value, 0);
  const pending = [...claims].filter((c) => !c.submitted).sort((a, b) => a.daysLeft - b.daysLeft).slice(0, 5);

  return (
    <div className="space-y-5">
      <BudgetStrip />

      {canDo('mdf.margin') && <MdfMarginPanel />}

      <div className="grid grid-cols-1 gap-5 xl:grid-cols-3">
        <Panel title="Tốc độ giải ngân so với kế hoạch" className="xl:col-span-2">
          <div className="h-64">
            <ResponsiveContainer width="100%" height="100%">
              <LineChart data={burn} margin={{ top: 8, right: 8, left: -8, bottom: 0 }}>
                <CartesianGrid stroke={C.line} strokeDasharray="3 3" vertical={false} />
                <XAxis dataKey="month" stroke={C.muted} tickLine={false} axisLine={false} fontSize={12} />
                <YAxis stroke={C.muted} tickLine={false} axisLine={false} fontSize={12} tickFormatter={(v) => `${Number(v) / 1e6}tr`} width={56} />
                <Tooltip contentStyle={{ background: C.card, border: `1px solid ${C.line}`, borderRadius: 8, color: C.text }} labelStyle={{ color: C.muted }} formatter={(v, name) => [vnd(Number(v)), name === 'actual' ? 'Thực tế' : 'Kế hoạch']} />
                <Line type="monotone" dataKey="plan" stroke={C.muted} strokeDasharray="5 5" dot={false} strokeWidth={1.5} />
                <Line type="monotone" dataKey="actual" stroke={C.orange} strokeWidth={2.5} dot={{ r: 3, fill: C.orange }} activeDot={{ r: 5 }} />
              </LineChart>
            </ResponsiveContainer>
          </div>
          <p className="mt-2 text-xs text-[#94A3B8]">
            {budget.declared === false ? `Chưa khai báo ngân sách năm ${budget.fiscalYear}. Vào Cài đặt > Quỹ Hãng 3M > Khai báo ngân sách năm mới.` : `Đến tháng ${Math.max(1, lastMonth)} đã giải ngân ${compact(budget.spent)}, ${budget.spent < (budget.total / 12) * Math.max(1, lastMonth) ? `chậm ${compact((budget.total / 12) * Math.max(1, lastMonth) - budget.spent)}` : `vượt ${compact(budget.spent - (budget.total / 12) * Math.max(1, lastMonth))}`} so với kế hoạch tuyến tính.`}
          </p>
        </Panel>

        <Panel title="Phân bổ theo hạng mục">
          <div className="relative h-48">
            <ResponsiveContainer width="100%" height="100%">
              <PieChart>
                <Pie data={alloc} dataKey="value" nameKey="name" innerRadius={58} outerRadius={82} paddingAngle={2} stroke="none">
                  {alloc.map((a) => <Cell key={a.name} fill={a.color} />)}
                </Pie>
                <Tooltip contentStyle={{ background: C.card, border: `1px solid ${C.line}`, borderRadius: 8 }} itemStyle={{ color: C.text }} formatter={(v) => vnd(Number(v))} />
              </PieChart>
            </ResponsiveContainer>
            <div className="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
              <span className="text-lg font-semibold tabular-nums text-[#F1F5F9]">{compact(totalAlloc)}</span>
              <span className="text-xs text-[#94A3B8]">đã phân bổ</span>
            </div>
          </div>
          <ul className="mt-3 space-y-2">
            {alloc.map((a) => (
              <li key={a.name} className="flex items-center justify-between text-sm">
                <span className="flex items-center gap-2 text-[#94A3B8]"><i className="h-2.5 w-2.5 rounded-full" style={{ background: a.color }} />{a.name}</span>
                <span className="tabular-nums text-[#F1F5F9]">{pct(a.value, totalAlloc)}</span>
              </li>
            ))}
          </ul>
        </Panel>
      </div>

      <Panel title="5 chiến dịch chờ claim hoàn ứng gấp nhất">
        <ClaimTable claims={pending} />
      </Panel>
    </div>
  );
}

function ClaimTable({ claims }: { claims: Claim[] }) {
  const { openClaim, customers, policy, canDo } = useApp();
  const showMargin = canDo('mdf.margin');
  if (!claims.length) return <EmptyState text={<>Không có hồ sơ nào.</>} art="doc" />;
  return (
    <>
    <div className="space-y-2 md:hidden">
      {claims.map((c) => {
        const st = claimState(c, policy.rules);
        const checks = auditClaim(c, policy.rules);
        return (
          <MobileRow key={c.id} title={c.programTitle} sub={`${c.code}, ${c.submitted ? 'đã nộp' : `còn ${c.daysLeft} ngày`}, chứng từ ${checks.filter((x) => x.passed).length}/${checks.length}`}
            badge={<span className="shrink-0 text-xs text-[#94A3B8]">{progName(c.programType)}</span>} value={compact(c.claimed)} status={<Chip tone={st.tone}>{st.label}</Chip>} onClick={() => openClaim(c.id)} />
        );
      })}
    </div>
    <div className="hidden md:block">
    <Table head={['Mã claim', 'Chương trình', 'Số tiền claim', 'Chứng từ', 'Hạn nộp', ...(showMargin ? ['Thặng dư / hoàn quỹ'] : []), 'Trạng thái']} minW={showMargin ? 940 : 760}>
      {claims.map((c) => {
        const checks = auditClaim(c, policy.rules);
        const passed = checks.filter((i) => i.passed).length;
        const st = claimState(c, policy.rules);
        const cust = customers.find((k) => k.id === c.customerId);
        return (
          <tr
            key={c.id}
            tabIndex={0}
            onClick={() => openClaim(c.id)}
            onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openClaim(c.id); } }}
            className={cn(rowCls, 'cursor-pointer outline-none focus-visible:bg-[#1C2534]')}
          >
            <td className={cn(tdFirst, 'font-medium text-[#F1F5F9]')}>{c.code}</td>
            <td className={tdCls}>
              <p className="max-w-[300px] truncate text-[#F1F5F9]">{c.programTitle}</p>
              <p className="text-xs text-[#94A3B8]">{progName(c.programType)}{cust ? `, ${cust.name}` : ''}</p>
            </td>
            <td className={cn(tdCls, 'text-right tabular-nums text-[#F1F5F9]')}>{vnd(c.claimed)}</td>
            <td className={tdCls}>
              <div className="flex items-center gap-2">
                <div className="w-16"><ProgressBar value={passed} max={checks.length} tone={blockersOf(c, policy.rules) ? C.orange : C.teal} /></div>
                <span className="text-xs tabular-nums text-[#94A3B8]">{passed}/{checks.length}</span>
              </div>
            </td>
            <td className={tdCls}>
              {c.submitted ? <span className="text-[#94A3B8]">Đã nộp</span> : <span className={cn('tabular-nums', c.daysLeft <= 3 ? 'text-[#F87171]' : 'text-[#F1F5F9]')}>Còn {c.daysLeft} ngày</span>}
            </td>
            {showMargin && <td className={tdCls}><MarginBadge c={c} /></td>}
            <td className={tdLast}><Chip tone={st.tone}>{st.label}</Chip></td>
          </tr>
        );
      })}
    </Table>
    </div>
    </>
  );
}

// =====================================================================
//  DATA MKT — danh sách lead, thêm mới, nhập từ CSV
// =====================================================================

function DataMktPage() {
  const { leads: allLeads, myLeads: leads, setLeads, customers, notify, presetQuery, canDo, userName, dept, openWin } = useApp();
  const [q, setQ] = useState(presetQuery);
  const [status, setStatus] = useState<string>('ALL');
  const [src, setSrc] = useState<'ALL' | Source>('ALL');
  const inR = useInRange();
  const [dp, setDp] = useState('ALL');
  const [modal, setModal] = useState<'add' | 'import' | null>(null);
  const [editId, setEditId] = useState<string | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const canEdit = canDo('lead.create');

  const list = leads.filter((l) => {
    const t = q.trim().toLowerCase();
    const hit = !t || [l.company, l.code, l.taxCode ?? '', l.contact, l.phone].some((v) => v.toLowerCase().includes(t));
    return hit && (status === 'ALL' || l.status === status) && (src === 'ALL' || l.source === src) && (dp === 'ALL' || l.dept === dp) && inR(leadDate(l));
  });

  const paged = usePaged(list, 12);
  const sel = useSelection(list.map((l) => l.id));
  const { routeLeads, routableDepts } = useApp();

  const importSpec: ImportSpec<LeadForm> = {
    title: 'Nhập lead từ file CSV',
    templateName: 'mau_nhap_lead.csv',
    headers: ['ten_cong_ty', 'nguoi_lien_he', 'so_dien_thoai', 'mst', 'email', 'phan_khuc', 'khu_vuc', 'nguon', 'gia_tri_uoc_tinh', 'nhu_cau'],
    sample: ['Công ty CP Cơ điện ABC', 'Nguyễn Văn A', '0903123456', '0312345678', 'a.nv@abc.vn', 'Tổng thầu / Nhà thầu M&E', 'Miền Nam', 'Google Ads', '1500000000', 'Đầu cáp co nguội 24kV cho trạm biến áp'],
    parseRow: (r) => {
      const segment = r.phan_khuc ? matchEnum(r.phan_khuc, SEGMENT_LABEL) : 'OTHER';
      if (!segment) return { ok: false, error: `Phân khúc "${r.phan_khuc}" không hợp lệ` };
      const source = r.nguon ? matchEnum(r.nguon, SOURCE_LABEL) : 'WEBSITE_FORM';
      if (!source) return { ok: false, error: `Nguồn "${r.nguon}" không hợp lệ` };
      const region = matchEnum(r.khu_vuc || 'Miền Nam', REGION_LABEL) ?? (/b[aắ]c/i.test(r.khu_vuc) ? 'NORTH' : /nam/i.test(r.khu_vuc) ? 'SOUTH' : undefined);
      if (!region) return { ok: false, error: `Khu vực "${r.khu_vuc}" không hợp lệ (Miền Bắc / Miền Nam)` };
      const form: LeadForm = { company: r.ten_cong_ty, contact: r.nguoi_lien_he, phone: r.so_dien_thoai, taxCode: r.mst, email: r.email, segment, source, region, province: '', boqValue: digits(r.gia_tri_uoc_tinh), boqNote: r.nhu_cau, attachments: [] };
      const e = validateLead(form, allLeads);
      const first = Object.values(e)[0];
      return first ? { ok: false, error: first } : { ok: true, item: form };
    },
    onImport: (items) => {
      const seen = new Set<string>();
      const codes = allLeads.map((l) => l.code);
      const created: Lead[] = [];
      for (const f of items) {
        if (f.taxCode && seen.has(f.taxCode)) continue; // trùng MST trong cùng file
        if (f.taxCode) seen.add(f.taxCode);
        const code = nextCode(codes, 'LD-2026-', 4);
        codes.push(code);
        created.push(formToLead(f, code));
      }
      setLeads((p) => [...created, ...p]);
      notify(`Đã nhập ${created.length} lead vào hộp chờ phân bổ`, 'teal');
    },
  };

  const exportCsv = () =>
    downloadCsv('danh_sach_lead.csv', [
      ['ma', 'cong_ty', 'nguoi_lien_he', 'so_dien_thoai', 'mst', 'phan_khuc', 'nguon', 'gia_tri_boq', 'diem', 'trang_thai', 'phong_ban', 'phu_trach'],
      ...list.map((l) => [l.code, l.company, l.contact, l.phone, l.taxCode ?? '', segName(l.segment), SOURCE_LABEL[l.source], boqTotal(l), l.score ?? scoreLead(l, customers), LEAD_STATUS[l.status].label, dept(l.dept)?.short ?? '', userName(l.assignee)]),
    ]);

  return (
    <div className="space-y-5">
      <FilterBar
        q={q} onQ={setQ} placeholder="Tìm MST, tên khách, mã lead, SĐT"
        dept={dp} onDept={setDp} status={status} onStatus={setStatus} extraActive={src !== 'ALL' ? 1 : 0}
        statusOptions={(Object.keys(LEAD_STATUS) as LeadStatus[]).map((s) => ({ value: s, label: LEAD_STATUS[s].label }))}
      >
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={src} onChange={(e) => setSrc(e.target.value as 'ALL' | Source)} aria-label="Lọc nguồn">
          <option value="ALL">Mọi nguồn</option>
          {(Object.keys(SOURCE_LABEL) as Source[]).map((s) => <option key={s} value={s}>{SOURCE_LABEL[s]}</option>)}
        </select>
      </FilterBar>

      <BulkBar count={sel.ids.length} onClear={sel.clear}>
        <select className={cn(inputBase, 'w-auto py-1 text-xs')} disabled={!canDo('lead.route')} value="" onChange={(e) => { if (!e.target.value) return; const ids = allLeads.filter((l) => sel.has(l.id) && ['NEW', 'NURTURE', 'ROUTED'].includes(l.status)).map((l) => l.id); routeLeads(ids, e.target.value); sel.clear(); }} aria-label="Phân về phòng">
          <option value="">Phân về phòng...</option>
          {routableDepts.map((d) => <option key={d.code} value={d.code}>{d.name}</option>)}
        </select>
        <button className={cn(btnGhost, btnSm, 'hover:text-[#F87171]')} disabled={!canEdit} onClick={() => {
          const ok = allLeads.filter((l) => sel.has(l.id) && l.status !== 'WON');
          setConfirm({ title: 'Xóa lead đã chọn', message: <>Xóa {ok.length} lead đã chọn? Lead đã chốt đơn được giữ lại.</>, blocked: ok.length ? undefined : 'Các lead đã chọn đều đã chốt đơn.', onConfirm: () => { setLeads((p) => p.filter((l) => !ok.some((x) => x.id === l.id))); sel.clear(); notify(`Đã xóa ${ok.length} lead`, 'orange'); } });
        }}><Trash2 className="h-3.5 w-3.5" aria-hidden />Xóa</button>
      </BulkBar>

      <Panel
        title={`${list.length} lead`}
        action={
          <div className="flex gap-2">
            <RowMenu text="Dữ liệu" icon={FileSpreadsheet} items={[{ label: 'Xuất CSV', icon: Download, onClick: exportCsv }, { label: 'Nhập từ file', icon: Upload, onClick: () => setModal('import'), disabled: !canEdit }]} />
            <button className={cn(btnPrimary, btnSm, 'max-lg:hidden')} disabled={!canEdit} onClick={() => setModal('add')}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm lead</button>
          </div>
        }
      >
        <div className="space-y-2 md:hidden">
          {paged.slice.map((l) => (
            <MobileRow key={l.id} avatar={l.company} title={l.company} sub={`${l.code}, ${l.phone}, ${l.province ?? REGION_LABEL[l.region]}`}
              badge={<Chip tone={(l.score ?? scoreLead(l, customers)) >= 80 ? 'red' : 'orange'}>{l.score ?? scoreLead(l, customers)}</Chip>}
              value={boqTotal(l) ? compact(boqTotal(l)) : '—'} status={<Chip tone={LEAD_STATUS[l.status].tone}>{LEAD_STATUS[l.status].label}</Chip>}
              menu={<RowMenu items={[{ label: 'Sửa lead', icon: Pencil, onClick: () => setEditId(l.id), disabled: !canEdit }, ...(l.status === 'QUOTED' ? [{ label: 'Chốt đơn', icon: CheckCircle2, onClick: () => openWin(l.id), disabled: !canDo('project.update') }] : [])]} />} />
          ))}
        </div>
        <div className="hidden md:block">
        <Table head={[<input key="all" type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={sel.allOn} onChange={sel.toggleAll} aria-label="Chọn tất cả" />, 'Mã lead', 'Công ty / liên hệ', 'MST', 'Nhóm / nguồn', 'Giá trị', 'Điểm', 'Trạng thái', 'Phòng ban / phụ trách', '']} minW={1000}>
          {paged.slice.map((l) => {
            const score = l.score ?? scoreLead(l, customers);
            return (
              <tr key={l.id} className={rowCls}>
                <td className={cn(tdFirst, 'w-10')}><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={sel.has(l.id)} onChange={() => sel.toggle(l.id)} aria-label={`Chọn ${l.code}`} /></td>
                <td className={tdCls}><p className="font-medium text-[#F1F5F9]">{l.code}</p><p className="text-xs text-[#94A3B8]">{l.receivedDaysAgo === 0 ? 'Hôm nay' : `${l.receivedDaysAgo} ngày trước`}</p></td>
                <td className={cn(tdCls, 'max-w-[230px]')}><p className="truncate text-[#F1F5F9]" title={l.company}>{l.company}</p><p className="truncate text-xs text-[#94A3B8]">{l.contact}, {l.phone}</p></td>
                <td className={cn(tdCls, 'tabular-nums')}>{l.taxCode ?? <span className="text-[#94A3B8]">Chưa có</span>}{findByTax(customers, l.taxCode) && <p><Chip tone="teal">Khách hiện hữu</Chip></p>}</td>
                <td className={tdCls}><p>{segName(l.segment)}</p><p className="text-xs text-[#94A3B8]">{SOURCE_LABEL[l.source]}, {REGION_LABEL[l.region]}</p></td>
                <td className={cn(tdCls, 'tabular-nums')}>{boqTotal(l) ? compact(boqTotal(l)) : '—'}<p className="text-xs text-[#94A3B8]">{boqIsEstimate(l) ? 'Ước tính' : 'Theo BOQ'}</p>{l.attachments?.length ? <p className="flex items-center gap-1 text-xs text-[#6FA8F0]"><Paperclip className="h-3 w-3" aria-hidden />{l.attachments.length} file</p> : null}</td>
                <td className={tdCls}><Chip tone={score >= 80 ? 'red' : score >= MQL_THRESHOLD ? 'orange' : 'muted'}>{score}</Chip></td>
                <td className={tdCls}>
                  <Chip tone={LEAD_STATUS[l.status].tone}>{LEAD_STATUS[l.status].label}</Chip>
                  {l.status === 'LOST' && l.lostReason && <p className="mt-1 text-xs text-[#F87171]">{LOST_REASON[l.lostReason]}</p>}
                  {l.status === 'QUOTED' && <button disabled={!canDo('project.update')} className={cn(btnBase, btnSm, 'mt-1.5 flex bg-[#00B894]/15 text-[#3DDBB6] hover:bg-[#00B894]/25')} onClick={() => openWin(l.id)}>Chốt đơn</button>}
                  {l.getflySync?.status === 'SYNCED' && <p className="mt-1 text-xs text-[#3DDBB6]">Getfly {l.getflySync.orderCode}</p>}
                </td>
                <td className={tdCls}>{l.dept ? <><p>{dept(l.dept)?.short}</p><p className="text-xs text-[#94A3B8]">{userName(l.assignee)}</p></> : <span className="text-[#94A3B8]">Chưa phân bổ</span>}</td>
                <td className={cn(tdLast, 'whitespace-nowrap text-right')}>
                  <button className={cn(btnGhost, 'mr-1 p-1.5')} disabled={!canEdit} onClick={() => setEditId(l.id)} aria-label={`Sửa ${l.code}`}><Pencil className="h-3.5 w-3.5" /></button>
                  <button className={cn(btnGhost, 'p-1.5 hover:text-[#F87171]')} disabled={!canEdit} onClick={() => setConfirm({
                    title: 'Xóa lead',
                    message: <>Xóa lead <b>{l.code}</b> {l.company}?</>,
                    blocked: l.status === 'WON' ? 'Lead đã chốt đơn và gắn khách hàng / đơn Getfly, không thể xóa.' : undefined,
                    onConfirm: () => { setLeads((p) => p.filter((x) => x.id !== l.id)); notify(`Đã xóa lead ${l.code}`, 'orange'); },
                  })} aria-label={`Xóa ${l.code}`}><Trash2 className="h-3.5 w-3.5" /></button>
                </td>
              </tr>
            );
          })}
        </Table>
        </div>
        {!list.length && <EmptyState text={<>Không có lead khớp bộ lọc.</>} art="search" />}
        <Pagination paged={paged} unit="lead" />
      </Panel>
      {canEdit && <Fab label="Thêm lead" onClick={() => setModal('add')} />}

      {modal === 'add' && <LeadFormModal onClose={() => setModal(null)} />}
      {editId && <LeadFormModal id={editId} onClose={() => setEditId(null)} />}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
      {modal === 'import' && <ImportModal spec={importSpec} onClose={() => setModal(null)} />}
    </div>
  );
}

// =====================================================================
//  PHÂN BỔ PHÒNG BAN — kéo-thả, SLA đếm ngược
// =====================================================================

// =====================================================================
//  PHÂN LEAD 2 BƯỚC — B1: MKT phân về phòng ban | B2: Trưởng phòng chỉ định Sales
//  Sales tiếp nhận trong SLA 2 giờ, sau đó khảo sát & nộp báo giá trong 24 giờ
// =====================================================================

function SlaTimer({ deadline, now }: { deadline: number; now: number | null }) {
  if (now == null) return <span className="text-xs text-[#94A3B8]">--:--</span>;
  const diff = deadline - now;
  if (diff < 0) return <Chip tone="red"><AlertTriangle className="h-3 w-3" aria-hidden />Quá SLA {fmtDur(diff)}</Chip>;
  return <Chip tone={diff < 30 * 6e4 ? 'orange' : 'muted'}><Clock className="h-3 w-3" aria-hidden />Còn {fmtDur(diff)}</Chip>;
}

const overdueCls = 'border-[#EF4444] motion-safe:animate-[blinkBorder_1.2s_ease-in-out_infinite]';

function AssignModal({ lead, onClose }: { lead: Lead; onClose: () => void }) {
  const { users, leads, assignLead, dept } = useApp();
  const reps = users.filter((u) => u.active && u.role === 'SALES_REP' && u.dept === lead.dept);
  const load = (id: string) => leads.filter((x) => x.assignee === id && OPEN_STATUSES.includes(x.status)).length;
  const minLoad = Math.min(...reps.map((r) => load(r.id)));
  const [pick, setPick] = useState(reps.find((r) => load(r.id) === minLoad)?.id ?? '');
  const d = dept(lead.dept);

  return (
    <Modal
      title="Chỉ định Sales phụ trách"
      onClose={onClose}
      footer={
        <>
          <button className={btnGhost} onClick={onClose}>Hủy</button>
          <button className={btnPrimary} disabled={!pick} onClick={() => { assignLead(lead.id, pick); onClose(); }}>
            <Clock className="h-4 w-4" aria-hidden />Chỉ định và bắt đầu SLA {d?.slaMinutes ?? 120} phút
          </button>
        </>
      }
    >
      <div className="mb-4 rounded bg-[#1C2534] p-3 text-sm">
        <p className="font-medium text-[#F1F5F9]">{lead.company}</p>
        <p className="text-xs text-[#94A3B8]">{lead.code}, {lead.boqNote}{boqTotal(lead) ? `, ${boqIsEstimate(lead) ? 'ước tính' : 'BOQ'} ${compact(boqTotal(lead))}` : ''}</p>
        <p className="mt-1 text-xs text-[#94A3B8]">Phân về {d?.name}: {lead.routingReason}</p>
      </div>
      {reps.length === 0 ? (
        <p className="text-sm text-[#F87171]">Phòng chưa có Sales đang hoạt động. Thêm nhân sự ở Cài đặt &gt; Phòng ban & Nhân sự.</p>
      ) : (
        <fieldset className="space-y-2">
          <legend className="mb-2 text-xs font-medium text-[#94A3B8]">Sales trực thuộc {d?.short}</legend>
          {reps.map((r) => (
            <label key={r.id} className={cn('flex cursor-pointer items-center gap-3 rounded border px-3 py-2.5', pick === r.id ? 'border-[#F28C33] bg-[#F28C33]/5' : 'border-[#263044] hover:bg-[#1C2534]')}>
              <input type="radio" name="rep" className="accent-[#F28C33]" checked={pick === r.id} onChange={() => setPick(r.id)} />
              <span className="flex h-8 w-8 items-center justify-center rounded-full bg-[#1C2534] text-xs font-semibold text-[#F7B23B]">{initials(r.name)}</span>
              <span className="min-w-0 flex-1">
                <span className="block text-sm text-[#F1F5F9]">{r.name}</span>
                <span className="block text-xs text-[#94A3B8]">{r.phone ?? r.email}</span>
              </span>
              <span className="text-right text-xs">
                <span className="block tabular-nums text-[#F1F5F9]">{load(r.id)} lead đang xử lý</span>
                {load(r.id) === minLoad && reps.length > 1 && <span className="text-[#3DDBB6]">Ít việc nhất</span>}
              </span>
            </label>
          ))}
        </fieldset>
      )}
    </Modal>
  );
}

function LeadCard({ l, now, action, onMenu, compact: small }: { l: Lead; now: number | null; action?: ReactNode; onMenu?: MenuItem[]; compact?: boolean }) {
  const { userName } = useApp();
  const late = isAcceptLate(l, now) || isQuoteOverdue(l, now);
  return (
    <article className={cn('rounded-md border bg-[#1C2534] p-3', late ? overdueCls : 'border-[#263044]')}>
      <div className="flex items-start justify-between gap-2">
        <p className="min-w-0 text-sm font-medium leading-snug text-[#F1F5F9]">{l.company}</p>
        <AgeBadge hours={leadAgeH(l, now)} />
      </div>
      {!small && <p className="mt-0.5 line-clamp-2 text-xs text-[#94A3B8]">{l.boqNote}</p>}
      <div className="mt-2 space-y-0.5 text-xs text-[#94A3B8]">
        <p className="flex items-center gap-1.5"><MapPin className="h-3 w-3" aria-hidden />{l.province ?? REGION_LABEL[l.region]}</p>
        <p className="flex items-center gap-1.5"><Users className="h-3 w-3" aria-hidden />{l.assignee ? userName(l.assignee) : l.dept ? 'Chờ chỉ định' : 'MKT'}</p>
      </div>
      {l.status === 'ASSIGNED' && <div className="mt-2"><SlaTimer deadline={l.slaDeadline ?? 0} now={now} /></div>}
      {l.status === 'ACCEPTED' && <div className="mt-2"><QuoteTimer deadline={l.quoteDeadline} now={now} /></div>}
      {(action || onMenu) && (
        <div className="mt-2.5 flex items-center justify-end gap-1.5">
          {action}
          {onMenu && <RowMenu items={onMenu} />}
        </div>
      )}
    </article>
  );
}

const STEP_COLORS = [C.orange, '#F6B533', C.blue, C.teal];

function AllocationPage() {
  const { myLeads: leads, setLeads, customers, now, routeLeads, acceptLead, canDo, routableDepts, me, role, simulateNewLead, simulateQuoteOverdue, openLeadForm, notify } = useApp();
  const inR = useInRange();
  const [q, setQ] = useState('');
  const [reg, setReg] = useState<'ALL' | Region>('ALL');
  const [seg, setSeg] = useState('ALL');
  const [st, setSt] = useState('ALL');
  const [dragOver, setDragOver] = useState<DeptCode | null>(null);
  const [assigning, setAssigning] = useState<Lead | null>(null);
  const [expanded, setExpanded] = useState<string[]>([]);
  const [openCol, setOpenCol] = useState<string>('INBOX');
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const [view, setView] = useState<'table' | 'board'>('table');
  const { userName, dept: deptOf } = useApp();
  const canRoute = canDo('lead.route');
  const canAssignIn = (d?: DeptCode) => canDo('lead.assign') && (role === 'BOD' || me.dept === d);
  const canAcceptLead = (l: Lead) => canDo('lead.accept') && (role === 'BOD' || (role === 'DEPT_HEAD' && me.dept === l.dept) || l.assignee === me.id);

  const match = (l: Lead) => {
    const t = q.trim().toLowerCase();
    return (!t || [l.company, l.code, l.taxCode ?? '', l.phone].some((v) => v.toLowerCase().includes(t))) && (st === 'ALL' || l.status === st) && (reg === 'ALL' || l.region === reg) && (seg === 'ALL' || l.segment === seg) && inR(leadDate(l));
  };
  const scope = leads.filter((l) => inR(leadDate(l)));
  const total = scope.length;
  const atLeast = (arr: LeadStatus[]) => scope.filter((l) => arr.includes(l.status)).length;
  const steps: [string, number][] = [
    ['Phân về phòng ban', atLeast(['ROUTED', 'ASSIGNED', 'ACCEPTED', 'QUOTED', 'WON', 'LOST'])],
    ['Trưởng phòng chỉ định', atLeast(['ASSIGNED', 'ACCEPTED', 'QUOTED', 'WON', 'LOST'])],
    ['Sales tiếp nhận', atLeast(['ACCEPTED', 'QUOTED', 'WON', 'LOST'])],
    ['Khảo sát & báo giá', atLeast(['QUOTED', 'WON', 'LOST'])],
  ];
  const unrouted = leads.filter((l) => (l.status === 'NEW' || l.status === 'NURTURE') && match(l));
  const late = scope.filter((l) => isAcceptLate(l, now) || isQuoteOverdue(l, now)).length;
  const depts = role === 'BOD' || role === 'MKT_LEAD' ? routableDepts : routableDepts.filter((d) => d.code === me.dept);

  const onDrop = (e: DragEvent, code: DeptCode) => {
    e.preventDefault();
    setDragOver(null);
    const id = e.dataTransfer.getData('text/plain');
    if (id && canRoute) routeLeads([id], code);
  };
  const menuFor = (l: Lead): MenuItem[] => [
    { label: 'Sửa thông tin lead', icon: Pencil, onClick: () => openLeadForm(false, l.id), disabled: !canDo('lead.create') },
    ...(l.status === 'NEW' ? [{ label: 'Chuyển nuôi dưỡng', icon: Clock, onClick: () => setLeads((p) => p.map((x) => (x.id === l.id ? { ...x, status: 'NURTURE' as LeadStatus } : x))), disabled: !canRoute }] : []),
    ...(l.status === 'NURTURE' ? [{ label: 'Đưa về chờ phân phòng', icon: Inbox, onClick: () => setLeads((p) => p.map((x) => (x.id === l.id ? { ...x, status: 'NEW' as LeadStatus } : x))), disabled: !canRoute }] : []),
    ...(['NEW', 'NURTURE', 'ROUTED'].includes(l.status) ? routableDepts.filter((d) => d.code !== l.dept).map((d) => ({ label: `Phân về ${d.short}`, icon: ArrowRight, onClick: () => routeLeads([l.id], d.code), disabled: !canRoute })) : []),
    ...(l.phone ? [{ label: `Gọi ${l.phone}`, icon: Phone, onClick: () => { window.location.href = `tel:${l.phone.replace(/\s/g, '')}`; } }] : []),
    { label: 'Xóa lead', icon: Trash2, danger: true, disabled: !canDo('lead.create'), onClick: () => setConfirm({ title: 'Xóa lead', message: <>Xóa lead <b>{l.code}</b> {l.company}?</>, onConfirm: () => { setLeads((p) => p.filter((x) => x.id !== l.id)); notify(`Đã xóa lead ${l.code}`, 'orange'); } }) },
  ];
  const limit = (key: string, arr: Lead[], n = 4) => (expanded.includes(key) ? arr : arr.slice(0, n));
  const more = (key: string, arr: Lead[], n = 4) => arr.length > n && (
    <button className="w-full rounded py-2 text-center text-xs text-[#94A3B8] hover:bg-[#1C2534] hover:text-[#F1F5F9]" onClick={() => setExpanded((p) => (p.includes(key) ? p.filter((x) => x !== key) : [...p, key]))}>
      {expanded.includes(key) ? 'Thu gọn' : `Xem thêm ${arr.length - n} lead`}
    </button>
  );

  /** Bảng hợp nhất: lead chờ phân phòng + lead đang xử lý trong các phòng */
  const flow = ['NEW', 'NURTURE', 'ROUTED', 'ASSIGNED', 'ACCEPTED'];
  const tableRows = [...unrouted, ...leads.filter((l) => !!l.dept && depts.some((d) => d.code === l.dept) && match(l) && ['ROUTED', 'ASSIGNED', 'ACCEPTED'].includes(l.status))]
    .sort((x, y) => Number(isAcceptLate(y, now) || isQuoteOverdue(y, now)) - Number(isAcceptLate(x, now) || isQuoteOverdue(x, now)) || flow.indexOf(x.status) - flow.indexOf(y.status) || leadAgeH(y, now) - leadAgeH(x, now));
  const paged = usePaged(tableRows, 10);
  const sel = useSelection(tableRows.filter((l) => ['NEW', 'NURTURE', 'ROUTED'].includes(l.status)).map((l) => l.id));
  const slaCell = (l: Lead) => l.status === 'ASSIGNED' ? <SlaTimer deadline={l.slaDeadline ?? 0} now={now} /> : l.status === 'ACCEPTED' ? <QuoteTimer deadline={l.quoteDeadline} now={now} /> : <AgeBadge hours={leadAgeH(l, now)} />;
  const actionCell = (l: Lead) => l.status === 'NEW' ? <RouteMenu lead={l} />
    : l.status === 'ROUTED' ? <button disabled={!canAssignIn(l.dept)} className={cn(btnPrimary, 'px-2.5 py-1 text-xs')} onClick={() => setAssigning(l)}>Chỉ định</button>
    : l.status === 'ASSIGNED' ? <button disabled={!canAcceptLead(l)} className={cn(btnBase, btnSm, 'bg-[#00B894] font-semibold text-[#0F141E]')} onClick={() => acceptLead(l.id)}>Tiếp nhận</button>
    : null;

  type Col = { key: string; title: string; icon: typeof Wallet; tint: string; count: number; body: ReactNode; drop?: DeptCode };
  const cols: Col[] = [
    ...(canRoute ? [{
      key: 'INBOX', title: 'MKT chờ phân phòng', icon: Inbox, tint: C.orange, count: unrouted.length,
      body: (
        <>
          {limit('INBOX', unrouted).map((l) => (
            <div key={l.id} draggable={canRoute} onDragStart={(e) => e.dataTransfer.setData('text/plain', l.id)} className={canRoute ? 'cursor-grab active:cursor-grabbing' : ''}>
              <LeadCard l={l} now={now} onMenu={menuFor(l)} action={
                l.status === 'NEW'
                  ? <RouteMenu lead={l} />
                  : <span className="text-[11px] text-[#94A3B8]">Điểm {l.score ?? scoreLead(l, customers)}, nuôi dưỡng</span>
              } />
            </div>
          ))}
          {more('INBOX', unrouted)}
          {!unrouted.length && <p className="py-6 text-center text-xs text-[#94A3B8]">Không có lead chờ phân phòng.</p>}
        </>
      ),
    }] : []),
    ...depts.map((d) => {
      const inDept = leads.filter((l) => l.dept === d.code && match(l) && ['ROUTED', 'ASSIGNED', 'ACCEPTED'].includes(l.status))
        .sort((a, b) => ['ROUTED', 'ASSIGNED', 'ACCEPTED'].indexOf(a.status) - ['ROUTED', 'ASSIGNED', 'ACCEPTED'].indexOf(b.status));
      return {
        key: d.code, title: d.name, icon: deptIcon(d.code), tint: d.code.startsWith('EMD') ? C.blue : C.teal, count: inDept.length, drop: d.code,
        body: (
          <>
            {limit(d.code, inDept).map((l) => (
              <div key={l.id} draggable={canRoute && l.status === 'ROUTED'} onDragStart={(e) => e.dataTransfer.setData('text/plain', l.id)}>
                <LeadCard l={l} now={now} onMenu={menuFor(l)} action={
                  l.status === 'ROUTED' ? <button disabled={!canAssignIn(l.dept)} className={cn(btnPrimary, 'px-2.5 py-1 text-xs')} onClick={() => setAssigning(l)}>Chỉ định</button>
                  : l.status === 'ASSIGNED' ? <button disabled={!canAcceptLead(l)} className={cn(btnGhost, btnSm)} onClick={() => acceptLead(l.id)}>Tiếp nhận</button>
                  : <span className="text-[11px] text-[#94A3B8]">Đang báo giá</span>
                } />
              </div>
            ))}
            {more(d.code, inDept)}
            {!inDept.length && <p className="rounded border border-dashed border-[#263044] px-3 py-6 text-center text-xs text-[#94A3B8]">{canRoute ? `Thả lead vào đây để phân về ${d.short}` : 'Không có lead'}</p>}
          </>
        ),
      };
    }),
  ];

  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Tổng lead" value={String(total)} icon={Users} color={C.orange} highlight spark={monthly(scope, leadAt)} />
        <StatCard label="Chờ phân phòng" value={String(scope.filter((l) => l.status === 'NEW').length)} icon={Inbox} color="#F6B533" sub={`${pct(scope.filter((l) => l.status === 'NEW').length, total)} tổng lead`} />
        <StatCard label="Chờ chỉ định" value={String(scope.filter((l) => l.status === 'ROUTED').length)} icon={UserPlus} color={C.blue} sub={`${pct(scope.filter((l) => l.status === 'ROUTED').length, total)} tổng lead`} />
        <StatCard label="Quá SLA" value={String(late)} icon={Clock} color={C.red} sub="Tiếp nhận 2h hoặc báo giá 24h" />
      </div>

      {/* Quy trình 2 bước */}
      <div className="rounded-md border border-[#263044] bg-[#151C29] p-3 sm:p-4">
        <ol className="grid grid-cols-4 gap-2 lg:gap-0">
          {steps.map(([title, n], i) => {
            const p = total ? (n / total) * 100 : 0;
            return (
              <li key={title} className="flex min-w-0 items-start gap-2 lg:gap-3 lg:pr-6">
                <div className="min-w-0 flex-1">
                  <div className="flex flex-col items-center gap-1 text-center lg:flex-row lg:items-center lg:gap-3 lg:text-left">
                    <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-bold text-[#0F141E] lg:h-11 lg:w-11 lg:text-sm" style={{ background: STEP_COLORS[i] }}>{String(i + 1).padStart(2, '0')}</span>
                    <div className="min-w-0">
                      <p className="truncate text-[11px] font-medium text-[#F1F5F9] lg:text-sm">{title}</p>
                      <p className="hidden text-xs tabular-nums text-[#94A3B8] lg:block">{n} / {total} lead</p>
                    </div>
                  </div>
                  <div className="mt-2 flex items-center gap-2">
                    <div className="flex-1"><ProgressBar value={n} max={total || 1} tone={STEP_COLORS[i]} /></div>
                    <span className="text-[11px] tabular-nums text-[#94A3B8]">{p.toFixed(0)}%</span>
                  </div>
                </div>
                {i < 3 && <ArrowRight className="mt-3 hidden h-5 w-5 shrink-0 text-[#94A3B8] lg:block" aria-hidden />}
              </li>
            );
          })}
        </ol>
      </div>

      <FilterBar q={q} onQ={setQ} placeholder="Tìm MST, tên khách hàng, mã lead..." status={st} onStatus={setSt} extraActive={(reg !== 'ALL' ? 1 : 0) + (seg !== 'ALL' ? 1 : 0)}
        actions={<>
          <ViewSwitch value={view} onChange={setView} options={['table', 'board']} />
          <RowMenu text="Mô phỏng" icon={BellRing} items={[{ label: 'Nhận lead mới', icon: Inbox, onClick: simulateNewLead, disabled: !canRoute }, { label: 'Quá hạn báo giá', icon: AlertTriangle, onClick: simulateQuoteOverdue }]} />
        </>}
        chips={<ChipFilter value={st === 'ALL' ? 'ALL' : st as LeadStatus} onChange={(v) => setSt(v)} total={tableRows.length} options={(['NEW', 'ROUTED', 'ASSIGNED', 'ACCEPTED'] as LeadStatus[]).map((x) => ({ value: x, label: LEAD_STATUS[x].label, count: leads.filter((l) => l.status === x && inR(leadDate(l))).length, color: x === 'ACCEPTED' ? C.teal : C.orange }))} />}
        statusOptions={(['NEW', 'NURTURE', 'ROUTED', 'ASSIGNED', 'ACCEPTED'] as LeadStatus[]).map((s) => ({ value: s, label: LEAD_STATUS[s].label }))}>
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={reg} onChange={(e) => setReg(e.target.value as 'ALL' | Region)} aria-label="Khu vực">
          <option value="ALL">Tất cả khu vực</option>
          {(Object.keys(REGION_LABEL) as Region[]).map((r) => <option key={r} value={r}>{REGION_LABEL[r]}</option>)}
        </select>
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={seg} onChange={(e) => setSeg(e.target.value)} aria-label="Nhóm khách hàng">
          <option value="ALL">Tất cả nhóm khách</option>
          {Object.keys(SEGMENT_LABEL).map((s) => <option key={s} value={s}>{segName(s)}</option>)}
        </select>
      </FilterBar>

      {!canRoute && <p className="flex items-center gap-2 text-xs text-[#94A3B8]"><Lock className="h-3.5 w-3.5" aria-hidden />Bạn đang xem lead {role === 'SALES_REP' ? 'được giao cho bạn' : 'của phòng mình'}. Toàn bộ lead chỉ Giám đốc và Marketing xem được.</p>}

      {view === 'table' && (
        <>
          <BulkBar count={sel.ids.length} onClear={sel.clear}>
            {routableDepts.map((d) => <button key={d.code} className={cn(btnGhost, btnSm)} disabled={!canRoute} onClick={() => { routeLeads(sel.ids, d.code); sel.clear(); }}><ArrowRight className="h-3.5 w-3.5" aria-hidden />Phân về {d.short}</button>)}
          </BulkBar>
          <Panel>
            <Table minW={1000} head={[
              <input key="all" type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={sel.allOn} onChange={sel.toggleAll} aria-label="Chọn tất cả" disabled={!canRoute} />,
              'Mã & khách hàng', 'Phòng ban', 'Phụ trách', <span key="v" className="block text-right">Giá trị BOQ</span>, 'SLA / thời hạn', 'Trạng thái', <span key="a" className="block text-right">Thao tác</span>,
            ]}>
              {paged.slice.map((l) => {
                const late = isAcceptLate(l, now) || isQuoteOverdue(l, now);
                const canSel = ['NEW', 'NURTURE', 'ROUTED'].includes(l.status);
                return (
                  <tr key={l.id} className={cn(rowCls, sel.has(l.id) && 'bg-[#F28C33]/5')}>
                    <td className={cn(tdFirst, 'w-10')}><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" disabled={!canSel || !canRoute} checked={sel.has(l.id)} onChange={() => sel.toggle(l.id)} aria-label={`Chọn ${l.company}`} /></td>
                    <td className={cn(tdCls, 'max-w-[230px]')} title={`${l.boqNote ?? ''}\n${l.province ?? REGION_LABEL[l.region]}${l.phone ? ` · ${l.phone}` : ''}`}><p className="truncate font-medium">{l.company}</p><p className="truncate text-xs text-[#94A3B8]"><span className="font-mono text-[#F7B23B]">{l.code}</span> · {l.boqNote || (l.province ?? REGION_LABEL[l.region])}</p></td>
                    <td className={cn(tdCls, 'whitespace-nowrap text-xs')}>{l.dept ? deptOf(l.dept)?.short ?? l.dept : <span className="text-[#94A3B8]">MKT</span>}</td>
                    <td className={cn(tdCls, 'max-w-[170px]')}>{l.assignee ? <span className="flex items-center gap-2"><Avatar name={userName(l.assignee)} size={26} /><span className="truncate text-sm">{userName(l.assignee)}</span></span> : <span className="text-xs text-[#94A3B8]">{l.dept ? 'Chờ chỉ định' : '—'}</span>}</td>
                    <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{boqTotal(l) ? compact(boqTotal(l)) : '—'}</td>
                    <td className={cn(tdCls, 'whitespace-nowrap')}>{slaCell(l)}</td>
                    <td className={cn(tdCls, 'whitespace-nowrap')}>{late ? <Chip tone="red">Quá hạn SLA</Chip> : <Chip tone={LEAD_STATUS[l.status].tone}>{LEAD_STATUS[l.status].label}</Chip>}</td>
                    <td className={tdLast}><div className="flex items-center justify-end gap-1.5">{actionCell(l)}<CommentButton entity="lead" entityId={l.id} title={`${l.code} · ${l.company}`} module="leads" /><RowMenu items={menuFor(l)} /></div></td>
                  </tr>
                );
              })}
            </Table>
            {!tableRows.length && <EmptyState text={<>Không có lead khớp bộ lọc.</>} art="search" />}
            <Pagination paged={paged} unit="lead" />
          </Panel>
        </>
      )}

      {view === 'board' && <>
      {/* Desktop: bảng kanban */}
      <div className={cn('hidden gap-4 lg:grid', cols.length >= 4 ? 'lg:grid-cols-4' : cols.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-2')}>
        {cols.map((c) => (
          <section
            key={c.key}
            onDragOver={c.drop ? (e) => { e.preventDefault(); setDragOver(c.drop!); } : undefined}
            onDragLeave={c.drop ? () => setDragOver(null) : undefined}
            onDrop={c.drop ? (e) => onDrop(e, c.drop!) : undefined}
            className={cn('flex flex-col rounded-md border bg-[#151C29] p-3 transition-colors', dragOver && dragOver === c.drop ? 'border-[#F28C33] bg-[#F28C33]/5' : 'border-[#263044]')}
          >
            <header className="mb-3 flex items-center gap-2 px-1">
              <span className="flex h-8 w-8 items-center justify-center rounded" style={{ background: `${c.tint}26`, color: c.tint }}><c.icon className="h-4 w-4" aria-hidden /></span>
              <h3 className="min-w-0 flex-1 truncate text-sm font-semibold">{c.title}</h3>
              <span className="rounded-md bg-[#1C2534] px-2 py-0.5 text-xs font-semibold tabular-nums">{c.count}</span>
            </header>
            <div className="space-y-2.5">{c.body}</div>
          </section>
        ))}
      </div>

      {/* Mobile: từng cột dạng xếp gọn */}
      <div className="space-y-2 lg:hidden">
        {cols.map((c) => (
          <section key={c.key} className="rounded-md border border-[#263044] bg-[#151C29]">
            <button className="flex w-full items-center gap-2 px-3 py-3 text-left" onClick={() => setOpenCol(openCol === c.key ? '' : c.key)} aria-expanded={openCol === c.key}>
              <span className="flex h-8 w-8 items-center justify-center rounded" style={{ background: `${c.tint}26`, color: c.tint }}><c.icon className="h-4 w-4" aria-hidden /></span>
              <span className="min-w-0 flex-1 truncate text-sm font-semibold">{c.title}</span>
              <span className="rounded-md bg-[#1C2534] px-2 py-0.5 text-xs font-semibold tabular-nums text-[#F7B23B]">{c.count}</span>
              <ChevronDown className={cn('h-4 w-4 text-[#94A3B8] transition-transform', openCol === c.key && 'rotate-180')} aria-hidden />
            </button>
            {openCol === c.key && <div className="space-y-2.5 border-t border-[#263044] p-3">{c.body}</div>}
          </section>
        ))}
      </div>

      </>}

      {assigning && <AssignModal lead={assigning} onClose={() => setAssigning(null)} />}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

// =====================================================================
//  PHÂN HỆ 2: HỘP LEAD MKT & ĐIỀU PHỐI
// =====================================================================

function LeadsModule() {
  const { presetQuery } = useApp();
  const [tab, setTab] = useState<'board' | 'list'>(presetQuery ? 'list' : 'board');
  return (
    <div className="space-y-5">
      <Tabs tabs={[{ id: 'board', label: 'Điều phối' }, { id: 'list', label: 'Data MKT' }]} value={tab} onChange={setTab} aside={<DateRangePicker />} />
      {tab === 'board' ? <AllocationPage /> : <DataMktPage />}
    </div>
  );
}

// =====================================================================
//  DRAWER DÙNG CHUNG
// =====================================================================

function Drawer({ title, eyebrow, badge, onClose, children, footer, actions }: { title: string; eyebrow?: string; badge?: ReactNode; onClose: () => void; children: ReactNode; footer?: ReactNode; actions?: ReactNode }) {
  useEffect(() => {
    const k = (e: KeyboardEvent) => { if (e.key === 'Escape') onClose(); };
    window.addEventListener('keydown', k);
    return () => window.removeEventListener('keydown', k);
  }, [onClose]);
  return (
    <div className="fixed inset-0 z-50" role="dialog" aria-modal="true" aria-label={title}>
      <div className="absolute inset-0 bg-black/60 motion-safe:animate-[fadeIn_.2s_ease-out]" onClick={onClose} />
      <aside className="absolute inset-y-0 right-0 flex w-full max-w-2xl flex-col border-l border-[#263044] bg-[#151C29] shadow-2xl motion-safe:animate-[slideIn_.28s_cubic-bezier(.2,.8,.2,1)]">
        <header className="flex items-start justify-between gap-4 border-b border-[#263044] px-6 pb-4 pt-[calc(1rem+env(safe-area-inset-top))]">
          <div className="min-w-0">
            <div className="flex flex-wrap items-center gap-2">
              {eyebrow && <span className="text-sm font-medium text-[#94A3B8]">{eyebrow}</span>}
              {badge}
            </div>
            <h2 className="mt-1 text-lg font-semibold leading-snug text-[#F1F5F9]">{title}</h2>
            {actions && <div className="mt-3 flex flex-wrap gap-2">{actions}</div>}
          </div>
          <button className={cn(btnGhost, 'p-2')} onClick={onClose} aria-label="Đóng"><X className="h-4 w-4" /></button>
        </header>
        <div className="flex-1 space-y-6 overflow-y-auto px-6 py-5">{children}</div>
        {footer && <footer className="border-t border-[#263044] bg-[#151C29] px-6 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-4">{footer}</footer>}
      </aside>
    </div>
  );
}

// =====================================================================
//  PHÂN HỆ 4: KHÁCH HÀNG 360 & LIÊN KẾT MDF
// =====================================================================

type CustomerForm = Omit<Customer, 'id' | 'code'>;
const EMPTY_CUSTOMER: CustomerForm = {
  name: '', taxCode: '', segment: 'OTHER', tier: 'NEW', region: 'SOUTH', dept: 'FACTORY_SALES', amId: undefined, sourceId: 'SELF', status: 'PROSPECT', createdAt: '',
  contactName: '', contactTitle: '', contactPhone: '', contactEmail: '', address: '',
  creditLimit: 0, debt: 0, ytdRevenue: 0, lastYearRevenue: 0,
};

function validateCustomer(f: CustomerForm, customers: Customer[], selfId?: string) {
  const e: Partial<Record<keyof CustomerForm, string>> = {};
  if (f.name.trim().length < 3) e.name = 'Nhập tên khách hàng';
  if (!MST_RE.test(f.taxCode.trim())) e.taxCode = 'MST gồm 10 số hoặc 13 số (dạng 0123456789-001)';
  else {
    const dup = customers.find((c) => c.taxCode === f.taxCode.trim() && c.id !== selfId);
    if (dup) e.taxCode = `MST đã thuộc khách hàng ${dup.code}`;
  }
  if (!f.contactName.trim()) e.contactName = 'Nhập người liên hệ';
  if (f.contactEmail && !EMAIL_RE.test(f.contactEmail)) e.contactEmail = 'Email chưa đúng định dạng';
  return e;
}

function CustomerFormModal({ id, onClose }: { id?: string; onClose: () => void }) {
  const { customers, setCustomers, users, departments, tierRules, sources, notify } = useApp();
  const [manageSources, setManageSources] = useState(false);
  const existing = customers.find((c) => c.id === id);
  const [f, setF] = useState<CustomerForm>(() => {
    if (!existing) return EMPTY_CUSTOMER;
    const { id: _i, code: _c, ...rest } = existing;
    void _i;
    void _c;
    return rest;
  });
  const [touched, setTouched] = useState(false);
  const errors = validateCustomer(f, customers, id);
  const set = <K extends keyof CustomerForm>(k: K, v: CustomerForm[K]) => setF((p) => ({ ...p, [k]: v }));
  const reps = users.filter((u) => u.active && u.dept === f.dept && (u.role === 'SALES_REP' || u.role === 'DEPT_HEAD'));
  const suggested = tierFor(f.ytdRevenue, tierRules);

  const save = () => {
    setTouched(true);
    if (Object.keys(errors).length) return;
    const clean = { ...f, name: f.name.trim(), taxCode: f.taxCode.trim() };
    if (existing) {
      setCustomers((p) => p.map((c) => (c.id === existing.id ? { ...c, ...clean } : c)));
      notify(`Đã cập nhật ${clean.name}`, 'teal');
    } else {
      const code = nextCode(customers.map((c) => c.code), 'KH-', 6);
      setCustomers((p) => [...p, { id: uid('k'), code, ...clean, createdAt: clean.createdAt || todayISO() }]);
      notify(`Đã thêm khách hàng ${code}`, 'teal');
    }
    onClose();
  };
  const err = (k: keyof CustomerForm) => (touched ? errors[k] : undefined);

  return (
    <Modal
      title={existing ? `Sửa khách hàng ${existing.code}` : 'Thêm khách hàng'}
      onClose={onClose}
      wide
      footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>{existing ? 'Lưu thay đổi' : 'Thêm khách hàng'}</button></>}
    >
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <Field label="Tên khách hàng *" error={err('name')} className="sm:col-span-2"><input className={inputCls} value={f.name} onChange={(e) => set('name', e.target.value)} /></Field>
        <Field label="Mã số thuế *" error={err('taxCode')}><input className={inputCls} value={f.taxCode} onChange={(e) => set('taxCode', e.target.value)} /></Field>
        <Field label="Nhóm khách hàng">
          <select className={inputCls} value={f.segment} onChange={(e) => set('segment', e.target.value as Segment)}>
            {(Object.keys(SEGMENT_LABEL) as Segment[]).map((s) => <option key={s} value={s}>{segName(s)}</option>)}
          </select>
        </Field>
        <Field label="Nguồn khách hàng">
          <div className="flex gap-2">
            <select className={inputCls} value={f.sourceId} onChange={(e) => set('sourceId', e.target.value)}>
              {sources.map((x) => <option key={x.id} value={x.id}>{x.name}</option>)}
            </select>
            <button type="button" className={cn(btnGhost, 'shrink-0')} onClick={() => setManageSources(true)}>Thêm / sửa</button>
          </div>
        </Field>
        <Field label="Trạng thái quan hệ">
          <select className={inputCls} value={f.status} onChange={(e) => set('status', e.target.value as CustomerStatus)}>
            {(Object.keys(CUSTOMER_STATUS) as CustomerStatus[]).map((x) => <option key={x} value={x}>{CUSTOMER_STATUS[x].label}</option>)}
          </select>
        </Field>
        <Field label="Khu vực">
          <select className={inputCls} value={f.region} onChange={(e) => set('region', e.target.value as Region)}>
            {(Object.keys(REGION_LABEL) as Region[]).map((r) => <option key={r} value={r}>{REGION_LABEL[r]}</option>)}
          </select>
        </Field>
        <Field label="Địa chỉ" className="sm:col-span-2"><input className={inputCls} value={f.address} onChange={(e) => set('address', e.target.value)} /></Field>
        <Field label="Người liên hệ *" error={err('contactName')}><input className={inputCls} value={f.contactName} onChange={(e) => set('contactName', e.target.value)} /></Field>
        <Field label="Chức vụ"><input className={inputCls} value={f.contactTitle} onChange={(e) => set('contactTitle', e.target.value)} /></Field>
        <Field label="Điện thoại liên hệ"><input className={inputCls} inputMode="tel" value={f.contactPhone} onChange={(e) => set('contactPhone', e.target.value)} /></Field>
        <Field label="Email liên hệ" error={err('contactEmail')}><input className={inputCls} type="email" value={f.contactEmail} onChange={(e) => set('contactEmail', e.target.value)} /></Field>
        <Field label="Phòng ban quản lý">
          <select className={inputCls} value={f.dept} onChange={(e) => setF((p) => ({ ...p, dept: e.target.value, amId: undefined }))}>
            {departments.filter((d) => d.active).map((d) => <option key={d.code} value={d.code}>{d.name}</option>)}
          </select>
        </Field>
        <Field label="Người phụ trách">
          <select className={inputCls} value={f.amId ?? ''} onChange={(e) => set('amId', e.target.value || undefined)}>
            <option value="">Chưa giao</option>
            {reps.map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}
          </select>
        </Field>
        <Field label="Hạn mức công nợ"><MoneyInput value={f.creditLimit} onChange={(n) => set('creditLimit', n)} /></Field>
        <Field label="Công nợ hiện tại" hint={f.creditLimit > 0 && f.debt > f.creditLimit ? 'Công nợ đang vượt hạn mức' : undefined}><MoneyInput value={f.debt} onChange={(n) => set('debt', n)} /></Field>
        <Field label="Doanh số lũy kế năm nay"><MoneyInput value={f.ytdRevenue} onChange={(n) => set('ytdRevenue', n)} /></Field>
        <Field label="Doanh số năm trước"><MoneyInput value={f.lastYearRevenue} onChange={(n) => set('lastYearRevenue', n)} /></Field>
        <Field label="Hạng khách hàng" hint={suggested !== f.tier ? `Theo quy tắc phân hạng, doanh số này thuộc hạng ${tierInfo(suggested).label}` : 'Khớp quy tắc phân hạng'}>
          <select className={inputCls} value={f.tier} onChange={(e) => set('tier', e.target.value as Tier)}>
            {TIERS.map((t) => <option key={t} value={t}>{tierInfo(t).label}</option>)}
          </select>
        </Field>

      </div>
      {manageSources && <SourceManagerModal onClose={() => setManageSources(false)} />}
    </Modal>
  );
}

type RevenueBand = 'ALL' | 'GT1B' | '500M_1B' | '200M_500M' | 'LT200M';
const REVENUE_BAND: Record<RevenueBand, { label: string; test: (n: number) => boolean }> = {
  ALL: { label: 'Mọi mức doanh số', test: () => true },
  GT1B: { label: 'Trên 1 tỷ', test: (n) => n > 1e9 },
  '500M_1B': { label: '500 triệu – 1 tỷ', test: (n) => n >= 500e6 && n <= 1e9 },
  '200M_500M': { label: '200 – 500 triệu', test: (n) => n >= 200e6 && n < 500e6 },
  LT200M: { label: 'Dưới 200 triệu', test: (n) => n < 200e6 },
};


function CustomersPage() {
  // Công nợ & tuổi nợ xem ở phân hệ Tài chính; Khách hàng chỉ còn danh sách (cột Công nợ vẫn hiện theo từng khách)
  return <TradingCustomersList />;
}

function TradingCustomersList() {
  const { customers: allCustomers, myCustomers: customers, setCustomers, claims, programs, departments, notify, canDo, userName, dept, openCustomer, openCustomerForm, openProgramForm, presetQuery, getflyOrders, range, leads, sources, quotes, users } = useApp();
  const inR = useInRange();
  const inPrev = inRangeOf(prevRange(range));
  const [q, setQ] = useState(presetQuery);
  const [dp, setDp] = useState<'ALL' | DeptCode>('ALL');
  const [region, setRegion] = useState<'ALL' | Region>('ALL');
  const [status, setStatus] = useState<string>('ALL');
  const [adv, setAdv] = useState<{ tier: string; source: string; band: RevenueBand; roiMin: number }>({ tier: 'ALL', source: 'ALL', band: 'ALL', roiMin: 0 });
  const [advOpen, setAdvOpen] = useState(false);
  const [importing, setImporting] = useState(false);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const canEdit = canDo('customer.edit');
  const roiOf = (c: Customer) => { const m = mdfOfCustomer(c.id, claims, programs); return m > 0 ? c.ytdRevenue / m : null; };
  const advCount = [adv.tier !== 'ALL', adv.source !== 'ALL', adv.band !== 'ALL', adv.roiMin > 0].filter(Boolean).length;

  const list = customers
    .filter((c) => {
      const t = q.trim().toLowerCase();
      const orderHit = !!t && getflyOrders.some((o) => o.customerId === c.id && o.orderCode.toLowerCase().includes(t));
      return (!t || orderHit || [c.name, c.code, c.taxCode, c.contactName, c.contactPhone.replace(/\s/g, '')].some((v) => v.toLowerCase().includes(t.replace(/\s/g, '')) || v.toLowerCase().includes(t)))
        && (dp === 'ALL' || c.dept === dp) && (region === 'ALL' || c.region === region) && (status === 'ALL' || c.status === status)
        && (adv.tier === 'ALL' || c.tier === adv.tier) && (adv.source === 'ALL' || c.sourceId === adv.source) && REVENUE_BAND[adv.band].test(c.ytdRevenue)
        && (adv.roiMin <= 0 || (roiOf(c) ?? 0) >= adv.roiMin);
    })
    .sort((a, b) => b.ytdRevenue - a.ytdRevenue);
  const paged = usePaged(list, 10);
  const sel = useSelection(list.map((c) => c.id));

  // ---- KPI có so sánh kỳ trước ----
  const newCur = customers.filter((c) => inR(c.createdAt)).length;
  const newPrev = customers.filter((c) => inPrev(c.createdAt)).length;
  const now = Date.now();
  const sixAgo = iso(new Date(now - 182 * 864e5));
  const twelveAgo = iso(new Date(now - 365 * 864e5));
  // Doanh số ghi nhận khi chốt đơn (trước VAT)
  const wonIn = (from: string, to?: string) => leads.filter((l) => l.status === 'WON' && l.wonAt && l.wonAt >= from && (!to || l.wonAt < to)).reduce((s, l) => s + (l.wonAmount ?? 0), 0);
  const rev6 = wonIn(sixAgo);
  const rev6Prev = wonIn(twelveAgo, sixAgo);
  const quoteCur = quotes.filter((x) => inR(x.date)).reduce((s, x) => s + x.amount, 0);
  const quotePrev = quotes.filter((x) => inPrev(x.date)).reduce((s, x) => s + x.amount, 0);
  const rate = (pred: (l: Lead) => boolean) => { const w = leads.filter((l) => l.status === 'WON' && pred(l)).length; const lo = leads.filter((l) => l.status === 'LOST' && pred(l)).length; return w + lo ? (w / (w + lo)) * 100 : 0; };
  const convCur = rate((l) => inR(leadDate(l)));
  const convPrev = rate((l) => inPrev(leadDate(l)));

  const deptShort = Object.fromEntries(departments.map((d) => [d.code, d.short])) as Record<DeptCode, string>;
  const deptNames = Object.fromEntries(departments.map((d) => [d.code, d.name])) as Record<DeptCode, string>;
  const tierLabels = Object.fromEntries(TIERS.map((t) => [t, tierInfo(t).label])) as Record<Tier, string>;

  const importSpec: ImportSpec<CustomerForm> = {
    title: 'Nhập khách hàng từ file CSV',
    templateName: 'mau_nhap_khach_hang.csv',
    headers: ['ten_khach_hang', 'mst', 'nhom_khach_hang', 'hang', 'phong_ban', 'khu_vuc', 'nguon_khach', 'nguoi_lien_he', 'chuc_vu', 'sdt_lien_he', 'email_lien_he', 'dia_chi', 'han_muc_no', 'cong_no', 'doanh_so_nam_nay', 'doanh_so_nam_truoc'],
    sample: ['Công ty TNHH Thiết bị điện XYZ', '0319876543', 'Đại lý phân phối cấp 2', 'Silver', 'EMD Nam', 'Miền Nam', 'Marketing: Digital (Ads, Website, Zalo)', 'Nguyễn Văn B', 'Giám đốc', '0909123456', 'b@xyz.vn', '12 Lê Lợi, Q.1, TP.HCM', '500000000', '120000000', '350000000', '200000000'],
    parseRow: (r) => {
      const segment = r.nhom_khach_hang ? matchEnum(r.nhom_khach_hang, SEGMENT_LABEL) : 'OTHER';
      if (!segment) return { ok: false, error: `Nhóm khách hàng "${r.nhom_khach_hang}" không hợp lệ` };
      const t = r.hang ? matchEnum(r.hang, tierLabels) : TIERS[TIERS.length - 1];
      if (!t) return { ok: false, error: `Hạng "${r.hang}" không hợp lệ (Diamond, Gold, Silver, Mới)` };
      const d = matchEnum(r.phong_ban, deptShort) ?? matchEnum(r.phong_ban, deptNames);
      if (!d) return { ok: false, error: `Phòng ban "${r.phong_ban}" không hợp lệ` };
      const region: Region = /b[aắ]c/i.test(r.khu_vuc) ? 'NORTH' : 'SOUTH';
      const src = sources.find((x) => x.name.toLowerCase() === (r.nguon_khach ?? '').trim().toLowerCase() || x.id === r.nguon_khach)?.id;
      if (r.nguon_khach && !src) return { ok: false, error: `Nguồn khách "${r.nguon_khach}" chưa có, thêm ở form khách hàng trước` };
      const form: CustomerForm = {
        ...EMPTY_CUSTOMER, name: r.ten_khach_hang, taxCode: r.mst, segment, tier: t, dept: d, region, sourceId: src ?? 'SELF',
        contactName: r.nguoi_lien_he, contactTitle: r.chuc_vu, contactPhone: r.sdt_lien_he, contactEmail: r.email_lien_he, address: r.dia_chi,
        creditLimit: digits(r.han_muc_no), debt: digits(r.cong_no), ytdRevenue: digits(r.doanh_so_nam_nay), lastYearRevenue: digits(r.doanh_so_nam_truoc),
      };
      const first = Object.values(validateCustomer(form, allCustomers))[0];
      return first ? { ok: false, error: first } : { ok: true, item: form };
    },
    onImport: (items) => {
      const codes = allCustomers.map((c) => c.code);
      const seen = new Set<string>();
      const created: Customer[] = [];
      for (const f of items) {
        if (seen.has(f.taxCode)) continue;
        seen.add(f.taxCode);
        const code = nextCode(codes, 'KH-', 6);
        codes.push(code);
        created.push({ id: uid('k'), code, ...f });
      }
      setCustomers((p) => [...p, ...created]);
      notify(`Đã nhập ${created.length} khách hàng`, 'teal');
    },
  };

  const exportRows = (rows: Customer[]) =>
    downloadCsv('khach_hang_360.csv', [
      ['ma', 'ten_khach_hang', 'mst', 'nhom', 'hang', 'trang_thai', 'phong_ban', 'phu_trach', 'nguon', 'nguoi_lien_he', 'dien_thoai', 'han_muc_no', 'cong_no', 'doanh_so_nam_nay', 'mdf_da_nhan', 'mdf_roi'],
      ...rows.map((c) => {
        const mdf = mdfOfCustomer(c.id, claims, programs);
        return [c.code, c.name, c.taxCode, segName(c.segment), tierInfo(c.tier).label, CUSTOMER_STATUS[c.status].label, dept(c.dept)?.short ?? '', userName(c.amId), CUSTOMER_SOURCE[c.sourceId]?.name ?? '', c.contactName, c.contactPhone, c.creditLimit, c.debt, c.ytdRevenue, mdf, mdf ? (c.ytdRevenue / mdf).toFixed(1) : ''];
      }),
    ]);

  const deleteBlock = (c: Customer) => {
    const refs = [claims.some((x) => x.customerId === c.id) && 'hồ sơ claim', programs.some((x) => x.customerId === c.id) && 'chương trình quỹ', getflyOrders.some((x) => x.customerId === c.id) && 'đơn Getfly', leads.some((x) => x.customerId === c.id) && 'dự án đã chốt'].filter(Boolean);
    return refs.length ? `Khách hàng đang gắn ${refs.join(', ')}. Không thể xóa để giữ số liệu đối soát.` : undefined;
  };
  const askDelete = (c: Customer) => setConfirm({ title: 'Xóa khách hàng', message: <>Xóa <b>{c.name}</b> (MST {c.taxCode})?</>, blocked: deleteBlock(c), onConfirm: () => { setCustomers((p) => p.filter((x) => x.id !== c.id)); notify(`Đã xóa ${c.name}`, 'orange'); } });
  const menuFor = (c: Customer): MenuItem[] => [
    { label: 'Xem hồ sơ 360', icon: Eye, onClick: () => openCustomer(c.id) },
    { label: `Gọi ${c.contactPhone}`, icon: Phone, onClick: () => { window.location.href = `tel:${c.contactPhone.replace(/\s/g, '')}`; }, disabled: !c.contactPhone },
    { label: 'Sao chép MST', icon: Copy, onClick: () => navigator.clipboard?.writeText(c.taxCode).then(() => notify(`Đã sao chép MST ${c.taxCode}`, 'teal'), () => notify('Trình duyệt chặn sao chép', 'red')) },
    { label: 'Đề xuất tài trợ quỹ 3M', icon: Coins, onClick: () => openProgramForm(c.id), disabled: !canDo('program.create') },
    { label: 'Xóa khách hàng', icon: Trash2, onClick: () => askDelete(c), danger: true, disabled: !canEdit },
  ];
  const bulkDelete = () => {
    const targets = customers.filter((c) => sel.has(c.id));
    const ok = targets.filter((c) => !deleteBlock(c));
    setConfirm({
      title: 'Xóa khách hàng đã chọn',
      message: <>Xóa {ok.length} / {targets.length} khách hàng đã chọn?{ok.length < targets.length ? ` ${targets.length - ok.length} khách đang gắn chứng từ đối soát sẽ được giữ lại.` : ''}</>,
      blocked: ok.length ? undefined : 'Tất cả khách đã chọn đều đang gắn hồ sơ quỹ, đơn Getfly hoặc dự án đã chốt.',
      onConfirm: () => { setCustomers((p) => p.filter((c) => !ok.some((x) => x.id === c.id))); sel.clear(); notify(`Đã xóa ${ok.length} khách hàng`, 'orange'); },
    });
  };
  const debtPill = (c: Customer) => (
    <span className={cn('inline-block rounded-md px-2 py-0.5 text-xs tabular-nums', c.creditLimit && c.debt > c.creditLimit * 0.9 ? 'bg-[#EF4444]/15 text-[#F87171]' : 'bg-[#00B894]/15 text-[#3DDBB6]')}>
      {compact(c.debt)}<span className="block text-[10px] opacity-70">/ {compact(c.creditLimit)}</span>
    </span>
  );

  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-5')}>
        <StatCard label="Tổng khách hàng" value={String(customers.length)} icon={Users} color={C.orange} highlight spark={monthly(customers, (c) => c.createdAt, undefined, 6, true)} delta={pctDelta(newCur, newPrev)} deltaLabel="khách mới so với kỳ trước" />
        <StatCard label="Khách hàng mới" value={String(newCur)} icon={UserPlus} color={C.teal} spark={monthly(customers, (c) => c.createdAt)} delta={pctDelta(newCur, newPrev)} sub="Trong khoảng thời gian đang lọc" />
        <StatCard label="Doanh số 6 tháng" value={compact(rev6)} icon={TrendingUp} color={C.blue} delta={pctDelta(rev6, rev6Prev)} sub="Ghi nhận khi chốt đơn" />
        <StatCard label="Giá trị báo giá" value={compact(quoteCur)} icon={ReceiptIcon} color="#8B5CF6" spark={monthly(quotes, (q) => q.date, (q) => q.amount)} delta={pctDelta(quoteCur, quotePrev)} sub={`${quotes.filter((x) => inR(x.date)).length} báo giá trong kỳ`} />
        <StatCard label="Chuyển đổi" value={`${convCur.toFixed(0)}%`} icon={Target} color={C.red} delta={pctDelta(convCur, convPrev)} sub="Chốt đơn / (chốt + trượt)" />
      </div>

      <FilterBar
        q={q} onQ={setQ} placeholder="Tìm MST, tên khách hàng, mã đơn, SĐT..."
        dept={dp} onDept={setDp} status={status} onStatus={setStatus}
        statusOptions={(Object.keys(CUSTOMER_STATUS) as CustomerStatus[]).map((x) => ({ value: x, label: CUSTOMER_STATUS[x].label }))}
        onAdvanced={() => setAdvOpen(true)} advancedCount={advCount} extraActive={region !== 'ALL' ? 1 : 0}
        actions={<div className="hidden lg:block"><DateRangePicker /></div>}
      >
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={region} onChange={(e) => setRegion(e.target.value as 'ALL' | Region)} aria-label="Khu vực">
          <option value="ALL">Tất cả khu vực</option>
          {(Object.keys(REGION_LABEL) as Region[]).map((r) => <option key={r} value={r}>{REGION_LABEL[r]}</option>)}
        </select>
      </FilterBar>


      <BulkBar count={sel.ids.length} onClear={sel.clear}>
        <button className={cn(btnGhost, btnSm)} onClick={() => exportRows(customers.filter((c) => sel.has(c.id)))}><Download className="h-3.5 w-3.5" aria-hidden />Xuất CSV</button>
        <select className={cn(inputBase, 'w-auto py-1 text-xs')} disabled={!canEdit} value="" onChange={(e) => { const v = e.target.value as CustomerStatus; if (!v) return; setCustomers((p) => p.map((c) => (sel.has(c.id) ? { ...c, status: v } : c))); notify(`Đã chuyển ${sel.ids.length} khách sang ${CUSTOMER_STATUS[v].label}`, 'teal'); }} aria-label="Đổi trạng thái">
          <option value="">Đổi trạng thái...</option>
          {(Object.keys(CUSTOMER_STATUS) as CustomerStatus[]).map((x) => <option key={x} value={x}>{CUSTOMER_STATUS[x].label}</option>)}
        </select>
        <select className={cn(inputBase, 'w-auto py-1 text-xs')} disabled={!canEdit} value="" onChange={(e) => { const u = users.find((x) => x.id === e.target.value); if (!u) return; setCustomers((p) => p.map((c) => (sel.has(c.id) ? { ...c, amId: u.id, dept: u.dept ?? c.dept } : c))); notify(`Đã giao ${sel.ids.length} khách cho ${u.name}`, 'teal'); }} aria-label="Giao phụ trách">
          <option value="">Giao phụ trách...</option>
          {users.filter((u) => u.active && (u.role === 'SALES_REP' || u.role === 'DEPT_HEAD')).map((u) => <option key={u.id} value={u.id}>{u.name} ({dept(u.dept)?.short})</option>)}
        </select>
        <button className={cn(btnGhost, btnSm, 'hover:text-[#F87171]')} disabled={!canEdit} onClick={bulkDelete}><Trash2 className="h-3.5 w-3.5" aria-hidden />Xóa</button>
      </BulkBar>

      <Panel
        title={`${list.length} khách hàng`}
        action={
          <div className="flex gap-2">
            <RowMenu text="Dữ liệu" icon={FileSpreadsheet} items={[{ label: 'Xuất CSV', icon: Download, onClick: () => exportRows(list) }, { label: 'Nhập từ file', icon: Upload, onClick: () => setImporting(true), disabled: !canEdit }]} />
            <button className={cn(btnPrimary, btnSm, 'max-lg:hidden')} disabled={!canEdit} onClick={() => openCustomerForm()}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm khách hàng</button>
          </div>
        }
      >
        {/* Mobile: danh sách thẻ */}
        <div className="space-y-2 md:hidden">
          {paged.slice.map((c) => (
            <MobileRow
              key={c.id}
              avatar={c.name}
              title={c.name}
              badge={<Chip tone={tierInfo(c.tier).tone}>{tierInfo(c.tier).label}</Chip>}
              sub={`${c.code}, ${c.contactPhone}`}
              value={compact(c.ytdRevenue)}
              status={<Chip tone={CUSTOMER_STATUS[c.status].tone}>{CUSTOMER_STATUS[c.status].label}</Chip>}
              onClick={() => openCustomer(c.id)}
            />
          ))}
        </div>
        {/* Desktop / tablet: bảng */}
        <div className="hidden md:block">
          <Table head={[<input key="all" type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={sel.allOn} onChange={sel.toggleAll} aria-label="Chọn tất cả" />, 'Khách hàng', 'Ngành hàng / AM', 'Doanh số', 'Công nợ', 'Trạng thái', <span key="a" className="block text-right">Thao tác</span>]} minW={1000}>
            {paged.slice.map((c) => {
              return (
                <tr key={c.id} className={cn(rowCls, 'cursor-pointer', sel.has(c.id) && 'bg-[#F28C33]/5')} onClick={() => openCustomer(c.id)}>
                  <td className={cn(tdFirst, 'w-10')} onClick={(e) => e.stopPropagation()}><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={sel.has(c.id)} onChange={() => sel.toggle(c.id)} aria-label={`Chọn ${c.name}`} /></td>
                  <td className={tdCls}>
                    <div className="flex items-center gap-3">
                      <Avatar name={c.name} size={30} />
                      <div className="min-w-0">
                        <p className="max-w-[220px] truncate font-medium text-[#F1F5F9]">{c.name}</p>
                        <p className="max-w-[220px] truncate text-xs text-[#94A3B8]" title={`MST ${c.taxCode} · ${c.contactPhone || 'Chưa có SĐT'}`}><span className="font-mono">{c.code}</span> · {c.contactPhone || `MST ${c.taxCode}`}</p>
                      </div>
                    </div>
                  </td>
                  <td className={tdCls}><p className="text-[#6FA8F0]">{dept(c.dept)?.short}</p><p className="text-xs text-[#94A3B8]">{userName(c.amId)}</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-[#F1F5F9]')}>{compact(c.ytdRevenue)}</td>
                  <td className={tdCls}>{debtPill(c)}</td>
                  <td className={tdCls}><Chip tone={CUSTOMER_STATUS[c.status].tone}>{CUSTOMER_STATUS[c.status].label}</Chip></td>
                  <td className={cn(tdLast, 'whitespace-nowrap text-right')} onClick={(e) => e.stopPropagation()}>
                    <span className="mr-1 inline-block align-middle"><CommentButton entity="customer" entityId={c.id} title={c.name} module="customers" /></span>
                    <button className={cn(btnGhost, 'mr-1 p-1.5')} disabled={!canEdit} onClick={() => openCustomerForm(c.id)} aria-label={`Sửa ${c.name}`}><Pencil className="h-4 w-4" /></button>
                    <RowMenu items={menuFor(c)} />
                  </td>
                </tr>
              );
            })}
          </Table>
        </div>
        {!list.length && <EmptyState text={<>Không có khách hàng khớp bộ lọc.</>} art="search" />}
        <Pagination paged={paged} unit="khách hàng" />
      </Panel>

      <Fab label="Thêm khách hàng" onClick={() => openCustomerForm()} disabled={!canEdit} />
      {importing && <ImportModal spec={importSpec} onClose={() => setImporting(false)} />}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
      {advOpen && (
        <Modal title="Bộ lọc nâng cao" onClose={() => setAdvOpen(false)} footer={<><button className={btnGhost} onClick={() => setAdv({ tier: 'ALL', source: 'ALL', band: 'ALL', roiMin: 0 })}>Xóa bộ lọc</button><button className={btnPrimary} onClick={() => setAdvOpen(false)}>Áp dụng</button></>}>
          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <Field label="Hạng khách hàng">
              <select className={inputCls} value={adv.tier} onChange={(e) => setAdv({ ...adv, tier: e.target.value })}>
                <option value="ALL">Mọi hạng</option>
                {TIERS.map((t) => <option key={t} value={t}>{tierInfo(t).label}</option>)}
              </select>
            </Field>
            <Field label="Nguồn khách hàng">
              <select className={inputCls} value={adv.source} onChange={(e) => setAdv({ ...adv, source: e.target.value })}>
                <option value="ALL">Mọi nguồn</option>
                {sources.map((x) => <option key={x.id} value={x.id}>{x.name}</option>)}
              </select>
            </Field>
            <Field label="Doanh số lũy kế">
              <select className={inputCls} value={adv.band} onChange={(e) => setAdv({ ...adv, band: e.target.value as RevenueBand })}>
                {(Object.keys(REVENUE_BAND) as RevenueBand[]).map((b) => <option key={b} value={b}>{REVENUE_BAND[b].label}</option>)}
              </select>
            </Field>
            <Field label="MDF ROI tối thiểu (lần)"><input className={inputCls} type="number" min={0} step={0.5} value={adv.roiMin} onChange={(e) => setAdv({ ...adv, roiMin: Number(e.target.value) })} /></Field>
          </div>
        </Modal>
      )}
    </div>
  );
}

function CustomerDrawer({ id, onClose }: { id: string; onClose: () => void }) {
  const { customers, claims, programs, myLeads: leads, tierRules, segRules, policy, userName, dept, canDo, openClaim, openCustomerForm, openProgramForm, getflyOrders, quotes, openComposer } = useApp();
  const [tab, setTab] = useState<'overview' | 'quotes' | 'getfly'>('overview');
  const c = customers.find((x) => x.id === id);
  if (!c) return null;
  const gfCount = getflyOrders.filter((o) => o.customerId === c.id).length;
  const cClaims = claims.filter((x) => x.customerId === c.id);
  const cProgs = programs.filter((p) => p.customerId === c.id && p.status !== 'CLAIMING');
  const mdf = mdfOfCustomer(c.id, claims, programs);
  const cap = tierRules.find((r) => r.tier === c.tier)?.mdfCap ?? 0;
  const leverage = mdf > 0 ? c.ytdRevenue / mdf : null;
  const rating = roiRating(leverage);
  const growth = c.lastYearRevenue ? (c.ytdRevenue - c.lastYearRevenue) / c.lastYearRevenue : null;
  const suggested = tierFor(c.ytdRevenue, tierRules);
  const cLeads = leads.filter((l) => l.customerId === c.id || (l.taxCode && l.taxCode === c.taxCode));
  const eligible = !!segRules[c.segment]?.mdfEligible;
  const cQuotes = quotesOfCustomer(c, quotes, leads);

  return (
    <Drawer
      title={c.name}
      eyebrow={`${c.code}, MST ${c.taxCode}`}
      badge={<Chip tone={tierInfo(c.tier).tone}>{tierInfo(c.tier).label}</Chip>}
      onClose={onClose}
      actions={
        <>
          <button className={cn(btnGhost, btnSm)} disabled={!canDo('customer.edit')} onClick={() => openCustomerForm(c.id)}><Pencil className="h-3.5 w-3.5" aria-hidden />Sửa hồ sơ</button>
          <button className={cn(btnBase, btnSm, 'bg-[#F28C33]/15 text-[#F7B23B] hover:bg-[#F28C33]/25')} disabled={!canDo('program.create') || !eligible} title={eligible ? undefined : 'Nhóm khách hàng này không thuộc diện nhận MDF'} onClick={() => openProgramForm(c.id)}>
            <Coins className="h-3.5 w-3.5" aria-hidden />Đề xuất tài trợ MDF
          </button>
        </>
      }
    >
      <Tabs tabs={[{ id: 'overview', label: 'Tổng quan' }, { id: 'quotes', label: `Báo giá (${cQuotes.length})` }, { id: 'getfly', label: `Getfly (${gfCount})` }]} value={tab} onChange={setTab} />
      {tab === 'getfly' ? <GetflyOrdersPanel customer={c} /> : tab === 'quotes' ? <QuoteHistory customer={c} /> : <>
      {/* MDF ROI — chỉ số đòn bẩy chính */}
      <section className="rounded-md border border-[#263044] bg-[#1C2534] p-4">
        <div className="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p className="text-xs text-[#94A3B8]">MDF ROI = Doanh thu mang lại / Chi phí quỹ đã cấp</p>
            <p className="mt-1 text-3xl font-semibold tabular-nums text-[#F1F5F9]">{leverage ? `${leverage.toFixed(1)} lần` : '—'}</p>
          </div>
          <Chip tone={rating.tone}>{rating.label}</Chip>
        </div>
        <p className="mt-2 text-sm tabular-nums text-[#94A3B8]">{vnd(c.ytdRevenue)} / {mdf ? vnd(mdf) : '0 ₫'}</p>
      </section>

      <div className="grid grid-cols-2 gap-3">
        <div className="rounded bg-[#1C2534] p-4">
          <p className="text-xs text-[#94A3B8]">Doanh số lũy kế</p>
          <p className="mt-1 text-xl font-semibold tabular-nums text-[#F1F5F9]">{compact(c.ytdRevenue)}</p>
          {growth !== null && <p className={cn('mt-1 text-xs', growth >= 0 ? 'text-[#3DDBB6]' : 'text-[#F87171]')}>{growth >= 0 ? '+' : ''}{(growth * 100).toFixed(0)}% so với năm trước</p>}
        </div>
        <div className="rounded bg-[#1C2534] p-4">
          <p className="text-xs text-[#94A3B8]">Hạn mức tài trợ hạng {tierInfo(c.tier).label}</p>
          <p className="mt-1 text-xl font-semibold tabular-nums text-[#F7B23B]">{compact(mdf)} / {compact(cap)}</p>
          <div className="mt-2"><ProgressBar value={mdf} max={cap} /></div>
        </div>
        <div className="rounded bg-[#1C2534] p-4">
          <p className="text-xs text-[#94A3B8]">Hạn mức công nợ</p>
          <p className="mt-1 text-xl font-semibold tabular-nums text-[#F1F5F9]">{compact(c.debt)} / {compact(c.creditLimit)}</p>
          <div className="mt-2"><ProgressBar value={c.debt} max={c.creditLimit} /></div>
        </div>
        <div className="rounded bg-[#1C2534] p-4">
          <p className="text-xs text-[#94A3B8]">Phân hạng theo quy tắc</p>
          <p className="mt-1 text-xl font-semibold text-[#F1F5F9]">{tierInfo(suggested).label}</p>
          <p className="mt-1 text-xs text-[#94A3B8]">{suggested === c.tier ? 'Khớp hạng hiện tại' : `Hạng hiện tại ${tierInfo(c.tier).label}, cần rà soát`}</p>
        </div>
      </div>

      <section>
        <h3 className="mb-3 text-sm font-semibold text-[#F1F5F9]">Thông tin doanh nghiệp và liên hệ</h3>
        <dl className="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
          {[
            ['Nhóm khách hàng', `${segName(c.segment)}${eligible ? '' : ' (không nhận MDF)'}`],
            ['Phòng ban quản lý', dept(c.dept)?.name ?? ''],
            ['Người phụ trách', userName(c.amId)],
            ['Nguồn khách hàng', CUSTOMER_SOURCE[c.sourceId]?.name ?? 'Chưa phân loại'],
            ['Khu vực', REGION_LABEL[c.region]],
            ['Người liên hệ', `${c.contactName}${c.contactTitle ? `, ${c.contactTitle}` : ''}`],
            ['Điện thoại', c.contactPhone || 'Chưa có'],
            ['Email', c.contactEmail || 'Chưa có'],
            ['Địa chỉ', c.address || 'Chưa có'],
          ].map(([k, v]) => (
            <div key={k}><dt className="text-xs text-[#94A3B8]">{k}</dt><dd className="mt-0.5 break-words text-[#F1F5F9]">{v}</dd></div>
          ))}
        </dl>
      </section>

      <section>
        <h3 className="mb-3 text-sm font-semibold text-[#F1F5F9]">Lịch sử nhận tài trợ quỹ Hãng</h3>
        {cProgs.length + cClaims.length === 0 ? (
          <p className="rounded border border-dashed border-[#263044] p-4 text-center text-sm text-[#94A3B8]">Khách hàng chưa nhận MDF.{eligible ? ' Bấm Đề xuất tài trợ MDF để bắt đầu.' : ''}</p>
        ) : (
          <ul className="divide-y divide-[#263044] rounded border border-[#263044]">
            {cClaims.map((x) => {
              const st = claimState(x, policy.rules);
              return (
                <li key={x.id}>
                  <button className="flex w-full items-center justify-between gap-3 px-3 py-2.5 text-left hover:bg-[#1C2534]" onClick={() => openClaim(x.id)}>
                    <div className="min-w-0">
                      <p className="truncate text-sm text-[#F1F5F9]">{x.programTitle}</p>
                      <p className="text-xs text-[#94A3B8]">{progName(x.programType)}, {x.period}, {compact(x.claimed)}</p>
                    </div>
                    <Chip tone={st.tone}>{st.label}</Chip>
                  </button>
                </li>
              );
            })}
            {cProgs.map((p) => (
              <li key={p.id} className="flex items-center justify-between gap-3 px-3 py-2.5">
                <div className="min-w-0"><p className="truncate text-sm text-[#F1F5F9]">{p.title}</p><p className="text-xs text-[#94A3B8]">{progName(p.type)}, {p.preApprovalId ?? `${p.code} (chờ 3M cấp mã)`}, {compact(p.held)}</p></div>
                <Chip tone={PROGRAM_STATUS[p.status].tone}>{PROGRAM_STATUS[p.status].label}</Chip>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section>
        <div className="mb-2 flex items-center justify-between gap-2">
          <h3 className="text-sm font-semibold text-[#F1F5F9]">Hợp đồng & tạo báo giá</h3>
          <button className={cn(btnGhost, btnSm)} disabled={!(canDo('project.update') || canDo('customer.edit'))} onClick={() => openComposer({ customerId: c.id, mode: 'QUOTE' })}><Plus className="h-3.5 w-3.5" aria-hidden />Tạo mới</button>
        </div>
        <GeneratedDocList customerId={c.id} compact />
      </section>

      <ActivityList customerId={c.id} />

      <ReservedGoodsPanel kind="CUSTOMER" refId={c.id} />

      <section>
        <h3 className="mb-3 text-sm font-semibold text-[#F1F5F9]">Lead và cơ hội liên quan</h3>
        {cLeads.length === 0 ? (
          <p className="text-sm text-[#94A3B8]">Chưa có lead nào gắn với MST này.</p>
        ) : (
          <ul className="space-y-2">
            {cLeads.map((l) => (
              <li key={l.id} className="flex items-center justify-between gap-3 rounded bg-[#1C2534] px-3 py-2.5">
                <div className="min-w-0"><p className="truncate text-sm text-[#F1F5F9]">{l.boqNote || l.company}</p><p className="text-xs text-[#94A3B8]">{l.code}, {boqIsEstimate(l) ? 'ước tính' : 'BOQ'} {compact(boqTotal(l))}</p></div>
                <Chip tone={LEAD_STATUS[l.status].tone}>{LEAD_STATUS[l.status].label}</Chip>
              </li>
            ))}
          </ul>
        )}
      </section>
      </>}
    </Drawer>
  );
}

// =====================================================================
//  PHÂN HỆ 5: DỰ ÁN & BÁO GIÁ BOQ
// =====================================================================

type Stage = 'ACCEPTED' | 'QUOTED' | 'WON' | 'LOST';
const STAGES: Stage[] = ['ACCEPTED', 'QUOTED', 'WON', 'LOST'];
const stageLabel = (s: LeadStatus) => LEAD_STATUS[s].label;

function PriceProtectionModal({ lead, onClose }: { lead: Lead; onClose: () => void }) {
  const { setLeads, notify } = useApp();
  const [discount, setDiscount] = useState(lead.priceProtection?.discountPct ?? 5);
  const [reason, setReason] = useState('');
  const [touched, setTouched] = useState(false);
  const err = touched && reason.trim().length < 10 ? 'Mô tả đối thủ, giá cạnh tranh hoặc lý do cần bảo vệ giá (tối thiểu 10 ký tự)' : undefined;
  const discErr = touched && (discount <= 0 || discount > 30) ? 'Mức giảm từ 1% đến 30%' : undefined;

  const submit = () => {
    setTouched(true);
    if (reason.trim().length < 10 || discount <= 0 || discount > 30) return;
    setLeads((p) => p.map((l) => (l.id === lead.id ? { ...l, priceProtection: { status: 'REQUESTED', discountPct: discount, reason: reason.trim() } } : l)));
    notify(`Đã gửi đề xuất bảo vệ giá ${discount}% cho ${lead.company}`, 'teal');
    onClose();
  };

  return (
    <Modal title="Đề xuất bảo vệ giá với Hãng" onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={submit}><BadgePercent className="h-4 w-4" aria-hidden />Gửi đề xuất</button></>}>
      <div className="space-y-4">
        <div className="rounded bg-[#1C2534] p-3 text-sm">
          <p className="font-medium text-[#F1F5F9]">{lead.boqNote}</p>
          <p className="text-xs text-[#94A3B8]">{lead.company}, {boqIsEstimate(lead) ? 'ước tính' : 'BOQ'} {vnd(boqTotal(lead))}</p>
        </div>
        <Field label="Mức giá đặc biệt đề nghị (% giảm so với giá niêm yết)" error={discErr}>
          <input className={inputCls} type="number" min={1} max={30} step={0.5} value={discount} onChange={(e) => setDiscount(Number(e.target.value))} />
        </Field>
        <p className="text-sm text-[#94A3B8]">Giá trị sau bảo vệ giá: <span className="tabular-nums text-[#F1F5F9]">{vnd(boqTotal(lead) * (1 - discount / 100))}</span></p>
        <Field label="Lý do / đối thủ cạnh tranh" error={err}>
          <textarea className={cn(inputCls, 'min-h-24')} value={reason} onChange={(e) => setReason(e.target.value)} placeholder="VD: Chủ đầu tư nhận báo giá hãng khác thấp hơn 7%, chốt thầu ngày 20/10" />
        </Field>
      </div>
    </Modal>
  );
}

function LostModal({ lead, onClose }: { lead: Lead; onClose: () => void }) {
  const { markLost } = useApp();
  const [reason, setReason] = useState<LostReason>('PRICE');
  const [note, setNote] = useState('');
  return (
    <Modal
      title={`Ghi nhận Trượt: ${lead.company}`}
      onClose={onClose}
      footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={cn(btnBase, 'bg-[#EF4444] px-3.5 py-2 text-white hover:bg-[#F05252]')} onClick={() => { markLost(lead.id, reason, note.trim()); onClose(); }}>Xác nhận Trượt</button></>}
    >
      <fieldset className="space-y-2">
        <legend className="mb-2 text-xs font-medium text-[#94A3B8]">Lý do trượt</legend>
        {(Object.keys(LOST_REASON) as LostReason[]).map((r) => (
          <label key={r} className={cn('flex cursor-pointer items-center gap-3 rounded border px-3 py-2.5 text-sm', reason === r ? 'border-[#EF4444] bg-[#EF4444]/5' : 'border-[#263044] hover:bg-[#1C2534]')}>
            <input type="radio" name="lost" className="accent-[#EF4444]" checked={reason === r} onChange={() => setReason(r)} />
            {LOST_REASON[r]}
          </label>
        ))}
      </fieldset>
      <Field label="Ghi chú (đối thủ, mức giá, bài học)" className="mt-4">
        <textarea className={cn(inputCls, 'min-h-20')} value={note} onChange={(e) => setNote(e.target.value)} placeholder="VD: Đối thủ chào thấp hơn 9%, tặng bảo trì 2 năm" />
      </Field>
    </Modal>
  );
}

/** Ngày gửi báo giá gần nhất của dự án */
const lastQuoteOf = (leadId: string, quotes: Quote[]) => quotes.filter((q) => q.leadId === leadId).sort((a, b) => b.version - a.version)[0];

function projectStatus(l: Lead, now: number | null, quotes: Quote[]): { label: string; tone: Tone } {
  if (isQuoteOverdue(l, now)) return { label: 'Quá hạn báo giá', tone: 'red' };
  if (l.status === 'QUOTED' && l.priceProtection?.status === 'REQUESTED') return { label: 'Chờ 3M duyệt giá', tone: 'blue' };
  if (l.status === 'QUOTED') return { label: lastQuoteOf(l.id, quotes) ? 'Chờ khách phản hồi' : 'Đã gửi báo giá', tone: 'orange' };
  return LEAD_STATUS[l.status];
}

function ProjectDrawer({ id, onClose, onBoq, onLost, onPP, onEdit }: { id: string; onClose: () => void; onBoq: (l: Lead) => void; onLost: (l: Lead) => void; onPP: (l: Lead) => void; onEdit: (l: Lead) => void }) {
  const { leads, setLeads, quotes, genDocs, userName, dept, now, canDo, openWin, openCustomer, notify, reopenLead, openComposer, skus } = useApp();
  const [tab, setTab] = useState<'quote' | 'contract' | 'progress'>('quote');
  const l = leads.find((x) => x.id === id);
  if (!l) return null;
  const st = projectStatus(l, now, quotes);
  const qs = quotes.filter((q) => q.leadId === l.id).sort((a, b) => b.version - a.version);
  const canEdit = canDo('project.update');
  const patch = (p: Partial<Lead>) => setLeads((all) => all.map((x) => (x.id === l.id ? { ...x, ...p } : x)));
  const pp = l.priceProtection;
  const won = quotes.find((q) => q.id === l.wonQuoteId);
  const wonT = won ? quoteTotals(won.lines, won.vatPct) : null;
  const contracts = genDocs.filter((d) => d.leadId === l.id);
  const latestC = latestContracts(contracts)[0];
  const pv = projectValue(l, quotes);

  return (
    <Drawer
      title={l.company}
      eyebrow={`${l.code}, ${dept(l.dept)?.short ?? ''}, ${userName(l.assignee)}`}
      badge={<Chip tone={st.tone}>{st.label}</Chip>}
      onClose={onClose}
      actions={
        <>
          {['ACCEPTED', 'QUOTED'].includes(l.status) && <button className={cn(btnPrimary, btnSm)} disabled={!canEdit} onClick={() => openComposer({ leadId: l.id, mode: 'QUOTE' })}><FileText className="h-3.5 w-3.5" aria-hidden />{qs.length ? 'Báo giá điều chỉnh' : 'Tạo báo giá'}</button>}
          {l.status === 'QUOTED' && (
            <>
              <button className={cn(btnBase, btnSm, 'bg-[#00B894]/15 text-[#3DDBB6] hover:bg-[#00B894]/25')} disabled={!canEdit} onClick={() => openWin(l.id)}><CheckCircle2 className="h-3.5 w-3.5" aria-hidden />Chốt đơn</button>
              <button className={cn(btnBase, btnSm, 'bg-[#EF4444]/15 text-[#F87171] hover:bg-[#EF4444]/25')} disabled={!canEdit} onClick={() => onLost(l)}>Trượt</button>
            </>
          )}
          {l.status === 'WON' && <button className={cn(btnPrimary, btnSm)} disabled={!canEdit} onClick={() => openComposer(latestC ? { docId: latestC.id, view: true } : { leadId: l.id, quoteId: l.wonQuoteId, mode: 'CONTRACT' })}><FileText className="h-3.5 w-3.5" aria-hidden />{latestC ? 'Mở hợp đồng' : 'Tạo hợp đồng'}</button>}
          {l.status === 'LOST' && <button className={cn(btnGhost, btnSm)} disabled={!canEdit} onClick={() => reopenLead(l.id)}>Mở lại</button>}
          <button className={cn(btnGhost, btnSm)} disabled={!canEdit} onClick={() => onEdit(l)}><Pencil className="h-3.5 w-3.5" aria-hidden />Sửa</button>
        </>
      }
    >
      <ProjectFlow lead={l} />
      <div className="grid grid-cols-3 gap-2 text-sm">
        <div className="rounded bg-[#1C2534] p-2.5"><p className="text-[11px] text-[#94A3B8]">Giá trị dự án</p><p className="font-semibold tabular-nums">{compact(pv.value)}</p><p className="truncate text-[10px] text-[#94A3B8]">{pv.source}</p></div>
        <div className="rounded bg-[#1C2534] p-2.5"><p className="text-[11px] text-[#94A3B8]">Hạn báo giá</p><div className="mt-0.5">{l.status === 'ACCEPTED' ? <QuoteTimer deadline={l.quoteDeadline} now={now} /> : <span className="text-xs">{qs[0] ? `Đã gửi ${fmtDate(qs[0].date)}` : '—'}</span>}</div></div>
        <div className="rounded bg-[#1C2534] p-2.5"><p className="text-[11px] text-[#94A3B8]">Liên hệ</p><p className="truncate text-xs">{l.contact}</p><p className="truncate text-[10px] text-[#94A3B8]">{l.phone}</p></div>
      </div>

      <Tabs tabs={[{ id: 'quote', label: 'Báo giá & BOQ' }, { id: 'contract', label: 'Hợp đồng & Doanh số' }, { id: 'progress', label: 'Tiến độ & Công tác' }]} value={tab} onChange={setTab} />

      {tab === 'quote' && (
        <div className="space-y-5">
          <section>
            <div className="mb-2 flex items-center justify-between gap-2">
              <h3 className="text-sm font-semibold">Bóc tách BOQ {l.boqItems?.length ? `(${compact(boqTotal(l))})` : ''}</h3>
              <button className={cn(btnGhost, btnSm)} disabled={!canEdit || l.status === 'WON' || l.status === 'LOST'} onClick={() => onBoq(l)}><Pencil className="h-3.5 w-3.5" aria-hidden />{l.boqItems?.length ? 'Sửa BOQ' : 'Bóc tách BOQ'}</button>
            </div>
            <div className="mb-2 flex flex-wrap items-center gap-2">
              {l.boqFile ? (
                <a href={l.boqFile.url} target="_blank" rel="noreferrer" className="flex items-center gap-1 text-xs text-[#6FA8F0] hover:underline"><FileText className="h-3.5 w-3.5" aria-hidden />{l.boqFile.name}</a>
              ) : (
                <FilePicker accept=".pdf,.xls,.xlsx,.csv,.dwg,.jpg,.jpeg,.png" disabled={!canEdit} onFiles={(f) => { patch({ hasBoqFile: true, boqFile: { name: f[0].name, url: URL.createObjectURL(f[0]) } }); notify(`Đã đính kèm ${f[0].name}`, 'teal'); }} className={cn(btnGhost, btnSm, 'inline-flex')}><Upload className="h-3.5 w-3.5" aria-hidden />Tải file BOQ</FilePicker>
              )}
            </div>
            {l.boqItems?.length ? (
              <ul className="divide-y divide-[#263044] rounded border border-[#263044] text-sm">
                {l.boqItems.map((it) => (
                  <li key={it.code} className="flex items-center justify-between gap-3 px-3 py-2">
                    <span className="min-w-0"><span className="block truncate">{it.name}</span><span className="text-xs text-[#94A3B8]">{it.code}, {it.qty} {it.unit} x {vnd(it.price)}{!skus.some((s) => s.sku === it.code) ? ', chưa có trong danh mục' : ''}</span></span>
                    <span className="shrink-0 tabular-nums">{compact(it.qty * it.price * (1 - it.discountPct / 100))}</span>
                  </li>
                ))}
              </ul>
            ) : <p className="text-sm text-[#94A3B8]">Chưa bóc tách. Giá trị đang dùng số ước tính {compact(l.boqValue)}.</p>}
          </section>

          <section>
            <h3 className="mb-2 text-sm font-semibold">Phiên bản báo giá ({qs.length})</h3>
            {qs.length ? (
              <ul className="space-y-2">
                {qs.map((q) => (
                  <li key={q.id} className="rounded bg-[#1C2534] px-3 py-2 text-sm">
                    <div className="flex flex-wrap items-center justify-between gap-2">
                      <span><b>{q.code}</b> <span className="text-xs text-[#94A3B8]">v{q.version}, {fmtDate(q.date)}, {q.lines.length} dòng</span></span>
                      <span className="flex items-center gap-2"><span className="tabular-nums">{compact(q.amount)}</span><Chip tone={QUOTE_STATUS[q.status].tone}>{QUOTE_STATUS[q.status].label}</Chip></span>
                    </div>
                    <div className="mt-1.5 flex flex-wrap items-center gap-2">
                      {q.approval && <Chip tone={q.approval.status === 'APPROVED' ? 'teal' : q.approval.status === 'PENDING' ? 'orange' : 'red'}>{q.approval.status === 'APPROVED' ? 'Đã duyệt giá' : q.approval.status === 'PENDING' ? `Chờ ${q.approval.level === 'BOD' ? 'BOD' : 'TP'} duyệt giá` : q.approval.status === 'NEED_INFO' ? 'Yêu cầu sửa giá' : 'Từ chối giá'}</Chip>}
                      {canDo('price.viewCost') && q.gmPct !== undefined && <span className="text-xs tabular-nums text-[#94A3B8]">GM {q.gmPct.toFixed(1)}%</span>}
                      <button className={cn(btnGhost, btnSm, 'ml-auto')} onClick={() => openComposer({ leadId: l.id, quoteId: q.id, mode: 'QUOTE' })}><Eye className="h-3.5 w-3.5" aria-hidden />Xem</button>
                    </div>
                  </li>
                ))}
              </ul>
            ) : <p className="text-sm text-[#94A3B8]">Chưa có báo giá. Bấm "Tạo báo giá": dòng hàng lấy từ BOQ, sửa giá / chiết khấu, xem trước A4 rồi xuất.</p>}
          </section>

          <section>
            <div className="mb-2 flex items-center justify-between gap-2">
              <h3 className="text-sm font-semibold">Bảo vệ giá 3M</h3>
              {!pp && ['ACCEPTED', 'QUOTED'].includes(l.status) && <button className={cn(btnGhost, btnSm)} disabled={!canDo('price.request')} onClick={() => onPP(l)}><BadgePercent className="h-3.5 w-3.5" aria-hidden />Đề xuất</button>}
            </div>
            {pp ? (
              <div className="rounded bg-[#1C2534] p-3 text-sm">
                <div className="flex items-center justify-between gap-2"><span>Giảm {pp.discountPct}%{pp.ref ? `, mã ${pp.ref}` : ''}</span><Chip tone={PP_STATUS[pp.status].tone}>{PP_STATUS[pp.status].label}</Chip></div>
                <p className="mt-1 text-xs text-[#94A3B8]">{pp.reason}</p>
              </div>
            ) : <p className="text-sm text-[#94A3B8]">Chưa đề xuất.</p>}
          </section>
        </div>
      )}

      {tab === 'contract' && (
        <div className="space-y-5">
          {l.status === 'WON' && won && wonT ? (
            <section className="rounded-md border border-[#00B894]/40 bg-[#00B894]/5 p-4">
              <p className="flex items-center gap-2 text-sm font-semibold text-[#3DDBB6]"><CheckCircle2 className="h-4 w-4" aria-hidden />Đã chốt đơn theo {won.code} v{won.version}{l.wonAt ? `, ngày ${fmtDate(l.wonAt)}` : ''}</p>
              <div className="mt-3 grid grid-cols-3 gap-2 text-sm">
                <div><p className="text-xs text-[#94A3B8]">Doanh số trước VAT</p><p className="font-semibold tabular-nums">{vnd(wonT.sub)}</p></div>
                <div><p className="text-xs text-[#94A3B8]">VAT</p><p className="font-semibold tabular-nums">{vnd(wonT.vat)}</p></div>
                <div><p className="text-xs text-[#94A3B8]">Sau VAT</p><p className="font-semibold tabular-nums">{vnd(wonT.gross)}</p></div>
              </div>
              <div className="mt-3 flex items-center gap-2 text-xs">
                {l.getflySync?.status === 'SYNCED' ? <Chip tone="teal"><Link2 className="h-3 w-3" aria-hidden />Getfly {l.getflySync.orderCode}</Chip> : <Chip tone="teal"><RefreshCw className="h-3 w-3" aria-hidden />Đã kích hoạt đồng bộ Getfly CRM</Chip>}
                <span className="text-[#94A3B8]">{l.getflySync?.status === 'SYNCED' ? 'Đơn đã có trên Getfly' : 'Gửi tự động khi tích hợp được bật'}</span>
              </div>
              {l.customerId && <button className={cn(btnGhost, btnSm, 'mt-3')} onClick={() => openCustomer(l.customerId!)}>Xem khách hàng</button>}
            </section>
          ) : l.status === 'LOST' ? (
            <p className="rounded bg-[#EF4444]/10 p-3 text-sm text-[#F87171]">Trượt{l.lostReason ? `: ${LOST_REASON[l.lostReason]}` : ''}{l.lostNote ? `. ${l.lostNote}` : ''}</p>
          ) : (
            <p className="rounded bg-[#1C2534] p-3 text-sm text-[#94A3B8]">Chưa chốt đơn. Khi chốt, chọn phiên bản báo giá; doanh số được ghi nhận và hợp đồng tự soạn từ báo giá đó.</p>
          )}
          <section>
            <div className="mb-2 flex items-center justify-between gap-2">
              <h3 className="text-sm font-semibold">Hợp đồng</h3>
              {l.status === 'WON' && !contracts.length && <button className={cn(btnGhost, btnSm)} disabled={!canEdit} onClick={() => openComposer({ leadId: l.id, quoteId: l.wonQuoteId, mode: 'CONTRACT' })}><Plus className="h-3.5 w-3.5" aria-hidden />Tạo hợp đồng</button>}
            </div>
            <GeneratedDocList leadId={l.id} compact />
          </section>
        </div>
      )}

      {tab === 'progress' && (
        <div className="space-y-5">
          <dl className="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
            {[
              ['Nhu cầu', l.boqNote || '—'],
              ['Khu vực', `${l.province ? `${l.province}, ` : ''}${REGION_LABEL[l.region]}`],
              ['Nhóm khách hàng', segName(l.segment)],
              ['Kênh nguồn', SOURCE_LABEL[l.source]],
            ].map(([k, v]) => <div key={k}><dt className="text-xs text-[#94A3B8]">{k}</dt><dd className="mt-0.5 break-words">{v}</dd></div>)}
          </dl>
          {(l.attachments?.length ?? 0) > 0 && (
            <div className="flex flex-wrap gap-2">
              {l.attachments!.map((a) => <a key={a.url} href={a.url} target="_blank" rel="noreferrer" className="flex items-center gap-1 rounded-md bg-[#1C2534] px-2 py-1 text-xs text-[#6FA8F0]"><Paperclip className="h-3 w-3" aria-hidden />{a.name}</a>)}
            </div>
          )}
          <ActivityList leadId={l.id} customerId={l.customerId} />
          <ReservedGoodsPanel kind="LEAD" refId={l.id} />
        </div>
      )}
    </Drawer>
  );
}

/** Gantt dự án: thanh từ ngày nhận → ngày chốt (hoặc ngày dự kiến theo chu kỳ chốt lịch sử), mốc gửi báo giá, hạn báo giá, vạch hôm nay */
function ProjectGantt({ list, onOpen }: { list: Lead[]; onOpen: (id: string) => void }) {
  const { quotes, userName, now } = useApp();
  const t = now ?? Date.now();
  const DAY = 864e5;
  const wonDays = list.filter((l) => l.status === 'WON' && l.wonAt).map((l) => (isoMs(l.wonAt) - leadAt(l)) / DAY).filter((x) => x > 0);
  const cycle = Number.isFinite(median(wonDays)) ? Math.max(14, median(wonDays)) : 45;
  const rows = list.slice(0, 60).map((l) => {
    const start = leadAt(l);
    const qs = quotes.filter((q) => q.leadId === l.id).map((q) => q.createdAt ?? isoMs(q.date)).filter(Number.isFinite);
    const end = l.status === 'WON' && l.wonAt ? isoMs(l.wonAt) : l.status === 'LOST' ? Math.max(start + 3 * DAY, ...qs, start) : Math.max(start + cycle * DAY, l.quoteDeadline ?? 0, t + 3 * DAY);
    return { l, start, end, qs, planned: l.status !== 'WON' && l.status !== 'LOST' };
  });
  if (!rows.length) return <EmptyState text={<>Không có dự án để vẽ Gantt</>} hint={<>Bỏ bớt bộ lọc hoặc đổi khoảng thời gian.</>} art="calendar" />;
  const min = Math.min(...rows.map((r) => r.start), t - 7 * DAY);
  const max = Math.max(...rows.map((r) => r.end), t + 14 * DAY);
  const d0 = new Date(min); d0.setDate(1); d0.setHours(0, 0, 0, 0);
  const from = d0.getTime();
  const days = Math.ceil((max - from) / DAY) + 3;
  const PX = days > 240 ? 4 : days > 120 ? 6 : 10;
  const width = days * PX;
  const x = (ms: number) => ((ms - from) / DAY) * PX;
  const months: { label: string; left: number }[] = [];
  for (let m = new Date(from); m.getTime() < from + days * DAY; m = new Date(m.getFullYear(), m.getMonth() + 1, 1)) months.push({ label: `T${m.getMonth() + 1}/${m.getFullYear()}`, left: x(m.getTime()) });
  const bar = (l: Lead) => (l.status === 'WON' ? 'bg-[#00B894]' : l.status === 'LOST' ? 'bg-[#EF4444]/70' : l.status === 'QUOTED' ? 'g-brand' : l.status === 'ACCEPTED' ? 'bg-[#0B5FB8]' : 'bg-[#475569]');
  return (
    <section className="rounded-md border border-white/[0.06] bg-[#151C29]/80">
      <header className="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-white/[0.06] px-5 py-4">
        <h2 className="font-display mr-auto text-[15px] font-bold">Tiến độ dự án (Gantt) · {rows.length}{list.length > rows.length ? ` / ${list.length}` : ''}</h2>
        {[['bg-[#0B5FB8]', 'Đang bóc BOQ / khảo sát'], ['g-brand', 'Đã gửi báo giá'], ['bg-[#00B894]', 'Chốt đơn'], ['bg-[#EF4444]/70', 'Trượt']].map(([c, l]) => <span key={l} className="flex items-center gap-1.5 text-[11px] text-[#94A3B8]"><i className={cn('h-2.5 w-4 rounded-sm', c)} />{l}</span>)}
        <span className="flex items-center gap-1.5 text-[11px] text-[#94A3B8]"><i className="h-2.5 w-2.5 rotate-45 bg-[#F6B533]" />Gửi báo giá</span>
        <span className="flex items-center gap-1.5 text-[11px] text-[#94A3B8]"><i className="h-2.5 w-4 rounded-sm border border-dashed border-[#94A3B8]" />Dự kiến (chu kỳ {Math.round(cycle)} ngày)</span>
      </header>
      <div className="flex">
        <div className="w-[220px] shrink-0 border-r border-white/[0.06]">
          <div className="h-9 border-b border-white/[0.06] px-4 py-2.5 text-[11px] font-semibold uppercase tracking-wider text-[#94A3B8]/80">Dự án</div>
          {rows.map(({ l }) => (
            <button key={l.id} className="flex h-12 w-full flex-col justify-center border-b border-white/[0.04] px-4 text-left hover:bg-[#0B5FB8]/10" onClick={() => onOpen(l.id)}>
              <span className="truncate text-sm font-medium">{l.company}</span>
              <span className="truncate text-[11px] text-[#94A3B8]">{l.code} · {userName(l.assignee) || 'Chưa giao'}</span>
            </button>
          ))}
        </div>
        <div className="min-w-0 flex-1 overflow-x-auto">
          <div className="relative" style={{ width, minWidth: '100%' }}>
            <div className="relative h-9 border-b border-white/[0.06]">
              {months.map((m) => <span key={m.label} className="absolute top-0 h-full border-l border-white/[0.06] pl-2 pt-2.5 text-[11px] font-semibold text-[#94A3B8]" style={{ left: m.left }}>{m.label}</span>)}
            </div>
            {months.map((m) => <span key={`g${m.label}`} className="pointer-events-none absolute bottom-0 top-9 border-l border-white/[0.04]" style={{ left: m.left }} aria-hidden />)}
            <span className="pointer-events-none absolute bottom-0 top-0 z-10 w-px bg-[#6FA8F0]" style={{ left: x(t) }} aria-hidden><span className="absolute -top-0 left-1 whitespace-nowrap rounded-sm bg-[#0B5FB8] px-1 text-[10px] font-semibold text-white">Hôm nay</span></span>
            {rows.map(({ l, start, end, qs, planned }) => {
              const realEnd = planned ? Math.min(end, t) : end;
              return (
                <div key={l.id} className="relative h-12 border-b border-white/[0.04]">
                  <button className={cn('absolute top-3.5 h-5 rounded-sm opacity-90 hover:opacity-100', bar(l))} style={{ left: x(start), width: Math.max(6, x(realEnd) - x(start)) }} onClick={() => onOpen(l.id)}
                    title={`${l.company}: nhận ${fmtDate(iso(new Date(start)))}${l.wonAt ? `, chốt ${fmtDate(l.wonAt)}` : planned ? `, dự kiến chốt ${fmtDate(iso(new Date(end)))}` : ''} · ${compact(boqTotal(l))}`}
                    aria-label={`${l.company}, ${LEAD_STATUS[l.status].label}`}>
                    <span className="block truncate px-1.5 text-[10px] font-semibold leading-5 text-[#0F141E] mix-blend-normal">{x(realEnd) - x(start) > 60 ? compact(boqTotal(l)) : ''}</span>
                  </button>
                  {planned && end > realEnd && <span className="absolute top-3.5 h-5 rounded-sm border border-dashed border-[#94A3B8]/60" style={{ left: x(realEnd), width: Math.max(4, x(end) - x(realEnd)) }} aria-hidden />}
                  {qs.map((q, i) => <i key={i} className="absolute top-[22px] h-2.5 w-2.5 -translate-x-1/2 rotate-45 border border-[#0F141E] bg-[#F6B533]" style={{ left: x(q) }} title={`Gửi báo giá ${new Date(q).toLocaleDateString('vi-VN')}`} />)}
                  {l.status === 'ACCEPTED' && l.quoteDeadline && <i className={cn('absolute top-2.5 h-7 w-0.5 rounded', l.quoteDeadline < t ? 'bg-[#EF4444]' : 'bg-[#F7B23B]')} style={{ left: x(l.quoteDeadline) }} title={`Hạn báo giá ${new Date(l.quoteDeadline).toLocaleString('vi-VN')}`} />}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  );
}

function ProjectsPage() {
  const { leads: allLeads, myLeads: leads, setLeads, notify, canDo, userName, dept, openWin, now, range, quotes, setQuotes, users, openLeadForm, simulateQuoteOverdue, reopenLead, reservations, openComposer, genDocs } = useApp();
  const inR = useInRange();
  const inPrev = inRangeOf(prevRange(range));
  const [stage, setStage] = useState<'ALL' | Stage>('ALL');
  const [q, setQ] = useState('');
  const [dp, setDp] = useState('ALL');
  const [owner, setOwner] = useState('ALL');
  const [adv, setAdv] = useState({ min: 0, max: 0, boq: 'ALL', pp: false });
  const [advOpen, setAdvOpen] = useState(false);
  const [viewId, setViewId] = useState<string | null>(null);
  const [ppLead, setPpLead] = useState<Lead | null>(null);
  const [lostLead, setLostLead] = useState<Lead | null>(null);
  const [boqLead, setBoqLead] = useState<Lead | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const [view, setView] = useState<'table' | 'gantt'>('table');
  const seedDemo = useSeedSalesDemo();
  const canEdit = canDo('project.update');
  const advCount = [adv.min > 0, adv.max > 0, adv.boq !== 'ALL', adv.pp].filter(Boolean).length;

  const isOpp = (l: Lead) => (STAGES as LeadStatus[]).includes(l.status);
  const opp = leads.filter((l) => {
    const t = q.trim().toLowerCase();
    const v = boqTotal(l);
    return isOpp(l)
      && (!t || [l.company, l.code, l.taxCode ?? '', l.boqNote, l.getflySync?.orderCode ?? ''].some((x) => x.toLowerCase().includes(t)))
      && (dp === 'ALL' || l.dept === dp) && (owner === 'ALL' || l.assignee === owner) && inR(leadDate(l))
      && (!adv.min || v >= adv.min) && (!adv.max || v <= adv.max) && (adv.boq === 'ALL' || (l.boqStatus ?? 'NOT_STARTED') === adv.boq) && (!adv.pp || !!l.priceProtection);
  });
  const list = (stage === 'ALL' ? opp : opp.filter((l) => l.status === stage)).sort((a, b) => Number(isQuoteOverdue(b, now)) - Number(isQuoteOverdue(a, now)) || a.receivedDaysAgo - b.receivedDaysAgo);
  const paged = usePaged(list, 10);
  const sel = useSelection(list.map((l) => l.id));
  const overdue = opp.filter((l) => isQuoteOverdue(l, now));
  const ppPending = opp.filter((l) => l.priceProtection?.status === 'REQUESTED').length;

  // ---- KPI ----
  const prevOpp = leads.filter((l) => isOpp(l) && inPrev(leadDate(l)));
  const open = opp.filter((l) => l.status === 'ACCEPTED' || l.status === 'QUOTED');
  const openPrev = prevOpp.filter((l) => l.status === 'ACCEPTED' || l.status === 'QUOTED');
  const boqSum = open.reduce((s, l) => s + boqTotal(l), 0);
  const expected = open.reduce((s, l) => s + (quotes.filter((x) => x.leadId === l.id && x.status === 'SENT')[0]?.amount ?? 0), 0);
  const conv = (arr: Lead[]) => { const w = arr.filter((l) => l.status === 'WON').length; const lo = arr.filter((l) => l.status === 'LOST').length; return w + lo ? (w / (w + lo)) * 100 : 0; };
  const owners = users.filter((u) => u.active && leads.some((l) => l.assignee === u.id && isOpp(l)));

  const askDelete = (l: Lead) => setConfirm({
    title: 'Xóa dự án',
    message: <>Xóa dự án <b>{l.company}</b>: {l.boqNote}? Báo giá liên quan cũng bị xóa.</>,
    blocked: l.status === 'WON' ? 'Dự án đã chốt đơn, gắn khách hàng và đơn Getfly. Không thể xóa.' : reservations.some((r) => r.kind === 'LEAD' && r.refId === l.id && (r.status === 'HELD' || r.status === 'PENDING_RELEASE')) ? 'Dự án còn hàng giữ chỗ trong kho. Giải phóng hoặc chuyển giữ chỗ trước khi xóa.' : undefined,
    onConfirm: () => { setLeads((p) => p.filter((x) => x.id !== l.id)); setQuotes((p) => p.filter((x) => x.leadId !== l.id)); notify(`Đã xóa dự án ${l.code}`, 'orange'); },
  });
  const menuFor = (l: Lead): MenuItem[] => [
    { label: 'Xem chi tiết', icon: Eye, onClick: () => setViewId(l.id) },
    ...(l.status === 'WON' ? [{ label: 'Hợp đồng', icon: FileText, onClick: () => { const d = genDocs.find((x) => x.leadId === l.id); openComposer(d ? { docId: d.id } : { leadId: l.id, quoteId: l.wonQuoteId, mode: 'CONTRACT' }); }, disabled: !canEdit }] : []),
    { label: l.boqItems?.length ? 'Sửa dòng BOQ' : 'Bóc tách BOQ', icon: FileSpreadsheet, onClick: () => setBoqLead(l), disabled: !canEdit || l.status === 'WON' || l.status === 'LOST' },
    ...(l.status === 'ACCEPTED' ? [{ label: 'Tạo báo giá', icon: FileText, onClick: () => openComposer({ leadId: l.id, mode: 'QUOTE' }), disabled: !canEdit }] : []),
    ...(l.status === 'QUOTED' ? [
      { label: 'Báo giá điều chỉnh', icon: Send, onClick: () => openComposer({ leadId: l.id, mode: 'QUOTE' }), disabled: !canEdit },
      { label: 'Chốt đơn', icon: CheckCircle2, onClick: () => openWin(l.id), disabled: !canEdit },
      { label: 'Trượt', icon: XCircle, onClick: () => setLostLead(l), disabled: !canEdit },
    ] : []),
    ...(!l.priceProtection && ['ACCEPTED', 'QUOTED'].includes(l.status) ? [{ label: 'Đề xuất bảo vệ giá 3M', icon: BadgePercent, onClick: () => setPpLead(l), disabled: !canDo('price.request') }] : []),
    ...(l.status === 'LOST' ? [{ label: 'Mở lại', icon: RefreshCw, onClick: () => reopenLead(l.id), disabled: !canEdit }] : []),
    { label: 'Xóa dự án', icon: Trash2, onClick: () => askDelete(l), danger: true, disabled: !canDo('lead.create') },
  ];
  const exportRows = (rows: Lead[]) => downloadCsv('du_an_boq.csv', [
    ['ma', 'khach_hang', 'du_an', 'phong_ban', 'phu_trach', 'gia_tri', 'nguon_gia_tri', 'trang_thai', 'bao_gia_gan_nhat'],
    ...rows.map((l) => [l.code, l.company, l.boqNote, dept(l.dept)?.short ?? '', userName(l.assignee), boqTotal(l), boqIsEstimate(l) ? 'Ước tính' : 'BOQ', LEAD_STATUS[l.status].label, lastQuoteOf(l.id, quotes)?.code ?? '']),
  ]);
  const quoteCell = (l: Lead) => {
    const lq = lastQuoteOf(l.id, quotes);
    return lq ? <span className="flex items-center gap-1.5 text-xs text-[#F1F5F9]"><Send className="h-3.5 w-3.5 text-[#94A3B8]" aria-hidden />Đã gửi {fmtDate(lq.date).slice(0, 5)}<span className="text-[#94A3B8]">(lần {lq.version})</span></span> : <span className="flex items-center gap-1.5 text-xs text-[#F87171]"><XCircle className="h-3.5 w-3.5" aria-hidden />Chưa gửi</span>;
  };

  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-5')}>
        <StatCard label="Khách dự án" value={String(new Set(opp.map((l) => l.taxCode || l.company)).size)} icon={Users} color={C.blue} spark={monthly(opp, leadAt)} delta={pctDelta(opp.length, prevOpp.length)} deltaLabel="dự án so với kỳ trước" />
        <StatCard label="Đang triển khai" value={String(open.length)} icon={FolderKanban} color={C.teal} delta={pctDelta(open.length, openPrev.length)} />
        <StatCard label="Giá trị BOQ" value={compact(boqSum)} icon={FileSpreadsheet} color={C.orange} highlight spark={monthly(opp, leadAt, (l) => boqTotal(l))} delta={pctDelta(boqSum, openPrev.reduce((s, l) => s + boqTotal(l), 0))} />
        <StatCard label="Doanh số dự kiến" value={compact(expected)} icon={TrendingUp} color="#8B5CF6" sub="Báo giá đang chờ khách phản hồi" />
        <StatCard label="Chuyển đổi" value={`${conv(opp).toFixed(0)}%`} icon={Target} color={C.red} delta={pctDelta(conv(opp), conv(prevOpp))} />
      </div>

      <FilterBar
        q={q} onQ={setQ} placeholder="Tìm dự án, khách hàng, mã dự án, mã đơn Getfly..."
        dept={dp} onDept={setDp} status={stage} onStatus={(v) => setStage(v as 'ALL' | Stage)}
        statusOptions={STAGES.map((s) => ({ value: s, label: stageLabel(s) }))}
        onAdvanced={() => setAdvOpen(true)} advancedCount={advCount} extraActive={owner !== 'ALL' ? 1 : 0}
        actions={<><ViewSwitch value={view} onChange={setView} options={['table', 'gantt']} /><div className="hidden lg:block"><DateRangePicker /></div></>}
      >
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={owner} onChange={(e) => setOwner(e.target.value)} aria-label="Phụ trách">
          <option value="ALL">Tất cả phụ trách</option>
          {owners.map((u) => <option key={u.id} value={u.id}>{u.name}</option>)}
        </select>
      </FilterBar>

      {(overdue.length > 0 || ppPending > 0) && (
        <div className="flex flex-col gap-2 rounded-md border border-[#F28C33]/40 bg-[#F28C33]/10 px-4 py-3 sm:flex-row sm:items-center">
          <AlertTriangle className="hidden h-5 w-5 shrink-0 text-[#F7B23B] sm:block" aria-hidden />
          <p className="flex-1 text-sm text-[#F7B23B]">
            {overdue.length > 0 && <span className="text-[#F87171]">{overdue.length} dự án quá hạn nộp báo giá 24 giờ, đã leo thang tới Trưởng phòng. </span>}
            {ppPending > 0 && <span>{ppPending} đề xuất bảo vệ giá đang chờ 3M phản hồi.</span>}
          </p>
          <div className="flex gap-2">
            <button className={cn(btnGhost, btnSm)} onClick={simulateQuoteOverdue}>Mô phỏng quá hạn</button>
            <button className={cn(btnPrimary, btnSm, 'max-lg:hidden')} disabled={!canEdit} onClick={() => openLeadForm(true)}><Plus className="h-3.5 w-3.5" aria-hidden />Tạo dự án mới</button>
          </div>
        </div>
      )}

      <BulkBar count={sel.ids.length} onClear={sel.clear}>
        <button className={cn(btnGhost, btnSm)} onClick={() => exportRows(allLeads.filter((l) => sel.has(l.id)))}><Download className="h-3.5 w-3.5" aria-hidden />Xuất CSV</button>
        <select className={cn(inputBase, 'w-auto py-1 text-xs')} disabled={!canDo('lead.assign') && !canEdit} value="" onChange={(e) => { const u = users.find((x) => x.id === e.target.value); if (!u) return; setLeads((p) => p.map((l) => (sel.has(l.id) ? { ...l, assignee: u.id, dept: u.dept ?? l.dept } : l))); notify(`Đã giao ${sel.ids.length} dự án cho ${u.name}`, 'teal'); sel.clear(); }} aria-label="Giao phụ trách">
          <option value="">Giao phụ trách...</option>
          {users.filter((u) => u.active && (u.role === 'SALES_REP' || u.role === 'DEPT_HEAD')).map((u) => <option key={u.id} value={u.id}>{u.name} ({dept(u.dept)?.short})</option>)}
        </select>
      </BulkBar>

      {view === 'gantt' ? <ProjectGantt list={list} onOpen={setViewId} /> : (
      <Panel
        title={`Danh sách dự án & BOQ (${list.length})`}
        action={
          <div className="flex gap-2">
            <RowMenu text="Thao tác" icon={FileSpreadsheet} items={[{ label: 'Xuất CSV', icon: Download, onClick: () => exportRows(list) }, { label: 'Tạo ví dụ luồng bán hàng', icon: Zap, onClick: () => setViewId(seedDemo()), disabled: !canEdit }]} />
            {!(overdue.length > 0 || ppPending > 0) && <button className={cn(btnPrimary, btnSm, 'max-lg:hidden')} disabled={!canEdit} onClick={() => openLeadForm(true)}><Plus className="h-3.5 w-3.5" aria-hidden />Tạo dự án mới</button>}
          </div>
        }
      >
        <div className="space-y-2 md:hidden">
          {paged.slice.map((l) => {
            const st = projectStatus(l, now, quotes);
            return (
              <MobileRow key={l.id} avatar={l.company} title={l.company} sub={`${l.code}, ${REGION_LABEL[l.region]}`} badge={quoteCell(l)} value={compact(projectValue(l, quotes).value)} status={<Chip tone={st.tone}>{st.label}</Chip>} onClick={() => setViewId(l.id)} />
            );
          })}
        </div>
        <div className="hidden md:block">
          <Table head={[<input key="all" type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={sel.allOn} onChange={sel.toggleAll} aria-label="Chọn tất cả" />, 'Khách hàng / Dự án', 'Phòng ban / Phụ trách', 'Giá trị dự án', 'Hạn báo giá', 'Báo giá', 'Trạng thái', <span key="a" className="block text-right">Thao tác</span>]} minW={1000}>
            {paged.slice.map((l) => {
              const late = isQuoteOverdue(l, now);
              const st = projectStatus(l, now, quotes);
              return (
                <tr key={l.id} className={cn(rowCls, 'cursor-pointer', late && 'bg-[#EF4444]/5', sel.has(l.id) && 'bg-[#F28C33]/5')} onClick={() => setViewId(l.id)}>
                  <td className={cn(tdFirst, 'w-10', late && 'border-l-2 border-l-[#EF4444] motion-safe:animate-[blinkBorder_1.2s_ease-in-out_infinite]')} onClick={(e) => e.stopPropagation()}><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={sel.has(l.id)} onChange={() => sel.toggle(l.id)} aria-label={`Chọn ${l.company}`} /></td>
                  <td className={tdCls}>
                    <div className="flex items-center gap-2">
                      <Avatar name={l.company} size={28} />
                      <div className="min-w-0">
                        <p className="max-w-[190px] truncate font-medium text-[#F1F5F9]" title={l.boqNote}>{l.company}</p>
                        <p className="max-w-[190px] truncate text-xs text-[#94A3B8]"><span className="font-mono text-[#F7B23B]">{l.code}</span> · {l.boqNote || (l.province ?? REGION_LABEL[l.region])}</p>
                      </div>
                    </div>
                  </td>
                  <td className={tdCls}><p>{dept(l.dept)?.short}</p><p className="text-xs text-[#94A3B8]">{userName(l.assignee)}</p></td>
                  <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{(() => { const pv = projectValue(l, quotes); return <><p className="text-[#F1F5F9]">{compact(pv.value)}</p><p className={cn('text-[11px]', pv.source === 'Ước tính MKT' ? 'text-[#F7B23B]' : 'text-[#94A3B8]')}>{pv.source}</p></>; })()}</td>
                  <td className={tdCls}>{l.status === 'ACCEPTED' ? <QuoteTimer deadline={l.quoteDeadline} now={now} /> : <span className="text-xs text-[#94A3B8]">{l.quoteDeadline ? fmtDate(iso(new Date(l.quoteDeadline))) : '—'}</span>}</td>
                  <td className={tdCls}>{quoteCell(l)}</td>
                  <td className={tdCls}><Chip tone={st.tone}>{st.label}</Chip></td>
                  <td className={cn(tdLast, 'whitespace-nowrap text-right')} onClick={(e) => e.stopPropagation()}>
                    <span className="mr-1 inline-block align-middle"><CommentButton entity="lead" entityId={l.id} title={`${l.code} · ${l.company}`} module="projects" /></span>
                    <button className={cn(btnGhost, 'mr-1 p-1.5')} disabled={!canEdit} onClick={() => openLeadForm(false, l.id)} aria-label={`Sửa ${l.company}`}><Pencil className="h-4 w-4" /></button>
                    <RowMenu items={menuFor(l)} />
                  </td>
                </tr>
              );
            })}
          </Table>
        </div>
        {!list.length && (
          <div className="py-8 text-center text-sm text-[#94A3B8]">
            <p>Chưa có dự án khớp bộ lọc. Lead được Sales tiếp nhận hoặc dự án Sales tự tạo sẽ hiện ở đây.</p>
            <button className={cn(btnPrimary, 'mt-3')} disabled={!canEdit} onClick={() => setViewId(seedDemo())}><Zap className="h-4 w-4" aria-hidden />Tạo ví dụ: BOQ → Báo giá → Chốt đơn → Getfly</button>
          </div>
        )}
        <Pagination paged={paged} unit="dự án" />
      </Panel>
      )}

      <Fab label="Tạo dự án mới" onClick={() => openLeadForm(true)} disabled={!canEdit} />
      {viewId && <ProjectDrawer id={viewId} onClose={() => setViewId(null)} onBoq={setBoqLead} onLost={setLostLead} onPP={setPpLead} onEdit={(l) => openLeadForm(false, l.id)} />}
      {ppLead && <PriceProtectionModal lead={ppLead} onClose={() => setPpLead(null)} />}
      {boqLead && <BoqEditorModal lead={allLeads.find((x) => x.id === boqLead.id) ?? boqLead} onClose={() => setBoqLead(null)} />}
      {lostLead && <LostModal lead={lostLead} onClose={() => setLostLead(null)} />}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
      {advOpen && (
        <Modal title="Bộ lọc nâng cao" onClose={() => setAdvOpen(false)} footer={<><button className={btnGhost} onClick={() => setAdv({ min: 0, max: 0, boq: 'ALL', pp: false })}>Xóa bộ lọc</button><button className={btnPrimary} onClick={() => setAdvOpen(false)}>Áp dụng</button></>}>
          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <Field label="Giá trị từ"><MoneyInput value={adv.min} onChange={(n) => setAdv({ ...adv, min: n })} /></Field>
            <Field label="Giá trị đến"><MoneyInput value={adv.max} onChange={(n) => setAdv({ ...adv, max: n })} /></Field>
            <label className="flex items-center gap-2 self-end pb-2 text-sm"><input type="checkbox" className="h-4 w-4 accent-[#F28C33]" checked={adv.pp} onChange={(e) => setAdv({ ...adv, pp: e.target.checked })} />Chỉ dự án có đề xuất bảo vệ giá</label>
          </div>
        </Modal>
      )}
    </div>
  );
}

// ---- Lịch sử báo giá trong Khách hàng 360 ----
function QuoteHistory({ customer: c }: { customer: Customer }) {
  const { quotes, setQuotes, leads, canDo, notify, openComposer } = useApp();
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const list = quotesOfCustomer(c, quotes, leads);
  const accepted = list.filter((q) => q.status === 'ACCEPTED');
  const canEdit = canDo('project.update');
  if (!list.length) return <p className="rounded-md border border-dashed border-[#263044] p-6 text-center text-sm text-[#94A3B8]">Chưa có báo giá nào cho khách hàng này.</p>;
  return (
    <div className="space-y-4">
      <div className="grid grid-cols-3 gap-3 text-sm">
        <div className="rounded bg-[#1C2534] p-3"><p className="text-xs text-[#94A3B8]">Số báo giá</p><p className="mt-1 text-lg font-semibold tabular-nums">{list.length}</p></div>
        <div className="rounded bg-[#1C2534] p-3"><p className="text-xs text-[#94A3B8]">Được chấp nhận</p><p className="mt-1 text-lg font-semibold tabular-nums text-[#3DDBB6]">{accepted.length}</p></div>
        <div className="rounded bg-[#1C2534] p-3"><p className="text-xs text-[#94A3B8]">Giá trị chấp nhận</p><p className="mt-1 text-lg font-semibold tabular-nums">{compact(accepted.reduce((s, q) => s + q.amount, 0))}</p></div>
      </div>
      <ul className="divide-y divide-[#263044] rounded border border-[#263044]">
        {list.map((q) => {
          const l = leads.find((x) => x.id === q.leadId);
          return (
            <li key={q.id} className="flex flex-wrap items-start gap-3 px-3 py-3">
              <History className="mt-0.5 h-4 w-4 shrink-0 text-[#94A3B8]" aria-hidden />
              <div className="min-w-0 flex-1">
                <p className="text-sm"><b>{q.code}</b> <span className="text-[#94A3B8]">lần {q.version}, {fmtDate(q.date)}</span></p>
                <p className="truncate text-xs text-[#94A3B8]">{l?.boqNote ?? 'Dự án đã xóa'}</p>
                <p className="text-xs text-[#94A3B8]">Hiệu lực đến {fmtDate(q.validUntil)}{q.discountPct ? `, chiết khấu ${q.discountPct}%` : ''}{q.note ? `. ${q.note}` : ''}</p>
                {q.file && <a href={q.file.url} target="_blank" rel="noreferrer" className="text-xs text-[#6FA8F0] hover:underline">{q.file.name}</a>}
              </div>
              <div className="text-right">
                <p className="tabular-nums">{vnd(q.amount)}</p>
                <Chip tone={QUOTE_STATUS[q.status].tone}>{QUOTE_STATUS[q.status].label}</Chip>
              </div>
              <div className="flex gap-1">
                <button className={cn(btnGhost, 'p-1.5')} onClick={() => openComposer({ leadId: l?.id, quoteId: q.id, mode: 'QUOTE' })} aria-label={`Xem ${q.code}`}><Eye className="h-3.5 w-3.5" /></button>
                <button className={cn(btnGhost, 'p-1.5 hover:text-[#F87171]')} disabled={!canEdit} onClick={() => setConfirm({ title: 'Xóa báo giá', message: <>Xóa báo giá <b>{q.code}</b>?</>, blocked: q.status === 'ACCEPTED' ? 'Báo giá đã được khách chấp nhận và gắn với đơn hàng, không thể xóa.' : undefined, onConfirm: () => { setQuotes((p) => p.filter((x) => x.id !== q.id)); notify(`Đã xóa ${q.code}`, 'orange'); } })} aria-label={`Xóa ${q.code}`}><Trash2 className="h-3.5 w-3.5" /></button>
              </div>
            </li>
          );
        })}
      </ul>
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

// =====================================================================
//  ĐỀ XUẤT CHƯƠNG TRÌNH MDF (Pre-Approval) — kiểm tra 4 lớp hạn mức
// =====================================================================

type ProgramForm = { title: string; type: ProgramType; customerId: string; dept: DeptCode; requested: number; sharePct: number; start: string; end: string; expectedLeads: number };

function ProgramFormModal({ customerId, programId, onClose }: { customerId?: string; programId?: string; onClose: () => void }) {
  const { me, budget, setBudget, programs, setPrograms, claims, customers, departments, tierRules, segRules, users, notify, dispatch } = useApp();
  const existing = programs.find((p) => p.id === programId);
  const preset = customers.find((c) => c.id === (existing?.customerId ?? customerId));
  const [f, setF] = useState<ProgramForm>(existing
    ? { title: existing.title, type: existing.type, customerId: existing.customerId ?? '', dept: existing.dept, requested: existing.requested, sharePct: existing.sharePct, start: existing.start, end: existing.end, expectedLeads: existing.expectedLeads ?? 0 }
    : { title: '', type: PROGRAM_TYPES[0] ?? '', customerId: customerId ?? '', dept: preset?.dept ?? me.dept ?? departments[0]?.code ?? '', requested: 0, sharePct: 100, start: '', end: '', expectedLeads: 0 });
  const ownHeld = existing?.held ?? 0;
  const [touched, setTouched] = useState(false);
  const set = <K extends keyof ProgramForm>(k: K, v: ProgramForm[K]) => setF((p) => ({ ...p, [k]: v }));

  // ---- Tính giữ chỗ & kiểm tra hạn mức ----
  const hold = Math.round((f.requested * f.sharePct) / 100);
  const available = budget.total - budget.spent - budget.committed + ownHeld;
  const typeCap = PROGRAM_BUDGET[f.type] ?? 0;
  const typeUsed = usedByType(f.type, claims, programs, budget.fiscalYear) - (existing && existing.type === f.type ? ownHeld : 0);
  const cust = customers.find((c) => c.id === f.customerId);
  const custCap = cust ? tierRules.find((r) => r.tier === cust.tier)?.mdfCap ?? 0 : 0;
  const custUsed = cust ? mdfOfCustomer(cust.id, claims, programs) - (existing && existing.customerId === cust.id ? ownHeld : 0) : 0;
  const head = users.find((u) => u.role === 'DEPT_HEAD' && u.dept === f.dept && u.active);
  const approver = head && head.approvalLimit >= hold ? `${head.name} (Trưởng phòng, hạn mức ${compact(head.approvalLimit)})` : 'Ban Giám đốc (vượt hạn mức Trưởng phòng)';
  const today = todayISO();

  const e: Partial<Record<keyof ProgramForm, string>> = {};
  if (f.title.trim().length < 5) e.title = 'Tên chương trình tối thiểu 5 ký tự';
  if (!f.type || !(f.type in PROGRAM_LABEL)) e.type = 'Chọn hạng mục';
  if (cust && !segRules[cust.segment]?.mdfEligible) e.customerId = `Nhóm ${segName(cust.segment)} không thuộc diện nhận quỹ (xem Cài đặt > Phân loại khách hàng)`;
  if (f.requested <= 0) e.requested = 'Nhập tổng chi phí dự kiến';
  else if (typeUsed + hold > typeCap) e.requested = `Vượt ngân sách hạng mục ${progName(f.type)} (còn ${compact(Math.max(0, typeCap - typeUsed))})`;
  else if (cust && custUsed + hold > custCap) e.requested = `Vượt hạn mức tài trợ hạng ${tierInfo(cust.tier).label} (còn ${compact(Math.max(0, custCap - custUsed))})`;
  else if (hold > available) e.requested = `Quỹ khả dụng chỉ còn ${compact(available)}`;
  if (f.sharePct < 1 || f.sharePct > 100) e.sharePct = 'Từ 1 đến 100%';
  if (!f.start) e.start = 'Chọn ngày bắt đầu';
  else if (f.start < today && !existing) e.start = 'Đề xuất phải lập trước khi chương trình diễn ra';
  else if (Number(f.start.slice(0, 4)) !== budget.fiscalYear) e.start = `Chương trình thuộc năm ${f.start.slice(0, 4)}: chuyển bộ lọc thời gian trên header sang năm đó để lập đề xuất`;
  if (budget.declared === false) e.title = `Chưa khai báo ngân sách năm ${budget.fiscalYear} (Cài đặt > Quỹ Hãng 3M)`;
  else if (f.start < budget.periodStart) e.start = `Phải nằm trong năm tài chính ${budget.fiscalYear}`;
  if (!f.end) e.end = 'Chọn ngày kết thúc';
  else if (f.start && f.end < f.start) e.end = 'Ngày kết thúc phải sau ngày bắt đầu';
  else if (f.end > budget.periodEnd) e.end = `Phải nằm trong năm tài chính ${budget.fiscalYear}`;
  const err = (k: keyof ProgramForm) => (touched ? e[k] : undefined);

  const save = () => {
    setTouched(true);
    if (Object.keys(e).length) return;
    if (existing) {
      setPrograms((p) => p.map((x) => (x.id === existing.id ? { ...x, title: f.title.trim(), type: f.type, customerId: f.customerId || undefined, dept: f.dept, requested: f.requested, sharePct: f.sharePct, held: hold, start: f.start, end: f.end, expectedLeads: f.expectedLeads || undefined } : x)));
      setBudget((b) => ({ ...b, committed: Math.max(0, b.committed + hold - ownHeld) }));
      notify(`Đã cập nhật ${existing.code}, giữ chỗ ${compact(hold)}`, 'teal');
    } else {
      // Mã đề xuất nội bộ tự sinh; mã Pre-Approval do 3M cấp, nhập khi ghi nhận 3M duyệt
      const code = nextCode(programs.map((p) => p.code), `DX-${budget.fiscalYear}-`, 4);
      const program: Program = {
        id: uid('m'), code, title: f.title.trim(), type: f.type,
        customerId: f.customerId || undefined, dept: f.dept, requested: f.requested, sharePct: f.sharePct, held: hold,
        start: f.start, end: f.end, expectedLeads: f.expectedLeads || undefined, status: 'PENDING_INTERNAL', requestedBy: me.id, requestedAt: Date.now(),
      };
      setPrograms((p) => [program, ...p]);
      setBudget((b) => ({ ...b, committed: b.committed + hold }));
      dispatch('PROGRAM_APPROVAL', { toAll: users.filter((u) => u.active && (u.role === 'BOD' || (u.role === 'DEPT_HEAD' && u.dept === f.dept))), title: `Đề xuất chi quỹ chờ duyệt: ${program.title}`, body: `${code}, giữ chỗ ${compact(hold)}` });
      notify(`Đã tạo đề xuất ${code}, giữ chỗ ${compact(hold)}. Chờ duyệt nội bộ rồi gửi 3M cấp mã Pre-Approval.`, 'teal');
    }
    onClose();
  };

  const rows: [string, string, string][] = [
    ['Phần Hãng tài trợ (giữ chỗ)', vnd(hold), hold > 0 ? C.orange : C.muted],
    [`${FUND_LABEL[PROGRAM_FUND[f.type] ?? 'MDF']}: ${progName(f.type)}`, `${compact(typeUsed + hold)} / ${compact(typeCap)}`, typeUsed + hold > typeCap ? C.red : C.text],
    ...(cust ? [[`Hạn mức hạng ${tierInfo(cust.tier).label}`, `${compact(custUsed + hold)} / ${compact(custCap)}`, custUsed + hold > custCap ? C.red : C.text] as [string, string, string]] : []),
    ['Quỹ khả dụng sau giữ chỗ', vnd(available - hold), available - hold < 0 ? C.red : C.teal],
  ];

  return (
    <Modal
      title={existing ? `Sửa đề xuất ${existing.code}` : 'Đề xuất chương trình quỹ 3M'}
      onClose={onClose}
      wide
      footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}><Lock className="h-4 w-4" aria-hidden />{existing ? 'Lưu thay đổi' : 'Gửi đề xuất và giữ chỗ'}</button></>}
    >
      <div className="grid grid-cols-1 gap-5 md:grid-cols-5">
        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 md:col-span-3">
          <Field label="Tên chương trình *" error={err('title')} className="sm:col-span-2"><input className={inputCls} value={f.title} onChange={(ev) => set('title', ev.target.value)} placeholder="VD: Hội thảo giải pháp đầu cáp co nguội Hải Phòng" /></Field>
          <Field label="Hạng mục ngân sách" error={err('type')}>
            <select className={inputCls} value={f.type} onChange={(ev) => set('type', ev.target.value)}>
              {(['MDF', 'CS'] as FundCode[]).map((fund) => (
                <optgroup key={fund} label={FUND_LABEL[fund]}>
                  {PROGRAM_TYPES.filter((t) => PROGRAM_FUND[t] === fund).map((t) => <option key={t} value={t}>{progName(t)}</option>)}
                </optgroup>
              ))}
            </select>
          </Field>
          <Field label="Phòng ban">
            <select className={inputCls} value={f.dept} onChange={(ev) => set('dept', ev.target.value)}>
              {departments.filter((d) => d.active).map((d) => <option key={d.code} value={d.code}>{d.short}</option>)}
            </select>
          </Field>
          <Field label="Khách hàng hưởng lợi" error={err('customerId')} className="sm:col-span-2">
            <select className={inputCls} value={f.customerId} onChange={(ev) => { const c = customers.find((x) => x.id === ev.target.value); setF((p) => ({ ...p, customerId: ev.target.value, dept: c?.dept ?? p.dept })); }}>
              <option value="">Hoạt động chung, không gắn khách hàng</option>
              {customers.map((c) => <option key={c.id} value={c.id}>{c.name} ({tierInfo(c.tier).label})</option>)}
            </select>
          </Field>
          <Field label="Tổng chi phí dự kiến *" error={err('requested')}><MoneyInput value={f.requested} onChange={(n) => set('requested', n)} /></Field>
          <Field label="Hãng tài trợ (%)" error={err('sharePct')}><input className={inputCls} type="number" min={1} max={100} value={f.sharePct} onChange={(ev) => set('sharePct', Number(ev.target.value))} /></Field>
          <Field label="Ngày bắt đầu *" error={err('start')}><input className={inputCls} type="date" value={f.start} min={today} onChange={(ev) => set('start', ev.target.value)} /></Field>
          <Field label="Ngày kết thúc *" error={err('end')}><input className={inputCls} type="date" value={f.end} min={f.start || today} onChange={(ev) => set('end', ev.target.value)} /></Field>
          {(PROGRAM_REQUIRED[f.type] ?? []).includes('ATTENDEE_SIGN_SHEET') && <Field label="Số người tham dự dự kiến"><input className={inputCls} type="number" min={0} value={f.expectedLeads || ''} onChange={(ev) => set('expectedLeads', Number(ev.target.value))} /></Field>}
        </div>

        <div className="space-y-3 rounded-md bg-[#1C2534] p-4 text-sm md:col-span-2">
          <p className="font-medium text-[#F1F5F9]">Kiểm tra hạn mức</p>
          {rows.map(([k, v, col]) => (
            <div key={k}><p className="text-xs text-[#94A3B8]">{k}</p><p className="font-medium tabular-nums" style={{ color: col }}>{v}</p></div>
          ))}
          <div className="border-t border-[#263044] pt-3 text-xs text-[#94A3B8]">
            <p className="mb-1 text-[#F1F5F9]">Người duyệt nội bộ</p>
            {hold > 0 ? approver : 'Nhập chi phí để xác định người duyệt.'}
          </div>
        </div>
      </div>
    </Modal>
  );
}

// =====================================================================
//  LUỒNG BÁN HÀNG MỘT NGUỒN DỮ LIỆU
//  BOQ (khối lượng kỹ thuật) -> Báo giá (dòng sản phẩm + giá + CK, có phiên bản)
//  -> Chốt đơn (chọn đúng 1 phiên bản báo giá) -> Đơn Getfly (lấy nguyên các dòng của phiên bản đó)
// =====================================================================

/** Chốt đơn: chọn phiên bản báo giá khách chấp nhận, xác nhận doanh số ghi nhận; sau đó tự soạn hợp đồng */
function WinModal({ leadId, onClose }: { leadId: string; onClose: () => void }) {
  const { leads, quotes, winLead, openComposer } = useApp();
  const lead = leads.find((l) => l.id === leadId);
  const list = quotes.filter((q) => q.leadId === leadId).sort((a, b) => b.version - a.version);
  /** Chỉ chốt theo báo giá có dòng hàng và đã qua duyệt giá (nếu cần duyệt) */
  const usable = (q: Quote) => q.lines.length > 0 && (!q.approval || q.approval.status === 'APPROVED');
  const [sel, setSel] = useState(() => (list.find((q) => q.status === 'SENT' && usable(q)) ?? list.find(usable))?.id ?? '');
  if (!lead) return null;
  const q = list.find((x) => x.id === sel);
  const t = q ? quoteTotals(q.lines, q.vatPct) : null;
  return (
    <Modal
      title={`Chốt đơn: ${lead.company}`}
      onClose={onClose}
      footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={cn(btnBase, 'bg-[#00B894] px-3.5 py-2 font-semibold text-[#0F141E] hover:bg-[#1FC7A2]')} disabled={!q} onClick={() => { winLead(lead.id, sel); onClose(); }}><CheckCircle2 className="h-4 w-4" aria-hidden />Xác nhận chốt đơn</button></>}
    >
      {!list.some((x) => x.lines.length) ? (
        <div className="space-y-3 text-sm">
          <p className="rounded bg-[#F28C33]/10 p-3 text-[#F7B23B]">Dự án chưa có báo giá có dòng sản phẩm. Cần tạo báo giá trước khi chốt đơn.</p>
          <button className={btnPrimary} onClick={() => { onClose(); openComposer({ leadId, mode: 'QUOTE' }); }}><FileText className="h-4 w-4" aria-hidden />Tạo báo giá ngay</button>
        </div>
      ) : (
        <div className="space-y-4">
          <fieldset className="space-y-2">
            <legend className="mb-2 text-xs font-medium text-[#94A3B8]">Phiên bản báo giá khách chốt</legend>
            {list.map((x) => (
              <label key={x.id} className={cn('flex cursor-pointer items-center gap-3 rounded border px-3 py-2.5 text-sm', !usable(x) && 'cursor-not-allowed opacity-50', sel === x.id ? 'border-[#00B894] bg-[#00B894]/10' : 'border-[#263044] hover:bg-[#1C2534]')}>
                <input type="radio" name="won-quote" className="accent-[#00B894]" disabled={!usable(x)} checked={sel === x.id} onChange={() => setSel(x.id)} />
                <span className="min-w-0 flex-1"><b>{x.code}</b> <span className="text-[#94A3B8]">v{x.version}, {fmtDate(x.date)}, {x.lines.length} dòng{x.approval && x.approval.status !== 'APPROVED' ? (x.approval.status === 'PENDING' ? ', chờ duyệt giá' : ', bị từ chối giá') : ''}</span></span>
                <span className="tabular-nums">{compact(x.amount)}</span>
              </label>
            ))}
          </fieldset>
          {t && (
            <div className="grid grid-cols-3 gap-2 text-sm">
              <div className="rounded bg-[#1C2534] p-3"><p className="text-xs text-[#94A3B8]">Doanh số trước VAT</p><p className="mt-1 font-semibold tabular-nums text-[#3DDBB6]">{vnd(t.sub)}</p></div>
              <div className="rounded bg-[#1C2534] p-3"><p className="text-xs text-[#94A3B8]">VAT {q?.vatPct}%</p><p className="mt-1 font-semibold tabular-nums">{vnd(t.vat)}</p></div>
              <div className="rounded bg-[#1C2534] p-3"><p className="text-xs text-[#94A3B8]">Sau VAT</p><p className="mt-1 font-semibold tabular-nums">{vnd(t.gross)}</p></div>
            </div>
          )}
        </div>
      )}
    </Modal>
  );
}

/** Sơ đồ dữ liệu của một dự án: BOQ -> Báo giá -> Chốt đơn -> Getfly */
function ProjectFlow({ lead }: { lead: Lead }) {
  const { quotes, genDocs } = useApp();
  const lq = latestQuote(lead.id, quotes);
  const won = quotes.find((q) => q.id === lead.wonQuoteId);
  const contract = latestContracts(genDocs.filter((d) => d.leadId === lead.id))[0];
  const contractDone = !!contract && (contract.status === 'ISSUED' || contract.status === 'APPROVED');
  const steps: { title: string; value: string; done: boolean }[] = [
    { title: 'BOQ', value: lead.boqItems?.length ? `${lead.boqItems.length} dòng, ${compact(boqTotal(lead))}` : `Ước tính ${compact(lead.boqValue)}`, done: !!lead.boqItems?.length },
    { title: 'Báo giá', value: lq ? `${lq.code} v${lq.version}` : 'Chưa tạo', done: !!lq },
    { title: 'Chốt đơn', value: won ? compact(won.amount) : lead.status === 'LOST' ? 'Trượt' : 'Chưa chốt', done: !!won },
    { title: 'Hợp đồng', value: contract ? (contractDone ? contract.contractCode : `${GENDOC_STATUS[contract.status].label} ${contract.contractCode}`) : 'Chưa tạo', done: contractDone },
  ];
  return (
    <ol className="flex items-start" aria-label="Tiến độ dự án">
      {steps.map((s, i) => (
        <li key={s.title} className="flex min-w-0 flex-1 flex-col items-center text-center">
          <div className="flex w-full items-center">
            <span className={cn('h-0.5 flex-1', i === 0 ? 'opacity-0' : steps[i - 1].done ? 'bg-[#00B894]' : 'bg-[#263044]')} />
            <span className={cn('flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold', s.done ? 'bg-[#00B894] text-[#0F141E]' : 'border border-[#263044] bg-[#1C2534] text-[#94A3B8]')}>{s.done ? <CheckCircle2 className="h-4 w-4" aria-hidden /> : i + 1}</span>
            <span className={cn('h-0.5 flex-1', i === steps.length - 1 ? 'opacity-0' : s.done ? 'bg-[#00B894]' : 'bg-[#263044]')} />
          </div>
          <p className={cn('mt-1 text-xs font-medium', s.done ? 'text-[#3DDBB6]' : 'text-[#F1F5F9]')}>{s.title}</p>
          <p className="w-full truncate px-1 text-[10px] text-[#94A3B8]">{s.value}</p>
        </li>
      ))}
    </ol>
  );
}

/** Tạo bộ dữ liệu ví dụ để thử trọn luồng: SKU có giá, khách hàng, dự án có BOQ, Getfly mô phỏng */
function useSeedSalesDemo() {
  const { skus, setSkus, customers, setCustomers, leads, setLeads, getfly, setGetfly, routableDepts, me, sources, notify } = useApp();
  return (): string => {
    const demoSkus: SkuItem[] = [
      { sku: '3M-QT3-24KV', name: 'Đầu cáp co nguội trong nhà 24kV QT-III', brand: '3M', category: 'Phụ kiện cáp trung thế', unit: 'Bộ', minStock: 10, maxStock: 100, leadTimeDays: 90, stock: 30, costPrice: 4_100_000, basePrice: 5_200_000, dealerPrice: 4_600_000, projectPrice: 4_800_000 },
      { sku: '3M-CSJ-24KV', name: 'Hộp nối cáp co nguội 24kV', brand: '3M', category: 'Phụ kiện cáp trung thế', unit: 'Bộ', minStock: 10, maxStock: 80, leadTimeDays: 90, stock: 12, costPrice: 5_300_000, basePrice: 6_900_000, dealerPrice: 6_000_000, projectPrice: 6_200_000 },
      { sku: '3M-SCOTCH-23', name: 'Băng keo cách điện cao áp Scotch 23, 19mm x 9,1m', brand: '3M', category: 'Băng keo điện', unit: 'Cuộn', minStock: 100, maxStock: 1500, leadTimeDays: 60, stock: 400, costPrice: 230_000, basePrice: 320_000, dealerPrice: 270_000, projectPrice: 285_000 },
    ];
    const missing = demoSkus.filter((d) => !skus.some((s) => s.sku === d.sku));
    if (missing.length) setSkus((p) => [...missing, ...p]);
    const dept = routableDepts.find((d) => d.code === 'EMD_SOUTH') ?? routableDepts[0];
    const taxCode = '0399999901';
    let cust = customers.find((c) => c.taxCode === taxCode);
    if (!cust) {
      cust = {
        id: uid('k'), code: nextCode(customers.map((c) => c.code), 'KH-', 6), name: 'Công ty CP Cơ điện Ví Dụ Sài Gòn (DEMO)', taxCode, segment: 'EPC_CONTRACTOR', tier: TIERS[TIERS.length - 1] ?? '',
        region: 'SOUTH', dept: dept?.code ?? '', amId: me.id, sourceId: sources.find((s) => s.isMarketing)?.id ?? sources[0]?.id ?? '', status: 'ACTIVE', createdAt: todayISO(),
        contactName: 'Nguyễn Văn Ví Dụ', contactTitle: 'Giám đốc', contactPhone: '0900 123 456', contactEmail: 'demo@vidu.vn', address: '1 Đường Ví Dụ, Quận 7, TP.HCM',
        creditLimit: 2_000_000_000, debt: 0, ytdRevenue: 0, lastYearRevenue: 0,
      };
      const c = cust;
      setCustomers((p) => [...p, c]);
    }
    const now = Date.now();
    const lead: Lead = {
      id: uid('l'), code: nextCode(leads.map((l) => l.code), 'LD-2026-', 4), company: cust.name, contact: cust.contactName, phone: cust.contactPhone, taxCode, email: cust.contactEmail,
      segment: 'EPC_CONTRACTOR', source: 'TECH_SEMINAR', region: 'SOUTH', province: 'TP.HCM', boqValue: 200_000_000, boqNote: 'Phụ kiện cáp trung thế cho trạm biến áp 2 x 1.000 kVA (DEMO)',
      hasBoqFile: false, receivedDaysAgo: 2, status: 'ACCEPTED', dept: dept?.code, assignee: me.id, routedAt: now - 3600_000, slaMet: true, quoteDeadline: now + 20 * 3600_000,
      routingReason: 'Dữ liệu ví dụ', customerId: cust.id, boqStatus: 'DONE', score: 80,
      boqItems: [
        { code: '3M-QT3-24KV', name: 'Đầu cáp co nguội trong nhà 24kV QT-III', unit: 'Bộ', qty: 20, price: 4_800_000, discountPct: 0 },
        { code: '3M-CSJ-24KV', name: 'Hộp nối cáp co nguội 24kV', unit: 'Bộ', qty: 10, price: 6_200_000, discountPct: 0 },
        { code: '3M-SCOTCH-23', name: 'Băng keo cách điện cao áp Scotch 23, 19mm x 9,1m', unit: 'Cuộn', qty: 200, price: 285_000, discountPct: 0 },
      ],
    };
    setLeads((p) => [lead, ...p]);
    if (!getfly.apiKey) setGetfly((g) => ({ ...g, isActive: true, demoMode: true }));
    notify('Đã tạo ví dụ: 3 SKU, 1 khách hàng, 1 dự án có BOQ. Getfly chuyển chế độ mô phỏng. Làm tiếp: Tạo báo giá → Chốt đơn → xem đơn Getfly.', 'teal');
    return lead.id;
  };
}

// =====================================================================
//  PHÂN HỆ: ĐẶT HÀNG HÃNG & LỊCH HÀNG VỀ (Vendor PO & Inbound Shipments)
//  - PO đặt trước 3–4 tháng, chia nhiều đợt hàng về (ETA, phương thức, BL/AWB)
//  - Phân bổ giữ chỗ cho dự án / khách hàng, phần còn lại nhập tồn kho tự do
//  - Danh mục SKU (Master SKU Catalog) dùng chung cho PO và bóc tách BOQ
// =====================================================================

function SupplyModule() {
  const { reservations } = useApp();
  const [tab, setTab] = useState<'po' | 'stock'>('po');
  const pending = reservations.filter((r) => r.status === 'PENDING_RELEASE').length;
  return (
    <div className="space-y-4">
      <Tabs tabs={[{ id: 'po', label: 'PO & hàng về' }, { id: 'stock', label: pending ? `Kho (${pending} chờ duyệt)` : 'Kho & giữ chỗ' }]} value={tab} onChange={setTab} aside={<DateRangePicker />} />
      {tab === 'po' ? <POPage /> : <InventoryPage />}
    </div>
  );
}

const daysBetween = (a: string, b: string) => Math.round((new Date(`${b}T12:00:00`).getTime() - new Date(`${a}T12:00:00`).getTime()) / 864e5);

/** Tên đích giữ chỗ (dự án hoặc khách hàng) */
function useAllocName() {
  const { leads, customers } = useApp();
  return (a: PoAllocation) => (a.kind === 'LEAD' ? leads.find((l) => l.id === a.refId)?.company ?? 'Dự án đã xóa' : customers.find((c) => c.id === a.refId)?.name ?? 'Khách đã xóa');
}

function BackorderBadge({ ordered, received }: { ordered: number; received: number }) {
  const owe = Math.max(0, ordered - received);
  if (!owe) return <Chip tone="teal">Đủ</Chip>;
  return <Chip tone={owe === ordered ? 'red' : 'orange'}>Nợ {owe.toLocaleString('vi-VN')}{owe === ordered ? ' (100%)' : ''}</Chip>;
}

function POPage() {
  const { pos, setPos, skus, canDo, notify, userName, openCustomer, go, range, receiveShipment } = useApp();
  const allocName = useAllocName();
  const canEdit = canDo('po.manage');
  const today = todayISO();
  const in15 = iso(new Date(Date.now() + 15 * 864e5));
  const [q, setQ] = useState('');
  const [st, setSt] = useState('ALL');
  const [purpose, setPurpose] = useState('ALL');
  const [open, setOpen] = useState<string[]>([]);
  const [poForm, setPoForm] = useState<{ id?: string } | null>(null);
  useIntent('po.create', () => setPoForm({}));
  const [shipForm, setShipForm] = useState<{ poId: string; shipmentId?: string } | null>(null);
  const [allocFor, setAllocFor] = useState<{ poId: string; sku: string } | null>(null);
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const skuOf = (code: string) => skus.find((s) => s.sku === code);
  const inR = inRangeOf(range);

  const active = pos.filter((p) => !p.cancelled);
  const allShip = active.flatMap((p) => p.shipments.map((s) => ({ po: p, s })));
  const shipValue = (po: VendorPO, s: Shipment) => s.lines.reduce((a, l) => a + l.qty * (po.lines.find((x) => x.sku === l.sku)?.unitPrice ?? 0), 0);
  const transit = allShip.filter(({ s }) => s.status === 'IN_TRANSIT' || s.status === 'ARRIVED');
  const soon = allShip.filter(({ s }) => s.status !== 'RECEIVED' && s.eta >= today && s.eta <= in15);
  const late = allShip.filter(({ s }) => s.status !== 'RECEIVED' && s.eta < today);
  const oweValue = active.reduce((a, p) => a + p.lines.reduce((b, l) => b + poLineStats(p, l).backorder * l.unitPrice, 0), 0);

  const list = pos.filter((p) => {
    const t = q.trim().toLowerCase();
    const state = poState(p, today).label;
    return (!t || [p.code, p.vendor, p.note, ...p.lines.map((l) => l.sku), ...p.shipments.map((s) => s.docNo)].some((v) => v.toLowerCase().includes(t)))
      && (st === 'ALL' || state === st) && (purpose === 'ALL' || p.purpose === purpose) && inR(p.orderDate);
  }).sort((a, b) => b.orderDate.localeCompare(a.orderDate));
  const paged = usePaged(list, 8);

  const patchPo = (id: string, fn: (p: VendorPO) => VendorPO) => setPos((all) => all.map((p) => (p.id === id ? fn(p) : p)));
  const setShipStatus = (po: VendorPO, s: Shipment, status: ShipmentStatus) => {
    // Nhập kho: chốt phân bổ đợt, phần giữ chỗ vào kho giữ chỗ, phần tự do cộng tồn
    if (status === 'RECEIVED') return receiveShipment(po.id, s.id);
    patchPo(po.id, (p) => ({ ...p, shipments: p.shipments.map((x) => (x.id === s.id ? { ...x, status } : x)) }));
    notify(`${po.code} ${s.code}: ${SHIPMENT_STATUS[status].label}`, 'teal');
  };
  const poMenu = (p: VendorPO): MenuItem[] => [
    { label: 'Thêm đợt hàng về', icon: Ship, onClick: () => setShipForm({ poId: p.id }), disabled: !canEdit || !!p.cancelled },
    { label: 'Sửa PO', icon: Pencil, onClick: () => setPoForm({ id: p.id }), disabled: !canEdit },
    { label: p.cancelled ? 'Mở lại PO' : 'Hủy PO', icon: XCircle, onClick: () => { patchPo(p.id, (x) => ({ ...x, cancelled: !x.cancelled })); notify(`${p.cancelled ? 'Đã mở lại' : 'Đã hủy'} ${p.code}`, 'orange'); }, disabled: !canEdit },
    {
      label: 'Xóa PO', icon: Trash2, danger: true, disabled: !canEdit,
      onClick: () => setConfirm({ title: 'Xóa PO', message: <>Xóa <b>{p.code}</b>?</>, blocked: p.shipments.some((s) => s.status === 'RECEIVED') ? 'PO đã có đợt hàng nhập kho, không thể xóa. Dùng Hủy PO để dừng các đợt còn lại.' : undefined, onConfirm: () => { setPos((all) => all.filter((x) => x.id !== p.id)); notify(`Đã xóa ${p.code}`, 'orange'); } }),
    },
  ];
  const toggle = (id: string) => setOpen((o) => (o.includes(id) ? o.filter((x) => x !== id) : [...o, id]));

  const progressCell = (p: VendorPO) => {
    const g = poProgress(p);
    return (
      <div className="w-44">
        <div className="flex h-2 overflow-hidden rounded-full bg-[#263044]">
          <div style={{ width: `${g.pct}%`, background: C.teal }} />
          <div style={{ width: `${g.transitPct}%`, background: C.blue }} />
        </div>
        <p className="mt-1 text-xs tabular-nums text-[#94A3B8]">{g.pct.toFixed(0)}% đã về{g.transit ? `, ${g.transitPct.toFixed(0)}% đang về` : ''}</p>
      </div>
    );
  };

  const detail = (p: VendorPO) => (
    <div className="space-y-4 bg-[#0B1019] px-4 py-4 sm:px-5">
      <div>
        <div className="mb-2 flex flex-wrap items-center justify-between gap-2">
          <h4 className="flex items-center gap-2 text-sm font-semibold"><Package className="h-4 w-4 text-[#F28C33]" aria-hidden />Sản phẩm trong PO ({p.lines.length})</h4>
          <span className="text-xs text-[#94A3B8]">Đặt {fmtDate(p.orderDate)}, dự kiến về đủ {fmtDate(p.expectedDate)}{p.createdBy ? `, người lập ${userName(p.createdBy)}` : ''}</span>
        </div>
        <div className="-mx-4 overflow-x-auto sm:-mx-5">
          <table className="w-full min-w-[920px] text-sm">
            <thead className="text-xs text-[#94A3B8]">
              <tr className="border-b border-[#263044] text-left">
                <th className="py-2 pl-4 pr-2 font-medium sm:pl-5">Mã SKU</th>
                <th className="px-2 py-2 font-medium">Tên sản phẩm</th>
                <th className="px-2 py-2 text-right font-medium">Đặt</th>
                <th className="px-2 py-2 text-right font-medium">Đã về</th>
                <th className="px-2 py-2 text-right font-medium">Đang về</th>
                <th className="px-2 py-2 font-medium">Hãng còn nợ</th>
                <th className="px-2 py-2 font-medium">Phân bổ giữ chỗ</th>
                <th className="py-2 pl-2 pr-4 sm:pr-5" />
              </tr>
            </thead>
            <tbody>
              {p.lines.map((l) => {
                const s = poLineStats(p, l);
                const k = skuOf(l.sku);
                return (
                  <tr key={l.sku} className="border-b border-[#263044]/60 align-top">
                    <td className="py-2.5 pl-4 pr-2 font-mono text-xs sm:pl-5">{l.sku}</td>
                    <td className="px-2 py-2.5"><p className="max-w-[240px]">{k?.name ?? 'SKU đã xóa khỏi danh mục'}</p><p className="text-xs text-[#94A3B8]">{k?.unit ?? ''}{k ? `, ${k.brand}` : ''}, {vnd(l.unitPrice)}</p></td>
                    <td className="px-2 py-2.5 text-right tabular-nums">{s.ordered.toLocaleString('vi-VN')}</td>
                    <td className="px-2 py-2.5 text-right tabular-nums text-[#3DDBB6]">{s.received.toLocaleString('vi-VN')}</td>
                    <td className="px-2 py-2.5 text-right tabular-nums text-[#6FA8F0]">{s.transit ? s.transit.toLocaleString('vi-VN') : '—'}</td>
                    <td className="px-2 py-2.5"><BackorderBadge ordered={s.ordered} received={s.received} />{s.unscheduled > 0 && <p className="mt-1 text-[11px] text-[#94A3B8]">{s.unscheduled.toLocaleString('vi-VN')} chưa có lịch giao</p>}</td>
                    <td className="px-2 py-2.5">
                      <div className="flex max-w-[280px] flex-wrap gap-1">
                        {l.allocations.map((a) => (
                          <button key={a.kind + a.refId} className="rounded-md bg-[#F28C33]/10 px-1.5 py-0.5 text-left text-[11px] text-[#F7B23B] hover:underline" onClick={() => (a.kind === 'CUSTOMER' ? openCustomer(a.refId) : go('projects'))}>
                            {a.kind === 'LEAD' ? 'Dự án' : 'KH'} {allocName(a)}: {a.qty.toLocaleString('vi-VN')}
                          </button>
                        ))}
                        <span className="rounded-md bg-[#1C2534] px-1.5 py-0.5 text-[11px] text-[#94A3B8]">Tồn tự do: {s.free.toLocaleString('vi-VN')}</span>
                      </div>
                    </td>
                    <td className="py-2.5 pl-2 pr-4 sm:pr-5"><button className={cn(btnGhost, btnSm)} disabled={!canEdit} onClick={() => setAllocFor({ poId: p.id, sku: l.sku })}>Phân bổ</button></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <div className="mb-2 flex items-center justify-between gap-2">
          <h4 className="flex items-center gap-2 text-sm font-semibold"><Ship className="h-4 w-4 text-[#F28C33]" aria-hidden />Đợt hàng về ({p.shipments.length})</h4>
          <button className={cn(btnGhost, btnSm)} disabled={!canEdit || !!p.cancelled} onClick={() => setShipForm({ poId: p.id })}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm đợt</button>
        </div>
        <div className="space-y-2">
          {[...p.shipments].sort((a, b) => a.eta.localeCompare(b.eta)).map((s) => {
            const M = SHIP_MODE[s.mode];
            const isLate = s.status !== 'RECEIVED' && s.eta < today;
            const left = daysBetween(today, s.eta);
            const next: ShipmentStatus | null = s.status === 'PLANNED' ? 'IN_TRANSIT' : s.status === 'IN_TRANSIT' ? 'ARRIVED' : s.status === 'ARRIVED' ? 'RECEIVED' : null;
            return (
              <div key={s.id} className={cn('rounded-md border p-3', isLate ? 'border-[#EF4444]/50 bg-[#EF4444]/5' : 'border-[#263044] bg-[#151C29]')}>
                <div className="flex flex-wrap items-center gap-x-4 gap-y-1.5">
                  <span className="font-medium">{s.code}</span>
                  <span className="flex items-center gap-1.5 text-xs text-[#94A3B8]"><M.icon className="h-3.5 w-3.5" aria-hidden />{M.label}</span>
                  <span className="font-mono text-xs text-[#94A3B8]">{s.mode === 'AIR' ? 'AWB' : 'BL'} {s.docNo || 'chưa có'}</span>
                  <span className="text-xs text-[#94A3B8]">{s.etd ? `ETD ${fmtDate(s.etd)}, ` : ''}ETA <b className={cn('tabular-nums', isLate ? 'text-[#F87171]' : 'text-[#F1F5F9]')}>{fmtDate(s.eta)}</b>{s.status !== 'RECEIVED' && <span className={isLate ? 'text-[#F87171]' : ''}> ({isLate ? `trễ ${-left} ngày` : left === 0 ? 'hôm nay' : `còn ${left} ngày`})</span>}{s.receivedAt && `, nhập kho ${fmtDate(s.receivedAt)}`}</span>
                  <Chip tone={isLate ? 'red' : SHIPMENT_STATUS[s.status].tone}>{isLate ? 'Trễ ETA' : SHIPMENT_STATUS[s.status].label}</Chip>
                  <div className="ml-auto flex gap-1.5">
                    {next && <button className={cn(next === 'RECEIVED' ? btnPrimary : btnGhost, btnSm)} disabled={!canEdit} onClick={() => setShipStatus(p, s, next)}>{next === 'IN_TRANSIT' ? 'Đã xuất hàng' : next === 'ARRIVED' ? 'Đã cập cảng' : 'Nhập kho'}</button>}
                    <button className={cn(btnGhost, 'p-1.5')} disabled={!canEdit} onClick={() => setShipForm({ poId: p.id, shipmentId: s.id })} aria-label={`Sửa ${s.code}`}><Pencil className="h-3.5 w-3.5" /></button>
                    <button className={cn(btnGhost, 'p-1.5 hover:text-[#F87171]')} disabled={!canEdit || s.status === 'RECEIVED'} onClick={() => setConfirm({ title: 'Xóa đợt hàng', message: <>Xóa {s.code} của {p.code}?</>, onConfirm: () => patchPo(p.id, (x) => ({ ...x, shipments: x.shipments.filter((y) => y.id !== s.id) })) })} aria-label={`Xóa ${s.code}`}><Trash2 className="h-3.5 w-3.5" /></button>
                  </div>
                </div>
                <ul className="mt-2 grid grid-cols-1 gap-1.5 md:grid-cols-2">
                  {s.lines.map((l) => {
                    const al = shipmentAllocation(p, s.id, l.sku);
                    return (
                      <li key={l.sku} className="rounded bg-[#1C2534] px-3 py-2 text-xs">
                        <p><span className="font-mono">{l.sku}</span> <b className="tabular-nums">{l.qty.toLocaleString('vi-VN')}</b> {skuOf(l.sku)?.unit ?? ''}</p>
                        <p className="mt-0.5 text-[#94A3B8]">
                          {al.reserved.map((r) => `Giữ cho ${allocName(r.a)}: ${r.qty.toLocaleString('vi-VN')}`).join('; ')}
                          {al.reserved.length > 0 && '; '}<span className="text-[#F1F5F9]">Tồn tự do: {al.free.toLocaleString('vi-VN')}</span>
                        </p>
                      </li>
                    );
                  })}
                </ul>
              </div>
            );
          })}
          {!p.shipments.length && <p className="text-sm text-[#94A3B8]">Chưa có lịch hàng về. Hãng còn nợ toàn bộ PO.</p>}
        </div>
      </div>
    </div>
  );

  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Đang vận chuyển" value={compact(transit.reduce((a, x) => a + shipValue(x.po, x.s), 0))} icon={Ship} color={C.blue} sub={`${transit.length} lô: ${transit.filter((x) => x.s.mode === 'SEA').length} đường biển, ${transit.filter((x) => x.s.mode === 'AIR').length} đường bay`} />
        <StatCard label="Sắp về 15 ngày" value={String(soon.length)} icon={CalendarDays} color={C.orange} sub={soon.length ? `${compact(soon.reduce((a, x) => a + shipValue(x.po, x.s), 0))}, sớm nhất ${fmtDate([...soon].sort((a, b) => a.s.eta.localeCompare(b.s.eta))[0].s.eta)}` : 'Không có lô sắp về'} />
        <StatCard label="Trễ ETA" value={String(late.length)} icon={AlertTriangle} color={C.red} sub={late.length ? late.map((x) => `${x.po.code} ${x.s.code}`).join(', ') : 'Không có lô trễ'} />
        <StatCard label="Hãng còn nợ" value={compact(oweValue)} icon={Warehouse} color="#8B5CF6" sub="Giá trị chưa về kho của các PO" />
      </div>

      <FilterBar q={q} onQ={setQ} placeholder="Tìm mã PO, SKU, số BL / AWB..." status={st} onStatus={setSt} statusOptions={['Chờ hàng', 'Về một phần', 'Trễ ETA', 'Đã về đủ', 'Đã hủy'].map((x) => ({ value: x, label: x }))} extraActive={purpose !== 'ALL' ? 1 : 0}>
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={purpose} onChange={(e) => setPurpose(e.target.value)} aria-label="Mục đích">
          <option value="ALL">Mọi mục đích</option>
          {(Object.keys(PO_PURPOSE) as PoPurpose[]).map((x) => <option key={x} value={x}>{PO_PURPOSE[x]}</option>)}
        </select>
      </FilterBar>

      <Panel
        title={`PO đặt Hãng (${list.length})`}
        action={<button className={cn(btnPrimary, btnSm, 'max-lg:hidden')} disabled={!canEdit} onClick={() => setPoForm({})}><Plus className="h-3.5 w-3.5" aria-hidden />Tạo PO mới</button>}
      >
        {/* Mobile */}
        <div className="space-y-2 md:hidden">
          {paged.slice.map((p) => {
            const stt = poState(p, today);
            return (
              <div key={p.id} className="overflow-hidden rounded-md border border-[#263044] bg-[#151C29]">
                <button className="w-full p-3 text-left" onClick={() => toggle(p.id)} aria-expanded={open.includes(p.id)}>
                  <div className="flex items-start justify-between gap-2">
                    <div className="min-w-0"><p className="font-medium">{p.code}</p><p className="truncate text-xs text-[#94A3B8]">{p.vendor}, đặt {fmtDate(p.orderDate)}</p></div>
                    <Chip tone={stt.tone}>{stt.label}</Chip>
                  </div>
                  <div className="mt-2 flex items-center justify-between gap-2">{progressCell(p)}<span className="font-semibold tabular-nums">{compact(poProgress(p).value)}</span></div>
                </button>
                {open.includes(p.id) && detail(p)}
              </div>
            );
          })}
        </div>
        {/* Desktop */}
        <div className="hidden md:block">
          <Table head={['', 'Mã PO', 'Ngày đặt', 'Mục đích', 'Giá trị', 'Tiến độ hàng về', 'Đợt hàng', 'Trạng thái', 'Thao tác']} minW={1080}>
            {paged.slice.map((p) => {
              const stt = poState(p, today);
              const nextShip = [...p.shipments].filter((s) => s.status !== 'RECEIVED').sort((a, b) => a.eta.localeCompare(b.eta))[0];
              const isOpen = open.includes(p.id);
              return [
                <tr key={p.id} className={cn(rowCls, 'cursor-pointer', p.cancelled && 'opacity-50')} onClick={() => toggle(p.id)}>
                  <td className={cn(tdFirst, 'w-10')}><ChevronRight className={cn('h-4 w-4 text-[#94A3B8] transition-transform', isOpen && 'rotate-90 text-[#F28C33]')} aria-hidden /></td>
                  <td className={tdCls}><p className="font-medium text-[#F1F5F9]">{p.code}</p><p className="text-xs text-[#94A3B8]">{p.vendor}</p></td>
                  <td className={cn(tdCls, 'tabular-nums')}>{fmtDate(p.orderDate)}<p className="text-xs text-[#94A3B8]">{daysBetween(p.orderDate, today)} ngày trước</p></td>
                  <td className={tdCls}><span className="text-xs">{PO_PURPOSE[p.purpose]}</span></td>
                  <td className={cn(tdCls, 'tabular-nums')}>{compact(poProgress(p).value)}<p className="text-xs text-[#94A3B8]">{p.lines.length} SKU</p></td>
                  <td className={tdCls}>{progressCell(p)}</td>
                  <td className={cn(tdCls, 'text-xs')}><p>{p.shipments.length} đợt</p>{nextShip && <p className={cn(nextShip.eta < today ? 'text-[#F87171]' : 'text-[#94A3B8]')}>Tiếp theo {fmtDate(nextShip.eta)}</p>}</td>
                  <td className={tdCls}><Chip tone={stt.tone}>{stt.label}</Chip></td>
                  <td className={tdLast} onClick={(e) => e.stopPropagation()}><div className="flex items-center justify-end gap-1.5"><CommentButton entity="po" entityId={p.id} title={`${p.code} · ${p.vendor}`} module="supply" /><RowMenu items={poMenu(p)} /></div></td>
                </tr>,
                isOpen && <tr key={`${p.id}-d`}><td colSpan={9} className="p-0">{detail(p)}</td></tr>,
              ];
            })}
          </Table>
        </div>
        {!list.length && <EmptyState text={pos.length ? <>Không có PO khớp bộ lọc.</> : <>Chưa có PO đặt Hãng</>} hint={pos.length ? undefined : <>PO đặt trước 3–4 tháng, chia đợt hàng về và phân bổ giữ chỗ cho dự án.</>} art={pos.length ? 'search' : 'box'} action={pos.length ? undefined : 'Tạo PO ngay'} onAction={canEdit ? () => setPoForm({}) : undefined} />}
        <Pagination paged={paged} unit="PO" />
      </Panel>

      <Fab label="Tạo PO mới" onClick={() => setPoForm({})} disabled={!canEdit} />
      {poForm && <POFormModal id={poForm.id} onClose={() => setPoForm(null)} />}
      {shipForm && <ShipmentModal poId={shipForm.poId} shipmentId={shipForm.shipmentId} onClose={() => setShipForm(null)} />}
      {allocFor && <AllocationModal poId={allocFor.poId} sku={allocFor.sku} onClose={() => setAllocFor(null)} />}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

/** Ô chọn SKU có tìm kiếm theo mã, tên, thương hiệu */
function SkuPicker({ value, onChange, exclude = [] }: { value: string; onChange: (sku: string) => void; exclude?: string[] }) {
  const { skus } = useApp();
  const [q, setQ] = useState('');
  const [open, setOpen] = useState(false);
  const [hi, setHi] = useState(0);
  const ref = useOutsideClose(open, () => setOpen(false));
  const cur = skus.find((s) => s.sku === value);
  const t = q.trim().toLowerCase();
  const opts = skus.filter((s) => !exclude.includes(s.sku) && (!t || [s.sku, s.name, s.brand, s.category].some((v) => v.toLowerCase().includes(t)))).slice(0, 8);
  const pick = (s: SkuItem) => { onChange(s.sku); setOpen(false); setQ(''); };
  return (
    <div className="relative" ref={ref} data-picker>
      <input
        className={cn(inputCls, 'py-1.5 text-xs')}
        value={open ? q : cur ? `${cur.sku} – ${cur.name}` : ''}
        placeholder="Tìm mã SKU hoặc tên hàng..."
        onFocus={() => { setOpen(true); setQ(''); setHi(0); }}
        onChange={(e) => { setQ(e.target.value); setOpen(true); setHi(0); }}
        onKeyDown={(e) => {
          if (e.key === 'Enter' && !open) { e.preventDefault(); setOpen(true); return; }
          if (e.key === 'ArrowDown') { e.preventDefault(); setHi((h) => Math.min(h + 1, opts.length - 1)); }
          if (e.key === 'ArrowUp') { e.preventDefault(); setHi((h) => Math.max(h - 1, 0)); }
          if (e.key === 'Enter' && opts[hi]) { e.preventDefault(); pick(opts[hi]); }
          if (e.key === 'Escape') setOpen(false);
        }}
        role="combobox"
        aria-expanded={open}
        aria-label="Chọn SKU"
      />
      {open && (
        <ul className="absolute left-0 right-0 top-full z-50 mt-1 max-h-64 overflow-y-auto rounded border border-[#263044] bg-[#151C29] py-1 shadow-2xl" role="listbox">
          {opts.map((s, i) => (
            <li key={s.sku} role="option" aria-selected={i === hi}>
              <button className={cn('w-full px-3 py-2 text-left text-xs', i === hi ? 'bg-[#F28C33]/10' : 'hover:bg-[#1C2534]')} onMouseEnter={() => setHi(i)} onMouseDown={(e) => { e.preventDefault(); pick(s); }}>
                <span className="font-mono text-[#F7B23B]">{s.sku}</span> <span className="text-[#F1F5F9]">{s.name}</span>
                <span className="block text-[#94A3B8]">{s.brand}, {s.category}, {s.unit}, lead-time {s.leadTimeDays} ngày, tồn {s.stock.toLocaleString('vi-VN')}</span>
              </button>
            </li>
          ))}
          {!opts.length && <li className="px-3 py-3 text-xs text-[#94A3B8]">Không có SKU phù hợp. Thêm ở phân hệ Sản phẩm.</li>}
        </ul>
      )}
    </div>
  );
}

function POFormModal({ id, onClose }: { id?: string; onClose: () => void }) {
  const { pos, setPos, skus, me, notify, budget, canDo } = useApp();
  const existing = pos.find((p) => p.id === id);
  const today = todayISO();
  const [vendor, setVendor] = useState(existing?.vendor ?? budget.vendor);
  const [orderDate, setOrderDate] = useState(existing?.orderDate ?? today);
  const [expectedDate, setExpectedDate] = useState(existing?.expectedDate ?? '');
  const [purpose, setPurpose] = useState<PoPurpose>(existing?.purpose ?? 'MIXED');
  const [note, setNote] = useState(existing?.note ?? '');
  const [lines, setLines] = useState<PoLine[]>(existing?.lines ?? [{ sku: '', qty: 0, unitPrice: 0, allocations: [] }]);
  const [touched, setTouched] = useState(false);
  const shippedOf = (sku: string) => existing ? existing.shipments.reduce((a, s) => a + (s.lines.find((x) => x.sku === sku)?.qty ?? 0), 0) : 0;
  const lead = Math.max(0, ...lines.map((l) => skus.find((s) => s.sku === l.sku)?.leadTimeDays ?? 0));
  const autoExpected = lead ? iso(new Date(new Date(`${orderDate}T12:00:00`).getTime() + lead * 864e5)) : '';
  const setLine = (i: number, p: Partial<PoLine>) => setLines((ls) => ls.map((l, j) => (j === i ? { ...l, ...p } : l)));
  const errs: string[] = [];
  const clean = lines.filter((l) => l.sku);
  if (vendor.trim().length < 2) errs.push('Nhập tên Hãng');
  if (!clean.length) errs.push('Chọn ít nhất 1 SKU');
  if (clean.some((l) => l.qty <= 0 || l.unitPrice <= 0)) errs.push('Số lượng và đơn giá phải lớn hơn 0');
  if (existing && clean.some((l) => l.qty < shippedOf(l.sku))) errs.push('Số lượng đặt không được nhỏ hơn số đã lên lịch giao');
  if (existing && existing.lines.some((l) => shippedOf(l.sku) > 0 && !clean.some((x) => x.sku === l.sku))) errs.push('Không xóa được SKU đã có đợt hàng');
  const total = clean.reduce((a, l) => a + l.qty * l.unitPrice, 0);

  const save = () => {
    setTouched(true);
    if (errs.length) return;
    const fixed = clean.map((l) => ({ ...l, allocations: l.allocations.filter((a) => a.qty > 0).slice(), qty: l.qty }));
    if (existing) {
      setPos((all) => all.map((p) => (p.id === existing.id ? { ...p, vendor: vendor.trim(), orderDate, expectedDate: expectedDate || autoExpected, purpose, note: note.trim(), lines: fixed } : p)));
      notify(`Đã cập nhật ${existing.code}`, 'teal');
    } else {
      const prefix = /hilti/i.test(vendor) ? 'HILTI' : budget.vendorCode;
      const seq = Math.max(0, ...pos.map((p) => Number(p.code.match(/(\d+)$/)?.[1] ?? 0))) + 1;
      const code = `PO-${prefix}-${orderDate.slice(0, 4)}-${String(seq).padStart(4, '0')}`;
      setPos((all) => [{ id: uid('po'), code, vendor: vendor.trim(), orderDate, expectedDate: expectedDate || autoExpected || orderDate, purpose, note: note.trim(), lines: fixed, shipments: [], createdBy: me.id }, ...all]);
      notify(`Đã tạo ${code}, ${compact(total)}. Thêm các đợt hàng về khi Hãng xác nhận lịch giao.`, 'teal');
    }
    onClose();
  };

  return (
    <Modal title={existing ? `Sửa ${existing.code}` : 'Tạo PO đặt Hãng'} onClose={onClose} wide footer={<><span className="mr-auto self-center text-sm tabular-nums">Tổng giá trị: <b>{vnd(total)}</b></span><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>{existing ? 'Lưu' : 'Tạo PO'}</button></>}>
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-4">
        <Field label="Hãng / nhà cung cấp" className="sm:col-span-2"><input className={inputCls} value={vendor} onChange={(e) => setVendor(e.target.value)} list="vendor-list" /></Field>
        <datalist id="vendor-list">{Array.from(new Set([budget.vendor, ...pos.map((p) => p.vendor)])).map((v) => <option key={v} value={v} />)}</datalist>
        <Field label="Ngày đặt"><input className={inputCls} type="date" value={orderDate} onChange={(e) => setOrderDate(e.target.value)} /></Field>
        <Field label="Dự kiến về đủ" hint={autoExpected ? `Theo lead-time dài nhất ${lead} ngày: ${fmtDate(autoExpected)}` : undefined}><input className={inputCls} type="date" value={expectedDate || autoExpected} onChange={(e) => setExpectedDate(e.target.value)} /></Field>
        <Field label="Mục đích" className="sm:col-span-2">
          <select className={inputCls} value={purpose} onChange={(e) => setPurpose(e.target.value as PoPurpose)}>
            {(Object.keys(PO_PURPOSE) as PoPurpose[]).map((x) => <option key={x} value={x}>{PO_PURPOSE[x]}</option>)}
          </select>
        </Field>
        <Field label="Ghi chú" className="sm:col-span-2"><input className={inputCls} value={note} onChange={(e) => setNote(e.target.value)} /></Field>
      </div>
      <h3 className="mb-2 mt-5 text-sm font-semibold">Sản phẩm đặt (chọn từ danh mục SKU)</h3>
      <div className="space-y-2">
        {lines.map((l, i) => {
          const k = skus.find((s) => s.sku === l.sku);
          const shipped = shippedOf(l.sku);
          return (
            <div key={i} className="grid grid-cols-12 items-start gap-2 rounded bg-[#1C2534] p-2">
              <div className="col-span-12 sm:col-span-6">
                <SkuPicker value={l.sku} exclude={lines.filter((_, j) => j !== i).map((x) => x.sku)} onChange={(sku) => setLine(i, { sku, unitPrice: l.unitPrice || (canDo('price.viewCost') ? skus.find((s) => s.sku === sku)?.costPrice : 0) || 0 })} />
                {k && <p className="mt-1 text-[11px] text-[#94A3B8]">{k.unit}, tồn {k.stock.toLocaleString('vi-VN')} (min {k.minStock}, max {k.maxStock}){shipped ? `, đã lên lịch ${shipped}` : ''}</p>}
              </div>
              <input className={cn(inputCls, 'col-span-4 py-1.5 text-xs sm:col-span-2')} type="number" min={0} placeholder="SL" value={l.qty || ''} onChange={(e) => setLine(i, { qty: Number(e.target.value) })} aria-label="Số lượng" />
              <input className={cn(inputCls, 'col-span-6 py-1.5 text-xs tabular-nums sm:col-span-3')} inputMode="numeric" placeholder="Đơn giá" value={l.unitPrice ? new Intl.NumberFormat('vi-VN').format(l.unitPrice) : ''} onChange={(e) => setLine(i, { unitPrice: digits(e.target.value) })} aria-label="Đơn giá" />
              <button className="col-span-2 flex justify-center pt-2 text-[#94A3B8] hover:text-[#F87171] disabled:opacity-40 sm:col-span-1" disabled={shipped > 0} onClick={() => setLines((ls) => ls.filter((_, j) => j !== i))} aria-label="Xóa dòng"><Trash2 className="h-4 w-4" /></button>
            </div>
          );
        })}
      </div>
      <button className={cn(btnGhost, btnSm, 'mt-2')} onClick={() => setLines((ls) => [...ls, { sku: '', qty: 0, unitPrice: 0, allocations: [] }])}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm SKU</button>
      {touched && errs.length > 0 && <ul className="mt-3 space-y-0.5 text-xs text-[#F87171]">{errs.map((x) => <li key={x}>{x}</li>)}</ul>}
    </Modal>
  );
}

function ShipmentModal({ poId, shipmentId, onClose }: { poId: string; shipmentId?: string; onClose: () => void }) {
  const { pos, setPos, skus, notify } = useApp();
  const po = pos.find((p) => p.id === poId)!;
  const existing = po.shipments.find((s) => s.id === shipmentId);
  const otherQty = (sku: string) => po.shipments.filter((s) => s.id !== shipmentId).reduce((a, s) => a + (s.lines.find((x) => x.sku === sku)?.qty ?? 0), 0);
  const [code, setCode] = useState(existing?.code ?? `Đợt ${po.shipments.length + 1}`);
  const [mode, setMode] = useState<ShipMode>(existing?.mode ?? 'SEA');
  const [docNo, setDocNo] = useState(existing?.docNo ?? '');
  const [etd, setEtd] = useState(existing?.etd ?? '');
  const [eta, setEta] = useState(existing?.eta ?? '');
  const [status, setStatus] = useState<ShipmentStatus>(existing?.status ?? 'PLANNED');
  const [qty, setQty] = useState<Record<string, number>>(() => Object.fromEntries(po.lines.map((l) => [l.sku, existing ? existing.lines.find((x) => x.sku === l.sku)?.qty ?? 0 : Math.max(0, l.qty - otherQty(l.sku))])));
  const [touched, setTouched] = useState(false);
  const errs: string[] = [];
  if (!eta) errs.push('Nhập ETA');
  if (etd && eta && etd > eta) errs.push('ETD phải trước ETA');
  if (status !== 'PLANNED' && !docNo.trim()) errs.push(`Nhập số ${mode === 'AIR' ? 'AWB' : 'vận đơn BL'} khi hàng đã xuất`);
  po.lines.forEach((l) => { if ((qty[l.sku] ?? 0) + otherQty(l.sku) > l.qty) errs.push(`${l.sku}: vượt số lượng đặt (còn ${l.qty - otherQty(l.sku)})`); });
  if (!Object.values(qty).some((v) => v > 0)) errs.push('Nhập số lượng ít nhất 1 SKU');

  const save = () => {
    setTouched(true);
    if (errs.length) return;
    const s: Shipment = { id: existing?.id ?? uid('s'), code: code.trim() || 'Đợt', mode, docNo: docNo.trim(), etd: etd || undefined, eta, status, receivedAt: existing?.receivedAt, lines: po.lines.filter((l) => (qty[l.sku] ?? 0) > 0).map((l) => ({ sku: l.sku, qty: qty[l.sku] })) };
    setPos((all) => all.map((p) => (p.id === po.id ? { ...p, shipments: existing ? p.shipments.map((x) => (x.id === s.id ? s : x)) : [...p.shipments, s] } : p)));
    notify(`${po.code}: ${existing ? 'đã cập nhật' : 'đã thêm'} ${s.code}, ETA ${fmtDate(eta)}`, 'teal');
    onClose();
  };

  return (
    <Modal title={`${existing ? 'Sửa' : 'Thêm'} đợt hàng về: ${po.code}`} onClose={onClose} wide footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Lưu</button></>}>
      <div className="grid grid-cols-2 gap-4 sm:grid-cols-3">
        <Field label="Tên đợt"><input className={inputCls} value={code} onChange={(e) => setCode(e.target.value)} /></Field>
        <Field label="Phương thức">
          <select className={inputCls} value={mode} onChange={(e) => setMode(e.target.value as ShipMode)}>
            {(Object.keys(SHIP_MODE) as ShipMode[]).map((m) => <option key={m} value={m}>{SHIP_MODE[m].label}</option>)}
          </select>
        </Field>
        <Field label={mode === 'AIR' ? 'Số AWB' : 'Số vận đơn (BL)'}><input className={cn(inputCls, 'font-mono')} value={docNo} onChange={(e) => setDocNo(e.target.value.toUpperCase())} /></Field>
        <Field label="ETD (ngày xuất)"><input className={inputCls} type="date" value={etd} onChange={(e) => setEtd(e.target.value)} /></Field>
        <Field label="ETA (dự kiến về) *"><input className={inputCls} type="date" value={eta} onChange={(e) => setEta(e.target.value)} /></Field>
        <Field label="Trạng thái">
          <select className={inputCls} value={status} onChange={(e) => setStatus(e.target.value as ShipmentStatus)} disabled={existing?.status === 'RECEIVED'}>
            {(Object.keys(SHIPMENT_STATUS) as ShipmentStatus[]).filter((x) => x !== 'RECEIVED' || existing?.status === 'RECEIVED').map((x) => <option key={x} value={x}>{SHIPMENT_STATUS[x].label}</option>)}
          </select>
        </Field>
      </div>
      <p className="mt-2 text-xs text-[#94A3B8]">Nhập kho bằng nút "Nhập kho" ở danh sách đợt hàng để cộng phần tồn tự do vào tồn kho.</p>
      <h3 className="mb-2 mt-4 text-sm font-semibold">Số lượng trong đợt này</h3>
      <div className="space-y-2">
        {po.lines.map((l) => (
          <div key={l.sku} className="flex items-center gap-3 rounded bg-[#1C2534] px-3 py-2 text-sm">
            <div className="min-w-0 flex-1"><p className="font-mono text-xs text-[#F7B23B]">{l.sku}</p><p className="truncate text-xs text-[#94A3B8]">{skus.find((s) => s.sku === l.sku)?.name}, đặt {l.qty}, các đợt khác {otherQty(l.sku)}</p></div>
            <input className={cn(inputBase, 'w-28 py-1.5 text-right text-xs tabular-nums')} type="number" min={0} max={l.qty - otherQty(l.sku)} value={qty[l.sku] ?? 0} onChange={(e) => setQty({ ...qty, [l.sku]: Number(e.target.value) })} aria-label={`Số lượng ${l.sku}`} />
          </div>
        ))}
      </div>
      {touched && errs.length > 0 && <ul className="mt-3 space-y-0.5 text-xs text-[#F87171]">{errs.map((x) => <li key={x}>{x}</li>)}</ul>}
    </Modal>
  );
}

function AllocationModal({ poId, sku, onClose }: { poId: string; sku: string; onClose: () => void }) {
  const { pos, setPos, leads, customers, skus, notify } = useApp();
  const po = pos.find((p) => p.id === poId)!;
  const line = po.lines.find((l) => l.sku === sku)!;
  const [rows, setRows] = useState<PoAllocation[]>(line.allocations);
  // Phần đã nhập kho theo từng đích bị khóa: chỉ sửa được phần chưa về
  const lockedOf = (kind: PoAllocation['kind'], refId: string) => receivedReservedFor(po, sku, kind, refId);
  const lockErr = line.allocations
    .filter((a) => lockedOf(a.kind, a.refId) > 0)
    .find((a) => (rows.find((r) => r.kind === a.kind && r.refId === a.refId)?.qty ?? 0) < lockedOf(a.kind, a.refId));
  const projects = leads.filter((l) => ['ACCEPTED', 'QUOTED', 'WON'].includes(l.status));
  const used = rows.reduce((a, r) => a + r.qty, 0);
  const over = used > line.qty;
  const dupKey = new Set<string>();
  const dup = rows.some((r) => { const k = r.kind + r.refId; if (dupKey.has(k)) return true; dupKey.add(k); return false; });
  const setRow = (i: number, p: Partial<PoAllocation>) => setRows((rs) => rs.map((r, j) => (j === i ? { ...r, ...p } : r)));

  const save = () => {
    if (over || dup || rows.some((r) => !r.refId || r.qty <= 0)) return notify('Kiểm tra lại phân bổ: chọn đích, số lượng > 0, không trùng và không vượt số đặt', 'red');
    if (lockErr) return notify(`Không giảm dưới số đã nhập kho giữ chỗ (${lockedOf(lockErr.kind, lockErr.refId)}). Phần đã về kho xử lý ở tab Kho & giữ chỗ.`, 'red');
    setPos((all) => all.map((p) => (p.id === po.id ? { ...p, lines: p.lines.map((l) => (l.sku === sku ? { ...l, allocations: rows } : l)) } : p)));
    notify(`Đã phân bổ ${sku}: giữ chỗ ${used}, tồn tự do ${line.qty - used}`, 'teal');
    onClose();
  };

  return (
    <Modal title={`Phân bổ giữ chỗ: ${sku}`} onClose={onClose} wide footer={<><span className={cn('mr-auto self-center text-sm tabular-nums', over && 'text-[#F87171]')}>Giữ chỗ {used} / {line.qty}, tồn tự do {Math.max(0, line.qty - used)}</span><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>Lưu phân bổ</button></>}>
      <p className="mb-3 text-sm text-[#94A3B8]">{skus.find((s) => s.sku === sku)?.name}, PO {po.code}. Hàng về theo từng đợt được lấp vào các suất giữ chỗ theo thứ tự dưới đây; phần còn lại nhập tồn kho tự do.</p>
      <div className="space-y-2">
        {rows.map((r, i) => (
          <div key={i} className="grid grid-cols-12 items-center gap-2 rounded bg-[#1C2534] p-2">
            <select className={cn(inputCls, 'col-span-4 py-1.5 text-xs sm:col-span-3')} value={r.kind} onChange={(e) => setRow(i, { kind: e.target.value as PoAllocation['kind'], refId: '' })} aria-label="Loại đích">
              <option value="LEAD">Dự án</option>
              <option value="CUSTOMER">Khách hàng / đại lý</option>
            </select>
            <select className={cn(inputCls, 'col-span-8 py-1.5 text-xs sm:col-span-6')} value={r.refId} onChange={(e) => setRow(i, { refId: e.target.value })} aria-label="Đích giữ chỗ">
              <option value="">Chọn...</option>
              {r.kind === 'LEAD' ? projects.map((l) => <option key={l.id} value={l.id}>{l.company}: {l.boqNote}</option>) : customers.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
            </select>
            <input className={cn(inputCls, 'col-span-9 py-1.5 text-right text-xs tabular-nums sm:col-span-2')} type="number" min={lockedOf(r.kind, r.refId)} value={r.qty || ''} onChange={(e) => setRow(i, { qty: Number(e.target.value) })} aria-label="Số lượng giữ" />
            <button className="col-span-3 flex justify-center text-[#94A3B8] hover:text-[#F87171] disabled:opacity-30 sm:col-span-1" disabled={lockedOf(r.kind, r.refId) > 0} title={lockedOf(r.kind, r.refId) > 0 ? 'Đã có hàng nhập kho cho đích này' : undefined} onClick={() => setRows((rs) => rs.filter((_, j) => j !== i))} aria-label="Xóa dòng"><Trash2 className="h-4 w-4" /></button>
            {lockedOf(r.kind, r.refId) > 0 && <p className="col-span-12 text-[11px] text-[#F7B23B]">Đã nhập kho giữ chỗ {lockedOf(r.kind, r.refId).toLocaleString('vi-VN')} (khóa), chỉ chỉnh được phần chưa về.</p>}
          </div>
        ))}
      </div>
      <button className={cn(btnGhost, btnSm, 'mt-2')} onClick={() => setRows((rs) => [...rs, { kind: 'LEAD', refId: '', qty: 0 }])}><Plus className="h-3.5 w-3.5" aria-hidden />Thêm giữ chỗ</button>
      {dup && <p className="mt-2 text-xs text-[#F87171]">Có đích giữ chỗ bị trùng.</p>}
    </Modal>
  );
}

// =====================================================================
//  DANH MỤC SẢN PHẨM (Master SKU Catalog)
// =====================================================================

function SkuModal({ sku, onClose }: { sku?: SkuItem; onClose: () => void }) {
  const { skus, setSkus, notify, canDo } = useApp();
  const canSeeCost = canDo('price.viewCost');
  const [f, setF] = useState<SkuItem>(sku ?? { sku: '', name: '', brand: '3M', category: '', unit: 'Bộ', minStock: 0, maxStock: 0, leadTimeDays: 90, stock: 0, costPrice: 0, basePrice: 0, dealerPrice: 0, projectPrice: 0 });
  const [touched, setTouched] = useState(false);
  const set = <K extends keyof SkuItem>(k: K, v: SkuItem[K]) => setF((p) => ({ ...p, [k]: v }));
  const e: Partial<Record<keyof SkuItem, string>> = {};
  if (!/^[A-Z0-9][A-Z0-9._-]{2,39}$/.test(f.sku)) e.sku = 'Mã viết hoa không dấu, 3–40 ký tự (chữ, số, - . _)';
  else if (!sku && skus.some((s) => s.sku === f.sku)) e.sku = 'Mã SKU đã tồn tại';
  if (f.name.trim().length < 3) e.name = 'Nhập tên và quy cách';
  if (!f.brand.trim()) e.brand = 'Nhập thương hiệu';
  if (f.minStock < 0) e.minStock = 'Không âm';
  if (f.maxStock < f.minStock) e.maxStock = 'Tồn tối đa phải lớn hơn hoặc bằng tối thiểu';
  if (f.leadTimeDays < 0 || f.leadTimeDays > 365) e.leadTimeDays = 'Từ 0 đến 365 ngày';
  if (f.basePrice <= 0) e.basePrice = 'Nhập giá bán lẻ tiêu chuẩn';
  if (f.dealerPrice > f.basePrice) e.dealerPrice = 'Giá đại lý không cao hơn giá bán lẻ';
  if (f.projectPrice > f.basePrice) e.projectPrice = 'Giá dự án không cao hơn giá bán lẻ';
  const err = (k: keyof SkuItem) => (touched ? e[k] : undefined);
  const brands = Array.from(new Set(['3M', 'Hilti', ...skus.map((s) => s.brand)]));
  const cats = Array.from(new Set(skus.map((s) => s.category).filter(Boolean)));

  const save = () => {
    setTouched(true);
    if (Object.keys(e).length) return;
    const clean = { ...f, name: f.name.trim(), brand: f.brand.trim(), category: f.category.trim() };
    setSkus((all) => (sku ? all.map((s) => (s.sku === sku.sku ? clean : s)) : [clean, ...all]));
    notify(sku ? `Đã cập nhật ${clean.sku}` : `Đã thêm sản phẩm ${clean.sku}`, 'teal');
    onClose();
  };

  return (
    <Modal title={sku ? `Sửa sản phẩm ${sku.sku}` : 'Thêm sản phẩm mới'} onClose={onClose} wide footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} onClick={save}>{sku ? 'Lưu' : 'Thêm sản phẩm'}</button></>}>
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-4">
        <Field label="Mã SKU *" error={err('sku')} hint={sku ? 'Mã không đổi được sau khi tạo' : undefined}><input className={cn(inputCls, 'font-mono')} disabled={!!sku} value={f.sku} onChange={(ev) => set('sku', ev.target.value.toUpperCase().replace(/\s/g, ''))} placeholder="3M-SCOTCH-23" /></Field>
        <Field label="Tên sản phẩm & quy cách *" error={err('name')} className="sm:col-span-3"><input className={inputCls} value={f.name} onChange={(ev) => set('name', ev.target.value)} placeholder="Băng keo cách điện Scotch 23, 19mm x 9,1m" /></Field>
        <Field label="Thương hiệu / Hãng *" error={err('brand')}><input className={inputCls} list="sku-brands" value={f.brand} onChange={(ev) => set('brand', ev.target.value)} /></Field>
        <datalist id="sku-brands">{brands.map((b) => <option key={b} value={b} />)}</datalist>
        <Field label="Phân loại / ngành hàng" className="sm:col-span-2"><input className={inputCls} list="sku-cats" value={f.category} onChange={(ev) => set('category', ev.target.value)} /></Field>
        <datalist id="sku-cats">{cats.map((c) => <option key={c} value={c} />)}</datalist>
        <Field label="Đơn vị tính">
          <select className={inputCls} value={f.unit} onChange={(ev) => set('unit', ev.target.value)}>
            {Array.from(new Set([...UNITS, f.unit])).map((u) => <option key={u} value={u}>{u}</option>)}
          </select>
        </Field>
        <Field label="Tồn an toàn tối thiểu (Min)" error={err('minStock')}><input className={inputCls} type="number" min={0} value={f.minStock} onChange={(ev) => set('minStock', Number(ev.target.value))} /></Field>
        <Field label="Tồn tối đa (Max)" error={err('maxStock')}><input className={inputCls} type="number" min={0} value={f.maxStock} onChange={(ev) => set('maxStock', Number(ev.target.value))} /></Field>
        <Field label="Lead-time nhập hàng (ngày)" error={err('leadTimeDays')}><input className={inputCls} type="number" min={0} value={f.leadTimeDays} onChange={(ev) => set('leadTimeDays', Number(ev.target.value))} /></Field>
        <Field label="Tồn kho hiện tại"><input className={inputCls} type="number" min={0} value={f.stock} onChange={(ev) => set('stock', Number(ev.target.value))} /></Field>
        <Field label="Giá bán lẻ tiêu chuẩn *" error={err('basePrice')}><MoneyInput value={f.basePrice} onChange={(n) => set('basePrice', n)} /></Field>
        <Field label="Giá đại lý" error={err('dealerPrice')}><MoneyInput value={f.dealerPrice} onChange={(n) => set('dealerPrice', n)} /></Field>
        <Field label="Giá dự án M&E" error={err('projectPrice')}><MoneyInput value={f.projectPrice} onChange={(n) => set('projectPrice', n)} /></Field>
        {canSeeCost && <Field label="Giá vốn nhập Hãng" hint="Chỉ Trưởng phòng / BOD xem; điền sẵn đơn giá PO"><MoneyInput value={f.costPrice} onChange={(n) => set('costPrice', n)} /></Field>}
      </div>
    </Modal>
  );
}

function SkuCatalog() {
  const { skus, setSkus, pos, canDo, notify, reservations } = useApp();
  const canEdit = canDo('po.manage');
  const canSeeCost = canDo('price.viewCost');
  const val = (s: SkuItem) => (canSeeCost ? s.costPrice : s.basePrice);
  const [q, setQ] = useState('');
  const [brand, setBrand] = useState('ALL');
  const [stockF, setStockF] = useState('ALL');
  const [modal, setModal] = useState<{ sku?: SkuItem } | null>(null);
  useIntent('sku.create', () => setModal({}));
  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
  const onOrder = (sku: string) => pos.filter((p) => !p.cancelled).reduce((a, p) => a + p.lines.filter((l) => l.sku === sku).reduce((b, l) => b + poLineStats(p, l).backorder, 0), 0);
  const level = (s: SkuItem) => (s.stock < s.minStock ? 'LOW' : s.maxStock && s.stock > s.maxStock ? 'HIGH' : 'OK');
  const list = skus.filter((s) => {
    const t = q.trim().toLowerCase();
    return (!t || [s.sku, s.name, s.category].some((v) => v.toLowerCase().includes(t))) && (brand === 'ALL' || s.brand === brand) && (stockF === 'ALL' || level(s) === stockF);
  });
  const paged = usePaged(list, 12);
  const low = skus.filter((s) => level(s) === 'LOW');
  const stockBadge = (s: SkuItem) => {
    const lv = level(s);
    return <Chip tone={lv === 'LOW' ? 'red' : lv === 'HIGH' ? 'orange' : 'teal'}>{lv === 'LOW' ? 'Dưới Min' : lv === 'HIGH' ? 'Vượt Max' : 'Trong định mức'}</Chip>;
  };
  const askDelete = (s: SkuItem) => setConfirm({
    title: 'Xóa sản phẩm', message: <>Xóa <b>{s.sku}</b> {s.name} khỏi danh mục?</>,
    blocked: pos.some((p) => p.lines.some((l) => l.sku === s.sku)) ? 'SKU đang có trong PO đặt Hãng, không thể xóa.' : reservedInStock(s.sku, reservations) > 0 ? 'SKU đang có hàng giữ chỗ trong kho, không thể xóa.' : undefined,
    onConfirm: () => { setSkus((all) => all.filter((x) => x.sku !== s.sku)); notify(`Đã xóa ${s.sku}`, 'orange'); },
  });

  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Số SKU" value={String(skus.length)} icon={Package} color={C.blue} sub={`${new Set(skus.map((s) => s.brand)).size} thương hiệu`} />
        <StatCard label="Dưới Min" value={String(low.length)} icon={AlertTriangle} color={C.red} sub={low.slice(0, 3).map((s) => s.sku).join(', ') || 'Không có'} />
        <StatCard label="Giá trị tồn kho" value={compact(skus.reduce((a, s) => a + (s.stock + reservedInStock(s.sku, reservations)) * val(s), 0))} icon={Warehouse} color={C.teal} sub={`Tự do ${compact(skus.reduce((a, s) => a + s.stock * val(s), 0))}, giữ chỗ ${compact(skus.reduce((a, s) => a + reservedInStock(s.sku, reservations) * val(s), 0))}`} />
        <StatCard label="Đang đặt" value={compact(skus.reduce((a, s) => a + onOrder(s.sku) * val(s), 0))} icon={Ship} color={C.orange} sub={canSeeCost ? 'Theo giá vốn, từ các PO đang mở' : 'Theo giá bán lẻ, từ các PO đang mở'} />
      </div>
      <div className="flex flex-col gap-2 rounded-md border border-[#263044] bg-[#151C29] p-2 sm:flex-row sm:items-center">
        <div className="relative flex-1">
          <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#94A3B8]" aria-hidden />
          <input className={cn(inputCls, 'border-[#263044] bg-[#0F141E] py-2 pl-9')} value={q} onChange={(e) => setQ(e.target.value)} placeholder="Tìm theo mã SKU hoặc tên hàng..." aria-label="Tìm sản phẩm" />
        </div>
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={brand} onChange={(e) => setBrand(e.target.value)} aria-label="Thương hiệu">
          <option value="ALL">Mọi thương hiệu</option>
          {Array.from(new Set(skus.map((s) => s.brand))).map((b) => <option key={b} value={b}>{b}</option>)}
        </select>
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={stockF} onChange={(e) => setStockF(e.target.value)} aria-label="Tình trạng tồn">
          <option value="ALL">Mọi tình trạng tồn</option>
          <option value="LOW">Dưới Min</option>
          <option value="OK">Trong định mức</option>
          <option value="HIGH">Vượt Max</option>
        </select>
        <button className={cn(btnPrimary, 'justify-center py-2')} disabled={!canEdit} onClick={() => setModal({})}><Plus className="h-4 w-4" aria-hidden />Thêm sản phẩm mới</button>
      </div>

      <Panel title={`${list.length} sản phẩm`}>
        <div className="space-y-2 md:hidden">
          {paged.slice.map((s) => (
            <MobileRow key={s.sku} title={s.name} sub={`${s.sku}, ${s.brand}, giữ chỗ ${reservedInStock(s.sku, reservations).toLocaleString('vi-VN')}`} badge={stockBadge(s)} value={`${s.stock.toLocaleString('vi-VN')} ${s.unit} tự do`} status={<span className="text-xs text-[#94A3B8]">Min {s.minStock}, Max {s.maxStock}</span>}
              menu={<RowMenu items={[{ label: 'Sửa', icon: Pencil, onClick: () => setModal({ sku: s }), disabled: !canEdit }, { label: 'Xóa', icon: Trash2, danger: true, onClick: () => askDelete(s), disabled: !canEdit }]} />} />
          ))}
        </div>
        <div className="hidden md:block">
          <Table head={['Mã SKU', 'Tên sản phẩm & quy cách', 'Bán lẻ / Đại lý / Dự án', 'Tồn tự do', 'Giữ chỗ / tổng', 'Min / Max', 'Đang đặt / lead-time', '']} minW={1000}>
            {paged.slice.map((s) => (
              <tr key={s.sku} className={rowCls}>
                <td className={cn(tdFirst, 'font-mono text-xs text-[#F7B23B]')}>{s.sku}</td>
                <td className={tdCls}><p className="max-w-[260px] truncate" title={s.name}>{s.name}</p><p className="max-w-[260px] truncate text-xs text-[#94A3B8]">{s.brand} · {s.category || 'Chưa phân loại'} · {s.unit}{canSeeCost ? ` · vốn ${vnd(s.costPrice)}` : ''}</p></td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-xs')}><p>{s.basePrice.toLocaleString('vi-VN')}</p><p className="text-[#94A3B8]">{(s.dealerPrice || s.basePrice).toLocaleString('vi-VN')} / {(s.projectPrice || s.basePrice).toLocaleString('vi-VN')}</p></td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}><p>{s.stock.toLocaleString('vi-VN')}</p>{stockBadge(s)}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}><p className="text-[#F7B23B]">{reservedInStock(s.sku, reservations) ? reservedInStock(s.sku, reservations).toLocaleString('vi-VN') : '—'}</p><p className="text-xs text-[#94A3B8]">{(s.stock + reservedInStock(s.sku, reservations)).toLocaleString('vi-VN')}</p></td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-xs')}>{s.minStock.toLocaleString('vi-VN')} / {s.maxStock.toLocaleString('vi-VN')}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}><p>{onOrder(s.sku) ? onOrder(s.sku).toLocaleString('vi-VN') : '—'}</p><p className="text-xs text-[#94A3B8]">{s.leadTimeDays} ngày</p></td>
                <td className={cn(tdLast, 'whitespace-nowrap text-right')}>
                  <button className={cn(btnGhost, 'mr-1 p-1.5')} disabled={!canEdit} onClick={() => setModal({ sku: s })} aria-label={`Sửa ${s.sku}`}><Pencil className="h-3.5 w-3.5" /></button>
                  <button className={cn(btnGhost, 'p-1.5 hover:text-[#F87171]')} disabled={!canEdit} onClick={() => askDelete(s)} aria-label={`Xóa ${s.sku}`}><Trash2 className="h-3.5 w-3.5" /></button>
                </td>
              </tr>
            ))}
          </Table>
        </div>
        {!list.length && <EmptyState text={skus.length ? <>Không có sản phẩm khớp bộ lọc.</> : <>Danh mục sản phẩm đang trống</>} hint={skus.length ? <>Thử bỏ bớt điều kiện lọc hoặc tìm theo mã SKU khác.</> : <>Thêm SKU để dùng chung cho bóc tách BOQ, báo giá và đặt PO Hãng.</>} art={skus.length ? 'search' : 'box'} action={skus.length ? undefined : 'Tạo sản phẩm ngay'} onAction={canEdit ? () => setModal({}) : undefined} />}
        <Pagination paged={paged} unit="sản phẩm" />
      </Panel>
      {modal && <SkuModal sku={modal.sku} onClose={() => setModal(null)} />}
      {confirm && <ConfirmDialog {...confirm} onClose={() => setConfirm(null)} />}
    </div>
  );
}

// =====================================================================
//  KHO & GIỮ CHỖ: hàng giữ chỗ trong kho, xuất giao, giải phóng có xác nhận
// =====================================================================

/** Chọn đích giữ chỗ: dự án đang mở / đã chốt hoặc khách hàng */
function TargetSelect({ kind, refId, onChange }: { kind: PoAllocation['kind']; refId: string; onChange: (kind: PoAllocation['kind'], refId: string) => void }) {
  const { leads, customers } = useApp();
  const projects = leads.filter((l) => ['ACCEPTED', 'QUOTED', 'WON'].includes(l.status));
  return (
    <div className="grid grid-cols-1 gap-2 sm:grid-cols-3">
      <select className={inputCls} value={kind} onChange={(e) => onChange(e.target.value as PoAllocation['kind'], '')} aria-label="Loại đích">
        <option value="LEAD">Dự án</option>
        <option value="CUSTOMER">Khách hàng / đại lý</option>
      </select>
      <select className={cn(inputCls, 'sm:col-span-2')} value={refId} onChange={(e) => onChange(kind, e.target.value)} aria-label="Đích giữ chỗ">
        <option value="">Chọn...</option>
        {kind === 'LEAD' ? projects.map((l) => <option key={l.id} value={l.id}>{l.company}: {l.boqNote}</option>) : customers.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
      </select>
    </div>
  );
}

function DeliverModal({ r, onClose }: { r: StockReservation; onClose: () => void }) {
  const { deliverReservation, skus } = useApp();
  const allocName = useAllocName();
  const [qty, setQty] = useState(r.qty);
  const [note, setNote] = useState('');
  return (
    <Modal title="Xuất giao hàng giữ chỗ" onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} disabled={qty <= 0 || qty > r.qty || !note.trim()} onClick={() => { deliverReservation(r.id, qty, note.trim()); onClose(); }}><Truck className="h-4 w-4" aria-hidden />Xác nhận xuất</button></>}>
      <div className="space-y-4">
        <div className="rounded bg-[#1C2534] p-3 text-sm">
          <p><span className="font-mono text-[#F7B23B]">{r.sku}</span> {skus.find((s) => s.sku === r.sku)?.name}</p>
          <p className="text-xs text-[#94A3B8]">Giữ cho {allocName(r)}, còn trong kho {r.qty.toLocaleString('vi-VN')}, đã giao {r.delivered.toLocaleString('vi-VN')}</p>
        </div>
        <Field label="Số lượng xuất"><input className={inputCls} type="number" min={1} max={r.qty} value={qty} onChange={(e) => setQty(Number(e.target.value))} /></Field>
        <Field label="Chứng từ xuất *" hint="Số phiếu xuất kho, mã đơn Getfly hoặc biên bản giao hàng"><input className={inputCls} value={note} onChange={(e) => setNote(e.target.value)} placeholder="VD: PXK-0012, đơn DH18150" /></Field>
      </div>
    </Modal>
  );
}

function RequestReleaseModal({ r, onClose }: { r: StockReservation; onClose: () => void }) {
  const { requestRelease } = useApp();
  const allocName = useAllocName();
  const [reason, setReason] = useState('');
  return (
    <Modal title="Yêu cầu trả về tồn tự do" onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} disabled={reason.trim().length < 5} onClick={() => { requestRelease(r.id, reason.trim()); onClose(); }}>Gửi yêu cầu</button></>}>
      <p className="mb-3 text-sm text-[#94A3B8]">{r.qty.toLocaleString('vi-VN')} {r.sku} đang giữ cho {allocName(r)}. Yêu cầu cần Trưởng phòng phụ trách hoặc Giám đốc xác nhận.</p>
      <Field label="Lý do *"><textarea className={cn(inputCls, 'min-h-20')} value={reason} onChange={(e) => setReason(e.target.value)} placeholder="VD: Khách đổi quy cách, hủy đơn..." /></Field>
    </Modal>
  );
}

function DecideReleaseModal({ r, onClose }: { r: StockReservation; onClose: () => void }) {
  const { decideRelease, canRelease, userName, skus } = useApp();
  const allocName = useAllocName();
  const [decision, setDecision] = useState<'RELEASE' | 'TRANSFER' | 'KEEP'>('RELEASE');
  const [target, setTarget] = useState<{ kind: PoAllocation['kind']; refId: string }>({ kind: 'LEAD', refId: '' });
  const [note, setNote] = useState('');
  const allowed = canRelease(r);
  const opts: [typeof decision, string, string][] = [
    ['RELEASE', 'Trả về tồn tự do', 'Cộng vào tồn kho tự do để bán cho khách khác'],
    ['TRANSFER', 'Chuyển sang dự án / khách hàng khác', 'Giữ nguyên trong kho, đổi đích giữ chỗ'],
    ['KEEP', 'Giữ lại cho đích hiện tại', 'Từ chối yêu cầu, ví dụ dự án có thể mở lại'],
  ];
  return (
    <Modal
      title="Xác nhận giải phóng hàng giữ chỗ"
      onClose={onClose}
      footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} disabled={!allowed || (decision === 'TRANSFER' && !target.refId)} onClick={() => { decideRelease(r.id, decision, note.trim(), decision === 'TRANSFER' ? target : undefined); onClose(); }}>Xác nhận</button></>}
    >
      <div className="space-y-4">
        <div className="rounded bg-[#1C2534] p-3 text-sm">
          <p><span className="font-mono text-[#F7B23B]">{r.sku}</span> {skus.find((s) => s.sku === r.sku)?.name}</p>
          <p className="text-xs text-[#94A3B8]">{r.qty.toLocaleString('vi-VN')} đang giữ cho {allocName(r)}</p>
          {r.releaseRequest && <p className="mt-1 text-xs text-[#F7B23B]">{r.releaseRequest.reason}{r.releaseRequest.by ? `, đề nghị bởi ${userName(r.releaseRequest.by)}` : ''}, {fmtDate(r.releaseRequest.at)}</p>}
        </div>
        {!allowed && <p className="rounded bg-[#EF4444]/10 p-3 text-sm text-[#F87171]">Bạn không có quyền xác nhận. Cần Trưởng phòng của phòng phụ trách hoặc Giám đốc (Cài đặt &gt; Phân quyền &gt; Xác nhận giải phóng hàng giữ chỗ).</p>}
        <fieldset className="space-y-2" disabled={!allowed}>
          {opts.map(([k, label, sub]) => (
            <label key={k} className={cn('flex cursor-pointer items-start gap-3 rounded border px-3 py-2.5', decision === k ? 'border-[#F28C33] bg-[#F28C33]/5' : 'border-[#263044] hover:bg-[#1C2534]')}>
              <input type="radio" name="decision" className="mt-1 accent-[#F28C33]" checked={decision === k} onChange={() => setDecision(k)} />
              <span><span className="block text-sm">{label}</span><span className="block text-xs text-[#94A3B8]">{sub}</span></span>
            </label>
          ))}
        </fieldset>
        {decision === 'TRANSFER' && <TargetSelect kind={target.kind} refId={target.refId} onChange={(kind, refId) => setTarget({ kind, refId })} />}
        <Field label="Ghi chú"><input className={inputCls} value={note} onChange={(e) => setNote(e.target.value)} /></Field>
      </div>
    </Modal>
  );
}

function ReserveFromStockModal({ onClose, preset }: { onClose: () => void; preset?: { kind: PoAllocation['kind']; refId: string } }) {
  const { skus, reserveFromStock } = useApp();
  const [sku, setSku] = useState('');
  const [target, setTarget] = useState(preset ?? { kind: 'LEAD' as PoAllocation['kind'], refId: '' });
  const [qty, setQty] = useState(0);
  const [note, setNote] = useState('');
  const k = skus.find((s) => s.sku === sku);
  const ok = !!k && qty > 0 && qty <= k.stock && !!target.refId;
  return (
    <Modal title="Giữ chỗ từ tồn tự do" onClose={onClose} footer={<><button className={btnGhost} onClick={onClose}>Hủy</button><button className={btnPrimary} disabled={!ok} onClick={() => { reserveFromStock(sku, target.kind, target.refId, qty, note.trim() || 'Giữ chỗ từ tồn kho'); onClose(); }}>Giữ chỗ</button></>}>
      <div className="space-y-4">
        <Field label="Sản phẩm"><SkuPicker value={sku} onChange={setSku} exclude={skus.filter((s) => s.stock <= 0).map((s) => s.sku)} /></Field>
        {k && <p className="-mt-2 text-xs text-[#94A3B8]">Tồn tự do hiện có {k.stock.toLocaleString('vi-VN')} {k.unit}</p>}
        <TargetSelect kind={target.kind} refId={target.refId} onChange={(kind, refId) => setTarget({ kind, refId })} />
        <div className="grid grid-cols-2 gap-3">
          <Field label="Số lượng"><input className={inputCls} type="number" min={1} max={k?.stock ?? 0} value={qty || ''} onChange={(e) => setQty(Number(e.target.value))} /></Field>
          <Field label="Ghi chú"><input className={inputCls} value={note} onChange={(e) => setNote(e.target.value)} /></Field>
        </div>
      </div>
    </Modal>
  );
}

function ReservationActions({ r, onDeliver, onRequest, onDecide }: { r: StockReservation; onDeliver: () => void; onRequest: () => void; onDecide: () => void }) {
  const { canDo, canRelease } = useApp();
  if (r.status === 'HELD') {
    return (
      <div className="flex flex-wrap gap-1.5">
        <button className={cn(btnPrimary, 'px-2.5 py-1 text-xs')} disabled={!canDo('stock.deliver') || r.qty <= 0} onClick={onDeliver}><Truck className="h-3.5 w-3.5" aria-hidden />Xuất giao</button>
        <button className={cn(btnGhost, btnSm)} disabled={!canDo('stock.deliver')} onClick={onRequest}>Trả về tồn</button>
      </div>
    );
  }
  if (r.status === 'PENDING_RELEASE') {
    return <button className={cn(btnGhost, btnSm, canRelease(r) && 'border-[#F28C33]/60 text-[#F7B23B]')} onClick={onDecide}>{canRelease(r) ? 'Xác nhận' : 'Xem yêu cầu'}</button>;
  }
  return <span className="text-xs text-[#94A3B8]">—</span>;
}

/** Hàng giữ chỗ của một dự án / khách hàng: trong kho, đang về, đã giao */
function ReservedGoodsPanel({ kind, refId }: { kind: PoAllocation['kind']; refId: string }) {
  const { reservations, pos, skus, canDo } = useApp();
  const [deliver, setDeliver] = useState<StockReservation | null>(null);
  const [request, setRequest] = useState<StockReservation | null>(null);
  const [decide, setDecide] = useState<StockReservation | null>(null);
  const [reserve, setReserve] = useState(false);
  const mine = reservations.filter((r) => r.kind === kind && r.refId === refId && r.status !== 'RELEASED');
  const incoming = pos.filter((p) => !p.cancelled).flatMap((p) => p.lines.flatMap((l) => l.allocations.filter((a) => a.kind === kind && a.refId === refId).map((a) => ({ po: p, sku: l.sku, qty: a.qty - receivedReservedFor(p, l.sku, kind, refId) })))).filter((x) => x.qty > 0);
  const unit = (sku: string) => skus.find((s) => s.sku === sku)?.unit ?? '';
  return (
    <section>
      <div className="mb-2 flex items-center justify-between gap-2">
        <h3 className="flex items-center gap-2 text-sm font-semibold"><Warehouse className="h-4 w-4 text-[#F28C33]" aria-hidden />Hàng giữ chỗ</h3>
        <button className={cn(btnGhost, btnSm)} disabled={!canDo('stock.deliver')} onClick={() => setReserve(true)}><Plus className="h-3.5 w-3.5" aria-hidden />Giữ từ tồn</button>
      </div>
      {!mine.length && !incoming.length && <p className="text-sm text-[#94A3B8]">Chưa có hàng giữ chỗ.</p>}
      <ul className="space-y-2">
        {mine.map((r) => (
          <li key={r.id} className="rounded bg-[#1C2534] px-3 py-2 text-sm">
            <div className="flex flex-wrap items-center justify-between gap-2">
              <span><span className="font-mono text-xs text-[#F7B23B]">{r.sku}</span> <span className="text-xs text-[#94A3B8]">trong kho</span> <b className="tabular-nums">{r.qty.toLocaleString('vi-VN')}</b> {unit(r.sku)}{r.delivered > 0 && <span className="text-xs text-[#3DDBB6]">, đã giao {r.delivered.toLocaleString('vi-VN')}</span>}</span>
              <Chip tone={RESERVATION_STATUS[r.status].tone}>{RESERVATION_STATUS[r.status].label}</Chip>
            </div>
            <div className="mt-2"><ReservationActions r={r} onDeliver={() => setDeliver(r)} onRequest={() => setRequest(r)} onDecide={() => setDecide(r)} /></div>
          </li>
        ))}
        {incoming.map((x) => (
          <li key={x.po.id + x.sku} className="flex items-center justify-between gap-2 rounded border border-dashed border-[#263044] px-3 py-2 text-sm">
            <span><span className="font-mono text-xs text-[#F7B23B]">{x.sku}</span> <span className="text-xs text-[#94A3B8]">đang về theo {x.po.code}</span> <b className="tabular-nums">{x.qty.toLocaleString('vi-VN')}</b> {unit(x.sku)}</span>
            <Chip tone="blue">Chưa về kho</Chip>
          </li>
        ))}
      </ul>
      {deliver && <DeliverModal r={deliver} onClose={() => setDeliver(null)} />}
      {request && <RequestReleaseModal r={request} onClose={() => setRequest(null)} />}
      {decide && <DecideReleaseModal r={decide} onClose={() => setDecide(null)} />}
      {reserve && <ReserveFromStockModal preset={{ kind, refId }} onClose={() => setReserve(false)} />}
    </section>
  );
}

function InventoryPage() {
  const { reservations, moves, skus, pos, userName, canRelease, canDo } = useApp();
  const allocName = useAllocName();
  const [q, setQ] = useState('');
  const [st, setSt] = useState<string>('ACTIVE');
  const [deliver, setDeliver] = useState<StockReservation | null>(null);
  const [request, setRequest] = useState<StockReservation | null>(null);
  const [decide, setDecide] = useState<StockReservation | null>(null);
  const [reserve, setReserve] = useState(false);
  const price = (sku: string) => { const k = skus.find((s) => s.sku === sku); return (canDo('price.viewCost') ? k?.costPrice : k?.basePrice) ?? 0; };
  const pending = reservations.filter((r) => r.status === 'PENDING_RELEASE');
  const myPending = pending.filter(canRelease);
  const active = reservations.filter((r) => r.status === 'HELD' || r.status === 'PENDING_RELEASE');
  const since30 = iso(new Date(Date.now() - 30 * 864e5));
  const list = reservations.filter((r) => {
    const t = q.trim().toLowerCase();
    const name = allocName(r).toLowerCase();
    return (!t || r.sku.toLowerCase().includes(t) || name.includes(t)) && (st === 'ALL' || (st === 'ACTIVE' ? r.status === 'HELD' || r.status === 'PENDING_RELEASE' : r.status === st));
  }).sort((a, b) => Number(b.status === 'PENDING_RELEASE') - Number(a.status === 'PENDING_RELEASE') || b.receivedAt.localeCompare(a.receivedAt));
  const paged = usePaged(list, 12);
  const source = (r: StockReservation) => { const po = pos.find((p) => p.id === r.poId); return po ? `${po.code} ${po.shipments.find((s) => s.id === r.shipmentId)?.code ?? ''}` : 'Từ tồn tự do'; };

  return (
    <div className="space-y-4">
      <div className={kpiGrid('lg:grid-cols-4')}>
        <StatCard label="Tồn tự do" value={compact(skus.reduce((a, s) => a + s.stock * price(s.sku), 0))} icon={Package} color={C.teal} sub={`${skus.filter((s) => s.stock > 0).length} SKU còn hàng`} />
        <StatCard label="Hàng giữ chỗ" value={compact(active.reduce((a, r) => a + r.qty * price(r.sku), 0))} icon={Warehouse} color={C.blue} sub={`${active.length} suất giữ chỗ`} />
        <StatCard label="Chờ giải phóng" value={String(pending.length)} icon={AlertTriangle} color={C.orange} sub={myPending.length ? `${myPending.length} chờ bạn xác nhận` : 'Không có yêu cầu chờ bạn'} />
        <StatCard label="Xuất giao 30 ngày" value={compact(moves.filter((m) => m.type === 'DELIVER' && m.at >= since30).reduce((a, m) => a + m.qty * price(m.sku), 0))} icon={Truck} color="#8B5CF6" sub={`${moves.filter((m) => m.type === 'DELIVER' && m.at >= since30).length} lần xuất`} />
      </div>

      {pending.length > 0 && (
        <Panel title={`Chờ xác nhận giải phóng (${pending.length})`}>
          <ul className="space-y-2">
            {pending.map((r) => (
              <li key={r.id} className="flex flex-col gap-2 rounded border border-[#F28C33]/40 bg-[#F28C33]/5 px-3 py-2.5 sm:flex-row sm:items-center">
                <div className="min-w-0 flex-1 text-sm">
                  <p><span className="font-mono text-xs text-[#F7B23B]">{r.sku}</span> <b className="tabular-nums">{r.qty.toLocaleString('vi-VN')}</b> đang giữ cho <b>{allocName(r)}</b></p>
                  <p className="text-xs text-[#94A3B8]">{r.releaseRequest?.reason}{r.releaseRequest?.by ? `, đề nghị bởi ${userName(r.releaseRequest.by)}` : ''}{r.releaseRequest ? `, ${fmtDate(r.releaseRequest.at)}` : ''}</p>
                </div>
                <button className={cn(canRelease(r) ? btnPrimary : btnGhost, btnSm)} onClick={() => setDecide(r)}>{canRelease(r) ? 'Xác nhận' : 'Chờ TP / Giám đốc'}</button>
              </li>
            ))}
          </ul>
        </Panel>
      )}

      <div className="flex flex-col gap-2 rounded-md border border-[#263044] bg-[#151C29] p-2 sm:flex-row sm:items-center">
        <div className="relative flex-1">
          <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#94A3B8]" aria-hidden />
          <input className={cn(inputCls, 'border-[#263044] bg-[#0F141E] py-2 pl-9')} value={q} onChange={(e) => setQ(e.target.value)} placeholder="Tìm SKU, dự án, khách hàng..." aria-label="Tìm hàng giữ chỗ" />
        </div>
        <select className={cn(inputCls, 'w-full border-[#263044] bg-[#0F141E] py-2 sm:w-auto')} value={st} onChange={(e) => setSt(e.target.value)} aria-label="Trạng thái">
          <option value="ACTIVE">Đang trong kho</option>
          <option value="ALL">Tất cả</option>
          {(Object.keys(RESERVATION_STATUS) as ReservationStatus[]).map((x) => <option key={x} value={x}>{RESERVATION_STATUS[x].label}</option>)}
        </select>
        <button className={cn(btnPrimary, 'justify-center py-2')} onClick={() => setReserve(true)}><Plus className="h-4 w-4" aria-hidden />Giữ chỗ từ tồn tự do</button>
      </div>

      <Panel title={`Hàng giữ chỗ (${list.length})`}>
        <div className="space-y-2 md:hidden">
          {paged.slice.map((r) => (
            <div key={r.id} className="rounded-md border border-[#263044] bg-[#151C29] p-3">
              <div className="flex items-start justify-between gap-2"><p className="text-sm font-medium">{allocName(r)}</p><Chip tone={RESERVATION_STATUS[r.status].tone}>{RESERVATION_STATUS[r.status].label}</Chip></div>
              <p className="mt-0.5 text-xs text-[#94A3B8]"><span className="font-mono">{r.sku}</span>, trong kho {r.qty.toLocaleString('vi-VN')}, đã giao {r.delivered.toLocaleString('vi-VN')}</p>
              <div className="mt-2"><ReservationActions r={r} onDeliver={() => setDeliver(r)} onRequest={() => setRequest(r)} onDecide={() => setDecide(r)} /></div>
            </div>
          ))}
        </div>
        <div className="hidden md:block">
          <Table head={['SKU', 'Giữ cho', 'Nguồn', 'Ngày nhập', 'Còn trong kho', 'Đã giao', 'Trạng thái', 'Thao tác']} minW={1000}>
            {paged.slice.map((r) => (
              <tr key={r.id} className={rowCls}>
                <td className={tdFirst}><p className="font-mono text-xs text-[#F7B23B]">{r.sku}</p><p className="max-w-[220px] truncate text-xs text-[#94A3B8]">{skus.find((s) => s.sku === r.sku)?.name}</p></td>
                <td className={tdCls}><p>{allocName(r)}</p><p className="text-xs text-[#94A3B8]">{r.kind === 'LEAD' ? 'Dự án' : 'Khách hàng'}</p></td>
                <td className={cn(tdCls, 'text-xs')}>{source(r)}</td>
                <td className={cn(tdCls, 'tabular-nums')}>{fmtDate(r.receivedAt)}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{r.qty.toLocaleString('vi-VN')}</td>
                <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums text-[#3DDBB6]')}>{r.delivered ? r.delivered.toLocaleString('vi-VN') : '—'}</td>
                <td className={tdCls}><Chip tone={RESERVATION_STATUS[r.status].tone}>{RESERVATION_STATUS[r.status].label}</Chip></td>
                <td className={tdLast}><ReservationActions r={r} onDeliver={() => setDeliver(r)} onRequest={() => setRequest(r)} onDecide={() => setDecide(r)} /></td>
              </tr>
            ))}
          </Table>
        </div>
        {!list.length && <EmptyState text={<>Chưa có hàng giữ chỗ</>} hint={<>Hàng giữ chỗ phát sinh khi nhập kho đợt hàng có phân bổ, hoặc khi giữ chỗ từ tồn tự do.</>} art="ledger" />}
        <Pagination paged={paged} unit="suất giữ chỗ" />
      </Panel>

      <Panel title="Lịch sử xuất nhập kho">
        <Table head={['Ngày', 'Nghiệp vụ', 'SKU', 'Số lượng', 'Đích', 'Chứng từ / ghi chú', 'Người thực hiện']} minW={900}>
          {moves.slice(0, 30).map((m) => (
            <tr key={m.id} className={rowCls}>
              <td className={cn(tdFirst, 'tabular-nums')}>{fmtDate(m.at)}</td>
              <td className={tdCls}><Chip tone={m.type === 'DELIVER' ? 'teal' : m.type === 'RELEASE' ? 'orange' : m.type === 'TRANSFER' ? 'blue' : 'muted'}>{MOVE_LABEL[m.type]}</Chip></td>
              <td className={cn(tdCls, 'font-mono text-xs')}>{m.sku}</td>
              <td className={cn(tdCls, 'whitespace-nowrap text-right tabular-nums')}>{m.type === 'DELIVER' ? '-' : '+'}{m.qty.toLocaleString('vi-VN')}</td>
              <td className={tdCls}>{m.refId && m.kind ? allocName({ kind: m.kind, refId: m.refId, qty: 0 }) : 'Tồn tự do'}</td>
              <td className={cn(tdCls, 'text-xs text-[#94A3B8]')}>{m.note}</td>
              <td className={tdLast}>{m.by ? userName(m.by) : '—'}</td>
            </tr>
          ))}
        </Table>
        {!moves.length && <EmptyState text={<>Chưa có giao dịch kho.</>} art="ledger" />}
      </Panel>

      {deliver && <DeliverModal r={deliver} onClose={() => setDeliver(null)} />}
      {request && <RequestReleaseModal r={request} onClose={() => setRequest(null)} />}
      {decide && <DecideReleaseModal r={decide} onClose={() => setDecide(null)} />}
      {reserve && <ReserveFromStockModal onClose={() => setReserve(false)} />}
    </div>
  );
}

// =====================================================================
//  BỘ SINH TỰ ĐỘNG BÁO GIÁ & HỢP ĐỒNG THEO MẪU (Document Template Engine)
//  Soạn trên app -> chọn cặp mẫu -> ghép biến (có điều kiện) -> xem trước & xuất
// =====================================================================

/** Biến hỗ trợ trong mẫu. Khối điều kiện: {{#if advance}}...{{/if}} (không lồng nhau) */
const TEMPLATE_VARS: [string, string][] = [
  ['doc_code', 'Số báo giá'],
  ['contract_code', 'Số hợp đồng'],
  ['doc_date', 'Ngày lập (dd/mm/yyyy)'],
  ['valid_until', 'Báo giá hiệu lực đến'],
  ['company_name', 'Tên pháp lý công ty bán'],
  ['company_tax_code', 'MST công ty bán'],
  ['company_address', 'Địa chỉ công ty bán'],
  ['company_phone', 'Điện thoại công ty bán'],
  ['company_rep', 'Người đại diện công ty bán'],
  ['company_rep_title', 'Chức vụ người đại diện'],
  ['company_bank', 'Số tài khoản, ngân hàng'],
  ['company_logo', 'Logo (ảnh)'],
  ['company_stamp', 'Mộc / chữ ký (ảnh)'],
  ['customer_name', 'Tên khách hàng (Bên mua)'],
  ['tax_code', 'MST khách hàng'],
  ['customer_address', 'Địa chỉ khách hàng'],
  ['customer_rep', 'Người đại diện khách hàng'],
  ['customer_rep_title', 'Chức vụ đại diện khách hàng'],
  ['customer_phone', 'Điện thoại khách hàng'],
  ['customer_email', 'Email khách hàng'],
  ['project_name', 'Tên dự án / nhu cầu'],
  ['project_code', 'Mã dự án'],
  ['items_table', 'Bảng hàng hóa (SKU, SL, đơn giá, thành tiền, VAT, tổng)'],
  ['subtotal', 'Cộng tiền hàng trước VAT'],
  ['vat_rate', 'Thuế suất VAT'],
  ['vat_amount', 'Tiền thuế VAT'],
  ['grand_total', 'Tổng cộng sau VAT'],
  ['grand_total_words', 'Tổng cộng bằng chữ'],
  ['delivery_terms', 'Tiến độ / địa điểm giao hàng'],
  ['advance_percent', 'Tỷ lệ tạm ứng'],
  ['advance_amount', 'Số tiền tạm ứng'],
  ['guarantee_terms', 'Nội dung bảo lãnh'],
  ['warranty_months', 'Thời hạn bảo hành (tháng)'],
  ['credit_days', 'Số ngày công nợ'],
  ['payment_method', 'Hình thức thanh toán'],
  ['note', 'Ghi chú thêm'],
  ['sales_name', 'Nhân viên phụ trách'],
  ['sales_phone', 'Điện thoại nhân viên phụ trách'],
];
const TEMPLATE_FLAGS: [string, string][] = [
  ['advance', 'Có tạm ứng'],
  ['credit', 'Có công nợ (số ngày > 0)'],
  ['no_credit', 'Thanh toán ngay, không công nợ'],
  ['guarantee', 'Có bảo lãnh'],
  ['warranty', 'Có bảo hành'],
  ['project', 'Có gắn dự án'],
  ['note', 'Có ghi chú'],
];
const RAW_VARS = new Set(['items_table', 'company_stamp', 'company_logo']);

const TX_CLAUSE: Record<TxType, { quote: string; contract: string }> = {
  DEALER: {
    quote: 'Giá đại lý áp dụng cho đơn hàng theo chính sách phân phối hiện hành; chiết khấu thưởng doanh số tính theo quý.',
    contract: 'Bên A được phân phối hàng hóa của Bên B tại khu vực đã thống nhất, cam kết trưng bày sản phẩm, tuân thủ giá bán khuyến nghị và không bán ra ngoài khu vực khi chưa có sự đồng ý của Bên B.',
  },
  PROJECT_ME: {
    quote: 'Đơn giá theo khối lượng BOQ của dự án; hàng hóa có đầy đủ CO, CQ khi giao.',
    contract: 'Hàng hóa được giao theo tiến độ thi công dự án và nghiệm thu theo khối lượng thực tế đối chiếu BOQ. Bên B cung cấp CO, CQ, catalogue và hỗ trợ kỹ thuật tại công trường khi Bên A yêu cầu.',
  },
  SUPPLY_INSTALL: {
    quote: 'Giá đã bao gồm vật tư, nhân công lắp đặt, thử nghiệm và nghiệm thu bàn giao.',
