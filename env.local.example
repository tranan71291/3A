# Đổi tên file thành .env.local (chạy trên máy) hoặc khai báo 2 biến này ở Vercel > Project > Settings > Environment Variables
# Lấy ở Supabase > Project Settings > API (hoặc Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...   # khóa "anon public" (hoặc "publishable"), KHÔNG dùng service_role / secret

# ---------------- v32: AI & Zalo (chỉ khai báo trên máy chủ, KHÔNG đặt tiền tố NEXT_PUBLIC_) ----------------
# Có thể thêm hậu tố __<MÃ_DOANH_NGHIỆP> để mỗi doanh nghiệp dùng khóa riêng, ví dụ ZALO_OA_ACCESS_TOKEN__ALUX
ANTHROPIC_API_KEY=            # Claude (Anthropic Console)
ANTHROPIC_MODEL=              # để trống = claude-sonnet-5-5
OPENAI_API_KEY=               # OpenAI (tùy chọn)
OPENAI_MODEL=                 # để trống = gpt-4o-mini
OPENAI_IMAGE_MODEL=           # tạo ảnh chế độ Nhanh, để trống = gpt-image-2.5-flare (Claude không tạo ảnh; cần OPENAI_API_KEY). gpt-image-1 đã ngừng 23/10/2026: đặt tên cũ thì máy chủ tự dùng mô hình mới
OPENAI_IMAGE_MODEL_DETAIL=    # v56.0.1: chế độ Chi tiết cao, để trống = gpt-image-2.5-sunburst
AI_IMAGE_RATE_PER_MIN=6       # giới hạn số ảnh / người / phút
AI_RATE_PER_MIN=20            # giới hạn số câu hỏi AI / người / phút
AI_EXTRACT_RATE_PER_MIN=6     # v35: giới hạn số lần bóc tách ảnh / PDF vào báo giá / người / phút

ZALO_APP_ID=                  # Zalo for Developers > ứng dụng
ZALO_APP_SECRET=
ZALO_OA_ACCESS_TOKEN=         # access token OA (hết hạn định kỳ)
ZALO_OA_REFRESH_TOKEN=        # để máy chủ tự làm mới access token
ZALO_OA_SECRET_KEY=           # khóa bí mật OA, xác thực chữ ký webhook
ZALO_INGEST_TOKEN=            # chuỗi ngẫu nhiên >= 24 ký tự, trùng với set_integration_token trong supabase-v32.sql
# ALLOW_LOCAL_API=1           # chỉ khi chạy production KHÔNG có Supabase (không khuyến nghị)

# ---------------- v35: Truyền thông đa kênh trên Bàn làm việc ----------------
# YouTube: chỉ cần khai báo Channel ID trong Cài đặt (dùng RSS công khai, không cần khóa)
# Zalo OA: dùng chung ZALO_OA_ACCESS_TOKEN / ZALO_OA_REFRESH_TOKEN ở trên
FACEBOOK_PAGE_ACCESS_TOKEN=   # Page access token của Fanpage (quyền đọc bài của Trang)
FACEBOOK_PAGE_ID=             # tùy chọn, có thể nhập trong Cài đặt
FACEBOOK_GRAPH_VERSION=       # để trống = v25.0

# ---------------- v37: AI Copilot dạng Skill (/api/chat) ----------------
# Dùng chung ANTHROPIC_API_KEY / ANTHROPIC_MODEL ở trên; OPENAI_API_KEY dùng cho embedding tài liệu (RAG)
EMBEDDING_MODEL=              # để trống = text-embedding-3-small (1536 chiều, khớp ai-copilot.sql)
COMPANY_NAME=                 # tên doanh nghiệp hiển thị trong prompt Copilot (để trống = mã doanh nghiệp)
# GEMINI_API_KEY= / GEMINI_MODEL=   # tùy chọn, khi không có khóa Anthropic

# v38 — gợi ý viết tiếp (ghost text), tùy chọn
# AI_COMPLETE_MODEL_ANTHROPIC=claude-haiku-5-5
# AI_COMPLETE_MODEL_OPENAI=gpt-4o-mini
# AI_GHOST_RATE_PER_MIN=12

# ---- v45: máy chủ gửi email (báo giá kèm PDF). Thêm hậu tố __<MÃ_DOANH_NGHIỆP> nếu mỗi doanh nghiệp dùng hộp thư riêng
SMTP_HOST=                    # vd: smtp.gmail.com, smtp.resend.com
SMTP_PORT=465                 # 465 = SSL; 587 = STARTTLS (đặt SMTP_SECURE=0)
SMTP_SECURE=
SMTP_USER=                    # tài khoản đăng nhập SMTP
SMTP_PASS=                    # mật khẩu ứng dụng / API key (chỉ đặt trên máy chủ)
SMTP_FROM=                    # vd: VASSH - Phòng Kinh doanh <sales@vassh.vn>

# ---- v60: tra cứu mã số thuế (tạo đơn, yêu cầu xuất hóa đơn). Mặc định dùng API tra cứu doanh nghiệp của VietQR, không cần khóa.
# Thêm hậu tố __<MÃ_DOANH_NGHIỆP> nếu mỗi doanh nghiệp dùng nguồn riêng (VD cổng tra cứu của nhà cung cấp hóa đơn điện tử)
# TAX_LOOKUP_URL=https://api.vietqr.io/v2/business/{code}   # {code} thay bằng mã số thuế; chỉ nhận https
# TAX_LOOKUP_KEY=               # gửi ở header x-api-key nếu nguồn yêu cầu (chỉ đặt trên máy chủ)
# TAX_LOOKUP_CLIENT_ID=         # gửi ở header x-client-id nếu nguồn yêu cầu
# TAX_LOOKUP_RATE_PER_MIN=20    # số lần tra / người / phút
# TAX_LOOKUP_DISABLED=1         # tắt tra cứu
